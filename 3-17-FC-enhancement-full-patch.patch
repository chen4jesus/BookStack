+            '二十三' => '23', '二十四' => '24', '二十五' => '25', '二十六' => '26',
+            '二十七' => '27', '二十八' => '28', '二十九' => '29', '三十' => '30',
+            '三十一' => '31', '三十二' => '32', '三十三' => '33', '三十四' => '34',
+            '三十五' => '35', '三十六' => '36', '三十七' => '37', '三十八' => '38',
+            '三十九' => '39', '四十' => '40', '四十一' => '41', '四十二' => '42',
+            '四十三' => '43', '四十四' => '44', '四十五' => '45', '四十六' => '46',
