+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6322', '6', '18', '28', '洗 拉 、 以 利 弗 、 耶 布 斯 （ 耶 布 斯 就 是 耶 路 撒 冷 ） 、 基 比 亚 、 基 列 ， 共 十 四 座 城 ， 还 有 属 城 的 村 庄 。 这 是 便 雅 悯 人 按 着 宗 族 所 得 的 地 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6323', '6', '19', '1', '为 西 缅 支 派 的 人 ， 按 着 宗 族 ， 拈 出 第 二 阄 。 他 们 所 得 的 地 业 是 在 犹 大 人 地 业 中 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6324', '6', '19', '2', '他 们 所 得 为 业 之 地 就 是 ： 别 是 巴 （ 或 名 示 巴 ） 、 摩 拉 大 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6325', '6', '19', '3', '哈 萨 书 亚 、 巴 拉 、 以 森 、');
