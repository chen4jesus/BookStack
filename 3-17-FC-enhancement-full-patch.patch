@@ -0,0 +1,149 @@
+@use "vars";
+@use "mixins";
+
+// Bible verse styles
+.bible-verse {
+  color: #0288D1;
+  cursor: pointer;
+  text-decoration: underline;
+  text-decoration-style: dotted;
+  text-underline-offset: 2px;
+  transition: color 0.2s ease, text-decoration-style 0.2s ease;
+  
+  &:hover {
+    color: #01579B;
+    text-decoration-style: solid;
+  }
+}
+
+.verse-content {
+  max-height: 400px;
+  overflow-y: auto;
+  padding: vars.$m;
+  
+  .bible-verses {
+    h4 {
+      margin-bottom: vars.$m;
+      color: var(--color-primary);
+      font-weight: bold;
+    }
+    
+    .verses {
+      .verse {
+        margin-bottom: vars.$s;
+        display: flex;
+        
+        .verse-number {
+          color: #666;
+          font-weight: bold;
+          margin-right: vars.$xs;
+          min-width: 20px;
+          
+          @include mixins.whenDark {
+            color: #aaa;
+          }
+        }
+        
+        .verse-text {
+          line-height: 1.6;
+        }
+      }
+    }
+  }
+}
+
+// Loading and error message styles
+.loading-message, .error-message {
+  padding: vars.$m;
+  text-align: center;
+}
+
+.loading-message {
