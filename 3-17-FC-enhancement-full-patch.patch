+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6318', '6', '18', '24', '基 法 阿 摩 尼 、 俄 弗 尼 、 迦 巴 ， 共 十 二 座 城 ， 还 有 属 城 的 村 庄 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6319', '6', '18', '25', '又 有 基 遍 、 拉 玛 、 比 录 、');
