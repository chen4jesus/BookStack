+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6343', '6', '19', '21', '利 篾 、 隐 干 宁 、 隐 哈 大 、 伯 帕 薛 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6344', '6', '19', '22', '又 达 到 他 泊 、 沙 哈 洗 玛 、 伯 示 麦 ， 直 通 到 约 但 河 为 止 ， 共 十 六 座 城 ， 还 有 属 城 的 村 庄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6345', '6', '19', '23', '这 些 城 并 属 城 的 村 庄 就 是 以 萨 迦 支 派 按 着 宗 族 所 得 的 地 业 。');
