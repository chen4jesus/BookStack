diff --git a/public/index.css b/public/index.css
new file mode 100644
--- /dev/null	(date 1742232231638)
+++ b/public/index.css	(date 1742232231638)
@@ -0,0 +1,451 @@
+.media-player-container {
+    position: fixed;
+    bottom: 0;
+    left: 0;
+    width: 100%;
+    padding: 10px;
+    padding-top: 0; /* Remove top padding to eliminate the line */
+    z-index: 9999;
+    color:#888888;
+    transition: transform 0.3s ease-in-out, height 0.3s;
+    border-radius: 10px;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    background: #ffffff;
+    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
+    box-sizing: border-box;
+    overflow: visible; /* Allow menus to overflow */
+}
+
+.tools-bar {
+    display: flex;
+    flex: 1;
+    justify-content: flex-start;
+    align-items: center;
+    width: 100%;
+    padding: 0;
+    margin: 0; /* Remove any margin that might create space */
+    order: 1; /* Default order - at the top */
+    border-top: none; /* Explicitly remove any border */
+    background-color: #ffffff; /* Match the container background */
+}
+
+#media-wrapper {
+    flex: 6;
+    display: flex;
+    align-items: center;
+    justify-content: flex-start; /* Align to the start (left) */
+    padding-left: 29%; /* Create 30% offset from the left */
+    height: 45px;
+    width: 90%;
+    margin: 0 auto;
+    order: 2; /* Default order - in the middle */
+    overflow: visible !important; /* Ensure dropdowns aren't clipped */
+    position: relative; /* Establish positioning context */
+}
+
+#active-file {
+    order: 3; /* Default order - after media wrapper */
+}
+
+#playlist {
+    order: 4; /* Default order - at the bottom */
+}
+
+/* Minimized Player - Smaller Size */
+.media-player-container.minimized {
+    height: 52px;
+    flex-direction: row;
+    align-items: center;
+    justify-content: space-between;
+    align-items: center;
+    padding: 2px 6px;
+}
+
+/* Player Controls */
+.js-player {
+    width: 100%;
+    max-width: 600px;
+    overflow: visible !important; /* Ensure dropdowns aren't clipped */
+}
+
+/* Hide Playlist in Minimized Mode */
+.media-player-container.minimized #playlist {
+    display: none;
+}
+
+/* Active File Name - Visible in Minimized Mode */
+#active-file {
+    font-size: 13px;
+    text-align: center;
+    word-break: break-word;
+    justify-content: center;
+    height: 52px;
+    overflow: auto;
+    display: none;
+}
+.media-player-container.expanded .tools-bar{
+    position:absolute;
+    top:22px;
+    left:20px;
+}
+
+.media-player-container.minimized #active-file {
+    flex: 6;
+    display: flex;
+    justify-items: center;
+    align-items: center;
+}
+
+/* Minimize / Expand / Hide Buttons */
+#toggle-player, #hide-player, #expand-player {
+    background: transparent;
+    border: none;
+    font-size: 18px;
+    cursor: pointer;
+    transition: 0.3s;
+    color: #888888;
+    margin-right: 8px;
+}
+
+#toggle-player:hover, #hide-player:hover {
+    color: rgb(111, 109, 109);
+}
+
+#expand-player {
+    color: white;
+}
+
+/* Close Button */
+.close-button {
+    color:#888888;
+    background: transparent;
+    border: none;
+    font-size: 14px;
+    cursor: pointer;
+}
+
+.close-button:hover {
+    color:rgb(111, 109, 109);
+}
+
+/* Playlist */
+#playlist {
+    list-style: none;
+    padding: 0;
+    margin-top: 0px;
+    text-align: left;
+    width: 100%;
+    max-width: 600px;
+}
+
+#playlist li {
+    background: #fff;
+    padding: 5px 8px;
+    margin: 3px 5px;
+    cursor: pointer;
+    border-radius: 5px;
+    transition: background 0.3s, border-left 0.3s;
+    text-align: left;
+    word-break: break-word;
+    overflow: auto;
+    border-left: 3px solid transparent;
+    position: relative;
+    display: flex;
+    align-items: center;
+}
+
+/* Playing indicator styling */
+.playing-indicator {
+    display: none;
+    color: #3498db;
+    margin-right: 5px;
+    font-size: 12px;
+    animation: pulsate 1.5s infinite;
+}
+
+#playlist li.active .playing-indicator {
+    display: inline;
+}
+
+@keyframes pulsate {
+    0% { opacity: 0.7; }
+    50% { opacity: 1; }
+    100% { opacity: 0.7; }
+}
+
+#playlist li:hover {
+    background: #f5f5f5;
+}
+
+#playlist li.active {
+    background: #e7f3ff;
+    border-left: 3px solid #3498db;
+    font-weight: 500;
+    color: #2980b9;
+}
+
+/* Dark mode support if needed */
+body.dark-mode #playlist li.active {
+    background: #1a3a5a;
+    border-left: 3px solid #3498db;
+    color: #7fbbec;
+}
+
+body.dark-mode #playlist li:hover {
+    background: #333;
+}
+
+body.dark-mode .playing-indicator {
+    color: #7fbbec;
+}
+
+@media (max-width: 768px) {
+    .media-player-container {
+        padding-bottom: 5px; /* Reduce bottom padding for mobile */
+    }
+    
+    .tools-bar {
+        order: 4; /* Move to the bottom on mobile */
+        margin-top: 0; /* Add spacing above toolbar */
+        margin-bottom: 0; /* Remove bottom margin */
+        justify-content: center; /* Center tools on mobile */
+        border-top: none;
+        padding-top: 0;
+    }
+
+    #playlist {
+        order: 3; /* Move playlist above toolbar */
+        margin-bottom: 5px; /* Add a small margin instead of a border */
+    }
+
+    /* Adjust the expanded view for mobile */
+    .media-player-container.expanded .tools-bar {
+        position: relative; /* Not absolute on mobile */
+        top: auto;
+        left: auto;
+        width: 100%;
+        order: 4; /* Keep at bottom even when expanded */
+    }
+
+    /* Ensure the player is still nicely centered on mobile */
+    #media-wrapper {
+        width: 95%;
+        max-width: 500px;
+        padding-left: 0; /* Remove the 30% padding on mobile */
+        justify-content: center; /* Re-center on mobile */
+    }
+
+    /* Improved active file display for mobile */
+    #active-file {
+        font-size: 12px;
+        max-width: 90%;
+        text-align: center;
+        margin: 5px 0;
+    }
+    
+    /* Make buttons slightly larger for touch on mobile */
+    #toggle-player, #hide-player, #close-media {
+        padding: 0px;
+        font-size: 20px;
+    }
+}
+
+/* Smaller mobile devices */
+@media (max-width: 480px) {
+    .tools-bar {
+        flex-direction: row;
+        justify-content: center; /* Center on very small screens */
+        padding: 0px 0px;
+    }
+    
+    .tools-bar button {
+        margin: 0 0px; /* Even spacing around buttons */
+    }
+    
+    /* Ensure volume buttons stay hidden */
+    .plyr__volume {
+        display: none;
+    }
+}
+
+/* Active file carousel - floating display */
+.active-file-carousel {
+    display: none;
+    position: fixed;
+    bottom: 100px;
+    left: 50%;
+    transform: translateX(-50%);
+    max-width: 80%;
+    padding: 8px 16px;
+    border-radius: 24px;
+    background: linear-gradient(135deg, rgba(25, 35, 60, 0.5), rgba(15, 25, 40, 0.6));
+    backdrop-filter: blur(8px);
+    color: white;
+    font-size: 14px;
+    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
+    z-index: 1000;
+    text-align: center;
+    overflow: hidden;
+    pointer-events: none; /* Makes it click-through */
+    border: 1px solid rgba(255, 255, 255, 0.15);
+    letter-spacing: 0.5px;
+    font-weight: 500;
+    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
+    transition: opacity 0.25s ease, transform 0.25s ease; /* Faster transition for button clicks */
+}
+
+.active-file-carousel.visible {
+    display: block;
+    animation: carouselAppear 0.25s ease forwards; /* Quicker animation for button clicks */
+}
+
+/* For long text, make it slide */
+.active-file-carousel {
+    white-space: nowrap;
+}
+
+.active-file-carousel.text-overflow {
+    animation: slideLeft 7s linear infinite;
+}
+
+/* Animations for the carousel */
+@keyframes carouselAppear {
+    from {
+        opacity: 0;
+        transform: translate(-50%, 20px) scale(0.95);
+    }
+    to {
+        opacity: 1;
+        transform: translate(-50%, 0) scale(1);
+    }
+}
+
+@keyframes slideLeft {
+    0%, 15% {
+        text-indent: 0;
+    }
+    50% {
+        text-indent: -100%;
+    }
+    65%, 100% {
+        text-indent: 0;
+    }
+}
+
+@keyframes subtlePulse {
+    0% {
+        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
+    }
+    50% {
+        box-shadow: 0 4px 20px rgba(50, 100, 150, 0.2);
+    }
+    100% {
+        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
+    }
+}
+
+@keyframes carouselUpdate {
+    0% {
+        opacity: 1;
+        transform: translateY(0) translateX(-50%);
+    }
+    30% {
+        opacity: 0;
+        transform: translateY(-15px) translateX(-50%) scale(0.97);
+    }
+    70% {
+        opacity: 0;
+        transform: translateY(15px) translateX(-50%) scale(0.97);
+    }
+    100% {
+        opacity: 1;
+        transform: translateY(0) translateX(-50%) scale(1);
+    }
+}
+
+/* Media query for mobile devices */
+@media (max-width: 768px) {
+    .active-file-carousel {
+        bottom: 80px;
+        max-width: 90%;
+        font-size: 13px;
+        padding: 6px 14px;
+    }
+}
+
+#reload-media {
+    margin-right: 5px;
+    font-size: 18px;
+    cursor: pointer;
+    background: none;
+    border: none;
+    color: #666;
+}
+
+#reload-media:hover {
+    color: #000;
+}
+
+.plyr__volume {
+  position: relative;
+}
+
+.plyr__volume input[data-plyr="volume"] {
+  display: none;
+  height: 2rem;
+  position: absolute;
+  right: -5.2rem;
+  top: -1rem;
+  transform-origin: left;
+  transform: rotate(-90deg);
+}
+
+.plyr__volume:hover input[data-plyr="volume"],
+.plyr__volume input[data-plyr="volume"]:hover {
+  display: block;
+}
+
+/* Styling for rewind and fast-forward buttons */
+button[data-plyr="rewind"],
+button[data-plyr="fast-forward"] {
+    font-size: 16px;
+    background: transparent;
+    color: #606060;
+    transition: color 0.2s ease-in-out;
+    padding: 6px;
+    margin: 0 3px;
+}
+
+button[data-plyr="rewind"]:hover,
+button[data-plyr="fast-forward"]:hover {
+    color: #000;
+}
+
+@media (max-width: 768px) {
+    button[data-plyr="rewind"],
+    button[data-plyr="fast-forward"] {
+        font-size: 18px;
+        padding: 8px;
