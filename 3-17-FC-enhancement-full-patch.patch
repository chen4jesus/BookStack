+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6328', '6', '19', '6', '伯 利 巴 勿 、 沙 鲁 险 ， 共 十 三 座 城 ， 还 有 属 城 的 村 庄 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6329', '6', '19', '7', '又 有 亚 因 、 利 门 、 以 帖 、 亚 珊 ， 共 四 座 城 ， 还 有 属 城 的 村 庄 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6330', '6', '19', '8', '并 有 这 些 城 邑 四 围 一 切 的 村 庄 ， 直 到 巴 拉 比 珥 ， 就 是 南 地 的 拉 玛 。 这 是 西 缅 支 派 按 着 宗 族 所 得 的 地 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6331', '6', '19', '9', '西 缅 人 的 地 业 是 从 犹 大 人 地 业 中 得 来 的 ； 因 为 犹 大 人 的 分 过 多 ， 所 以 西 缅 人 在 他 们 的 地 业 中 得 了 地 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6332', '6', '19', '10', '为 西 布 伦 人 ， 按 着 宗 族 ， 拈 出 第 三 阄 。 他 们 地 业 的 境 界 是 到 撒 立 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6333', '6', '19', '11', '往 西 上 到 玛 拉 拉 ， 达 到 大 巴 设 ， 又 达 到 约 念 前 的 河 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6334', '6', '19', '12', '又 从 撒 立 往 东 转 向 日 出 之 地 ， 到 吉 斯 绿 他 泊 的 境 界 ， 又 通 到 大 比 拉 ， 上 到 雅 非 亚 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6335', '6', '19', '13', '从 那 里 往 东 ， 接 连 到 迦 特 希 弗 ， 至 以 特 加 汛 ， 通 到 临 门 ， 临 门 延 到 尼 亚 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6336', '6', '19', '14', '又 绕 过 尼 亚 的 北 边 ， 转 到 哈 拿 顿 ， 通 到 伊 弗 他 伊 勒 谷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6337', '6', '19', '15', '还 有 加 他 、 拿 哈 拉 、 伸 仑 、 以 大 拉 、 伯 利 恒 ， 共 十 二 座 城 ， 还 有 属 城 的 村 庄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6338', '6', '19', '16', '这 些 城 并 属 城 的 村 庄 就 是 西 布 伦 人 按 着 宗 族 所 得 的 地 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6339', '6', '19', '17', '为 以 萨 迦 人 ， 按 着 宗 族 ， 拈 出 第 四 阄 。');
