+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6347', '6', '19', '25', '他 们 的 境 界 是 黑 甲 、 哈 利 、 比 田 、 押 煞 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6348', '6', '19', '26', '亚 拉 米 勒 、 亚 末 、 米 沙 勒 ； 往 西 达 到 迦 密 ， 又 到 希 曷 立 纳 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6349', '6', '19', '27', '转 向 日 出 之 地 ， 到 伯 大 衮 ， 达 到 细 步 纶 往 北 到 伊 弗 他 伊 勒 谷 ， 到 伯 以 墨 和 尼 业 ， 也 通 到 迦 步 勒 的 左 边 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6350', '6', '19', '28', '又 到 义 伯 仑 、 利 合 、 哈 们 、 加 拿 ， 直 到 西 顿 大 城 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6351', '6', '19', '29', '转 到 拉 玛 和 坚 固 城 推 罗 ； 又 转 到 何 萨 ， 靠 近 亚 革 悉 一 带 地 方 ， 直 通 到 海 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6352', '6', '19', '30', '又 有 乌 玛 、 亚 弗 、 利 合 ， 共 二 十 二 座 城 ， 还 有 属 城 的 村 庄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6353', '6', '19', '31', '这 些 城 并 属 城 的 村 庄 就 是 亚 设 支 派 按 着 宗 族 所 得 的 地 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6354', '6', '19', '32', '为 拿 弗 他 利 人 ， 按 着 宗 族 ， 拈 出 第 六 阄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6355', '6', '19', '33', '他 们 的 境 界 是 从 希 利 弗 从 撒 拿 音 的 橡 树 ， 从 亚 大 米 尼 吉 和 雅 比 聂 ， 直 到 拉 共 ， 通 到 约 但 河 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6356', '6', '19', '34', '又 转 向 西 到 亚 斯 纳 他 泊 ， 从 那 里 通 到 户 割 ， 南 边 到 西 布 伦 ， 西 边 到 亚 设 ， 又 向 日 出 之 地 ， 达 到 约 但 河 那 里 的 犹 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6357', '6', '19', '35', '坚 固 的 城 就 是 ： 西 丁 、 侧 耳 、 哈 末 、 拉 甲 、 基 尼 烈 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6358', '6', '19', '36', '亚 大 玛 、 拉 玛 、 夏 琐 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6359', '6', '19', '37', '基 低 斯 、 以 得 来 、 隐 夏 琐 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6360', '6', '19', '38', '以 利 稳 、 密 大 伊 勒 、 和 琏 、 伯 亚 纳 、 伯 示 麦 ， 共 十 九 座 城 ， 还 有 属 城 的 村 庄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6361', '6', '19', '39', '这 些 城 并 属 城 的 村 庄 就 是 拿 弗 他 利 支 派 按 着 宗 族 所 得 的 地 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6362', '6', '19', '40', '为 但 支 派 ， 按 着 宗 族 ， 拈 出 第 七 阄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6363', '6', '19', '41', '他 们 地 业 的 境 界 是 琐 拉 、 以 实 陶 、 伊 珥 示 麦 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6364', '6', '19', '42', '沙 拉 宾 、 亚 雅 仑 、 伊 提 拉 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6365', '6', '19', '43', '以 伦 、 亭 拿 他 、 以 革 伦 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6366', '6', '19', '44', '伊 利 提 基 、 基 比 顿 、 巴 拉 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6367', '6', '19', '45', '伊 胡 得 、 比 尼 比 拉 、 迦 特 临 门 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6368', '6', '19', '46', '美 耶 昆 、 拉 昆 ， 并 约 帕 对 面 的 地 界 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6369', '6', '19', '47', '但 人 的 地 界 越 过 原 得 的 地 界 ； 因 为 但 人 上 去 攻 取 利 善 ， 用 刀 击 杀 城 中 的 人 ， 得 了 那 城 ， 住 在 其 中 ， 以 他 们 先 祖 但 的 名 将 利 善 改 名 为 但 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6370', '6', '19', '48', '这 些 城 并 属 城 的 村 庄 就 是 但 支 派 按 着 宗 族 所 得 的 地 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6371', '6', '19', '49', '以 色 列 人 按 着 境 界 分 完 了 地 业 ， 就 在 他 们 中 间 将 地 给 嫩 的 儿 子 约 书 亚 为 业 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6372', '6', '19', '50', '是 照 耶 和 华 的 吩 咐 ， 将 约 书 亚 所 求 的 城 ， 就 是 以 法 莲 山 地 的 亭 拿 西 拉 城 ， 给 了 他 。 他 就 修 那 城 ， 住 在 其 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6373', '6', '19', '51', '这 就 是 祭 司 以 利 亚 撒 和 嫩 的 儿 子 约 书 亚 ， 并 以 色 列 各 支 派 的 族 长 ， 在 示 罗 会 幕 门 口 ， 耶 和 华 面 前 ， 拈 阄 所 分 的 地 业 。 这 样 ， 他 们 把 地 分 完 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6374', '6', '20', '1', '耶 和 华 晓 谕 约 书 亚 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6375', '6', '20', '2', '你 吩 咐 以 色 列 人 说 ： 你 们 要 照 着 我 藉 摩 西 所 晓 谕 你 们 的 ， 为 自 己 设 立 逃 城 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6376', '6', '20', '3', '使 那 无 心 而 误 杀 人 的 ， 可 以 逃 到 那 里 。 这 些 城 可 以 作 你 们 逃 避 报 血 仇 人 的 地 方 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6377', '6', '20', '4', '那 杀 人 的 要 逃 到 这 些 城 中 的 一 座 城 ， 站 在 城 门 口 ， 将 他 的 事 情 说 给 城 内 的 长 老 们 听 。 他 们 就 把 他 收 进 城 里 ， 给 他 地 方 ， 使 他 住 在 他 们 中 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6378', '6', '20', '5', '若 是 报 血 仇 的 追 了 他 来 ， 长 老 不 可 将 他 交 在 报 血 仇 的 手 里 ； 因 为 他 是 素 无 仇 恨 ， 无 心 杀 了 人 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6379', '6', '20', '6', '他 要 住 在 那 城 里 ， 站 在 会 众 面 前 听 审 判 ， 等 到 那 时 的 大 祭 司 死 了 ， 杀 人 的 才 可 以 回 到 本 城 本 家 ， 就 是 他 所 逃 出 来 的 那 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6380', '6', '20', '7', '於 是 ， 以 色 列 人 在 拿 弗 他 利 山 地 分 定 加 利 利 的 基 低 斯 ； 在 以 法 莲 山 地 分 定 示 剑 ； 在 犹 大 山 地 分 定 基 列 亚 巴 （ 基 列 亚 巴 就 是 希 伯 仑 ） ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6381', '6', '20', '8', '又 在 约 但 河 外 耶 利 哥 东 ， 从 流 便 支 派 中 ， 在 旷 野 的 平 原 ， 设 立 比 悉 ； 从 迦 得 支 派 中 设 立 基 列 的 拉 末 ； 从 玛 拿 西 支 派 中 设 立 巴 珊 的 哥 兰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6382', '6', '20', '9', '这 都 是 为 以 色 列 众 人 和 在 他 们 中 间 寄 居 的 外 人 所 分 定 的 地 邑 ， 使 误 杀 人 的 都 可 以 逃 到 那 里 ， 不 死 在 报 血 仇 人 的 手 中 ， 等 他 站 在 会 众 面 前 听 审 判 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6383', '6', '21', '1', '那 时 ， 利 未 人 的 众 族 长 来 到 祭 司 以 利 亚 撒 和 嫩 的 儿 子 约 书 亚 ， 并 以 色 列 各 支 派 的 族 长 面 前 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6384', '6', '21', '2', '在 迦 南 地 的 示 罗 对 他 们 说 ： 从 前 耶 和 华 藉 着 摩 西 吩 咐 给 我 们 城 邑 居 住 ， 并 城 邑 的 郊 野 可 以 牧 养 我 们 的 牲 畜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6385', '6', '21', '3', '於 是 以 色 列 人 照 耶 和 华 所 吩 咐 的 ， 从 自 己 的 地 业 中 ， 将 以 下 所 记 的 城 邑 和 城 邑 的 郊 野 给 了 利 未 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6386', '6', '21', '4', '为 哥 辖 族 拈 阄 ： 利 未 人 的 祭 司 、 亚 伦 的 子 孙 ， 从 犹 大 支 派 、 西 缅 支 派 、 便 雅 悯 支 派 的 地 业 中 ， 按 阄 得 了 十 三 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6387', '6', '21', '5', '哥 辖 其 馀 的 子 孙 ， 从 以 法 莲 支 派 、 但 支 派 、 玛 拿 西 半 支 派 的 地 业 中 ， 按 阄 得 了 十 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6388', '6', '21', '6', '革 顺 的 子 孙 ， 从 以 萨 迦 支 派 、 亚 设 支 派 、 拿 弗 他 利 支 派 、 住 巴 珊 的 玛 拿 西 半 支 派 的 地 业 中 ， 按 阄 得 了 十 三 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6389', '6', '21', '7', '米 拉 利 的 子 孙 ， 按 着 宗 族 ， 从 流 便 支 派 、 迦 得 支 派 、 西 布 伦 支 派 的 地 业 中 ， 按 阄 得 了 十 二 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6390', '6', '21', '8', '以 色 列 人 照 着 耶 和 华 藉 摩 西 所 吩 咐 的 ， 将 这 些 城 邑 和 城 邑 的 郊 野 ， 按 阄 分 给 利 未 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6391', '6', '21', '9', '从 犹 大 支 派 、 西 缅 支 派 的 地 业 中 ， 将 以 下 所 记 的 城 给 了 利 未 支 派 哥 辖 宗 族 亚 伦 的 子 孙 ； 因 为 给 他 们 拈 出 头 一 阄 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6392', '6', '21', '10', 'a');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6393', '6', '21', '11', '将 犹 大 山 地 的 基 列 亚 巴 和 四 围 的 郊 野 给 了 他 们 。 亚 巴 是 亚 衲 族 的 始 祖 。 （ 基 列 亚 巴 就 是 希 伯 仑 ） 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6394', '6', '21', '12', '惟 将 属 城 的 田 地 和 村 庄 给 了 耶 孚 尼 的 儿 子 迦 勒 为 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6395', '6', '21', '13', '以 色 列 人 将 希 伯 仑 ， 就 是 误 杀 人 的 逃 城 和 属 城 的 郊 野 ， 给 了 祭 司 亚 伦 的 子 孙 ； 又 给 他 们 立 拿 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6396', '6', '21', '14', '雅 提 珥 和 属 城 的 郊 野 ， 以 实 提 莫 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6397', '6', '21', '15', '何 仑 和 属 城 的 郊 野 ， 底 璧 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6398', '6', '21', '16', '亚 因 和 属 城 的 郊 野 ， 淤 他 和 属 城 的 郊 野 ， 伯 示 麦 和 属 城 的 郊 野 ， 共 九 座 城 ， 都 是 从 这 二 支 派 中 分 出 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6399', '6', '21', '17', '又 从 便 雅 悯 支 派 的 地 业 中 给 了 他 们 基 遍 和 属 城 的 郊 野 ， 迦 巴 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6400', '6', '21', '18', '亚 拿 突 和 属 城 的 郊 野 ， 亚 勒 们 和 属 城 的 郊 野 ， 共 四 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6401', '6', '21', '19', '亚 伦 子 孙 作 祭 司 的 共 有 十 三 座 城 ， 还 有 属 城 的 郊 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6402', '6', '21', '20', '利 未 支 派 中 哥 辖 的 宗 族 ， 就 是 哥 辖 其 馀 的 子 孙 ， 拈 阄 所 得 的 城 有 从 以 法 莲 支 派 中 分 出 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6403', '6', '21', '21', '以 色 列 人 将 以 法 莲 山 地 的 示 剑 ， 就 是 误 杀 人 的 逃 城 和 属 城 的 郊 野 ， 给 了 他 们 ； 又 给 他 们 基 色 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6404', '6', '21', '22', '基 伯 先 和 属 城 的 郊 野 ， 伯 和 仑 和 属 城 的 郊 野 ， 共 四 座 城 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6405', '6', '21', '23', '又 从 但 支 派 的 地 业 中 给 了 他 们 伊 利 提 基 和 属 城 的 郊 野 ， 基 比 顿 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6406', '6', '21', '24', '亚 雅 仑 和 属 城 的 郊 野 ， 迦 特 临 门 和 属 城 的 郊 野 ， 共 四 座 城 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6407', '6', '21', '25', '又 从 玛 拿 西 半 支 派 的 地 业 中 给 了 他 们 他 纳 和 属 城 的 郊 野 ， 迦 特 临 门 和 属 城 的 郊 野 ， 共 两 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6408', '6', '21', '26', '哥 辖 其 馀 的 子 孙 共 有 十 座 城 ， 还 有 属 城 的 郊 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6409', '6', '21', '27', '以 色 列 人 又 从 玛 拿 西 半 支 派 的 地 业 中 将 巴 珊 的 哥 兰 ， 就 是 误 杀 人 的 逃 城 和 属 城 的 郊 野 ， 给 了 利 未 支 派 革 顺 的 子 孙 ； 又 给 他 们 比 施 提 拉 和 属 城 的 郊 野 ， 共 两 座 城 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6410', '6', '21', '28', '又 从 以 萨 迦 支 派 的 地 业 中 给 了 他 们 基 善 和 属 城 的 郊 野 ， 大 比 拉 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6411', '6', '21', '29', '耶 末 和 属 城 的 郊 野 ， 隐 干 宁 和 属 城 的 郊 野 ， 共 四 座 城 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6412', '6', '21', '30', '又 从 亚 设 支 派 的 地 业 中 给 了 他 们 米 沙 勒 和 属 城 的 郊 野 ， 押 顿 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6413', '6', '21', '31', '黑 甲 和 属 城 的 郊 野 ， 利 合 和 属 城 的 郊 野 ， 共 四 座 城 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6414', '6', '21', '32', '又 从 拿 弗 他 利 支 派 的 地 业 中 将 加 利 利 的 基 低 斯 ， 就 是 误 杀 人 的 逃 城 和 属 城 的 郊 野 ， 给 了 他 们 ； 又 给 他 们 哈 末 多 珥 和 属 城 的 郊 野 ， 加 珥 坦 和 属 城 的 郊 野 ， 共 三 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6415', '6', '21', '33', '革 顺 人 按 着 宗 族 所 得 的 城 ， 共 十 三 座 ， 还 有 属 城 的 郊 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6416', '6', '21', '34', '其 馀 利 未 支 派 米 拉 利 子 孙 ， 从 西 布 伦 支 派 的 地 业 中 所 得 的 ， 就 是 约 念 和 属 城 的 郊 野 ， 加 珥 他 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6417', '6', '21', '35', '丁 拿 和 属 城 的 郊 野 ， 拿 哈 拉 和 属 城 的 郊 野 ， 共 四 座 城 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6418', '6', '21', '36', '又 从 流 便 支 派 的 地 业 中 给 了 他 们 比 悉 和 属 城 的 郊 野 ， 雅 杂 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6419', '6', '21', '37', '基 底 莫 和 属 城 的 郊 野 ， 米 法 押 和 属 城 的 郊 野 ， 共 四 座 城 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6420', '6', '21', '38', '又 从 迦 得 支 派 的 地 业 中 ， 将 基 列 的 拉 末 ， 就 是 误 杀 人 的 逃 城 和 属 城 的 郊 野 ， 给 了 他 们 ； 又 给 他 们 玛 哈 念 和 属 城 的 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6421', '6', '21', '39', '希 实 本 和 属 城 的 郊 野 ， 雅 谢 和 属 城 的 郊 野 ， 共 四 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6422', '6', '21', '40', '其 馀 利 未 支 派 的 人 ， 就 是 米 拉 利 的 子 孙 ， 按 着 宗 族 拈 阄 所 得 的 ， 共 十 二 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6423', '6', '21', '41', '利 未 人 在 以 色 列 人 的 地 业 中 所 得 的 城 ， 共 四 十 八 座 ， 并 有 属 城 的 郊 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6424', '6', '21', '42', '这 些 城 四 围 都 有 属 城 的 郊 野 ， 城 城 都 是 如 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6425', '6', '21', '43', '这 样 ， 耶 和 华 将 从 前 向 他 们 列 祖 起 誓 所 应 许 的 全 地 赐 给 以 色 列 人 ， 他 们 就 得 了 为 业 ， 住 在 其 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6426', '6', '21', '44', '耶 和 华 照 着 向 他 们 列 祖 起 誓 所 应 许 的 一 切 话 ， 使 他 们 四 境 平 安 ； 他 们 一 切 仇 敌 中 ， 没 有 一 人 在 他 们 面 前 站 立 得 住 。 耶 和 华 把 一 切 仇 敌 都 交 在 他 们 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6427', '6', '21', '45', '耶 和 华 应 许 赐 福 给 以 色 列 家 的 话 一 句 也 没 有 落 空 ， 都 应 验 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6428', '6', '22', '1', '当 时 ， 约 书 亚 召 了 流 便 人 、 迦 得 人 ， 和 玛 拿 西 半 支 派 的 人 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6429', '6', '22', '2', '对 他 们 说 ： 耶 和 华 仆 人 摩 西 所 吩 咐 你 们 的 ， 你 们 都 遵 守 了 ； 我 所 吩 咐 你 们 的 ， 你 们 也 都 听 从 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6430', '6', '22', '3', '你 们 这 许 多 日 子 ， 总 没 有 撇 离 你 们 的 弟 兄 ， 直 到 今 日 ， 并 守 了 耶 和 华 ─ 你 们 　 神 所 吩 咐 你 们 当 守 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6431', '6', '22', '4', '如 今 耶 和 华 ─ 你 们 　 神 照 着 他 所 应 许 的 ， 使 你 们 弟 兄 得 享 平 安 ， 现 在 可 以 转 回 你 们 的 帐 棚 ， 到 耶 和 华 的 仆 人 摩 西 在 约 但 河 东 所 赐 你 们 为 业 之 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6432', '6', '22', '5', '只 要 切 切 的 谨 慎 遵 行 耶 和 华 仆 人 摩 西 所 吩 咐 你 们 的 诫 命 律 法 ， 爱 耶 和 华 ─ 你 们 的 　 神 ， 行 他 一 切 的 道 ， 守 他 的 诫 命 ， 专 靠 他 ， 尽 心 尽 性 事 奉 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6433', '6', '22', '6', '於 是 约 书 亚 为 他 们 祝 福 ， 打 发 他 们 去 ， 他 们 就 回 自 己 的 帐 棚 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6434', '6', '22', '7', '玛 拿 西 那 半 支 派 ， 摩 西 早 已 在 巴 珊 分 给 他 们 地 业 。 这 半 支 派 ， 约 书 亚 在 约 但 河 西 ， 在 他 们 弟 兄 中 ， 分 给 他 们 地 业 。 约 书 亚 打 发 他 们 回 帐 棚 的 时 候 为 他 们 祝 福 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6435', '6', '22', '8', '对 他 们 说 ： 你 们 带 许 多 财 物 ， 许 多 牲 畜 和 金 、 银 、 铜 、 铁 ， 并 许 多 衣 服 ， 回 你 们 的 帐 棚 去 ， 要 将 你 们 从 仇 敌 夺 来 的 物 ， 与 你 们 众 弟 兄 同 分 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6436', '6', '22', '9', '於 是 流 便 人 、 迦 得 人 、 玛 拿 西 半 支 派 的 人 从 迦 南 地 的 示 罗 起 行 ， 离 开 以 色 列 人 ， 回 往 他 们 得 为 业 的 基 列 地 ， 就 是 照 耶 和 华 藉 摩 西 所 吩 咐 的 得 了 为 业 之 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6437', '6', '22', '10', '流 便 人 、 迦 得 人 ， 和 玛 拿 西 半 支 派 的 人 到 了 靠 近 约 但 河 的 一 带 迦 南 地 ， 就 在 约 但 河 那 里 筑 了 一 座 坛 ； 那 坛 看 着 高 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6438', '6', '22', '11', '以 色 列 人 听 说 流 便 人 、 迦 得 人 、 玛 拿 西 半 支 派 的 人 靠 近 约 但 河 边 ， 在 迦 南 地 属 以 色 列 人 的 那 边 筑 了 一 座 坛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6439', '6', '22', '12', '全 会 众 一 听 见 ， 就 聚 集 在 示 罗 ， 要 上 去 攻 打 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6440', '6', '22', '13', '以 色 列 人 打 发 祭 司 以 利 亚 撒 的 儿 子 非 尼 哈 ， 往 基 列 地 去 见 流 便 人 、 迦 得 人 、 玛 拿 西 半 支 派 的 人 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6441', '6', '22', '14', '又 打 发 十 个 首 领 与 非 尼 哈 同 去 ， 就 是 以 色 列 每 支 派 的 一 个 首 领 ， 都 是 以 色 列 军 中 的 统 领 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6442', '6', '22', '15', '他 们 到 了 基 列 地 ， 见 流 便 人 、 迦 得 人 ， 和 玛 拿 西 半 支 派 的 人 ， 对 他 们 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6443', '6', '22', '16', '耶 和 华 全 会 众 这 样 说 ， 你 们 今 日 转 去 不 跟 从 耶 和 华 ， 干 犯 以 色 列 的 　 神 ， 为 自 己 筑 一 座 坛 ， 悖 逆 了 耶 和 华 ， 这 犯 的 是 甚 麽 罪 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6444', '6', '22', '17', '从 前 拜 ? 珥 的 罪 孽 还 算 小 麽 ？ 虽 然 瘟 疫 临 到 耶 和 华 的 会 众 ， 到 今 日 我 们 还 没 有 洗 净 这 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6445', '6', '22', '18', '你 们 今 日 竟 转 去 不 跟 从 耶 和 华 麽 ？ 你 们 今 日 既 悖 逆 耶 和 华 ， 明 日 他 必 向 以 色 列 全 会 众 发 怒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6446', '6', '22', '19', '你 们 所 得 为 业 之 地 ， 若 嫌 不 洁 净 ， 就 可 以 过 到 耶 和 华 之 地 ， 就 是 耶 和 华 的 帐 幕 所 住 之 地 ， 在 我 们 中 间 得 地 业 。 只 是 不 可 悖 逆 耶 和 华 ， 也 不 可 得 罪 我 们 ， 在 耶 和 华 ─ 我 们 　 神 的 坛 以 外 为 自 己 筑 坛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6447', '6', '22', '20', '从 前 谢 拉 的 曾 孙 亚 干 岂 不 是 在 那 当 灭 的 物 上 犯 了 罪 ， 就 有 忿 怒 临 到 以 色 列 全 会 众 麽 ？ 那 人 在 所 犯 的 罪 中 不 独 一 人 死 亡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6448', '6', '22', '21', '於 是 流 便 人 、 迦 得 人 、 玛 拿 西 半 支 派 的 人 回 答 以 色 列 军 中 的 统 领 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6449', '6', '22', '22', '大 能 者 神 耶 和 华 ！ 大 能 者 神 耶 和 华 ！ 他 是 知 道 的 ！ 以 色 列 人 也 必 知 道 ！ 我 们 若 有 悖 逆 的 意 思 ， 或 是 干 犯 耶 和 华 （ 愿 你 今 日 不 保 佑 我 们 ） ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6450', '6', '22', '23', '为 自 己 筑 坛 ， 要 转 去 不 跟 从 耶 和 华 ， 或 是 要 将 燔 祭 、 素 祭 、 平 安 祭 献 在 坛 上 ， 愿 耶 和 华 亲 自 讨 我 们 的 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6451', '6', '22', '24', '我 们 行 这 事 并 非 无 故 ， 是 特 意 做 的 ， 说 ： 恐 怕 日 後 你 们 的 子 孙 对 我 们 的 子 孙 说 ： 你 们 与 耶 和 华 ─ 以 色 列 的 　 神 有 何 关 涉 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6452', '6', '22', '25', '因 为 耶 和 华 把 约 但 河 定 为 我 们 和 你 们 这 流 便 人 、 迦 得 人 的 交 界 ， 你 们 与 耶 和 华 无 分 了 。 这 样 ， 你 们 的 子 孙 就 使 我 们 的 子 孙 不 再 敬 畏 耶 和 华 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6453', '6', '22', '26', '因 此 我 们 说 ： 不 如 为 自 己 筑 一 座 坛 ， 不 是 为 献 燔 祭 ， 也 不 是 为 献 别 的 祭 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6454', '6', '22', '27', '乃 是 为 你 我 中 间 和 你 我 後 人 中 间 作 证 据 ， 好 叫 我 们 也 在 耶 和 华 面 前 献 燔 祭 、 平 安 祭 ， 和 别 的 祭 事 奉 他 ， 免 得 你 们 的 子 孙 日 後 对 我 们 的 子 孙 说 ， 你 们 与 耶 和 华 无 分 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6455', '6', '22', '28', '所 以 我 们 说 ： 日 後 你 们 对 我 们 ， 或 对 我 们 的 後 人 这 样 说 ， 我 们 就 可 以 回 答 说 ， 你 们 看 我 们 列 祖 所 筑 的 坛 是 耶 和 华 坛 的 样 式 ； 这 并 不 是 为 献 燔 祭 ， 也 不 是 为 献 别 的 祭 ， 乃 是 为 作 你 我 中 间 的 证 据 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6456', '6', '22', '29', '我 们 在 耶 和 华 ─ 我 们 　 神 帐 幕 前 的 坛 以 外 ， 另 筑 一 座 坛 ， 为 献 燔 祭 、 素 祭 ， 和 别 的 祭 ， 悖 逆 耶 和 华 ， 今 日 转 去 不 跟 从 他 ， 我 们 断 没 有 这 个 意 思 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6457', '6', '22', '30', '祭 司 非 尼 哈 与 会 中 的 首 领 ， 就 是 与 他 同 来 以 色 列 军 中 的 统 领 ， 听 见 流 便 人 、 迦 得 人 、 玛 拿 西 人 所 说 的 话 ， 就 都 以 为 美 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6458', '6', '22', '31', '祭 司 以 利 亚 撒 的 儿 子 非 尼 哈 对 流 便 人 、 迦 得 人 、 玛 拿 西 人 说 ： 今 日 我 们 知 道 耶 和 华 在 我 们 中 间 ， 因 为 你 们 没 有 向 他 犯 了 这 罪 。 现 在 你 们 救 以 色 列 人 脱 离 耶 和 华 的 手 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6459', '6', '22', '32', '祭 司 以 利 亚 撒 的 儿 子 非 尼 哈 与 众 首 领 离 了 流 便 人 、 迦 得 人 ， 从 基 列 地 回 往 迦 南 地 ， 到 了 以 色 列 人 那 里 ， 便 将 这 事 回 报 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6460', '6', '22', '33', '以 色 列 人 以 这 事 为 美 ， 就 称 颂 　 神 ， 不 再 提 上 去 攻 打 流 便 人 、 迦 得 人 、 毁 坏 他 们 所 住 的 地 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6461', '6', '22', '34', '流 便 人 、 迦 得 人 给 坛 起 名 叫 证 坛 ， 意 思 说 ： 这 坛 在 我 们 中 间 证 明 耶 和 华 是 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6462', '6', '23', '1', '耶 和 华 使 以 色 列 人 安 静 ， 不 与 四 围 的 一 切 仇 敌 争 战 ， 已 经 多 日 。 约 书 亚 年 纪 老 迈 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6463', '6', '23', '2', '就 把 以 色 列 众 人 的 长 老 、 族 长 、 审 判 官 ， 并 官 长 都 召 了 来 ， 对 他 们 说 ： 我 年 纪 已 经 老 迈 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6464', '6', '23', '3', '耶 和 华 ─ 你 们 的 　 神 因 你 们 的 缘 故 向 那 些 国 所 行 的 一 切 事 ， 你 们 亲 眼 看 见 了 ， 因 那 为 你 们 争 战 的 是 耶 和 华 ─ 你 们 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6465', '6', '23', '4', '我 所 剪 除 和 所 剩 下 的 各 国 ， 从 约 但 河 起 到 日 落 之 处 的 大 海 ， 我 已 经 拈 阄 分 给 你 们 各 支 派 为 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6466', '6', '23', '5', '耶 和 华 ─ 你 们 的 　 神 必 将 他 们 从 你 们 面 前 赶 出 去 ， 使 他 们 离 开 你 们 ， 你 们 就 必 得 他 们 的 地 为 业 ， 正 如 耶 和 华 ─ 你 们 的 　 神 所 应 许 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6467', '6', '23', '6', '所 以 ， 你 们 要 大 大 壮 胆 ， 谨 守 遵 行 写 在 摩 西 律 法 书 上 的 一 切 话 ， 不 可 偏 离 左 右 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6468', '6', '23', '7', '不 可 与 你 们 中 间 所 剩 下 的 这 些 国 民 搀 杂 。 他 们 的 　 神 ， 你 们 不 可 提 他 的 名 ， 不 可 指 着 他 起 誓 ， 也 不 可 事 奉 、 叩 拜 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6469', '6', '23', '8', '只 要 照 着 你 们 到 今 日 所 行 的 ， 专 靠 耶 和 华 ─ 你 们 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6470', '6', '23', '9', '因 为 耶 和 华 已 经 把 又 大 又 强 的 国 民 从 你 们 面 前 赶 出 ； 直 到 今 日 ， 没 有 一 人 在 你 们 面 前 站 立 得 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6471', '6', '23', '10', '你 们 一 人 必 追 赶 千 人 ， 因 耶 和 华 ─ 你 们 的 　 神 照 他 所 应 许 的 ， 为 你 们 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6472', '6', '23', '11', '你 们 要 分 外 谨 慎 ， 爱 耶 和 华 ─ 你 们 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6473', '6', '23', '12', '你 们 若 稍 微 转 去 ， 与 你 们 中 间 所 剩 下 的 这 些 国 民 联 络 ， 彼 此 结 亲 ， 互 相 往 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6474', '6', '23', '13', '你 们 要 确 实 知 道 ， 耶 和 华 ─ 你 们 的 　 神 必 不 再 将 他 们 从 你 们 眼 前 赶 出 ； 他 们 却 要 成 为 你 们 的 网 罗 、 机 槛 、 肋 上 的 鞭 、 眼 中 的 刺 ， 直 到 你 们 在 耶 和 华 ─ 你 们 　 神 所 赐 的 这 美 地 上 灭 亡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6475', '6', '23', '14', '我 现 在 要 走 世 人 必 走 的 路 。 你 们 是 一 心 一 意 的 知 道 ， 耶 和 华 ─ 你 们 　 神 所 应 许 赐 福 与 你 们 的 话 没 有 一 句 落 空 ， 都 应 验 在 你 们 身 上 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6476', '6', '23', '15', '耶 和 华 ─ 你 们 　 神 所 应 许 的 一 切 福 气 怎 样 临 到 你 们 身 上 ， 耶 和 华 也 必 照 样 使 各 样 祸 患 临 到 你 们 身 上 ， 直 到 把 你 们 从 耶 和 华 ─ 你 们 　 神 所 赐 的 这 美 地 上 除 灭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6477', '6', '23', '16', '你 们 若 违 背 耶 和 华 ─ 你 们 　 神 吩 咐 你 们 所 守 的 约 ， 去 事 奉 别 　 神 ， 叩 拜 他 ， 耶 和 华 的 怒 气 必 向 你 们 发 作 ， 使 你 们 在 他 所 赐 的 美 地 上 速 速 灭 亡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6478', '6', '24', '1', '约 书 亚 将 以 色 列 的 众 支 派 聚 集 在 示 剑 ， 召 了 以 色 列 的 长 老 、 族 长 、 审 判 官 ， 并 官 长 来 ， 他 们 就 站 在 　 神 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6479', '6', '24', '2', '约 书 亚 对 众 民 说 ： 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 古 时 你 们 的 列 祖 ， 就 是 亚 伯 拉 罕 和 拿 鹤 的 父 亲 他 拉 ， 住 在 大 河 那 边 事 奉 别 　 神 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6480', '6', '24', '3', '我 将 你 们 的 祖 宗 亚 伯 拉 罕 从 大 河 那 边 带 来 ， 领 他 走 遍 迦 南 全 地 ， 又 使 他 的 子 孙 众 多 ， 把 以 撒 赐 给 他 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6481', '6', '24', '4', '又 把 雅 各 和 以 扫 赐 给 以 撒 ， 将 西 珥 山 赐 给 以 扫 为 业 ； 後 来 雅 各 和 他 的 子 孙 下 到 埃 及 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6482', '6', '24', '5', '我 差 遣 摩 西 、 亚 伦 ， 并 照 我 在 埃 及 中 所 行 的 降 灾 与 埃 及 ， 然 後 把 你 们 领 出 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6483', '6', '24', '6', '我 领 你 们 列 祖 出 埃 及 ， 他 们 就 到 了 红 海 ； 埃 及 人 带 领 车 辆 马 兵 追 赶 你 们 列 祖 到 红 海 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6484', '6', '24', '7', '你 们 列 祖 哀 求 耶 和 华 ， 他 就 使 你 们 和 埃 及 人 中 间 黑 暗 了 ， 又 使 海 水 淹 没 埃 及 人 。 我 在 埃 及 所 行 的 事 ， 你 们 亲 眼 见 过 。 你 们 在 旷 野 也 住 了 许 多 年 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6485', '6', '24', '8', '我 领 你 们 到 约 但 河 东 亚 摩 利 人 所 住 之 地 。 他 们 与 你 们 争 战 ， 我 将 他 们 交 在 你 们 手 中 ， 你 们 便 得 了 他 们 的 地 为 业 ； 我 也 在 你 们 面 前 将 他 们 灭 绝 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6486', '6', '24', '9', '那 时 ， 摩 押 王 西 拨 的 儿 子 巴 勒 起 来 攻 击 以 色 列 人 ， 打 发 人 召 了 比 珥 的 儿 子 巴 兰 来 咒 诅 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6487', '6', '24', '10', '我 不 肯 听 巴 兰 的 话 ， 所 以 他 倒 为 你 们 连 连 祝 福 。 这 样 ， 我 便 救 你 们 脱 离 巴 勒 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6488', '6', '24', '11', '你 们 过 了 约 但 河 ， 到 了 耶 利 哥 ； 耶 利 哥 人 、 亚 摩 利 人 、 比 利 洗 人 、 迦 南 人 、 赫 人 、 革 迦 撒 人 、 希 未 人 、 耶 布 斯 人 都 与 你 们 争 战 ； 我 把 他 们 交 在 你 们 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6489', '6', '24', '12', '我 打 发 黄 蜂 飞 在 你 们 前 面 ， 将 亚 摩 利 人 的 二 王 从 你 们 面 前 撵 出 ， 并 不 是 用 你 的 刀 ， 也 不 是 用 你 的 弓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6490', '6', '24', '13', '我 赐 给 你 们 地 土 ， 非 你 们 所 修 治 的 ； 我 赐 给 你 们 城 邑 ， 非 你 们 所 建 造 的 。 你 们 就 住 在 其 中 ， 又 得 吃 非 你 们 所 栽 种 的 葡 萄 园 、 橄 榄 园 的 果 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6491', '6', '24', '14', '现 在 你 们 要 敬 畏 耶 和 华 ， 诚 心 实 意 的 事 奉 他 ， 将 你 们 列 祖 在 大 河 那 边 和 在 埃 及 所 事 奉 的 　 神 除 掉 ， 去 事 奉 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6492', '6', '24', '15', '若 是 你 们 以 事 奉 耶 和 华 为 不 好 ， 今 日 就 可 以 选 择 所 要 事 奉 的 ： 是 你 们 列 祖 在 大 河 那 边 所 事 奉 的 　 神 呢 ？ 是 你 们 所 住 这 地 的 亚 摩 利 人 的 　 神 呢 ？ 至 於 我 和 我 家 ， 我 们 必 定 事 奉 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6493', '6', '24', '16', '百 姓 回 答 说 ： 我 们 断 不 敢 离 弃 耶 和 华 去 事 奉 别 　 神 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6494', '6', '24', '17', '因 耶 和 华 ─ 我 们 的 　 神 曾 将 我 们 和 我 们 列 祖 从 埃 及 地 的 为 奴 之 家 领 出 来 ， 在 我 们 眼 前 行 了 那 些 大 神 迹 ， 在 我 们 所 行 的 道 上 ， 所 经 过 的 诸 国 ， 都 保 护 了 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6495', '6', '24', '18', '耶 和 华 又 把 住 此 地 的 亚 摩 利 人 都 从 我 们 面 前 赶 出 去 。 所 以 ， 我 们 必 事 奉 耶 和 华 ， 因 为 他 是 我 们 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6496', '6', '24', '19', '约 书 亚 对 百 姓 说 ： 你 们 不 能 事 奉 耶 和 华 ； 因 为 他 是 圣 洁 的 　 神 ， 是 忌 邪 的 　 神 ， 必 不 赦 免 你 们 的 过 犯 罪 恶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6497', '6', '24', '20', '你 们 若 离 弃 耶 和 华 去 事 奉 外 邦 　 神 ， 耶 和 华 在 降 福 之 後 ， 必 转 而 降 祸 与 你 们 ， 把 你 们 灭 绝 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6498', '6', '24', '21', '百 姓 回 答 约 书 亚 说 ： 不 然 ， 我 们 定 要 事 奉 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6499', '6', '24', '22', '约 书 亚 对 百 姓 说 ： 你 们 选 定 耶 和 华 ， 要 事 奉 他 ， 你 们 自 己 作 见 证 罢 ！ 他 们 说 ： 我 们 愿 意 作 见 证 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6500', '6', '24', '23', '约 书 亚 说 ： 你 们 现 在 要 除 掉 你 们 中 间 的 外 邦 　 神 ， 专 心 归 向 耶 和 华 ─ 以 色 列 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6501', '6', '24', '24', '百 姓 回 答 约 书 亚 说 ： 我 们 必 事 奉 耶 和 华 ─ 我 们 的 　 神 ， 听 从 他 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6502', '6', '24', '25', '当 日 ， 约 书 亚 就 与 百 姓 立 约 ， 在 示 剑 为 他 们 立 定 律 例 典 章 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6503', '6', '24', '26', '约 书 亚 将 这 些 话 都 写 在 　 神 的 律 法 书 上 ， 又 将 一 块 大 石 头 立 在 橡 树 下 耶 和 华 的 圣 所 旁 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6504', '6', '24', '27', '约 书 亚 对 百 姓 说 ： 看 哪 ， 这 石 头 可 以 向 我 们 作 见 证 ； 因 为 是 听 见 了 耶 和 华 所 吩 咐 我 们 的 一 切 话 ， 倘 或 你 们 背 弃 你 们 的 　 神 ， 这 石 头 就 可 以 向 你 们 作 见 证 （ 倘 或 云 云 ： 或 作 所 以 要 向 你 们 作 见 证 ， 免 得 你 们 背 弃 耶 和 华 ─ 你 们 的 　 神 ） 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6505', '6', '24', '28', '於 是 约 书 亚 打 发 百 姓 各 归 自 己 的 地 业 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6506', '6', '24', '29', '这 些 事 以 後 ， 耶 和 华 的 仆 人 嫩 的 儿 子 约 书 亚 ， 正 一 百 一 十 岁 ， 就 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6507', '6', '24', '30', '以 色 列 人 将 他 葬 在 他 地 业 的 境 内 ， 就 是 在 以 法 莲 山 地 的 亭 拿 西 拉 ， 在 迦 实 山 的 北 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6508', '6', '24', '31', '约 书 亚 在 世 和 约 书 亚 死 後 ， 那 些 知 道 耶 和 华 为 以 色 列 人 所 行 诸 事 的 长 老 还 在 的 时 候 ， 以 色 列 人 事 奉 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6509', '6', '24', '32', '以 色 列 人 从 埃 及 所 带 来 约 瑟 的 骸 骨 ， 葬 埋 在 示 剑 ， 就 是 在 雅 各 从 前 用 一 百 块 银 子 向 示 剑 的 父 亲 、 哈 抹 的 子 孙 所 买 的 那 块 地 里 ； 这 就 作 了 约 瑟 子 孙 的 产 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6510', '6', '24', '33', '亚 伦 的 儿 子 以 利 亚 撒 也 死 了 ， 就 把 他 葬 在 他 儿 子 非 尼 哈 所 得 、 以 法 莲 山 地 的 小 山 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6511', '7', '1', '1', '约 书 亚 死 後 ， 以 色 列 人 求 问 耶 和 华 说 ： 我 们 中 间 谁 当 首 先 上 去 攻 击 迦 南 人 ， 与 他 们 争 战 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6512', '7', '1', '2', '耶 和 华 说 ： 犹 大 当 先 上 去 ， 我 已 将 那 地 交 在 他 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6513', '7', '1', '3', '犹 大 对 他 哥 哥 西 缅 说 ： 请 你 同 我 到 拈 阄 所 得 之 地 去 ， 好 与 迦 南 人 争 战 ； 以 後 我 也 同 你 到 你 拈 阄 所 得 之 地 去 。 於 是 西 缅 与 他 同 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6514', '7', '1', '4', '犹 大 就 上 去 ； 耶 和 华 将 迦 南 人 和 比 利 洗 人 交 在 他 们 手 中 。 他 们 在 比 色 击 杀 了 一 万 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6515', '7', '1', '5', '又 在 那 里 遇 见 亚 多 尼 比 色 ， 与 他 争 战 ， 杀 败 迦 南 人 和 比 利 洗 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6516', '7', '1', '6', '亚 多 尼 比 色 逃 跑 ； 他 们 追 赶 ， 拿 住 他 ， 砍 断 他 手 脚 的 大 姆 指 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6517', '7', '1', '7', '亚 多 尼 比 色 说 ： 从 前 有 七 十 个 王 ， 手 脚 的 大 姆 指 都 被 我 砍 断 ， 在 我 桌 子 底 下 拾 取 零 碎 食 物 。 现 在 　 神 按 着 我 所 行 的 报 应 我 了 。 於 是 他 们 将 亚 多 尼 比 色 带 到 耶 路 撒 冷 ， 他 就 死 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6518', '7', '1', '8', '犹 大 人 攻 打 耶 路 撒 冷 ， 将 城 攻 取 ， 用 刀 杀 了 城 内 的 人 ， 并 且 放 火 烧 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6519', '7', '1', '9', '後 来 犹 大 人 下 去 ， 与 住 山 地 、 南 地 ， 和 高 原 的 迦 南 人 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6520', '7', '1', '10', '犹 大 人 去 攻 击 住 希 伯 仑 的 迦 南 人 ， 杀 了 示 筛 、 亚 希 幔 、 挞 买 。 希 伯 仑 从 前 名 叫 基 列 亚 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6521', '7', '1', '11', '他 们 从 那 里 去 攻 击 底 壁 的 居 民 ； 底 壁 从 前 名 叫 基 列 西 弗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6522', '7', '1', '12', '迦 勒 说 ： 谁 能 攻 打 基 列 西 弗 ， 将 城 夺 取 ， 我 就 把 我 女 儿 押 撒 给 他 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6523', '7', '1', '13', '迦 勒 兄 弟 基 纳 斯 的 儿 子 俄 陀 聂 夺 取 了 那 城 ， 迦 勒 就 把 女 儿 押 撒 给 他 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6524', '7', '1', '14', '押 撒 过 门 的 时 候 ， 劝 丈 夫 向 他 父 亲 求 一 块 田 。 押 撒 一 下 驴 ， 迦 勒 问 他 说 ： 你 要 甚 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6525', '7', '1', '15', '他 说 ： 求 你 赐 福 给 我 ， 你 既 将 我 安 置 在 南 地 ， 求 你 也 给 我 水 泉 。 迦 勒 就 把 上 泉 下 泉 赐 给 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6526', '7', '1', '16', '摩 西 的 内 兄 （ 或 译 ： 岳 父 ） 是 基 尼 人 ， 他 的 子 孙 与 犹 大 人 一 同 离 了 棕 树 城 ， 往 亚 拉 得 以 南 的 犹 大 旷 野 去 ， 就 住 在 民 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6527', '7', '1', '17', '犹 大 和 他 哥 哥 西 缅 同 去 ， 击 杀 了 住 洗 法 的 迦 南 人 ， 将 城 尽 行 毁 灭 ， 那 城 的 名 便 叫 何 珥 玛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6528', '7', '1', '18', '犹 大 又 取 了 迦 萨 和 迦 萨 的 四 境 ， 亚 实 基 伦 和 亚 实 基 伦 的 四 境 ， 以 革 伦 和 以 革 伦 的 四 境 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6529', '7', '1', '19', '耶 和 华 与 犹 大 同 在 ， 犹 大 就 赶 出 山 地 的 居 民 ， 只 是 不 能 赶 出 平 原 的 居 民 ， 因 为 他 们 有 铁 车 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6530', '7', '1', '20', '以 色 列 人 照 摩 西 所 说 的 ， 将 希 伯 仑 给 了 迦 勒 ； 迦 勒 就 从 那 里 赶 出 亚 衲 族 的 三 个 族 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6531', '7', '1', '21', '便 雅 悯 人 没 有 赶 出 住 耶 路 撒 冷 的 耶 布 斯 人 。 耶 布 斯 人 仍 在 耶 路 撒 冷 与 便 雅 悯 人 同 住 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6532', '7', '1', '22', '约 瑟 家 也 上 去 攻 打 伯 特 利 ； 耶 和 华 与 他 们 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6533', '7', '1', '23', '约 瑟 家 打 发 人 去 窥 探 伯 特 利 （ 那 城 起 先 名 叫 路 斯 ） 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6534', '7', '1', '24', '窥 探 的 人 看 见 一 个 人 从 城 里 出 来 ， 就 对 他 说 ： 求 你 将 进 城 的 路 指 示 我 们 ， 我 们 必 恩 待 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6535', '7', '1', '25', '那 人 将 进 城 的 路 指 示 他 们 ， 他 们 就 用 刀 击 杀 了 城 中 的 居 民 ， 但 将 那 人 和 他 全 家 放 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6536', '7', '1', '26', '那 人 往 赫 人 之 地 去 ， 筑 了 一 座 城 ， 起 名 叫 路 斯 。 那 城 到 如 今 还 叫 这 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6537', '7', '1', '27', '玛 拿 西 没 有 赶 出 伯 善 和 属 伯 善 乡 村 的 居 民 ， 他 纳 和 属 他 纳 乡 村 的 居 民 ， 多 珥 和 属 多 珥 乡 村 的 居 民 ， 以 伯 莲 和 属 以 伯 莲 乡 村 的 居 民 ， 米 吉 多 和 属 米 吉 多 乡 村 的 居 民 ； 迦 南 人 却 执 意 住 在 那 些 地 方 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6538', '7', '1', '28', '及 至 以 色 列 强 盛 了 ， 就 使 迦 南 人 作 苦 工 ， 没 有 把 他 们 全 然 赶 出 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6539', '7', '1', '29', '以 法 莲 没 有 赶 出 住 基 色 的 迦 南 人 。 於 是 迦 南 人 仍 住 在 基 色 ， 在 以 法 莲 中 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6540', '7', '1', '30', '西 布 伦 没 有 赶 出 基 伦 的 居 民 和 拿 哈 拉 的 居 民 。 於 是 迦 南 人 仍 住 在 西 布 伦 中 间 ， 成 了 服 苦 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6541', '7', '1', '31', '亚 设 没 有 赶 出 亚 柯 和 西 顿 的 居 民 ， 亚 黑 拉 和 亚 革 悉 的 居 民 ， 黑 巴 、 亚 弗 革 与 利 合 的 居 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6542', '7', '1', '32', '於 是 ， 亚 设 因 为 没 有 赶 出 那 地 的 迦 南 人 ， 就 住 在 他 们 中 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6543', '7', '1', '33', '拿 弗 他 利 没 有 赶 出 伯 示 麦 和 伯 亚 纳 的 居 民 ， 於 是 拿 弗 他 利 就 住 在 那 地 的 迦 南 人 中 间 ； 然 而 伯 示 麦 和 伯 亚 纳 的 居 民 成 了 服 苦 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6544', '7', '1', '34', '亚 摩 利 人 强 逼 但 人 住 在 山 地 ， 不 容 他 们 下 到 平 原 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6545', '7', '1', '35', '亚 摩 利 人 却 执 意 住 在 希 烈 山 和 亚 雅 伦 并 沙 宾 。 然 而 约 瑟 家 胜 了 他 们 ， 使 他 们 成 了 服 苦 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6546', '7', '1', '36', '亚 摩 利 人 的 境 界 ， 是 从 亚 克 拉 滨 坡 ， 从 西 拉 而 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6547', '7', '2', '1', '耶 和 华 的 使 者 从 吉 甲 上 到 波 金 ， 对 以 色 列 人 说 ： 我 使 你 们 从 埃 及 上 来 ， 领 你 们 到 我 向 你 们 列 祖 起 誓 应 许 之 地 。 我 又 说 ： 我 永 不 废 弃 与 你 们 所 立 的 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6548', '7', '2', '2', '你 们 也 不 可 与 这 地 的 居 民 立 约 ， 要 拆 毁 他 们 的 祭 坛 。 你 们 竟 没 有 听 从 我 的 话 ！ 为 何 这 样 行 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6549', '7', '2', '3', '因 此 我 又 说 ： 我 必 不 将 他 们 从 你 们 面 前 赶 出 ； 他 们 必 作 你 们 肋 下 的 荆 棘 。 他 们 的 　 神 必 作 你 们 的 网 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6550', '7', '2', '4', '耶 和 华 的 使 者 向 以 色 列 众 人 说 这 话 的 时 候 ， 百 姓 就 放 声 而 哭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6551', '7', '2', '5', '於 是 给 那 地 方 起 名 叫 波 金 （ 就 是 哭 的 意 思 ） 。 众 人 在 那 里 向 耶 和 华 献 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6552', '7', '2', '6', '从 前 约 书 亚 打 发 以 色 列 百 姓 去 的 时 候 ， 他 们 各 归 自 己 的 地 业 ， 占 据 地 土 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6553', '7', '2', '7', '约 书 亚 在 世 和 约 书 亚 死 後 ， 那 些 见 耶 和 华 为 以 色 列 人 所 行 大 事 的 长 老 还 在 的 时 候 ， 百 姓 都 事 奉 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6554', '7', '2', '8', '耶 和 华 的 仆 人 、 嫩 的 儿 子 约 书 亚 ， 正 一 百 一 十 岁 就 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6555', '7', '2', '9', '以 色 列 人 将 他 葬 在 他 地 业 的 境 内 ， 就 是 在 以 法 莲 山 地 的 亭 拿 希 烈 ， 在 迦 实 山 的 北 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6556', '7', '2', '10', '那 世 代 的 人 也 都 归 了 自 己 的 列 祖 。 後 来 有 别 的 世 代 兴 起 ， 不 知 道 耶 和 华 ， 也 不 知 道 耶 和 华 为 以 色 列 人 所 行 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6557', '7', '2', '11', '以 色 列 人 行 耶 和 华 眼 中 看 为 恶 的 事 ， 去 事 奉 诸 巴 力 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6558', '7', '2', '12', '离 弃 了 领 他 们 出 埃 及 地 的 耶 和 华 ─ 他 们 列 祖 的 　 神 ， 去 叩 拜 别 　 神 ， 就 是 四 围 列 国 的 　 神 ， 惹 耶 和 华 发 怒 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6559', '7', '2', '13', '并 离 弃 耶 和 华 ， 去 事 奉 巴 力 和 亚 斯 他 录 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6560', '7', '2', '14', '耶 和 华 的 怒 气 向 以 色 列 人 发 作 ， 就 把 他 们 交 在 抢 夺 他 们 的 人 手 中 ， 又 将 他 们 付 与 四 围 仇 敌 的 手 中 ， 甚 至 他 们 在 仇 敌 面 前 再 不 能 站 立 得 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6561', '7', '2', '15', '他 们 无 论 往 何 处 去 ， 耶 和 华 都 以 灾 祸 攻 击 他 们 ， 正 如 耶 和 华 所 说 的 话 ， 又 如 耶 和 华 向 他 们 所 起 的 誓 ； 他 们 便 极 其 困 苦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6562', '7', '2', '16', '耶 和 华 兴 起 士 师 ， 士 师 就 拯 救 他 们 脱 离 抢 夺 他 们 人 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6563', '7', '2', '17', '他 们 却 不 听 从 士 师 ， 竟 随 从 叩 拜 别 　 神 ， 行 了 邪 淫 ， 速 速 地 偏 离 他 们 列 祖 所 行 的 道 ， 不 如 他 们 列 祖 顺 从 耶 和 华 的 命 令 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6564', '7', '2', '18', '耶 和 华 为 他 们 兴 起 士 师 ， 就 与 那 士 师 同 在 。 士 师 在 世 的 一 切 日 子 ， 耶 和 华 拯 救 他 们 脱 离 仇 敌 的 手 。 他 们 因 受 欺 压 扰 害 ， 就 哀 声 叹 气 ， 所 以 耶 和 华 後 悔 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6565', '7', '2', '19', '及 至 士 师 死 後 ， 他 们 就 转 去 行 恶 ， 比 他 们 列 祖 更 甚 ， 去 事 奉 叩 拜 别 　 神 ， 总 不 断 绝 顽 梗 的 恶 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6566', '7', '2', '20', '於 是 耶 和 华 的 怒 气 向 以 色 列 人 发 作 。 他 说 ： 因 这 民 违 背 我 吩 咐 他 们 列 祖 所 守 的 约 ， 不 听 从 我 的 话 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6567', '7', '2', '21', '所 以 约 书 亚 死 的 时 候 所 剩 下 的 各 族 ， 我 必 不 再 从 他 们 面 前 赶 出 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6568', '7', '2', '22', '为 要 藉 此 试 验 以 色 列 人 ， 看 他 们 肯 照 他 们 列 祖 谨 守 遵 行 我 的 道 不 肯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6569', '7', '2', '23', '这 样 耶 和 华 留 下 各 族 ， 不 将 他 们 速 速 赶 出 ， 也 没 有 交 付 约 书 亚 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6570', '7', '3', '1', '耶 和 华 留 下 这 几 族 ， 为 要 试 验 那 不 曾 知 道 与 迦 南 争 战 之 事 的 以 色 列 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6571', '7', '3', '2', '好 叫 以 色 列 的 後 代 又 知 道 又 学 习 未 曾 晓 得 的 战 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6572', '7', '3', '3', '所 留 下 的 就 是 非 利 士 的 五 个 首 领 和 一 切 迦 南 人 、 西 顿 人 ， 并 住 利 巴 嫩 山 的 希 未 人 ， 从 巴 力 黑 们 山 直 到 哈 马 口 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6573', '7', '3', '4', '留 下 这 几 族 ， 为 要 试 验 以 色 列 人 ， 知 道 他 们 肯 听 从 耶 和 华 藉 摩 西 吩 咐 他 们 列 祖 的 诫 命 不 肯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6574', '7', '3', '5', '以 色 列 人 竟 住 在 迦 南 人 、 赫 人 、 亚 摩 利 人 、 比 利 洗 人 、 希 未 人 、 耶 布 斯 人 中 间 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6575', '7', '3', '6', '娶 他 们 的 女 儿 为 妻 ， 将 自 己 的 女 儿 嫁 给 他 们 的 儿 子 ， 并 事 奉 他 们 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6576', '7', '3', '7', '以 色 列 人 行 耶 和 华 眼 中 看 为 恶 的 事 ， 忘 记 耶 和 华 ─ 他 们 的 　 神 ， 去 事 奉 诸 巴 力 和 亚 舍 拉 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6577', '7', '3', '8', '所 以 耶 和 华 的 怒 气 向 以 色 列 人 发 作 ， 就 把 他 们 交 在 米 所 波 大 米 王 古 珊 利 萨 田 的 手 中 。 以 色 列 人 服 事 古 珊 利 萨 田 八 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6578', '7', '3', '9', '以 色 列 人 呼 求 耶 和 华 的 时 候 ， 耶 和 华 就 为 他 们 兴 起 一 位 拯 救 者 救 他 们 ， 就 是 迦 勒 兄 弟 基 纳 斯 的 儿 子 俄 陀 聂 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6579', '7', '3', '10', '耶 和 华 的 灵 降 在 他 身 上 ， 他 就 作 了 以 色 列 的 士 师 ， 出 去 争 战 。 耶 和 华 将 米 所 波 大 米 王 古 珊 利 萨 田 交 在 他 手 中 ， 他 便 胜 了 古 珊 利 萨 田 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6580', '7', '3', '11', '於 是 国 中 太 平 四 十 年 。 基 纳 斯 的 儿 子 俄 陀 聂 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6581', '7', '3', '12', '以 色 列 人 又 行 耶 和 华 眼 中 看 为 恶 的 事 ， 耶 和 华 就 使 摩 押 王 伊 矶 伦 强 盛 ， 攻 击 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6582', '7', '3', '13', '伊 矶 伦 招 聚 亚 扪 人 和 亚 玛 力 人 ， 去 攻 打 以 色 列 人 ， 占 据 棕 树 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6583', '7', '3', '14', '於 是 以 色 列 人 服 事 摩 押 王 伊 矶 伦 十 八 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6584', '7', '3', '15', '以 色 列 人 呼 求 耶 和 华 的 时 候 ， 耶 和 华 就 为 他 们 兴 起 一 位 拯 救 者 ， 就 是 便 雅 悯 人 基 拉 的 儿 子 以 笏 ； 他 是 左 手 便 利 的 。 以 色 列 人 托 他 送 礼 物 给 摩 押 王 伊 矶 伦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6585', '7', '3', '16', '以 笏 打 了 一 把 两 刃 的 剑 ， 长 一 肘 ， 带 在 右 腿 衣 服 里 面 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6586', '7', '3', '17', '他 将 礼 物 献 给 摩 押 王 伊 矶 伦 （ 原 来 伊 矶 伦 极 其 肥 胖 ） ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6587', '7', '3', '18', '以 笏 献 完 礼 物 ， 便 将 抬 礼 物 的 人 打 发 走 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6588', '7', '3', '19', '自 己 却 从 靠 近 吉 甲 凿 石 之 地 回 来 ， 说 ： 王 啊 ， 我 有 一 件 机 密 事 奏 告 你 。 王 说 ： ? 避 罢 ！ 於 是 左 右 侍 立 的 人 都 退 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6589', '7', '3', '20', '以 笏 来 到 王 面 前 ； 王 独 自 一 人 坐 在 凉 楼 上 。 以 笏 说 ： 我 奉 　 神 的 命 报 告 你 一 件 事 。 王 就 从 座 位 上 站 起 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6590', '7', '3', '21', '以 笏 便 伸 左 手 ， 从 右 腿 上 拔 出 剑 来 ， 刺 入 王 的 肚 腹 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6591', '7', '3', '22', '连 剑 把 都 刺 进 去 了 。 剑 被 肥 肉 夹 住 ， 他 没 有 从 王 的 肚 腹 拔 出 来 ， 且 穿 通 了 後 身 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6592', '7', '3', '23', '以 笏 就 出 到 游 廊 ， 将 楼 门 尽 都 关 锁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6593', '7', '3', '24', '以 笏 出 来 之 後 ， 王 的 仆 人 到 了 ， 看 见 楼 门 关 锁 ， 就 说 ： 他 必 是 在 楼 上 大 解 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6594', '7', '3', '25', '他 们 等 烦 了 ， 见 仍 不 开 楼 门 ， 就 拿 钥 匙 开 了 ， 不 料 ， 他 们 的 主 人 已 死 ， 倒 在 地 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6595', '7', '3', '26', '他 们 耽 延 的 时 候 ， 以 笏 就 逃 跑 了 ， 经 过 凿 石 之 地 ， 逃 到 西 伊 拉 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6596', '7', '3', '27', '到 了 ， 就 在 以 法 莲 山 地 吹 角 。 以 色 列 人 随 着 他 下 了 山 地 ， 他 在 前 头 引 路 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6597', '7', '3', '28', '对 他 们 说 ： 你 们 随 我 来 ， 因 为 耶 和 华 已 经 把 你 们 的 仇 敌 摩 押 人 交 在 你 们 手 中 。 於 是 他 们 跟 着 他 下 去 ， 把 守 约 但 河 的 渡 口 ， 不 容 摩 押 一 人 过 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6598', '7', '3', '29', '那 时 击 杀 了 摩 押 人 约 有 一 万 ， 都 是 强 壮 的 勇 士 ， 没 有 一 人 逃 脱 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6599', '7', '3', '30', '这 样 ， 摩 押 就 被 以 色 列 人 制 伏 了 。 国 中 太 平 八 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6600', '7', '3', '31', '以 笏 之 後 ， 有 亚 拿 的 儿 子 珊 迦 ， 他 用 赶 牛 的 棍 子 打 死 六 百 非 利 士 人 。 他 也 救 了 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6601', '7', '4', '1', '以 笏 死 後 ， 以 色 列 人 又 行 耶 和 华 眼 中 看 为 恶 的 事 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6602', '7', '4', '2', '耶 和 华 就 把 他 们 付 与 在 夏 琐 作 王 的 迦 南 王 耶 宾 手 中 ； 他 的 将 军 是 西 西 拉 ， 住 在 外 邦 人 的 夏 罗 设 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6603', '7', '4', '3', '耶 宾 王 有 铁 车 九 百 辆 。 他 大 大 欺 压 以 色 列 人 二 十 年 ， 以 色 列 人 就 呼 求 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6604', '7', '4', '4', '有 一 位 女 先 知 名 叫 底 波 拉 ， 是 拉 比 多 的 妻 ， 当 时 作 以 色 列 的 士 师 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6605', '7', '4', '5', '他 住 在 以 法 莲 山 地 拉 玛 和 伯 特 利 中 间 ， 在 底 波 拉 的 棕 树 下 。 以 色 列 人 都 上 他 那 里 去 听 判 断 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6606', '7', '4', '6', '他 打 发 人 从 拿 弗 他 利 的 基 低 斯 将 亚 比 挪 ? 的 儿 子 巴 拉 召 了 来 ， 对 他 说 ： 耶 和 华 ─ 以 色 列 的 　 神 吩 咐 你 说 ： 你 率 领 一 万 拿 弗 他 利 和 西 布 伦 人 上 他 泊 山 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6607', '7', '4', '7', '我 必 使 耶 宾 的 将 军 西 西 拉 率 领 他 的 车 辆 和 全 军 往 基 顺 河 ， 到 你 那 里 去 ； 我 必 将 他 交 在 你 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6608', '7', '4', '8', '巴 拉 说 ： 你 若 同 我 去 ， 我 就 去 ； 你 若 不 同 我 去 ， 我 就 不 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6609', '7', '4', '9', '底 波 拉 说 ： 我 必 与 你 同 去 ， 只 是 你 在 所 行 的 路 上 得 不 着 荣 耀 ， 因 为 耶 和 华 要 将 西 西 拉 交 在 一 个 妇 人 手 里 。 於 是 底 波 拉 起 来 ， 与 巴 拉 一 同 往 基 低 斯 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6610', '7', '4', '10', '巴 拉 就 招 聚 西 布 伦 人 和 拿 弗 他 利 人 到 基 低 斯 ， 跟 他 上 去 的 有 一 万 人 。 底 波 拉 也 同 他 上 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6611', '7', '4', '11', '摩 西 岳 父 （ 或 译 ： 内 兄 ） 何 巴 的 後 裔 ， 基 尼 人 希 百 曾 离 开 基 尼 族 ， 到 靠 近 基 低 斯 撒 拿 音 的 橡 树 旁 支 搭 帐 棚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6612', '7', '4', '12', '有 人 告 诉 西 西 拉 说 ： 亚 比 挪 ? 的 儿 子 巴 拉 已 经 上 他 泊 山 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6613', '7', '4', '13', '西 西 拉 就 聚 集 所 有 的 铁 车 九 百 辆 ， 和 跟 随 他 的 全 军 ， 从 外 邦 人 的 夏 罗 设 出 来 ， 到 了 基 顺 河 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6614', '7', '4', '14', '底 波 拉 对 巴 拉 说 ： 你 起 来 ， 今 日 就 是 耶 和 华 将 西 西 拉 交 在 你 手 的 日 子 。 耶 和 华 岂 不 在 你 前 头 行 麽 ？ 於 是 巴 拉 下 了 他 泊 山 ， 跟 随 他 有 一 万 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6615', '7', '4', '15', '耶 和 华 使 西 西 拉 和 他 一 切 车 辆 全 军 溃 乱 ， 在 巴 拉 面 前 被 刀 杀 败 ； 西 西 拉 下 车 步 行 逃 跑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6616', '7', '4', '16', '巴 拉 追 赶 车 辆 、 军 队 ， 直 到 外 邦 人 的 夏 罗 设 。 西 西 拉 的 全 军 都 倒 在 刀 下 ， 没 有 留 下 一 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6617', '7', '4', '17', '只 有 西 西 拉 步 行 逃 跑 ， 到 了 基 尼 人 希 百 之 妻 雅 亿 的 帐 棚 ， 因 为 夏 琐 王 耶 宾 与 基 尼 人 希 百 家 和 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6618', '7', '4', '18', '雅 亿 出 来 迎 接 西 西 拉 ， 对 他 说 ： 请 我 主 进 来 ， 不 要 惧 怕 ； 西 西 拉 就 进 了 他 的 帐 棚 。 雅 忆 用 被 将 他 遮 盖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6619', '7', '4', '19', '西 西 拉 对 雅 亿 说 ： 我 渴 了 ， 求 你 给 我 一 点 水 喝 。 雅 亿 就 打 开 皮 袋 ， 给 他 奶 子 喝 ， 仍 旧 把 他 遮 盖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6620', '7', '4', '20', '西 西 拉 又 对 雅 亿 说 ： 请 你 站 在 帐 棚 门 口 ， 若 有 人 来 问 你 说 ： 有 人 在 这 里 没 有 ？ 你 就 说 ： 没 有 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6621', '7', '4', '21', '西 西 拉 疲 乏 沉 睡 。 希 百 的 妻 雅 亿 取 了 帐 棚 的 橛 子 ， 手 里 拿 着 锤 子 ， 轻 悄 悄 地 到 他 旁 边 ， 将 橛 子 从 他 鬓 边 钉 进 去 ， 钉 入 地 里 。 西 西 拉 就 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6622', '7', '4', '22', '巴 拉 追 赶 西 西 拉 的 时 候 ， 雅 亿 出 来 迎 接 他 说 ： 来 罢 ， 我 将 你 所 寻 找 的 人 给 你 看 。 他 就 进 入 帐 棚 ， 看 见 西 西 拉 已 经 死 了 ， 倒 在 地 上 ， 橛 子 还 在 他 鬓 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6623', '7', '4', '23', '这 样 ， 　 神 使 迦 南 王 耶 宾 被 以 色 列 人 制 伏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6624', '7', '4', '24', '从 此 以 色 列 人 的 手 越 发 有 力 ， 胜 了 迦 南 王 耶 宾 ， 直 到 将 他 灭 绝 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6625', '7', '5', '1', '那 时 ， 底 波 拉 和 亚 比 挪 ? 的 儿 子 巴 拉 作 歌 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6626', '7', '5', '2', '因 为 以 色 列 中 有 军 长 率 领 ， 百 姓 也 甘 心 牺 牲 自 己 ， 你 们 应 当 颂 赞 耶 和 华 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6627', '7', '5', '3', '君 王 啊 ， 要 听 ！ 王 子 啊 ， 要 侧 耳 而 听 ！ 我 要 向 耶 和 华 歌 唱 ； 我 要 歌 颂 耶 和 华 ─ 以 色 列 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6628', '7', '5', '4', '耶 和 华 啊 ， 你 从 西 珥 出 来 ， 由 以 东 地 行 走 。 那 时 地 震 天 漏 ， 云 也 落 雨 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6629', '7', '5', '5', '山 见 耶 和 华 的 面 就 震 动 ， 西 乃 山 见 耶 和 华 ─ 以 色 列 　 神 的 面 也 是 如 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6630', '7', '5', '6', '在 亚 拿 之 子 珊 迦 的 时 候 ， 又 在 雅 亿 的 日 子 ， 大 道 无 人 行 走 ， 都 是 绕 道 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6631', '7', '5', '7', '以 色 列 中 的 官 长 停 职 ， 直 到 我 底 波 拉 兴 起 ， 等 我 兴 起 作 以 色 列 的 母 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6632', '7', '5', '8', '以 色 列 人 选 择 新 　 神 ， 争 战 的 事 就 临 到 城 门 。 那 时 ， 以 色 列 四 万 人 中 岂 能 见 盾 牌 枪 矛 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6633', '7', '5', '9', '我 心 倾 向 以 色 列 的 首 领 ， 他 们 在 民 中 甘 心 牺 牲 自 己 。 你 们 应 当 颂 赞 耶 和 华 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6634', '7', '5', '10', '骑 白 驴 的 、 坐 绣 花 毯 子 的 、 行 路 的 ， 你 们 都 当 传 扬 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6635', '7', '5', '11', '在 远 离 弓 箭 响 声 打 水 之 处 ， 人 必 述 说 耶 和 华 公 义 的 作 为 ， 就 是 他 治 理 以 色 列 公 义 的 作 为 。 那 时 耶 和 华 的 民 下 到 城 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6636', '7', '5', '12', '底 波 拉 啊 ， 兴 起 ！ 兴 起 ！ 你 当 兴 起 ， 兴 起 ， 唱 歌 。 亚 比 挪 ? 的 儿 子 巴 拉 啊 ， 你 当 奋 兴 ， 掳 掠 你 的 敌 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6637', '7', '5', '13', '那 时 有 馀 剩 的 贵 胄 和 百 姓 一 同 下 来 ； 耶 和 华 降 临 ， 为 我 攻 击 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6638', '7', '5', '14', '有 根 本 在 亚 玛 力 人 的 地 ， 从 以 法 莲 下 来 的 ； 便 雅 悯 在 民 中 跟 随 。 有 掌 权 的 从 玛 吉 下 来 ； 有 持 杖 检 点 民 数 的 从 西 布 伦 下 来 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6639', '7', '5', '15', '以 萨 迦 的 首 领 与 底 波 拉 同 来 ； 以 萨 迦 怎 样 ， 巴 拉 也 怎 样 。 众 人 都 跟 随 巴 拉 冲 下 平 原 ； 在 流 便 的 溪 水 旁 有 心 中 定 大 志 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6640', '7', '5', '16', '你 为 何 坐 在 羊 圈 内 听 群 中 吹 笛 的 声 音 呢 ？ 在 流 便 的 溪 水 旁 有 心 中 设 大 谋 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6641', '7', '5', '17', '基 列 人 安 居 在 约 但 河 外 。 但 人 为 何 等 在 船 上 ？ 亚 设 人 在 海 口 静 坐 ， 在 港 口 安 居 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6642', '7', '5', '18', '西 布 伦 人 是 拚 命 敢 死 的 ； 拿 弗 他 利 人 在 田 野 的 高 处 也 是 如 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6643', '7', '5', '19', '君 王 都 来 争 战 。 那 时 迦 南 诸 王 在 米 吉 多 水 旁 的 他 纳 争 战 ， 却 未 得 掳 掠 银 钱 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6644', '7', '5', '20', '星 宿 从 天 上 争 战 ， 从 其 轨 道 攻 击 西 西 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6645', '7', '5', '21', '基 顺 古 河 把 敌 人 冲 没 ； 我 的 灵 啊 ， 应 当 努 力 前 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6646', '7', '5', '22', '那 时 壮 马 驰 驱 ， 踢 跳 ， 奔 腾 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6647', '7', '5', '23', '耶 和 华 的 使 者 说 ： 应 当 咒 诅 米 罗 斯 ， 大 大 咒 诅 其 中 的 居 民 ； 因 为 他 们 不 来 帮 助 耶 和 华 ， 不 来 帮 助 耶 和 华 攻 击 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6648', '7', '5', '24', '愿 基 尼 人 希 百 的 妻 雅 亿 比 众 妇 人 多 得 福 气 ， 比 住 帐 棚 的 妇 人 更 蒙 福 祉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6649', '7', '5', '25', '西 西 拉 求 水 ， 雅 亿 给 他 奶 子 ， 用 宝 贵 的 盘 子 给 他 奶 油 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6650', '7', '5', '26', '雅 亿 左 手 拿 着 帐 棚 的 橛 子 ， 右 手 拿 着 匠 人 的 锤 子 ， 击 打 西 西 拉 ， 打 伤 他 的 头 ， 把 他 的 鬓 角 打 破 穿 通 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6651', '7', '5', '27', '西 西 拉 在 他 脚 前 曲 身 仆 倒 ， 在 他 脚 前 曲 身 倒 卧 ； 在 那 里 曲 身 ， 就 在 那 里 死 亡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6652', '7', '5', '28', '西 西 拉 的 母 亲 从 窗 户 里 往 外 观 看 ， 从 窗 棂 中 呼 叫 说 ： 他 的 战 车 为 何 耽 延 不 来 呢 ？ 他 的 车 轮 为 何 行 得 慢 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6653', '7', '5', '29', '聪 明 的 宫 女 安 慰 他 （ 原 文 是 回 答 他 ） ， 他 也 自 言 自 语 地 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6654', '7', '5', '30', '他 们 莫 非 得 财 而 分 ？ 每 人 得 了 一 两 个 女 子 ？ 西 西 拉 得 了 彩 衣 为 掳 物 ， 得 绣 花 的 彩 衣 为 掠 物 。 这 彩 衣 两 面 绣 花 ， 乃 是 披 在 被 掳 之 人 颈 项 上 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6655', '7', '5', '31', '耶 和 华 啊 ， 愿 你 的 仇 敌 都 这 样 灭 亡 ！ 愿 爱 你 的 人 如 日 头 出 现 ， 光 辉 烈 烈 ！ 这 样 ， 国 中 太 平 四 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6656', '7', '6', '1', '以 色 列 人 又 行 耶 和 华 眼 中 看 为 恶 的 事 ， 耶 和 华 就 把 他 们 交 在 米 甸 人 手 里 七 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6657', '7', '6', '2', '米 甸 人 压 制 以 色 列 人 ； 以 色 列 人 因 为 米 甸 人 ， 就 在 山 中 挖 穴 、 挖 洞 、 建 造 营 寨 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6658', '7', '6', '3', '以 色 列 人 每 逢 撒 种 之 後 ， 米 甸 人 、 亚 玛 力 人 ， 和 东 方 人 都 上 来 攻 打 他 们 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6659', '7', '6', '4', '对 着 他 们 安 营 ， 毁 坏 土 产 ， 直 到 迦 萨 ， 没 有 给 以 色 列 人 留 下 食 物 ， 牛 、 羊 、 驴 也 没 有 留 下 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6660', '7', '6', '5', '因 为 那 些 人 带 着 牲 畜 帐 棚 来 ， 像 蝗 虫 那 样 多 ， 人 和 骆 驼 无 数 ， 都 进 入 国 内 ， 毁 坏 全 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6661', '7', '6', '6', '以 色 列 人 因 米 甸 人 的 缘 故 ， 极 其 穷 乏 ， 就 呼 求 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6662', '7', '6', '7', '以 色 列 人 因 米 甸 人 的 缘 故 ， 呼 求 耶 和 华 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6663', '7', '6', '8', '耶 和 华 就 差 遣 先 知 到 以 色 列 人 那 里 ， 对 他 们 说 ： 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 我 曾 领 你 们 从 埃 及 上 来 ， 出 了 为 奴 之 家 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6664', '7', '6', '9', '救 你 们 脱 离 埃 及 人 的 手 ， 并 脱 离 一 切 欺 压 你 们 之 人 的 手 ， 把 他 们 从 你 们 面 前 赶 出 ， 将 他 们 的 地 赐 给 你 们 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6665', '7', '6', '10', '又 对 你 们 说 ： 我 是 耶 和 华 ─ 你 们 的 　 神 。 你 们 住 在 亚 摩 利 人 的 地 ， 不 可 敬 畏 他 们 的 　 神 。 你 们 竟 不 听 从 我 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6666', '7', '6', '11', '耶 和 华 的 使 者 到 了 俄 弗 拉 ， 坐 在 亚 比 以 谢 族 人 约 阿 施 的 橡 树 下 。 约 阿 施 的 儿 子 基 甸 正 在 酒 ? 那 里 打 麦 子 ， 为 要 防 备 米 甸 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6667', '7', '6', '12', '耶 和 华 的 使 者 向 基 甸 显 现 ， 对 他 说 ： 大 能 的 勇 士 啊 ， 耶 和 华 与 你 同 在 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6668', '7', '6', '13', '基 甸 说 ： 主 啊 ， 耶 和 华 若 与 我 们 同 在 ， 我 们 何 至 遭 遇 这 一 切 事 呢 ？ 我 们 的 列 祖 不 是 向 我 们 说 耶 和 华 领 我 们 从 埃 及 上 来 麽 ？ 他 那 样 奇 妙 的 作 为 在 哪 里 呢 ？ 现 在 他 却 丢 弃 我 们 ， 将 我 们 交 在 米 甸 人 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6669', '7', '6', '14', '耶 和 华 观 看 基 甸 ， 说 ： 你 靠 着 你 这 能 力 去 从 米 甸 人 手 里 拯 救 以 色 列 人 ， 不 是 我 差 遣 你 去 的 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6670', '7', '6', '15', '基 甸 说 ： 主 啊 ， 我 有 何 能 拯 救 以 色 列 人 呢 ？ 我 家 在 玛 拿 西 支 派 中 是 至 贫 穷 的 。 我 在 我 父 家 是 至 微 小 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6671', '7', '6', '16', '耶 和 华 对 他 说 ： 我 与 你 同 在 ， 你 就 必 击 打 米 甸 人 ， 如 击 打 一 人 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6672', '7', '6', '17', '基 甸 说 ： 我 若 在 你 眼 前 蒙 恩 ， 求 你 给 我 一 个 证 据 ， 使 我 知 道 与 我 说 话 的 就 是 主 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6673', '7', '6', '18', '求 你 不 要 离 开 这 里 ， 等 我 归 回 将 礼 物 带 来 供 在 你 面 前 。 主 说 ： 我 必 等 你 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6674', '7', '6', '19', '基 甸 去 预 备 了 一 只 山 羊 羔 ， 用 一 伊 法 细 面 做 了 无 酵 饼 ， 将 肉 放 在 筐 内 ， 把 汤 盛 在 壶 中 ， 带 到 橡 树 下 ， 献 在 使 者 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6675', '7', '6', '20', '　 神 的 使 者 吩 咐 基 甸 说 ： 将 肉 和 无 酵 饼 放 在 这 磐 石 上 ， 把 汤 倒 出 来 。 他 就 这 样 行 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6676', '7', '6', '21', '耶 和 华 的 使 者 伸 出 手 内 的 杖 ， 杖 头 挨 了 肉 和 无 酵 饼 ， 就 有 火 从 磐 石 中 出 来 ， 烧 尽 了 肉 和 无 酵 饼 。 耶 和 华 的 使 者 也 就 不 见 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6677', '7', '6', '22', '基 甸 见 他 是 耶 和 华 的 使 者 ， 就 说 ： 哀 哉 ！ 主 耶 和 华 啊 ， 我 不 好 了 ， 因 为 我 觌 面 看 见 耶 和 华 的 使 者 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6678', '7', '6', '23', '耶 和 华 对 他 说 ： 你 放 心 ， 不 要 惧 怕 ， 你 必 不 至 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6679', '7', '6', '24', '於 是 基 甸 在 那 里 为 耶 和 华 筑 了 一 座 坛 ， 起 名 叫 耶 和 华 沙 龙 （ 就 是 耶 和 华 赐 平 安 的 意 思 ） 。 （ 这 坛 在 亚 比 以 谢 族 的 俄 弗 拉 直 到 如 今 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6680', '7', '6', '25', '当 那 夜 ， 耶 和 华 吩 咐 基 甸 说 ： 你 取 你 父 亲 的 牛 来 ， 就 是 （ 或 译 ： 和 ） 那 七 岁 的 第 二 只 牛 ， 并 拆 毁 你 父 亲 为 巴 力 所 筑 的 坛 ， 砍 下 坛 旁 的 木 偶 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6681', '7', '6', '26', '在 这 磐 石 （ 原 文 是 保 障 ） 上 整 整 齐 齐 地 为 耶 和 华 ─ 你 的 　 神 筑 一 座 坛 ， 将 第 二 只 牛 献 为 燔 祭 ， 用 你 所 砍 下 的 木 偶 作 柴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6682', '7', '6', '27', '基 甸 就 从 他 仆 人 中 挑 了 十 个 人 ， 照 着 耶 和 华 吩 咐 他 的 行 了 。 他 因 怕 父 家 和 本 城 的 人 ， 不 敢 在 白 昼 行 这 事 ， 就 在 夜 间 行 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6683', '7', '6', '28', '城 里 的 人 清 早 起 来 ， 见 巴 力 的 坛 拆 毁 ， 坛 旁 的 木 偶 砍 下 ， 第 二 只 牛 献 在 新 筑 的 坛 上 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6684', '7', '6', '29', '就 彼 此 说 ： 这 事 是 谁 做 的 呢 ？ 他 们 访 查 之 後 ， 就 说 ： 这 是 约 阿 施 的 儿 子 基 甸 做 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6685', '7', '6', '30', '城 里 的 人 对 约 阿 施 说 ： 将 你 儿 子 交 出 来 ， 好 治 死 他 ； 因 为 他 拆 毁 了 巴 力 的 坛 ， 砍 下 坛 旁 的 木 偶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6686', '7', '6', '31', '约 阿 施 回 答 站 着 攻 击 他 的 众 人 说 ： 你 们 是 为 巴 力 争 论 麽 ？ 你 们 要 救 他 麽 ？ 谁 为 他 争 论 ， 趁 早 将 谁 治 死 ！ 巴 力 若 果 是 　 神 ， 有 人 拆 毁 他 的 坛 ， 让 他 为 自 己 争 论 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6687', '7', '6', '32', '所 以 当 日 人 称 基 甸 为 耶 路 巴 力 ， 意 思 说 ： 他 拆 毁 巴 力 的 坛 ， 让 巴 力 与 他 争 论 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6688', '7', '6', '33', '那 时 ， 米 甸 人 、 亚 玛 力 人 ， 和 东 方 人 都 聚 集 过 河 ， 在 耶 斯 列 平 原 安 营 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6689', '7', '6', '34', '耶 和 华 的 灵 降 在 基 甸 身 上 ， 他 就 吹 角 ； 亚 比 以 谢 族 都 聚 集 跟 随 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6690', '7', '6', '35', '他 打 发 人 走 遍 玛 拿 西 地 ， 玛 拿 西 人 也 聚 集 跟 随 他 ； 又 打 发 人 去 见 亚 设 人 、 西 布 伦 人 、 拿 弗 他 利 人 ， 他 们 也 都 出 来 与 他 们 会 合 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6691', '7', '6', '36', '基 甸 对 　 神 说 ： 你 若 果 照 着 所 说 的 话 ， 藉 我 手 拯 救 以 色 列 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6692', '7', '6', '37', '我 就 把 一 团 羊 毛 放 在 禾 场 上 ： 若 单 是 羊 毛 上 有 露 水 ， 别 的 地 方 都 是 乾 的 ， 我 就 知 道 你 必 照 着 所 说 的 话 ， 藉 我 手 拯 救 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6693', '7', '6', '38', '次 日 早 晨 基 甸 起 来 ， 见 果 然 是 这 样 ； 将 羊 毛 挤 一 挤 ， 从 羊 毛 中 拧 出 满 盆 的 露 水 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6694', '7', '6', '39', '基 甸 又 对 　 神 说 ： 求 你 不 要 向 我 发 怒 ， 我 再 说 这 一 次 ： 让 我 将 羊 毛 再 试 一 次 。 但 愿 羊 毛 是 乾 的 ， 别 的 地 方 都 有 露 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6695', '7', '6', '40', '这 夜 　 神 也 如 此 行 ： 独 羊 毛 上 是 乾 的 ， 别 的 地 方 都 有 露 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6696', '7', '7', '1', '耶 路 巴 力 就 是 基 甸 ， 他 和 一 切 跟 随 的 人 早 晨 起 来 ， 在 哈 律 泉 旁 安 营 。 米 甸 营 在 他 们 北 边 的 平 原 ， 靠 近 摩 利 冈 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6697', '7', '7', '2', '耶 和 华 对 基 甸 说 ： 跟 随 你 的 人 过 多 ， 我 不 能 将 米 甸 人 交 在 他 们 手 中 ， 免 得 以 色 列 人 向 我 夸 大 ， 说 ： 是 我 们 自 己 的 手 救 了 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6698', '7', '7', '3', '现 在 你 要 向 这 些 人 宣 告 说 ： 凡 惧 怕 胆 怯 的 ， 可 以 离 开 基 列 山 回 去 。 於 是 有 二 万 二 千 人 回 去 ， 只 剩 下 一 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6699', '7', '7', '4', '耶 和 华 对 基 甸 说 ： 人 还 是 过 多 ； 你 要 带 他 们 下 到 水 旁 ， 我 好 在 那 里 为 你 试 试 他 们 。 我 指 点 谁 说 ： 这 人 可 以 同 你 去 ， 他 就 可 以 同 你 去 ； 我 指 点 谁 说 ： 这 人 不 可 同 你 去 ， 他 就 不 可 同 你 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6700', '7', '7', '5', '基 甸 就 带 他 们 下 到 水 旁 。 耶 和 华 对 基 甸 说 ： 凡 用 舌 头 舔 水 ， 像 狗 舔 的 ， 要 使 他 单 站 在 一 处 ； 凡 跪 下 喝 水 的 ， 也 要 使 他 单 站 在 一 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6701', '7', '7', '6', '於 是 用 手 捧 着 舔 水 的 有 三 百 人 ， 其 馀 的 都 跪 下 喝 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6702', '7', '7', '7', '耶 和 华 对 基 甸 说 ： 我 要 用 这 舔 水 的 三 百 人 拯 救 你 们 ， 将 米 甸 人 交 在 你 手 中 ； 其 馀 的 人 都 可 以 各 归 各 处 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6703', '7', '7', '8', '这 三 百 人 就 带 着 食 物 和 角 ； 其 馀 的 以 色 列 人 ， 基 甸 都 打 发 他 们 各 归 各 的 帐 棚 ， 只 留 下 这 三 百 人 。 米 甸 营 在 他 下 边 的 平 原 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6704', '7', '7', '9', '当 那 夜 ， 耶 和 华 吩 咐 基 甸 说 ： 起 来 ， 下 到 米 甸 营 里 去 ， 因 我 已 将 他 们 交 在 你 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6705', '7', '7', '10', '倘 若 你 怕 下 去 ， 就 带 你 的 仆 人 普 拉 下 到 那 营 里 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6706', '7', '7', '11', '你 必 听 见 他 们 所 说 的 ， 然 後 你 就 有 胆 量 下 去 攻 营 。 於 是 基 甸 带 着 仆 人 普 拉 下 到 营 旁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6707', '7', '7', '12', '米 甸 人 、 亚 玛 力 人 ， 和 一 切 东 方 人 都 布 散 在 平 原 ， 如 同 蝗 虫 那 样 多 。 他 们 的 骆 驼 无 数 ， 多 如 海 边 的 沙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6708', '7', '7', '13', '基 甸 到 了 ， 就 听 见 一 人 将 梦 告 诉 同 伴 说 ： 我 做 了 一 梦 ， 梦 见 一 个 大 麦 饼 滚 入 米 甸 营 中 ， 到 了 帐 幕 ， 将 帐 幕 撞 倒 ， 帐 幕 就 翻 转 倾 覆 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6709', '7', '7', '14', '那 同 伴 说 ： 这 不 是 别 的 ， 乃 是 以 色 列 人 约 阿 施 的 儿 子 基 甸 的 刀 ； 　 神 已 将 米 甸 和 全 军 都 交 在 他 的 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6710', '7', '7', '15', '基 甸 听 见 这 梦 和 梦 的 讲 解 ， 就 敬 拜 　 神 ， 回 到 以 色 列 营 中 ， 说 ： 起 来 罢 ！ 耶 和 华 已 将 米 甸 的 军 队 交 在 你 们 手 中 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6711', '7', '7', '16', '於 是 基 甸 将 三 百 人 分 作 三 队 ， 把 角 和 空 瓶 交 在 各 人 手 里 （ 瓶 内 都 藏 着 火 把 ） ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6712', '7', '7', '17', '吩 咐 他 们 说 ： 你 们 要 看 我 行 事 ： 我 到 了 营 的 旁 边 怎 样 行 ， 你 们 也 要 怎 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6713', '7', '7', '18', '我 和 一 切 跟 随 我 的 人 吹 角 的 时 候 ， 你 们 也 要 在 营 的 四 围 吹 角 ， 喊 叫 说 ： 耶 和 华 和 基 甸 的 刀 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6714', '7', '7', '19', '基 甸 和 跟 随 他 的 一 百 人 ， 在 三 更 之 初 才 换 更 的 时 候 ， 来 到 营 旁 ， 就 吹 角 ， 打 破 手 中 的 瓶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6715', '7', '7', '20', '三 队 的 人 就 都 吹 角 ， 打 破 瓶 子 ， 左 手 拿 着 火 把 ， 右 手 拿 着 角 ， 喊 叫 说 ： 耶 和 华 和 基 甸 的 刀 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6716', '7', '7', '21', '他 们 在 营 的 四 围 各 站 各 的 地 方 ； 全 营 的 人 都 乱 窜 。 三 百 人 呐 喊 ， 使 他 们 逃 跑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6717', '7', '7', '22', '三 百 人 就 吹 角 ， 耶 和 华 使 全 营 的 人 用 刀 互 相 击 杀 ， 逃 到 西 利 拉 的 伯 哈 示 他 ， 直 逃 到 靠 近 他 巴 的 亚 伯 米 何 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6718', '7', '7', '23', '以 色 列 人 就 从 拿 弗 他 利 、 亚 设 ， 和 玛 拿 西 全 地 聚 集 来 追 赶 米 甸 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6719', '7', '7', '24', '基 甸 打 发 人 走 遍 以 法 莲 山 地 ， 说 ： 你 们 下 来 攻 击 米 甸 人 ， 争 先 把 守 约 但 河 的 渡 口 ， 直 到 伯 巴 拉 。 於 是 以 法 莲 的 众 人 聚 集 ， 把 守 约 但 河 的 渡 口 ， 直 到 伯 巴 拉 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6720', '7', '7', '25', '捉 住 了 米 甸 人 的 两 个 首 领 ： 一 名 俄 立 ， 一 名 西 伊 伯 ； 将 俄 立 杀 在 俄 立 磐 石 上 ， 将 西 伊 伯 杀 在 西 伊 伯 酒 ? 那 里 ； 又 追 赶 米 甸 人 ， 将 俄 立 和 西 伊 伯 的 首 级 带 过 约 但 河 ， 到 基 甸 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6721', '7', '8', '1', '以 法 莲 人 对 基 甸 说 ： 你 去 与 米 甸 人 争 战 ， 没 有 招 我 们 同 去 ， 为 甚 麽 这 样 待 我 们 呢 ？ 他 们 就 与 基 甸 大 大 地 争 吵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6722', '7', '8', '2', '基 甸 对 他 们 说 ： 我 所 行 的 岂 能 比 你 们 所 行 的 呢 ？ 以 法 莲 拾 取 剩 下 的 葡 萄 不 强 过 亚 比 以 谢 所 摘 的 葡 萄 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6723', '7', '8', '3', '　 神 已 将 米 甸 人 的 两 个 首 领 俄 立 和 西 伊 伯 交 在 你 们 手 中 ； 我 所 行 的 岂 能 比 你 们 所 行 的 呢 ？ 基 甸 说 了 这 话 ， 以 法 莲 人 的 怒 气 就 消 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6724', '7', '8', '4', '基 甸 和 跟 随 他 的 三 百 人 到 约 但 河 过 渡 ， 虽 然 疲 乏 ， 还 是 追 赶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6725', '7', '8', '5', '基 甸 对 疏 割 人 说 ： 求 你 们 拿 饼 来 给 跟 随 我 的 人 吃 ， 因 为 他 们 疲 乏 了 ； 我 们 追 赶 米 甸 人 的 两 个 王 西 巴 和 撒 慕 拿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6726', '7', '8', '6', '疏 割 人 的 首 领 回 答 说 ： 西 巴 和 撒 慕 拿 已 经 在 你 手 里 ， 你 使 我 们 将 饼 给 你 的 军 兵 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6727', '7', '8', '7', '基 甸 说 ： 耶 和 华 将 西 巴 和 撒 慕 拿 交 在 我 手 之 後 ， 我 就 用 野 地 的 荆 条 和 枳 棘 打 伤 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6728', '7', '8', '8', '基 甸 从 那 里 上 到 毗 努 伊 勒 ， 对 那 里 的 人 也 是 这 样 说 ； 毗 努 伊 勒 人 也 与 疏 割 人 回 答 他 的 话 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6729', '7', '8', '9', '他 向 毗 努 伊 勒 人 说 ： 我 平 平 安 安 回 来 的 时 候 ， 我 必 拆 毁 这 楼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6730', '7', '8', '10', '那 时 西 巴 和 撒 慕 拿 ， 并 跟 随 他 们 的 军 队 都 在 加 各 ， 约 有 一 万 五 千 人 ， 就 是 东 方 人 全 军 所 剩 下 的 ； 已 经 被 杀 约 有 十 二 万 拿 刀 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6731', '7', '8', '11', '基 甸 就 由 挪 巴 和 约 比 哈 东 边 ， 从 住 帐 棚 人 的 路 上 去 ， 杀 败 了 米 甸 人 的 军 兵 ， 因 为 他 们 坦 然 无 惧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6732', '7', '8', '12', '西 巴 和 撒 慕 拿 逃 跑 ； 基 甸 追 赶 他 们 ， 捉 住 米 甸 的 二 王 西 巴 和 撒 慕 拿 ， 惊 散 全 军 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6733', '7', '8', '13', '约 阿 施 的 儿 子 基 甸 由 希 列 斯 坡 从 阵 上 回 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6734', '7', '8', '14', '捉 住 疏 割 的 一 个 少 年 人 ， 问 他 ： 疏 割 的 首 领 长 老 是 谁 ？ 他 就 将 首 领 长 老 七 十 七 个 人 的 名 字 写 出 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6735', '7', '8', '15', '基 甸 到 了 疏 割 ， 对 那 里 的 人 说 ： 你 们 从 前 讥 诮 我 说 ： 西 巴 和 撒 慕 拿 已 经 在 你 手 里 ， 你 使 我 们 将 饼 给 跟 随 你 的 疲 乏 人 麽 ？ ㄤ 萑 在 西 巴 和 撒 慕 拿 在 这 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6736', '7', '8', '16', '於 是 捉 住 那 城 内 的 长 老 ， 用 野 地 的 荆 条 和 枳 棘 责 打 （ 原 文 是 指 教 ） 疏 割 人 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6737', '7', '8', '17', '又 拆 了 毗 努 伊 勒 的 楼 ， 杀 了 那 城 里 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6738', '7', '8', '18', '基 甸 问 西 巴 和 撒 慕 拿 说 ： 你 们 在 他 泊 山 所 杀 的 人 是 甚 麽 样 式 ？ 回 答 说 ： 他 们 好 像 你 ， 各 人 都 有 王 子 的 样 式 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6739', '7', '8', '19', '基 甸 说 ： 他 们 是 我 同 母 的 弟 兄 ， 我 指 着 永 生 的 耶 和 华 起 誓 ， 你 们 从 前 若 存 留 他 们 的 性 命 ， 我 如 今 就 不 杀 你 们 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6740', '7', '8', '20', '於 是 对 他 的 长 子 益 帖 说 ： 你 起 来 杀 他 们 。 但 益 帖 因 为 是 童 子 ， 害 怕 ， 不 敢 拔 刀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6741', '7', '8', '21', '西 巴 和 撒 慕 拿 说 ： 你 自 己 起 来 杀 我 们 罢 ！ 因 为 人 如 何 ， 力 量 也 是 如 何 。 基 甸 就 起 来 ， 杀 了 西 巴 和 撒 慕 拿 ， 夺 获 他 们 骆 驼 项 上 戴 的 月 牙 圈 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6742', '7', '8', '22', '以 色 列 人 对 基 甸 说 ： 你 既 救 我 们 脱 离 米 甸 人 的 手 ， 愿 你 和 你 的 儿 孙 管 理 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6743', '7', '8', '23', '基 甸 说 ： 我 不 管 理 你 们 ， 我 的 儿 子 也 不 管 理 你 们 ， 惟 有 耶 和 华 管 理 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6744', '7', '8', '24', '基 甸 又 对 他 们 说 ： 我 有 一 件 事 求 你 们 ： 请 你 们 各 人 将 所 夺 的 耳 环 给 我 。 原 来 仇 敌 是 以 实 玛 利 人 ， 都 是 戴 金 耳 环 的 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6745', '7', '8', '25', '他 们 说 ： 我 们 情 愿 给 你 。 就 铺 开 一 件 外 衣 ， 各 人 将 所 夺 的 耳 环 丢 在 其 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6746', '7', '8', '26', '基 甸 所 要 出 来 的 金 耳 环 重 一 千 七 百 舍 客 勒 金 子 。 此 外 还 有 米 甸 王 所 戴 的 月 环 、 耳 坠 ， 和 所 穿 的 紫 色 衣 服 ， 并 骆 驼 项 上 的 金 炼 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6747', '7', '8', '27', '基 甸 以 此 制 造 了 一 个 以 弗 得 ， 设 立 在 本 城 俄 弗 拉 。 後 来 以 色 列 人 拜 那 以 弗 得 行 了 邪 淫 ； 这 就 作 了 基 甸 和 他 全 家 的 网 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6748', '7', '8', '28', '这 样 ， 米 甸 人 被 以 色 列 人 制 伏 了 ， 不 敢 再 抬 头 。 基 甸 还 在 的 日 子 ， 国 中 太 平 四 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6749', '7', '8', '29', '约 阿 施 的 儿 子 耶 路 巴 力 回 去 ， 住 在 自 己 家 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6750', '7', '8', '30', '基 甸 有 七 十 个 亲 生 的 儿 子 ， 因 为 他 有 许 多 的 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6751', '7', '8', '31', '他 的 妾 住 在 示 剑 ， 也 给 他 生 了 一 个 儿 子 。 基 甸 与 他 起 名 叫 亚 比 米 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6752', '7', '8', '32', '约 阿 施 的 儿 子 基 甸 ， 年 纪 老 迈 而 死 ， 葬 在 亚 比 以 谢 族 的 俄 弗 拉 ， 在 他 父 亲 约 阿 施 的 坟 墓 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6753', '7', '8', '33', '基 甸 死 後 ， 以 色 列 人 又 去 随 从 诸 巴 力 行 邪 淫 ， 以 巴 力 比 利 土 为 他 们 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6754', '7', '8', '34', '以 色 列 人 不 记 念 耶 和 华 ─ 他 们 的 　 神 ， 就 是 拯 救 他 们 脱 离 四 围 仇 敌 之 手 的 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6755', '7', '8', '35', '也 不 照 着 耶 路 巴 力 ， 就 是 基 甸 向 他 们 所 施 的 恩 惠 厚 待 他 的 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6756', '7', '9', '1', '耶 路 巴 力 的 儿 子 亚 比 米 勒 到 了 示 剑 见 他 的 众 母 舅 ， 对 他 们 和 他 外 祖 全 家 的 人 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6757', '7', '9', '2', '请 你 们 问 示 剑 的 众 人 说 ， 是 耶 路 巴 力 的 众 子 七 十 人 都 管 理 你 们 好 呢 ？ 还 是 一 人 管 理 你 们 好 呢 ？ 你 们 又 要 记 念 我 是 你 们 的 骨 肉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6758', '7', '9', '3', '他 的 众 母 舅 便 将 这 一 切 话 为 他 说 给 示 剑 人 听 ， 示 剑 人 的 心 就 归 向 亚 比 米 勒 。 他 们 说 ： 他 原 是 我 们 的 弟 兄 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6759', '7', '9', '4', '就 从 巴 力 比 利 土 的 庙 中 取 了 七 十 舍 客 勒 银 子 给 亚 比 米 勒 ； 亚 比 米 勒 用 以 雇 了 些 匪 徒 跟 随 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6760', '7', '9', '5', '他 往 俄 弗 拉 到 他 父 亲 的 家 ， 将 他 弟 兄 、 耶 路 巴 力 的 众 子 七 十 人 都 杀 在 一 块 磐 石 上 ； 只 剩 下 耶 路 巴 力 的 小 儿 子 约 坦 ， 因 为 他 躲 藏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6761', '7', '9', '6', '示 剑 人 和 米 罗 人 都 一 同 聚 集 ， 往 示 剑 橡 树 旁 的 柱 子 那 里 ， 立 亚 比 米 勒 为 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6762', '7', '9', '7', '有 人 将 这 事 告 诉 约 坦 ， 他 就 去 站 在 基 利 心 山 顶 上 ， 向 众 人 大 声 喊 叫 说 ： 示 剑 人 哪 ， 你 们 要 听 我 的 话 ， 　 神 也 就 听 你 们 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6763', '7', '9', '8', '有 一 时 树 木 要 膏 一 树 为 王 ， 管 理 他 们 ， 就 去 对 橄 榄 树 说 ： 请 你 作 我 们 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6764', '7', '9', '9', '橄 榄 树 回 答 说 ： 我 岂 肯 止 住 供 奉 　 神 和 尊 重 人 的 油 ， 飘 ? 在 众 树 之 上 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6765', '7', '9', '10', '树 木 对 无 花 果 树 说 ： 请 你 来 作 我 们 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6766', '7', '9', '11', '无 花 果 树 回 答 说 ： 我 岂 肯 止 住 所 结 甜 美 的 果 子 ， 飘 ? 在 众 树 之 上 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6767', '7', '9', '12', '树 木 对 葡 萄 树 说 ： 请 你 来 作 我 们 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6768', '7', '9', '13', '葡 萄 树 回 答 说 ： 我 岂 肯 止 住 使 　 神 和 人 喜 乐 的 新 酒 ， 飘 ? 在 众 树 之 上 呢 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6769', '7', '9', '14', '众 树 对 荆 棘 说 ： 请 你 来 作 我 们 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6770', '7', '9', '15', '荆 棘 回 答 说 ： 你 们 若 诚 诚 实 实 地 膏 我 为 王 ， 就 要 投 在 我 的 荫 下 ； 不 然 ， 愿 火 从 荆 棘 里 出 来 ， 烧 灭 利 巴 嫩 的 香 柏 树 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6771', '7', '9', '16', '现 在 你 们 立 亚 比 米 勒 为 王 ， 若 按 诚 实 正 直 善 待 耶 路 巴 力 和 他 的 全 家 ， 这 就 是 酬 他 的 劳 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6772', '7', '9', '17', '从 前 我 父 冒 死 为 你 们 争 战 ， 救 了 你 们 脱 离 米 甸 人 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6773', '7', '9', '18', '你 们 如 今 起 来 攻 击 我 的 父 家 ， 将 他 众 子 七 十 人 杀 在 一 块 磐 石 上 ， 又 立 他 婢 女 所 生 的 儿 子 亚 比 米 勒 为 示 剑 人 的 王 ； 他 原 是 你 们 的 弟 兄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6774', '7', '9', '19', '你 们 如 今 若 按 诚 实 正 直 待 耶 路 巴 力 和 他 的 家 ， 就 可 因 亚 比 米 勒 得 欢 乐 ， 他 也 可 因 你 们 得 欢 乐 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6775', '7', '9', '20', '不 然 ， 愿 火 从 亚 比 米 勒 发 出 ， 烧 灭 示 剑 人 和 米 罗 众 人 ， 又 愿 火 从 示 剑 人 和 米 罗 人 中 出 来 ， 烧 灭 亚 比 米 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6776', '7', '9', '21', '约 坦 因 怕 他 弟 兄 亚 比 米 勒 ， 就 逃 跑 ， 来 到 比 珥 ， 住 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6777', '7', '9', '22', '亚 比 米 勒 管 理 以 色 列 人 三 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6778', '7', '9', '23', '　 神 使 恶 魔 降 在 亚 比 米 勒 和 示 剑 人 中 间 ， 示 剑 人 就 以 诡 诈 待 亚 比 米 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6779', '7', '9', '24', '这 是 要 叫 耶 路 巴 力 七 十 个 儿 子 所 受 的 残 害 归 与 他 们 的 哥 哥 亚 比 米 勒 ， 又 叫 那 流 他 们 血 的 罪 归 与 帮 助 他 杀 弟 兄 的 示 剑 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6780', '7', '9', '25', '示 剑 人 在 山 顶 上 设 埋 伏 ， 等 候 亚 比 米 勒 。 凡 从 他 们 那 里 经 过 的 人 ， 他 们 就 抢 夺 。 有 人 将 这 事 告 诉 亚 比 米 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6781', '7', '9', '26', '以 别 的 儿 子 迦 勒 和 他 的 弟 兄 来 到 示 剑 ， 示 剑 人 都 信 靠 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6782', '7', '9', '27', '示 剑 人 出 城 到 田 间 去 ， 摘 下 葡 萄 ， 踹 酒 ， 设 摆 筵 宴 ， 进 他 们 　 神 的 庙 中 吃 喝 ， 咒 诅 亚 比 米 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6783', '7', '9', '28', '以 别 的 儿 子 迦 勒 说 ： 亚 比 米 勒 是 谁 ？ 示 剑 是 谁 ？ 使 我 们 服 事 他 呢 ？ 他 不 是 耶 路 巴 力 的 儿 子 麽 ？ 他 的 帮 手 不 是 西 布 勒 麽 ？ 你 们 可 以 服 事 示 剑 的 父 亲 哈 抹 的 後 裔 。 我 们 为 何 服 事 亚 比 米 勒 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6784', '7', '9', '29', '惟 愿 这 民 归 我 的 手 下 ， 我 就 除 掉 亚 比 米 勒 。 迦 勒 又 对 亚 比 米 勒 说 ： 增 添 你 的 军 兵 出 来 罢 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6785', '7', '9', '30', '邑 宰 西 布 勒 听 见 以 别 的 儿 子 迦 勒 的 话 ， 就 发 怒 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6786', '7', '9', '31', '悄 悄 地 打 发 人 去 见 亚 比 米 勒 ， 说 ： 以 别 的 儿 子 迦 勒 和 他 的 弟 兄 到 了 示 剑 ， 煽 惑 城 中 的 民 攻 击 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6787', '7', '9', '32', '现 在 你 和 跟 随 你 的 人 今 夜 起 来 ， 在 田 间 埋 伏 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6788', '7', '9', '33', '到 早 晨 太 阳 一 出 ， 你 就 起 来 闯 城 。 迦 勒 和 跟 随 他 的 人 出 来 攻 击 你 的 时 候 ， 你 便 向 他 们 见 机 而 做 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6789', '7', '9', '34', '於 是 ， 亚 比 米 勒 和 跟 随 他 的 众 人 夜 间 起 来 ， 分 作 四 队 ， 埋 伏 等 候 示 剑 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6790', '7', '9', '35', '以 别 的 儿 子 迦 勒 出 去 ， 站 在 城 门 口 。 亚 比 米 勒 和 跟 随 他 的 人 从 埋 伏 之 处 起 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6791', '7', '9', '36', '迦 勒 看 见 那 些 人 ， 就 对 西 布 勒 说 ： 看 哪 ， 有 人 从 山 顶 上 下 来 了 。 西 布 勒 说 ： 你 看 见 山 的 影 子 ， 以 为 是 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6792', '7', '9', '37', '迦 勒 又 说 ： 看 哪 ， 有 人 从 高 处 下 来 ， 又 有 一 队 从 米 恶 尼 尼 橡 树 的 路 上 而 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6793', '7', '9', '38', '西 布 勒 对 他 说 ： 你 曾 说 ， 亚 比 米 勒 是 谁 ， 叫 我 们 服 事 他 ？ 你 所 夸 的 口 在 哪 里 呢 ？ 这 不 是 你 所 藐 视 的 民 麽 ？ 你 现 在 出 去 ， 与 他 们 交 战 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6794', '7', '9', '39', '於 是 迦 勒 率 领 示 剑 人 出 去 ， 与 亚 比 米 勒 交 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6795', '7', '9', '40', '亚 比 米 勒 追 赶 迦 勒 ； 迦 勒 在 他 面 前 逃 跑 ， 有 许 多 受 伤 仆 倒 的 ， 直 到 城 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6796', '7', '9', '41', '亚 比 米 勒 住 在 亚 鲁 玛 。 西 布 勒 赶 出 迦 勒 和 他 弟 兄 ， 不 准 他 们 住 在 示 剑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6797', '7', '9', '42', '次 日 ， 民 出 到 田 间 ， 有 人 告 诉 亚 比 米 勒 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6798', '7', '9', '43', '他 就 把 他 的 人 分 作 三 队 ， 埋 伏 在 田 间 ， 看 见 示 剑 人 从 城 里 出 来 ， 就 起 来 击 杀 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6799', '7', '9', '44', '亚 比 米 勒 和 跟 随 他 的 一 队 向 前 闯 去 ， 站 在 城 门 口 ； 那 两 队 直 闯 到 田 间 ， 击 杀 了 众 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6800', '7', '9', '45', '亚 比 米 勒 整 天 攻 打 城 ， 将 城 夺 取 ， 杀 了 其 中 的 居 民 ， 将 城 拆 毁 ， 撒 上 了 盐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6801', '7', '9', '46', '示 剑 楼 的 人 听 见 了 ， 就 躲 入 巴 力 比 利 土 庙 的 卫 所 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6802', '7', '9', '47', '有 人 告 诉 亚 比 米 勒 说 ： 示 剑 楼 的 人 都 聚 在 一 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6803', '7', '9', '48', '亚 比 米 勒 和 跟 随 他 的 人 就 都 上 撒 们 山 。 亚 比 米 勒 手 拿 斧 子 ， 砍 下 一 根 树 枝 ， 扛 在 肩 上 ， 对 跟 随 他 的 人 说 ： 你 们 看 我 所 行 的 ， 也 当 赶 紧 照 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6804', '7', '9', '49', '众 人 就 各 砍 一 枝 ， 跟 随 亚 比 米 勒 ， 把 树 枝 堆 在 卫 所 的 四 围 ， 放 火 烧 了 卫 所 ， 以 致 示 剑 楼 的 人 都 死 了 ， 男 女 约 有 一 千 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6805', '7', '9', '50', '亚 比 米 勒 到 提 备 斯 ， 向 提 备 斯 安 营 ， 就 攻 取 了 那 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6806', '7', '9', '51', '城 中 有 一 座 坚 固 的 楼 ； 城 里 的 众 人 ， 无 论 男 女 ， 都 逃 进 楼 去 ， 关 上 门 ， 上 了 楼 顶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6807', '7', '9', '52', '亚 比 米 勒 到 了 楼 前 攻 打 ， 挨 近 楼 门 ， 要 用 火 焚 烧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6808', '7', '9', '53', '有 一 个 妇 人 把 一 块 上 磨 石 抛 在 亚 比 米 勒 的 头 上 ， 打 破 了 他 的 脑 骨 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6809', '7', '9', '54', '他 就 急 忙 喊 叫 拿 他 兵 器 的 少 年 人 ， 对 他 说 ： 拔 出 你 的 刀 来 ， 杀 了 我 罢 ！ 免 得 人 议 论 我 说 ， 他 为 一 个 妇 人 所 杀 。 於 是 少 年 人 把 他 刺 透 ， 他 就 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6810', '7', '9', '55', '以 色 列 人 见 亚 比 米 勒 死 了 ， 便 各 回 自 己 的 地 方 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6811', '7', '9', '56', '这 样 ， 　 神 报 应 亚 比 米 勒 向 他 父 亲 所 行 的 恶 ， 就 是 杀 了 弟 兄 七 十 个 人 的 恶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6812', '7', '9', '57', '示 剑 人 的 一 切 恶 ， 　 神 也 都 报 应 在 他 们 头 上 ； 耶 路 巴 力 的 儿 子 约 坦 的 咒 诅 归 到 们 身 上 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6813', '7', '10', '1', '亚 比 米 勒 以 後 ， 有 以 萨 迦 人 朵 多 的 孙 子 、 普 瓦 的 儿 子 陀 拉 兴 起 ， 拯 救 以 色 列 人 。 他 住 在 以 法 莲 山 地 的 沙 密 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6814', '7', '10', '2', '陀 拉 作 以 色 列 的 士 师 二 十 三 年 ， 就 死 了 ， 葬 在 沙 密 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6815', '7', '10', '3', '在 他 以 後 有 基 列 人 睚 珥 兴 起 ， 作 以 色 列 的 士 师 二 十 二 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6816', '7', '10', '4', '他 有 三 十 个 儿 子 ， 骑 着 三 十 匹 驴 驹 。 他 们 有 三 十 座 城 邑 ， 叫 作 哈 倭 特 睚 珥 ， 直 到 如 今 ， 都 是 在 基 列 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6817', '7', '10', '5', '睚 珥 死 了 ， 就 葬 在 加 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6818', '7', '10', '6', '以 色 列 人 又 行 耶 和 华 眼 中 看 为 恶 的 事 ， 去 事 奉 诸 巴 力 和 亚 斯 他 录 ， 并 亚 兰 的 　 神 、 西 顿 的 　 神 、 摩 押 的 　 神 、 亚 扪 人 的 　 神 、 非 利 士 人 的 　 神 ， 离 弃 耶 和 华 ， 不 事 奉 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6819', '7', '10', '7', '耶 和 华 的 怒 气 向 以 色 列 人 发 作 ， 就 把 他 们 交 在 非 利 士 人 和 亚 扪 人 的 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6820', '7', '10', '8', '从 那 年 起 ， 他 们 扰 害 欺 压 约 但 河 那 边 、 住 亚 摩 利 人 之 基 列 地 的 以 色 列 人 ， 共 有 十 八 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6821', '7', '10', '9', '亚 扪 人 又 渡 过 约 但 河 去 攻 打 犹 大 和 便 雅 悯 ， 并 以 法 莲 族 。 以 色 列 人 就 甚 觉 窘 迫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6822', '7', '10', '10', '以 色 列 人 哀 求 耶 和 华 说 ： 我 们 得 罪 了 你 ； 因 为 离 弃 了 我 们 　 神 ， 去 事 奉 诸 巴 力 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6823', '7', '10', '11', '耶 和 华 对 以 色 列 人 说 ： 我 岂 没 有 救 过 你 们 脱 离 埃 及 人 、 亚 摩 利 人 、 亚 扪 人 ， 和 非 利 士 人 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6824', '7', '10', '12', '西 顿 人 、 亚 玛 力 人 、 马 云 人 也 都 欺 压 你 们 ； 你 们 哀 求 我 ， 我 也 拯 救 你 们 脱 离 他 们 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6825', '7', '10', '13', '你 们 竟 离 弃 我 ， 事 奉 别 　 神 ！ 所 以 我 不 再 救 你 们 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6826', '7', '10', '14', '你 们 去 哀 求 所 选 择 的 　 神 ； 你 们 遭 遇 急 难 的 时 候 ， 让 他 救 你 们 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6827', '7', '10', '15', '以 色 列 人 对 耶 和 华 说 ： 我 们 犯 罪 了 ， 任 凭 你 随 意 待 我 们 罢 ！ 只 求 你 今 日 拯 救 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6828', '7', '10', '16', '以 色 列 人 就 除 掉 他 们 中 间 的 外 邦 　 神 ， 事 奉 耶 和 华 。 耶 和 华 因 以 色 列 人 受 的 苦 难 ， 就 心 中 担 忧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6829', '7', '10', '17', '当 时 亚 扪 人 聚 集 ， 安 营 在 基 列 。 以 色 列 人 也 聚 集 ， 安 营 在 米 斯 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6830', '7', '10', '18', '基 列 的 民 和 众 首 领 彼 此 商 议 说 ： 谁 能 先 去 攻 打 亚 扪 人 ， 谁 必 作 基 列 一 切 居 民 的 领 袖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6831', '7', '11', '1', '基 列 人 耶 弗 他 是 个 大 能 的 勇 士 ， 是 妓 女 的 儿 子 。 耶 弗 他 是 基 列 所 生 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6832', '7', '11', '2', '基 列 的 妻 也 生 了 几 个 儿 子 ： 他 妻 所 生 的 儿 子 长 大 了 ， 就 赶 逐 耶 弗 他 ， 说 ： 你 不 可 在 我 们 父 家 承 受 产 业 ， 因 为 你 是 妓 女 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6833', '7', '11', '3', '耶 弗 他 就 逃 避 他 的 弟 兄 ， 去 住 在 陀 伯 地 ， 有 些 匪 徒 到 他 那 里 聚 集 ， 与 他 一 同 出 入 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6834', '7', '11', '4', '过 了 些 日 子 ， 亚 扪 人 攻 打 以 色 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6835', '7', '11', '5', '亚 扪 人 攻 打 以 色 列 的 时 候 ， 基 列 的 长 老 到 陀 伯 地 去 ， 要 叫 耶 弗 他 回 来 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6836', '7', '11', '6', '对 耶 弗 他 说 ： 请 你 来 作 我 们 的 元 帅 ， 我 们 好 与 亚 扪 人 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6837', '7', '11', '7', '耶 弗 他 回 答 基 列 的 长 老 说 ： 从 前 你 们 不 是 恨 我 、 赶 逐 我 出 离 父 家 麽 ？ 现 在 你 们 遭 遇 急 难 为 何 到 我 这 里 来 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6838', '7', '11', '8', '基 列 的 长 老 回 答 耶 弗 他 说 ： 现 在 我 们 到 你 这 里 来 ， 是 要 你 同 我 们 去 ， 与 亚 扪 人 争 战 ； 你 可 以 作 基 列 一 切 居 民 的 领 袖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6839', '7', '11', '9', '耶 弗 他 对 基 列 的 长 老 说 ： 你 们 叫 我 回 去 ， 与 亚 扪 人 争 战 ， 耶 和 华 把 他 交 给 我 ， 我 可 以 作 你 们 的 领 袖 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6840', '7', '11', '10', '基 列 的 长 老 回 答 耶 弗 他 说 ： 有 耶 和 华 在 你 我 中 间 作 见 证 ， 我 们 必 定 照 你 的 话 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6841', '7', '11', '11', '於 是 耶 弗 他 同 基 列 的 长 老 回 去 ， 百 姓 就 立 耶 弗 他 作 领 袖 、 作 元 帅 。 耶 弗 他 在 米 斯 巴 将 自 己 的 一 切 话 陈 明 在 耶 和 华 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6842', '7', '11', '12', '耶 弗 他 打 发 使 者 去 见 亚 扪 人 的 王 ， 说 ： 你 与 我 有 甚 麽 相 干 ， 竟 来 到 我 国 中 攻 打 我 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6843', '7', '11', '13', '亚 扪 人 的 王 回 答 耶 弗 他 的 使 者 说 ： 因 为 以 色 列 从 埃 及 上 来 的 时 候 占 据 我 的 地 ， 从 亚 嫩 河 到 雅 博 河 ， 直 到 约 但 河 。 现 在 你 要 好 好 地 将 这 地 归 还 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6844', '7', '11', '14', '耶 弗 他 又 打 发 使 者 去 见 亚 扪 人 的 王 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6845', '7', '11', '15', '对 他 说 ： 耶 弗 他 如 此 说 ， 以 色 列 人 并 没 有 占 据 摩 押 地 和 亚 扪 人 的 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6846', '7', '11', '16', '以 色 列 人 从 埃 及 上 来 乃 是 经 过 旷 野 到 红 海 ， 来 到 加 低 斯 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6847', '7', '11', '17', '就 打 发 使 者 去 见 以 东 王 ， 说 ： 求 你 容 我 从 你 的 地 经 过 。 以 东 王 却 不 应 允 。 又 照 样 打 发 使 者 去 见 摩 押 王 ， 他 也 不 允 准 。 以 色 列 人 就 住 在 加 低 斯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6848', '7', '11', '18', '他 们 又 经 过 旷 野 ， 绕 着 以 东 和 摩 押 地 ， 从 摩 押 地 的 东 边 过 来 ， 在 亚 嫩 河 边 安 营 ， 并 没 有 入 摩 押 的 境 内 ， 因 为 亚 嫩 河 是 摩 押 的 边 界 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6849', '7', '11', '19', '以 色 列 人 打 发 使 者 去 见 亚 摩 利 王 西 宏 ， 就 是 希 实 本 的 王 ， 对 他 说 ： 求 你 容 我 们 从 你 的 地 经 过 ， 往 我 们 自 己 的 地 方 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6850', '7', '11', '20', '西 宏 却 不 信 服 以 色 列 人 ， 不 容 他 们 经 过 他 的 境 界 ， 乃 招 聚 他 的 众 民 在 雅 杂 安 营 ， 与 以 色 列 人 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6851', '7', '11', '21', '耶 和 华 ─ 以 色 列 的 　 神 将 西 宏 和 他 的 众 民 都 交 在 以 色 列 人 手 中 ， 以 色 列 人 就 击 杀 他 们 ， 得 了 亚 摩 利 人 的 全 地 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6852', '7', '11', '22', '从 亚 嫩 河 到 雅 博 河 ， 从 旷 野 直 到 约 但 河 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6853', '7', '11', '23', '耶 和 华 ─ 以 色 列 的 　 神 在 他 百 姓 以 色 列 面 前 赶 出 亚 摩 利 人 ， 你 竟 要 得 他 们 的 地 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6854', '7', '11', '24', '你 的 　 神 基 抹 所 赐 你 的 地 你 不 是 得 为 业 麽 ？ 耶 和 华 ─ 我 们 的 　 神 在 我 们 面 前 所 赶 出 的 人 ， 我 们 就 得 他 的 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6855', '7', '11', '25', '难 道 你 比 摩 押 王 西 拨 的 儿 子 巴 勒 还 强 麽 ？ 他 曾 与 以 色 列 人 争 竞 ， 或 是 与 他 们 争 战 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6856', '7', '11', '26', '以 色 列 人 住 希 实 本 和 属 希 实 本 的 乡 村 ， 亚 罗 珥 和 属 亚 罗 珥 的 乡 村 ， 并 沿 亚 嫩 河 的 一 切 城 邑 ， 已 经 有 三 百 年 了 ； 在 这 三 百 年 之 内 ， 你 们 为 甚 麽 没 有 取 回 这 些 地 方 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6857', '7', '11', '27', '原 来 我 没 有 得 罪 你 ， 你 却 攻 打 我 ， 恶 待 我 。 愿 审 判 人 的 耶 和 华 今 日 在 以 色 列 人 和 亚 扪 人 中 间 判 断 是 非 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6858', '7', '11', '28', '但 亚 扪 人 的 王 不 肯 听 耶 弗 他 打 发 人 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6859', '7', '11', '29', '耶 和 华 的 灵 降 在 耶 弗 他 身 上 ， 他 就 经 过 基 列 和 玛 拿 西 ， 来 到 基 列 的 米 斯 巴 ， 又 从 米 斯 巴 来 到 亚 扪 人 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6860', '7', '11', '30', '耶 弗 他 就 向 耶 和 华 许 愿 ， 说 ： 你 若 将 亚 扪 人 交 在 我 手 中 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6861', '7', '11', '31', '我 从 亚 扪 人 那 里 平 平 安 安 回 来 的 时 候 ， 无 论 甚 麽 人 ， 先 从 我 家 门 出 来 迎 接 我 ， 就 必 归 你 ， 我 也 必 将 他 献 上 为 燔 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6862', '7', '11', '32', '於 是 耶 弗 他 往 亚 扪 人 那 里 去 ， 与 他 们 争 战 ； 耶 和 华 将 他 们 交 在 他 手 中 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6863', '7', '11', '33', '他 就 大 大 杀 败 他 们 ， 从 亚 罗 珥 到 米 匿 ， 直 到 亚 备 勒 基 拉 明 ， 攻 取 了 二 十 座 城 。 这 样 亚 扪 人 就 被 以 色 列 人 制 伏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6864', '7', '11', '34', '耶 弗 他 回 米 斯 巴 到 了 自 己 的 家 ， 不 料 ， 他 女 儿 拿 着 鼓 跳 舞 出 来 迎 接 他 ， 是 他 独 生 的 ， 此 外 无 儿 无 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6865', '7', '11', '35', '耶 弗 他 看 见 他 ， 就 撕 裂 衣 服 ， 说 ： 哀 哉 ！ 我 的 女 儿 啊 ， 你 使 我 甚 是 愁 苦 ， 叫 我 作 难 了 ； 因 为 我 已 经 向 耶 和 华 开 口 许 愿 ， 不 能 挽 回 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6866', '7', '11', '36', '他 女 儿 回 答 说 ： 父 啊 ， 你 既 向 耶 和 华 开 口 ， 就 当 照 你 口 中 所 说 的 向 我 行 ， 因 耶 和 华 已 经 在 仇 敌 亚 扪 人 身 上 为 你 报 仇 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6867', '7', '11', '37', '又 对 父 亲 说 ： 有 一 件 事 求 你 允 准 ： 容 我 去 两 个 月 ， 与 同 伴 在 山 上 ， 好 哀 哭 我 终 为 处 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6868', '7', '11', '38', '耶 弗 他 说 ： 你 去 罢 ！ 就 容 他 去 两 个 月 。 他 便 和 同 伴 去 了 ， 在 山 上 为 他 终 为 处 女 哀 哭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6869', '7', '11', '39', '两 月 已 满 ， 他 回 到 父 亲 那 里 ， 父 亲 就 照 所 许 的 愿 向 他 行 了 。 女 儿 终 身 没 有 亲 近 男 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6870', '7', '11', '40', '此 後 以 色 列 中 有 个 规 矩 ， 每 年 以 色 列 的 女 子 去 为 基 列 人 耶 弗 他 的 女 儿 哀 哭 四 天 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6871', '7', '12', '1', '以 法 莲 人 聚 集 ， 到 了 北 方 ， 对 耶 弗 他 说 ： 你 去 与 亚 扪 人 争 战 ， 为 甚 麽 没 有 招 我 们 同 去 呢 ？ 我 们 必 用 火 烧 你 和 你 的 房 屋 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6872', '7', '12', '2', '耶 弗 他 对 他 们 说 ： 我 和 我 的 民 与 亚 扪 ； 人 大 大 争 战 ； 我 招 你 们 来 ， 你 们 竟 没 有 来 救 我 脱 离 他 们 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6873', '7', '12', '3', '我 见 你 们 不 来 救 我 ， 我 就 拚 命 前 去 攻 击 亚 扪 人 ， 耶 和 华 将 他 们 交 在 我 手 中 。 你 们 今 日 为 甚 麽 上 我 这 里 来 攻 打 我 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6874', '7', '12', '4', '於 是 耶 弗 他 招 聚 基 列 人 ， 与 以 法 莲 人 争 战 。 基 列 人 击 杀 以 法 莲 ， 是 因 他 们 说 ： 你 们 基 列 人 在 以 法 莲 、 玛 拿 西 中 间 ， 不 过 是 以 法 莲 逃 亡 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6875', '7', '12', '5', '基 列 人 把 守 约 但 河 的 渡 口 ， 不 容 以 法 莲 人 过 去 。 以 法 莲 逃 走 的 人 若 说 ： 容 我 过 去 。 基 列 人 就 问 他 说 ： 你 是 以 法 莲 人 不 是 ？ 他 若 说 ： 不 是 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6876', '7', '12', '6', '就 对 他 说 ： 你 说 示 播 列 ； 以 法 莲 人 因 为 咬 不 真 字 音 ， 便 说 西 播 列 。 基 列 人 就 将 他 拿 住 ， 杀 在 约 但 河 的 渡 口 。 那 时 以 法 莲 人 被 杀 的 有 四 万 二 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6877', '7', '12', '7', '耶 弗 他 作 以 色 列 的 士 师 年 。 基 列 人 耶 弗 他 死 了 ， 葬 在 基 列 的 一 座 城 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6878', '7', '12', '8', '耶 弗 他 以 後 ， 有 伯 利 恒 人 以 比 赞 作 以 色 列 士 师 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6879', '7', '12', '9', '他 有 三 十 个 儿 子 ， 三 十 女 儿 ； 女 儿 都 嫁 出 去 了 。 他 给 众 子 从 外 乡 娶 了 三 十 媳 妇 。 他 作 以 色 列 的 士 师 七 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6880', '7', '12', '10', '以 比 赞 死 了 ， 葬 在 伯 利 恒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6881', '7', '12', '11', '以 比 赞 之 後 ， 有 西 布 伦 人 以 伦 ， 作 以 色 列 的 士 师 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6882', '7', '12', '12', '西 布 伦 人 以 伦 死 了 ， 葬 在 西 布 伦 地 的 亚 雅 仑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6883', '7', '12', '13', '以 伦 之 後 ， 有 比 拉 顿 人 希 列 的 儿 子 押 顿 作 以 色 的 士 师 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6884', '7', '12', '14', '他 有 四 十 个 儿 子 ， 三 十 个 孙 子 ， 骑 着 七 十 匹 驴 驹 。 押 顿 作 以 色 列 的 士 师 八 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6885', '7', '12', '15', '比 拉 顿 人 希 列 的 儿 子 押 顿 死 了 ， 葬 在 以 法 莲 地 的 比 拉 顿 ， 在 亚 玛 力 人 的 山 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6886', '7', '13', '1', '以 色 列 人 又 行 耶 和 华 眼 中 看 为 恶 的 事 ， 耶 和 华 将 他 们 交 在 非 利 士 人 手 中 四 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6887', '7', '13', '2', '那 时 ， 有 一 个 琐 拉 人 ， 是 属 但 族 的 ， 名 叫 玛 挪 亚 。 他 的 妻 不 怀 孕 ， 不 生 育 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6888', '7', '13', '3', '耶 和 华 的 使 者 向 那 妇 人 显 现 ， 对 他 说 ： 向 来 你 不 怀 孕 ， 不 生 育 ， 如 今 你 必 怀 孕 生 一 个 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6889', '7', '13', '4', '所 以 你 当 谨 慎 ， 清 酒 浓 酒 都 不 可 喝 ， 一 切 不 洁 之 物 也 不 可 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6890', '7', '13', '5', '你 必 怀 孕 生 一 个 儿 子 ， 不 可 用 剃 头 刀 剃 他 的 头 ， 因 为 这 孩 子 一 出 胎 就 归 　 神 作 拿 细 耳 人 。 他 必 起 首 拯 救 以 色 列 人 脱 离 非 利 士 人 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6891', '7', '13', '6', '妇 人 就 回 去 对 丈 夫 说 ： 有 一 个 　 神 人 到 我 面 前 来 ， 他 的 相 貌 如 　 神 使 者 的 相 貌 ， 甚 是 可 畏 。 我 没 有 问 他 从 哪 里 来 ， 他 也 没 有 将 他 的 名 告 诉 我 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6892', '7', '13', '7', '却 对 我 说 ： 你 要 怀 孕 生 一 个 儿 子 ， 所 以 清 酒 浓 酒 都 不 可 喝 ， 一 切 不 洁 之 物 也 不 可 吃 ； 因 为 这 孩 子 从 出 胎 一 直 到 死 ， 必 归 □ 　 神 作 拿 细 耳 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6893', '7', '13', '8', '玛 挪 亚 就 祈 求 耶 和 华 说 ： 主 啊 ， 求 你 再 差 遣 那 　 神 人 到 我 们 这 里 来 ， 好 指 教 我 们 怎 样 待 这 将 要 生 的 孩 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6894', '7', '13', '9', '　 神 应 允 玛 挪 亚 的 话 ； 妇 人 正 坐 在 田 间 的 时 候 ， 　 神 的 使 者 又 到 他 那 里 ， 他 丈 夫 玛 挪 亚 却 没 有 同 他 在 一 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6895', '7', '13', '10', '妇 人 急 忙 跑 去 告 诉 丈 夫 说 ： 那 日 到 我 面 前 来 的 人 ， 又 向 我 显 现 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6896', '7', '13', '11', '玛 挪 亚 起 来 跟 随 他 的 妻 来 到 那 人 面 前 ， 对 他 说 ： 与 这 妇 人 说 话 的 就 是 你 麽 ？ 他 说 ： 是 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6897', '7', '13', '12', '玛 挪 亚 说 ： 愿 你 的 话 应 验 ！ 我 们 当 怎 样 待 这 孩 子 ， 他 後 来 当 怎 样 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6898', '7', '13', '13', '耶 和 华 的 使 者 对 玛 挪 亚 说 ： 我 告 诉 妇 人 的 一 切 事 ， 他 都 当 谨 慎 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6899', '7', '13', '14', '葡 萄 树 所 结 的 都 不 可 吃 ， 清 酒 浓 酒 都 不 可 喝 ， 一 切 不 洁 之 物 也 不 可 吃 。 凡 我 所 吩 咐 的 ， 他 都 当 遵 守 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6900', '7', '13', '15', '玛 挪 亚 对 耶 和 华 的 使 者 说 ： 求 你 容 我 们 款 留 你 ， 好 为 你 预 备 一 只 山 羊 羔 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6901', '7', '13', '16', '耶 和 华 的 使 者 对 玛 挪 亚 说 ： 你 虽 然 款 留 我 ， 我 却 不 吃 你 的 食 物 ， 你 若 预 备 燔 祭 就 当 献 与 耶 和 华 。 原 来 玛 挪 亚 不 知 道 他 是 耶 和 华 的 使 者 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6902', '7', '13', '17', '玛 挪 亚 对 耶 和 华 的 使 者 说 ： 请 将 你 的 名 告 诉 我 ， 到 你 话 应 验 的 时 候 ， 我 们 好 尊 敬 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6903', '7', '13', '18', '耶 和 华 的 使 者 对 他 说 ： 你 何 必 问 我 的 名 ， 我 名 是 奇 妙 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6904', '7', '13', '19', '玛 挪 亚 将 一 只 山 羊 羔 和 素 祭 在 磐 石 上 献 与 耶 和 华 ， 使 者 行 奇 妙 的 事 ； 玛 挪 亚 和 他 的 妻 观 看 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6905', '7', '13', '20', '见 火 焰 从 坛 上 往 上 升 ， 耶 和 华 的 使 者 在 坛 上 的 火 焰 中 也 升 上 去 了 。 玛 挪 亚 和 他 的 妻 看 见 ， 就 俯 伏 於 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6906', '7', '13', '21', '耶 和 华 的 使 者 不 再 向 玛 挪 亚 和 他 的 妻 显 现 ， 玛 挪 亚 才 知 道 他 是 耶 和 华 的 使 者 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6907', '7', '13', '22', '玛 挪 亚 对 他 的 妻 说 ： 我 们 必 要 死 ， 因 为 看 见 了 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6908', '7', '13', '23', '他 的 妻 却 对 他 说 ： 耶 和 华 若 要 杀 我 们 ， 必 不 从 我 们 手 里 收 纳 燔 祭 和 素 祭 ， 并 不 将 这 一 切 事 指 示 我 们 ， 今 日 也 不 将 这 些 话 告 诉 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6909', '7', '13', '24', '後 来 妇 人 生 了 一 个 儿 子 ， 给 他 起 名 叫 参 孙 。 孩 子 长 大 ， 耶 和 华 赐 福 与 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6910', '7', '13', '25', '在 玛 哈 尼 但 ， 就 是 琐 拉 和 以 实 陶 中 间 ， 耶 和 华 的 灵 才 感 动 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6911', '7', '14', '1', '参 孙 下 到 亭 拿 ， 在 那 里 看 见 一 个 女 子 ， 是 非 利 士 人 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6912', '7', '14', '2', '参 孙 上 来 禀 告 他 父 母 说 ： 我 在 亭 拿 看 见 一 个 女 子 ， 是 非 利 士 人 的 女 儿 ， 愿 你 们 给 我 娶 来 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6913', '7', '14', '3', '他 父 母 说 ： 在 你 弟 兄 的 女 儿 中 ， 或 在 本 国 的 民 中 ， 岂 没 有 一 个 女 子 ， 何 至 你 去 在 未 受 割 礼 的 非 利 士 人 中 娶 妻 呢 ？ 参 孙 对 他 父 亲 说 ： 愿 你 给 我 娶 那 女 子 ， 因 我 喜 悦 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6914', '7', '14', '4', '他 的 父 母 却 不 知 道 这 事 是 出 於 耶 和 华 ， 因 为 他 找 机 会 攻 击 非 利 士 人 。 那 时 ， 非 利 士 人 辖 制 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6915', '7', '14', '5', '参 孙 跟 他 父 母 下 亭 拿 去 ， 到 了 亭 拿 的 葡 萄 园 ， 见 有 一 只 少 壮 狮 子 向 他 吼 叫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6916', '7', '14', '6', '耶 和 华 的 灵 大 大 感 动 参 孙 ， 他 虽 然 手 无 器 械 ， 却 将 狮 子 撕 裂 ， 如 同 撕 裂 山 羊 羔 一 样 。 他 行 这 事 并 没 有 告 诉 父 母 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6917', '7', '14', '7', '参 孙 下 去 与 女 子 说 话 ， 就 喜 悦 他 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6918', '7', '14', '8', '过 了 些 日 子 ， 再 下 去 要 娶 那 女 子 ， 转 向 道 旁 要 看 死 狮 ， 见 有 一 群 蜂 子 和 蜜 在 死 狮 之 内 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6919', '7', '14', '9', '就 用 手 取 蜜 ， 且 吃 且 走 ； 到 了 父 母 那 里 ， 给 他 父 母 ， 他 们 也 吃 了 ； 只 是 没 有 告 诉 这 蜜 是 从 死 狮 之 内 取 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6920', '7', '14', '10', '他 父 亲 下 去 见 女 子 。 参 孙 在 那 里 设 摆 筵 宴 ， 因 为 向 来 少 年 人 都 有 这 个 规 矩 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6921', '7', '14', '11', '众 人 看 见 参 孙 ， 就 请 了 三 十 个 人 陪 伴 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6922', '7', '14', '12', '参 孙 对 他 们 说 ： 我 给 你 们 出 一 个 谜 语 ， 你 们 在 七 日 筵 宴 之 内 ， 若 能 猜 出 意 思 告 诉 我 ， 我 就 给 你 们 三 十 件 里 衣 ， 三 十 套 衣 裳 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6923', '7', '14', '13', '你 们 若 不 能 猜 出 意 思 告 诉 我 ， 你 们 就 给 我 三 十 件 里 衣 ， 三 十 套 衣 裳 。 他 们 说 ： 请 将 谜 语 说 给 我 们 听 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6924', '7', '14', '14', '参 孙 对 他 们 说 ： 吃 的 从 吃 者 出 来 ； 甜 的 从 强 者 出 来 。 他 们 三 日 不 能 猜 出 谜 语 的 意 思 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6925', '7', '14', '15', '到 第 七 天 ， 他 们 对 参 孙 的 妻 说 ： 你 诓 哄 你 丈 夫 ， 探 出 谜 语 的 意 思 告 诉 我 们 ， 免 得 我 们 用 火 烧 你 和 你 父 家 。 你 们 请 了 我 们 来 ， 是 要 夺 我 们 所 有 的 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6926', '7', '14', '16', '参 孙 的 妻 在 丈 夫 面 前 啼 哭 说 ： 你 是 恨 我 ， 不 是 爱 我 ， 你 给 我 本 国 的 人 出 谜 语 ， 却 没 有 将 意 思 告 诉 我 。 参 孙 回 答 说 ： 连 我 父 母 我 都 没 有 告 诉 ， 岂 可 告 诉 你 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6927', '7', '14', '17', '七 日 筵 宴 之 内 ， 他 在 丈 夫 面 前 啼 哭 ， 到 第 七 天 逼 着 他 ， 他 才 将 谜 语 的 意 思 告 诉 他 妻 ， 他 妻 就 告 诉 本 国 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6928', '7', '14', '18', '到 第 七 天 ， 日 头 未 落 以 前 ， 那 城 里 的 人 对 参 孙 说 ： 有 甚 麽 比 蜜 还 甜 呢 ？ 有 甚 麽 比 狮 子 还 强 呢 ？ 参 孙 对 他 们 说 ： 你 们 若 非 用 我 的 母 牛 犊 耕 地 ， 就 猜 不 出 我 谜 语 的 意 思 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6929', '7', '14', '19', '耶 和 华 的 灵 大 大 感 动 参 孙 ， 他 就 下 到 亚 实 基 伦 ， 击 杀 了 三 十 个 人 ， 夺 了 他 们 的 衣 裳 ， 将 衣 裳 给 了 猜 出 谜 语 的 人 。 参 孙 发 怒 ， 就 上 父 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6930', '7', '14', '20', '参 孙 的 妻 便 归 了 参 孙 的 陪 伴 ， 就 是 作 过 他 朋 友 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6931', '7', '15', '1', '过 了 些 日 子 ， 到 割 麦 子 的 时 候 ， 参 孙 带 着 一 只 山 羊 羔 去 看 他 的 妻 ， 说 ： 我 要 进 内 室 见 我 的 妻 。 他 岳 父 不 容 他 进 去 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6932', '7', '15', '2', '说 ： 我 估 定 你 是 极 其 恨 他 ， 因 此 我 将 他 给 了 你 的 陪 伴 。 他 的 妹 子 不 是 比 他 还 美 丽 麽 ？ 你 可 以 娶 来 代 替 他 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6933', '7', '15', '3', '参 孙 说 ： 这 回 我 加 害 於 非 利 士 人 不 算 有 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6934', '7', '15', '4', '於 是 参 孙 去 捉 了 三 百 只 狐 狸 （ 或 译 ： 野 狗 ） ， 将 狐 狸 尾 巴 一 对 一 对 地 捆 上 ， 将 火 把 捆 在 两 条 尾 巴 中 间 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6935', '7', '15', '5', '点 着 火 把 ， 就 放 狐 狸 进 入 非 利 士 人 站 着 的 禾 稼 ， 将 堆 集 的 禾 捆 和 未 割 的 禾 稼 ， 并 橄 榄 园 尽 都 烧 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6936', '7', '15', '6', '非 利 士 人 说 ： 这 事 是 谁 做 的 呢 ？ 有 人 说 ： 是 亭 拿 人 的 女 婿 参 孙 ， 因 为 他 岳 父 将 他 的 妻 给 了 他 的 陪 伴 。 於 是 非 利 士 人 上 去 ， 用 火 烧 了 妇 人 和 他 的 父 亲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6937', '7', '15', '7', '参 孙 对 非 利 士 人 说 ： 你 们 既 然 这 样 行 ， 我 必 向 你 们 报 仇 才 肯 罢 休 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6938', '7', '15', '8', '参 孙 就 大 大 击 杀 他 们 ， 连 腿 带 腰 都 砍 断 了 。 他 便 下 去 ， 住 在 以 坦 磐 的 穴 内 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6939', '7', '15', '9', '非 利 士 人 上 去 安 营 在 犹 大 ， 布 散 在 利 希 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6940', '7', '15', '10', '犹 大 人 说 ： 你 们 为 何 上 来 攻 击 我 们 呢 ？ 他 们 说 ： 我 们 上 来 是 要 捆 绑 参 孙 ； 他 向 我 们 怎 样 行 ， 我 们 也 要 向 他 怎 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6941', '7', '15', '11', '於 是 有 三 千 犹 大 人 下 到 以 坦 磐 的 穴 内 ， 对 参 孙 说 ： 非 利 士 人 辖 制 我 们 ， 你 不 知 道 麽 ？ 你 向 我 们 行 的 是 甚 麽 事 呢 ？ 他 回 答 说 ： 他 们 向 我 怎 样 行 ， 我 也 要 向 他 们 怎 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6942', '7', '15', '12', '犹 大 人 对 他 说 ： 我 们 下 来 是 要 捆 绑 你 ， 将 你 交 在 非 利 士 人 手 中 。 参 孙 说 ： 你 们 要 向 我 起 誓 ， 应 承 你 们 自 己 不 害 死 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6943', '7', '15', '13', '他 们 说 ： 我 们 断 不 杀 你 ， 只 要 将 你 捆 绑 交 在 非 利 士 人 手 中 。 於 是 用 两 条 新 绳 捆 绑 参 孙 ， 将 他 从 以 坦 磐 带 上 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6944', '7', '15', '14', '参 孙 到 了 利 希 ， 非 利 士 人 都 迎 着 喧 嚷 。 耶 和 华 的 灵 大 大 感 动 参 孙 ， 他 臂 上 的 绳 就 像 火 烧 的 麻 一 样 ， 他 的 绑 绳 都 从 他 手 上 脱 落 下 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6945', '7', '15', '15', '他 见 一 块 未 乾 的 驴 腮 骨 ， 就 伸 手 拾 起 来 ， 用 以 击 杀 一 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6946', '7', '15', '16', '参 孙 说 ： 我 用 驴 ? 骨 杀 人 成 堆 ， 用 驴 腮 骨 杀 了 一 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6947', '7', '15', '17', '说 完 这 话 ， 就 把 那 ? 骨 从 手 里 抛 出 去 了 。 那 地 便 叫 拉 末 利 希 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6948', '7', '15', '18', '参 孙 甚 觉 口 渴 ， 就 求 告 耶 和 华 说 ： 你 既 藉 仆 人 的 手 施 行 这 麽 大 的 拯 救 ， 岂 可 任 我 渴 死 、 落 在 未 受 割 礼 的 人 手 中 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6949', '7', '15', '19', '　 神 就 使 利 希 的 洼 处 裂 开 ， 有 水 从 其 中 涌 出 来 。 参 孙 喝 了 ， 精 神 复 原 ； 因 此 那 泉 名 叫 隐 哈 歌 利 ， 那 泉 直 到 今 日 还 在 利 希 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6950', '7', '15', '20', '当 非 利 士 人 辖 制 以 色 列 人 的 时 候 ， 参 孙 作 以 色 列 的 士 师 二 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6951', '7', '16', '1', '参 孙 到 了 迦 萨 ， 在 那 里 看 见 一 个 妓 女 ， 就 与 他 亲 近 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6952', '7', '16', '2', '有 人 告 诉 迦 萨 人 说 ： 参 孙 到 这 里 来 了 ！ 他 们 就 把 他 团 团 围 住 ， 终 夜 在 城 门 悄 悄 埋 伏 ， 说 ： 等 到 天 亮 我 们 便 杀 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6953', '7', '16', '3', '参 孙 睡 到 半 夜 ， 起 来 ， 将 城 门 的 门 扇 、 门 框 、 门 闩 ， 一 齐 拆 下 来 ， 扛 在 肩 上 ， 扛 到 希 伯 仑 前 的 山 顶 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6954', '7', '16', '4', '後 来 ， 参 孙 在 梭 烈 谷 喜 爱 一 个 妇 人 ， 名 叫 大 利 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6955', '7', '16', '5', '非 利 士 人 的 首 领 上 去 见 那 妇 人 ， 对 他 说 ： 求 你 诓 哄 参 孙 ， 探 探 他 因 何 有 这 麽 大 的 力 气 ， 我 们 用 何 法 能 胜 他 ， 捆 绑 克 制 他 。 我 们 就 每 人 给 你 一 千 一 百 舍 客 勒 银 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6956', '7', '16', '6', '大 利 拉 对 参 孙 说 ： 求 你 告 诉 我 ， 你 因 何 有 这 麽 大 的 力 气 ， 当 用 何 法 捆 绑 克 制 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6957', '7', '16', '7', '参 孙 回 答 说 ： 人 若 用 七 条 未 乾 的 青 绳 子 捆 绑 我 ， 我 就 软 弱 像 别 人 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6958', '7', '16', '8', '於 是 非 利 士 人 的 首 领 拿 了 七 条 未 乾 的 青 绳 子 来 ， 交 给 妇 人 ， 他 就 用 绳 子 捆 绑 参 孙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6959', '7', '16', '9', '有 人 预 先 埋 伏 在 妇 人 的 内 室 里 。 妇 人 说 ： 参 孙 哪 ， 非 利 士 人 拿 你 来 了 ！ 参 孙 就 挣 断 绳 子 ， 如 挣 断 经 火 的 麻 线 一 般 。 这 样 ， 他 力 气 的 根 由 人 还 是 不 知 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6960', '7', '16', '10', '大 利 拉 对 参 孙 说 ： 你 欺 哄 我 ， 向 我 说 谎 言 。 现 在 求 你 告 诉 我 当 用 何 法 捆 绑 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6961', '7', '16', '11', '参 孙 回 答 说 ： 人 若 用 没 有 使 过 的 新 绳 捆 绑 我 ， 我 就 软 弱 像 别 人 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6962', '7', '16', '12', '大 利 拉 就 用 新 绳 捆 绑 他 ， 对 他 说 ： 参 孙 哪 ， 非 利 士 人 拿 你 来 了 ！ 有 人 预 先 埋 伏 在 内 室 里 。 参 孙 将 臂 上 的 绳 挣 断 了 ， 如 挣 断 一 条 线 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6963', '7', '16', '13', '大 利 拉 对 参 孙 说 ： 你 到 如 今 还 是 欺 哄 我 ， 向 我 说 谎 言 。 求 你 告 诉 我 ， 当 用 何 法 捆 绑 你 。 参 孙 回 答 说 ： 你 若 将 我 头 上 的 七 条 发 绺 ， 与 纬 线 同 织 就 可 以 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6964', '7', '16', '14', '於 是 大 利 拉 将 他 的 发 绺 与 纬 线 同 织 ， 用 橛 子 钉 住 ， 对 他 说 ： 参 孙 哪 ， 非 利 士 人 拿 你 来 了 ！ 参 孙 从 睡 中 醒 来 ， 将 机 上 的 橛 子 和 纬 线 一 齐 都 拔 出 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6965', '7', '16', '15', '大 利 拉 对 参 孙 说 ： 你 既 不 与 我 同 心 ， 怎 麽 说 你 爱 我 呢 ？ 你 这 三 次 欺 哄 我 ， 没 有 告 诉 我 ， 你 因 何 有 这 麽 大 的 力 气 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6966', '7', '16', '16', '大 利 拉 天 天 用 话 催 逼 他 ， 甚 至 他 心 里 烦 闷 要 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6967', '7', '16', '17', '参 孙 就 把 心 中 所 藏 的 都 告 诉 了 他 ， 对 他 说 ： 向 来 人 没 有 用 剃 头 刀 剃 我 的 头 ， 因 为 我 自 出 母 胎 就 归 　 神 作 拿 细 耳 人 ； 若 剃 了 我 的 头 发 ， 我 的 力 气 就 离 开 我 ， 我 便 软 弱 像 别 人 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6968', '7', '16', '18', '大 利 拉 见 他 把 心 中 所 藏 的 都 告 诉 了 他 ， 就 打 发 人 到 非 利 士 人 的 首 领 那 里 ， 对 他 们 说 ： 他 已 经 把 心 中 所 藏 的 都 告 诉 了 我 ， 请 你 们 再 上 来 一 次 。 於 是 非 利 士 人 的 首 领 手 里 拿 着 银 子 ， 上 到 妇 人 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6969', '7', '16', '19', '大 利 拉 使 参 孙 枕 着 他 的 膝 睡 觉 ， 叫 了 一 个 人 来 剃 除 他 头 上 的 七 条 发 绺 。 於 是 大 利 拉 克 制 他 ， 他 的 力 气 就 离 开 他 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6970', '7', '16', '20', '大 利 拉 说 ： 参 孙 哪 ， 非 利 士 人 拿 你 来 了 ！ 参 孙 从 睡 中 醒 来 ， 心 里 说 ： 我 要 像 前 几 次 出 去 活 动 身 体 ； 他 却 不 知 道 耶 和 华 已 经 离 开 他 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6971', '7', '16', '21', '非 利 士 人 将 他 拿 住 ， 剜 了 他 的 眼 睛 ， 带 他 下 到 迦 萨 ， 用 铜 炼 拘 索 他 ； 他 就 在 监 里 推 磨 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6972', '7', '16', '22', '然 而 他 的 头 发 被 剃 之 後 ， 又 渐 渐 长 起 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6973', '7', '16', '23', '非 利 士 人 的 首 领 聚 集 ， 要 给 他 们 的 神 大 衮 献 大 祭 ， 并 且 欢 乐 ， 因 为 他 们 说 ： 我 们 的 　 神 将 我 们 的 仇 敌 参 孙 交 在 我 们 手 中 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6974', '7', '16', '24', '众 人 看 见 参 孙 ， 就 赞 美 他 们 的 　 神 说 ： 我 们 的 　 神 将 毁 坏 我 们 地 、 杀 害 我 们 许 多 人 的 仇 敌 交 在 我 们 手 中 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6975', '7', '16', '25', '他 们 正 宴 乐 的 时 候 ， 就 说 ： 叫 参 孙 来 ， 在 我 们 面 前 戏 耍 戏 耍 。 於 是 将 参 孙 从 监 里 提 出 来 ， 他 就 在 众 人 面 前 戏 耍 。 他 们 使 他 站 在 两 柱 中 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6976', '7', '16', '26', '参 孙 向 拉 他 手 的 童 子 说 ： 求 你 让 我 摸 着 托 房 的 柱 子 ， 我 要 靠 一 靠 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6977', '7', '16', '27', '那 时 房 内 充 满 男 女 ， 非 利 士 人 的 众 首 领 也 都 在 那 里 。 房 的 平 顶 上 约 有 三 千 男 女 观 看 参 孙 戏 耍 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6978', '7', '16', '28', '参 孙 求 告 耶 和 华 说 ： 主 耶 和 华 啊 ， 求 你 眷 念 我 。 神 啊 ， 求 你 赐 我 这 一 次 的 力 量 ， 使 我 在 非 利 士 人 身 上 报 那 剜 我 双 眼 的 仇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6979', '7', '16', '29', '参 孙 就 抱 住 托 房 的 那 两 根 柱 子 ： 左 手 抱 一 根 ， 右 手 抱 一 根 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6980', '7', '16', '30', '说 ： 我 情 愿 与 非 利 士 人 同 死 ！ 就 尽 力 屈 身 ， 房 子 倒 塌 ， 压 住 首 领 和 房 内 的 众 人 。 这 样 ， 参 孙 死 时 所 杀 的 人 比 活 着 所 杀 的 还 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6981', '7', '16', '31', '参 孙 的 弟 兄 和 他 父 的 全 家 都 下 去 取 他 的 尸 首 ， 抬 上 来 葬 在 琐 拉 和 以 实 陶 中 间 ， 在 他 父 玛 挪 亚 的 坟 墓 里 。 参 孙 作 以 色 列 的 士 师 二 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6982', '7', '17', '1', '以 法 莲 山 地 有 一 个 人 名 叫 米 迦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6983', '7', '17', '2', '他 对 母 亲 说 ： 你 那 一 千 一 百 舍 客 勒 银 子 被 人 拿 去 ， 你 因 此 咒 诅 ， 并 且 告 诉 了 我 。 看 哪 ， 这 银 子 在 我 这 里 ， 是 我 拿 去 了 。 他 母 亲 说 ： 我 儿 啊 ， 愿 耶 和 华 赐 福 与 你 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6984', '7', '17', '3', '米 迦 就 把 这 一 千 一 百 舍 客 勒 银 子 还 他 母 亲 。 他 母 亲 说 ： 我 分 出 这 银 子 来 为 你 献 给 耶 和 华 ， 好 雕 刻 一 个 像 ， 铸 成 一 个 像 。 现 在 我 还 是 交 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6985', '7', '17', '4', '米 迦 将 银 子 还 他 母 亲 ， 他 母 亲 将 二 百 舍 客 勒 银 子 交 给 银 匠 ， 雕 刻 一 个 像 ， 铸 成 一 个 像 ， 安 置 在 米 迦 的 屋 内 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6986', '7', '17', '5', '这 米 迦 有 了 　 神 堂 ， 又 制 造 以 弗 得 和 家 中 的 神 像 ， 分 派 他 一 个 儿 子 作 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6987', '7', '17', '6', '那 时 以 色 列 中 没 有 王 ， 各 人 任 意 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6988', '7', '17', '7', '犹 大 的 伯 利 恒 有 一 个 少 年 人 ， 是 犹 大 族 的 利 未 人 ， 他 在 那 里 寄 居 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6989', '7', '17', '8', '这 人 离 开 犹 大 的 伯 利 恒 城 ， 要 找 一 个 可 住 的 地 方 。 行 路 的 时 候 ， 到 了 以 法 莲 山 地 ， 走 到 米 迦 的 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6990', '7', '17', '9', '米 迦 问 他 说 ： 你 从 哪 里 来 ？ 他 回 答 说 ： 从 犹 大 的 伯 利 恒 来 。 我 是 利 未 人 ， 要 找 一 个 可 住 的 地 方 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6991', '7', '17', '10', '米 迦 说 ： 你 可 以 住 在 我 这 里 ， 我 以 你 为 父 、 为 祭 司 。 我 每 年 给 你 十 舍 客 勒 银 子 ， 一 套 衣 服 和 度 日 的 食 物 。 利 未 人 就 进 了 他 的 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6992', '7', '17', '11', '利 未 人 情 愿 与 那 人 同 住 ； 那 人 看 这 少 年 人 如 自 己 的 儿 子 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6993', '7', '17', '12', '米 迦 分 派 这 少 年 的 利 未 人 作 祭 司 ， 他 就 住 在 米 迦 的 家 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6994', '7', '17', '13', '米 迦 说 ： 现 在 我 知 道 耶 和 华 必 赐 福 与 我 ， 因 我 有 一 个 利 未 人 作 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6995', '7', '18', '1', '那 时 ， 以 色 列 中 没 有 王 。 但 支 派 的 人 仍 是 寻 地 居 住 ； 因 为 到 那 日 子 ， 他 们 还 没 有 在 以 色 列 支 派 中 得 地 为 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6996', '7', '18', '2', '但 人 从 琐 拉 和 以 实 陶 打 发 本 族 中 的 五 个 勇 士 ， 去 仔 细 窥 探 那 地 ， 吩 咐 他 们 说 ： 你 们 去 窥 探 那 地 。 他 们 来 到 以 法 莲 山 地 ， 进 了 米 迦 的 住 宅 ， 就 在 那 里 住 宿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6997', '7', '18', '3', '他 们 临 近 米 迦 的 住 宅 ， 听 出 那 少 年 利 未 人 的 口 音 来 ， 就 进 去 问 他 说 ： 谁 领 你 到 这 里 来 ？ 你 在 这 里 做 甚 麽 ？ 你 在 这 里 得 甚 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6998', '7', '18', '4', '他 回 答 说 ： 米 迦 待 我 如 此 如 此 ， 请 我 作 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6999', '7', '18', '5', '他 们 对 他 说 ： 请 你 求 问 　 神 ， 使 我 们 知 道 所 行 的 道 路 通 达 不 通 达 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7000', '7', '18', '6', '祭 司 对 他 们 说 ： 你 们 可 以 平 平 安 安 地 去 ， 你 们 所 行 的 道 路 是 在 耶 和 华 面 前 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7001', '7', '18', '7', '五 人 就 走 了 ， 来 到 拉 亿 ， 见 那 里 的 民 安 居 无 虑 ， 如 同 西 顿 人 安 居 一 样 。 在 那 地 没 有 人 掌 权 扰 乱 他 们 ； 他 们 离 西 顿 人 也 远 ， 与 别 人 没 有 来 往 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7002', '7', '18', '8', '五 人 回 到 琐 拉 和 以 实 陶 ， 见 他 们 的 弟 兄 ； 弟 兄 问 他 们 说 ： 你 们 有 甚 麽 话 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7003', '7', '18', '9', '他 们 回 答 说 ： 起 来 ， 我 们 上 去 攻 击 他 们 罢 ！ 我 们 已 经 窥 探 那 地 ， 见 那 地 甚 好 。 你 们 为 何 静 坐 不 动 呢 ？ 要 急 速 前 往 得 那 地 为 业 ， 不 可 迟 延 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7004', '7', '18', '10', '你 们 到 了 那 里 ， 必 看 见 安 居 无 虑 的 民 ， 地 也 宽 阔 。 □ 　 神 已 将 那 地 交 在 你 们 手 中 ； 那 地 百 物 俱 全 ， 一 无 所 缺 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7005', '7', '18', '11', '於 是 但 族 中 的 六 百 人 ， 各 带 兵 器 ， 从 琐 拉 和 以 实 陶 前 往 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7006', '7', '18', '12', '上 到 犹 大 的 基 列 耶 琳 ， 在 基 列 耶 琳 後 边 安 营 。 因 此 那 地 方 名 叫 玛 哈 尼 但 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7007', '7', '18', '13', '他 们 从 那 里 往 以 法 莲 山 地 去 ， 来 到 米 迦 的 住 宅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7008', '7', '18', '14', '从 前 窥 探 拉 亿 地 的 五 个 人 对 他 们 的 弟 兄 说 ： 这 宅 子 里 有 以 弗 得 和 家 中 的 神 像 ， 并 雕 刻 的 像 与 铸 成 的 像 ， 你 们 知 道 麽 ？ 现 在 你 们 要 想 一 想 当 怎 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7009', '7', '18', '15', '五 人 就 进 入 米 迦 的 住 宅 ， 到 了 那 少 年 利 未 人 的 房 内 问 他 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7010', '7', '18', '16', '那 六 百 但 人 各 带 兵 器 ， 站 在 门 口 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7011', '7', '18', '17', '窥 探 地 的 五 个 人 走 进 去 ， 将 雕 刻 的 像 、 以 弗 得 、 家 中 的 神 像 ， 并 铸 成 的 像 ， 都 拿 了 去 。 祭 司 和 带 兵 器 的 六 百 人 ， 一 同 站 在 门 口 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7012', '7', '18', '18', '那 五 个 人 进 入 米 迦 的 住 宅 ， 拿 出 雕 刻 的 像 、 以 弗 得 、 家 中 的 神 像 ， 并 铸 成 的 像 ， 祭 司 就 问 他 们 说 ： 你 们 做 甚 麽 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7013', '7', '18', '19', '他 们 回 答 说 ： 不 要 作 声 ， 用 手 捂 口 ， 跟 我 们 去 罢 ！ 我 们 必 以 你 为 父 、 为 祭 司 。 你 作 一 家 的 祭 司 好 呢 ？ 还 是 作 以 色 列 一 族 一 支 派 的 祭 司 好 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7014', '7', '18', '20', '祭 司 心 里 喜 悦 ， 便 拿 着 以 弗 得 和 家 中 的 神 像 ， 并 雕 刻 的 像 ， 进 入 他 们 中 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7015', '7', '18', '21', '他 们 就 转 身 离 开 那 里 ， 妻 子 、 儿 女 、 牲 畜 、 财 物 都 在 前 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7016', '7', '18', '22', '离 米 迦 的 住 宅 已 远 ， 米 迦 的 近 邻 都 聚 集 来 ， 追 赶 但 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7017', '7', '18', '23', '呼 叫 但 人 。 但 人 回 头 问 米 迦 说 ： 你 聚 集 这 许 多 人 来 做 甚 麽 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7018', '7', '18', '24', '米 迦 说 ： 你 们 将 我 所 做 的 神 像 和 祭 司 都 带 了 去 ， 我 还 有 所 剩 的 麽 ？ 怎 麽 还 问 我 说 做 甚 麽 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7019', '7', '18', '25', '但 人 对 米 迦 说 ： 你 不 要 使 我 们 听 见 你 的 声 音 ， 恐 怕 有 性 暴 的 人 攻 击 你 ， 以 致 你 和 你 的 全 家 尽 都 丧 命 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7020', '7', '18', '26', '但 人 还 是 走 他 们 的 路 。 米 迦 见 他 们 的 势 力 比 自 己 强 盛 ， 就 转 身 回 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7021', '7', '18', '27', '但 人 将 米 迦 所 做 的 神 像 和 他 的 祭 司 都 带 到 拉 亿 ， 见 安 居 无 虑 的 民 ， 就 用 刀 杀 了 那 民 ， 又 放 火 烧 了 那 城 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7022', '7', '18', '28', '并 无 人 搭 救 ； 因 为 离 西 顿 远 ， 他 们 又 与 别 人 没 有 来 往 。 城 在 平 原 ， 那 平 原 靠 近 伯 利 合 。 但 人 又 在 那 里 修 城 居 住 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7023', '7', '18', '29', '照 着 他 们 始 祖 以 色 列 之 子 但 的 名 字 ， 给 那 城 起 名 叫 但 ； 原 先 那 城 名 叫 拉 亿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7024', '7', '18', '30', '但 人 就 为 自 己 设 立 那 雕 刻 的 像 。 摩 西 的 孙 子 、 革 舜 的 儿 子 约 拿 单 ， 和 他 的 子 孙 作 但 支 派 的 祭 司 ， 直 到 那 地 遭 掳 掠 的 日 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7025', '7', '18', '31', '　 神 的 殿 在 示 罗 多 少 日 子 ， 但 人 为 自 己 设 立 米 迦 所 雕 刻 的 像 也 在 但 多 少 日 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7026', '7', '19', '1', '当 以 色 列 中 没 有 王 的 时 候 ， 有 住 以 法 莲 山 地 那 边 的 一 个 利 未 人 ， 娶 了 一 个 犹 大 伯 利 恒 的 女 子 为 妾 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7027', '7', '19', '2', '妾 行 淫 离 开 丈 夫 ， 回 犹 大 的 伯 利 恒 ， 到 了 父 家 ， 在 那 里 住 了 四 个 月 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7028', '7', '19', '3', '他 丈 夫 起 来 ， 带 着 一 个 仆 人 、 两 匹 驴 去 见 他 ， 用 好 话 劝 他 回 来 。 女 子 就 引 丈 夫 进 入 父 家 。 他 父 见 了 那 人 ， 便 欢 欢 喜 喜 地 迎 接 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7029', '7', '19', '4', '那 人 的 岳 父 ， 就 是 女 子 的 父 亲 ， 将 那 人 留 下 住 了 三 天 。 於 是 二 人 一 同 吃 喝 、 住 宿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7030', '7', '19', '5', '到 第 四 天 ， 利 未 人 清 早 起 来 要 走 ， 女 子 的 父 亲 对 女 婿 说 ： 请 你 吃 点 饭 ， 加 添 心 力 ， 然 後 可 以 行 路 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7031', '7', '19', '6', '於 是 二 人 坐 下 一 同 吃 喝 。 女 子 的 父 亲 对 那 人 说 ： 请 你 再 住 一 夜 ， 畅 快 你 的 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7032', '7', '19', '7', '那 人 起 来 要 走 ， 他 岳 父 强 留 他 ， 他 又 住 了 一 宿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7033', '7', '19', '8', '到 第 五 天 ， 他 清 早 起 来 要 走 ， 女 子 的 父 亲 说 ： 请 你 吃 点 饭 ， 加 添 心 力 ， 等 到 日 头 偏 西 再 走 。 於 是 二 人 一 同 吃 饭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7034', '7', '19', '9', '那 人 同 他 的 妾 和 仆 人 起 来 要 走 ， 他 岳 父 ， 就 是 女 子 的 父 亲 ， 对 他 说 ： 看 哪 ， 日 头 偏 西 了 ， 请 你 再 住 一 夜 ； 天 快 晚 了 ， 可 以 在 这 里 住 宿 ， 畅 快 你 的 心 。 明 天 早 早 起 行 回 家 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7035', '7', '19', '10', '那 人 不 愿 再 住 一 夜 ， 就 备 上 那 两 匹 驴 ， 带 着 妾 起 身 走 了 ， 来 到 耶 布 斯 的 对 面 （ 耶 布 斯 就 是 耶 路 撒 冷 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7036', '7', '19', '11', '临 近 耶 布 斯 的 时 候 ， 日 头 快 要 落 了 ， 仆 人 对 主 人 说 ： 我 们 不 如 进 这 耶 布 斯 人 的 城 里 住 宿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7037', '7', '19', '12', '主 人 回 答 说 ： 我 们 不 可 进 不 是 以 色 列 人 住 的 外 邦 城 ， 不 如 过 到 基 比 亚 去 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7038', '7', '19', '13', '又 对 仆 人 说 ： 我 们 可 以 到 一 个 地 方 ， 或 住 在 基 比 亚 ， 或 住 在 拉 玛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7039', '7', '19', '14', '他 们 就 往 前 走 。 将 到 便 雅 悯 的 基 比 亚 ， 日 头 已 经 落 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7040', '7', '19', '15', '他 们 进 入 基 比 亚 要 在 那 里 住 宿 ， 就 坐 在 城 里 的 街 上 ， 因 为 无 人 接 他 们 进 家 住 宿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7041', '7', '19', '16', '晚 上 ， 有 一 个 老 年 人 从 田 间 做 工 回 来 。 他 原 是 以 法 莲 山 地 的 人 ， 住 在 基 比 亚 ； 那 地 方 的 人 却 是 便 雅 悯 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7042', '7', '19', '17', '老 年 人 举 目 看 见 客 人 坐 在 城 里 的 街 上 ， 就 问 他 说 ： 你 从 哪 里 来 ？ 要 往 哪 里 去 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7043', '7', '19', '18', '他 回 答 说 ： 我 们 从 犹 大 的 伯 利 恒 来 ， 要 往 以 法 莲 山 地 那 边 去 。 我 原 是 那 里 的 人 ， 到 过 犹 大 的 伯 利 恒 ， 现 在 我 往 耶 和 华 的 殿 去 ， 在 这 里 无 人 接 我 进 他 的 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7044', '7', '19', '19', '其 实 我 有 粮 草 可 以 喂 驴 ， 我 与 我 的 妾 ， 并 我 的 仆 人 ， 有 饼 有 酒 ， 并 不 缺 少 甚 麽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7045', '7', '19', '20', '老 年 人 说 ： 愿 你 平 安 ！ 你 所 需 用 的 我 都 给 你 ， 只 是 不 可 在 街 上 过 夜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7046', '7', '19', '21', '於 是 领 他 们 到 家 里 ， 喂 上 驴 ， 他 们 就 洗 脚 吃 喝 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7047', '7', '19', '22', '他 们 心 里 正 欢 畅 的 时 候 ， 城 中 的 匪 徒 围 住 房 子 ， 连 连 叩 门 ， 对 房 主 老 人 说 ： 你 把 那 进 你 家 的 人 带 出 来 ， 我 们 要 与 他 交 合 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7048', '7', '19', '23', '那 房 主 出 来 对 他 们 说 ： 弟 兄 们 哪 ， 不 要 这 样 作 恶 ； 这 人 既 然 进 了 我 的 家 ， 你 们 就 不 要 行 这 丑 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7049', '7', '19', '24', '我 有 个 女 儿 ， 还 是 处 女 ， 并 有 这 人 的 妾 ， 我 将 他 们 领 出 来 任 凭 你 们 玷 辱 他 们 ， 只 是 向 这 人 不 可 行 这 样 的 丑 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7050', '7', '19', '25', '那 些 人 却 不 听 从 他 的 话 。 那 人 就 把 他 的 妾 拉 出 去 交 给 他 们 ， 他 们 便 与 他 交 合 ， 终 夜 凌 辱 他 ， 直 到 天 色 快 亮 才 放 他 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7051', '7', '19', '26', '天 快 亮 的 时 候 ， 妇 人 回 到 他 主 人 住 宿 的 房 门 前 ， 就 仆 倒 在 地 ， 直 到 天 亮 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7052', '7', '19', '27', '早 晨 ， 他 的 主 人 起 来 开 了 房 门 ， 出 去 要 行 路 ， 不 料 那 妇 人 仆 倒 在 房 门 前 ， 两 手 搭 在 门 槛 上 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7053', '7', '19', '28', '就 对 妇 人 说 ： 起 来 ， 我 们 走 罢 ！ 妇 人 却 不 回 答 。 那 人 便 将 他 驮 在 驴 上 ， 起 身 回 本 处 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7054', '7', '19', '29', '到 了 家 里 ， 用 刀 将 妾 的 尸 身 切 成 十 二 块 ， 使 人 拿 着 传 送 以 色 列 的 四 境 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7055', '7', '19', '30', '凡 看 见 的 人 都 说 ： 从 以 色 列 人 出 埃 及 地 ， 直 到 今 日 ， 这 样 的 事 没 有 行 过 ， 也 没 有 见 过 。 现 在 应 当 思 想 ， 大 家 商 议 当 怎 样 办 理 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7056', '7', '20', '1', '於 是 以 色 列 从 但 到 别 是 巴 ， 以 及 住 基 列 地 的 众 人 都 出 来 ， 如 同 一 人 ， 聚 集 在 米 斯 巴 耶 和 华 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7057', '7', '20', '2', '以 色 列 民 的 首 领 ， 就 是 各 支 派 的 军 长 ， 都 站 在 　 神 百 姓 的 会 中 ； 拿 刀 的 步 兵 共 有 四 十 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7058', '7', '20', '3', '以 色 列 人 上 到 米 斯 巴 ， 便 雅 悯 人 都 听 见 了 。 以 色 列 人 说 ： 请 你 将 这 件 恶 事 的 情 由 对 我 们 说 明 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7059', '7', '20', '4', '那 利 未 人 ， 就 是 被 害 之 妇 人 的 丈 夫 ， 回 答 说 ： 我 和 我 的 妾 到 了 便 雅 悯 的 基 比 亚 住 宿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7060', '7', '20', '5', '基 比 亚 人 夜 间 起 来 ， 围 了 我 住 的 房 子 ， 想 要 杀 我 ， 又 将 我 的 妾 强 奸 致 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7061', '7', '20', '6', '我 就 把 我 妾 的 尸 身 切 成 块 子 ， 使 人 拿 着 传 送 以 色 列 得 为 业 的 全 地 ， 因 为 基 比 亚 人 在 以 色 列 中 行 了 扔 菏 丑 恶 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7062', '7', '20', '7', '你 们 以 色 列 人 都 当 筹 划 商 议 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7063', '7', '20', '8', '众 民 都 起 来 如 同 一 人 ， 说 ： 我 们 连 一 人 都 不 回 自 己 帐 棚 、 自 己 房 屋 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7064', '7', '20', '9', '我 们 向 基 比 亚 人 必 这 样 行 ， 照 所 掣 的 签 去 攻 击 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7065', '7', '20', '10', '我 们 要 在 以 色 列 各 支 派 中 ， 一 百 人 挑 取 十 人 ， 一 千 人 挑 取 百 人 ， 一 万 人 挑 取 千 人 ， 为 民 运 粮 ， 等 大 众 到 了 便 雅 悯 的 基 比 亚 ， 就 照 基 比 亚 人 在 以 色 列 中 所 行 的 丑 事 征 伐 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7066', '7', '20', '11', '於 是 以 色 列 众 人 彼 此 连 合 如 同 一 人 ， 聚 集 攻 击 那 城');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7067', '7', '20', '12', '以 色 列 众 支 派 打 发 人 去 ， 问 便 雅 悯 支 派 的 各 家 说 ： 你 们 中 间 怎 麽 做 了 这 样 的 恶 事 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7068', '7', '20', '13', '现 在 你 们 要 将 基 比 亚 的 那 些 匪 徒 交 出 来 ， 我 们 好 治 死 他 们 ， 从 以 色 列 中 除 掉 这 恶 。 便 雅 悯 人 却 不 肯 听 从 他 们 弟 兄 以 色 列 人 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7069', '7', '20', '14', '便 雅 悯 人 从 他 们 的 各 城 里 出 来 ， 聚 集 到 了 基 比 亚 ， 要 与 以 色 列 人 打 仗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7070', '7', '20', '15', '那 时 便 雅 悯 人 从 各 城 里 点 出 拿 刀 的 ， 共 有 二 万 六 千 ； 另 外 还 有 基 比 亚 人 点 出 七 百 精 兵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7071', '7', '20', '16', '在 众 军 之 中 有 拣 选 的 七 百 精 兵 ， 都 是 左 手 便 利 的 ， 能 用 机 弦 甩 石 打 人 ， 毫 发 不 差 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7072', '7', '20', '17', '便 雅 悯 人 之 外 ， 点 出 以 色 列 人 拿 刀 的 ， 共 有 四 十 万 ， 都 是 战 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7073', '7', '20', '18', '以 色 列 人 就 起 来 ， 到 伯 特 利 去 求 问 　 神 说 ： 我 们 中 间 谁 当 首 先 上 去 与 便 雅 悯 人 争 战 呢 ？ 耶 和 华 说 ： 犹 大 当 先 上 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7074', '7', '20', '19', '以 色 列 人 早 晨 起 来 ， 对 着 基 比 亚 安 营 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7075', '7', '20', '20', '以 色 列 人 出 来 ， 要 与 便 雅 悯 人 打 仗 ， 就 在 基 比 亚 前 摆 阵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7076', '7', '20', '21', '便 雅 悯 人 就 从 基 比 亚 出 来 ， 当 日 杀 死 以 色 列 人 二 万 二 千 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7077', '7', '20', '22', '以 色 列 人 彼 此 奋 勇 ， 仍 在 头 一 日 摆 阵 的 地 方 又 摆 阵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7078', '7', '20', '23', '未 摆 阵 之 先 ， 以 色 列 人 上 去 ， 在 耶 和 华 面 前 哭 号 ， 直 到 晚 上 ， 求 问 耶 和 华 说 ： 我 们 再 去 与 我 们 弟 兄 便 雅 悯 人 打 仗 可 以 不 可 以 ？ 耶 和 华 说 ： 可 以 上 去 攻 击 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7079', '7', '20', '24', '第 二 日 ， 以 色 列 人 就 上 前 攻 击 便 雅 悯 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7080', '7', '20', '25', '便 雅 悯 人 也 在 这 日 从 基 比 亚 出 来 ， 与 以 色 列 人 接 战 ， 又 杀 死 他 们 一 万 八 千 ， 都 是 拿 刀 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7081', '7', '20', '26', '以 色 列 众 人 就 上 到 伯 特 利 ， 坐 在 耶 和 华 面 前 哭 号 ， 当 日 禁 食 直 到 晚 上 ； 又 在 耶 和 华 面 前 献 燔 祭 和 平 安 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7082', '7', '20', '27', '那 时 ， 　 神 的 约 柜 在 那 里 ； 亚 伦 的 孙 子 、 以 利 亚 撒 的 儿 子 非 尼 哈 侍 立 在 约 柜 前 。 以 色 列 人 问 耶 和 华 说 ： 我 们 当 再 出 去 与 我 们 弟 兄 便 雅 悯 人 打 仗 呢 ？ 还 是 罢 兵 呢 ？ 耶 和 华 说 ： 你 们 当 上 去 ， 因 为 明 日 我 必 将 他 们 交 在 你 们 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7083', '7', '20', '28', 'a');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7084', '7', '20', '29', '以 色 列 人 在 基 比 亚 的 四 围 设 下 伏 兵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7085', '7', '20', '30', '第 三 日 ， 以 色 列 人 又 上 去 攻 击 便 雅 悯 人 ， 在 基 比 亚 前 摆 阵 ， 与 前 两 次 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7086', '7', '20', '31', '便 雅 悯 人 也 出 来 迎 敌 ， 就 被 引 诱 离 城 ； 在 田 间 两 条 路 上 ， 一 通 伯 特 利 ， 一 通 基 比 亚 ， 像 前 两 次 ， 动 手 杀 死 以 色 列 人 约 有 三 十 个 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7087', '7', '20', '32', '便 雅 悯 人 说 ： 他 们 仍 旧 败 在 我 们 面 前 。 但 以 色 列 人 说 ： 我 们 不 如 逃 跑 ， 引 诱 他 们 离 开 城 到 路 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7088', '7', '20', '33', '以 色 列 众 人 都 起 来 ， 在 巴 力 他 玛 摆 阵 ， 以 色 列 的 伏 兵 从 马 利 迦 巴 埋 伏 的 地 方 冲 上 前 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7089', '7', '20', '34', '有 以 色 列 人 中 的 一 万 精 兵 ， 来 到 基 比 亚 前 接 战 ， 势 派 甚 是 凶 猛 ； 便 雅 悯 人 却 不 知 道 灾 祸 临 近 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7090', '7', '20', '35', '耶 和 华 使 以 色 列 人 杀 败 便 雅 悯 人 。 那 日 ， 以 色 列 人 杀 死 便 雅 悯 人 二 万 五 千 一 百 ， 都 是 拿 刀 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7091', '7', '20', '36', '於 是 便 雅 悯 人 知 道 自 己 败 了 。 先 是 以 色 列 人 ； 因 为 靠 着 在 基 比 亚 前 所 设 的 伏 兵 ， 就 在 便 雅 悯 人 面 前 诈 败 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7092', '7', '20', '37', '伏 兵 急 忙 闯 进 基 比 亚 ， 用 刀 杀 死 全 城 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7093', '7', '20', '38', '以 色 列 人 预 先 同 伏 兵 约 定 在 城 内 放 火 ， 以 烟 气 上 腾 为 号 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7094', '7', '20', '39', '以 色 列 人 临 退 阵 的 时 候 ， 便 雅 悯 人 动 手 杀 死 以 色 列 人 ， 约 有 三 十 个 ， 就 说 ： 他 们 仍 像 前 次 被 我 们 杀 败 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7095', '7', '20', '40', '当 烟 气 如 柱 从 城 中 上 腾 的 时 候 ， 便 雅 悯 人 回 头 观 看 ， 见 全 城 的 烟 气 冲 天 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7096', '7', '20', '41', '以 色 列 人 又 转 身 回 来 ， 便 雅 悯 人 就 甚 惊 惶 ， 因 为 看 见 灾 祸 临 到 自 己 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7097', '7', '20', '42', '他 们 在 以 色 列 人 面 前 转 身 往 旷 野 逃 跑 ； 以 色 列 人 在 後 面 追 杀 。 那 从 各 城 里 出 来 的 ， 也 都 夹 攻 杀 灭 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7098', '7', '20', '43', '以 色 列 人 围 绕 便 雅 悯 人 ， 追 赶 他 们 ， 在 他 们 歇 脚 之 处 、 对 着 日 出 之 地 的 基 比 亚 践 踏 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7099', '7', '20', '44', '便 雅 悯 人 死 了 的 有 一 万 八 千 ， 都 是 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7100', '7', '20', '45', '其 馀 的 人 转 身 向 旷 野 逃 跑 ， 往 临 门 磐 去 。 以 色 列 人 在 道 路 上 杀 了 他 们 五 千 人 ， 如 拾 取 遗 穗 一 样 ， 追 到 基 顿 又 杀 了 他 们 二 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7101', '7', '20', '46', '那 日 便 雅 悯 死 了 的 共 有 二 万 五 千 人 ， 都 是 拿 刀 的 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7102', '7', '20', '47', '只 剩 下 六 百 人 ， 转 身 向 旷 野 逃 跑 ， 到 了 临 门 磐 ， 就 在 那 里 住 了 四 个 月 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7103', '7', '20', '48', '以 色 列 人 又 转 到 便 雅 悯 地 ， 将 各 城 的 人 和 牲 畜 ， 并 一 切 所 遇 见 的 ， 都 用 刀 杀 尽 ， 又 放 火 烧 了 一 切 城 邑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7104', '7', '21', '1', '以 色 列 人 在 米 斯 巴 曾 起 誓 说 ： 我 们 都 不 将 女 儿 给 便 雅 悯 人 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7105', '7', '21', '2', '以 色 列 人 来 到 伯 特 利 ， 坐 在 　 神 面 前 直 到 晚 上 ， 放 声 痛 哭 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7106', '7', '21', '3', '说 ： 耶 和 华 ─ 以 色 列 的 　 神 啊 ， 为 何 以 色 列 中 有 这 样 缺 了 一 支 派 的 事 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7107', '7', '21', '4', '次 日 清 早 ， 百 姓 起 来 ， 在 那 里 筑 了 一 座 坛 ， 献 燔 祭 和 平 安 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7108', '7', '21', '5', '以 色 列 人 彼 此 问 说 ： 以 色 列 各 支 派 中 ， 谁 没 有 同 会 众 上 到 耶 和 华 面 前 来 呢 ？ 先 是 以 色 列 人 起 过 大 誓 说 ， 凡 不 上 米 斯 巴 到 耶 和 华 面 前 来 的 ， 必 将 他 治 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7109', '7', '21', '6', '以 色 列 人 为 他 们 的 弟 兄 便 雅 悯 後 悔 ， 说 ： 如 今 以 色 列 中 绝 了 一 个 支 派 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7110', '7', '21', '7', '我 们 既 在 耶 和 华 面 前 起 誓 说 ， 必 不 将 我 们 的 女 儿 给 便 雅 悯 人 为 妻 ， 现 在 我 们 当 怎 样 办 理 、 使 他 们 剩 下 的 人 有 妻 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7111', '7', '21', '8', '又 彼 此 问 说 ： 以 色 列 支 派 中 谁 没 有 上 米 斯 巴 到 耶 和 华 面 前 来 呢 ？ 他 们 就 查 出 基 列 雅 比 没 有 一 人 进 营 到 会 众 那 里 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7112', '7', '21', '9', '因 为 百 姓 被 数 的 时 候 ， 没 有 一 个 基 列 雅 比 人 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7113', '7', '21', '10', '会 众 就 打 发 一 万 二 千 大 勇 士 ， 吩 咐 他 们 说 ： 你 们 去 用 刀 将 基 列 雅 比 人 连 妇 女 带 孩 子 都 击 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7114', '7', '21', '11', '所 当 行 的 就 是 这 样 ： 要 将 一 切 男 子 和 已 嫁 的 女 子 尽 行 杀 戮 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7115', '7', '21', '12', '他 们 在 基 列 雅 比 人 中 ， 遇 见 了 四 百 个 未 嫁 的 处 女 ， 就 带 到 迦 南 地 的 示 罗 营 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7116', '7', '21', '13', '全 会 众 打 发 人 到 临 门 磐 的 便 雅 悯 人 那 里 ， 向 他 们 说 和 睦 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7117', '7', '21', '14', '当 时 便 雅 悯 人 回 来 了 ， 以 色 列 人 就 把 所 存 活 基 列 雅 比 的 女 子 给 他 们 为 妻 ， 还 是 不 够 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7118', '7', '21', '15', '百 姓 为 便 雅 悯 人 後 悔 ， 因 为 耶 和 华 使 以 色 列 人 缺 了 一 个 支 派 （ 原 文 是 使 以 色 列 中 有 了 破 口 ） 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7119', '7', '21', '16', '会 中 的 长 老 说 ： 便 雅 悯 中 的 女 子 既 然 除 灭 了 ， 我 们 当 怎 样 办 理 、 使 那 馀 剩 的 人 有 妻 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7120', '7', '21', '17', '又 说 ： 便 雅 悯 逃 脱 的 人 当 有 地 业 ， 免 得 以 色 列 中 涂 抹 了 一 个 支 派 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7121', '7', '21', '18', '只 是 我 们 不 能 将 自 己 的 女 儿 给 他 们 为 妻 ； 因 为 以 色 列 人 曾 起 誓 说 ， 有 将 女 儿 给 便 雅 悯 人 为 妻 的 ， 必 受 咒 诅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7122', '7', '21', '19', '他 们 又 说 ： 在 利 波 拿 以 南 ， 伯 特 利 以 北 ， 在 示 剑 大 路 以 东 的 示 罗 ， 年 年 有 耶 和 华 的 节 期 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7123', '7', '21', '20', '就 吩 咐 便 雅 悯 人 说 ： 你 们 去 ， 在 葡 萄 园 中 埋 伏 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7124', '7', '21', '21', '若 看 见 示 罗 的 女 子 出 来 跳 舞 ， 就 从 葡 萄 园 出 来 ， 在 示 罗 的 女 子 中 各 抢 一 个 为 妻 ， 回 便 雅 悯 地 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7125', '7', '21', '22', '他 们 的 父 亲 或 是 弟 兄 若 来 与 我 们 争 竞 ， 我 们 就 说 ： 求 你 们 看 我 们 的 情 面 ， 施 恩 给 这 些 人 ， 因 我 们 在 争 战 的 时 候 没 有 给 他 们 留 下 女 子 为 妻 。 这 也 不 是 你 们 将 子 女 给 他 们 的 ； 若 是 你 们 给 的 ， 就 算 有 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7126', '7', '21', '23', '於 是 便 雅 悯 人 照 样 而 行 ， 按 着 他 们 的 数 目 从 跳 舞 的 女 子 中 抢 去 为 妻 ， 就 回 自 己 的 地 业 去 ， 又 重 修 城 邑 居 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7127', '7', '21', '24', '当 时 以 色 列 人 离 开 那 里 ， 各 归 本 支 派 、 本 宗 族 、 本 地 业 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7128', '7', '21', '25', '那 时 ， 以 色 列 中 没 有 王 ， 各 人 任 意 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7129', '8', '1', '1', '当 士 师 秉 政 的 时 候 ， 国 中 遭 遇 饥 荒 。 在 犹 大 、 伯 利 恒 ， 有 一 个 人 带 着 妻 子 和 两 个 儿 子 往 摩 押 地 去 寄 居 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7130', '8', '1', '2', '这 人 名 叫 以 利 米 勒 ， 他 的 妻 名 叫 拿 俄 米 ； 他 两 个 儿 子 ， 一 个 名 叫 玛 伦 ， 一 个 名 叫 基 连 ， 都 是 犹 大 的 伯 利 恒 的 以 法 他 人 。 他 们 到 了 摩 押 地 ， 就 住 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7131', '8', '1', '3', '後 来 拿 俄 米 的 丈 夫 以 利 米 勒 死 了 ， 剩 下 妇 人 和 他 两 个 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7132', '8', '1', '4', '这 两 个 儿 子 娶 了 摩 押 女 子 为 妻 ， 一 个 名 叫 俄 珥 巴 ， 一 个 名 叫 路 得 ， 在 那 里 住 了 约 有 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7133', '8', '1', '5', '玛 伦 和 基 连 二 人 也 死 了 ， 剩 下 拿 俄 米 ， 没 有 丈 夫 ， 也 没 有 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7134', '8', '1', '6', '他 就 与 两 个 儿 妇 起 身 ， 要 从 摩 押 地 归 回 ； 因 为 他 在 摩 押 地 听 见 耶 和 华 眷 顾 自 己 的 百 姓 ， 赐 粮 食 与 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7135', '8', '1', '7', '於 是 他 和 两 个 儿 妇 起 行 离 开 所 住 的 地 方 ， 要 回 犹 大 地 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7136', '8', '1', '8', '拿 俄 米 对 两 个 儿 妇 说 ： 你 们 各 人 回 娘 家 去 罢 。 愿 耶 和 华 恩 待 你 们 ， 像 你 们 恩 待 已 死 的 人 与 我 一 样 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7137', '8', '1', '9', '愿 耶 和 华 使 你 们 各 在 新 夫 家 中 得 平 安 ！ 於 是 拿 俄 米 与 他 们 亲 嘴 。 他 们 就 放 声 而 哭 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7138', '8', '1', '10', '说 ： 不 然 ， 我 们 必 与 你 一 同 回 你 本 国 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7139', '8', '1', '11', '拿 俄 米 说 ： 我 女 儿 们 哪 ， 回 去 罢 ！ 为 何 要 跟 我 去 呢 ？ 我 还 能 生 子 作 你 们 的 丈 夫 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7140', '8', '1', '12', '我 女 儿 们 哪 ， 回 去 罢 ！ 我 年 纪 老 迈 ， 不 能 再 有 丈 夫 ； 即 或 说 ， 我 还 有 指 望 ， 今 夜 有 丈 夫 可 以 生 子 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7141', '8', '1', '13', '你 们 岂 能 等 着 他 们 长 大 呢 ？ 你 们 岂 能 等 着 他 们 不 嫁 别 人 呢 ？ 我 女 儿 们 哪 ， 不 要 这 样 。 我 为 你 们 的 缘 故 甚 是 愁 苦 ， 因 为 耶 和 华 伸 手 攻 击 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7142', '8', '1', '14', '两 个 儿 妇 又 放 声 而 哭 ， 俄 珥 巴 与 婆 婆 亲 嘴 而 别 ， 只 是 路 得 舍 不 得 拿 俄 米 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7143', '8', '1', '15', '拿 俄 米 说 ： 看 哪 ， 你 嫂 子 已 经 回 他 本 国 和 他 所 拜 的 神 那 里 去 了 ， 你 也 跟 着 你 嫂 子 回 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7144', '8', '1', '16', '路 得 说 ： 不 要 催 我 回 去 不 跟 随 你 。 你 往 哪 里 去 ， 我 也 往 那 里 去 ； 你 在 哪 里 住 宿 ， 我 也 在 那 里 住 宿 ； 你 的 国 就 是 我 的 国 ， 你 的 　 神 就 是 我 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7145', '8', '1', '17', '你 在 哪 里 死 ， 我 也 在 那 里 死 ， 也 葬 在 那 里 。 除 非 死 能 使 你 我 相 离 ！ 不 然 ， 愿 耶 和 华 重 重 地 降 罚 与 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7146', '8', '1', '18', '拿 俄 米 见 路 得 定 意 要 跟 随 自 己 去 ， 就 不 再 劝 他 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7147', '8', '1', '19', '於 是 二 人 同 行 ， 来 到 伯 利 恒 。 他 们 到 了 伯 利 恒 ， 合 城 的 人 就 都 惊 讶 。 妇 女 们 说 ： 这 是 拿 俄 米 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7148', '8', '1', '20', '拿 俄 米 对 他 们 说 ： 不 要 叫 我 拿 俄 米 （ 就 是 甜 的 意 思 ） ， 要 叫 我 玛 拉 （ 就 是 苦 的 意 思 ） ， 因 为 全 能 者 使 我 受 了 大 苦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7149', '8', '1', '21', '我 满 满 地 出 去 ， 耶 和 华 使 我 空 空 地 回 来 。 耶 和 华 降 祸 与 我 ， 全 能 者 使 我 受 苦 。 既 是 这 样 ， 你 们 为 何 还 叫 我 拿 俄 米 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7150', '8', '1', '22', '拿 俄 米 和 他 儿 妇 摩 押 女 子 路 得 ， 从 摩 押 地 回 来 到 伯 利 恒 ， 正 是 动 手 割 大 麦 的 时 候 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7151', '8', '2', '1', '拿 俄 米 的 丈 夫 以 利 米 勒 的 亲 族 中 ， 有 一 个 人 名 叫 波 阿 斯 ， 是 个 大 财 主 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7152', '8', '2', '2', '摩 押 女 子 路 得 对 拿 俄 米 说 ： 容 我 往 田 间 去 ， 我 蒙 谁 的 恩 ， 就 在 谁 的 身 後 拾 取 麦 穗 。 拿 俄 米 说 ： 女 儿 啊 ， 你 只 管 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7153', '8', '2', '3', '路 得 就 去 了 ， 来 到 田 间 ， 在 收 割 的 人 身 後 拾 取 麦 穗 。 他 恰 巧 到 了 以 利 米 勒 本 族 的 人 波 阿 斯 那 块 田 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7154', '8', '2', '4', '波 阿 斯 正 从 伯 利 恒 来 ， 对 收 割 的 人 说 ： 愿 耶 和 华 与 你 们 同 在 ！ 他 们 回 答 说 ： 愿 耶 和 华 赐 福 与 你 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7155', '8', '2', '5', '波 阿 斯 问 监 管 收 割 的 仆 人 说 ： 那 是 谁 家 的 女 子 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7156', '8', '2', '6', '监 管 收 割 的 仆 人 回 答 说 ： 是 那 摩 押 女 子 ， 跟 随 拿 俄 米 从 摩 押 地 回 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7157', '8', '2', '7', '他 说 ： 请 你 容 我 跟 着 收 割 的 人 拾 取 打 捆 剩 下 的 麦 穗 。 他 从 早 晨 直 到 如 今 ， 除 了 在 屋 子 里 坐 一 会 儿 ， 常 在 这 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7158', '8', '2', '8', '波 阿 斯 对 路 得 说 ： 女 儿 啊 ， 听 我 说 ， 不 要 往 别 人 田 里 拾 取 麦 穗 ， 也 不 要 离 开 这 里 ， 要 常 与 我 使 女 们 在 一 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7159', '8', '2', '9', '我 的 仆 人 在 那 块 田 收 割 ， 你 就 跟 着 他 们 去 。 我 已 经 吩 咐 仆 人 不 可 欺 负 你 ； 你 若 渴 了 ， 就 可 以 到 器 皿 那 里 喝 仆 人 打 来 的 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7160', '8', '2', '10', '路 得 就 俯 伏 在 地 叩 拜 ， 对 他 说 ： 我 既 是 外 邦 人 ， 怎 麽 蒙 你 的 恩 ， 这 样 顾 恤 我 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7161', '8', '2', '11', '波 阿 斯 回 答 说 ： 自 从 你 丈 夫 死 後 ， 凡 你 向 婆 婆 所 行 的 ， 并 你 离 开 父 母 和 本 地 ， 到 素 不 认 识 的 民 中 ， 这 些 事 人 全 都 告 诉 我 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7162', '8', '2', '12', '愿 耶 和 华 照 你 所 行 的 赏 赐 你 。 你 来 投 靠 耶 和 华 ─ 以 色 列 　 神 的 翅 膀 下 ， 愿 你 满 得 他 的 赏 赐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7163', '8', '2', '13', '路 得 说 ： 我 主 啊 ， 愿 在 你 眼 前 蒙 恩 。 我 虽 然 不 及 你 的 一 个 使 女 ， 你 还 用 慈 爱 的 话 安 慰 我 的 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7164', '8', '2', '14', '到 了 吃 饭 的 时 候 ， 波 阿 斯 对 路 得 说 ： 你 到 这 里 来 吃 饼 ， 将 饼 蘸 在 醋 里 。 路 得 就 在 收 割 的 人 旁 边 坐 下 ； 他 们 把 烘 了 的 穗 子 递 给 他 。 他 吃 饱 了 ， 还 有 馀 剩 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7165', '8', '2', '15', '他 起 来 又 拾 取 麦 穗 ， 波 阿 斯 吩 咐 仆 人 说 ： 他 就 是 在 捆 中 拾 取 麦 穗 ， 也 可 以 容 他 ， 不 可 羞 辱 他 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7166', '8', '2', '16', '并 要 从 捆 里 抽 出 些 来 ， 留 在 地 下 任 他 拾 取 ， 不 可 叱 吓 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7167', '8', '2', '17', '这 样 ， 路 得 在 田 间 拾 取 麦 穗 ， 直 到 晚 上 ， 将 所 拾 取 的 打 了 ， 约 有 一 伊 法 大 麦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7168', '8', '2', '18', '他 就 把 所 拾 取 的 带 进 城 去 给 婆 婆 看 ， 又 把 他 吃 饱 了 所 剩 的 给 了 婆 婆 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7169', '8', '2', '19', '婆 婆 问 他 说 ： 你 今 日 在 哪 里 拾 取 麦 穗 ， 在 哪 里 做 工 呢 ？ 愿 那 顾 恤 你 的 得 福 。 路 得 就 告 诉 婆 婆 说 ： 我 今 日 在 一 个 名 叫 波 阿 斯 的 人 那 里 做 工 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7170', '8', '2', '20', '拿 俄 米 对 儿 妇 说 ： 愿 那 人 蒙 耶 和 华 赐 福 ， 因 为 他 不 断 地 恩 待 活 人 死 人 。 拿 俄 米 又 说 ： 那 是 我 们 本 族 的 人 ， 是 一 个 至 近 的 亲 属 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7171', '8', '2', '21', '摩 押 女 子 路 得 说 ： 他 对 我 说 ： 你 要 紧 随 我 的 仆 人 拾 取 麦 穗 ， 直 等 他 们 收 完 了 我 的 庄 稼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7172', '8', '2', '22', '拿 俄 米 对 儿 妇 路 得 说 ： 女 儿 啊 ， 你 跟 着 他 的 使 女 出 去 ， 不 叫 人 遇 见 你 在 别 人 田 间 ， 这 才 为 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7173', '8', '2', '23', '於 是 路 得 与 波 阿 斯 的 使 女 常 在 一 处 拾 取 麦 穗 ， 直 到 收 完 了 大 麦 和 小 麦 。 路 得 仍 与 婆 婆 同 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7174', '8', '3', '1', '路 得 的 婆 婆 拿 俄 米 对 他 说 ： 女 儿 啊 ， 我 不 当 为 你 找 个 安 身 之 处 ， 使 你 享 福 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7175', '8', '3', '2', '你 与 波 阿 斯 的 使 女 常 在 一 处 ， 波 阿 斯 不 是 我 们 的 亲 族 麽 ？ 他 今 夜 在 场 上 簸 大 麦 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7176', '8', '3', '3', '你 要 沐 浴 抹 膏 ， 换 上 衣 服 ， 下 到 场 上 ， 却 不 要 使 那 人 认 出 你 来 。 你 等 他 吃 喝 完 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7177', '8', '3', '4', '到 他 睡 的 时 候 ， 你 看 准 他 睡 的 地 方 ， 就 进 去 掀 开 他 脚 上 的 被 ， 躺 卧 在 那 里 ， 他 必 告 诉 你 所 当 做 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7178', '8', '3', '5', '路 得 说 ： 凡 你 所 吩 咐 的 ， 我 必 遵 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7179', '8', '3', '6', '路 得 就 下 到 场 上 ， 照 他 婆 婆 所 吩 咐 他 的 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7180', '8', '3', '7', '波 阿 斯 吃 喝 完 了 ， 心 里 欢 畅 ， 就 去 睡 在 麦 堆 旁 边 。 路 得 便 悄 悄 地 来 掀 开 他 脚 上 的 被 ， 躺 卧 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7181', '8', '3', '8', '到 了 夜 半 ， 那 人 忽 然 惊 醒 ， 翻 过 身 来 ， 不 料 有 女 子 躺 在 他 的 脚 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7182', '8', '3', '9', '他 就 说 ： 你 是 谁 ？ 回 答 说 ： 我 是 你 的 婢 女 路 得 。 求 你 用 你 的 衣 襟 遮 盖 我 ， 因 为 你 是 我 一 个 至 近 的 亲 属 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7183', '8', '3', '10', '波 阿 斯 说 ： 女 儿 啊 ， 愿 你 蒙 耶 和 华 赐 福 。 你 末 後 的 恩 比 先 前 更 大 ； 因 为 少 年 人 无 论 贫 富 ， 你 都 没 有 跟 从 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7184', '8', '3', '11', '女 儿 啊 ， 现 在 不 要 惧 怕 ， 凡 你 所 说 的 ， 我 必 照 着 行 ； 我 本 城 的 人 都 知 道 你 是 个 贤 德 的 女 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7185', '8', '3', '12', '我 实 在 是 你 一 个 至 近 的 亲 属 ， 只 是 还 有 一 个 人 比 我 更 近 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7186', '8', '3', '13', '你 今 夜 在 这 里 住 宿 ， 明 早 他 若 肯 为 你 尽 亲 属 的 本 分 ， 就 由 他 罢 ！ 倘 若 不 肯 ， 我 指 着 永 生 的 耶 和 华 起 誓 ， 我 必 为 你 尽 了 本 分 ， 你 只 管 躺 到 天 亮 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7187', '8', '3', '14', '路 得 便 在 他 脚 下 躺 到 天 快 亮 ， 人 彼 此 不 能 辨 认 的 时 候 就 起 来 了 。 波 阿 斯 说 ： 不 可 使 人 知 道 有 女 子 到 场 上 来 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7188', '8', '3', '15', '又 对 路 得 说 ： 打 开 你 所 披 的 外 衣 。 他 打 开 了 ， 波 阿 斯 就 撮 了 六 簸 箕 大 麦 ， 帮 他 扛 在 肩 上 ， 他 便 进 城 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7189', '8', '3', '16', '路 得 回 到 婆 婆 那 里 ， 婆 婆 说 ： 女 儿 啊 ， 怎 麽 样 了 ？ 路 得 就 将 那 人 向 他 所 行 的 述 说 了 一 遍 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7190', '8', '3', '17', '又 说 ： 那 人 给 了 我 六 簸 箕 大 麦 ， 对 我 说 ： 你 不 可 空 手 回 去 见 你 的 婆 婆 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7191', '8', '3', '18', '婆 婆 说 ： 女 儿 啊 ， 你 只 管 安 坐 等 候 ， 看 这 事 怎 样 成 就 ， 因 为 那 人 今 日 不 办 成 这 事 必 不 休 息 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7192', '8', '4', '1', '波 阿 斯 到 了 城 门 ， 坐 在 那 里 ， 恰 巧 波 阿 斯 所 说 的 那 至 近 的 亲 属 经 过 。 波 阿 斯 说 ： 某 人 哪 ， 你 来 坐 在 这 里 。 他 就 来 坐 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7193', '8', '4', '2', '波 阿 斯 又 从 本 城 的 长 老 中 拣 选 了 十 人 ， 对 他 们 说 ： 请 你 们 坐 在 这 里 。 他 们 就 都 坐 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7194', '8', '4', '3', '波 阿 斯 对 那 至 近 的 亲 属 说 ： 从 摩 押 地 回 来 的 拿 俄 米 ， 现 在 要 卖 我 们 族 兄 以 利 米 勒 的 那 块 地 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7195', '8', '4', '4', '我 想 当 赎 那 块 地 的 是 你 ， 其 次 是 我 ， 以 外 再 没 有 别 人 了 。 你 可 以 在 这 里 的 人 面 前 和 我 本 国 的 长 老 面 前 说 明 ， 你 若 肯 赎 就 赎 ， 若 不 肯 赎 就 告 诉 我 。 那 人 回 答 说 ： 我 肯 赎 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7196', '8', '4', '5', '波 阿 斯 说 ： 你 从 拿 俄 米 手 中 买 这 地 的 时 候 ， 也 当 娶 （ 原 文 是 买 ；10 节 同 ） 死 人 的 妻 摩 押 女 子 路 得 ， 使 死 人 在 产 业 上 存 留 他 的 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7197', '8', '4', '6', '那 人 说 ： 这 样 我 就 不 能 赎 了 ， 恐 怕 於 我 的 产 业 有 碍 。 你 可 以 赎 我 所 当 赎 的 ， 我 不 能 赎 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7198', '8', '4', '7', '从 前 ， 在 以 色 列 中 要 定 夺 甚 麽 事 ， 或 赎 回 ， 或 交 易 ， 这 人 就 脱 鞋 给 那 人 。 以 色 列 人 都 以 此 为 证 据 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7199', '8', '4', '8', '那 人 对 波 阿 斯 说 ： 你 自 己 买 罢 ！ 於 是 将 鞋 脱 下 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7200', '8', '4', '9', '波 阿 斯 对 长 老 和 众 民 说 ： 你 们 今 日 作 见 证 ， 凡 属 以 利 米 勒 和 基 连 、 玛 伦 的 ， 我 都 从 拿 俄 米 手 中 置 买 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7201', '8', '4', '10', '又 娶 了 玛 伦 的 妻 摩 押 女 子 路 得 为 妻 ， 好 在 死 人 的 产 业 上 存 留 他 的 名 ， 免 得 他 的 名 在 本 族 本 乡 灭 没 。 你 们 今 日 可 以 作 见 证 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7202', '8', '4', '11', '在 城 门 坐 着 的 众 民 和 长 老 都 说 ： 我 们 作 见 证 。 愿 耶 和 华 使 进 你 家 的 这 女 子 ， 像 建 立 以 色 列 家 的 拉 结 、 利 亚 二 人 一 样 。 又 愿 你 在 以 法 他 得 亨 通 ， 在 伯 利 恒 得 名 声 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7203', '8', '4', '12', '愿 耶 和 华 从 这 少 年 女 子 赐 你 後 裔 ， 使 你 的 家 像 他 玛 从 犹 大 所 生 法 勒 斯 的 家 一 般 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7204', '8', '4', '13', '於 是 ， 波 阿 斯 娶 了 路 得 为 妻 ， 与 他 同 房 。 耶 和 华 使 他 怀 孕 生 了 一 个 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7205', '8', '4', '14', '妇 人 们 对 拿 俄 米 说 ： 耶 和 华 是 应 当 称 颂 的 ！ 因 为 今 日 没 有 撇 下 你 ， 使 你 无 至 近 的 亲 属 。 愿 这 孩 子 在 以 色 列 中 得 名 声 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7206', '8', '4', '15', '他 必 提 起 你 的 精 神 ， 奉 养 你 的 老 ， 因 为 是 爱 慕 你 的 那 儿 妇 所 生 的 。 有 这 儿 妇 比 有 七 个 儿 子 还 好 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7207', '8', '4', '16', '拿 俄 米 就 把 孩 子 抱 在 怀 中 ， 作 他 的 养 母 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7208', '8', '4', '17', '邻 舍 的 妇 人 说 ： 拿 俄 米 得 孩 子 了 ！ 就 给 孩 子 起 名 叫 俄 备 得 。 这 俄 备 得 是 耶 西 的 父 ， 耶 西 是 大 卫 的 父 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7209', '8', '4', '18', '法 勒 斯 的 後 代 记 在 下 面 ： 法 勒 斯 生 希 斯 仑 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7210', '8', '4', '19', '希 斯 仑 生 兰 ； 兰 生 亚 米 拿 达 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7211', '8', '4', '20', '亚 米 拿 达 生 拿 顺 ； 拿 顺 生 撒 门 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7212', '8', '4', '21', '撒 门 生 波 阿 斯 ； 波 阿 斯 生 俄 备 得 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7213', '8', '4', '22', '俄 备 得 生 耶 西 ； 耶 西 生 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7214', '9', '1', '1', '以 法 莲 山 地 的 拉 玛 琐 非 有 一 个 以 法 莲 人 ， 名 叫 以 利 加 拿 ， 是 苏 弗 的 玄 孙 ， 托 户 的 曾 孙 ， 以 利 户 的 孙 子 ， 耶 罗 罕 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7215', '9', '1', '2', '他 有 两 个 妻 ： 一 名 哈 拿 ， 一 名 毗 尼 拿 。 毗 尼 拿 有 儿 女 ， 哈 拿 没 有 儿 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7216', '9', '1', '3', '这 人 每 年 从 本 城 上 到 示 罗 ， 敬 拜 祭 祀 万 军 之 耶 和 华 ； 在 那 里 有 以 利 的 两 个 儿 子 何 弗 尼 、 非 尼 哈 当 耶 和 华 的 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7217', '9', '1', '4', '以 利 加 拿 每 逢 献 祭 的 日 子 ， 将 祭 肉 分 给 他 的 妻 毗 尼 拿 和 毗 尼 拿 所 生 的 儿 女 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7218', '9', '1', '5', '给 哈 拿 的 却 是 双 分 ， 因 为 他 爱 哈 拿 。 无 奈 耶 和 华 不 使 哈 拿 生 育 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7219', '9', '1', '6', '毗 尼 拿 见 耶 和 华 不 使 哈 拿 生 育 ， 就 作 他 的 对 头 ， 大 大 激 动 他 ， 要 使 他 生 气 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7220', '9', '1', '7', '每 年 上 到 耶 和 华 殿 的 时 候 ， 以 利 加 拿 都 以 双 分 给 哈 拿 ； 毗 尼 拿 仍 是 激 动 他 ， 以 致 他 哭 泣 不 吃 饭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7221', '9', '1', '8', '他 丈 夫 以 利 加 拿 对 他 说 ： 哈 拿 啊 ， 你 为 何 哭 泣 ， 不 吃 饭 ， 心 里 愁 闷 呢 ？ 有 我 不 比 十 个 儿 子 还 好 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7222', '9', '1', '9', '他 们 在 示 罗 吃 喝 完 了 ， 哈 拿 就 站 起 来 。 祭 司 以 利 在 耶 和 华 殿 的 门 框 旁 边 ， 坐 在 自 己 的 位 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7223', '9', '1', '10', '哈 拿 心 里 愁 苦 ， 就 痛 痛 哭 泣 ， 祈 祷 耶 和 华 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7224', '9', '1', '11', '许 愿 说 ： 万 军 之 耶 和 华 啊 ， 你 若 垂 顾 婢 女 的 苦 情 ， 眷 念 不 忘 婢 女 ， 赐 我 一 个 儿 子 ， 我 必 使 他 终 身 归 与 耶 和 华 ， 不 用 剃 头 刀 剃 他 的 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7225', '9', '1', '12', '哈 拿 在 耶 和 华 面 前 不 住 地 祈 祷 ， 以 利 定 睛 看 他 的 嘴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7226', '9', '1', '13', '（ 原 来 哈 拿 心 中 默 祷 ， 只 动 嘴 唇 ， 不 出 声 音 ， 因 此 以 利 以 为 他 喝 醉 了 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7227', '9', '1', '14', '以 利 对 他 说 ： 你 要 醉 到 几 时 呢 ？ 你 不 应 该 喝 酒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7228', '9', '1', '15', '哈 拿 回 答 说 ： 主 啊 ， 不 是 这 样 。 我 是 心 里 愁 苦 的 妇 人 ， 清 酒 浓 酒 都 没 有 喝 ， 但 在 耶 和 华 面 前 倾 心 吐 意 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7229', '9', '1', '16', '不 要 将 婢 女 看 作 不 正 经 的 女 子 。 我 因 被 人 激 动 ， 愁 苦 太 多 ， 所 以 祈 求 到 如 今 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7230', '9', '1', '17', '以 利 说 ： 你 可 以 平 平 安 安 地 回 去 。 愿 以 色 列 的 　 神 允 准 你 向 他 所 求 的 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7231', '9', '1', '18', '哈 拿 说 ： 愿 婢 女 在 你 眼 前 蒙 恩 。 於 是 妇 人 走 去 吃 饭 ， 面 上 再 不 带 愁 容 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7232', '9', '1', '19', '次 日 清 早 ， 他 们 起 来 ， 在 耶 和 华 面 前 敬 拜 ， 就 回 拉 玛 。 到 了 家 里 ， 以 利 加 拿 和 妻 哈 拿 同 房 ， 耶 和 华 顾 念 哈 拿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7233', '9', '1', '20', '哈 拿 就 怀 孕 。 日 期 满 足 ， 生 了 一 个 儿 子 ， 给 他 起 名 叫 撒 母 耳 ， 说 ： 这 是 我 从 耶 和 华 那 里 求 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7234', '9', '1', '21', '以 利 加 拿 和 他 全 家 都 上 示 罗 去 ， 要 向 耶 和 华 献 年 祭 ， 并 还 所 许 的 愿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7235', '9', '1', '22', '哈 拿 却 没 有 上 去 ， 对 丈 夫 说 ： 等 孩 子 断 了 奶 ， 我 便 带 他 上 去 朝 见 耶 和 华 ， 使 他 永 远 住 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7236', '9', '1', '23', '他 丈 夫 以 利 加 拿 说 ： 就 随 你 的 意 行 罢 ！ 可 以 等 儿 子 断 了 奶 。 但 愿 耶 和 华 应 验 他 的 话 。 於 是 妇 人 在 家 里 乳 养 儿 子 ， 直 到 断 了 奶 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7237', '9', '1', '24', '既 断 了 奶 ， 就 把 孩 子 带 上 示 罗 ， 到 了 耶 和 华 的 殿 ； 又 带 了 三 只 公 牛 ， 一 伊 法 细 面 ， 一 皮 袋 酒 。 （ 那 时 ， 孩 子 还 小 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7238', '9', '1', '25', '宰 了 一 只 公 牛 ， 就 领 孩 子 到 以 利 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7239', '9', '1', '26', '妇 人 说 ： 主 啊 ， 我 敢 在 你 面 前 起 誓 ， 从 前 在 你 这 里 站 着 祈 求 耶 和 华 的 那 妇 人 ， 就 是 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7240', '9', '1', '27', '我 祈 求 为 要 得 这 孩 子 ； 耶 和 华 已 将 我 所 求 的 赐 给 我 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7241', '9', '1', '28', '所 以 ， 我 将 这 孩 子 归 与 耶 和 华 ， 使 他 终 身 归 与 耶 和 华 。 於 是 在 那 里 敬 拜 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7242', '9', '2', '1', '哈 拿 祷 告 说 ： 我 的 心 因 耶 和 华 快 乐 ； 我 的 角 因 耶 和 华 高 举 。 我 的 口 向 仇 敌 张 开 ； 我 因 耶 和 华 的 救 恩 欢 欣 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7243', '9', '2', '2', '只 有 耶 和 华 为 圣 ； 除 他 以 外 没 有 可 比 的 ， 也 没 有 磐 石 像 我 们 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7244', '9', '2', '3', '人 不 要 夸 口 说 骄 傲 的 话 ， 也 不 要 出 狂 妄 的 言 语 ； 因 耶 和 华 是 大 有 智 识 的 　 神 ， 人 的 行 为 被 他 衡 量 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7245', '9', '2', '4', '勇 士 的 弓 都 已 折 断 ； 跌 倒 的 人 以 力 量 束 腰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7246', '9', '2', '5', '素 来 饱 足 的 ， 反 作 用 人 求 食 ； 饥 饿 的 ， 再 不 饥 饿 。 不 生 育 的 ， 生 了 七 个 儿 子 ； 多 有 儿 女 的 ， 反 倒 衰 微 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7247', '9', '2', '6', '耶 和 华 使 人 死 ， 也 使 人 活 ， 使 人 下 阴 间 ， 也 使 人 往 上 升 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7248', '9', '2', '7', '他 使 人 贫 穷 ， 也 使 人 富 足 ， 使 人 卑 微 ， 也 使 人 高 贵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7249', '9', '2', '8', '他 从 灰 尘 里 抬 举 贫 寒 人 ， 从 粪 堆 中 提 拔 穷 乏 人 ， 使 他 们 与 王 子 同 坐 ， 得 着 荣 耀 的 座 位 。 地 的 柱 子 属 於 耶 和 华 ； 他 将 世 界 立 在 其 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7250', '9', '2', '9', '他 必 保 护 圣 民 的 脚 步 ， 使 恶 人 在 黑 暗 中 寂 然 不 动 ； 人 都 不 能 靠 力 量 得 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7251', '9', '2', '10', '与 耶 和 华 争 竞 的 ， 必 被 打 碎 ； 耶 和 华 必 从 天 上 以 雷 攻 击 他 ， 必 审 判 地 极 的 人 ， 将 力 量 赐 与 所 立 的 王 ， 高 举 受 膏 者 的 角 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7252', '9', '2', '11', '以 利 加 拿 往 拉 玛 回 家 去 了 。 那 孩 子 在 祭 司 以 利 面 前 事 奉 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7253', '9', '2', '12', '以 利 的 两 个 儿 子 是 恶 人 ， 不 认 识 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7254', '9', '2', '13', '这 二 祭 司 待 百 姓 是 这 样 的 规 矩 ： 凡 有 人 献 祭 ， 正 煮 肉 的 时 候 ， 祭 司 的 仆 人 就 来 ， 手 拿 三 齿 的 叉 子 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7255', '9', '2', '14', '将 叉 子 往 罐 里 ， 或 鼎 里 ， 或 釜 里 ， 或 锅 里 一 插 ， 插 上 来 的 肉 ， 祭 司 都 取 了 去 。 凡 上 到 示 罗 的 以 色 列 人 ， 他 们 都 是 这 样 看 待 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7256', '9', '2', '15', '又 在 未 烧 脂 油 以 前 ， 祭 司 的 仆 人 就 来 对 献 祭 的 人 说 ： 将 肉 给 祭 司 ， 叫 他 烤 罢 。 他 不 要 煮 过 的 ， 要 生 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7257', '9', '2', '16', '献 祭 的 人 若 说 ： 必 须 先 烧 脂 油 ， 然 後 你 可 以 随 意 取 肉 。 仆 人 就 说 ： 你 立 时 给 我 ， 不 然 我 便 抢 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7258', '9', '2', '17', '如 此 ， 这 二 少 年 人 的 罪 在 耶 和 华 面 前 甚 重 了 ， 因 为 他 们 藐 视 耶 和 华 的 祭 物 （ 或 译 ： 他 们 使 人 厌 弃 给 耶 和 华 献 祭 ） 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7259', '9', '2', '18', '那 时 ， 撒 母 耳 还 是 孩 子 ， 穿 着 细 麻 布 的 以 弗 得 ， 侍 立 在 耶 和 华 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7260', '9', '2', '19', '他 母 亲 每 年 为 他 做 一 件 小 外 袍 ， 同 着 丈 夫 上 来 献 年 祭 的 时 候 带 来 给 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7261', '9', '2', '20', '以 利 为 以 利 加 拿 和 他 的 妻 祝 福 ， 说 ： 愿 耶 和 华 由 这 妇 人 再 赐 你 後 裔 ， 代 替 你 从 耶 和 华 求 来 的 孩 子 。 他 们 就 回 本 乡 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7262', '9', '2', '21', '耶 和 华 眷 顾 哈 拿 ， 他 就 怀 孕 生 了 三 个 儿 子 ， 两 个 女 儿 。 那 孩 子 撒 母 耳 在 耶 和 华 面 前 渐 渐 长 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7263', '9', '2', '22', '以 利 年 甚 老 迈 ， 听 见 他 两 个 儿 子 待 以 色 列 众 人 的 事 ， 又 听 见 他 们 与 会 幕 门 前 伺 候 的 妇 人 苟 合 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7264', '9', '2', '23', '他 就 对 他 们 说 ： 你 们 为 何 行 这 样 的 事 呢 ？ 我 从 这 众 百 姓 听 见 你 们 的 恶 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7265', '9', '2', '24', '我 儿 啊 ， 不 可 这 样 ！ 我 听 见 你 们 的 风 声 不 好 ， 你 们 使 耶 和 华 的 百 姓 犯 了 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7266', '9', '2', '25', '人 若 得 罪 人 ， 有 士 师 审 判 他 ； 人 若 得 罪 耶 和 华 ， 谁 能 为 他 祈 求 呢 ？ 然 而 他 们 还 是 不 听 父 亲 的 话 ， 因 为 耶 和 华 想 要 杀 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7267', '9', '2', '26', '孩 子 撒 母 耳 渐 渐 长 大 ， 耶 和 华 与 人 越 发 喜 爱 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7268', '9', '2', '27', '有 　 神 人 来 见 以 利 ， 对 他 说 ： 耶 和 华 如 此 说 ： 你 祖 父 在 埃 及 法 老 家 作 奴 仆 的 时 候 ， 我 不 是 向 他 们 显 现 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7269', '9', '2', '28', '在 以 色 列 众 支 派 中 ， 我 不 是 拣 选 人 作 我 的 祭 司 ， 使 他 烧 香 ， 在 我 坛 上 献 祭 ， 在 我 面 前 穿 以 弗 得 ， 又 将 以 色 列 人 所 献 的 火 祭 都 赐 给 你 父 家 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7270', '9', '2', '29', '我 所 吩 咐 献 在 我 居 所 的 祭 物 ， 你 们 为 何 践 踏 ？ 尊 重 你 的 儿 子 过 於 尊 重 我 ， 将 我 民 以 色 列 所 献 美 好 的 祭 物 肥 己 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7271', '9', '2', '30', '因 此 ， 耶 和 华 ─ 以 色 列 的 　 神 说 ： 我 曾 说 ， 你 和 你 父 家 必 永 远 行 在 我 面 前 ； 现 在 我 却 说 ， 决 不 容 你 们 这 样 行 。 因 为 尊 重 我 的 ， 我 必 重 看 他 ； 藐 视 我 的 ， 他 必 被 轻 视 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7272', '9', '2', '31', '日 子 必 到 ， 我 要 折 断 你 的 膀 臂 和 你 父 家 的 膀 臂 ， 使 你 家 中 没 有 一 个 老 年 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7273', '9', '2', '32', '在 神 使 以 色 列 人 享 福 的 时 候 ， 你 必 看 见 我 居 所 的 败 落 。 在 你 家 中 必 永 远 没 有 一 个 老 年 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7274', '9', '2', '33', '我 必 不 从 我 坛 前 灭 尽 你 家 中 的 人 ； 那 未 灭 的 必 使 你 眼 目 乾 瘪 、 心 中 忧 伤 。 你 家 中 所 生 的 人 都 必 死 在 中 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7275', '9', '2', '34', '你 的 两 个 儿 子 何 弗 尼 、 非 尼 哈 所 遭 遇 的 事 可 作 你 的 证 据 ： 他 们 二 人 必 一 日 同 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7276', '9', '2', '35', '我 要 为 自 己 立 一 个 忠 心 的 祭 司 ； 他 必 照 我 的 心 意 而 行 。 我 要 为 他 建 立 坚 固 的 家 ； 他 必 永 远 行 在 我 的 受 膏 者 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7277', '9', '2', '36', '你 家 所 剩 下 的 人 都 必 来 叩 拜 他 ， 求 块 银 子 ， 求 个 饼 ， 说 ： 求 你 赐 我 祭 司 的 职 分 ， 好 叫 我 得 点 饼 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7278', '9', '3', '1', '童 子 撒 母 耳 在 以 利 面 前 事 奉 耶 和 华 。 当 那 些 日 子 ， 耶 和 华 的 言 语 稀 少 ， 不 常 有 默 示 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7279', '9', '3', '2', '一 日 ， 以 利 睡 卧 在 自 己 的 地 方 ； 他 眼 目 昏 花 ， 看 不 分 明 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7280', '9', '3', '3', '　 神 的 灯 在 　 神 耶 和 华 殿 内 约 柜 那 里 ， 还 没 有 熄 灭 ， 撒 母 耳 已 经 睡 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7281', '9', '3', '4', '耶 和 华 呼 唤 撒 母 耳 。 撒 母 耳 说 ： 我 在 这 里 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7282', '9', '3', '5', '就 跑 到 以 利 那 里 ， 说 ： 你 呼 唤 我 ？ 我 在 这 里 。 以 利 回 答 说 ： 我 没 有 呼 唤 你 ， 你 去 睡 罢 。 他 就 去 睡 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7283', '9', '3', '6', '耶 和 华 又 呼 唤 撒 母 耳 。 撒 母 耳 起 来 ， 到 以 利 那 里 ， 说 ： 你 呼 唤 我 ？ 我 在 这 里 。 以 利 回 答 说 ： 我 的 儿 ， 我 没 有 呼 唤 你 ， 你 去 睡 罢 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7284', '9', '3', '7', '那 时 撒 母 耳 还 未 认 识 耶 和 华 ， 也 未 得 耶 和 华 的 默 示 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7285', '9', '3', '8', '耶 和 华 第 三 次 呼 唤 撒 母 耳 。 撒 母 耳 起 来 ， 到 以 利 那 里 ， 说 ： 你 又 呼 唤 我 ？ 我 在 这 里 。 以 利 才 明 白 是 耶 和 华 呼 唤 童 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7286', '9', '3', '9', '因 此 以 利 对 撒 母 耳 说 ： 你 仍 去 睡 罢 ； 若 再 呼 唤 你 ， 你 就 说 ： 耶 和 华 啊 ， 请 说 ， 仆 人 敬 听 ！ 撒 母 耳 就 去 ， 仍 睡 在 原 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7287', '9', '3', '10', '耶 和 华 又 来 站 着 ， 像 前 三 次 呼 唤 说 ： 撒 母 耳 啊 ！ 撒 母 耳 啊 ！ 撒 母 耳 回 答 说 ： 请 说 ， 仆 人 敬 听 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7288', '9', '3', '11', '耶 和 华 对 撒 母 耳 说 ： 我 在 以 色 列 中 必 行 一 件 事 ， 叫 听 见 的 人 都 必 耳 鸣 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7289', '9', '3', '12', '我 指 着 以 利 家 所 说 的 话 ， 到 了 时 候 ， 我 必 始 终 应 验 在 以 利 身 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7290', '9', '3', '13', '我 曾 告 诉 他 必 永 远 降 罚 与 他 的 家 ， 因 他 知 道 儿 子 作 孽 ， 自 招 咒 诅 ， 却 不 禁 止 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7291', '9', '3', '14', '所 以 我 向 以 利 家 起 誓 说 ： 以 利 家 的 罪 孽 ， 虽 献 祭 奉 礼 物 ， 永 不 能 得 赎 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7292', '9', '3', '15', '撒 母 耳 睡 到 天 亮 ， 就 开 了 耶 和 华 的 殿 门 ， 不 敢 将 默 示 告 诉 以 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7293', '9', '3', '16', '以 利 呼 唤 撒 母 耳 说 ： 我 儿 撒 母 耳 啊 ！ 撒 母 耳 回 答 说 ： 我 在 这 里 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7294', '9', '3', '17', '以 利 说 ： 耶 和 华 对 你 说 甚 麽 ， 你 不 要 向 我 隐 瞒 ； 你 若 将 　 神 对 你 所 说 的 隐 瞒 一 句 ， 愿 他 重 重 地 降 罚 与 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7295', '9', '3', '18', '撒 母 耳 就 把 一 切 话 都 告 诉 了 以 利 ， 并 没 有 隐 瞒 。 以 利 说 ： 这 是 出 於 耶 和 华 ， 愿 他 凭 自 己 的 意 旨 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7296', '9', '3', '19', '撒 母 耳 长 大 了 ， 耶 和 华 与 他 同 在 ， 使 他 所 说 的 话 一 句 都 不 落 空 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7297', '9', '3', '20', '从 但 到 别 是 巴 所 有 的 以 色 列 人 都 知 道 耶 和 华 立 撒 母 耳 为 先 知 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7298', '9', '3', '21', '耶 和 华 又 在 示 罗 显 现 ； 因 为 耶 和 华 将 自 己 的 话 默 示 撒 母 耳 ， 撒 母 耳 就 把 这 话 传 遍 以 色 列 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7299', '9', '4', '1', '以 色 列 人 出 去 与 非 利 士 人 打 仗 ， 安 营 在 以 便 以 谢 ； 非 利 士 人 安 营 在 亚 弗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7300', '9', '4', '2', '非 利 士 人 向 以 色 列 人 摆 阵 。 两 军 交 战 的 时 候 ， 以 色 列 人 败 在 非 利 士 人 面 前 ； 非 利 士 人 在 战 场 上 杀 了 他 们 的 军 兵 约 有 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7301', '9', '4', '3', '百 姓 回 到 营 里 ， 以 色 列 的 长 老 说 ： 耶 和 华 今 日 为 何 使 我 们 败 在 非 利 士 人 面 前 呢 ？ 我 们 不 如 将 耶 和 华 的 约 柜 从 示 罗 抬 到 我 们 这 里 来 ， 好 在 我 们 中 间 救 我 们 脱 离 敌 人 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7302', '9', '4', '4', '於 是 百 姓 打 发 人 到 示 罗 ， 从 那 里 将 坐 在 二 基 路 伯 上 万 军 之 耶 和 华 的 约 柜 抬 来 。 以 利 的 两 个 儿 子 何 弗 尼 、 非 尼 哈 与 　 神 的 约 柜 同 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7303', '9', '4', '5', '耶 和 华 的 约 柜 到 了 营 中 ， 以 色 列 众 人 就 大 声 欢 呼 ， 地 便 震 动 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7304', '9', '4', '6', '非 利 士 人 听 见 欢 呼 的 声 音 ， 就 说 ： 在 希 伯 来 人 营 里 大 声 欢 呼 ， 是 甚 麽 缘 故 呢 ？ 随 後 就 知 道 耶 和 华 的 约 柜 到 了 营 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7305', '9', '4', '7', '非 利 士 人 就 惧 怕 起 来 ， 说 ： 有 　 神 到 了 他 们 营 中 ； 又 说 ： 我 们 有 祸 了 ！ 向 来 不 曾 有 这 样 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7306', '9', '4', '8', '我 们 有 祸 了 ！ 谁 能 救 我 们 脱 离 这 些 大 能 之 　 神 的 手 呢 ？ 从 前 在 旷 野 用 各 样 灾 殃 击 打 埃 及 人 的 ， 就 是 这 些 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7307', '9', '4', '9', '非 利 士 人 哪 ， 你 们 要 刚 强 ， 要 作 大 丈 夫 ， 免 得 作 希 伯 来 人 的 奴 仆 ， 如 同 他 们 作 你 们 的 奴 仆 一 样 。 你 们 要 作 大 丈 夫 ， 与 他 们 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7308', '9', '4', '10', '非 利 士 人 和 以 色 列 人 打 仗 ， 以 色 列 人 败 了 ， 各 向 各 家 奔 逃 ， 被 杀 的 人 甚 多 ， 以 色 列 的 步 兵 仆 倒 了 三 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7309', '9', '4', '11', '　 神 的 约 柜 被 掳 去 ， 以 利 的 两 个 儿 子 何 弗 尼 、 非 尼 哈 也 都 被 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7310', '9', '4', '12', '当 日 ， 有 一 个 便 雅 悯 人 从 阵 上 逃 跑 ， 衣 服 撕 裂 ， 头 蒙 灰 尘 ， 来 到 示 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7311', '9', '4', '13', '到 了 的 时 候 ， 以 利 正 在 道 旁 坐 在 自 己 的 位 上 观 望 ， 为 　 神 的 约 柜 心 里 担 忧 。 那 人 进 城 报 信 ， 合 城 的 人 就 都 呼 喊 起 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7312', '9', '4', '14', '以 利 听 见 呼 喊 的 声 音 就 问 说 ： 这 喧 嚷 是 甚 麽 缘 故 呢 ？ 那 人 急 忙 来 报 信 给 以 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7313', '9', '4', '15', '那 时 以 利 九 十 八 岁 了 ， 眼 目 发 直 ， 不 能 看 见 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7314', '9', '4', '16', '那 人 对 以 利 说 ： 我 是 从 阵 上 来 的 ， 今 日 我 从 阵 上 逃 回 。 以 利 说 ： 我 儿 ， 事 情 怎 样 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7315', '9', '4', '17', '报 信 的 回 答 说 ： 以 色 列 人 在 非 利 士 人 面 前 逃 跑 ， 民 中 被 杀 的 甚 多 ！ 你 的 两 个 儿 子 何 弗 尼 、 非 尼 哈 也 都 死 了 ， 并 且 　 神 的 约 柜 被 掳 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7316', '9', '4', '18', '他 一 提 　 神 的 约 柜 ， 以 利 就 从 他 的 位 上 往 後 跌 倒 ， 在 门 旁 折 断 颈 项 而 死 ； 因 为 他 年 纪 老 迈 ， 身 体 沉 重 。 以 利 作 以 色 列 的 士 师 四 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7317', '9', '4', '19', '以 利 的 儿 妇 、 非 尼 哈 的 妻 怀 孕 将 到 产 期 ， 他 听 见 　 神 的 约 柜 被 掳 去 ， 公 公 和 丈 夫 都 死 了 ， 就 猛 然 疼 痛 ， 曲 身 生 产 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7318', '9', '4', '20', '将 要 死 的 时 候 ， 旁 边 站 着 的 妇 人 们 对 他 说 ： 不 要 怕 ！ 你 生 了 男 孩 子 了 。 他 却 不 回 答 ， 也 不 放 在 心 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7319', '9', '4', '21', '他 给 孩 子 起 名 叫 以 迦 博 ， 说 ： 荣 耀 离 开 以 色 列 了 ！ 这 是 因 　 神 的 约 柜 被 掳 去 ， 又 因 他 公 公 和 丈 夫 都 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7320', '9', '4', '22', '他 又 说 ： 荣 耀 离 开 以 色 列 ， 因 为 　 神 的 约 柜 被 掳 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7321', '9', '5', '1', '非 利 士 人 将 　 神 的 约 柜 从 以 便 以 谢 抬 到 亚 实 突 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7322', '9', '5', '2', '非 利 士 人 将 　 神 的 约 柜 抬 进 大 衮 庙 ， 放 在 大 衮 的 旁 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7323', '9', '5', '3', '次 日 清 早 ， 亚 实 突 人 起 来 ， 见 大 衮 仆 倒 在 耶 和 华 的 约 柜 前 ， 脸 伏 於 地 ， 就 把 大 衮 仍 立 在 原 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7324', '9', '5', '4', '又 次 日 清 早 起 来 ， 见 大 衮 仆 倒 在 耶 和 华 的 约 柜 前 ， 脸 伏 於 地 ， 并 且 大 衮 的 头 和 两 手 都 在 门 槛 上 折 断 ， 只 剩 下 大 衮 的 残 体 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7325', '9', '5', '5', '（ 因 此 ， 大 衮 的 祭 司 和 一 切 进 亚 实 突 、 大 衮 庙 的 人 都 不 踏 大 衮 庙 的 门 槛 ， 直 到 今 日 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7326', '9', '5', '6', '耶 和 华 的 手 重 重 加 在 亚 实 突 人 身 上 ， 败 坏 他 们 ， 使 他 们 生 痔 疮 。 亚 实 突 和 亚 实 突 的 四 境 都 是 如 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7327', '9', '5', '7', '亚 实 突 人 见 这 光 景 ， 就 说 ： 以 色 列 　 神 的 约 柜 不 可 留 在 我 们 这 里 ， 因 为 他 的 手 重 重 加 在 我 们 和 我 们 　 神 大 衮 的 身 上 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7328', '9', '5', '8', '就 打 发 人 去 请 非 利 士 的 众 首 领 来 聚 集 ， 问 他 们 说 ： 我 们 向 以 色 列 　 神 的 约 柜 应 当 怎 样 行 呢 ？ 他 们 回 答 说 ： 可 以 将 以 色 列 　 神 的 约 柜 运 到 迦 特 去 。 於 是 将 以 色 列 　 神 的 约 柜 运 到 那 里 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7329', '9', '5', '9', '运 到 之 後 ， 耶 和 华 的 手 攻 击 那 城 ， 使 那 城 的 人 大 大 惊 慌 ， 无 论 大 小 都 生 痔 疮 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7330', '9', '5', '10', '他 们 就 把 　 神 的 约 柜 送 到 以 革 伦 。 　 神 的 约 柜 到 了 ， 以 革 伦 人 就 喊 嚷 起 来 说 ： 他 们 将 以 色 列 　 神 的 约 柜 运 到 我 们 这 里 ， 要 害 我 们 和 我 们 的 众 民 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7331', '9', '5', '11', '於 是 打 发 人 去 请 非 利 士 的 众 首 领 来 ， 说 ： 愿 你 们 将 以 色 列 　 神 的 约 柜 送 回 原 处 ， 免 得 害 了 我 们 和 我 们 的 众 民 ！ 原 来 　 神 的 手 重 重 攻 击 那 城 ， 城 中 的 人 有 因 惊 慌 而 死 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7332', '9', '5', '12', '未 曾 死 的 人 都 生 了 痔 疮 。 合 城 呼 号 ， 声 音 上 达 於 天 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7333', '9', '6', '1', '耶 和 华 的 约 柜 在 非 利 士 人 之 地 七 个 月 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7334', '9', '6', '2', '非 利 士 人 将 祭 司 和 占 卜 的 聚 了 来 ， 问 他 们 说 ： 我 们 向 耶 和 华 的 约 柜 应 当 怎 样 行 ？ 请 指 示 我 们 用 何 法 将 约 柜 送 回 原 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7335', '9', '6', '3', '他 们 说 ： 若 要 将 以 色 列 　 神 的 约 柜 送 回 去 ， 不 可 空 空 地 送 去 ， 必 要 给 他 献 赔 罪 的 礼 物 ， 然 後 你 们 可 得 痊 愈 ， 并 知 道 他 的 手 为 何 不 离 开 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7336', '9', '6', '4', '非 利 士 人 说 ： 应 当 用 甚 麽 献 为 赔 罪 的 礼 物 呢 ？ 他 们 回 答 说 ： 当 照 非 利 士 首 领 的 数 目 ， 用 五 个 金 痔 疮 ， 五 个 金 老 鼠 ， 因 为 在 你 们 众 人 和 你 们 首 领 的 身 上 都 是 一 样 的 灾 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7337', '9', '6', '5', '所 以 当 制 造 你 们 痔 疮 的 像 和 毁 坏 你 们 田 地 老 鼠 的 像 ， 并 要 归 荣 耀 给 以 色 列 的 　 神 ， 或 者 他 向 你 们 和 你 们 的 　 神 ， 并 你 们 的 田 地 ， 把 手 放 轻 些 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7338', '9', '6', '6', '你 们 为 何 硬 着 心 像 埃 及 人 和 法 老 一 样 呢 ？ 　 神 在 埃 及 人 中 间 行 奇 事 ， 埃 及 人 岂 不 释 放 以 色 列 人 ， 他 们 就 去 了 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7339', '9', '6', '7', '现 在 你 们 应 当 造 一 辆 新 车 ， 将 两 只 未 曾 负 轭 有 乳 的 母 牛 套 在 车 上 ， 使 牛 犊 回 家 去 ， 离 开 母 牛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7340', '9', '6', '8', '把 耶 和 华 的 约 柜 放 在 车 上 ， 将 所 献 赔 罪 的 金 物 装 在 匣 子 里 ， 放 在 柜 旁 ， 将 柜 送 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7341', '9', '6', '9', '你 们 要 看 看 ： 车 若 直 行 以 色 列 的 境 界 到 伯 示 麦 去 ， 这 大 灾 就 是 耶 和 华 降 在 我 们 身 上 的 ； 若 不 然 ， 便 可 以 知 道 不 是 他 的 手 击 打 我 们 ， 是 我 们 偶 然 遇 见 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7342', '9', '6', '10', '非 利 士 人 就 这 样 行 ： 将 两 只 有 乳 的 母 牛 套 在 车 上 ， 将 牛 犊 关 在 家 里 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7343', '9', '6', '11', '把 耶 和 华 的 约 柜 和 装 金 老 鼠 并 金 痔 疮 像 的 匣 子 都 放 在 车 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7344', '9', '6', '12', '牛 直 行 大 道 ， 往 伯 示 麦 去 ， 一 面 走 一 面 叫 ， 不 偏 左 右 。 非 利 士 的 首 领 跟 在 後 面 ， 直 到 伯 示 麦 的 境 界 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7345', '9', '6', '13', '伯 示 麦 人 正 在 平 原 收 割 麦 子 ， 举 目 看 见 约 柜 ， 就 欢 喜 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7346', '9', '6', '14', '车 到 了 伯 示 麦 人 约 书 亚 的 田 间 ， 就 站 住 了 。 在 那 里 有 一 块 大 磐 石 ， 他 们 把 车 劈 了 ， 将 两 只 母 牛 献 给 耶 和 华 为 燔 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7347', '9', '6', '15', '利 未 人 将 耶 和 华 的 约 柜 和 装 金 物 的 匣 子 拿 下 来 ， 放 在 大 磐 石 上 。 当 日 伯 示 麦 人 将 燔 祭 和 平 安 祭 献 给 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7348', '9', '6', '16', '非 利 士 人 的 五 个 首 领 看 见 ， 当 日 就 回 以 革 伦 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7349', '9', '6', '17', '非 利 士 人 献 给 耶 和 华 作 赔 罪 的 金 痔 疮 像 ， 就 是 这 些 ： 一 个 是 为 亚 实 突 ， 一 个 是 为 迦 萨 ， 一 个 是 为 亚 实 基 伦 ， 一 个 是 为 迦 特 ， 一 个 是 为 以 革 伦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7350', '9', '6', '18', '金 老 鼠 的 数 目 是 照 非 利 士 五 个 首 领 的 城 邑 ， 就 是 坚 固 的 城 邑 和 乡 村 ， 以 及 大 磐 石 。 这 磐 石 是 放 耶 和 华 约 柜 的 ， 到 今 日 还 在 伯 示 麦 人 约 书 亚 的 田 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7351', '9', '6', '19', '耶 和 华 因 伯 示 麦 人 擅 观 他 的 约 柜 ， 就 击 杀 了 他 们 七 十 人 ； 那 时 有 五 万 人 在 那 里 （ 原 文 是 七 十 人 加 五 万 人 ） 。 百 姓 因 耶 和 华 大 大 击 杀 他 们 ， 就 哀 哭 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7352', '9', '6', '20', '伯 示 麦 人 说 ： 谁 能 在 耶 和 华 这 圣 洁 的 　 神 面 前 侍 立 呢 ？ 这 约 柜 可 以 从 我 们 这 里 送 到 谁 那 里 去 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7353', '9', '6', '21', '於 是 打 发 人 去 见 基 列 耶 琳 的 居 民 ， 说 ： 非 利 士 人 将 耶 和 华 的 约 柜 送 回 来 了 ， 你 们 下 来 将 约 柜 接 到 你 们 那 里 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7354', '9', '7', '1', '基 列 耶 琳 人 就 下 来 ， 将 耶 和 华 的 约 柜 接 上 去 ， 放 在 山 上 亚 比 拿 达 的 家 中 ， 分 派 他 儿 子 以 利 亚 撒 看 守 耶 和 华 的 约 柜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7355', '9', '7', '2', '约 柜 在 基 列 耶 琳 许 久 。 过 了 二 十 年 ， 以 色 列 全 家 都 倾 向 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7356', '9', '7', '3', '撒 母 耳 对 以 色 列 全 家 说 ： 你 们 若 一 心 归 顺 耶 和 华 ， 就 要 把 外 邦 的 　 神 和 亚 斯 他 录 从 你 们 中 间 除 掉 ， 专 心 归 向 耶 和 华 ， 单 单 地 事 奉 他 。 他 必 救 你 们 脱 离 非 利 士 人 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7357', '9', '7', '4', '以 色 列 人 就 除 掉 诸 巴 力 和 亚 斯 他 录 ， 单 单 地 事 奉 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7358', '9', '7', '5', '撒 母 耳 说 ： 要 使 以 色 列 众 人 聚 集 在 米 斯 巴 ， 我 好 为 你 们 祷 告 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7359', '9', '7', '6', '他 们 就 聚 集 在 米 斯 巴 ， 打 水 浇 在 耶 和 华 面 前 ， 当 日 禁 食 ， 说 ： 我 们 得 罪 了 耶 和 华 。 於 是 撒 母 耳 在 米 斯 巴 审 判 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7360', '9', '7', '7', '非 利 士 人 听 见 以 色 列 人 聚 集 在 米 斯 巴 ， 非 利 士 的 首 领 就 上 来 要 攻 击 以 色 列 人 。 以 色 列 人 听 见 ， 就 惧 怕 非 利 士 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7361', '9', '7', '8', '以 色 列 人 对 撒 母 耳 说 ： 愿 你 不 住 地 为 我 们 呼 求 耶 和 华 ─ 我 们 的 　 神 ， 救 我 们 脱 离 非 利 士 人 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7362', '9', '7', '9', '撒 母 耳 就 把 一 只 吃 奶 的 羊 羔 献 与 耶 和 华 作 全 牲 的 燔 祭 ， 为 以 色 列 人 呼 求 耶 和 华 ； 耶 和 华 就 应 允 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7363', '9', '7', '10', '撒 母 耳 正 献 燔 祭 的 时 候 ， 非 利 士 人 前 来 要 与 以 色 列 人 争 战 。 当 日 ， 耶 和 华 大 发 雷 声 ， 惊 乱 非 利 士 人 ， 他 们 就 败 在 以 色 列 人 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7364', '9', '7', '11', '以 色 列 人 从 米 斯 巴 出 来 ， 追 赶 非 利 士 人 ， 击 杀 他 们 ， 直 到 伯 甲 的 下 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7365', '9', '7', '12', '撒 母 耳 将 一 块 石 头 立 在 米 斯 巴 和 善 的 中 间 ， 给 石 头 起 名 叫 以 便 以 谢 ， 说 ： 到 如 今 耶 和 华 都 帮 助 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7366', '9', '7', '13', '从 此 ， 非 利 士 人 就 被 制 伏 ， 不 敢 再 入 以 色 列 人 的 境 内 。 撒 母 耳 作 士 师 的 时 候 ， 耶 和 华 的 手 攻 击 非 利 士 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7367', '9', '7', '14', '非 利 士 人 所 取 以 色 列 人 的 城 邑 ， 从 以 革 伦 直 到 迦 特 ， 都 归 以 色 列 人 了 。 属 这 些 城 的 四 境 ， 以 色 列 人 也 从 非 利 士 人 手 下 收 回 。 那 时 以 色 列 人 与 亚 摩 利 人 和 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7368', '9', '7', '15', '撒 母 耳 平 生 作 以 色 列 的 士 师 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7369', '9', '7', '16', '他 每 年 巡 行 到 伯 特 利 、 吉 甲 、 米 斯 巴 ， 在 这 几 处 审 判 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7370', '9', '7', '17', '随 後 回 到 拉 玛 ， 因 为 他 的 家 在 那 里 ； 也 在 那 里 审 判 以 色 列 人 ， 且 为 耶 和 华 筑 了 一 座 坛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7371', '9', '8', '1', '撒 母 耳 年 纪 老 迈 ， 就 立 他 儿 子 作 以 色 列 的 士 师 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7372', '9', '8', '2', '长 子 名 叫 约 珥 ， 次 子 名 叫 亚 比 亚 ； 他 们 在 别 是 巴 作 士 师 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7373', '9', '8', '3', '他 儿 子 不 行 他 的 道 ， 贪 图 财 利 ， 收 受 贿 赂 ， 屈 枉 正 直 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7374', '9', '8', '4', '以 色 列 的 长 老 都 聚 集 ， 来 到 拉 玛 见 撒 母 耳 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7375', '9', '8', '5', '对 他 说 ： 你 年 纪 老 迈 了 ， 你 儿 子 不 行 你 的 道 。 现 在 求 你 为 我 们 立 一 个 王 治 理 我 们 ， 像 列 国 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7376', '9', '8', '6', '撒 母 耳 不 喜 悦 他 们 说 立 一 个 王 治 理 我 们 ， 他 就 祷 告 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7377', '9', '8', '7', '耶 和 华 对 撒 母 耳 说 ： 百 姓 向 你 说 的 一 切 话 ， 你 只 管 依 从 ； 因 为 他 们 不 是 厌 弃 你 ， 乃 是 厌 弃 我 ， 不 要 我 作 他 们 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7378', '9', '8', '8', '自 从 我 领 他 们 出 埃 及 到 如 今 ， 他 们 常 常 离 弃 我 ， 事 奉 别 　 神 。 现 在 他 们 向 你 所 行 的 ， 是 照 他 们 素 来 所 行 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7379', '9', '8', '9', '故 此 你 要 依 从 他 们 的 话 ， 只 是 当 警 戒 他 们 ， 告 诉 他 们 将 来 那 王 怎 样 管 辖 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7380', '9', '8', '10', '撒 母 耳 将 耶 和 华 的 话 都 传 给 求 他 立 王 的 百 姓 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7381', '9', '8', '11', '管 辖 你 们 的 王 必 这 样 行 ： 他 必 派 你 们 的 儿 子 为 他 赶 车 、 跟 马 ， 奔 走 在 车 前 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7382', '9', '8', '12', '又 派 他 们 作 千 夫 长 、 五 十 夫 长 ， 为 他 耕 种 田 地 ， 收 割 庄 稼 ， 打 造 军 器 和 车 上 的 器 械 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7383', '9', '8', '13', '必 取 你 们 的 女 儿 为 他 制 造 香 膏 ， 做 饭 烤 饼 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7384', '9', '8', '14', '也 必 取 你 们 最 好 的 田 地 、 葡 萄 园 、 橄 榄 园 赐 给 他 的 臣 仆 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7385', '9', '8', '15', '你 们 的 粮 食 和 葡 萄 园 所 出 的 ， 他 必 取 十 分 之 一 给 他 的 太 监 和 臣 仆 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7386', '9', '8', '16', '又 必 取 你 们 的 仆 人 婢 女 ， 健 壮 的 少 年 人 和 你 们 的 驴 ， 供 他 的 差 役 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7387', '9', '8', '17', '你 们 的 羊 群 ， 他 必 取 十 分 之 一 ， 你 们 也 必 作 他 的 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7388', '9', '8', '18', '那 时 你 们 必 因 所 选 的 王 哀 求 耶 和 华 ， 耶 和 华 却 不 应 允 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7389', '9', '8', '19', '百 姓 竟 不 肯 听 撒 母 耳 的 话 ， 说 ： 不 然 ！ 我 们 定 要 一 个 王 治 理 我 们 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7390', '9', '8', '20', '使 我 们 像 列 国 一 样 ， 有 王 治 理 我 们 ， 统 领 我 们 ， 为 我 们 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7391', '9', '8', '21', '撒 母 耳 听 见 百 姓 这 一 切 话 ， 就 将 这 话 陈 明 在 耶 和 华 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7392', '9', '8', '22', '耶 和 华 对 撒 母 耳 说 ： 你 只 管 依 从 他 们 的 话 ， 为 他 们 立 王 。 撒 母 耳 对 以 色 列 人 说 ： 你 们 各 归 各 城 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7393', '9', '9', '1', '有 一 个 便 雅 悯 人 ， 名 叫 基 士 ， 是 便 雅 悯 人 亚 斐 亚 的 玄 孙 ， 比 歌 拉 的 曾 孙 ， 洗 罗 的 孙 子 ， 亚 别 的 儿 子 ， 是 个 大 能 的 勇 士 （ 或 译 ： 大 财 主 ） 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7394', '9', '9', '2', '他 有 一 个 儿 子 ， 名 叫 扫 罗 ， 又 健 壮 、 又 俊 美 ， 在 以 色 列 人 中 没 有 一 个 能 比 他 的 ； 身 体 比 众 民 高 过 一 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7395', '9', '9', '3', '扫 罗 的 父 亲 基 士 丢 了 几 头 驴 ， 他 就 吩 咐 儿 子 扫 罗 说 ： 你 带 一 个 仆 人 去 寻 找 驴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7396', '9', '9', '4', '扫 罗 就 走 过 以 法 莲 山 地 ， 又 过 沙 利 沙 地 ， 都 没 有 找 着 ； 又 过 沙 琳 地 ， 驴 也 不 在 那 里 ； 又 过 便 雅 悯 地 ， 还 没 有 找 着 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7397', '9', '9', '5', '到 了 苏 弗 地 ， 扫 罗 对 跟 随 他 的 仆 人 说 ： 我 们 不 如 回 去 ， 恐 怕 我 父 亲 不 为 驴 挂 心 ， 反 为 我 们 担 忧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7398', '9', '9', '6', '仆 人 说 ： 这 城 里 有 一 位 　 神 人 ， 是 众 人 所 尊 重 的 ， 凡 他 所 说 的 全 都 应 验 。 我 们 不 如 往 他 那 里 去 ， 或 者 他 能 将 我 们 当 走 的 路 指 示 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7399', '9', '9', '7', '扫 罗 对 仆 人 说 ： 我 们 若 去 ， 有 甚 麽 可 以 送 那 人 呢 ？ 我 们 囊 中 的 食 物 都 吃 尽 了 ， 也 没 有 礼 物 可 以 送 那 　 神 人 ， 我 们 还 有 甚 麽 没 有 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7400', '9', '9', '8', '仆 人 回 答 扫 罗 说 ： 我 手 里 有 银 子 一 舍 客 勒 的 四 分 之 一 ， 可 以 送 那 　 神 人 ， 请 他 指 示 我 们 当 走 的 路 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7401', '9', '9', '9', '（ 从 前 以 色 列 中 ， 若 有 人 去 问 　 神 ， 就 说 ： 我 们 问 先 见 去 罢 ！ 现 在 称 为 先 知 的 ， 从 前 称 为 先 见 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7402', '9', '9', '10', '扫 罗 对 仆 人 说 ： 你 说 的 是 ， 我 们 可 以 去 。 於 是 他 们 往 　 神 人 所 住 的 城 里 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7403', '9', '9', '11', '他 们 上 坡 要 进 城 ， 就 遇 见 几 个 少 年 女 子 出 来 打 水 ， 问 他 们 说 ： 先 见 在 这 里 没 有 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7404', '9', '9', '12', '女 子 回 答 说 ： 在 这 里 ， 他 在 你 们 前 面 。 快 去 罢 ！ 他 今 日 正 到 城 里 ， 因 为 今 日 百 姓 要 在 邱 坛 献 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7405', '9', '9', '13', '在 他 还 没 有 上 邱 坛 吃 祭 物 之 先 ， 你 们 一 进 城 必 遇 见 他 ； 因 他 未 到 ， 百 姓 不 能 吃 ， 必 等 他 先 祝 祭 ， 然 後 请 的 客 才 吃 。 现 在 你 们 上 去 ， 这 时 候 必 遇 见 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7406', '9', '9', '14', '二 人 就 上 去 ； 将 进 城 的 时 候 ， 撒 母 耳 正 迎 着 他 们 来 ， 要 上 邱 坛 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7407', '9', '9', '15', '扫 罗 未 到 的 前 一 日 ， 耶 和 华 已 经 指 示 撒 母 耳 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7408', '9', '9', '16', '明 日 这 时 候 ， 我 必 使 一 个 人 从 便 雅 悯 地 到 你 这 里 来 ， 你 要 膏 他 作 我 民 以 色 列 的 君 。 他 必 救 我 民 脱 离 非 利 士 人 的 手 ； 因 我 民 的 哀 声 上 达 於 我 ， 我 就 眷 顾 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7409', '9', '9', '17', '撒 母 耳 看 见 扫 罗 的 时 候 ， 耶 和 华 对 他 说 ： 看 哪 ， 这 人 就 是 我 对 你 所 说 的 ， 他 必 治 理 我 的 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7410', '9', '9', '18', '扫 罗 在 城 门 里 走 到 撒 母 耳 跟 前 ， 说 ： 请 告 诉 我 ， 先 见 的 寓 所 在 哪 里 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7411', '9', '9', '19', '撒 母 耳 回 答 说 ： 我 就 是 先 见 。 你 在 我 前 面 上 邱 坛 去 ， 因 为 你 们 今 日 必 与 我 同 席 ； 明 日 早 晨 我 送 你 去 ， 将 你 心 里 的 事 都 告 诉 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7412', '9', '9', '20', '至 於 你 前 三 日 所 丢 的 那 几 头 驴 ， 你 心 里 不 必 挂 念 ， 已 经 找 着 了 。 以 色 列 众 人 所 仰 慕 的 是 谁 呢 ？ 不 是 仰 慕 你 和 你 父 的 全 家 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7413', '9', '9', '21', '扫 罗 说 ： 我 不 是 以 色 列 支 派 中 至 小 的 便 雅 悯 人 麽 ？ 我 家 不 是 便 雅 悯 支 派 中 至 小 的 家 麽 ？ 你 为 何 对 我 说 这 样 的 话 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7414', '9', '9', '22', '撒 母 耳 领 扫 罗 和 他 仆 人 进 了 客 堂 ， 使 他 们 在 请 来 的 客 中 坐 首 位 ； 客 约 有 三 十 个 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7415', '9', '9', '23', '撒 母 耳 对 厨 役 说 ： 我 交 给 你 收 存 的 那 一 分 祭 肉 现 在 可 以 拿 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7416', '9', '9', '24', '厨 役 就 把 收 存 的 腿 拿 来 ， 摆 在 扫 罗 面 前 ， 撒 母 耳 说 ： 这 是 所 留 下 的 ， 放 在 你 面 前 。 吃 罢 ！ 因 我 请 百 姓 的 时 候 ， 特 意 为 你 存 留 这 肉 到 此 时 。 当 日 ， 扫 罗 就 与 撒 母 耳 同 席 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7417', '9', '9', '25', '众 人 从 邱 坛 下 来 进 城 ， 撒 母 耳 和 扫 罗 在 房 顶 上 说 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7418', '9', '9', '26', '次 日 清 早 起 来 ， 黎 明 的 时 候 ， 扫 罗 在 房 顶 上 。 撒 母 耳 呼 叫 他 说 ： 起 来 罢 ， 我 好 送 你 回 去 。 扫 罗 就 起 来 ， 和 撒 母 耳 一 同 出 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7419', '9', '9', '27', '二 人 下 到 城 角 ， 撒 母 耳 对 扫 罗 说 ： 要 吩 咐 仆 人 先 走 （ 仆 人 就 先 走 了 ） ； 你 且 站 在 这 里 ， 等 我 将 　 神 的 话 传 与 你 听 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7420', '9', '10', '1', '撒 母 耳 拿 瓶 膏 油 倒 在 扫 罗 的 头 上 ， 与 他 亲 嘴 ， 说 ： 这 不 是 耶 和 华 膏 你 作 他 产 业 的 君 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7421', '9', '10', '2', '你 今 日 与 我 离 别 之 後 ， 在 便 雅 悯 境 内 的 泄 撒 ， 靠 近 拉 结 的 坟 墓 ， 要 遇 见 两 个 人 。 他 们 必 对 你 说 ： 你 去 找 的 那 几 头 驴 已 经 找 着 了 。 现 在 你 父 亲 不 为 驴 挂 心 ， 反 为 你 担 忧 ， 说 ： 我 为 儿 子 怎 麽 才 好 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7422', '9', '10', '3', '你 从 那 里 往 前 行 ， 到 了 他 泊 的 橡 树 那 里 ， 必 遇 见 三 个 往 伯 特 利 去 拜 　 神 的 人 ： 一 个 带 着 三 只 山 羊 羔 ， 一 个 带 着 三 个 饼 ， 一 个 带 着 一 皮 袋 酒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7423', '9', '10', '4', '他 们 必 问 你 安 ， 给 你 两 个 饼 ， 你 就 从 他 们 手 中 接 过 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7424', '9', '10', '5', '此 後 你 到 　 神 的 山 ， 在 那 里 有 非 利 士 人 的 防 兵 。 你 到 了 城 的 时 候 ， 必 遇 见 一 班 先 知 从 邱 坛 下 来 ， 前 面 有 鼓 瑟 的 、 击 鼓 的 、 吹 笛 的 、 弹 琴 的 ， 他 们 都 受 感 说 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7425', '9', '10', '6', '耶 和 华 的 灵 必 大 大 感 动 你 ， 你 就 与 他 们 一 同 受 感 说 话 ； 你 要 变 为 新 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7426', '9', '10', '7', '这 兆 头 临 到 你 ， 你 就 可 以 趁 时 而 做 ， 因 为 　 神 与 你 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7427', '9', '10', '8', '你 当 在 我 以 先 下 到 吉 甲 ， 我 也 必 下 到 那 里 献 燔 祭 和 平 安 祭 。 你 要 等 候 七 日 ， 等 我 到 了 那 里 ， 指 示 你 当 行 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7428', '9', '10', '9', '扫 罗 转 身 离 别 撒 母 耳 ， 　 神 就 赐 他 一 个 新 心 。 当 日 这 一 切 兆 头 都 应 验 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7429', '9', '10', '10', '扫 罗 到 了 那 山 ， 有 一 班 先 知 遇 见 他 ， 　 神 的 灵 大 大 感 动 他 ， 他 就 在 先 知 中 受 感 说 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7430', '9', '10', '11', '素 来 认 识 扫 罗 的 ， 看 见 他 和 先 知 一 同 受 感 说 话 ， 就 彼 此 说 ： 基 士 的 儿 子 遇 见 甚 麽 了 ？ 扫 罗 也 列 在 先 知 中 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7431', '9', '10', '12', '那 地 方 有 一 个 人 说 ： 这 些 人 的 父 亲 是 谁 呢 ？ 此 後 有 句 俗 语 说 ： 扫 罗 也 列 在 先 知 中 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7432', '9', '10', '13', '扫 罗 受 感 说 话 已 毕 ， 就 上 邱 坛 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7433', '9', '10', '14', '扫 罗 的 叔 叔 问 扫 罗 和 他 仆 人 说 ： 你 们 往 哪 里 去 了 ？ 回 答 说 ： 找 驴 去 了 。 我 们 见 没 有 驴 ， 就 到 了 撒 母 耳 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7434', '9', '10', '15', '扫 罗 的 叔 叔 说 ： 请 将 撒 母 耳 向 你 们 所 说 的 话 告 诉 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7435', '9', '10', '16', '扫 罗 对 他 叔 叔 说 ： 他 明 明 地 告 诉 我 们 驴 已 经 找 着 了 。 至 於 撒 母 耳 所 说 的 国 事 ， 扫 罗 却 没 有 告 诉 叔 叔 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7436', '9', '10', '17', '撒 母 耳 将 百 姓 招 聚 到 米 斯 巴 耶 和 华 那 里 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7437', '9', '10', '18', '对 他 们 说 ： 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 我 领 你 们 以 色 列 人 出 埃 及 ， 救 你 们 脱 离 埃 及 人 的 手 ， 又 救 你 们 脱 离 欺 压 你 们 各 国 之 人 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7438', '9', '10', '19', '你 们 今 日 却 厌 弃 了 救 你 们 脱 离 一 切 灾 难 的 　 神 ， 说 ： 求 你 立 一 个 王 治 理 我 们 。 现 在 你 们 应 当 按 着 支 派 、 宗 族 都 站 在 耶 和 华 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7439', '9', '10', '20', '於 是 ， 撒 母 耳 使 以 色 列 众 支 派 近 前 来 掣 签 ， 就 掣 出 便 雅 悯 支 派 来 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7440', '9', '10', '21', '又 使 便 雅 悯 支 派 按 着 宗 族 近 前 来 ， 就 掣 出 玛 特 利 族 ， 从 其 中 又 掣 出 基 士 的 儿 子 扫 罗 。 众 人 寻 找 他 却 寻 不 着 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7441', '9', '10', '22', '就 问 耶 和 华 说 ： 那 人 到 这 里 来 了 没 有 ？ 耶 和 华 说 ： 他 藏 在 器 具 中 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7442', '9', '10', '23', '众 人 就 跑 去 从 那 里 领 出 他 来 。 他 站 在 百 姓 中 间 ， 身 体 比 众 民 高 过 一 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7443', '9', '10', '24', '撒 母 耳 对 众 民 说 ： 你 们 看 耶 和 华 所 拣 选 的 人 ， 众 民 中 有 可 比 他 的 麽 ？ 众 民 就 大 声 欢 呼 说 ： 愿 王 万 岁 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7444', '9', '10', '25', '撒 母 耳 将 国 法 对 百 姓 说 明 ， 又 记 在 书 上 ， 放 在 耶 和 华 面 前 ， 然 後 遣 散 众 民 ， 各 回 各 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7445', '9', '10', '26', '扫 罗 往 基 比 亚 回 家 去 ， 有 　 神 感 动 的 一 群 人 跟 随 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7446', '9', '10', '27', '但 有 些 匪 徒 说 ： 这 人 怎 能 救 我 们 呢 ？ 就 藐 视 他 ， 没 有 送 他 礼 物 ； 扫 罗 却 不 理 会 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7447', '9', '11', '1', '亚 扪 人 的 王 拿 辖 上 来 ， 对 着 基 列 雅 比 安 营 。 雅 比 众 人 对 拿 辖 说 ： 你 与 我 们 立 约 ， 我 们 就 服 事 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7448', '9', '11', '2', '亚 扪 人 拿 辖 说 ： 你 们 若 由 我 剜 出 你 们 各 人 的 右 眼 ， 以 此 凌 辱 以 色 列 众 人 ， 我 就 与 你 们 立 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7449', '9', '11', '3', '雅 比 的 长 老 对 他 说 ： 求 你 宽 容 我 们 七 日 ， 等 我 们 打 发 人 往 以 色 列 的 全 境 去 ； 若 没 有 人 救 我 们 ， 我 们 就 出 来 归 顺 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7450', '9', '11', '4', '使 者 到 了 扫 罗 住 的 基 比 亚 ， 将 这 话 说 给 百 姓 听 ， 百 姓 就 都 放 声 而 哭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7451', '9', '11', '5', '扫 罗 正 从 田 间 赶 牛 回 来 ， 问 说 ： 百 姓 为 甚 麽 哭 呢 ？ 众 人 将 雅 比 人 的 话 告 诉 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7452', '9', '11', '6', '扫 罗 听 见 这 话 ， 就 被 　 神 的 灵 大 大 感 动 ， 甚 是 发 怒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7453', '9', '11', '7', '他 将 一 对 牛 切 成 块 子 ， 托 付 使 者 传 送 以 色 列 的 全 境 ， 说 ： 凡 不 出 来 跟 随 扫 罗 和 撒 母 耳 的 ， 也 必 这 样 切 开 他 的 牛 。 於 是 耶 和 华 使 百 姓 惧 怕 ， 他 们 就 都 出 来 ， 如 同 一 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7454', '9', '11', '8', '扫 罗 在 比 色 数 点 他 们 ： 以 色 列 人 有 三 十 万 ， 犹 大 人 有 三 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7455', '9', '11', '9', '众 人 对 那 使 者 说 ： 你 们 要 回 覆 基 列 雅 比 人 说 ， 明 日 太 阳 近 午 的 时 候 ， 你 们 必 得 解 救 。 使 者 回 去 告 诉 雅 比 人 ， 他 们 就 欢 喜 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7456', '9', '11', '10', '於 是 雅 比 人 对 亚 扪 人 说 ： 明 日 我 们 出 来 归 顺 你 们 ， 你 们 可 以 随 意 待 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7457', '9', '11', '11', '第 二 日 ， 扫 罗 将 百 姓 分 为 三 队 ， 在 晨 更 的 时 候 入 了 亚 扪 人 的 营 ， 击 杀 他 们 直 到 太 阳 近 午 ， 剩 下 的 人 都 逃 散 ， 没 有 二 人 同 在 一 处 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7458', '9', '11', '12', '百 姓 对 撒 母 耳 说 ： 那 说 扫 罗 岂 能 管 理 我 们 的 是 谁 呢 ？ 可 以 将 他 交 出 来 ， 我 们 好 杀 死 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7459', '9', '11', '13', '扫 罗 说 ： 今 日 耶 和 华 在 以 色 列 中 施 行 拯 救 ， 所 以 不 可 杀 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7460', '9', '11', '14', '撒 母 耳 对 百 姓 说 ： 我 们 要 往 吉 甲 去 ， 在 那 里 立 国 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7461', '9', '11', '15', '众 百 姓 就 到 了 吉 甲 那 里 ， 在 耶 和 华 面 前 立 扫 罗 为 王 ， 又 在 耶 和 华 面 前 献 平 安 祭 。 扫 罗 和 以 色 列 众 人 大 大 欢 喜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7462', '9', '12', '1', '撒 母 耳 对 以 色 列 众 人 说 ： 你 们 向 我 所 求 的 ， 我 已 应 允 了 ， 为 你 们 立 了 一 个 王 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7463', '9', '12', '2', '现 在 有 这 王 在 你 们 前 面 行 。 我 已 年 老 发 白 ， 我 的 儿 子 都 在 你 们 这 里 。 我 从 幼 年 直 到 今 日 都 在 你 们 前 面 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7464', '9', '12', '3', '我 在 这 里 ， 你 们 要 在 耶 和 华 和 他 的 受 膏 者 面 前 给 我 作 见 证 。 我 夺 过 谁 的 牛 ， 抢 过 谁 的 驴 ， 欺 负 过 谁 ， 虐 待 过 谁 ， 从 谁 手 里 受 过 贿 赂 因 而 眼 瞎 呢 ？ 若 有 ， 我 必 偿 还 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7465', '9', '12', '4', '众 人 说 ： 你 未 曾 欺 负 我 们 ， 虐 待 我 们 ， 也 未 曾 从 谁 手 里 受 过 甚 麽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7466', '9', '12', '5', '撒 母 耳 对 他 们 说 ： 你 们 在 我 手 里 没 有 找 着 甚 麽 ， 有 耶 和 华 和 他 的 受 膏 者 今 日 为 证 。 他 们 说 ： 愿 他 为 证 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7467', '9', '12', '6', '撒 母 耳 对 百 姓 说 ： 从 前 立 摩 西 、 亚 伦 ， 又 领 你 们 列 祖 出 埃 及 地 的 是 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7468', '9', '12', '7', '现 在 你 们 要 站 住 ， 等 我 在 耶 和 华 面 前 对 你 们 讲 论 耶 和 华 向 你 们 和 你 们 列 祖 所 行 一 切 公 义 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7469', '9', '12', '8', '从 前 雅 各 到 了 埃 及 ， 後 来 你 们 列 祖 呼 求 耶 和 华 ， 耶 和 华 就 差 遣 摩 西 、 亚 伦 领 你 们 列 祖 出 埃 及 ， 使 他 们 在 这 地 方 居 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7470', '9', '12', '9', '他 们 却 忘 记 耶 和 华 ─ 他 们 的 　 神 ， 他 就 把 他 们 付 与 夏 琐 将 军 西 西 拉 的 手 里 ， 和 非 利 士 人 并 摩 押 王 的 手 里 。 於 是 这 些 人 常 来 攻 击 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7471', '9', '12', '10', '他 们 就 呼 求 耶 和 华 说 ： 我 们 离 弃 耶 和 华 ， 事 奉 巴 力 和 亚 斯 他 录 ， 是 有 罪 了 。 现 在 求 你 救 我 们 脱 离 仇 敌 的 手 ， 我 们 必 事 奉 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7472', '9', '12', '11', '耶 和 华 就 差 遣 耶 路 巴 力 、 比 但 、 耶 弗 他 、 撒 母 耳 救 你 们 脱 离 四 围 仇 敌 的 手 ， 你 们 才 安 然 居 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7473', '9', '12', '12', '你 们 见 亚 扪 人 的 王 拿 辖 来 攻 击 你 们 ， 就 对 我 说 ： 我 们 定 要 一 个 王 治 理 我 们 。 其 实 耶 和 华 ─ 你 们 的 　 神 是 你 们 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7474', '9', '12', '13', '现 在 ， 你 们 所 求 所 选 的 王 在 这 里 。 看 哪 ， 耶 和 华 已 经 为 你 们 立 王 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7475', '9', '12', '14', '你 们 若 敬 畏 耶 和 华 ， 事 奉 他 ， 听 从 他 的 话 ， 不 违 背 他 的 命 令 ， 你 们 和 治 理 你 们 的 王 也 都 顺 从 耶 和 华 ─ 你 们 的 　 神 就 好 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7476', '9', '12', '15', '倘 若 不 听 从 耶 和 华 的 话 ， 违 背 他 的 命 令 ， 耶 和 华 的 手 必 攻 击 你 们 ， 像 从 前 攻 击 你 们 列 祖 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7477', '9', '12', '16', '现 在 你 们 要 站 住 ， 看 耶 和 华 在 你 们 眼 前 要 行 一 件 大 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7478', '9', '12', '17', '这 不 是 割 麦 子 的 时 候 麽 ？ 我 求 告 耶 和 华 ， 他 必 打 雷 降 雨 ， 使 你 们 又 知 道 又 看 出 ， 你 们 求 立 王 的 事 是 在 耶 和 华 面 前 犯 大 罪 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7479', '9', '12', '18', '於 是 撒 母 耳 求 告 耶 和 华 ， 耶 和 华 就 在 这 日 打 雷 降 雨 ， 众 民 便 甚 惧 怕 耶 和 华 和 撒 母 耳 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7480', '9', '12', '19', '众 民 对 撒 母 耳 说 ： 求 你 为 仆 人 们 祷 告 耶 和 华 ─ 你 的 　 神 ， 免 得 我 们 死 亡 ， 因 为 我 们 求 立 王 的 事 正 是 罪 上 加 罪 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7481', '9', '12', '20', '撒 母 耳 对 百 姓 说 ： 不 要 惧 怕 ！ 你 们 虽 然 行 了 这 恶 ， 却 不 要 偏 离 耶 和 华 ， 只 要 尽 心 事 奉 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7482', '9', '12', '21', '若 偏 离 耶 和 华 去 顺 从 那 不 能 救 人 的 虚 神 是 无 益 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7483', '9', '12', '22', '耶 和 华 既 喜 悦 选 你 们 作 他 的 子 民 ， 就 必 因 他 的 大 名 不 撇 弃 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7484', '9', '12', '23', '至 於 我 ， 断 不 停 止 为 你 们 祷 告 ， 以 致 得 罪 耶 和 华 。 我 必 以 善 道 正 路 指 教 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7485', '9', '12', '24', '只 要 你 们 敬 畏 耶 和 华 ， 诚 诚 实 实 地 尽 心 事 奉 他 ， 想 念 他 向 你 们 所 行 的 事 何 等 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7486', '9', '12', '25', '你 们 若 仍 然 作 恶 ， 你 们 和 你 们 的 王 必 一 同 灭 亡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7487', '9', '13', '1', '扫 罗 登 基 年 四 十 岁 ； 作 以 色 列 王 二 年 的 时 候 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7488', '9', '13', '2', '就 从 以 色 列 中 拣 选 了 三 千 人 ： 二 千 跟 随 扫 罗 在 密 抹 和 伯 特 利 山 ， 一 千 跟 随 约 拿 单 在 便 雅 悯 的 基 比 亚 ； 其 馀 的 人 扫 罗 都 打 发 各 回 各 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7489', '9', '13', '3', '约 拿 单 攻 击 迦 巴 、 非 利 士 人 的 防 营 ， 非 利 士 人 听 见 了 。 扫 罗 就 在 遍 地 吹 角 ， 意 思 说 ， 要 使 希 伯 来 人 听 见 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7490', '9', '13', '4', '以 色 列 众 人 听 见 扫 罗 攻 击 非 利 士 人 的 防 营 ， 又 听 见 以 色 列 人 为 非 利 士 人 所 憎 恶 ， 就 跟 随 扫 罗 聚 集 在 吉 甲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7491', '9', '13', '5', '非 利 士 人 聚 集 ， 要 与 以 色 列 人 争 战 ， 有 车 三 万 辆 ， 马 兵 六 千 ， 步 兵 像 海 边 的 沙 那 样 多 ， 就 上 来 在 伯 亚 文 东 边 的 密 抹 安 营 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7492', '9', '13', '6', '以 色 列 百 姓 见 自 己 危 急 窘 迫 ， 就 藏 在 山 洞 、 丛 林 、 石 穴 、 隐 密 处 ， 和 坑 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7493', '9', '13', '7', '有 些 希 伯 来 人 过 了 约 但 河 ， 逃 到 迦 得 和 基 列 地 。 扫 罗 还 是 在 吉 甲 ， 百 姓 都 战 战 兢 兢 地 跟 随 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7494', '9', '13', '8', '扫 罗 照 着 撒 母 耳 所 定 的 日 期 等 了 七 日 。 撒 母 耳 还 没 有 来 到 吉 甲 ， 百 姓 也 离 开 扫 罗 散 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7495', '9', '13', '9', '扫 罗 说 ： 把 燔 祭 和 平 安 祭 带 到 我 这 里 来 。 扫 罗 就 献 上 燔 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7496', '9', '13', '10', '刚 献 完 燔 祭 ， 撒 母 耳 就 到 了 。 扫 罗 出 去 迎 接 他 ， 要 问 他 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7497', '9', '13', '11', '撒 母 耳 说 ： 你 做 的 是 甚 麽 事 呢 ？ 扫 罗 说 ： 因 为 我 见 百 姓 离 开 我 散 去 ， 你 也 不 照 所 定 的 日 期 来 到 ， 而 且 非 利 士 人 聚 集 在 密 抹 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7498', '9', '13', '12', '所 以 我 心 里 说 ： 恐 怕 我 没 有 祷 告 耶 和 华 。 非 利 士 人 下 到 吉 甲 攻 击 我 ， 我 就 勉 强 献 上 燔 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7499', '9', '13', '13', '撒 母 耳 对 扫 罗 说 ： 你 做 了 糊 涂 事 了 ， 没 有 遵 守 耶 和 华 ─ 你 　 神 所 吩 咐 你 的 命 令 。 若 遵 守 ， 耶 和 华 必 在 以 色 列 中 坚 立 你 的 王 位 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7500', '9', '13', '14', '现 在 你 的 王 位 必 不 长 久 。 耶 和 华 已 经 寻 着 一 个 合 他 心 意 的 人 ， 立 他 作 百 姓 的 君 ， 因 为 你 没 有 遵 守 耶 和 华 所 吩 咐 你 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7501', '9', '13', '15', '撒 母 耳 就 起 来 ， 从 吉 甲 上 到 便 雅 悯 的 基 比 亚 。 扫 罗 数 点 跟 随 他 的 ， 约 有 六 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7502', '9', '13', '16', '扫 罗 和 他 儿 子 约 拿 单 ， 并 跟 随 他 们 的 人 ， 都 住 在 便 雅 悯 的 迦 巴 ； 但 非 利 士 人 安 营 在 密 抹 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7503', '9', '13', '17', '有 掠 兵 从 非 利 士 营 中 出 来 ， 分 为 三 队 ： 一 队 往 俄 弗 拉 向 书 亚 地 去 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7504', '9', '13', '18', '一 队 往 伯 和 仑 去 ， 一 队 往 洗 波 音 谷 对 面 的 地 境 向 旷 野 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7505', '9', '13', '19', '那 时 ， 以 色 列 全 地 没 有 一 个 铁 匠 ； 因 为 非 利 士 人 说 ， 恐 怕 希 伯 来 人 制 造 刀 枪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7506', '9', '13', '20', '以 色 列 人 要 磨 锄 、 犁 、 斧 、 铲 ， 就 下 到 非 利 士 人 那 里 去 磨 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7507', '9', '13', '21', '但 有 锉 可 以 锉 铲 、 犁 、 三 齿 叉 、 斧 子 ， 并 赶 牛 锥 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7508', '9', '13', '22', '所 以 到 了 争 战 的 日 子 ， 跟 随 扫 罗 和 约 拿 单 的 人 没 有 一 个 手 里 有 刀 有 枪 的 ， 惟 独 扫 罗 和 他 儿 子 约 拿 单 有 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7509', '9', '13', '23', '非 利 士 人 的 一 队 防 兵 到 了 密 抹 的 隘 口 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7510', '9', '14', '1', '有 一 日 ， 扫 罗 的 儿 子 约 拿 单 对 拿 他 兵 器 的 少 年 人 说 ： 我 们 不 如 过 到 那 边 ， 到 非 利 士 人 的 防 营 那 里 去 。 但 他 没 有 告 诉 父 亲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7511', '9', '14', '2', '扫 罗 在 基 比 亚 的 尽 边 ， 坐 在 米 矶 仑 的 石 榴 树 下 ， 跟 随 他 的 约 有 六 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7512', '9', '14', '3', '在 那 里 有 亚 希 突 的 儿 子 亚 希 亚 ， 穿 着 以 弗 得 。 （ 亚 希 突 是 以 迦 博 的 哥 哥 ， 非 尼 哈 的 儿 子 ， 以 利 的 孙 子 。 以 利 从 前 在 示 罗 作 耶 和 华 的 祭 司 。 ） 约 拿 单 去 了 ， 百 姓 却 不 知 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7513', '9', '14', '4', '约 拿 单 要 从 隘 口 过 到 非 利 士 防 营 那 里 去 。 这 隘 口 两 边 各 有 一 个 山 峰 ： 一 名 播 薛 ， 一 名 西 尼 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7514', '9', '14', '5', '一 峰 向 北 ， 与 密 抹 相 对 ， 一 峰 向 南 ， 与 迦 巴 相 对 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7515', '9', '14', '6', '约 拿 单 对 拿 兵 器 的 少 年 人 说 ： 我 们 不 如 过 到 未 受 割 礼 人 的 防 营 那 里 去 ， 或 者 耶 和 华 为 我 们 施 展 能 力 ； 因 为 耶 和 华 使 人 得 胜 ， 不 在 乎 人 多 人 少 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7516', '9', '14', '7', '拿 兵 器 的 对 他 说 ： 随 你 的 心 意 行 罢 。 你 可 以 上 去 ， 我 必 跟 随 你 ， 与 你 同 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7517', '9', '14', '8', '约 拿 单 说 ： 我 们 要 过 到 那 些 人 那 里 去 ， 使 他 们 看 见 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7518', '9', '14', '9', '他 们 若 对 我 们 说 ： 你 们 站 住 ， 等 我 们 到 你 们 那 里 去 ， 我 们 就 站 住 ， 不 上 他 们 那 里 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7519', '9', '14', '10', '他 们 若 说 ： 你 们 上 到 我 们 这 里 来 ， 这 话 就 是 我 们 的 证 据 ； 我 们 便 上 去 ， 因 为 耶 和 华 将 他 们 交 在 我 们 手 里 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7520', '9', '14', '11', '二 人 就 使 非 利 士 的 防 兵 看 见 。 非 利 士 人 说 ： 希 伯 来 人 从 所 藏 的 洞 穴 里 出 来 了 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7521', '9', '14', '12', '防 兵 对 约 拿 单 和 拿 兵 器 的 人 说 ： 你 们 上 到 这 里 来 ， 我 们 有 一 件 事 指 示 你 们 。 约 拿 单 就 对 拿 兵 器 的 人 说 ： 你 跟 随 我 上 去 ， 因 为 耶 和 华 将 他 们 交 在 以 色 列 人 手 里 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7522', '9', '14', '13', '约 拿 单 就 爬 上 去 ， 拿 兵 器 的 人 跟 随 他 。 约 拿 单 杀 倒 非 利 士 人 ， 拿 兵 器 的 人 也 随 着 杀 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7523', '9', '14', '14', '约 拿 单 和 拿 兵 器 的 人 起 头 所 杀 的 约 有 二 十 人 ， 都 在 一 亩 地 的 半 犁 沟 之 内 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7524', '9', '14', '15', '於 是 在 营 中 、 在 田 野 、 在 众 民 内 都 有 战 兢 ， 防 兵 和 掠 兵 也 都 战 兢 ， 地 也 震 动 ， 战 兢 之 势 甚 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7525', '9', '14', '16', '在 便 雅 悯 的 基 比 亚 ， 扫 罗 的 守 望 兵 看 见 非 利 士 的 军 众 溃 散 ， 四 围 乱 窜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7526', '9', '14', '17', '扫 罗 就 对 跟 随 他 的 民 说 ： 你 们 查 点 查 点 ， 看 从 我 们 这 里 出 去 的 是 谁 ？ 他 们 一 查 点 ， 就 知 道 约 拿 单 和 拿 兵 器 的 人 没 有 在 这 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7527', '9', '14', '18', '那 时 　 神 的 约 柜 在 以 色 列 人 那 里 。 扫 罗 对 亚 希 亚 说 ： 你 将 　 神 的 约 柜 运 了 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7528', '9', '14', '19', '扫 罗 正 与 祭 司 说 话 的 时 候 ， 非 利 士 营 中 的 喧 嚷 越 发 大 了 ； 扫 罗 就 对 祭 司 说 ： 停 手 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7529', '9', '14', '20', '扫 罗 和 跟 随 他 的 人 都 聚 集 ， 来 到 战 场 ， 看 见 非 利 士 人 用 刀 互 相 击 杀 ， 大 大 惶 乱 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7530', '9', '14', '21', '从 前 由 四 方 来 跟 随 非 利 士 军 的 希 伯 来 人 现 在 也 转 过 来 ， 帮 助 跟 随 扫 罗 和 约 拿 单 的 以 色 列 人 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7531', '9', '14', '22', '那 藏 在 以 法 莲 山 地 的 以 色 列 人 听 说 非 利 士 人 逃 跑 ， 就 出 来 紧 紧 地 追 杀 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7532', '9', '14', '23', '那 日 ， 耶 和 华 使 以 色 列 人 得 胜 ， 一 直 战 到 伯 亚 文 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7533', '9', '14', '24', '扫 罗 叫 百 姓 起 誓 说 ， 凡 不 等 到 晚 上 向 敌 人 报 完 了 仇 吃 甚 麽 的 ， 必 受 咒 诅 。 因 此 这 日 百 姓 没 有 吃 甚 麽 ， 就 极 其 困 惫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7534', '9', '14', '25', '众 民 进 入 树 林 ， 见 有 蜜 在 地 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7535', '9', '14', '26', '他 们 进 了 树 林 ， 见 有 蜜 流 下 来 ， 却 没 有 人 敢 用 手 取 蜜 入 口 ， 因 为 他 们 怕 那 誓 言 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7536', '9', '14', '27', '约 拿 单 没 有 听 见 他 父 亲 叫 百 姓 起 誓 ， 所 以 伸 手 中 的 杖 ， 用 杖 头 蘸 在 蜂 房 里 ， 转 手 送 入 口 内 ， 眼 睛 就 明 亮 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7537', '9', '14', '28', '百 姓 中 有 一 人 对 他 说 ： 你 父 亲 曾 叫 百 姓 严 严 地 起 誓 说 ， 今 日 吃 甚 麽 的 ， 必 受 咒 诅 ； 因 此 百 姓 就 疲 乏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7538', '9', '14', '29', '约 拿 单 说 ： 我 父 亲 连 累 你 们 了 。 你 看 ， 我 尝 了 这 一 点 蜜 ， 眼 睛 就 明 亮 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7539', '9', '14', '30', '今 日 百 姓 若 任 意 吃 了 从 仇 敌 所 夺 的 物 ， 击 杀 的 非 利 士 人 岂 不 更 多 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7540', '9', '14', '31', '这 日 ， 以 色 列 人 击 杀 非 利 士 人 ， 从 密 抹 直 到 亚 雅 仑 。 百 姓 甚 是 疲 乏 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7541', '9', '14', '32', '就 急 忙 将 所 夺 的 牛 羊 和 牛 犊 宰 於 地 上 ， 肉 还 带 血 就 吃 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7542', '9', '14', '33', '有 人 告 诉 扫 罗 说 ： 百 姓 吃 带 血 的 肉 ， 得 罪 耶 和 华 了 。 扫 罗 说 ： 你 们 有 罪 了 ， 今 日 要 将 大 石 头 滚 到 我 这 里 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7543', '9', '14', '34', '扫 罗 又 说 ： 你 们 散 在 百 姓 中 ， 对 他 们 说 ， 你 们 各 人 将 牛 羊 牵 到 我 这 里 来 宰 了 吃 ， 不 可 吃 带 血 的 肉 得 罪 耶 和 华 。 这 夜 ， 百 姓 就 把 牛 羊 牵 到 那 里 宰 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7544', '9', '14', '35', '扫 罗 为 耶 和 华 筑 了 一 座 坛 ， 这 是 他 初 次 为 耶 和 华 筑 的 坛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7545', '9', '14', '36', '扫 罗 说 ： 我 们 不 如 夜 里 下 去 追 赶 非 利 士 人 ， 抢 掠 他 们 ， 直 到 天 亮 ， 不 留 他 们 一 人 。 众 民 说 ： 你 看 怎 样 好 就 去 行 罢 ！ 祭 司 说 ： 我 们 先 当 亲 近 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7546', '9', '14', '37', '扫 罗 求 问 　 神 说 ： 我 下 去 追 赶 非 利 士 人 可 以 不 可 以 ？ 你 将 他 们 交 在 以 色 列 人 手 里 不 交 ？ 这 日 　 神 没 有 回 答 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7547', '9', '14', '38', '扫 罗 说 ： 你 们 百 姓 中 的 长 老 都 上 这 里 来 ， 查 明 今 日 是 谁 犯 了 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7548', '9', '14', '39', '我 指 着 救 以 色 列 ─ 永 生 的 耶 和 华 起 誓 ， 就 是 我 儿 子 约 拿 单 犯 了 罪 ， 他 也 必 死 。 但 百 姓 中 无 一 人 回 答 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7549', '9', '14', '40', '扫 罗 就 对 以 色 列 众 人 说 ： 你 们 站 在 一 边 ， 我 与 我 儿 子 约 拿 单 也 站 在 一 边 。 百 姓 对 扫 罗 说 ： 你 看 怎 样 好 就 去 行 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7550', '9', '14', '41', '扫 罗 祷 告 耶 和 华 ─ 以 色 列 的 　 神 说 ： 求 你 指 示 实 情 。 於 是 掣 签 掣 出 扫 罗 和 约 拿 单 来 ； 百 姓 尽 都 无 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7551', '9', '14', '42', '扫 罗 说 ： 你 们 再 掣 签 ， 看 是 我 ， 是 我 儿 子 约 拿 单 ， 就 掣 出 约 拿 单 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7552', '9', '14', '43', '扫 罗 对 约 拿 单 说 ： 你 告 诉 我 ， 你 做 了 甚 麽 事 ？ 约 拿 单 说 ： 我 实 在 以 手 里 的 杖 ， 用 杖 头 蘸 了 一 点 蜜 尝 了 一 尝 。 这 样 我 就 死 麽 （ 或 译 ： 罢 ） ） ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7553', '9', '14', '44', '扫 罗 说 ： 约 拿 单 哪 ， 你 定 要 死 ！ 若 不 然 ， 愿 　 神 重 重 地 降 罚 与 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7554', '9', '14', '45', '百 姓 对 扫 罗 说 ： 约 拿 单 在 以 色 列 人 中 这 样 大 行 拯 救 ， 岂 可 使 他 死 呢 ？ 断 乎 不 可 ！ 我 们 指 着 永 生 的 耶 和 华 起 誓 ， 连 他 的 一 根 头 发 也 不 可 落 地 ， 因 为 他 今 日 与 　 神 一 同 做 事 。 於 是 百 姓 救 约 拿 单 免 了 死 亡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7555', '9', '14', '46', '扫 罗 回 去 ， 不 追 赶 非 利 士 人 ； 非 利 士 人 也 回 本 地 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7556', '9', '14', '47', '扫 罗 执 掌 以 色 列 的 国 权 ， 常 常 攻 击 他 四 围 的 一 切 仇 敌 ， 就 是 摩 押 人 、 亚 扪 人 、 以 东 人 ， 和 琐 巴 诸 王 ， 并 非 利 士 人 。 他 无 论 往 何 处 去 ， 都 打 败 仇 敌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7557', '9', '14', '48', '扫 罗 奋 勇 攻 击 亚 玛 力 人 ， 救 了 以 色 列 人 脱 离 抢 掠 他 们 之 人 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7558', '9', '14', '49', '扫 罗 的 儿 子 是 约 拿 单 、 亦 施 韦 、 麦 基 舒 亚 。 他 的 两 个 女 儿 ： 长 女 名 米 拉 ， 次 女 名 米 甲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7559', '9', '14', '50', '扫 罗 的 妻 名 叫 亚 希 暖 ， 是 亚 希 玛 斯 的 女 儿 。 扫 罗 的 元 帅 名 叫 押 尼 珥 ， 是 尼 珥 的 儿 子 ； 尼 珥 是 扫 罗 的 叔 叔 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7560', '9', '14', '51', '扫 罗 的 父 亲 基 士 ， 押 尼 珥 的 父 亲 尼 珥 ， 都 是 亚 别 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7561', '9', '14', '52', '扫 罗 平 生 常 与 非 利 士 人 大 大 争 战 。 扫 罗 遇 见 有 能 力 的 人 或 勇 士 ， 都 招 募 了 来 跟 随 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7562', '9', '15', '1', '撒 母 耳 对 扫 罗 说 ： 耶 和 华 差 遣 我 膏 你 为 王 ， 治 理 他 的 百 姓 以 色 列 ； 所 以 你 当 听 从 耶 和 华 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7563', '9', '15', '2', '万 军 之 耶 和 华 如 此 说 ： 以 色 列 人 出 埃 及 的 时 候 ， 在 路 上 亚 玛 力 人 怎 样 待 他 们 ， 怎 样 抵 挡 他 们 ， 我 都 没 忘 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7564', '9', '15', '3', '现 在 你 要 去 击 打 亚 玛 力 人 ， 灭 尽 他 们 所 有 的 ， 不 可 怜 惜 他 们 ， 将 男 女 、 孩 童 、 吃 奶 的 ， 并 牛 、 羊 、 骆 驼 ， 和 驴 尽 行 杀 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7565', '9', '15', '4', '於 是 扫 罗 招 聚 百 姓 在 提 拉 因 ， 数 点 他 们 ， 共 有 步 兵 二 十 万 ， 另 有 犹 大 人 一 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7566', '9', '15', '5', '扫 罗 到 了 亚 玛 力 的 京 城 ， 在 谷 中 设 下 埋 伏 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7567', '9', '15', '6', '扫 罗 对 基 尼 人 说 ： 你 们 离 开 亚 玛 力 人 下 去 罢 ， 恐 怕 我 将 你 们 和 亚 玛 力 人 一 同 杀 灭 ； 因 为 以 色 列 人 出 埃 及 的 时 候 ， 你 们 曾 恩 待 他 们 。 於 是 基 尼 人 离 开 亚 玛 力 人 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7568', '9', '15', '7', '扫 罗 击 打 亚 玛 力 人 ， 从 哈 腓 拉 直 到 埃 及 前 的 书 珥 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7569', '9', '15', '8', '生 擒 了 亚 玛 力 王 亚 甲 ， 用 刀 杀 尽 亚 玛 力 的 众 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7570', '9', '15', '9', '扫 罗 和 百 姓 却 怜 惜 亚 甲 ， 也 爱 惜 上 好 的 牛 、 羊 、 牛 犊 、 羊 羔 ， 并 一 切 美 物 ， 不 肯 灭 绝 。 凡 下 贱 瘦 弱 的 ， 尽 都 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7571', '9', '15', '10', '耶 和 华 的 话 临 到 撒 母 耳 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7572', '9', '15', '11', '我 立 扫 罗 为 王 ， 我 後 悔 了 ； 因 为 他 转 去 不 跟 从 我 ， 不 遵 守 我 的 命 令 。 撒 母 耳 便 甚 忧 愁 ， 终 夜 哀 求 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7573', '9', '15', '12', '撒 母 耳 清 早 起 来 ， 迎 接 扫 罗 。 有 人 告 诉 撒 母 耳 说 ： 扫 罗 到 了 迦 密 ， 在 那 里 立 了 记 纪 念 碑 ， 又 转 身 下 到 吉 甲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7574', '9', '15', '13', '撒 母 耳 到 了 扫 罗 那 里 ， 扫 罗 对 他 说 ： 愿 耶 和 华 赐 福 与 你 ， 耶 和 华 的 命 令 我 已 遵 守 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7575', '9', '15', '14', '撒 母 耳 说 ： 我 耳 中 听 见 有 羊 叫 、 牛 鸣 ， 是 从 哪 里 来 的 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7576', '9', '15', '15', '扫 罗 说 ： 这 是 百 姓 从 亚 玛 力 人 那 里 带 来 的 ； 因 为 他 们 爱 惜 上 好 的 牛 羊 ， 要 献 与 耶 和 华 ─ 你 的 　 神 ； 其 馀 的 ， 我 们 都 灭 尽 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7577', '9', '15', '16', '撒 母 耳 对 扫 罗 说 ： 你 住 口 罢 ！ 等 我 将 耶 和 华 昨 夜 向 我 所 说 的 话 告 诉 你 。 扫 罗 说 ： 请 讲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7578', '9', '15', '17', '撒 母 耳 对 扫 罗 说 ： 从 前 你 虽 然 以 自 己 为 小 ， 岂 不 是 被 立 为 以 色 列 支 派 的 元 首 麽 ？ 耶 和 华 膏 你 作 以 色 列 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7579', '9', '15', '18', '耶 和 华 差 遣 你 ， 吩 咐 你 说 ， 你 去 击 打 那 些 犯 罪 的 亚 玛 力 人 ， 将 他 们 灭 绝 净 尽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7580', '9', '15', '19', '你 为 何 没 有 听 从 耶 和 华 的 命 令 ， 急 忙 掳 掠 财 物 ， 行 耶 和 华 眼 中 看 为 恶 的 事 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7581', '9', '15', '20', '扫 罗 对 撒 母 耳 说 ： 我 实 在 听 从 了 耶 和 华 的 命 令 ， 行 了 耶 和 华 所 差 遣 我 行 的 路 ， 擒 了 亚 玛 力 王 亚 甲 来 ， 灭 尽 了 亚 玛 力 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7582', '9', '15', '21', '百 姓 却 在 所 当 灭 的 物 中 取 了 最 好 的 牛 羊 ， 要 在 吉 甲 献 与 耶 和 华 ─ 你 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7583', '9', '15', '22', '撒 母 耳 说 ： 耶 和 华 喜 悦 燔 祭 和 平 安 祭 ， 岂 如 喜 悦 人 听 从 他 的 话 呢 ？ 听 命 胜 於 献 祭 ； 顺 从 胜 於 公 羊 的 脂 油 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7584', '9', '15', '23', '悖 逆 的 罪 与 行 邪 术 的 罪 相 等 ； 顽 梗 的 罪 与 拜 虚 神 和 偶 像 的 罪 相 同 。 你 既 厌 弃 耶 和 华 的 命 令 ， 耶 和 华 也 厌 弃 你 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7585', '9', '15', '24', '扫 罗 对 撒 母 耳 说 ： 我 有 罪 了 ， 我 因 惧 怕 百 姓 ， 听 从 他 们 的 话 ， 就 违 背 了 耶 和 华 的 命 令 和 你 的 言 语 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7586', '9', '15', '25', '现 在 求 你 赦 免 我 的 罪 ， 同 我 回 去 ， 我 好 敬 拜 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7587', '9', '15', '26', '撒 母 耳 对 扫 罗 说 ： 我 不 同 你 回 去 ； 因 为 你 厌 弃 耶 和 华 的 命 令 ， 耶 和 华 也 厌 弃 你 作 以 色 列 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7588', '9', '15', '27', '撒 母 耳 转 身 要 走 ， 扫 罗 就 扯 住 他 外 袍 的 衣 襟 ， 衣 襟 就 撕 断 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7589', '9', '15', '28', '撒 母 耳 对 他 说 ： 如 此 ， 今 日 耶 和 华 使 以 色 列 国 与 你 断 绝 ， 将 这 国 赐 与 比 你 更 好 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7590', '9', '15', '29', '以 色 列 的 大 能 者 必 不 致 说 谎 ， 也 不 致 後 悔 ； 因 为 他 迥 非 世 人 ， 决 不 後 悔 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7591', '9', '15', '30', '扫 罗 说 ： 我 有 罪 了 ， 虽 然 如 此 ， 求 你 在 我 百 姓 的 长 老 和 以 色 列 人 面 前 抬 举 我 ， 同 我 回 去 ， 我 好 敬 拜 耶 和 华 ─ 你 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7592', '9', '15', '31', '於 是 撒 母 耳 转 身 跟 随 扫 罗 回 去 ， 扫 罗 就 敬 拜 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7593', '9', '15', '32', '撒 母 耳 说 ： 要 把 亚 玛 力 王 亚 甲 带 到 我 这 里 来 。 亚 甲 就 欢 欢 喜 喜 地 来 到 他 面 前 ， 心 里 说 ， 死 亡 的 苦 难 必 定 过 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7594', '9', '15', '33', '撒 母 耳 说 ： 你 既 用 刀 使 妇 人 丧 子 ， 这 样 ， 你 母 亲 在 妇 人 中 也 必 丧 子 。 於 是 ， 撒 母 耳 在 吉 甲 耶 和 华 面 前 将 亚 甲 杀 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7595', '9', '15', '34', '撒 母 耳 回 了 拉 玛 。 扫 罗 上 他 所 住 的 基 比 亚 ， 回 自 己 的 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7596', '9', '15', '35', '撒 母 耳 直 到 死 的 日 子 ， 再 没 有 见 扫 罗 ； 但 撒 母 耳 为 扫 罗 悲 伤 ， 是 因 耶 和 华 後 悔 立 他 为 以 色 列 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7597', '9', '16', '1', '耶 和 华 对 撒 母 耳 说 ： 我 既 厌 弃 扫 罗 作 以 色 列 的 王 ， 你 为 他 悲 伤 要 到 几 时 呢 ？ 你 将 膏 油 盛 满 了 角 ， 我 差 遣 你 往 伯 利 恒 人 耶 西 那 里 去 ； 因 为 我 在 他 众 子 之 内 ， 预 定 一 个 作 王 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7598', '9', '16', '2', '撒 母 耳 说 ： 我 怎 能 去 呢 ？ 扫 罗 若 听 见 ， 必 要 杀 我 。 耶 和 华 说 ： 你 可 以 带 一 只 牛 犊 去 ， 就 说 ： 我 来 是 要 向 耶 和 华 献 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7599', '9', '16', '3', '你 要 请 耶 西 来 吃 祭 肉 ， 我 就 指 示 你 所 当 行 的 事 。 我 所 指 给 你 的 人 ， 你 要 膏 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7600', '9', '16', '4', '撒 母 耳 就 照 耶 和 华 的 话 去 行 。 到 了 伯 利 恒 ， 那 城 里 的 长 老 都 战 战 兢 兢 地 出 来 迎 接 他 ， 问 他 说 ： 你 是 为 平 安 来 的 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7601', '9', '16', '5', '他 说 ： 为 平 安 来 的 ， 我 是 给 耶 和 华 献 祭 。 你 们 当 自 洁 ， 来 与 我 同 吃 祭 肉 。 撒 母 耳 就 使 耶 西 和 他 众 子 自 洁 ， 请 他 们 来 吃 祭 肉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7602', '9', '16', '6', '他 们 来 的 时 候 ， 撒 母 耳 看 见 以 利 押 ， 就 心 里 说 ， 耶 和 华 的 受 膏 者 必 定 在 他 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7603', '9', '16', '7', '耶 和 华 却 对 撒 母 耳 说 ： 不 要 看 他 的 外 貌 和 他 身 材 高 大 ， 我 不 拣 选 他 。 因 为 ， 耶 和 华 不 像 人 看 人 ： 人 是 看 外 貌 ； 耶 和 华 是 看 内 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7604', '9', '16', '8', '耶 西 叫 亚 比 拿 达 从 撒 母 耳 面 前 经 过 ， 撒 母 耳 说 ： 耶 和 华 也 不 拣 选 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7605', '9', '16', '9', '耶 西 又 叫 沙 玛 从 撒 母 耳 面 前 经 过 ， 撒 母 耳 说 ： 耶 和 华 也 不 拣 选 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7606', '9', '16', '10', '耶 西 叫 他 七 个 儿 子 都 从 撒 母 耳 面 前 经 过 ， 撒 母 耳 说 ： 这 都 不 是 耶 和 华 所 拣 选 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7607', '9', '16', '11', '撒 母 耳 对 耶 西 说 ： 你 的 儿 子 都 在 这 里 麽 ？ 他 回 答 说 ： 还 有 个 小 的 ， 现 在 放 羊 。 撒 母 耳 对 耶 西 说 ： 你 打 发 人 去 叫 他 来 ； 他 若 不 来 ， 我 们 必 不 坐 席 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7608', '9', '16', '12', '耶 西 就 打 发 人 去 叫 了 他 来 。 他 面 色 光 红 ， 双 目 清 秀 ， 容 貌 俊 美 。 耶 和 华 说 ： 这 就 是 他 ， 你 起 来 膏 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7609', '9', '16', '13', '撒 母 耳 就 用 角 里 的 膏 油 ， 在 他 诸 兄 中 膏 了 他 。 从 这 日 起 ， 耶 和 华 的 灵 就 大 大 感 动 大 卫 。 撒 母 耳 起 身 回 拉 玛 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7610', '9', '16', '14', '耶 和 华 的 灵 离 开 扫 罗 ， 有 恶 魔 从 耶 和 华 那 里 来 扰 乱 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7611', '9', '16', '15', '扫 罗 的 臣 仆 对 他 说 ： 现 在 有 恶 魔 从 　 神 那 里 来 扰 乱 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7612', '9', '16', '16', '我 们 的 主 可 以 吩 咐 面 前 的 臣 仆 ， 找 一 个 善 於 弹 琴 的 来 ， 等 　 神 那 里 来 的 恶 魔 临 到 你 身 上 的 时 候 ， 使 他 用 手 弹 琴 ， 你 就 好 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7613', '9', '16', '17', '扫 罗 对 臣 仆 说 ： 你 们 可 以 为 我 找 一 个 善 於 弹 琴 的 ， 带 到 我 这 里 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7614', '9', '16', '18', '其 中 有 一 个 少 年 人 说 ： 我 曾 见 伯 利 恒 人 耶 西 的 一 个 儿 子 善 於 弹 琴 ， 是 大 有 勇 敢 的 战 士 ， 说 话 合 宜 ， 容 貌 俊 美 ， 耶 和 华 也 与 他 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7615', '9', '16', '19', '於 是 扫 罗 差 遣 使 者 去 见 耶 西 ， 说 ： 请 你 打 发 你 放 羊 的 儿 子 大 卫 到 我 这 里 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7616', '9', '16', '20', '耶 西 就 把 几 个 饼 和 一 皮 袋 酒 ， 并 一 只 山 羊 羔 ， 都 驮 在 驴 上 ， 交 给 他 儿 子 大 卫 ， 送 与 扫 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7617', '9', '16', '21', '大 卫 到 了 扫 罗 那 里 ， 就 侍 立 在 扫 罗 面 前 。 扫 罗 甚 喜 爱 他 ， 他 就 作 了 扫 罗 拿 兵 器 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7618', '9', '16', '22', '扫 罗 差 遣 人 去 见 耶 西 ， 说 ： 求 你 容 大 卫 侍 立 在 我 面 前 ， 因 为 他 在 我 眼 前 蒙 了 恩 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7619', '9', '16', '23', '从 　 神 那 里 来 的 恶 魔 临 到 扫 罗 身 上 的 时 候 ， 大 卫 就 拿 琴 ， 用 手 而 弹 ， 扫 罗 便 舒 畅 爽 快 ， 恶 魔 离 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7620', '9', '17', '1', '非 利 士 人 招 聚 他 们 的 军 旅 ， 要 来 争 战 ； 聚 集 在 属 犹 大 的 梭 哥 ， 安 营 在 梭 哥 和 亚 西 加 中 间 的 以 弗 大 悯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7621', '9', '17', '2', '扫 罗 和 以 色 列 人 也 聚 集 ， 在 以 拉 谷 安 营 ， 摆 列 队 伍 ， 要 与 非 利 士 人 打 仗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7622', '9', '17', '3', '非 利 士 人 站 在 这 边 山 上 ， 以 色 列 人 站 在 那 边 山 上 ， 当 中 有 谷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7623', '9', '17', '4', '从 非 利 士 营 中 出 来 一 个 讨 战 的 人 ， 名 叫 歌 利 亚 ， 是 迦 特 人 ， 身 高 六 肘 零 一 虎 口 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7624', '9', '17', '5', '头 戴 铜 盔 ， 身 穿 铠 甲 ， 甲 重 五 千 舍 客 勒 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7625', '9', '17', '6', '腿 上 有 铜 护 膝 ， 两 肩 之 中 背 负 铜 戟 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7626', '9', '17', '7', '枪 杆 粗 如 织 布 的 机 轴 ， 铁 枪 头 重 六 百 舍 客 勒 。 有 一 个 拿 盾 牌 的 人 在 他 前 面 走 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7627', '9', '17', '8', '歌 利 亚 对 着 以 色 列 的 军 队 站 立 ， 呼 叫 说 ： 你 们 出 来 摆 列 队 伍 做 甚 麽 呢 ？ 我 不 是 非 利 士 人 麽 ？ 你 们 不 是 扫 罗 的 仆 人 麽 ？ 可 以 从 你 们 中 间 拣 选 一 人 ， 使 他 下 到 我 这 里 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7628', '9', '17', '9', '他 若 能 与 我 战 斗 ， 将 我 杀 死 ， 我 们 就 作 你 们 的 仆 人 ； 我 若 胜 了 他 ， 将 他 杀 死 ， 你 们 就 作 我 们 的 仆 人 ， 服 事 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7629', '9', '17', '10', '那 非 利 士 人 又 说 ： 我 今 日 向 以 色 列 人 的 军 队 骂 阵 。 你 们 叫 一 个 人 出 来 ， 与 我 战 斗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7630', '9', '17', '11', '扫 罗 和 以 色 列 众 人 听 见 非 利 士 人 的 这 些 话 ， 就 惊 惶 ， 极 其 害 怕 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7631', '9', '17', '12', '大 卫 是 犹 大 、 伯 利 恒 的 以 法 他 人 耶 西 的 儿 子 。 耶 西 有 八 个 儿 子 。 当 扫 罗 的 时 候 ， 耶 西 已 经 老 迈 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7632', '9', '17', '13', '耶 西 的 三 个 大 儿 子 跟 随 扫 罗 出 征 。 这 出 征 的 三 个 儿 子 ： 长 子 名 叫 以 利 押 ， 次 子 名 叫 亚 比 拿 达 ， 三 子 名 叫 沙 玛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7633', '9', '17', '14', '大 卫 是 最 小 的 ； 那 三 个 大 儿 子 跟 随 扫 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7634', '9', '17', '15', '大 卫 有 时 离 开 扫 罗 ， 回 伯 利 恒 放 他 父 亲 的 羊 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7635', '9', '17', '16', '那 非 利 士 人 早 晚 都 出 来 站 着 ， 如 此 四 十 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7636', '9', '17', '17', '一 日 ， 耶 西 对 他 儿 子 大 卫 说 ： 你 拿 一 伊 法 烘 了 的 穗 子 和 十 个 饼 ， 速 速 地 送 到 营 里 去 ， 交 给 你 哥 哥 们 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7637', '9', '17', '18', '再 拿 这 十 块 奶 饼 ， 送 给 他 们 的 千 夫 长 ， 且 问 你 哥 哥 们 好 ， 向 他 们 要 一 封 信 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7638', '9', '17', '19', '扫 罗 与 大 卫 的 三 个 哥 哥 和 以 色 列 众 人 ， 在 以 拉 谷 与 非 利 士 人 打 仗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7639', '9', '17', '20', '大 卫 早 晨 起 来 ， 将 羊 交 托 一 个 看 守 的 人 ， 照 着 他 父 亲 所 吩 咐 的 话 ， 带 着 食 物 去 了 。 到 了 辎 重 营 ， 军 兵 刚 出 到 战 场 ， 呐 喊 要 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7640', '9', '17', '21', '以 色 列 人 和 非 利 士 人 都 摆 列 队 伍 ， 彼 此 相 对 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7641', '9', '17', '22', '大 卫 把 他 带 来 的 食 物 留 在 看 守 物 件 人 的 手 下 ， 跑 到 战 场 ， 问 他 哥 哥 们 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7642', '9', '17', '23', '与 他 们 说 话 的 时 候 ， 那 讨 战 的 ， 就 是 属 迦 特 的 非 利 士 人 歌 利 亚 ， 从 非 利 士 队 中 出 来 ， 说 从 前 所 说 的 话 ； 大 卫 都 听 见 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7643', '9', '17', '24', '以 色 列 众 人 看 见 那 人 ， 就 逃 跑 ， 极 其 害 怕 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7644', '9', '17', '25', '以 色 列 人 彼 此 说 ： 这 上 来 的 人 你 看 见 了 麽 ？ 他 上 来 是 要 向 以 色 列 人 骂 阵 。 若 有 能 杀 他 的 ， 王 必 赏 赐 他 大 财 ， 将 自 己 的 女 儿 给 他 为 妻 ， 并 在 以 色 列 人 中 免 他 父 家 纳 粮 当 差 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7645', '9', '17', '26', '大 卫 问 站 在 旁 边 的 人 说 ： 有 人 杀 这 非 利 士 人 ， 除 掉 以 色 列 人 的 耻 辱 ， 怎 样 待 他 呢 ？ 这 未 受 割 礼 的 非 利 士 人 是 谁 呢 ？ 竟 敢 向 永 生 　 神 的 军 队 骂 阵 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7646', '9', '17', '27', '百 姓 照 先 前 的 话 回 答 他 说 ： 有 人 能 杀 这 非 利 士 人 ， 必 如 此 如 此 待 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7647', '9', '17', '28', '大 卫 的 长 兄 以 利 押 听 见 大 卫 与 他 们 所 说 的 话 ， 就 向 他 发 怒 ， 说 ： 你 下 来 做 甚 麽 呢 ？ 在 旷 野 的 那 几 只 羊 ， 你 交 托 了 谁 呢 ？ 我 知 道 你 的 骄 傲 和 你 心 里 的 恶 意 ， 你 下 来 特 为 要 看 争 战 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7648', '9', '17', '29', '大 卫 说 ： 我 做 了 甚 麽 呢 ？ 我 来 岂 没 有 缘 故 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7649', '9', '17', '30', '大 卫 就 离 开 他 转 向 别 人 ， 照 先 前 的 话 而 问 ； 百 姓 仍 照 先 前 的 话 回 答 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7650', '9', '17', '31', '有 人 听 见 大 卫 所 说 的 话 ， 就 告 诉 了 扫 罗 ； 扫 罗 便 打 发 人 叫 他 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7651', '9', '17', '32', '大 卫 对 扫 罗 说 ： 人 都 不 必 因 那 非 利 士 人 胆 怯 。 你 的 仆 人 要 去 与 那 非 利 士 人 战 斗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7652', '9', '17', '33', '扫 罗 对 大 卫 说 ： 你 不 能 去 与 那 非 利 士 人 战 斗 ； 因 为 你 年 纪 太 轻 ， 他 自 幼 就 作 战 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7653', '9', '17', '34', '大 卫 对 扫 罗 说 ： 你 仆 人 为 父 亲 放 羊 ， 有 时 来 了 狮 子 ， 有 时 来 了 熊 ， 从 群 中 衔 一 只 羊 羔 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7654', '9', '17', '35', '我 就 追 赶 他 ， 击 打 他 ， 将 羊 羔 从 他 口 中 救 出 来 。 他 起 来 要 害 我 ， 我 就 揪 着 他 的 胡 子 ， 将 他 打 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7655', '9', '17', '36', '你 仆 人 曾 打 死 狮 子 和 熊 ， 这 未 受 割 礼 的 非 利 士 人 向 永 生 　 神 的 军 队 骂 阵 ， 也 必 像 狮 子 和 熊 一 般 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7656', '9', '17', '37', '大 卫 又 说 ： 耶 和 华 救 我 脱 离 狮 子 和 熊 的 爪 ， 也 必 救 我 脱 离 这 非 利 士 人 的 手 。 扫 罗 对 大 卫 说 ： 你 可 以 去 罢 ！ 耶 和 华 必 与 你 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7657', '9', '17', '38', '扫 罗 就 把 自 己 的 战 衣 给 大 卫 穿 上 ， 将 铜 盔 给 他 戴 上 ， 又 给 他 穿 上 铠 甲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7658', '9', '17', '39', '大 卫 把 刀 跨 在 战 衣 外 ， 试 试 能 走 不 能 走 ； 因 为 素 来 没 有 穿 惯 ， 就 对 扫 罗 说 ： 我 穿 戴 这 些 不 能 走 ， 因 为 素 来 没 有 穿 惯 。 於 是 摘 脱 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7659', '9', '17', '40', '他 手 中 拿 杖 ， 又 在 溪 中 挑 选 了 五 块 光 滑 石 子 ， 放 在 袋 里 ， 就 是 牧 人 带 的 囊 里 ； 手 中 拿 着 甩 石 的 机 弦 ， 就 去 迎 那 非 利 士 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7660', '9', '17', '41', '非 利 士 人 也 渐 渐 地 迎 着 大 卫 来 ， 拿 盾 牌 的 走 在 前 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7661', '9', '17', '42', '非 利 士 人 观 看 ， 见 了 大 卫 ， 就 藐 视 他 ； 因 为 他 年 轻 ， 面 色 光 红 ， 容 貌 俊 美 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7662', '9', '17', '43', '非 利 士 人 对 大 卫 说 ： 你 拿 杖 到 我 这 里 来 ， 我 岂 是 狗 呢 ？ 非 利 士 人 就 指 着 自 己 的 　 神 咒 诅 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7663', '9', '17', '44', '非 利 士 人 又 对 大 卫 说 ： 来 罢 ！ 我 将 你 的 肉 给 空 中 的 飞 鸟 、 田 野 的 走 兽 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7664', '9', '17', '45', '大 卫 对 非 利 士 人 说 ： 你 来 攻 击 我 ， 是 靠 着 刀 枪 和 铜 戟 ； 我 来 攻 击 你 ， 是 靠 着 万 军 之 耶 和 华 的 名 ， 就 是 你 所 怒 骂 带 领 以 色 列 军 队 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7665', '9', '17', '46', '今 日 耶 和 华 必 将 你 交 在 我 手 里 。 我 必 杀 你 ， 斩 你 的 头 ， 又 将 非 利 士 军 兵 的 尸 首 给 空 中 的 飞 鸟 、 地 上 的 野 兽 吃 ， 使 普 天 下 的 人 都 知 道 以 色 列 中 有 　 神 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7666', '9', '17', '47', '又 使 这 众 人 知 道 耶 和 华 使 人 得 胜 ， 不 是 用 刀 用 枪 ， 因 为 争 战 的 胜 败 全 在 乎 耶 和 华 。 他 必 将 你 们 交 在 我 们 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7667', '9', '17', '48', '非 利 士 人 起 身 ， 迎 着 大 卫 前 来 。 大 卫 急 忙 迎 着 非 利 士 人 ， 往 战 场 跑 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7668', '9', '17', '49', '大 卫 用 手 从 囊 中 掏 出 一 块 石 子 来 ， 用 机 弦 甩 去 ， 打 中 非 利 士 人 的 额 ， 石 子 进 入 额 内 ， 他 就 仆 倒 ， 面 伏 於 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7669', '9', '17', '50', '这 样 ， 大 卫 用 机 弦 甩 石 ， 胜 了 那 非 利 士 人 ， 打 死 他 ； 大 卫 手 中 却 没 有 刀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7670', '9', '17', '51', '大 卫 跑 去 ， 站 在 非 利 士 人 身 旁 ， 将 他 的 刀 从 鞘 中 拔 出 来 ， 杀 死 他 ， 割 了 他 的 头 。 非 利 士 众 人 看 见 他 们 讨 战 的 勇 士 死 了 ， 就 都 逃 跑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7671', '9', '17', '52', '以 色 列 人 和 犹 大 人 便 起 身 呐 喊 ， 追 赶 非 利 士 人 ， 直 到 迦 特 （ 或 译 ： 该 ） 和 以 革 伦 的 城 门 。 被 杀 的 非 利 士 人 倒 在 沙 拉 音 的 路 上 ， 直 到 迦 特 和 以 革 伦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7672', '9', '17', '53', '以 色 列 人 追 赶 非 利 士 人 回 来 ， 就 夺 了 他 们 的 营 盘 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7673', '9', '17', '54', '大 卫 将 那 非 利 士 人 的 头 拿 到 耶 路 撒 冷 ， 却 将 他 军 装 放 在 自 己 的 帐 棚 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7674', '9', '17', '55', '扫 罗 看 见 大 卫 去 攻 击 非 利 士 人 ， 就 问 元 帅 押 尼 珥 说 ： 押 尼 珥 啊 ， 那 少 年 人 是 谁 的 儿 子 ？ 押 尼 珥 说 ： 我 敢 在 王 面 前 起 誓 ， 我 不 知 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7675', '9', '17', '56', '王 说 ： 你 可 以 问 问 那 幼 年 人 是 谁 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7676', '9', '17', '57', '大 卫 打 死 非 利 士 人 回 来 ， 押 尼 珥 领 他 到 扫 罗 面 前 ， 他 手 中 拿 着 非 利 士 人 的 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7677', '9', '17', '58', '扫 罗 问 他 说 ： 少 年 人 哪 ， 你 是 谁 的 儿 子 ？ 大 卫 说 ： 我 是 你 仆 人 伯 利 恒 人 耶 西 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7678', '9', '18', '1', '大 卫 对 扫 罗 说 完 了 话 ， 约 拿 单 的 心 与 大 卫 的 心 深 相 契 合 。 约 拿 单 爱 大 卫 ， 如 同 爱 自 己 的 性 命 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7679', '9', '18', '2', '那 日 扫 罗 留 住 大 卫 ， 不 容 他 再 回 父 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7680', '9', '18', '3', '约 拿 单 爱 大 卫 如 同 爱 自 己 的 性 命 ， 就 与 他 结 盟 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7681', '9', '18', '4', '约 拿 单 从 身 上 脱 下 外 袍 ， 给 了 大 卫 ， 又 将 战 衣 、 刀 、 弓 、 腰 带 都 给 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7682', '9', '18', '5', '扫 罗 无 论 差 遣 大 卫 往 何 处 去 ， 他 都 做 事 精 明 。 扫 罗 就 立 他 作 战 士 长 ， 众 百 姓 和 扫 罗 的 臣 仆 无 不 喜 悦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7683', '9', '18', '6', '大 卫 打 死 了 那 非 利 士 人 ， 同 众 人 回 来 的 时 候 ， 妇 女 们 从 以 色 列 各 城 里 出 来 ， 欢 欢 喜 喜 ， 打 鼓 击 磬 ， 歌 唱 跳 舞 ， 迎 接 扫 罗 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7684', '9', '18', '7', '众 妇 女 舞 蹈 唱 和 ， 说 ： 扫 罗 杀 死 千 千 ， 大 卫 杀 死 万 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7685', '9', '18', '8', '扫 罗 甚 发 怒 ， 不 喜 悦 这 话 ， 就 说 ： 将 万 万 归 大 卫 ， 千 千 归 我 ， 只 剩 下 王 位 没 有 给 他 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7686', '9', '18', '9', '从 这 日 起 ， 扫 罗 就 怒 视 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7687', '9', '18', '10', '次 日 ， 从 　 神 那 里 来 的 恶 魔 大 大 降 在 扫 罗 身 上 ， 他 就 在 家 中 胡 言 乱 语 。 大 卫 照 常 弹 琴 ， 扫 罗 手 里 拿 着 枪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7688', '9', '18', '11', '扫 罗 把 枪 一 抡 ， 心 里 说 ， 我 要 将 大 卫 刺 透 ， 钉 在 墙 上 。 大 卫 躲 避 他 两 次 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7689', '9', '18', '12', '扫 罗 惧 怕 大 卫 ； 因 为 耶 和 华 离 开 自 己 ， 与 大 卫 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7690', '9', '18', '13', '所 以 扫 罗 使 大 卫 离 开 自 己 ， 立 他 为 千 夫 长 ， 他 就 领 兵 出 入 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7691', '9', '18', '14', '大 卫 做 事 无 不 精 明 ， 耶 和 华 也 与 他 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7692', '9', '18', '15', '扫 罗 见 大 卫 做 事 精 明 ， 就 甚 怕 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7693', '9', '18', '16', '但 以 色 列 和 犹 大 众 人 都 爱 大 卫 ， 因 为 他 领 他 们 出 入 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7694', '9', '18', '17', '扫 罗 对 大 卫 说 ： 我 将 大 女 儿 米 拉 给 你 为 妻 ， 只 要 你 为 我 奋 勇 ， 为 耶 和 华 争 战 。 扫 罗 心 里 说 ： 我 不 好 亲 手 害 他 ， 要 藉 非 利 士 人 的 手 害 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7695', '9', '18', '18', '大 卫 对 扫 罗 说 ： 我 是 谁 ， 我 是 甚 麽 出 身 ， 我 父 家 在 以 色 列 中 是 何 等 的 家 ， 岂 敢 作 王 的 女 婿 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7696', '9', '18', '19', '扫 罗 的 女 儿 米 拉 到 了 当 给 大 卫 的 时 候 ， 扫 罗 却 给 了 米 何 拉 人 亚 得 列 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7697', '9', '18', '20', '扫 罗 的 次 女 米 甲 爱 大 卫 。 有 人 告 诉 扫 罗 ， 扫 罗 就 喜 悦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7698', '9', '18', '21', '扫 罗 心 里 说 ： 我 将 这 女 儿 给 大 卫 ， 作 他 的 网 罗 ， 好 藉 非 利 士 人 的 手 害 他 。 所 以 扫 罗 对 大 卫 说 ： 你 今 日 可 以 第 二 次 作 我 的 女 婿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7699', '9', '18', '22', '扫 罗 吩 咐 臣 仆 说 ： 你 们 暗 中 对 大 卫 说 ： 王 喜 悦 你 ， 王 的 臣 仆 也 都 喜 爱 你 ， 所 以 你 当 作 王 的 女 婿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7700', '9', '18', '23', '扫 罗 的 臣 仆 就 照 这 话 说 给 大 卫 听 。 大 卫 说 ： 你 们 以 为 作 王 的 女 婿 是 一 件 小 事 麽 ？ 我 是 贫 穷 卑 微 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7701', '9', '18', '24', '扫 罗 的 臣 仆 回 奏 说 ， 大 卫 所 说 的 如 此 如 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7702', '9', '18', '25', '扫 罗 说 ： 你 们 要 对 大 卫 这 样 说 ： 王 不 要 甚 麽 聘 礼 ， 只 要 一 百 非 利 士 人 的 阳 皮 ， 好 在 王 的 仇 敌 身 上 报 仇 。 扫 罗 的 意 思 要 使 大 卫 丧 在 非 利 士 人 的 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7703', '9', '18', '26', '扫 罗 的 臣 仆 将 这 话 告 诉 大 卫 ， 大 卫 就 欢 喜 作 王 的 女 婿 。 日 期 还 没 有 到 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7704', '9', '18', '27', '大 卫 和 跟 随 他 的 人 起 身 前 往 ， 杀 了 二 百 非 利 士 人 ， 将 阳 皮 满 数 交 给 王 ， 为 要 作 王 的 女 婿 。 於 是 扫 罗 将 女 儿 米 甲 给 大 卫 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7705', '9', '18', '28', '扫 罗 见 耶 和 华 与 大 卫 同 在 ， 又 知 道 女 儿 米 甲 爱 大 卫 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7706', '9', '18', '29', '就 更 怕 大 卫 ， 常 作 大 卫 的 仇 敌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7707', '9', '18', '30', '每 逢 非 利 士 军 长 出 来 打 仗 ， 大 卫 比 扫 罗 的 臣 仆 做 事 精 明 ， 因 此 他 的 名 被 人 尊 重 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7708', '9', '19', '1', '扫 罗 对 他 儿 子 约 拿 单 和 众 臣 仆 说 ， 要 杀 大 卫 ； 扫 罗 的 儿 子 约 拿 单 却 甚 喜 爱 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7709', '9', '19', '2', '约 拿 单 告 诉 大 卫 说 ： 我 父 扫 罗 想 要 杀 你 ， 所 以 明 日 早 晨 你 要 小 心 ， 到 一 个 僻 静 地 方 藏 身 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7710', '9', '19', '3', '我 就 出 到 你 所 藏 的 田 里 ， 站 在 我 父 亲 旁 边 与 他 谈 论 。 我 看 他 情 形 怎 样 ， 我 必 告 诉 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7711', '9', '19', '4', '约 拿 单 向 他 父 亲 扫 罗 替 大 卫 说 好 话 ， 说 ： 王 不 可 得 罪 王 的 仆 人 大 卫 ； 因 为 他 未 曾 得 罪 你 ， 他 所 行 的 都 与 你 大 有 益 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7712', '9', '19', '5', '他 拚 命 杀 那 非 利 士 人 ， 耶 和 华 为 以 色 列 众 人 大 行 拯 救 ； 那 时 你 看 见 ， 甚 是 欢 喜 ， 现 在 为 何 无 故 要 杀 大 卫 ， 流 无 辜 人 的 血 ， 自 己 取 罪 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7713', '9', '19', '6', '扫 罗 听 了 约 拿 单 的 话 ， 就 指 着 永 生 的 耶 和 华 起 誓 说 ： 我 必 不 杀 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7714', '9', '19', '7', '约 拿 单 叫 大 卫 来 ， 把 这 一 切 事 告 诉 他 ， 带 他 去 见 扫 罗 。 他 就 仍 然 侍 立 在 扫 罗 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7715', '9', '19', '8', '此 後 又 有 争 战 的 事 。 大 卫 出 去 与 非 利 士 人 打 仗 ， 大 大 杀 败 他 们 ， 他 们 就 在 他 面 前 逃 跑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7716', '9', '19', '9', '从 耶 和 华 那 里 来 的 恶 魔 又 降 在 扫 罗 身 上 （ 扫 罗 手 里 拿 枪 坐 在 屋 里 ） ， 大 卫 就 用 手 弹 琴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7717', '9', '19', '10', '扫 罗 用 枪 想 要 刺 透 大 卫 ， 钉 在 墙 上 ； 他 却 躲 开 ， 扫 罗 的 枪 刺 入 墙 内 。 当 夜 大 卫 逃 走 ， 躲 避 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7718', '9', '19', '11', '扫 罗 打 发 人 到 大 卫 的 房 屋 那 里 窥 探 他 ， 要 等 到 天 亮 杀 他 。 大 卫 的 妻 米 甲 对 他 说 ： 你 今 夜 若 不 逃 命 ， 明 日 你 要 被 杀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7719', '9', '19', '12', '於 是 米 甲 将 大 卫 从 窗 户 里 缒 下 去 ； 大 卫 就 逃 走 ， 躲 避 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7720', '9', '19', '13', '米 甲 把 家 中 的 神 像 放 在 床 上 ， 头 枕 在 山 羊 毛 装 的 枕 头 上 ， 用 被 遮 盖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7721', '9', '19', '14', '扫 罗 打 发 人 去 捉 拿 大 卫 ， 米 甲 说 ： 他 病 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7722', '9', '19', '15', '扫 罗 又 打 发 人 去 看 大 卫 ， 说 ： 当 连 床 将 他 抬 来 ， 我 好 杀 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7723', '9', '19', '16', '使 者 进 去 ， 看 见 床 上 有 神 像 ， 头 枕 在 山 羊 毛 装 的 枕 头 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7724', '9', '19', '17', '扫 罗 对 米 甲 说 ： 你 为 甚 麽 这 样 欺 哄 我 ， 放 我 仇 敌 逃 走 呢 ？ 米 甲 回 答 说 ： 他 对 我 说 ： 你 放 我 走 ， 不 然 我 要 杀 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7725', '9', '19', '18', '大 卫 逃 避 ， 来 到 拉 玛 见 撒 母 耳 ， 将 扫 罗 向 他 所 行 的 事 述 说 了 一 遍 。 他 和 撒 母 耳 就 往 拿 约 去 居 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7726', '9', '19', '19', '有 人 告 诉 扫 罗 ， 说 大 卫 在 拉 玛 的 拿 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7727', '9', '19', '20', '扫 罗 打 发 人 去 捉 拿 大 卫 。 去 的 人 见 有 一 班 先 知 都 受 感 说 话 ， 撒 母 耳 站 在 其 中 监 管 他 们 ； 打 发 去 的 人 也 受 　 神 的 灵 感 动 说 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7728', '9', '19', '21', '有 人 将 这 事 告 诉 扫 罗 ， 他 又 打 发 人 去 ， 他 们 也 受 感 说 话 。 扫 罗 第 三 次 打 发 人 去 ， 他 们 也 受 感 说 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7729', '9', '19', '22', '然 後 扫 罗 自 己 往 拉 玛 去 ， 到 了 西 沽 的 大 井 ， 问 人 说 ： 撒 母 耳 和 大 卫 在 哪 里 呢 ？ 有 人 说 ： 在 拉 玛 的 拿 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7730', '9', '19', '23', '他 就 往 拉 玛 的 拿 约 去 。 　 神 的 灵 也 感 动 他 ， 一 面 走 一 面 说 话 ， 直 到 拉 玛 的 拿 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7731', '9', '19', '24', '他 就 脱 了 衣 服 ， 在 撒 母 耳 面 前 受 感 说 话 ， 一 昼 一 夜 露 体 躺 卧 。 因 此 有 句 俗 语 说 ： 扫 罗 也 列 在 先 知 中 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7732', '9', '20', '1', '大 卫 从 拉 玛 的 拿 约 逃 跑 ， 来 到 约 拿 单 那 里 ， 对 他 说 ： 我 做 了 甚 麽 ？ 有 甚 麽 罪 孽 呢 ？ 在 你 父 亲 面 前 犯 了 甚 麽 罪 ， 他 竟 寻 索 我 的 性 命 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7733', '9', '20', '2', '约 拿 单 回 答 说 ： 断 然 不 是 ！ 你 必 不 致 死 。 我 父 作 事 ， 无 论 大 小 ， 没 有 不 叫 我 知 道 的 。 怎 麽 独 有 这 事 隐 瞒 我 呢 ？ 决 不 如 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7734', '9', '20', '3', '大 卫 又 起 誓 说 ： 你 父 亲 准 知 我 在 你 眼 前 蒙 恩 。 他 心 里 说 ， 不 如 不 叫 约 拿 单 知 道 ， 恐 怕 他 愁 烦 。 我 指 着 永 生 的 耶 和 华 ， 又 敢 在 你 面 前 起 誓 ， 我 离 死 不 过 一 步 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7735', '9', '20', '4', '约 拿 单 对 大 卫 说 ： 你 心 里 所 求 的 ， 我 必 为 你 成 就 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7736', '9', '20', '5', '大 卫 对 约 拿 单 说 ： 明 日 是 初 一 ， 我 当 与 王 同 席 ， 求 你 容 我 去 藏 在 田 野 ， 直 到 第 三 日 晚 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7737', '9', '20', '6', '你 父 亲 若 见 我 不 在 席 上 ， 你 就 说 ： 大 卫 切 求 我 许 他 回 本 城 伯 利 恒 去 ， 因 为 他 全 家 在 那 里 献 年 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7738', '9', '20', '7', '你 父 亲 若 说 好 ， 仆 人 就 平 安 了 ； 他 若 发 怒 ， 你 就 知 道 他 决 意 要 害 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7739', '9', '20', '8', '求 你 施 恩 与 仆 人 ， 因 你 在 耶 和 华 面 前 曾 与 仆 人 结 盟 。 我 若 有 罪 ， 不 如 你 自 己 杀 我 ， 何 必 将 我 交 给 你 父 亲 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7740', '9', '20', '9', '约 拿 单 说 ： 断 无 此 事 ！ 我 若 知 道 我 父 亲 决 意 害 你 ， 我 岂 不 告 诉 你 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7741', '9', '20', '10', '大 卫 对 约 拿 单 说 ： 你 父 亲 若 用 厉 言 回 答 你 ， 谁 来 告 诉 我 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7742', '9', '20', '11', '约 拿 单 对 大 卫 说 ： 你 我 且 往 田 野 去 。 二 人 就 往 田 野 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7743', '9', '20', '12', '约 拿 单 对 大 卫 说 ： 愿 耶 和 华 ─ 以 色 列 的 　 神 为 证 。 明 日 约 在 这 时 候 ， 或 第 三 日 ， 我 探 我 父 亲 的 意 思 ， 若 向 你 有 好 意 ， 我 岂 不 打 发 人 告 诉 你 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7744', '9', '20', '13', '我 父 亲 若 有 意 害 你 ， 我 不 告 诉 你 使 你 平 平 安 安 地 走 ， 愿 耶 和 华 重 重 地 降 罚 与 我 。 愿 耶 和 华 与 你 同 在 ， 如 同 从 前 与 我 父 亲 同 在 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7745', '9', '20', '14', '你 要 照 耶 和 华 的 慈 爱 恩 待 我 ， 不 但 我 活 着 的 时 候 免 我 死 亡 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7746', '9', '20', '15', '就 是 我 死 後 ， 耶 和 华 从 地 上 剪 除 你 仇 敌 的 时 候 ， 你 也 永 不 可 向 我 家 绝 了 恩 惠 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7747', '9', '20', '16', '於 是 约 拿 单 与 大 卫 家 结 盟 ， 说 ： 愿 耶 和 华 藉 大 卫 的 仇 敌 追 讨 背 约 的 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7748', '9', '20', '17', '约 拿 单 因 爱 大 卫 如 同 爱 自 己 的 性 命 ， 就 使 他 再 起 誓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7749', '9', '20', '18', '约 拿 单 对 他 说 ： 明 日 是 初 一 ， 你 的 座 位 空 设 ， 人 必 理 会 你 不 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7750', '9', '20', '19', '你 等 三 日 ， 就 要 速 速 下 去 ， 到 你 从 前 遇 事 所 藏 的 地 方 ， 在 以 色 磐 石 那 里 等 候 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7751', '9', '20', '20', '我 要 向 磐 石 旁 边 射 三 箭 ， 如 同 射 箭 靶 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7752', '9', '20', '21', '我 要 打 发 童 子 ， 说 ： 去 把 箭 找 来 。 我 若 对 童 子 说 ： 箭 在 後 头 ， 把 箭 拿 来 ， 你 就 可 以 回 来 ； 我 指 着 永 生 的 耶 和 华 起 誓 ， 你 必 平 安 无 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7753', '9', '20', '22', '我 若 对 童 子 说 ： 箭 在 前 头 ， 你 就 要 去 ， 因 为 是 耶 和 华 打 发 你 去 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7754', '9', '20', '23', '至 於 你 我 今 日 所 说 的 话 ， 有 耶 和 华 在 你 我 中 间 为 证 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7755', '9', '20', '24', '大 卫 就 去 藏 在 田 野 。 到 了 初 一 日 ， 王 坐 席 要 吃 饭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7756', '9', '20', '25', '王 照 常 坐 在 靠 墙 的 位 上 ， 约 拿 单 侍 立 ， 押 尼 珥 坐 在 扫 罗 旁 边 ， 大 卫 的 座 位 空 设 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7757', '9', '20', '26', '然 而 这 日 扫 罗 没 有 说 甚 麽 ， 他 想 大 卫 遇 事 ， 偶 染 不 洁 ， 他 必 定 是 不 洁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7758', '9', '20', '27', '初 二 日 大 卫 的 座 位 还 空 设 。 扫 罗 问 他 儿 子 约 拿 单 说 ： 耶 西 的 儿 子 为 何 昨 日 、 今 日 没 有 来 吃 饭 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7759', '9', '20', '28', '约 拿 单 回 答 扫 罗 说 ： 大 卫 切 求 我 容 他 往 伯 利 恒 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7760', '9', '20', '29', '他 说 ： 求 你 容 我 去 ， 因 为 我 家 在 城 里 有 献 祭 的 事 ； 我 长 兄 吩 咐 我 去 。 如 今 我 若 在 你 眼 前 蒙 恩 ， 求 你 容 我 去 见 我 的 弟 兄 ； 所 以 大 卫 没 有 赴 王 的 席 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7761', '9', '20', '30', '扫 罗 向 约 拿 单 发 怒 ， 对 他 说 ： 你 这 顽 梗 背 逆 之 妇 人 所 生 的 ， 我 岂 不 知 道 你 喜 悦 耶 西 的 儿 子 ， 自 取 羞 辱 ， 以 致 你 母 亲 露 体 蒙 羞 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7762', '9', '20', '31', '耶 西 的 儿 子 若 在 世 间 活 着 ， 你 和 你 的 国 位 必 站 立 不 住 。 现 在 你 要 打 发 人 去 ， 将 他 捉 拿 交 给 我 ； 他 是 该 死 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7763', '9', '20', '32', '约 拿 单 对 父 亲 扫 罗 说 ： 他 为 甚 麽 该 死 呢 ？ 他 做 了 甚 麽 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7764', '9', '20', '33', '扫 罗 向 约 拿 单 抡 枪 要 刺 他 ， 约 拿 单 就 知 道 他 父 亲 决 意 要 杀 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7765', '9', '20', '34', '於 是 约 拿 单 气 忿 忿 地 从 席 上 起 来 ， 在 这 初 二 日 没 有 吃 饭 。 他 因 见 父 亲 羞 辱 大 卫 ， 就 为 大 卫 愁 烦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7766', '9', '20', '35', '次 日 早 晨 ， 约 拿 单 按 着 与 大 卫 约 会 的 时 候 出 到 田 野 ， 有 一 个 童 子 跟 随 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7767', '9', '20', '36', '约 拿 单 对 童 子 说 ： 你 跑 去 ， 把 我 所 射 的 箭 找 来 。 童 子 跑 去 ， 约 拿 单 就 把 箭 射 在 童 子 前 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7768', '9', '20', '37', '童 子 到 了 约 拿 单 落 箭 之 地 ， 约 拿 单 呼 叫 童 子 说 ： 箭 不 是 在 你 前 头 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7769', '9', '20', '38', '约 拿 单 又 呼 叫 童 子 说 ： 速 速 地 去 ， 不 要 迟 延 ！ 童 子 就 拾 起 箭 来 ， 回 到 主 人 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7770', '9', '20', '39', '童 子 却 不 知 道 这 是 甚 麽 意 思 ， 只 有 约 拿 单 和 大 卫 知 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7771', '9', '20', '40', '约 拿 单 将 弓 箭 交 给 童 子 ， 吩 咐 说 ： 你 拿 到 城 里 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7772', '9', '20', '41', '童 子 一 去 ， 大 卫 就 从 磐 石 的 南 边 出 来 ， 俯 伏 在 地 ， 拜 了 三 拜 ； 二 人 亲 嘴 ， 彼 此 哭 泣 ， 大 卫 哭 得 更 恸 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7773', '9', '20', '42', '约 拿 单 对 大 卫 说 ： 我 们 二 人 曾 指 着 耶 和 华 的 名 起 誓 说 ： 愿 耶 和 华 在 你 我 中 间 ， 并 你 我 後 裔 中 间 为 证 ， 直 到 永 远 。 如 今 你 平 平 安 安 地 去 罢 ！ 大 卫 就 起 身 走 了 ； 约 拿 单 也 回 城 里 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7774', '9', '21', '1', '大 卫 到 了 挪 伯 祭 司 亚 希 米 勒 那 里 ， 亚 希 米 勒 战 战 兢 兢 地 出 来 迎 接 他 ， 问 他 说 ： 你 为 甚 麽 独 自 来 ， 没 有 人 跟 随 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7775', '9', '21', '2', '大 卫 回 答 祭 司 亚 希 米 勒 说 ： 王 吩 咐 我 一 件 事 说 ： 我 差 遣 你 委 托 你 的 这 件 事 ， 不 要 使 人 知 道 。 故 此 我 已 派 定 少 年 人 在 某 处 等 候 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7776', '9', '21', '3', '现 在 你 手 下 有 甚 麽 ？ 求 你 给 我 五 个 饼 或 是 别 样 的 食 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7777', '9', '21', '4', '祭 司 对 大 卫 说 ： 我 手 下 没 有 寻 常 的 饼 ， 只 有 圣 饼 ； 若 少 年 人 没 有 亲 近 妇 人 才 可 以 给 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7778', '9', '21', '5', '大 卫 对 祭 司 说 ： 实 在 约 有 三 日 我 们 没 有 亲 近 妇 人 ； 我 出 来 的 时 候 ， 虽 是 寻 常 行 路 ， 少 年 人 的 器 皿 还 是 洁 净 的 ； 何 况 今 日 不 更 是 洁 净 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7779', '9', '21', '6', '祭 司 就 拿 圣 饼 给 他 ； 因 为 在 那 里 没 有 别 样 饼 ， 只 有 更 换 新 饼 ， 从 耶 和 华 面 前 撤 下 来 的 陈 设 饼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7780', '9', '21', '7', '（ 当 日 有 扫 罗 的 一 个 臣 子 留 在 耶 和 华 面 前 。 他 名 叫 多 益 ， 是 以 东 人 ， 作 扫 罗 的 司 牧 长 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7781', '9', '21', '8', '大 卫 问 亚 希 米 勒 说 ： 你 手 下 有 枪 有 刀 没 有 ？ 因 为 王 的 事 甚 急 ， 连 刀 剑 器 械 我 都 没 有 带 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7782', '9', '21', '9', '祭 司 说 ： 你 在 以 拉 谷 杀 非 利 士 人 歌 利 亚 的 那 刀 在 这 里 ， 裹 在 布 中 ， 放 在 以 弗 得 後 边 ， 你 要 就 可 以 拿 去 ； 除 此 以 外 ， 再 没 有 别 的 。 大 卫 说 ： 这 刀 没 有 可 比 的 ！ 求 你 给 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7783', '9', '21', '10', '那 日 大 卫 起 来 ， 躲 避 扫 罗 ， 逃 到 迦 特 王 亚 吉 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7784', '9', '21', '11', '亚 吉 的 臣 仆 对 亚 吉 说 ： 这 不 是 以 色 列 国 王 大 卫 麽 ？ 那 里 的 妇 女 跳 舞 唱 和 ， 不 是 指 着 他 说 扫 罗 杀 死 千 千 ， 大 卫 杀 死 万 万 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7785', '9', '21', '12', '大 卫 将 这 话 放 在 心 里 ， 甚 惧 怕 迦 特 王 亚 吉 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7786', '9', '21', '13', '就 在 众 人 面 前 改 变 了 寻 常 的 举 动 ， 在 他 们 手 下 假 装 疯 癫 ， 在 城 门 的 门 扇 上 胡 写 乱 画 ， 使 唾 沫 流 在 胡 子 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7787', '9', '21', '14', '亚 吉 对 臣 仆 说 ： 你 们 看 ， 这 人 是 疯 子 。 为 甚 麽 带 他 到 我 这 里 来 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7788', '9', '21', '15', '我 岂 缺 少 疯 子 ， 你 们 带 这 人 来 在 我 面 前 疯 癫 麽 ？ 这 人 岂 可 进 我 的 家 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7789', '9', '22', '1', '大 卫 就 离 开 那 里 ， 逃 到 亚 杜 兰 洞 。 他 的 弟 兄 和 他 父 亲 的 全 家 听 见 了 ， 就 都 下 到 他 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7790', '9', '22', '2', '凡 受 窘 迫 的 、 欠 债 的 、 心 里 苦 恼 的 都 聚 集 到 大 卫 那 里 ； 大 卫 就 作 他 们 的 头 目 ， 跟 随 他 的 约 有 四 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7791', '9', '22', '3', '大 卫 从 那 里 往 摩 押 的 米 斯 巴 去 ， 对 摩 押 王 说 ： 求 你 容 我 父 母 搬 来 ， 住 在 你 们 这 里 ， 等 我 知 道 　 神 要 为 我 怎 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7792', '9', '22', '4', '大 卫 领 他 父 母 到 摩 押 王 面 前 。 大 卫 住 山 寨 多 少 日 子 ， 他 父 母 也 住 摩 押 王 那 里 多 少 日 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7793', '9', '22', '5', '先 知 迦 得 对 大 卫 说 ： 你 不 要 住 在 山 寨 ， 要 往 犹 大 地 去 。 大 卫 就 离 开 那 里 ， 进 入 哈 列 的 树 林 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7794', '9', '22', '6', '扫 罗 在 基 比 亚 的 拉 玛 ， 坐 在 垂 丝 柳 树 下 ， 手 里 拿 着 枪 ， 众 臣 仆 侍 立 在 左 右 。 扫 罗 听 见 大 卫 和 跟 随 他 的 人 在 何 处 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7795', '9', '22', '7', '就 对 左 右 侍 立 的 臣 仆 说 ： 便 雅 悯 人 哪 ， 你 们 要 听 我 的 话 ！ 耶 西 的 儿 子 能 将 田 地 和 葡 萄 园 赐 给 你 们 各 人 麽 ？ 能 立 你 们 各 人 作 千 夫 长 百 夫 长 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7796', '9', '22', '8', '你 们 竟 都 结 党 害 我 ！ 我 的 儿 子 与 耶 西 的 儿 子 结 盟 的 时 候 ， 无 人 告 诉 我 ； 我 的 儿 子 挑 唆 我 的 臣 子 谋 害 我 ， 就 如 今 日 的 光 景 ， 也 无 人 告 诉 我 ， 为 我 忧 虑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7797', '9', '22', '9', '那 时 以 东 人 多 益 站 在 扫 罗 的 臣 仆 中 ， 对 他 说 ： 我 曾 看 见 耶 西 的 儿 子 到 了 挪 伯 ， 亚 希 突 的 儿 子 亚 希 米 勒 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7798', '9', '22', '10', '亚 希 米 勒 为 他 求 问 耶 和 华 ， 又 给 他 食 物 ， 并 给 他 杀 非 利 士 人 歌 利 亚 的 刀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7799', '9', '22', '11', '王 就 打 发 人 将 祭 司 亚 希 突 的 儿 子 亚 希 米 勒 和 他 父 亲 的 全 家 ， 就 是 住 挪 伯 的 祭 司 都 召 了 来 ； 他 们 就 来 见 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7800', '9', '22', '12', '扫 罗 说 ： 亚 希 突 的 儿 子 ， 要 听 我 的 话 ！ 他 回 答 说 ： 主 啊 ， 我 在 这 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7801', '9', '22', '13', '扫 罗 对 他 说 ： 你 为 甚 麽 与 耶 西 的 儿 子 结 党 害 我 ， 将 食 物 和 刀 给 他 ， 又 为 他 求 问 　 神 ， 使 他 起 来 谋 害 我 ， 就 如 今 日 的 光 景 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7802', '9', '22', '14', '亚 希 米 勒 回 答 王 说 ： 王 的 臣 仆 中 有 谁 比 大 卫 忠 心 呢 ？ 他 是 王 的 女 婿 ， 又 是 王 的 参 谋 ， 并 且 在 王 家 中 是 尊 贵 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7803', '9', '22', '15', '我 岂 是 从 今 日 才 为 他 求 问 　 神 呢 ？ 断 不 是 这 样 ！ 王 不 要 将 罪 归 我 和 我 父 的 全 家 ； 因 为 这 事 ， 无 论 大 小 ， 仆 人 都 不 知 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7804', '9', '22', '16', '王 说 ： 亚 希 米 勒 啊 ， 你 和 你 父 的 全 家 都 是 该 死 的 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7805', '9', '22', '17', '王 就 吩 咐 左 右 的 侍 卫 说 ： 你 们 去 杀 耶 和 华 的 祭 司 ； 因 为 他 们 帮 助 大 卫 ， 又 知 道 大 卫 逃 跑 ， 竟 没 有 告 诉 我 。 扫 罗 的 臣 子 却 不 肯 伸 手 杀 耶 和 华 的 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7806', '9', '22', '18', '王 吩 咐 多 益 说 ： 你 去 杀 祭 司 罢 ！ 以 东 人 多 益 就 去 杀 祭 司 ， 那 日 杀 了 穿 细 麻 布 以 弗 得 的 八 十 五 人 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7807', '9', '22', '19', '又 用 刀 将 祭 司 城 挪 伯 中 的 男 女 、 孩 童 、 吃 奶 的 ， 和 牛 、 羊 、 驴 尽 都 杀 灭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7808', '9', '22', '20', '亚 希 突 的 儿 子 亚 希 米 勒 有 一 个 儿 子 ， 名 叫 亚 比 亚 他 ， 逃 到 大 卫 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7809', '9', '22', '21', '亚 比 亚 他 将 扫 罗 杀 耶 和 华 祭 司 的 事 告 诉 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7810', '9', '22', '22', '大 卫 对 亚 比 亚 他 说 ： 那 日 我 见 以 东 人 多 益 在 那 里 ， 就 知 道 他 必 告 诉 扫 罗 。 你 父 的 全 家 丧 命 ， 都 是 因 我 的 缘 故 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7811', '9', '22', '23', '你 可 以 住 在 我 这 里 ， 不 要 惧 怕 。 因 为 寻 索 你 命 的 就 是 寻 索 我 的 命 ； 你 在 我 这 里 可 得 保 全 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7812', '9', '23', '1', '有 人 告 诉 大 卫 说 ： 非 利 士 人 攻 击 基 伊 拉 ， 抢 夺 禾 场 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7813', '9', '23', '2', '所 以 大 卫 求 问 耶 和 华 说 ： 我 去 攻 打 那 些 非 利 士 人 可 以 不 可 以 ？ 耶 和 华 对 大 卫 说 ： 你 可 以 去 攻 打 非 利 士 人 ， 拯 救 基 伊 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7814', '9', '23', '3', '跟 随 大 卫 的 人 对 他 说 ： 我 们 在 犹 大 地 这 里 尚 且 惧 怕 ， 何 况 往 基 伊 拉 去 攻 打 非 利 士 人 的 军 旅 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7815', '9', '23', '4', '大 卫 又 求 问 耶 和 华 。 耶 和 华 回 答 说 ： 你 起 身 下 基 伊 拉 去 ， 我 必 将 非 利 士 人 交 在 你 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7816', '9', '23', '5', '大 卫 和 跟 随 他 的 人 往 基 伊 拉 去 ， 与 非 利 士 人 打 仗 ， 大 大 杀 败 他 们 ， 又 夺 获 他 们 的 牲 畜 。 这 样 ， 大 卫 救 了 基 伊 拉 的 居 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7817', '9', '23', '6', '亚 希 米 勒 的 儿 子 亚 比 亚 他 逃 到 基 伊 拉 见 大 卫 的 时 候 ， 手 里 拿 着 以 弗 得 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7818', '9', '23', '7', '有 人 告 诉 扫 罗 说 ： 大 卫 到 了 基 伊 拉 。 扫 罗 说 ： 他 进 了 有 门 有 闩 的 城 ， 困 闭 在 里 头 ； 这 是 　 神 将 他 交 在 我 手 里 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7819', '9', '23', '8', '於 是 扫 罗 招 聚 众 民 ， 要 下 去 攻 打 基 伊 拉 城 ， 围 困 大 卫 和 跟 随 他 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7820', '9', '23', '9', '大 卫 知 道 扫 罗 设 计 谋 害 他 ， 就 对 祭 司 亚 比 亚 他 说 ： 将 以 弗 得 拿 过 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7821', '9', '23', '10', '大 卫 祷 告 说 ： 耶 和 华 ─ 以 色 列 的 　 神 啊 ， 你 仆 人 听 真 了 扫 罗 要 往 基 伊 拉 来 ， 为 我 的 缘 故 灭 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7822', '9', '23', '11', '基 伊 拉 人 将 我 交 在 扫 罗 手 里 不 交 ？ 扫 罗 照 着 你 仆 人 所 听 的 话 下 来 不 下 来 ？ 耶 和 华 ─ 以 色 列 的 　 神 啊 ， 求 你 指 示 仆 人 ！ 耶 和 华 说 ： 扫 罗 必 下 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7823', '9', '23', '12', '大 卫 又 说 ： 基 伊 拉 人 将 我 和 跟 随 我 的 人 交 在 扫 罗 手 里 不 交 ？ 耶 和 华 说 ： 必 交 出 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7824', '9', '23', '13', '大 卫 和 跟 随 他 的 约 有 六 百 人 ， 就 起 身 出 了 基 伊 拉 ， 往 他 们 所 能 往 的 地 方 去 。 有 人 告 诉 扫 罗 ， 大 卫 离 开 基 伊 拉 逃 走 ； 於 是 扫 罗 不 出 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7825', '9', '23', '14', '大 卫 住 在 旷 野 的 山 寨 里 ， 常 在 西 弗 旷 野 的 山 地 。 扫 罗 天 天 寻 索 大 卫 ， 　 神 却 不 将 大 卫 交 在 他 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7826', '9', '23', '15', '大 卫 知 道 扫 罗 出 来 寻 索 他 的 命 。 那 时 ， 他 住 在 西 弗 旷 野 的 树 林 里 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7827', '9', '23', '16', '扫 罗 的 儿 子 约 拿 单 起 身 ， 往 那 树 林 里 去 见 大 卫 ， 使 他 倚 靠 　 神 得 以 坚 固 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7828', '9', '23', '17', '对 他 说 ： 不 要 惧 怕 ！ 我 父 扫 罗 的 手 必 不 加 害 於 你 ； 你 必 作 以 色 列 的 王 ， 我 也 作 你 的 宰 相 。 这 事 我 父 扫 罗 知 道 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7829', '9', '23', '18', '於 是 二 人 在 耶 和 华 面 前 立 约 。 大 卫 仍 住 在 树 林 里 ， 约 拿 单 回 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7830', '9', '23', '19', '西 弗 人 上 到 基 比 亚 见 扫 罗 ， 说 ： 大 卫 不 是 在 我 们 那 里 的 树 林 里 山 寨 中 、 旷 野 南 边 的 哈 基 拉 山 藏 着 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7831', '9', '23', '20', '王 啊 ， 请 你 随 你 的 心 愿 下 来 ， 我 们 必 亲 自 将 他 交 在 王 的 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7832', '9', '23', '21', '扫 罗 说 ： 愿 耶 和 华 赐 福 与 你 们 ， 因 你 们 顾 恤 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7833', '9', '23', '22', '请 你 们 回 去 ， 再 确 实 查 明 他 的 住 处 和 行 踪 ， 是 谁 看 见 他 在 那 里 ， 因 为 我 听 见 人 说 他 甚 狡 猾 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7834', '9', '23', '23', '所 以 要 看 准 他 藏 匿 的 地 方 ， 回 来 据 实 地 告 诉 我 ， 我 就 与 你 们 同 去 。 他 若 在 犹 大 的 境 内 ， 我 必 从 千 门 万 户 中 搜 出 他 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7835', '9', '23', '24', '西 弗 人 就 起 身 ， 在 扫 罗 以 先 往 西 弗 去 。 大 卫 和 跟 随 他 的 人 却 在 玛 云 旷 野 南 边 的 亚 拉 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7836', '9', '23', '25', '扫 罗 和 跟 随 他 的 人 去 寻 找 大 卫 ； 有 人 告 诉 大 卫 ， 他 就 下 到 磐 石 ， 住 在 玛 云 的 旷 野 。 扫 罗 听 见 ， 便 在 玛 云 的 旷 野 追 赶 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7837', '9', '23', '26', '扫 罗 在 山 这 边 走 ， 大 卫 和 跟 随 他 的 人 在 山 那 边 走 。 大 卫 急 忙 躲 避 扫 罗 ； 因 为 扫 罗 和 跟 随 他 的 人 ， 四 面 围 住 大 卫 和 跟 随 他 的 人 ， 要 拿 获 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7838', '9', '23', '27', '忽 有 使 者 来 报 告 扫 罗 说 ： 非 利 士 人 犯 境 抢 掠 ， 请 王 快 快 回 去 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7839', '9', '23', '28', '於 是 扫 罗 不 追 赶 大 卫 ， 回 去 攻 打 非 利 士 人 。 因 此 那 地 方 名 叫 西 拉 哈 玛 希 罗 结 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7840', '9', '23', '29', '大 卫 从 那 里 上 去 ， 住 在 隐 基 底 的 山 寨 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7841', '9', '24', '1', '扫 罗 追 赶 非 利 士 人 回 来 ， 有 人 告 诉 他 说 ： 大 卫 在 隐 基 底 的 旷 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7842', '9', '24', '2', '扫 罗 就 从 以 色 列 人 中 挑 选 三 千 精 兵 ， 率 领 他 们 往 野 羊 的 磐 石 去 ， 寻 索 大 卫 和 跟 随 他 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7843', '9', '24', '3', '到 了 路 旁 的 羊 圈 ， 在 那 里 有 洞 ， 扫 罗 进 去 大 解 。 大 卫 和 跟 随 他 的 人 正 藏 在 洞 里 的 深 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7844', '9', '24', '4', '跟 随 的 人 对 大 卫 说 ： 耶 和 华 曾 应 许 你 说 ： 我 要 将 你 的 仇 敌 交 在 你 手 里 ， 你 可 以 任 意 待 他 。 如 今 时 候 到 了 ！ 大 卫 就 起 来 ， 悄 悄 地 割 下 扫 罗 外 袍 的 衣 襟 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7845', '9', '24', '5', '随 後 大 卫 心 中 自 责 ， 因 为 割 下 扫 罗 的 衣 襟 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7846', '9', '24', '6', '对 跟 随 他 的 人 说 ： 我 的 主 乃 是 耶 和 华 的 受 膏 者 ， 我 在 耶 和 华 面 前 万 不 敢 伸 手 害 他 ， 因 他 是 耶 和 华 的 受 膏 者 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7847', '9', '24', '7', '大 卫 用 这 话 拦 住 跟 随 他 的 人 ， 不 容 他 们 起 来 害 扫 罗 。 扫 罗 起 来 ， 从 洞 里 出 去 行 路 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7848', '9', '24', '8', '随 後 大 卫 也 起 来 ， 从 洞 里 出 去 ， 呼 叫 扫 罗 说 ： 我 主 ， 我 王 ！ 扫 罗 回 头 观 看 ， 大 卫 就 屈 身 、 脸 伏 於 地 下 拜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7849', '9', '24', '9', '大 卫 对 扫 罗 说 ： 你 为 何 听 信 人 的 谗 言 ， 说 大 卫 想 要 害 你 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7850', '9', '24', '10', '今 日 你 亲 眼 看 见 在 洞 中 ， 耶 和 华 将 你 交 在 我 手 里 ； 有 人 叫 我 杀 你 ， 我 却 爱 惜 你 ， 说 ： 我 不 敢 伸 手 害 我 的 主 ， 因 为 他 是 耶 和 华 的 受 膏 者 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7851', '9', '24', '11', '我 父 啊 ， 看 看 你 外 袍 的 衣 襟 在 我 手 中 。 我 割 下 你 的 衣 襟 ， 没 有 杀 你 ； 你 由 此 可 以 知 道 我 没 有 恶 意 叛 逆 你 。 你 虽 然 猎 取 我 的 命 ， 我 却 没 有 得 罪 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7852', '9', '24', '12', '愿 耶 和 华 在 你 我 中 间 判 断 是 非 ， 在 你 身 上 为 我 伸 冤 ， 我 却 不 亲 手 加 害 於 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7853', '9', '24', '13', '古 人 有 句 俗 语 说 ： 恶 事 出 於 恶 人 。 我 却 不 亲 手 加 害 於 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7854', '9', '24', '14', '以 色 列 王 出 来 要 寻 找 谁 呢 ？ 追 赶 谁 呢 ？ 不 过 追 赶 一 条 死 狗 ， 一 个 虼 蚤 就 是 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7855', '9', '24', '15', '愿 耶 和 华 在 你 我 中 间 施 行 审 判 ， 断 定 是 非 ， 并 且 鉴 察 ， 为 我 伸 冤 ， 救 我 脱 离 你 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7856', '9', '24', '16', '大 卫 向 扫 罗 说 完 这 话 ， 扫 罗 说 ： 我 儿 大 卫 ， 这 是 你 的 声 音 麽 ？ 就 放 声 大 哭 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7857', '9', '24', '17', '对 大 卫 说 ： 你 比 我 公 义 ； 因 为 你 以 善 待 我 ， 我 却 以 恶 待 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7858', '9', '24', '18', '你 今 日 显 明 是 以 善 待 我 ； 因 为 耶 和 华 将 我 交 在 你 手 里 ， 你 却 没 有 杀 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7859', '9', '24', '19', '人 若 遇 见 仇 敌 ， 岂 肯 放 他 平 安 无 事 地 去 呢 ？ 愿 耶 和 华 因 你 今 日 向 我 所 行 的 ， 以 善 报 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7860', '9', '24', '20', '我 也 知 道 你 必 要 作 王 ， 以 色 列 的 国 必 坚 立 在 你 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7861', '9', '24', '21', '现 在 你 要 指 着 耶 和 华 向 我 起 誓 ， 不 剪 除 我 的 後 裔 ， 在 我 父 家 不 灭 没 我 的 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7862', '9', '24', '22', '於 是 大 卫 向 扫 罗 起 誓 ， 扫 罗 就 回 家 去 ； 大 卫 和 跟 随 他 的 人 上 山 寨 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7863', '9', '25', '1', '撒 母 耳 死 了 ， 以 色 列 众 人 聚 集 ， 为 他 哀 哭 ， 将 他 葬 在 拉 玛 ─ 他 自 己 的 坟 墓 （ 原 文 是 房 屋 ） 里 。 大 卫 起 身 ， 下 到 巴 兰 的 旷 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7864', '9', '25', '2', '在 玛 云 有 一 个 人 ， 他 的 产 业 在 迦 密 ， 是 一 个 大 富 户 ， 有 三 千 绵 羊 ， 一 千 山 羊 ； 他 正 在 迦 密 剪 羊 毛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7865', '9', '25', '3', '那 人 名 叫 拿 八 ， 是 迦 勒 族 的 人 ； 他 的 妻 名 叫 亚 比 该 ， 是 聪 明 俊 美 的 妇 人 。 拿 八 为 人 刚 愎 凶 恶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7866', '9', '25', '4', '大 卫 在 旷 野 听 见 说 拿 八 剪 羊 毛 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7867', '9', '25', '5', '大 卫 就 打 发 十 个 仆 人 ， 吩 咐 他 们 说 ： 你 们 上 迦 密 去 见 拿 八 ， 提 我 的 名 问 他 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7868', '9', '25', '6', '要 对 那 富 户 如 此 说 ： 愿 你 平 安 ， 愿 你 家 平 安 ， 愿 你 一 切 所 有 的 都 平 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7869', '9', '25', '7', '现 在 我 听 说 有 人 为 你 剪 羊 毛 ， 你 的 牧 人 在 迦 密 的 时 候 和 我 们 在 一 处 ， 我 们 没 有 欺 负 他 们 ， 他 们 也 未 曾 失 落 甚 麽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7870', '9', '25', '8', '可 以 问 你 的 仆 人 ， 他 们 必 告 诉 你 。 所 以 愿 我 的 仆 人 在 你 眼 前 蒙 恩 ， 因 为 是 在 好 日 子 来 的 。 求 你 随 手 取 点 赐 与 仆 人 和 你 儿 子 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7871', '9', '25', '9', '大 卫 的 仆 人 到 了 ， 将 这 话 提 大 卫 的 名 都 告 诉 了 拿 八 ， 就 住 了 口 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7872', '9', '25', '10', '拿 八 回 答 大 卫 的 仆 人 说 ： 大 卫 是 谁 ？ 耶 西 的 儿 子 是 谁 ？ 近 来 悖 逆 主 人 奔 逃 的 仆 人 甚 多 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7873', '9', '25', '11', '我 岂 可 将 饮 食 和 为 我 剪 羊 毛 人 所 宰 的 肉 给 我 不 知 道 从 哪 里 来 的 人 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7874', '9', '25', '12', '大 卫 的 仆 人 就 转 身 从 原 路 回 去 ， 照 这 话 告 诉 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7875', '9', '25', '13', '大 卫 向 跟 随 他 的 人 说 ： 你 们 各 人 都 要 带 上 刀 ！ 众 人 就 都 带 上 刀 ， 大 卫 也 带 上 刀 。 跟 随 大 卫 上 去 的 约 有 四 百 人 ， 留 下 二 百 人 看 守 器 具 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7876', '9', '25', '14', '有 拿 八 的 一 个 仆 人 告 诉 拿 八 的 妻 亚 比 该 说 ： 大 卫 从 旷 野 打 发 使 者 来 问 我 主 人 的 安 ， 主 人 却 辱 骂 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7877', '9', '25', '15', '但 是 那 些 人 待 我 们 甚 好 ； 我 们 在 田 野 与 他 们 来 往 的 时 候 ， 没 有 受 他 们 的 欺 负 ， 也 未 曾 失 落 甚 麽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7878', '9', '25', '16', '我 们 在 他 们 那 里 牧 羊 的 时 候 ， 他 们 昼 夜 作 我 们 的 保 障 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7879', '9', '25', '17', '所 以 你 当 筹 划 ， 看 怎 样 行 才 好 ； 不 然 ， 祸 患 定 要 临 到 我 主 人 和 他 全 家 。 他 性 情 凶 暴 ， 无 人 敢 与 他 说 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7880', '9', '25', '18', '亚 比 该 急 忙 将 二 百 饼 ， 两 皮 袋 酒 ， 五 只 收 拾 好 了 的 羊 ， 五 细 亚 烘 好 了 的 穗 子 ， 一 百 葡 萄 饼 ， 二 百 无 花 果 饼 ， 都 驮 在 驴 上 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7881', '9', '25', '19', '对 仆 人 说 ： 你 们 前 头 走 ， 我 随 着 你 们 去 。 这 事 他 却 没 有 告 诉 丈 夫 拿 八 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7882', '9', '25', '20', '亚 比 该 骑 着 驴 ， 正 下 山 坡 ， 见 大 卫 和 跟 随 他 的 人 从 对 面 下 来 ， 亚 比 该 就 迎 接 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7883', '9', '25', '21', '大 卫 曾 说 ： 我 在 旷 野 为 那 人 看 守 所 有 的 ， 以 致 他 一 样 不 失 落 ， 实 在 是 徒 然 了 ！ 他 向 我 以 恶 报 善 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7884', '9', '25', '22', '凡 属 拿 八 的 男 丁 ， 我 若 留 一 个 到 明 日 早 晨 ， 愿 　 神 重 重 降 罚 与 我 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7885', '9', '25', '23', '亚 比 该 见 大 卫 ， 便 急 忙 下 驴 ， 在 大 卫 面 前 脸 伏 於 地 叩 拜 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7886', '9', '25', '24', '俯 伏 在 大 卫 的 脚 前 ， 说 ： 我 主 啊 ， 愿 这 罪 归 我 ！ 求 你 容 婢 女 向 你 进 言 ， 更 求 你 听 婢 女 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7887', '9', '25', '25', '我 主 不 要 理 这 坏 人 拿 八 ， 他 的 性 情 与 他 的 名 相 称 ； 他 名 叫 拿 八 （ 就 是 愚 顽 的 意 思 ） ， 他 为 人 果 然 愚 顽 。 但 我 主 所 打 发 的 仆 人 ， 婢 女 并 没 有 看 见 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7888', '9', '25', '26', '我 主 啊 ， 耶 和 华 既 然 阻 止 你 亲 手 报 仇 ， 取 流 血 的 罪 ， 所 以 我 指 着 永 生 的 耶 和 华 ， 又 敢 在 你 面 前 起 誓 说 ： 愿 你 的 仇 敌 和 谋 害 你 的 人 都 像 拿 八 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7889', '9', '25', '27', '如 今 求 你 将 婢 女 送 来 的 礼 物 给 跟 随 你 的 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7890', '9', '25', '28', '求 你 饶 恕 婢 女 的 罪 过 。 耶 和 华 必 为 我 主 建 立 坚 固 的 家 ， 因 我 主 为 耶 和 华 争 战 ； 并 且 在 你 平 生 的 日 子 查 不 出 有 甚 麽 过 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7891', '9', '25', '29', '虽 有 人 起 来 追 逼 你 ， 寻 索 你 的 性 命 ， 你 的 性 命 却 在 耶 和 华 ─ 你 的 　 神 那 里 蒙 保 护 ， 如 包 裹 宝 器 一 样 ； 你 仇 敌 的 性 命 ， 耶 和 华 必 抛 去 ， 如 用 机 弦 甩 石 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7892', '9', '25', '30', '我 主 现 在 若 不 亲 手 报 仇 流 无 辜 人 的 血 ， 到 了 耶 和 华 照 所 应 许 你 的 话 赐 福 与 你 ， 立 你 作 以 色 列 的 王 ， 那 时 我 主 必 不 至 心 里 不 安 ， 觉 得 良 心 有 亏 。 耶 和 华 赐 福 与 我 主 的 时 候 ， 求 你 记 念 婢 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7893', '9', '25', '31', 'a');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7894', '9', '25', '32', '大 卫 对 亚 比 该 说 ： 耶 和 华 ─ 以 色 列 的 　 神 是 应 当 称 颂 的 ， 因 为 他 今 日 使 你 来 迎 接 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7895', '9', '25', '33', '你 和 你 的 见 识 也 当 称 赞 ； 因 为 你 今 日 拦 阻 我 亲 手 报 仇 、 流 人 的 血 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7896', '9', '25', '34', '我 指 着 阻 止 我 加 害 於 你 的 耶 和 华 ─ 以 色 列 永 生 的 　 神 起 誓 ， 你 若 不 速 速 地 来 迎 接 我 ， 到 明 日 早 晨 ， 凡 属 拿 八 的 男 丁 必 定 不 留 一 个 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7897', '9', '25', '35', '大 卫 受 了 亚 比 该 送 来 的 礼 物 ， 就 对 他 说 ： 我 听 了 你 的 话 ， 准 了 你 的 情 面 ， 你 可 以 平 平 安 安 地 回 家 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7898', '9', '25', '36', '亚 比 该 到 拿 八 那 里 ， 见 他 在 家 里 设 摆 筵 席 ， 如 同 王 的 筵 席 ； 拿 八 快 乐 大 醉 。 亚 比 该 无 论 大 小 事 都 没 有 告 诉 他 ， 就 等 到 次 日 早 晨 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7899', '9', '25', '37', '到 了 早 晨 ， 拿 八 醒 了 酒 ， 他 的 妻 将 这 些 事 都 告 诉 他 ， 他 就 魂 不 附 体 ， 身 僵 如 石 头 一 般 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7900', '9', '25', '38', '过 了 十 天 ， 耶 和 华 击 打 拿 八 ， 他 就 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7901', '9', '25', '39', '大 卫 听 见 拿 八 死 了 ， 就 说 ： 应 当 称 颂 耶 和 华 ， 因 他 伸 了 拿 八 羞 辱 我 的 冤 ， 又 阻 止 仆 人 行 恶 ； 也 使 拿 八 的 恶 归 到 拿 八 的 头 上 。 於 是 大 卫 打 发 人 去 ， 与 亚 比 该 说 ， 要 娶 他 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7902', '9', '25', '40', '大 卫 的 仆 人 到 了 迦 密 见 亚 比 该 ， 对 他 说 ： 大 卫 打 发 我 们 来 见 你 ， 想 要 娶 你 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7903', '9', '25', '41', '亚 比 该 就 起 来 ， 俯 伏 在 地 ， 说 ： 我 情 愿 作 婢 女 ， 洗 我 主 仆 人 的 脚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7904', '9', '25', '42', '亚 比 该 立 刻 起 身 ， 骑 上 驴 ， 带 着 五 个 使 女 ， 跟 从 大 卫 的 使 者 去 了 ， 就 作 了 大 卫 的 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7905', '9', '25', '43', '大 卫 先 娶 了 耶 斯 列 人 亚 希 暖 ， 他 们 二 人 都 作 了 他 的 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7906', '9', '25', '44', '扫 罗 已 将 他 的 女 儿 米 甲 ， 就 是 大 卫 的 妻 ， 给 了 迦 琳 人 拉 亿 的 儿 子 帕 提 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7907', '9', '26', '1', '西 弗 人 到 基 比 亚 见 扫 罗 ， 说 ： 大 卫 不 是 在 旷 野 前 的 哈 基 拉 山 藏 着 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7908', '9', '26', '2', '扫 罗 就 起 身 ， 带 领 以 色 列 人 中 挑 选 的 三 千 精 兵 下 到 西 弗 的 旷 野 ， 要 在 那 里 寻 索 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7909', '9', '26', '3', '扫 罗 在 旷 野 前 的 哈 基 拉 山 ， 在 道 路 上 安 营 。 大 卫 住 在 旷 野 ， 听 说 扫 罗 到 旷 野 来 追 寻 他 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7910', '9', '26', '4', '就 打 发 人 去 探 听 ， 便 知 道 扫 罗 果 然 来 到 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7911', '9', '26', '5', '大 卫 起 来 ， 到 扫 罗 安 营 的 地 方 ， 看 见 扫 罗 和 他 的 元 帅 尼 珥 的 儿 子 押 尼 珥 睡 卧 之 处 ； 扫 罗 睡 在 辎 重 营 里 ， 百 姓 安 营 在 他 周 围 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7912', '9', '26', '6', '大 卫 对 赫 人 亚 希 米 勒 和 洗 鲁 雅 的 儿 子 约 押 的 兄 弟 亚 比 筛 说 ： 谁 同 我 下 到 扫 罗 营 里 去 ？ 亚 比 筛 说 ： 我 同 你 下 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7913', '9', '26', '7', '於 是 大 卫 和 亚 比 筛 夜 间 到 了 百 姓 那 里 ， 见 扫 罗 睡 在 辎 重 营 里 ； 他 的 枪 在 头 旁 ， 插 在 地 上 。 押 尼 珥 和 百 姓 睡 在 他 周 围 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7914', '9', '26', '8', '亚 比 筛 对 大 卫 说 ： 现 在 　 神 将 你 的 仇 敌 交 在 你 手 里 ， 求 你 容 我 拿 枪 将 他 刺 透 在 地 ， 一 刺 就 成 ， 不 用 再 刺 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7915', '9', '26', '9', '大 卫 对 亚 比 筛 说 ： 不 可 害 死 他 。 有 谁 伸 手 害 耶 和 华 的 受 膏 者 而 无 罪 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7916', '9', '26', '10', '大 卫 又 说 ： 我 指 着 永 生 的 耶 和 华 起 誓 ， 他 或 被 耶 和 华 击 打 ， 或 是 死 期 到 了 ， 或 是 出 战 阵 亡 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7917', '9', '26', '11', '我 在 耶 和 华 面 前 ， 万 不 敢 伸 手 害 耶 和 华 的 受 膏 者 。 现 在 你 可 以 将 他 头 旁 的 枪 和 水 瓶 拿 来 ， 我 们 就 走 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7918', '9', '26', '12', '大 卫 从 扫 罗 的 头 旁 拿 了 枪 和 水 瓶 ， 二 人 就 走 了 ， 没 有 人 看 见 ， 没 有 人 知 道 ， 也 没 有 人 醒 起 ， 都 睡 着 了 ， 因 为 耶 和 华 使 他 们 沉 沉 地 睡 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7919', '9', '26', '13', '大 卫 过 到 那 边 去 ， 远 远 地 站 在 山 顶 上 ， 与 他 们 相 离 甚 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7920', '9', '26', '14', '大 卫 呼 叫 百 姓 和 尼 珥 的 儿 子 押 尼 珥 说 ： 押 尼 珥 啊 ， 你 为 何 不 答 应 呢 ？ 押 尼 珥 说 ： 你 是 谁 ？ 竟 敢 呼 叫 王 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7921', '9', '26', '15', '大 卫 对 押 尼 珥 说 ： 你 不 是 个 勇 士 麽 ？ 以 色 列 中 谁 能 比 你 呢 ？ 民 中 有 人 进 来 要 害 死 王 ─ 你 的 主 ， 你 为 何 没 有 保 护 王 ─ 你 的 主 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7922', '9', '26', '16', '你 这 样 是 不 好 的 ！ 我 指 着 永 生 的 耶 和 华 起 誓 ， 你 们 都 是 该 死 的 ； 因 为 没 有 保 护 你 们 的 主 ， 就 是 耶 和 华 的 受 膏 者 。 现 在 你 看 看 王 头 旁 的 枪 和 水 瓶 在 哪 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7923', '9', '26', '17', '扫 罗 听 出 是 大 卫 的 声 音 ， 就 说 ： 我 儿 大 卫 ， 这 是 你 的 声 音 麽 ？ 大 卫 说 ： 主 ─ 我 的 王 啊 ， 是 我 的 声 音 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7924', '9', '26', '18', '又 说 ： 我 做 了 甚 麽 ？ 我 手 里 有 甚 麽 恶 事 ？ 我 主 竟 追 赶 仆 人 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7925', '9', '26', '19', '求 我 主 我 王 听 仆 人 的 话 ： 若 是 耶 和 华 激 发 你 攻 击 我 ， 愿 耶 和 华 收 纳 祭 物 ； 若 是 人 激 发 你 ， 愿 他 在 耶 和 华 面 前 受 咒 诅 ； 因 为 他 现 今 赶 逐 我 ， 不 容 我 在 耶 和 华 的 产 业 上 有 分 ， 说 ： 你 去 事 奉 别 　 神 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7926', '9', '26', '20', '现 在 求 王 不 要 使 我 的 血 流 在 离 耶 和 华 远 的 地 方 。 以 色 列 王 出 来 是 寻 找 一 个 虼 蚤 ， 如 同 人 在 山 上 猎 取 一 个 鹧 鸪 一 般 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7927', '9', '26', '21', '扫 罗 说 ： 我 有 罪 了 ！ 我 儿 大 卫 ， 你 可 以 回 来 ， 因 你 今 日 看 我 的 性 命 为 宝 贵 ； 我 必 不 再 加 害 於 你 。 我 是 糊 涂 人 ， 大 大 错 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7928', '9', '26', '22', '大 卫 说 ： 王 的 枪 在 这 里 ， 可 以 吩 咐 一 个 仆 人 过 来 拿 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7929', '9', '26', '23', '今 日 耶 和 华 将 王 交 在 我 手 里 ， 我 却 不 肯 伸 手 害 耶 和 华 的 受 膏 者 。 耶 和 华 必 照 各 人 的 公 义 诚 实 报 应 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7930', '9', '26', '24', '我 今 日 重 看 你 的 性 命 ， 愿 耶 和 华 也 重 看 我 的 性 命 ， 并 且 拯 救 我 脱 离 一 切 患 难 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7931', '9', '26', '25', '扫 罗 对 大 卫 说 ： 我 儿 大 卫 ， 愿 你 得 福 ！ 你 必 做 大 事 ， 也 必 得 胜 。 於 是 大 卫 起 行 ， 扫 罗 回 他 的 本 处 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7932', '9', '27', '1', '大 卫 心 里 说 ： 必 有 一 日 我 死 在 扫 罗 手 里 ， 不 如 逃 奔 非 利 士 地 去 。 扫 罗 见 我 不 在 以 色 列 的 境 内 ， 就 必 绝 望 ， 不 再 寻 索 我 ； 这 样 我 可 以 脱 离 他 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7933', '9', '27', '2', '於 是 大 卫 起 身 ， 和 跟 随 他 的 六 百 人 投 奔 迦 特 王 ─ 玛 俄 的 儿 子 亚 吉 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7934', '9', '27', '3', '大 卫 和 他 的 两 个 妻 ， 就 是 耶 斯 列 人 亚 希 暖 和 作 过 拿 八 妻 的 迦 密 人 亚 比 该 ， 并 跟 随 他 的 人 ， 连 各 人 的 眷 属 ， 都 住 在 迦 特 的 亚 吉 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7935', '9', '27', '4', '有 人 告 诉 扫 罗 说 ： 大 卫 逃 到 迦 特 。 扫 罗 就 不 再 寻 索 他 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7936', '9', '27', '5', '大 卫 对 亚 吉 说 ： 我 若 在 你 眼 前 蒙 恩 ， 求 你 在 京 外 的 城 邑 中 赐 我 一 个 地 方 居 住 。 仆 人 何 必 与 王 同 住 京 都 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7937', '9', '27', '6', '当 日 亚 吉 将 洗 革 拉 赐 给 他 ， 因 此 洗 革 拉 属 犹 大 王 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7938', '9', '27', '7', '大 卫 在 非 利 士 地 住 了 一 年 零 四 个 月 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7939', '9', '27', '8', '大 卫 和 跟 随 他 的 人 上 去 ， 侵 夺 基 述 人 、 基 色 人 、 亚 玛 力 人 之 地 。 这 几 族 历 来 住 在 那 地 ， 从 书 珥 直 到 埃 及 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7940', '9', '27', '9', '大 卫 击 杀 那 地 的 人 ， 无 论 男 女 都 没 有 留 下 一 个 ， 又 夺 获 牛 、 羊 、 骆 驼 、 驴 ， 并 衣 服 ， 回 来 见 亚 吉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7941', '9', '27', '10', '亚 吉 说 ： 你 们 今 日 侵 夺 了 甚 麽 地 方 呢 ？ 大 卫 说 ： 侵 夺 了 犹 大 的 南 方 、 耶 拉 篾 的 南 方 、 基 尼 的 南 方 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7942', '9', '27', '11', '无 论 男 女 ， 大 卫 没 有 留 下 一 个 带 到 迦 特 来 。 他 说 ： 恐 怕 他 们 将 我 们 的 事 告 诉 人 ， 说 大 卫 住 在 非 利 士 地 的 时 候 常 常 这 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7943', '9', '27', '12', '亚 吉 信 了 大 卫 ， 心 里 说 ： 大 卫 使 本 族 以 色 列 人 憎 恶 他 ， 所 以 他 必 永 远 作 我 的 仆 人 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7944', '9', '28', '1', '那 时 ， 非 利 士 人 聚 集 军 旅 ， 要 与 以 色 列 人 打 仗 。 亚 吉 对 大 卫 说 ： 你 当 知 道 ， 你 和 跟 随 你 的 人 都 要 随 我 出 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7945', '9', '28', '2', '大 卫 对 亚 吉 说 ： 仆 人 所 能 做 的 事 ， 王 必 知 道 。 亚 吉 对 大 卫 说 ： 这 样 ， 我 立 你 永 远 作 我 的 护 卫 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7946', '9', '28', '3', '那 时 撒 母 耳 已 经 死 了 ， 以 色 列 众 人 为 他 哀 哭 ， 葬 他 在 拉 玛 ， 就 是 在 他 本 城 里 。 扫 罗 曾 在 国 内 不 容 有 交 鬼 的 和 行 巫 术 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7947', '9', '28', '4', '非 利 士 人 聚 集 ， 来 到 书 念 安 营 ； 扫 罗 聚 集 以 色 列 众 人 在 基 利 波 安 营 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7948', '9', '28', '5', '扫 罗 看 见 非 利 士 的 军 旅 就 惧 怕 ， 心 中 发 颤 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7949', '9', '28', '6', '扫 罗 求 问 耶 和 华 ， 耶 和 华 却 不 藉 梦 ， 或 乌 陵 ， 或 先 知 回 答 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7950', '9', '28', '7', '扫 罗 吩 咐 臣 仆 说 ： 当 为 我 找 一 个 交 鬼 的 妇 人 ， 我 好 去 问 他 。 臣 仆 说 ： 在 隐 多 珥 有 一 个 交 鬼 的 妇 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7951', '9', '28', '8', '於 是 扫 罗 改 了 装 ， 穿 上 别 的 衣 服 ， 带 着 两 个 人 ， 夜 里 去 见 那 妇 人 。 扫 罗 说 ： 求 你 用 交 鬼 的 法 术 ， 将 我 所 告 诉 你 的 死 人 ， 为 我 招 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7952', '9', '28', '9', '妇 人 对 他 说 ： 你 知 道 扫 罗 从 国 中 剪 除 交 鬼 的 和 行 巫 术 的 。 你 为 何 陷 害 我 的 性 命 ， 使 我 死 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7953', '9', '28', '10', '扫 罗 向 妇 人 指 着 耶 和 华 起 誓 说 ： 我 指 着 永 生 的 耶 和 华 起 誓 ， 你 必 不 因 这 事 受 刑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7954', '9', '28', '11', '妇 人 说 ： 我 为 你 招 谁 上 来 呢 ？ 回 答 说 ： 为 我 招 撒 母 耳 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7955', '9', '28', '12', '妇 人 看 见 撒 母 耳 ， 就 大 声 呼 叫 ， 对 扫 罗 说 ： 你 是 扫 罗 ， 为 甚 麽 欺 哄 我 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7956', '9', '28', '13', '王 对 妇 人 说 ： 不 要 惧 怕 ， 你 看 见 了 甚 麽 呢 ？ 妇 人 对 扫 罗 说 ： 我 看 见 有 　 神 从 地 里 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7957', '9', '28', '14', '扫 罗 说 ： 他 是 怎 样 的 形 状 ？ 妇 人 说 ： 有 一 个 老 人 上 来 ， 身 穿 长 衣 。 扫 罗 知 道 是 撒 母 耳 ， 就 屈 身 ， 脸 伏 於 地 下 拜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7958', '9', '28', '15', '撒 母 耳 对 扫 罗 说 ： 你 为 甚 麽 搅 扰 我 ， 招 我 上 来 呢 ？ 扫 罗 回 答 说 ： 我 甚 窘 急 ； 因 为 非 利 士 人 攻 击 我 ， 　 神 也 离 开 我 ， 不 再 藉 先 知 或 梦 回 答 我 。 因 此 请 你 上 来 ， 好 指 示 我 应 当 怎 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7959', '9', '28', '16', '撒 母 耳 说 ： 耶 和 华 已 经 离 开 你 ， 且 与 你 为 敌 ， 你 何 必 问 我 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7960', '9', '28', '17', '耶 和 华 照 他 藉 我 说 的 话 ， 已 经 从 你 手 里 夺 去 国 权 ， 赐 与 别 人 ， 就 是 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7961', '9', '28', '18', '因 你 没 有 听 从 耶 和 华 的 命 令 ； 他 恼 怒 亚 玛 力 人 ， 你 没 有 灭 绝 他 们 ， 所 以 今 日 耶 和 华 向 你 这 样 行 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7962', '9', '28', '19', '并 且 耶 和 华 必 将 你 和 以 色 列 人 交 在 非 利 士 人 的 手 里 。 明 日 你 和 你 众 子 必 与 我 在 一 处 了 ； 耶 和 华 必 将 以 色 列 的 军 兵 交 在 非 利 士 人 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7963', '9', '28', '20', '扫 罗 猛 然 仆 倒 ， 挺 身 在 地 ， 因 撒 母 耳 的 话 甚 是 惧 怕 ； 那 一 昼 一 夜 没 有 吃 甚 麽 ， 就 毫 无 气 力 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7964', '9', '28', '21', '妇 人 到 扫 罗 面 前 ， 见 他 极 其 惊 恐 ， 对 他 说 ： 婢 女 听 从 你 的 话 ， 不 顾 惜 自 己 的 性 命 ， 遵 从 你 所 吩 咐 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7965', '9', '28', '22', '现 在 求 你 听 婢 女 的 话 ， 容 我 在 你 面 前 摆 上 一 点 食 物 ， 你 吃 了 ， 可 以 有 气 力 行 路 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7966', '9', '28', '23', '扫 罗 不 肯 ， 说 ： 我 不 吃 。 但 他 的 仆 人 和 妇 人 再 三 劝 他 ， 他 才 听 了 他 们 的 话 ， 从 地 上 起 来 ， 坐 在 床 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7967', '9', '28', '24', '妇 人 急 忙 将 家 里 的 一 只 肥 牛 犊 宰 了 ， 又 拿 面 抟 成 无 酵 饼 烤 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7968', '9', '28', '25', '摆 在 扫 罗 和 他 仆 人 面 前 。 他 们 吃 完 ， 当 夜 就 起 身 走 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7969', '9', '29', '1', '非 利 士 人 将 他 们 的 军 旅 聚 到 亚 弗 ； 以 色 列 人 在 耶 斯 列 的 泉 旁 安 营 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7970', '9', '29', '2', '非 利 士 人 的 首 领 各 率 军 队 ， 或 百 或 千 ， 挨 次 前 进 ； 大 卫 和 跟 随 他 的 人 同 着 亚 吉 跟 在 後 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7971', '9', '29', '3', '非 利 士 人 的 首 领 说 ： 这 些 希 伯 来 人 在 这 里 做 甚 麽 呢 ？ 亚 吉 对 他 们 说 ： 这 不 是 以 色 列 王 扫 罗 的 臣 子 大 卫 麽 ？ 他 在 我 这 里 有 些 年 日 了 。 自 从 他 投 降 我 直 到 今 日 ， 我 未 曾 见 他 有 过 错 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7972', '9', '29', '4', '非 利 士 人 的 首 领 向 亚 吉 发 怒 ， 对 他 说 ： 你 要 叫 这 人 回 你 所 安 置 他 的 地 方 ， 不 可 叫 他 同 我 们 出 战 ， 恐 怕 他 在 阵 上 反 为 我 们 的 敌 人 。 他 用 甚 麽 与 他 主 人 复 和 呢 ？ 岂 不 是 用 我 们 这 些 人 的 首 级 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7973', '9', '29', '5', '从 前 以 色 列 的 妇 女 跳 舞 唱 和 说 ： 扫 罗 杀 死 千 千 ， 大 卫 杀 死 万 万 ， 所 说 的 不 是 这 个 大 卫 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7974', '9', '29', '6', '亚 吉 叫 大 卫 来 ， 对 他 说 ： 我 指 着 永 生 的 耶 和 华 起 誓 ， 你 是 正 直 人 。 你 随 我 在 军 中 出 入 ， 我 看 你 甚 好 。 自 从 你 投 奔 我 到 如 今 ， 我 未 曾 见 你 有 甚 麽 过 失 ； 只 是 众 首 领 不 喜 悦 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7975', '9', '29', '7', '现 在 你 可 以 平 平 安 安 地 回 去 ， 免 得 非 利 士 人 的 首 领 不 欢 喜 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7976', '9', '29', '8', '大 卫 对 亚 吉 说 ： 我 做 了 甚 麽 呢 ？ 自 从 仆 人 到 你 面 前 ， 直 到 今 日 ， 你 查 出 我 有 甚 麽 过 错 ， 使 我 不 去 攻 击 主 ─ 我 王 的 仇 敌 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7977', '9', '29', '9', '亚 吉 说 ： 我 知 道 你 在 我 眼 前 是 好 人 ， 如 同 　 神 的 使 者 一 般 ； 只 是 非 利 士 人 的 首 领 说 ： 这 人 不 可 同 我 们 出 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7978', '9', '29', '10', '故 此 你 和 跟 随 你 的 人 ， 就 是 你 本 主 的 仆 人 ， 要 明 日 早 晨 起 来 ， 等 到 天 亮 回 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7979', '9', '29', '11', '於 是 大 卫 和 跟 随 他 的 人 早 晨 起 来 ， 回 往 非 利 士 地 去 。 非 利 士 人 也 上 耶 斯 列 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7980', '9', '30', '1', '第 三 日 ， 大 卫 和 跟 随 他 的 人 到 了 洗 革 拉 。 亚 玛 力 人 已 经 侵 夺 南 地 ， 攻 破 洗 革 拉 ， 用 火 焚 烧 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7981', '9', '30', '2', '掳 了 城 内 的 妇 女 和 其 中 的 大 小 人 口 ， 却 没 有 杀 一 个 ， 都 带 着 走 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7982', '9', '30', '3', '大 卫 和 跟 随 他 的 人 到 了 那 城 ， 不 料 ， 城 已 烧 毁 ， 他 们 的 妻 子 儿 女 都 被 掳 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7983', '9', '30', '4', '大 卫 和 跟 随 他 的 人 就 放 声 大 哭 ， 直 哭 得 没 有 气 力 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7984', '9', '30', '5', '大 卫 的 两 个 妻 ─ 耶 斯 列 人 亚 希 暖 和 作 过 拿 八 妻 的 迦 密 人 亚 比 该 ， 也 被 掳 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7985', '9', '30', '6', '大 卫 甚 是 焦 急 ， 因 众 人 为 自 己 的 儿 女 苦 恼 ， 说 ： 要 用 石 头 打 死 他 。 大 卫 却 倚 靠 耶 和 华 ─ 他 的 　 神 ， 心 里 坚 固 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7986', '9', '30', '7', '大 卫 对 亚 希 米 勒 的 儿 子 祭 司 亚 比 亚 他 说 ： 请 你 将 以 弗 得 拿 过 来 。 亚 比 亚 他 就 将 以 弗 得 拿 到 大 卫 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7987', '9', '30', '8', '大 卫 求 问 耶 和 华 说 ： 我 追 赶 敌 军 ， 追 得 上 追 不 上 呢 ？ 耶 和 华 说 ： 你 可 以 追 ， 必 追 得 上 ， 都 救 得 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7988', '9', '30', '9', '於 是 ， 大 卫 和 跟 随 他 的 六 百 人 来 到 比 梭 溪 ； 有 不 能 前 去 的 就 留 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7989', '9', '30', '10', '大 卫 却 带 着 四 百 人 往 前 追 赶 ， 有 二 百 人 疲 乏 ， 不 能 过 比 梭 溪 ， 所 以 留 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7990', '9', '30', '11', '这 四 百 人 在 田 野 遇 见 一 个 埃 及 人 ， 就 带 他 到 大 卫 面 前 ， 给 他 饼 吃 ， 给 他 水 喝 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7991', '9', '30', '12', '又 给 他 一 块 无 花 果 饼 ， 两 个 葡 萄 饼 。 他 吃 了 ， 就 精 神 复 原 ； 因 为 他 三 日 三 夜 没 有 吃 饼 ， 没 有 喝 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7992', '9', '30', '13', '大 卫 问 他 说 ： 你 是 属 谁 的 ？ 你 是 哪 里 的 人 ？ 他 回 答 说 ： 我 是 埃 及 的 少 年 人 ， 是 亚 玛 力 人 的 奴 仆 ； 因 我 三 日 前 患 病 ， 我 主 人 就 把 我 撇 弃 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7993', '9', '30', '14', '我 们 侵 夺 了 基 利 提 的 南 方 和 属 犹 大 的 地 ， 并 迦 勒 地 的 南 方 ， 又 用 火 烧 了 洗 革 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7994', '9', '30', '15', '大 卫 问 他 说 ： 你 肯 领 我 们 到 敌 军 那 里 不 肯 ？ 他 回 答 说 ： 你 要 向 我 指 着 　 神 起 誓 ， 不 杀 我 ， 也 不 将 我 交 在 我 主 人 手 里 ， 我 就 领 你 下 到 敌 军 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7995', '9', '30', '16', '那 人 领 大 卫 下 去 ， 见 他 们 散 在 地 上 ， 吃 喝 跳 舞 ， 因 为 从 非 利 士 地 和 犹 大 地 所 掳 来 的 财 物 甚 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7996', '9', '30', '17', '大 卫 从 黎 明 直 到 次 日 晚 上 ， 击 杀 他 们 ， 除 了 四 百 骑 骆 驼 的 少 年 人 之 外 ， 没 有 一 个 逃 脱 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7997', '9', '30', '18', '亚 玛 力 人 所 掳 去 的 财 物 ， 大 卫 全 都 夺 回 ， 并 救 回 他 的 两 个 妻 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7998', '9', '30', '19', '凡 亚 玛 力 人 所 掳 去 的 ， 无 论 大 小 、 儿 女 、 财 物 ， 大 卫 都 夺 回 来 ， 没 有 失 落 一 个 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('7999', '9', '30', '20', '大 卫 所 夺 来 的 牛 群 羊 群 ， 跟 随 他 的 人 赶 在 原 有 的 群 畜 前 边 ， 说 ： 这 是 大 卫 的 掠 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8000', '9', '30', '21', '大 卫 到 了 那 疲 乏 不 能 跟 随 、 留 在 比 梭 溪 的 二 百 人 那 里 。 他 们 出 来 迎 接 大 卫 并 跟 随 的 人 。 大 卫 前 来 问 他 们 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8001', '9', '30', '22', '跟 随 大 卫 人 中 的 恶 人 和 匪 类 说 ： 这 些 人 既 然 没 有 和 我 们 同 去 ， 我 们 所 夺 的 财 物 就 不 分 给 他 们 ， 只 将 他 们 各 人 的 妻 子 儿 女 给 他 们 ， 使 他 们 带 去 就 是 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8002', '9', '30', '23', '大 卫 说 ： 弟 兄 们 ， 耶 和 华 所 赐 给 我 们 的 ， 不 可 不 分 给 他 们 ； 因 为 他 保 佑 我 们 ， 将 那 攻 击 我 们 的 敌 军 交 在 我 们 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8003', '9', '30', '24', '这 事 谁 肯 依 从 你 们 呢 ？ 上 阵 的 得 多 少 ， 看 守 器 具 的 也 得 多 少 ； 应 当 大 家 平 分 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8004', '9', '30', '25', '大 卫 定 此 为 以 色 列 的 律 例 典 章 ， 从 那 日 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8005', '9', '30', '26', '大 卫 到 了 洗 革 拉 ， 从 掠 物 中 取 些 送 给 他 朋 友 犹 大 的 长 老 ， 说 ： 这 是 从 耶 和 华 仇 敌 那 里 夺 来 的 ， 送 你 们 为 礼 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8006', '9', '30', '27', '他 送 礼 物 给 住 伯 特 利 的 ， 南 地 拉 末 的 ， 雅 提 珥 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8007', '9', '30', '28', '住 亚 罗 珥 的 ， 息 末 的 ， 以 实 提 莫 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8008', '9', '30', '29', '住 拉 哈 勒 的 ， 耶 拉 篾 各 城 的 ， 基 尼 各 城 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8009', '9', '30', '30', '住 何 珥 玛 的 ， 歌 拉 珊 的 ， 亚 挞 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8010', '9', '30', '31', '住 希 伯 仑 的 ， 并 大 卫 和 跟 随 他 的 人 素 来 所 到 之 处 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8011', '9', '31', '1', '非 利 士 人 与 以 色 列 人 争 战 。 以 色 列 人 在 非 利 士 人 面 前 逃 跑 ， 在 基 利 波 有 被 杀 仆 倒 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8012', '9', '31', '2', '非 利 士 人 紧 追 扫 罗 和 他 儿 子 们 ， 就 杀 了 扫 罗 的 儿 子 约 拿 单 、 亚 比 拿 达 、 麦 基 舒 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8013', '9', '31', '3', '势 派 甚 大 ， 扫 罗 被 弓 箭 手 追 上 ， 射 伤 甚 重 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8014', '9', '31', '4', '就 吩 咐 拿 他 兵 器 的 人 说 ： 你 拔 出 刀 来 ， 将 我 刺 死 ， 免 得 那 些 未 受 割 礼 的 人 来 刺 我 ， 凌 辱 我 。 但 拿 兵 器 的 人 甚 惧 怕 ， 不 肯 刺 他 ； 扫 罗 就 自 己 伏 在 刀 上 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8015', '9', '31', '5', '拿 兵 器 的 人 见 扫 罗 已 死 ， 也 伏 在 刀 上 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8016', '9', '31', '6', '这 样 ， 扫 罗 和 他 三 个 儿 子 ， 与 拿 他 兵 器 的 人 ， 以 及 跟 随 他 的 人 ， 都 一 同 死 亡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8017', '9', '31', '7', '住 平 原 那 边 并 约 但 河 西 的 以 色 列 人 ， 见 以 色 列 军 兵 逃 跑 ， 扫 罗 和 他 儿 子 都 死 了 ， 也 就 弃 城 逃 跑 。 非 利 士 人 便 来 住 在 其 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8018', '9', '31', '8', '次 日 ， 非 利 士 人 来 剥 那 被 杀 之 人 的 衣 服 ， 看 见 扫 罗 和 他 三 个 儿 子 仆 倒 在 基 利 波 山 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8019', '9', '31', '9', '就 割 下 他 的 首 级 ， 剥 了 他 的 军 装 ， 打 发 人 到 （ 或 译 ： 送 到 ） 非 利 士 地 的 四 境 ， 报 信 与 他 们 庙 里 的 偶 像 和 众 民 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8020', '9', '31', '10', '又 将 扫 罗 的 军 装 放 在 亚 斯 他 录 庙 里 ， 将 他 的 尸 身 钉 在 伯 珊 的 城 墙 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8021', '9', '31', '11', '基 列 雅 比 的 居 民 听 见 非 利 士 人 向 扫 罗 所 行 的 事 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8022', '9', '31', '12', '他 们 中 间 所 有 的 勇 士 就 起 身 ， 走 了 一 夜 ， 将 扫 罗 和 他 儿 子 的 尸 身 从 伯 珊 城 墙 上 取 下 来 ， 送 到 雅 比 那 里 ， 用 火 烧 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8023', '9', '31', '13', '将 他 们 骸 骨 葬 在 雅 比 的 垂 丝 柳 树 下 ， 就 禁 食 七 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8024', '10', '1', '1', '扫 罗 死 後 ， 大 卫 击 杀 亚 玛 力 人 回 来 ， 在 洗 革 拉 住 了 两 天 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8025', '10', '1', '2', '第 三 天 ， 有 一 人 从 扫 罗 的 营 里 出 来 ， 衣 服 撕 裂 ， 头 蒙 灰 尘 ， 到 大 卫 面 前 伏 地 叩 拜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8026', '10', '1', '3', '大 卫 问 他 说 ： 你 从 哪 里 来 ？ 他 说 ： 我 从 以 色 列 的 营 里 逃 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8027', '10', '1', '4', '大 卫 又 问 他 说 ： 事 情 怎 样 ？ 请 你 告 诉 我 。 他 回 答 说 ： 百 姓 从 阵 上 逃 跑 ， 也 有 许 多 人 仆 倒 死 亡 ； 扫 罗 和 他 儿 子 约 拿 单 也 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8028', '10', '1', '5', '大 卫 问 报 信 的 少 年 人 说 ： 你 怎 麽 知 道 扫 罗 和 他 儿 子 约 拿 单 死 了 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8029', '10', '1', '6', '报 信 的 少 年 人 说 ： 我 偶 然 到 基 利 波 山 ， 看 见 扫 罗 伏 在 自 己 枪 上 ， 有 战 车 、 马 兵 紧 紧 地 追 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8030', '10', '1', '7', '他 回 头 看 见 我 ， 就 呼 叫 我 。 我 说 ： 我 在 这 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8031', '10', '1', '8', '他 问 我 说 ： 你 是 甚 麽 人 ？ 我 说 ： 我 是 亚 玛 力 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8032', '10', '1', '9', '他 说 ： 请 你 来 ， 将 我 杀 死 ； 因 为 痛 苦 抓 住 我 ， 我 的 生 命 尚 存 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8033', '10', '1', '10', '我 准 知 他 仆 倒 必 不 能 活 ， 就 去 将 他 杀 死 ， 把 他 头 上 的 冠 冕 、 臂 上 的 镯 子 拿 到 我 主 这 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8034', '10', '1', '11', '大 卫 就 撕 裂 衣 服 ， 跟 随 他 的 人 也 是 如 此 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8035', '10', '1', '12', '而 且 悲 哀 哭 号 ， 禁 食 到 晚 上 ， 是 因 扫 罗 和 他 儿 子 约 拿 单 ， 并 耶 和 华 的 民 以 色 列 家 的 人 ， 倒 在 刀 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8036', '10', '1', '13', '大 卫 问 报 信 的 少 年 人 说 ： 你 是 哪 里 的 人 ？ 他 说 ： 我 是 亚 玛 力 客 人 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8037', '10', '1', '14', '大 卫 说 ： 你 伸 手 杀 害 耶 和 华 的 受 膏 者 ， 怎 麽 不 畏 惧 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8038', '10', '1', '15', '大 卫 叫 了 一 个 少 年 人 来 ， 说 ： 你 去 杀 他 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8039', '10', '1', '16', '大 卫 对 他 说 ： 你 流 人 血 的 罪 归 到 自 己 的 头 上 ， 因 为 你 亲 口 作 见 证 说 ： 我 杀 了 耶 和 华 的 受 膏 者 。 少 年 人 就 把 他 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8040', '10', '1', '17', '大 卫 作 哀 歌 ， 吊 扫 罗 和 他 儿 子 约 拿 单 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8041', '10', '1', '18', '且 吩 咐 将 这 歌 教 导 犹 大 人 。 这 歌 名 叫 弓 歌 ， 写 在 雅 煞 珥 书 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8042', '10', '1', '19', '歌 中 说 ： 以 色 列 啊 ， 你 尊 荣 者 在 山 上 被 杀 ！ 大 英 雄 何 竟 死 亡 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8043', '10', '1', '20', '不 要 在 迦 特 报 告 ； 不 要 在 亚 实 基 伦 街 上 传 扬 ； 免 得 非 利 士 的 女 子 欢 乐 ； 免 得 未 受 割 礼 之 人 的 女 子 矜 夸 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8044', '10', '1', '21', '基 利 波 山 哪 ， 愿 你 那 里 没 有 雨 露 ！ 愿 你 田 地 无 土 产 可 作 供 物 ！ 因 为 英 雄 的 盾 牌 在 那 里 被 污 丢 弃 ； 扫 罗 的 盾 牌 彷 佛 未 曾 抹 油 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8045', '10', '1', '22', '约 拿 单 的 弓 箭 非 流 敌 人 的 血 不 退 缩 ； 扫 罗 的 刀 剑 非 剖 勇 士 的 油 不 收 回 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8046', '10', '1', '23', '扫 罗 和 约 拿 单 ─ 活 时 相 悦 相 爱 ， 死 时 也 不 分 离 ─ 他 们 比 鹰 更 快 ， 比 狮 子 还 强 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8047', '10', '1', '24', '以 色 列 的 女 子 啊 ， 当 为 扫 罗 哭 号 ！ 他 曾 使 你 们 穿 朱 红 色 的 美 衣 ， 使 你 们 衣 服 有 黄 金 的 妆 饰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8048', '10', '1', '25', '英 雄 何 竟 在 阵 上 仆 倒 ！ 约 拿 单 何 竟 在 山 上 被 杀 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8049', '10', '1', '26', '我 兄 约 拿 单 哪 ， 我 为 你 悲 伤 ！ 我 甚 喜 悦 你 ！ 你 向 我 发 的 爱 情 奇 妙 非 常 ， 过 於 妇 女 的 爱 情 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8050', '10', '1', '27', '英 雄 何 竟 仆 倒 ！ 战 具 何 竟 灭 没 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8051', '10', '2', '1', '此 後 ， 大 卫 问 耶 和 华 说 ： 我 上 犹 大 的 一 个 城 去 可 以 麽 ？ 耶 和 华 说 ： 可 以 。 大 卫 说 ： 我 上 哪 一 个 城 去 呢 ？ 耶 和 华 说 ： 上 希 伯 仑 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8052', '10', '2', '2', '於 是 大 卫 和 他 的 两 个 妻 ─ 一 个 是 耶 斯 列 人 亚 希 暖 ， 一 个 是 作 过 迦 密 人 拿 八 妻 的 亚 比 该 ─ 都 上 那 里 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8053', '10', '2', '3', '大 卫 也 将 跟 随 他 的 人 和 他 们 各 人 的 眷 属 一 同 带 上 去 ， 住 在 希 伯 仑 的 城 邑 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8054', '10', '2', '4', '犹 大 人 来 到 希 伯 仑 ， 在 那 里 膏 大 卫 作 犹 大 家 的 王 。 有 人 告 诉 大 卫 说 ： 葬 埋 扫 罗 的 是 基 列 雅 比 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8055', '10', '2', '5', '大 卫 就 差 人 去 见 基 列 雅 比 人 ， 对 他 们 说 ： 你 们 厚 待 你 们 的 主 ─ 扫 罗 ， 将 他 葬 埋 。 愿 耶 和 华 赐 福 与 你 们 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8056', '10', '2', '6', '你 们 既 行 了 这 事 ， 愿 耶 和 华 以 慈 爱 诚 实 待 你 们 ， 我 也 要 为 此 厚 待 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8057', '10', '2', '7', '现 在 你 们 的 主 ─ 扫 罗 死 了 ， 犹 大 家 已 经 膏 我 作 他 们 的 王 ， 所 以 你 们 要 刚 强 奋 勇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8058', '10', '2', '8', '扫 罗 的 元 帅 尼 珥 的 儿 子 押 尼 珥 ， 曾 将 扫 罗 的 儿 子 伊 施 波 设 带 过 河 ， 到 玛 哈 念 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8059', '10', '2', '9', '立 他 作 王 ， 治 理 基 列 、 亚 书 利 、 耶 斯 列 、 以 法 莲 、 便 雅 悯 ， 和 以 色 列 众 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8060', '10', '2', '10', '扫 罗 的 儿 子 伊 施 波 设 登 基 的 时 候 年 四 十 岁 ， 作 以 色 列 王 二 年 ； 惟 独 犹 大 家 归 从 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8061', '10', '2', '11', '大 卫 在 希 伯 仑 作 犹 大 家 的 王 ， 共 七 年 零 六 个 月 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8062', '10', '2', '12', '尼 珥 的 儿 子 押 尼 珥 和 扫 罗 的 儿 子 伊 施 波 设 的 仆 人 从 玛 哈 念 出 来 ， 往 基 遍 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8063', '10', '2', '13', '洗 鲁 雅 的 儿 子 约 押 和 大 卫 的 仆 人 也 出 来 ， 在 基 遍 池 旁 与 他 们 相 遇 ； 一 班 坐 在 池 这 边 ， 一 班 坐 在 池 那 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8064', '10', '2', '14', '押 尼 珥 对 约 押 说 ： 让 少 年 人 起 来 ， 在 我 们 面 前 戏 耍 罢 ！ 约 押 说 ： 可 以 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8065', '10', '2', '15', '就 按 着 定 数 起 来 ： 属 扫 罗 儿 子 伊 施 波 设 的 便 雅 悯 人 过 去 十 二 名 ， 大 卫 的 仆 人 也 过 去 十 二 名 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8066', '10', '2', '16', '彼 此 揪 头 ， 用 刀 刺 肋 ， 一 同 仆 倒 。 所 以 ， 那 地 叫 作 希 利 甲 哈 素 林 ， 就 在 基 遍 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8067', '10', '2', '17', '那 日 的 战 事 凶 猛 ， 押 尼 珥 和 以 色 列 人 败 在 大 卫 的 仆 人 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8068', '10', '2', '18', '在 那 里 有 洗 鲁 雅 的 三 个 儿 子 ： 约 押 、 亚 比 筛 、 亚 撒 黑 。 亚 撒 黑 脚 快 如 野 鹿 一 般 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8069', '10', '2', '19', '亚 撒 黑 追 赶 押 尼 珥 ， 直 追 赶 他 不 偏 左 右 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8070', '10', '2', '20', '押 尼 珥 回 头 说 ： 你 是 亚 撒 黑 麽 ？ 回 答 说 ： 是 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8071', '10', '2', '21', '押 尼 珥 对 他 说 ： 你 或 转 向 左 转 向 右 ， 拿 住 一 个 少 年 人 ， 剥 去 他 的 战 衣 。 亚 撒 黑 却 不 肯 转 开 不 追 赶 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8072', '10', '2', '22', '押 尼 珥 又 对 亚 撒 黑 说 ： 你 转 开 不 追 赶 我 罢 ！ 我 何 必 杀 你 呢 ？ 若 杀 你 ， 有 甚 麽 脸 见 你 哥 哥 约 押 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8073', '10', '2', '23', '亚 撒 黑 仍 不 肯 转 开 。 故 此 ， 押 尼 珥 就 用 枪 ? 刺 入 他 的 肚 腹 ， 甚 至 枪 从 背 後 透 出 ， 亚 撒 黑 就 在 那 里 仆 倒 而 死 。 众 人 赶 到 亚 撒 黑 仆 倒 而 死 的 地 方 ， 就 都 站 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8074', '10', '2', '24', '约 押 和 亚 比 筛 追 赶 押 尼 珥 ， 日 落 的 时 候 ， 到 了 通 基 遍 旷 野 的 路 旁 ， 基 亚 对 面 的 亚 玛 山 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8075', '10', '2', '25', '便 雅 悯 人 聚 集 ， 跟 随 押 尼 珥 站 在 一 个 山 顶 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8076', '10', '2', '26', '押 尼 珥 呼 叫 约 押 说 ： 刀 剑 岂 可 永 远 杀 人 麽 ？ 你 岂 不 知 终 久 必 有 苦 楚 麽 ？ 你 要 等 何 时 才 叫 百 姓 回 去 、 不 追 赶 弟 兄 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8077', '10', '2', '27', '约 押 说 ： 我 指 着 永 生 的 　 神 起 誓 ： 你 若 不 说 戏 耍 的 那 句 话 ， 今 日 早 晨 百 姓 就 回 去 ， 不 追 赶 弟 兄 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8078', '10', '2', '28', '於 是 约 押 吹 角 ， 众 民 就 站 住 ， 不 再 追 赶 以 色 列 人 ， 也 不 再 打 仗 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8079', '10', '2', '29', '押 尼 珥 和 跟 随 他 的 人 整 夜 经 过 亚 拉 巴 ， 过 约 但 河 ， 走 过 毕 伦 ， 到 了 玛 哈 念 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8080', '10', '2', '30', '约 押 追 赶 押 尼 珥 回 来 ， 聚 集 众 民 ， 见 大 卫 的 仆 人 中 缺 少 了 十 九 个 人 和 亚 撒 黑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8081', '10', '2', '31', '但 大 卫 的 仆 人 杀 了 便 雅 悯 人 和 跟 随 押 尼 珥 的 人 ， 共 三 百 六 十 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8082', '10', '2', '32', '众 人 将 亚 撒 黑 送 到 伯 利 恒 ， 葬 在 他 父 亲 的 坟 墓 里 。 约 押 和 跟 随 他 的 人 走 了 一 夜 ， 天 亮 的 时 候 到 了 希 伯 仑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8083', '10', '3', '1', '扫 罗 家 和 大 卫 家 争 战 许 久 。 大 卫 家 日 见 强 盛 ； 扫 罗 家 日 见 衰 弱 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8084', '10', '3', '2', '大 卫 在 希 伯 仑 得 了 几 个 儿 子 ： 长 子 暗 嫩 是 耶 斯 列 人 亚 希 暖 所 生 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8085', '10', '3', '3', '次 子 基 利 押 （ 在 历 代 上 三 章 一 节 作 但 以 利 ） 是 作 过 迦 密 人 拿 八 的 妻 亚 比 该 所 生 的 ； 三 子 押 沙 龙 是 基 述 王 达 买 的 女 儿 玛 迦 所 生 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8086', '10', '3', '4', '四 子 亚 多 尼 雅 是 哈 及 所 生 的 ； 五 子 示 法 提 雅 是 亚 比 他 所 生 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8087', '10', '3', '5', '六 子 以 特 念 是 大 卫 的 妻 以 格 拉 所 生 的 。 大 卫 这 六 个 儿 子 都 是 在 希 伯 仑 生 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8088', '10', '3', '6', '扫 罗 家 和 大 卫 家 争 战 的 时 候 ， 押 尼 珥 在 扫 罗 家 大 有 权 势 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8089', '10', '3', '7', '扫 罗 有 一 妃 嫔 ， 名 叫 利 斯 巴 ， 是 爱 亚 的 女 儿 。 一 日 ， 伊 施 波 设 对 押 尼 珥 说 ： 你 为 甚 麽 与 我 父 的 妃 嫔 同 房 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8090', '10', '3', '8', '押 尼 珥 因 伊 施 波 设 的 话 就 甚 发 怒 ， 说 ： 我 岂 是 犹 大 的 狗 头 呢 ？ 我 恩 待 你 父 扫 罗 的 家 和 他 的 弟 兄 、 朋 友 ， 不 将 你 交 在 大 卫 手 里 ， 今 日 你 竟 为 这 妇 人 责 备 我 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8091', '10', '3', '9', '我 若 不 照 着 耶 和 华 起 誓 应 许 大 卫 的 话 行 ， 废 去 扫 罗 的 位 ， 建 立 大 卫 的 位 ， 使 他 治 理 以 色 列 和 犹 大 ， 从 但 直 到 别 是 巴 ， 愿 　 神 重 重 地 降 罚 与 我 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8092', '10', '3', '10', 'a');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8093', '10', '3', '11', '伊 施 波 设 惧 怕 押 尼 珥 ， 不 敢 回 答 一 句 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8094', '10', '3', '12', '押 尼 珥 打 发 人 去 见 大 卫 ， 替 他 说 ： 这 国 归 谁 呢 ？ 又 说 ： 你 与 我 立 约 ， 我 必 帮 助 你 ， 使 以 色 列 人 都 归 服 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8095', '10', '3', '13', '大 卫 说 ： 好 ！ 我 与 你 立 约 。 但 有 一 件 ， 你 来 见 我 面 的 时 候 ， 若 不 将 扫 罗 的 女 儿 米 甲 带 来 ， 必 不 得 见 我 的 面 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8096', '10', '3', '14', '大 卫 就 打 发 人 去 见 扫 罗 的 儿 子 伊 施 波 设 ， 说 ： 你 要 将 我 的 妻 米 甲 归 还 我 ； 他 是 我 从 前 用 一 百 非 利 士 人 的 阳 皮 所 聘 定 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8097', '10', '3', '15', '伊 施 波 设 就 打 发 人 去 ， 将 米 甲 从 拉 亿 的 儿 子 、 他 丈 夫 帕 铁 那 里 接 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8098', '10', '3', '16', '米 甲 的 丈 夫 跟 着 他 ， 一 面 走 一 面 哭 ， 直 跟 到 巴 户 琳 。 押 尼 珥 说 ： 你 回 去 罢 ！ 帕 铁 就 回 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8099', '10', '3', '17', '押 尼 珥 对 以 色 列 长 老 说 ： 从 前 你 们 愿 意 大 卫 作 王 治 理 你 们 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8100', '10', '3', '18', '现 在 你 们 可 以 照 心 愿 而 行 。 因 为 耶 和 华 曾 论 到 大 卫 说 ： 我 必 藉 我 仆 人 大 卫 的 手 ， 救 我 民 以 色 列 脱 离 非 利 士 人 和 众 仇 敌 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8101', '10', '3', '19', '押 尼 珥 也 用 这 话 说 给 便 雅 悯 人 听 ， 又 到 希 伯 仑 ， 将 以 色 列 人 和 便 雅 悯 全 家 一 切 所 喜 悦 的 事 说 给 大 卫 听 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8102', '10', '3', '20', '押 尼 珥 带 着 二 十 个 人 来 到 希 伯 仑 见 大 卫 ， 大 卫 就 为 押 尼 珥 和 他 带 来 的 人 设 摆 筵 席 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8103', '10', '3', '21', '押 尼 珥 对 大 卫 说 ： 我 要 起 身 去 招 聚 以 色 列 众 人 来 见 我 主 我 王 ， 与 你 立 约 ， 你 就 可 以 照 着 心 愿 作 王 。 於 是 大 卫 送 押 尼 珥 去 ， 押 尼 珥 就 平 平 安 安 地 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8104', '10', '3', '22', '约 押 和 大 卫 的 仆 人 攻 击 敌 军 ， 带 回 许 多 的 掠 物 。 那 时 押 尼 珥 不 在 希 伯 仑 大 卫 那 里 ， 因 大 卫 已 经 送 他 去 ， 他 也 平 平 安 安 地 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8105', '10', '3', '23', '约 押 和 跟 随 他 的 全 军 到 了 ， 就 有 人 告 诉 约 押 说 ： 尼 珥 的 儿 子 押 尼 珥 来 见 王 ， 王 送 他 去 ， 他 也 平 平 安 安 地 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8106', '10', '3', '24', '约 押 去 见 王 说 ： 你 这 是 做 甚 麽 呢 ？ 押 尼 珥 来 见 你 ， 你 为 何 送 他 去 ， 他 就 踪 影 不 见 了 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8107', '10', '3', '25', '你 当 晓 得 ， 尼 珥 的 儿 子 押 尼 珥 来 是 要 诓 哄 你 ， 要 知 道 你 的 出 入 和 你 一 切 所 行 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8108', '10', '3', '26', '约 押 从 大 卫 那 里 出 来 ， 就 打 发 人 去 追 赶 押 尼 珥 ， 在 西 拉 井 追 上 他 ， 将 他 带 回 来 ， 大 卫 却 不 知 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8109', '10', '3', '27', '押 尼 珥 回 到 希 伯 仑 ， 约 押 领 他 到 城 门 的 ? 洞 ， 假 作 要 与 他 说 机 密 话 ， 就 在 那 里 刺 透 他 的 肚 腹 ， 他 便 死 了 。 这 是 报 杀 他 兄 弟 亚 撒 黑 的 仇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8110', '10', '3', '28', '大 卫 听 见 了 ， 就 说 ： 流 尼 珥 的 儿 子 押 尼 珥 的 血 ， 这 罪 在 耶 和 华 面 前 必 永 不 归 我 和 我 的 国 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8111', '10', '3', '29', '愿 流 他 血 的 罪 归 到 约 押 头 上 和 他 父 的 全 家 ； 又 愿 约 押 家 不 断 有 患 漏 症 的 ， 长 大 ? 疯 的 ， 架 ? 而 行 的 ， 被 刀 杀 死 的 ， 缺 乏 饮 食 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8112', '10', '3', '30', '约 押 和 他 兄 弟 亚 比 筛 杀 了 押 尼 珥 ， 是 因 押 尼 珥 在 基 遍 争 战 的 时 候 杀 了 他 们 的 兄 弟 亚 撒 黑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8113', '10', '3', '31', '大 卫 吩 咐 约 押 和 跟 随 他 的 众 人 说 ： 你 们 当 撕 裂 衣 服 ， 腰 束 麻 布 ， 在 押 尼 珥 棺 前 哀 哭 。 大 卫 王 也 跟 在 棺 後 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8114', '10', '3', '32', '他 们 将 押 尼 珥 葬 在 希 伯 仑 。 王 在 押 尼 珥 的 墓 旁 放 声 而 哭 ， 众 民 也 都 哭 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8115', '10', '3', '33', '王 为 押 尼 珥 举 哀 ， 说 ： 押 尼 珥 何 竟 像 愚 顽 人 死 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8116', '10', '3', '34', '你 手 未 曾 捆 绑 ， 脚 未 曾 锁 住 。 你 死 ， 如 人 死 在 罪 孽 之 辈 手 下 一 样 。 於 是 众 民 又 为 押 尼 珥 哀 哭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8117', '10', '3', '35', '日 头 未 落 的 时 候 ， 众 民 来 劝 大 卫 吃 饭 ， 但 大 卫 起 誓 说 ： 我 若 在 日 头 未 落 以 前 吃 饭 ， 或 吃 别 物 ， 愿 　 神 重 重 地 降 罚 与 我 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8118', '10', '3', '36', '众 民 知 道 了 就 都 喜 悦 。 凡 王 所 行 的 ， 众 民 无 不 喜 悦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8119', '10', '3', '37', '那 日 ， 以 色 列 众 民 才 知 道 杀 尼 珥 的 儿 子 押 尼 珥 并 非 出 於 王 意 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8120', '10', '3', '38', '王 对 臣 仆 说 ： 你 们 岂 不 知 今 日 以 色 列 人 中 死 了 一 个 作 元 帅 的 大 丈 夫 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8121', '10', '3', '39', '我 虽 然 受 膏 为 王 ， 今 日 还 是 软 弱 ； 这 洗 鲁 雅 的 两 个 儿 子 比 我 刚 强 。 愿 耶 和 华 照 着 恶 人 所 行 的 恶 报 应 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8122', '10', '4', '1', '扫 罗 的 儿 子 伊 施 波 设 听 见 押 尼 珥 死 在 希 伯 仑 ， 手 就 发 软 ； 以 色 列 众 人 也 都 惊 惶');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8123', '10', '4', '2', '扫 罗 的 儿 子 伊 施 波 设 有 两 个 军 长 ， 一 名 巴 拿 ， 一 名 利 甲 ， 是 便 雅 悯 支 派 、 比 录 人 临 门 的 儿 子 。 比 录 也 属 便 雅 悯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8124', '10', '4', '3', '比 录 人 早 先 逃 到 基 他 音 ， 在 那 里 寄 居 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8125', '10', '4', '4', '扫 罗 的 儿 子 约 拿 单 有 一 个 儿 子 名 叫 米 非 波 设 ， 是 瘸 腿 的 。 扫 罗 和 约 拿 单 死 亡 的 消 息 从 耶 斯 列 传 到 的 时 候 ， 他 才 五 岁 。 他 乳 母 抱 着 他 逃 跑 ； 因 为 跑 得 太 急 ， 孩 子 掉 在 地 上 ， 腿 就 瘸 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8126', '10', '4', '5', '一 日 ， 比 录 人 临 门 的 两 个 儿 子 利 甲 和 巴 拿 出 去 ， 约 在 午 热 的 时 候 到 了 伊 施 波 设 的 家 ； 伊 施 波 设 正 睡 午 觉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8127', '10', '4', '6', '他 们 进 了 房 子 ， 假 作 要 取 麦 子 ， 就 刺 透 伊 施 波 设 的 肚 腹 ， 逃 跑 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8128', '10', '4', '7', '他 们 进 房 子 的 时 候 ， 伊 施 波 设 正 在 卧 房 里 躺 在 床 上 ， 他 们 将 他 杀 死 ， 割 了 他 的 首 级 ， 拿 着 首 级 在 亚 拉 巴 走 了 一 夜 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8129', '10', '4', '8', '将 伊 施 波 设 的 首 级 拿 到 希 伯 仑 见 大 卫 王 ， 说 ： 王 的 仇 敌 扫 罗 曾 寻 索 王 的 性 命 。 看 哪 ， 这 是 他 儿 子 伊 施 波 设 的 首 级 ； 耶 和 华 今 日 为 我 主 我 王 在 扫 罗 和 他 後 裔 的 身 上 报 了 仇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8130', '10', '4', '9', '大 卫 对 比 录 人 临 门 的 儿 子 利 甲 和 他 兄 弟 巴 拿 说 ： 我 指 着 救 我 性 命 脱 离 一 切 苦 难 、 永 生 的 耶 和 华 起 誓 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8131', '10', '4', '10', '从 前 有 人 报 告 我 说 ， 扫 罗 死 了 ， 他 自 以 为 报 好 消 息 ； 我 就 拿 住 他 ， 将 他 杀 在 洗 革 拉 ， 这 就 作 了 他 报 消 息 的 赏 赐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8132', '10', '4', '11', '何 况 恶 人 将 义 人 杀 在 他 的 床 上 ， 我 岂 不 向 你 们 讨 流 他 血 的 罪 、 从 世 上 除 灭 你 们 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8133', '10', '4', '12', '於 是 大 卫 吩 咐 少 年 人 将 他 们 杀 了 ， 砍 断 他 们 的 手 脚 ， 挂 在 希 伯 仑 的 池 旁 ， 却 将 伊 施 波 设 的 首 级 葬 在 希 伯 仑 押 尼 珥 的 坟 墓 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8134', '10', '5', '1', '以 色 列 众 支 派 来 到 希 伯 仑 见 大 卫 ， 说 ： 我 们 原 是 你 的 骨 肉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8135', '10', '5', '2', '从 前 扫 罗 作 我 们 王 的 时 候 ， 率 领 以 色 列 人 出 入 的 是 你 ； 耶 和 华 也 曾 应 许 你 说 ： 你 必 牧 养 我 的 民 以 色 列 ， 作 以 色 列 的 君 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8136', '10', '5', '3', '於 是 以 色 列 的 长 老 都 来 到 希 伯 仑 见 大 卫 王 ， 大 卫 在 希 伯 仑 耶 和 华 面 前 与 他 们 立 约 ， 他 们 就 膏 大 卫 作 以 色 列 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8137', '10', '5', '4', '大 卫 登 基 的 时 候 年 三 十 岁 ， 在 位 四 十 年 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8138', '10', '5', '5', '在 希 伯 仑 作 犹 大 王 七 年 零 六 个 月 ， 在 耶 路 撒 冷 作 以 色 列 和 犹 大 王 三 十 三 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8139', '10', '5', '6', '大 卫 和 跟 随 他 的 人 到 了 耶 路 撒 冷 ， 要 攻 打 住 那 地 方 的 耶 布 斯 人 。 耶 布 斯 人 对 大 卫 说 ： 你 若 不 赶 出 瞎 子 、 瘸 子 ， 必 不 能 进 这 地 方 ； 心 里 想 大 卫 决 不 能 进 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8140', '10', '5', '7', '然 而 大 卫 攻 取 锡 安 的 保 障 ， 就 是 大 卫 的 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8141', '10', '5', '8', '当 日 ， 大 卫 说 ： 谁 攻 打 耶 布 斯 人 ， 当 上 水 沟 攻 打 我 心 里 所 恨 恶 的 瘸 子 、 瞎 子 。 从 此 有 俗 语 说 ： 在 那 里 有 瞎 子 、 瘸 子 ， 他 不 能 进 屋 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8142', '10', '5', '9', '大 卫 住 在 保 障 里 ， 给 保 障 起 名 叫 大 卫 城 。 大 卫 又 从 米 罗 以 里 ， 周 围 筑 墙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8143', '10', '5', '10', '大 卫 日 见 强 盛 ， 因 为 耶 和 华 ─ 万 军 之 　 神 与 他 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8144', '10', '5', '11', '推 罗 王 希 兰 将 香 柏 木 运 到 大 卫 那 里 ， 又 差 遣 使 者 和 木 匠 、 石 匠 给 大 卫 建 造 宫 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8145', '10', '5', '12', '大 卫 就 知 道 耶 和 华 坚 立 他 作 以 色 列 王 ， 又 为 自 己 的 民 以 色 列 使 他 的 国 兴 旺 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8146', '10', '5', '13', '大 卫 离 开 希 伯 仑 之 後 ， 在 耶 路 撒 冷 又 立 后 妃 ， 又 生 儿 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8147', '10', '5', '14', '在 耶 路 撒 冷 所 生 的 儿 子 是 沙 母 亚 、 朔 罢 、 拿 单 、 所 罗 门 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8148', '10', '5', '15', '益 辖 、 以 利 书 亚 、 尼 斐 、 雅 非 亚 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8149', '10', '5', '16', '以 利 沙 玛 、 以 利 雅 大 、 以 利 法 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8150', '10', '5', '17', '非 利 士 人 听 见 人 膏 大 卫 作 以 色 列 王 ， 非 利 士 人 就 上 来 寻 索 大 卫 ； 大 卫 听 见 ， 就 下 到 保 障 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8151', '10', '5', '18', '非 利 士 人 来 了 ， 布 散 在 利 乏 音 谷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8152', '10', '5', '19', '大 卫 求 问 耶 和 华 说 ： 我 可 以 上 去 攻 打 非 利 士 人 麽 ？ 你 将 他 们 交 在 我 手 里 麽 ？ 耶 和 华 说 ： 你 可 以 上 去 ， 我 必 将 非 利 士 人 交 在 你 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8153', '10', '5', '20', '大 卫 来 到 巴 力 毗 拉 心 ， 在 那 里 击 杀 非 利 士 人 ， 说 ： 耶 和 华 在 我 面 前 冲 破 敌 人 ， 如 同 水 冲 去 一 般 。 因 此 称 那 地 方 为 巴 力 毗 拉 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8154', '10', '5', '21', '非 利 士 人 将 偶 像 撇 在 那 里 ， 大 卫 和 跟 随 他 的 人 拿 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8155', '10', '5', '22', '非 利 士 人 又 上 来 ， 布 散 在 利 乏 音 谷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8156', '10', '5', '23', '大 卫 求 问 耶 和 华 ； 耶 和 华 说 ： 不 要 一 直 地 上 去 ， 要 转 到 他 们 後 头 ， 从 桑 林 对 面 攻 打 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8157', '10', '5', '24', '你 听 见 桑 树 梢 上 有 脚 步 的 声 音 ， 就 要 急 速 前 去 ， 因 为 那 时 耶 和 华 已 经 在 你 前 头 去 攻 打 非 利 士 人 的 军 队 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8158', '10', '5', '25', '大 卫 就 遵 着 耶 和 华 所 吩 咐 的 去 行 ， 攻 打 非 利 士 人 ， 从 迦 巴 直 到 基 色 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8159', '10', '6', '1', '大 卫 又 聚 集 以 色 列 中 所 有 挑 选 的 人 三 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8160', '10', '6', '2', '大 卫 起 身 ， 率 领 跟 随 他 的 众 人 前 往 ， 要 从 巴 拉 犹 大 将 　 神 的 约 柜 运 来 ； 这 约 柜 就 是 坐 在 二 基 路 伯 上 万 军 之 耶 和 华 留 名 的 约 柜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8161', '10', '6', '3', '他 们 将 　 神 的 约 柜 从 冈 上 亚 比 拿 达 的 家 里 抬 出 来 ， 放 在 新 车 上 ； 亚 比 拿 达 的 两 个 儿 子 乌 撒 和 亚 希 约 赶 这 新 车 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8162', '10', '6', '4', '他 们 将 　 神 的 约 柜 从 冈 上 亚 比 拿 达 家 里 抬 出 来 的 时 候 ， 亚 希 约 在 柜 前 行 走 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8163', '10', '6', '5', '大 卫 和 以 色 列 的 全 家 在 耶 和 华 面 前 ， 用 松 木 制 造 的 各 样 乐 器 和 琴 、 瑟 、 鼓 、 钹 、 锣 ， 作 乐 跳 舞 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8164', '10', '6', '6', '到 了 拿 艮 的 禾 场 ， 因 为 牛 失 前 蹄 （ 或 译 ： 惊 跳 ） ， 乌 撒 就 伸 手 扶 住 　 神 的 约 柜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8165', '10', '6', '7', '　 神 耶 和 华 向 乌 撒 发 怒 ， 因 这 错 误 击 杀 他 ， 他 就 死 在 　 神 的 约 柜 旁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8166', '10', '6', '8', '大 卫 因 耶 和 华 击 杀 （ 原 文 是 闯 杀 ） 乌 撒 ， 心 里 愁 烦 ， 就 称 那 地 方 为 毗 列 斯 乌 撒 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8167', '10', '6', '9', '那 日 ， 大 卫 惧 怕 耶 和 华 ， 说 ： 耶 和 华 的 约 柜 怎 可 运 到 我 这 里 来 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8168', '10', '6', '10', '於 是 大 卫 不 肯 将 耶 和 华 的 约 柜 运 进 大 卫 的 城 ， 却 运 到 迦 特 人 俄 别 以 东 的 家 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8169', '10', '6', '11', '耶 和 华 的 约 柜 在 迦 特 人 俄 别 以 东 家 中 三 个 月 ； 耶 和 华 赐 福 给 俄 别 以 东 和 他 的 全 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8170', '10', '6', '12', '有 人 告 诉 大 卫 王 说 ： 耶 和 华 因 为 约 柜 赐 福 给 俄 别 以 东 的 家 和 一 切 属 他 的 。 大 卫 就 去 ， 欢 欢 喜 喜 地 将 　 神 的 约 柜 从 俄 别 以 东 家 中 抬 到 大 卫 的 城 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8171', '10', '6', '13', '抬 耶 和 华 约 柜 的 人 走 了 六 步 ， 大 卫 就 献 牛 与 肥 羊 为 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8172', '10', '6', '14', '大 卫 穿 着 细 麻 布 的 以 弗 得 ， 在 耶 和 华 面 前 极 力 跳 舞 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8173', '10', '6', '15', '这 样 ， 大 卫 和 以 色 列 的 全 家 欢 呼 吹 角 ， 将 耶 和 华 的 约 柜 抬 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8174', '10', '6', '16', '耶 和 华 的 约 柜 进 了 大 卫 城 的 时 候 ， 扫 罗 的 女 儿 米 甲 从 窗 户 里 观 看 ， 见 大 卫 王 在 耶 和 华 面 前 踊 跃 跳 舞 ， 心 里 就 轻 视 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8175', '10', '6', '17', '众 人 将 耶 和 华 的 约 柜 请 进 去 ， 安 放 在 所 预 备 的 地 方 ， 就 是 在 大 卫 所 搭 的 帐 幕 里 。 大 卫 在 耶 和 华 面 前 献 燔 祭 和 平 安 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8176', '10', '6', '18', '大 卫 献 完 了 燔 祭 和 平 安 祭 ， 就 奉 万 军 之 耶 和 华 的 名 给 民 祝 福 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8177', '10', '6', '19', '并 且 分 给 以 色 列 众 人 ， 无 论 男 女 ， 每 人 一 个 饼 ， 一 块 肉 ， 一 个 葡 萄 饼 ； 众 人 就 各 回 各 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8178', '10', '6', '20', '大 卫 回 家 要 给 眷 属 祝 福 ； 扫 罗 的 女 儿 米 甲 出 来 迎 接 他 ， 说 ： 以 色 列 王 今 日 在 臣 仆 的 婢 女 眼 前 露 体 ， 如 同 一 个 轻 贱 人 无 耻 露 体 一 样 ， 有 好 大 的 荣 耀 啊 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8179', '10', '6', '21', '大 卫 对 米 甲 说 ： 这 是 在 耶 和 华 面 前 ； 耶 和 华 已 拣 选 我 ， 废 了 你 父 和 你 父 的 全 家 ， 立 我 作 耶 和 华 民 以 色 列 的 君 ， 所 以 我 必 在 耶 和 华 面 前 跳 舞 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8180', '10', '6', '22', '我 也 必 更 加 卑 微 ， 自 己 看 为 轻 贱 。 你 所 说 的 那 些 婢 女 ， 他 们 倒 要 尊 敬 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8181', '10', '6', '23', '扫 罗 的 女 儿 米 甲 ， 直 到 死 日 ， 没 有 生 养 儿 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8182', '10', '7', '1', '王 住 在 自 己 宫 中 ， 耶 和 华 使 他 安 靖 ， 不 被 四 围 的 仇 敌 扰 乱 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8183', '10', '7', '2', '那 时 ， 王 对 先 知 拿 单 说 ： 看 哪 ， 我 住 在 香 柏 木 的 宫 中 ， 　 神 的 约 柜 反 在 幔 子 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8184', '10', '7', '3', '拿 单 对 王 说 ： 你 可 以 照 你 的 心 意 而 行 ， 因 为 耶 和 华 与 你 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8185', '10', '7', '4', '当 夜 ， 耶 和 华 的 话 临 到 拿 单 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8186', '10', '7', '5', '你 去 告 诉 我 仆 人 大 卫 ， 说 耶 和 华 如 此 说 ： 你 岂 可 建 造 殿 宇 给 我 居 住 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8187', '10', '7', '6', '自 从 我 领 以 色 列 人 出 埃 及 直 到 今 日 ， 我 未 曾 住 过 殿 宇 ， 常 在 会 幕 和 帐 幕 中 行 走 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8188', '10', '7', '7', '凡 我 同 以 色 列 人 所 走 的 地 方 ， 我 何 曾 向 以 色 列 一 支 派 的 士 师 ， 就 是 我 吩 咐 牧 养 我 民 以 色 列 的 说 ： 你 们 为 何 不 给 我 建 造 香 柏 木 的 殿 宇 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8189', '10', '7', '8', '现 在 ， 你 要 告 诉 我 仆 人 大 卫 ， 说 万 军 之 耶 和 华 如 此 说 ： 我 从 羊 圈 中 将 你 召 来 ， 叫 你 不 再 跟 从 羊 群 ， 立 你 作 我 民 以 色 列 的 君 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8190', '10', '7', '9', '你 无 论 往 哪 里 去 ， 我 常 与 你 同 在 ， 剪 除 你 的 一 切 仇 敌 。 我 必 使 你 得 大 名 ， 好 像 世 上 大 大 有 名 的 人 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8191', '10', '7', '10', '我 必 为 我 民 以 色 列 选 定 一 个 地 方 ， 栽 培 他 们 ， 使 他 们 住 自 己 的 地 方 ， 不 再 迁 移 ； 凶 恶 之 子 也 不 像 从 前 扰 害 他 们 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8192', '10', '7', '11', '并 不 像 我 命 士 师 治 理 我 民 以 色 列 的 时 候 一 样 。 我 必 使 你 安 靖 ， 不 被 一 切 仇 敌 扰 乱 ， 并 且 我 ─ 耶 和 华 应 许 你 ， 必 为 你 建 立 家 室 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8193', '10', '7', '12', '你 寿 数 满 足 、 与 你 列 祖 同 睡 的 时 候 ， 我 必 使 你 的 後 裔 接 续 你 的 位 ； 我 也 必 坚 定 他 的 国 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8194', '10', '7', '13', '他 必 为 我 的 名 建 造 殿 宇 ； 我 必 坚 定 他 的 国 位 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8195', '10', '7', '14', '我 要 作 他 的 父 ， 他 要 作 我 的 子 ； 他 若 犯 了 罪 ， 我 必 用 人 的 杖 责 打 他 ， 用 人 的 鞭 责 罚 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8196', '10', '7', '15', '但 我 的 慈 爱 仍 不 离 开 他 ， 像 离 开 在 你 面 前 所 废 弃 的 扫 罗 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8197', '10', '7', '16', '你 的 家 和 你 的 国 必 在 我 （ 原 文 是 你 ） 面 前 永 远 坚 立 。 你 的 国 位 也 必 坚 定 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8198', '10', '7', '17', '拿 单 就 按 这 一 切 话 ， 照 这 默 示 ， 告 诉 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8199', '10', '7', '18', '於 是 大 卫 王 进 去 ， 坐 在 耶 和 华 面 前 ， 说 ： 主 耶 和 华 啊 ， 我 是 谁 ？ 我 的 家 算 甚 麽 ？ 你 竟 使 我 到 这 地 步 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8200', '10', '7', '19', '主 耶 和 华 啊 ， 这 在 你 眼 中 还 看 为 小 ， 又 应 许 你 仆 人 的 家 至 於 久 远 。 主 耶 和 华 啊 ， 这 岂 是 人 所 常 遇 的 事 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8201', '10', '7', '20', '主 耶 和 华 啊 ， 我 还 有 何 言 可 以 对 你 说 呢 ？ 因 为 你 知 道 你 的 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8202', '10', '7', '21', '你 行 这 大 事 使 仆 人 知 道 ， 是 因 你 所 应 许 的 话 ， 也 是 照 你 的 心 意 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8203', '10', '7', '22', '主 耶 和 华 啊 ， 你 本 为 大 ， 照 我 们 耳 中 听 见 ， 没 有 可 比 你 的 ； 除 你 以 外 再 无 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8204', '10', '7', '23', '世 上 有 何 民 能 比 你 的 民 以 色 列 呢 ？ 你 从 埃 及 救 赎 他 们 作 自 己 的 子 民 ， 又 在 你 赎 出 来 的 民 面 前 行 大 而 可 畏 的 事 ， 驱 逐 列 邦 人 和 他 们 的 　 神 ， 显 出 你 的 大 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8205', '10', '7', '24', '你 曾 坚 立 你 的 民 以 色 列 作 你 的 子 民 ， 直 到 永 远 ； 你 ─ 耶 和 华 也 作 了 他 们 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8206', '10', '7', '25', '耶 和 华 　 神 啊 ， 你 所 应 许 仆 人 和 仆 人 家 的 话 ， 求 你 坚 定 ， 直 到 永 远 ； 照 你 所 说 的 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8207', '10', '7', '26', '愿 人 永 远 尊 你 的 名 为 大 ， 说 ： 万 军 之 耶 和 华 是 治 理 以 色 列 的 　 神 。 这 样 ， 你 仆 人 大 卫 的 家 必 在 你 面 前 坚 立 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8208', '10', '7', '27', '万 军 之 耶 和 华 ─ 以 色 列 的 　 神 啊 ， 因 你 启 示 你 的 仆 人 说 ： 我 必 为 你 建 立 家 室 ， 所 以 仆 人 大 胆 向 你 如 此 祈 祷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8209', '10', '7', '28', '主 耶 和 华 啊 ， 惟 有 你 是 　 神 。 你 的 话 是 真 实 的 ； 你 也 应 许 将 这 福 气 赐 给 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8210', '10', '7', '29', '现 在 求 你 赐 福 与 仆 人 的 家 ， 可 以 永 存 在 你 面 前 。 主 耶 和 华 啊 ， 这 是 你 所 应 许 的 。 愿 你 永 远 赐 福 与 仆 人 的 家 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8211', '10', '8', '1', '此 後 ， 大 卫 攻 打 非 利 士 人 ， 把 他 们 治 服 ， 从 他 们 手 下 夺 取 了 京 城 的 权 柄 （ 原 文 是 母 城 的 嚼 环 ） ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8212', '10', '8', '2', '又 攻 打 摩 押 人 ， 使 他 们 躺 卧 在 地 上 ， 用 绳 量 一 量 ： 量 二 绳 的 杀 了 ， 量 一 绳 的 存 留 。 摩 押 人 就 归 服 大 卫 ， 给 他 进 贡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8213', '10', '8', '3', '琐 巴 王 利 合 的 儿 子 哈 大 底 谢 往 大 河 去 ， 要 夺 回 他 的 国 权 。 大 卫 就 攻 打 他 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8214', '10', '8', '4', '擒 拿 了 他 的 马 兵 一 千 七 百 ， 步 兵 二 万 ， 将 拉 战 车 的 马 砍 断 蹄 筋 ， 但 留 下 一 百 辆 车 . 的 马 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8215', '10', '8', '5', '大 马 色 的 亚 兰 人 来 帮 助 琐 巴 王 哈 大 底 谢 ， 大 卫 就 杀 了 亚 兰 人 二 万 二 千 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8216', '10', '8', '6', '於 是 大 卫 在 大 马 色 的 亚 兰 地 设 立 防 营 ， 亚 兰 人 就 归 服 他 ， 给 他 进 贡 。 大 卫 无 论 往 哪 里 去 ， 耶 和 华 都 使 他 得 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8217', '10', '8', '7', '他 夺 了 哈 大 底 谢 臣 仆 所 拿 的 金 盾 牌 ， 带 到 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8218', '10', '8', '8', '大 卫 王 又 从 属 哈 大 底 谢 的 比 他 和 比 罗 他 城 中 夺 取 了 许 多 的 铜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8219', '10', '8', '9', '哈 马 王 陀 以 听 见 大 卫 杀 败 哈 大 底 谢 的 全 军 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8220', '10', '8', '10', '就 打 发 他 儿 子 约 兰 去 见 大 卫 王 ， 问 他 的 安 ， 为 他 祝 福 ， 因 为 他 杀 败 了 哈 大 底 谢 （ 原 来 陀 以 与 哈 大 底 谢 常 常 争 战 ） 。 约 兰 带 了 金 银 铜 的 器 皿 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8221', '10', '8', '11', '大 卫 王 将 这 些 器 皿 和 他 治 服 各 国 所 得 来 的 金 银 都 分 别 为 圣 ， 献 给 耶 和 华 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8222', '10', '8', '12', '就 是 从 亚 兰 、 摩 押 、 亚 扪 、 非 利 士 、 亚 玛 力 人 所 得 来 的 ， 以 及 从 琐 巴 王 利 合 的 儿 子 哈 大 底 谢 所 掠 之 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8223', '10', '8', '13', '大 卫 在 盐 谷 击 杀 了 亚 兰 （ 或 译 ： 以 东 ， 见 诗 篇 六 十 篇 诗 题 ） 一 万 八 千 人 回 来 ， 就 得 了 大 名 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8224', '10', '8', '14', '又 在 以 东 全 地 设 立 防 营 ， 以 东 人 就 都 归 服 大 卫 。 大 卫 无 论 往 哪 里 去 ， 耶 和 华 都 使 他 得 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8225', '10', '8', '15', '大 卫 作 以 色 列 众 人 的 王 ， 又 向 众 民 秉 公 行 义 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8226', '10', '8', '16', '洗 鲁 雅 的 儿 子 约 押 作 元 帅 ； 亚 希 律 的 儿 子 约 沙 法 作 史 官 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8227', '10', '8', '17', '亚 希 突 的 儿 子 撒 督 和 亚 比 亚 他 的 儿 子 亚 希 米 勒 作 祭 司 长 ； 西 莱 雅 作 书 记 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8228', '10', '8', '18', '耶 何 耶 大 的 儿 子 比 拿 雅 统 辖 基 利 提 人 和 比 利 提 人 。 大 卫 的 众 子 都 作 领 袖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8229', '10', '9', '1', '大 卫 问 说 ： 扫 罗 家 还 有 剩 下 的 人 没 有 ？ 我 要 因 约 拿 单 的 缘 故 向 他 施 恩 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8230', '10', '9', '2', '扫 罗 家 有 一 个 仆 人 ， 名 叫 洗 巴 ， 有 人 叫 他 来 见 大 卫 ， 王 问 他 说 ： 你 是 洗 巴 麽 。 回 答 说 ： 仆 人 是 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8231', '10', '9', '3', '王 说 ： 扫 罗 家 还 有 人 没 有 ？ 我 要 照 　 神 的 慈 爱 恩 待 他 。 洗 巴 对 王 说 ： 还 有 约 拿 单 的 一 个 儿 子 ， 是 瘸 腿 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8232', '10', '9', '4', '王 说 ： 他 在 哪 里 ？ 洗 巴 对 王 说 ： 他 在 罗 底 巴 ， 亚 米 利 的 儿 子 玛 吉 家 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8233', '10', '9', '5', '於 是 大 卫 王 打 发 人 去 ， 从 罗 底 巴 亚 米 利 的 儿 子 玛 吉 家 里 召 了 他 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8234', '10', '9', '6', '扫 罗 的 孙 子 、 约 拿 单 的 儿 子 米 非 波 设 来 见 大 卫 ， 伏 地 叩 拜 。 大 卫 说 ： 米 非 波 设 ！ 米 非 波 设 说 ： 仆 人 在 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8235', '10', '9', '7', '大 卫 说 ： 你 不 要 惧 怕 ， 我 必 因 你 父 亲 约 拿 单 的 缘 故 施 恩 与 你 ， 将 你 祖 父 扫 罗 的 一 切 田 地 都 归 还 你 ； 你 也 可 以 常 与 我 同 席 吃 饭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8236', '10', '9', '8', '米 非 波 设 又 叩 拜 ， 说 ： 仆 人 算 甚 麽 ， 不 过 如 死 狗 一 般 ， 竟 蒙 王 这 样 眷 顾 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8237', '10', '9', '9', '王 召 了 扫 罗 的 仆 人 洗 巴 来 ， 对 他 说 ： 我 已 将 属 扫 罗 和 他 的 一 切 家 产 都 赐 给 你 主 人 的 儿 子 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8238', '10', '9', '10', '你 和 你 的 众 子 、 仆 人 要 为 你 主 人 的 儿 子 米 非 波 设 耕 种 田 地 ， 把 所 产 的 拿 来 供 他 食 用 ； 他 却 要 常 与 我 同 席 吃 饭 。 洗 巴 有 十 五 个 儿 子 ， 二 十 个 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8239', '10', '9', '11', '洗 巴 对 王 说 ： 凡 我 主 我 王 吩 咐 仆 人 的 ， 仆 人 都 必 遵 行 。 王 又 说 ： 米 非 波 设 必 与 我 同 席 吃 饭 ， 如 王 的 儿 子 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8240', '10', '9', '12', '米 非 波 设 有 一 个 小 儿 子 ， 名 叫 米 迦 。 凡 住 在 洗 巴 家 里 的 人 都 作 了 米 非 波 设 的 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8241', '10', '9', '13', '於 是 米 非 波 设 住 在 耶 路 撒 冷 ， 常 与 王 同 席 吃 饭 。 他 两 腿 都 是 瘸 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8242', '10', '10', '1', '此 後 ， 亚 扪 人 的 王 死 了 ， 他 儿 子 哈 嫩 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8243', '10', '10', '2', '大 卫 说 ： 我 要 照 哈 嫩 的 父 亲 拿 辖 厚 待 我 的 恩 典 厚 待 哈 嫩 。 於 是 大 卫 差 遣 臣 仆 ， 为 他 丧 父 安 慰 他 。 大 卫 的 臣 仆 到 了 亚 扪 人 的 境 内 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8244', '10', '10', '3', '但 亚 扪 人 的 首 领 对 他 们 的 主 哈 嫩 说 ： 大 卫 差 人 来 安 慰 你 ， 你 想 他 是 尊 敬 你 父 亲 麽 ？ 他 差 臣 仆 来 不 是 详 察 窥 探 、 要 倾 覆 这 城 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8245', '10', '10', '4', '哈 嫩 便 将 大 卫 臣 仆 的 胡 须 剃 去 一 半 ， 又 割 断 他 们 下 半 截 的 衣 服 ， 使 他 们 露 出 下 体 ， 打 发 他 们 回 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8246', '10', '10', '5', '有 人 告 诉 大 卫 ， 他 就 差 人 去 迎 接 他 们 ， （ 因 为 他 们 甚 觉 羞 耻 ） ， 告 诉 他 们 说 ： 可 以 住 在 耶 利 哥 ， 等 到 胡 须 长 起 再 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8247', '10', '10', '6', '亚 扪 人 知 道 大 卫 憎 恶 他 们 ， 就 打 发 人 去 ， 招 募 伯 利 合 的 亚 兰 人 和 琐 巴 的 亚 兰 人 ， 步 兵 二 万 ， 与 玛 迦 王 的 人 一 千 、 陀 伯 人 一 万 二 千 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8248', '10', '10', '7', '大 卫 听 见 了 ， 就 差 派 约 押 统 带 勇 猛 的 全 军 出 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8249', '10', '10', '8', '亚 扪 人 出 来 ， 在 城 门 前 摆 阵 ； 琐 巴 与 利 合 的 亚 兰 人 、 陀 伯 人 ， 并 玛 迦 人 ， 另 在 郊 野 摆 阵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8250', '10', '10', '9', '约 押 看 见 敌 人 在 他 前 後 摆 阵 ， 就 从 以 色 列 军 中 挑 选 精 兵 ， 使 他 们 对 着 亚 兰 人 摆 阵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8251', '10', '10', '10', '其 馀 的 兵 交 与 他 兄 弟 亚 比 筛 ， 对 着 亚 扪 人 摆 阵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8252', '10', '10', '11', '约 押 对 亚 比 筛 说 ： 亚 兰 人 若 强 过 我 ， 你 就 来 帮 助 我 ； 亚 扪 人 若 强 过 你 ， 我 就 去 帮 助 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8253', '10', '10', '12', '我 们 都 当 刚 强 ， 为 本 国 的 民 和 　 神 的 城 邑 作 大 丈 夫 。 愿 耶 和 华 凭 他 的 意 旨 而 行 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8254', '10', '10', '13', '於 是 ， 约 押 和 跟 随 他 的 人 前 进 攻 打 亚 兰 人 ； 亚 兰 人 在 约 押 面 前 逃 跑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8255', '10', '10', '14', '亚 扪 人 见 亚 兰 人 逃 跑 ， 他 们 也 在 亚 比 筛 面 前 逃 跑 进 城 。 约 押 就 离 开 亚 扪 人 那 里 ， 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8256', '10', '10', '15', '亚 兰 人 见 自 己 被 以 色 列 人 打 败 ， 就 又 聚 集 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8257', '10', '10', '16', '哈 大 底 谢 差 遣 人 ， 将 大 河 那 边 的 亚 兰 人 调 来 ； 他 们 到 了 希 兰 ， 哈 大 底 谢 的 将 军 朔 法 率 领 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8258', '10', '10', '17', '有 人 告 诉 大 卫 ， 他 就 聚 集 以 色 列 众 人 ， 过 约 但 河 ， 来 到 希 兰 。 亚 兰 人 迎 着 大 卫 摆 阵 ， 与 他 打 仗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8259', '10', '10', '18', '亚 兰 人 在 以 色 列 人 面 前 逃 跑 ； 大 卫 杀 了 亚 兰 七 百 辆 战 车 的 人 ， 四 万 马 兵 ， 又 杀 了 亚 兰 的 将 军 朔 法 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8260', '10', '10', '19', '属 哈 大 底 谢 的 诸 王 见 自 己 被 以 色 列 人 打 败 ， 就 与 以 色 列 人 和 好 ， 归 服 他 们 。 於 是 亚 兰 人 不 敢 再 帮 助 亚 扪 人 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8261', '10', '11', '1', '过 了 一 年 ， 到 列 王 出 战 的 时 候 ， 大 卫 又 差 派 约 押 ， 率 领 臣 仆 和 以 色 列 众 人 出 战 。 他 们 就 打 败 亚 扪 人 ， 围 攻 拉 巴 。 大 卫 仍 住 在 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8262', '10', '11', '2', '一 日 ， 太 阳 平 西 ， 大 卫 从 床 上 起 来 ， 在 王 宫 的 平 顶 上 游 行 ， 看 见 一 个 妇 人 沐 浴 ， 容 貌 甚 美 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8263', '10', '11', '3', '大 卫 就 差 人 打 听 那 妇 人 是 谁 。 有 人 说 ： 他 是 以 连 的 女 儿 ， 赫 人 乌 利 亚 的 妻 拔 示 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8264', '10', '11', '4', '大 卫 差 人 去 ， 将 妇 人 接 来 ； 那 时 他 的 月 经 才 得 洁 净 。 他 来 了 ， 大 卫 与 他 同 房 ， 他 就 回 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8265', '10', '11', '5', '於 是 他 怀 了 孕 ， 打 发 人 去 告 诉 大 卫 说 ： 我 怀 了 孕 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8266', '10', '11', '6', '大 卫 差 人 到 约 押 那 里 ， 说 ： 你 打 发 赫 人 乌 利 亚 到 我 这 里 来 。 约 押 就 打 发 乌 利 亚 去 见 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8267', '10', '11', '7', '乌 利 亚 来 了 ， 大 卫 问 约 押 好 ， 也 问 兵 好 ， 又 问 争 战 的 事 怎 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8268', '10', '11', '8', '大 卫 对 乌 利 亚 说 ： 你 回 家 去 ， 洗 洗 脚 罢 ！ 乌 利 亚 出 了 王 宫 ， 随 後 王 送 他 一 分 食 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8269', '10', '11', '9', '乌 利 亚 却 和 他 主 人 的 仆 人 一 同 睡 在 宫 门 外 ， 没 有 回 家 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8270', '10', '11', '10', '有 人 告 诉 大 卫 说 ： 乌 利 亚 没 有 回 家 去 。 大 卫 就 问 乌 利 亚 说 ： 你 从 远 路 上 来 ， 为 甚 麽 不 回 家 去 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8271', '10', '11', '11', '乌 利 亚 对 大 卫 说 ： 约 柜 和 以 色 列 与 犹 大 兵 都 住 在 棚 里 ， 我 主 约 押 和 我 主 （ 或 译 ： 王 ） 的 仆 人 都 在 田 野 安 营 ， 我 岂 可 回 家 吃 喝 、 与 妻 子 同 寝 呢 ？ 我 敢 在 王 面 前 起 誓 （ 原 文 是 我 指 着 王 和 王 的 性 命 起 誓 ） ： 我 决 不 行 这 事 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8272', '10', '11', '12', '大 卫 吩 咐 乌 利 亚 说 ： 你 今 日 仍 住 在 这 里 ， 明 日 我 打 发 你 去 。 於 是 乌 利 亚 那 日 和 次 日 住 在 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8273', '10', '11', '13', '大 卫 召 了 乌 利 亚 来 ， 叫 他 在 自 己 面 前 吃 喝 ， 使 他 喝 醉 。 到 了 晚 上 ， 乌 利 亚 出 去 与 他 主 的 仆 人 一 同 住 宿 ， 还 没 有 回 到 家 里 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8274', '10', '11', '14', '次 日 早 晨 ， 大 卫 写 信 与 约 押 ， 交 乌 利 亚 随 手 带 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8275', '10', '11', '15', '信 内 写 着 说 ： 要 派 乌 利 亚 前 进 ， 到 阵 势 极 险 之 处 ， 你 们 便 退 後 ， 使 他 被 杀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8276', '10', '11', '16', '约 押 围 城 的 时 候 ， 知 道 敌 人 那 里 有 勇 士 ， 便 将 乌 利 亚 派 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8277', '10', '11', '17', '城 里 的 人 出 来 和 约 押 打 仗 ； 大 卫 的 仆 人 中 有 几 个 被 杀 的 ， 赫 人 乌 利 亚 也 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8278', '10', '11', '18', '於 是 ， 约 押 差 人 去 将 争 战 的 一 切 事 告 诉 大 卫 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8279', '10', '11', '19', '又 嘱 咐 使 者 说 ： 你 把 争 战 的 一 切 事 对 王 说 完 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8280', '10', '11', '20', '王 若 发 怒 ， 问 你 说 ： 你 们 打 仗 为 甚 麽 挨 近 城 墙 呢 ？ 岂 不 知 敌 人 必 从 城 上 射 箭 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8281', '10', '11', '21', '从 前 打 死 耶 路 比 设 （ 就 是 耶 路 巴 力 ， 见 士 师 记 九 章 一 节 ） 儿 子 亚 比 米 勒 的 是 谁 呢 ？ 岂 不 是 一 个 妇 人 从 城 上 抛 下 一 块 上 磨 石 来 ， 打 在 他 身 上 ， 他 就 死 在 提 备 斯 麽 ？ 你 们 为 甚 麽 挨 近 城 墙 呢 ？ 你 就 说 ： 王 的 仆 人 ─ 赫 人 乌 利 亚 也 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8282', '10', '11', '22', '使 者 起 身 ， 来 见 大 卫 ， 照 着 约 押 所 吩 咐 他 的 话 奏 告 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8283', '10', '11', '23', '使 者 对 大 卫 说 ： 敌 人 强 过 我 们 ， 出 到 郊 野 与 我 们 打 仗 ， 我 们 追 杀 他 们 ， 直 到 城 门 口 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8284', '10', '11', '24', '射 箭 的 从 城 上 射 王 的 仆 人 ， 射 死 几 个 ， 赫 人 乌 利 亚 也 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8285', '10', '11', '25', '王 向 使 者 说 ： 你 告 诉 约 押 说 ： 不 要 因 这 事 愁 闷 ， 刀 剑 或 吞 灭 这 人 或 吞 灭 那 人 ， 没 有 一 定 的 ； 你 只 管 竭 力 攻 城 ， 将 城 倾 覆 。 可 以 用 这 话 勉 励 约 押 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8286', '10', '11', '26', '乌 利 亚 的 妻 听 见 丈 夫 乌 利 亚 死 了 ， 就 为 他 哀 哭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8287', '10', '11', '27', '哀 哭 的 日 子 过 了 ， 大 卫 差 人 将 他 接 到 宫 里 ， 他 就 作 了 大 卫 的 妻 ， 给 大 卫 生 了 一 个 儿 子 。 但 大 卫 所 行 的 这 事 ， 耶 和 华 甚 不 喜 悦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8288', '10', '12', '1', '耶 和 华 差 遣 拿 单 去 见 大 卫 。 拿 单 到 了 大 卫 那 里 ， 对 他 说 ： 在 一 座 城 里 有 两 个 人 ： 一 个 是 富 户 ， 一 个 是 穷 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8289', '10', '12', '2', '富 户 有 许 多 牛 群 羊 群 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8290', '10', '12', '3', '穷 人 除 了 所 买 来 养 活 的 一 只 小 母 羊 羔 之 外 ， 别 无 所 有 。 羊 羔 在 他 家 里 和 他 儿 女 一 同 长 大 ， 吃 他 所 吃 的 ， 喝 他 所 喝 的 ， 睡 在 他 怀 中 ， 在 他 看 来 如 同 女 儿 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8291', '10', '12', '4', '有 一 客 人 来 到 这 富 户 家 里 ； 富 户 舍 不 得 从 自 己 的 牛 群 羊 群 中 取 一 只 预 备 给 客 人 吃 ， 却 取 了 那 穷 人 的 羊 羔 ， 预 备 给 客 人 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8292', '10', '12', '5', '大 卫 就 甚 恼 怒 那 人 ， 对 拿 单 说 ： 我 指 着 永 生 的 耶 和 华 起 誓 ， 行 这 事 的 人 该 死 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8293', '10', '12', '6', '他 必 偿 还 羊 羔 四 倍 ； 因 为 他 行 这 事 ， 没 有 怜 恤 的 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8294', '10', '12', '7', '拿 单 对 大 卫 说 ： 你 就 是 那 人 ！ 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 我 膏 你 作 以 色 列 的 王 ， 救 你 脱 离 扫 罗 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8295', '10', '12', '8', '我 将 你 主 人 的 家 业 赐 给 你 ， 将 你 主 人 的 妻 交 在 你 怀 里 ， 又 将 以 色 列 和 犹 大 家 赐 给 你 ； 你 若 还 以 为 不 足 ， 我 早 就 加 倍 地 赐 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8296', '10', '12', '9', '你 为 甚 麽 藐 视 耶 和 华 的 命 令 ， 行 他 眼 中 看 为 恶 的 事 呢 ？ 你 借 亚 扪 人 的 刀 杀 害 赫 人 乌 利 亚 ， 又 娶 了 他 的 妻 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8297', '10', '12', '10', '你 既 藐 视 我 ， 娶 了 赫 人 乌 利 亚 的 妻 为 妻 ， 所 以 刀 剑 必 永 不 离 开 你 的 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8298', '10', '12', '11', '耶 和 华 如 此 说 ： 我 必 从 你 家 中 兴 起 祸 患 攻 击 你 ； 我 必 在 你 眼 前 把 你 的 妃 嫔 赐 给 别 人 ， 他 在 日 光 之 下 就 与 他 们 同 寝 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8299', '10', '12', '12', '你 在 暗 中 行 这 事 ， 我 却 要 在 以 色 列 众 人 面 前 ， 日 光 之 下 ， 报 应 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8300', '10', '12', '13', '大 卫 对 拿 单 说 ： 我 得 罪 耶 和 华 了 ！ 拿 单 说 ： 耶 和 华 已 经 除 掉 你 的 罪 ， 你 必 不 至 於 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8301', '10', '12', '14', '只 是 你 行 这 事 ， 叫 耶 和 华 的 仇 敌 大 得 亵 渎 的 机 会 ， 故 此 ， 你 所 得 的 孩 子 必 定 要 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8302', '10', '12', '15', '拿 单 就 回 家 去 了 。 耶 和 华 击 打 乌 利 亚 妻 给 大 卫 所 生 的 孩 子 ， 使 他 得 重 病 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8303', '10', '12', '16', '所 以 大 卫 为 这 孩 子 恳 求 　 神 ， 而 且 禁 食 ， 进 入 内 室 ， 终 夜 躺 在 地 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8304', '10', '12', '17', '他 家 中 的 老 臣 来 到 他 旁 边 ， 要 把 他 从 地 上 扶 起 来 ， 他 却 不 肯 起 来 ， 也 不 同 他 们 吃 饭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8305', '10', '12', '18', '到 第 七 日 ， 孩 子 死 了 。 大 卫 的 臣 仆 不 敢 告 诉 他 孩 子 死 了 ， 因 他 们 说 ： 孩 子 还 活 着 的 时 候 ， 我 们 劝 他 ， 他 尚 且 不 肯 听 我 们 的 话 ， 若 告 诉 他 孩 子 死 了 ， 岂 不 更 加 忧 伤 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8306', '10', '12', '19', '大 卫 见 臣 仆 彼 此 低 声 说 话 ， 就 知 道 孩 子 死 了 ， 问 臣 仆 说 ： 孩 子 死 了 麽 ？ 他 们 说 ： 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8307', '10', '12', '20', '大 卫 就 从 地 上 起 来 ， 沐 浴 ， 抹 膏 ， 换 了 衣 裳 ， 进 耶 和 华 的 殿 敬 拜 ； 然 後 回 宫 ， 吩 咐 人 摆 饭 ， 他 便 吃 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8308', '10', '12', '21', '臣 仆 问 他 说 ： 你 所 行 的 是 甚 麽 意 思 ？ 孩 子 活 着 的 时 候 ， 你 禁 食 哭 泣 ； 孩 子 死 了 ， 你 倒 起 来 吃 饭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8309', '10', '12', '22', '大 卫 说 ： 孩 子 还 活 着 ， 我 禁 食 哭 泣 ； 因 为 我 想 ， 或 者 耶 和 华 怜 恤 我 ， 使 孩 子 不 死 也 未 可 知 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8310', '10', '12', '23', '孩 子 死 了 ， 我 何 必 禁 食 ， 我 岂 能 使 他 返 回 呢 ？ 我 必 往 他 那 里 去 ， 他 却 不 能 回 我 这 里 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8311', '10', '12', '24', '大 卫 安 慰 他 的 妻 拔 示 巴 ， 与 他 同 寝 ， 他 就 生 了 儿 子 ， 给 他 起 名 叫 所 罗 门 。 耶 和 华 也 喜 爱 他 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8312', '10', '12', '25', '就 藉 先 知 拿 单 赐 他 一 个 名 字 ， 叫 耶 底 底 亚 ， 因 为 耶 和 华 爱 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8313', '10', '12', '26', '约 押 攻 取 亚 扪 人 的 京 城 拉 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8314', '10', '12', '27', '约 押 打 发 使 者 去 见 大 卫 ， 说 ： 我 攻 打 拉 巴 ， 取 其 水 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8315', '10', '12', '28', '现 在 你 要 聚 集 其 馀 的 军 兵 来 ， 安 营 围 攻 这 城 ， 恐 怕 我 取 了 这 城 ， 人 就 以 我 的 名 叫 这 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8316', '10', '12', '29', '於 是 大 卫 聚 集 众 军 ， 往 拉 巴 去 攻 城 ， 就 取 了 这 城 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8317', '10', '12', '30', '夺 了 亚 扪 人 之 王 所 戴 的 金 冠 冕 （ 王 ： 或 译 玛 勒 堪 ； 玛 勒 堪 就 是 米 勒 公 ， 又 名 摩 洛 ， 亚 扪 族 之 神 名 ） ， 其 上 的 金 子 重 一 他 连 得 ， 又 嵌 着 宝 石 。 人 将 这 冠 冕 戴 在 大 卫 头 上 。 大 卫 从 城 里 夺 了 许 多 财 物 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8318', '10', '12', '31', '将 城 里 的 人 拉 出 来 ， 放 在 锯 下 ， 或 铁 耙 下 ， 或 铁 斧 下 ， 或 叫 他 经 过 砖 窑 （ 或 译 ： 强 他 们 用 锯 ， 或 用 打 粮 食 的 铁 器 ， 或 用 铁 斧 做 工 ， 或 使 在 砖 窑 里 服 役 ） ； 大 卫 待 亚 扪 各 城 的 居 民 都 是 如 此 。 其 後 ， 大 卫 和 众 军 都 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8319', '10', '13', '1', '大 卫 的 儿 子 押 沙 龙 有 一 个 美 貌 的 妹 子 ， 名 叫 他 玛 。 大 卫 的 儿 子 暗 嫩 爱 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8320', '10', '13', '2', '暗 嫩 为 他 妹 子 他 玛 忧 急 成 病 。 他 玛 还 是 处 女 ， 暗 嫩 以 为 难 向 他 行 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8321', '10', '13', '3', '暗 嫩 有 一 个 朋 友 ， 名 叫 约 拿 达 ， 是 大 卫 长 兄 示 米 亚 的 儿 子 。 这 约 拿 达 为 人 极 其 狡 猾 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8322', '10', '13', '4', '他 问 暗 嫩 说 ： 王 的 儿 子 啊 ， 为 何 一 天 比 一 天 瘦 弱 呢 ？ 请 你 告 诉 我 。 暗 嫩 回 答 说 ： 我 爱 我 兄 弟 押 沙 龙 的 妹 子 他 玛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8323', '10', '13', '5', '约 拿 达 说 ： 你 不 如 躺 在 床 上 装 病 ； 你 父 亲 来 看 你 ， 就 对 他 说 ： 求 父 叫 我 妹 子 他 玛 来 ， 在 我 眼 前 预 备 食 物 ， 递 给 我 吃 ， 使 我 看 见 ， 好 从 他 手 里 接 过 来 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8324', '10', '13', '6', '於 是 暗 嫩 躺 卧 装 病 。 王 来 看 他 ， 他 对 王 说 ： 求 父 叫 我 妹 子 他 玛 来 ， 在 我 眼 前 为 我 做 两 个 饼 ， 我 好 从 他 手 里 接 过 来 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8325', '10', '13', '7', '大 卫 就 打 发 人 到 宫 里 ， 对 他 玛 说 ： 你 往 你 哥 哥 暗 嫩 的 屋 里 去 ， 为 他 预 备 食 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8326', '10', '13', '8', '他 玛 就 到 他 哥 哥 暗 嫩 的 屋 里 ； 暗 嫩 正 躺 卧 。 他 玛 抟 面 ， 在 他 眼 前 做 饼 ， 且 烤 熟 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8327', '10', '13', '9', '在 他 面 前 将 饼 从 锅 里 倒 出 来 ， 他 却 不 肯 吃 ， 便 说 ： 众 人 离 开 我 出 去 罢 ！ 众 人 就 都 离 开 他 ， 出 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8328', '10', '13', '10', '暗 嫩 对 他 玛 说 ： 你 把 食 物 拿 进 卧 房 ， 我 好 从 你 手 里 接 过 来 吃 。 他 玛 就 把 所 做 的 饼 拿 进 卧 房 ， 到 他 哥 哥 暗 嫩 那 里 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8329', '10', '13', '11', '拿 着 饼 上 前 给 他 吃 ， 他 便 拉 住 他 玛 ， 说 ： 我 妹 妹 ， 你 来 与 我 同 寝 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8330', '10', '13', '12', '他 玛 说 ： 我 哥 哥 ， 不 要 玷 辱 我 。 以 色 列 人 中 不 当 这 样 行 ， 你 不 要 做 这 丑 事 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8331', '10', '13', '13', '你 玷 辱 了 我 ， 我 何 以 掩 盖 我 的 羞 耻 呢 ？ 你 在 以 色 列 中 也 成 了 愚 妄 人 。 你 可 以 求 王 ， 他 必 不 禁 止 我 归 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8332', '10', '13', '14', '但 暗 嫩 不 肯 听 他 的 话 ， 因 比 他 力 大 ， 就 玷 辱 他 ， 与 他 同 寝 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8333', '10', '13', '15', '随 後 ， 暗 嫩 极 其 恨 他 ， 那 恨 他 的 心 比 先 前 爱 他 的 心 更 甚 ， 对 他 说 ： 你 起 来 ， 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8334', '10', '13', '16', '他 玛 说 ： 不 要 这 样 ！ 你 赶 出 我 去 的 这 罪 比 你 才 行 的 更 重 ！ 但 暗 嫩 不 肯 听 他 的 话 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8335', '10', '13', '17', '就 叫 伺 候 自 己 的 仆 人 来 ， 说 ： 将 这 个 女 子 赶 出 去 ！ 他 一 出 去 ， 你 就 关 门 ， 上 闩 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8336', '10', '13', '18', '那 时 他 玛 穿 着 彩 衣 ， 因 为 没 有 出 嫁 的 公 主 都 是 这 样 穿 。 暗 嫩 的 仆 人 就 把 他 赶 出 去 ， 关 门 上 闩 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8337', '10', '13', '19', '他 玛 把 灰 尘 撒 在 头 上 ， 撕 裂 所 穿 的 彩 衣 ， 以 手 抱 头 ， 一 面 行 走 ， 一 面 哭 喊 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8338', '10', '13', '20', '他 胞 兄 押 沙 龙 问 他 说 ： 莫 非 你 哥 哥 暗 嫩 与 你 亲 近 了 麽 ？ 我 妹 妹 ， 暂 且 不 要 作 声 ， 他 是 你 的 哥 哥 ， 不 要 将 这 事 放 在 心 上 。 他 玛 就 孤 孤 单 单 地 住 在 他 胞 兄 押 沙 龙 家 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8339', '10', '13', '21', '大 卫 王 听 见 这 事 ， 就 甚 发 怒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8340', '10', '13', '22', '押 沙 龙 并 不 和 他 哥 哥 暗 嫩 说 好 说 歹 ； 因 为 暗 嫩 玷 辱 他 妹 妹 他 玛 ， 所 以 押 沙 龙 恨 恶 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8341', '10', '13', '23', '过 了 二 年 ， 在 靠 近 以 法 莲 的 巴 力 夏 琐 有 人 为 押 沙 龙 剪 羊 毛 ； 押 沙 龙 请 王 的 众 子 与 他 同 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8342', '10', '13', '24', '押 沙 龙 来 见 王 ， 说 ： 现 在 有 人 为 仆 人 剪 羊 毛 ， 请 王 和 王 的 臣 仆 与 仆 人 同 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8343', '10', '13', '25', '王 对 押 沙 龙 说 ： 我 儿 ， 我 们 不 必 都 去 ， 恐 怕 使 你 耗 费 太 多 。 押 沙 龙 再 三 请 王 ， 王 仍 是 不 肯 去 ， 只 为 他 祝 福 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8344', '10', '13', '26', '押 沙 龙 说 ： 王 若 不 去 ， 求 王 许 我 哥 哥 暗 嫩 同 去 。 王 说 ： 何 必 要 他 去 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8345', '10', '13', '27', '押 沙 龙 再 三 求 王 ， 王 就 许 暗 嫩 和 王 的 众 子 与 他 同 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8346', '10', '13', '28', '押 沙 龙 吩 咐 仆 人 说 ： 你 们 注 意 ， 看 暗 嫩 饮 酒 畅 快 的 时 候 ， 我 对 你 们 说 杀 暗 嫩 ， 你 们 便 杀 他 ， 不 要 惧 怕 。 这 不 是 我 吩 咐 你 们 的 麽 ？ 你 们 只 管 壮 胆 奋 勇 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8347', '10', '13', '29', '押 沙 龙 的 仆 人 就 照 押 沙 龙 所 吩 咐 的 ， 向 暗 嫩 行 了 。 王 的 众 子 都 起 来 ， 各 人 骑 上 骡 子 ， 逃 跑 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8348', '10', '13', '30', '他 们 还 在 路 上 ， 有 风 声 传 到 大 卫 那 里 ， 说 ： 押 沙 龙 将 王 的 众 子 都 杀 了 ， 没 有 留 下 一 个 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8349', '10', '13', '31', '王 就 起 来 ， 撕 裂 衣 服 ， 躺 在 地 上 。 王 的 臣 仆 也 都 撕 裂 衣 服 ， 站 在 旁 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8350', '10', '13', '32', '大 卫 的 长 兄 ， 示 米 亚 的 儿 子 约 拿 达 说 ： 我 主 ， 不 要 以 为 王 的 众 子 ─ 少 年 人 都 杀 了 ， 只 有 暗 嫩 一 个 人 死 了 。 自 从 暗 嫩 玷 辱 押 沙 龙 妹 子 他 玛 的 那 日 ， 押 沙 龙 就 定 意 杀 暗 嫩 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8351', '10', '13', '33', '现 在 ， 我 主 我 王 ， 不 要 把 这 事 放 在 心 上 ， 以 为 王 的 众 子 都 死 了 ， 只 有 暗 嫩 一 个 人 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8352', '10', '13', '34', '押 沙 龙 逃 跑 了 。 守 望 的 少 年 人 举 目 观 看 ， 见 有 许 多 人 从 山 坡 的 路 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8353', '10', '13', '35', '约 拿 达 对 王 说 ： 看 哪 ， 王 的 众 子 都 来 了 ， 果 然 与 你 仆 人 所 说 的 相 合 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8354', '10', '13', '36', '话 才 说 完 ， 王 的 众 子 都 到 了 ， 放 声 大 哭 。 王 和 臣 仆 也 都 哭 得 甚 恸 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8355', '10', '13', '37', '押 沙 龙 逃 到 基 述 王 亚 米 忽 的 儿 子 达 买 那 里 去 了 。 大 卫 天 天 为 他 儿 子 悲 哀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8356', '10', '13', '38', '押 沙 龙 逃 到 基 述 ， 在 那 里 住 了 三 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8357', '10', '13', '39', '暗 嫩 死 了 以 後 ， 大 卫 王 得 了 安 慰 ， 心 里 切 切 想 念 押 沙 龙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8358', '10', '14', '1', '洗 鲁 雅 的 儿 子 约 押 ， 知 道 王 心 里 想 念 押 沙 龙 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8359', '10', '14', '2', '就 打 发 人 往 提 哥 亚 去 ， 从 那 里 叫 了 一 个 聪 明 的 妇 人 来 ， 对 他 说 ： 请 你 假 装 居 丧 的 ， 穿 上 孝 衣 ， 不 要 用 膏 抹 身 ， 要 装 作 为 死 者 许 久 悲 哀 的 妇 人 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8360', '10', '14', '3', '进 去 见 王 ， 对 王 如 此 如 此 说 。 於 是 约 押 将 当 说 的 话 教 导 了 妇 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8361', '10', '14', '4', '提 哥 亚 妇 人 到 王 面 前 ， 伏 地 叩 拜 ， 说 ： 王 啊 ， 求 你 拯 救 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8362', '10', '14', '5', '王 问 他 说 ： 你 有 甚 麽 事 呢 ？ 回 答 说 ： 婢 女 实 在 是 寡 妇 ， 我 丈 夫 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8363', '10', '14', '6', '我 有 两 个 儿 子 ， 一 日 在 田 间 争 斗 ， 没 有 人 解 劝 ， 这 个 就 打 死 那 个 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8364', '10', '14', '7', '现 在 全 家 的 人 都 起 来 攻 击 婢 女 ， 说 ： 你 将 那 打 死 兄 弟 的 交 出 来 ， 我 们 好 治 死 他 ， 偿 他 打 死 兄 弟 的 命 ， 灭 绝 那 承 受 家 业 的 。 这 样 ， 他 们 要 将 我 剩 下 的 炭 火 灭 尽 ， 不 与 我 丈 夫 留 名 留 後 在 世 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8365', '10', '14', '8', '王 对 妇 人 说 ： 你 回 家 去 罢 ！ 我 必 为 你 下 令 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8366', '10', '14', '9', '提 哥 亚 妇 人 又 对 王 说 ： 我 主 我 王 ， 愿 这 罪 归 我 和 我 父 家 ， 与 王 和 王 的 位 无 干 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8367', '10', '14', '10', '王 说 ： 凡 难 为 你 的 ， 你 就 带 他 到 我 这 里 来 ， 他 必 不 再 搅 扰 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8368', '10', '14', '11', '妇 人 说 ： 愿 王 记 念 耶 和 华 ─ 你 的 　 神 ， 不 许 报 血 仇 的 人 施 行 灭 绝 ， 恐 怕 他 们 灭 绝 我 的 儿 子 。 王 说 ： 我 指 着 永 生 的 耶 和 华 起 誓 ： 你 的 儿 子 连 一 根 头 发 也 不 致 落 在 地 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8369', '10', '14', '12', '妇 人 说 ： 求 我 主 我 王 容 婢 女 再 说 一 句 话 。 王 说 ： 你 说 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8370', '10', '14', '13', '妇 人 说 ： 王 为 何 也 起 意 要 害 　 神 的 民 呢 ？ 王 不 使 那 逃 亡 的 人 回 来 ， 王 的 这 话 就 是 自 证 己 错 了 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8371', '10', '14', '14', '我 们 都 是 必 死 的 ， 如 同 水 泼 在 地 上 ， 不 能 收 回 。 　 神 并 不 夺 取 人 的 性 命 ， 乃 设 法 使 逃 亡 的 人 不 致 成 为 赶 出 、 回 不 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8372', '10', '14', '15', '我 来 将 这 话 告 诉 我 主 我 王 ， 是 因 百 姓 使 我 惧 怕 。 婢 女 想 ， 不 如 将 这 话 告 诉 王 ， 或 者 王 成 就 婢 女 所 求 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8373', '10', '14', '16', '人 要 将 我 和 我 儿 子 从 　 神 的 地 业 上 一 同 除 灭 ， 王 必 应 允 救 我 脱 离 他 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8374', '10', '14', '17', '婢 女 又 想 ， 我 主 我 王 的 话 必 安 慰 我 ； 因 为 我 主 我 王 能 辨 别 是 非 ， 如 同 　 神 的 使 者 一 样 。 惟 愿 耶 和 华 ─ 你 的 　 神 与 你 同 在 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8375', '10', '14', '18', '王 对 妇 人 说 ： 我 要 问 你 一 句 话 ， 你 一 点 不 要 瞒 我 。 妇 人 说 ： 愿 我 主 我 王 说 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8376', '10', '14', '19', '王 说 ： 你 这 些 话 莫 非 是 约 押 的 主 意 麽 ？ 妇 人 说 ： 我 敢 在 我 主 我 王 面 前 起 誓 ： 王 的 话 正 对 ， 不 偏 左 右 ， 是 王 的 仆 人 约 押 吩 咐 我 的 ， 这 些 话 是 他 教 导 我 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8377', '10', '14', '20', '王 的 仆 人 约 押 如 此 行 ， 为 要 挽 回 这 事 。 我 主 的 智 慧 却 如 　 神 使 者 的 智 慧 ， 能 知 世 上 一 切 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8378', '10', '14', '21', '王 对 约 押 说 ： 我 应 允 你 这 事 。 你 可 以 去 ， 把 那 少 年 人 押 沙 龙 带 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8379', '10', '14', '22', '约 押 就 面 伏 於 地 叩 拜 ， 祝 谢 於 王 ， 又 说 ： 王 既 应 允 仆 人 所 求 的 ， 仆 人 今 日 知 道 在 我 主 我 王 眼 前 蒙 恩 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8380', '10', '14', '23', '於 是 约 押 起 身 往 基 述 去 ， 将 押 沙 龙 带 回 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8381', '10', '14', '24', '王 说 ： 使 他 回 自 己 家 里 去 ， 不 要 见 我 的 面 。 押 沙 龙 就 回 自 己 家 里 去 ， 没 有 见 王 的 面 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8382', '10', '14', '25', '以 色 列 全 地 之 中 ， 无 人 像 押 沙 龙 那 样 俊 美 ， 得 人 的 称 赞 ， 从 脚 底 到 头 顶 毫 无 暇 疵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8383', '10', '14', '26', '他 的 头 发 甚 重 ， 每 到 年 底 剪 发 一 次 ； 所 剪 下 来 的 ， 按 王 的 平 称 一 称 ， 重 二 百 舍 客 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8384', '10', '14', '27', '押 沙 龙 生 了 三 个 儿 子 ， 一 个 女 儿 。 女 儿 名 叫 他 玛 ， 是 个 容 貌 俊 美 的 女 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8385', '10', '14', '28', '押 沙 龙 住 在 耶 路 撒 冷 足 有 二 年 ， 没 有 见 王 的 面 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8386', '10', '14', '29', '押 沙 龙 打 发 人 去 叫 约 押 来 ， 要 托 他 去 见 王 ， 约 押 却 不 肯 来 。 第 二 次 打 发 人 去 叫 他 ， 他 仍 不 肯 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8387', '10', '14', '30', '所 以 押 沙 龙 对 仆 人 说 ： 你 们 看 ， 约 押 有 一 块 田 ， 与 我 的 田 相 近 ， 其 中 有 大 麦 ， 你 们 去 放 火 烧 了 。 押 沙 龙 的 仆 人 就 去 放 火 烧 了 那 田 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8388', '10', '14', '31', '於 是 约 押 起 来 ， 到 了 押 沙 龙 家 里 ， 问 他 说 ： 你 的 仆 人 为 何 放 火 烧 了 我 的 田 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8389', '10', '14', '32', '押 沙 龙 回 答 约 押 说 ： 我 打 发 人 去 请 你 来 ， 好 托 你 去 见 王 ， 替 我 说 ： 我 为 何 从 基 述 回 来 呢 ？ 不 如 仍 在 那 里 。 现 在 要 许 我 见 王 的 面 ； 我 若 有 罪 ， 任 凭 王 杀 我 就 是 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8390', '10', '14', '33', '於 是 约 押 去 见 王 ， 将 这 话 奏 告 王 ， 王 便 叫 押 沙 龙 来 。 押 沙 龙 来 见 王 ， 在 王 面 前 俯 伏 於 地 ， 王 就 与 押 沙 龙 亲 嘴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8391', '10', '15', '1', '此 後 ， 押 沙 龙 为 自 己 预 备 车 马 ， 又 派 五 十 人 在 他 前 头 奔 走 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8392', '10', '15', '2', '押 沙 龙 常 常 早 晨 起 来 ， 站 在 城 门 的 道 旁 ， 凡 有 争 讼 要 去 求 王 判 断 的 ， 押 沙 龙 就 叫 他 过 来 ， 问 他 说 ： 你 是 哪 一 城 的 人 ？ 回 答 说 ： 仆 人 是 以 色 列 某 支 派 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8393', '10', '15', '3', '押 沙 龙 对 他 说 ： 你 的 事 有 情 有 理 ， 无 奈 王 没 有 委 人 听 你 伸 诉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8394', '10', '15', '4', '押 沙 龙 又 说 ： 恨 不 得 我 作 国 中 的 士 师 ！ 凡 有 争 讼 求 审 判 的 到 我 这 里 来 ， 我 必 秉 公 判 断 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8395', '10', '15', '5', '若 有 人 近 前 来 要 拜 押 沙 龙 ， 押 沙 龙 就 伸 手 拉 住 他 ， 与 他 亲 嘴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8396', '10', '15', '6', '以 色 列 人 中 ， 凡 去 见 王 求 判 断 的 ， 押 沙 龙 都 是 如 此 待 他 们 。 这 样 ， 押 沙 龙 暗 中 得 了 以 色 列 人 的 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8397', '10', '15', '7', '满 了 四 十 年 （ 有 作 四 年 的 ） ， 押 沙 龙 对 王 说 ： 求 你 准 我 往 希 伯 仑 去 ， 还 我 向 耶 和 华 所 许 的 愿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8398', '10', '15', '8', '因 为 仆 人 住 在 亚 兰 的 基 述 ， 曾 许 愿 说 ： 耶 和 华 若 使 我 再 回 耶 路 撒 冷 ， 我 必 事 奉 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8399', '10', '15', '9', '王 说 ： 你 平 平 安 安 地 去 罢 ！ 押 沙 龙 就 起 身 ， 往 希 伯 仑 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8400', '10', '15', '10', '押 沙 龙 打 发 探 子 走 遍 以 色 列 各 支 派 ， 说 ： 你 们 一 听 见 角 声 就 说 ： 押 沙 龙 在 希 伯 仑 作 王 了 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8401', '10', '15', '11', '押 沙 龙 在 耶 路 撒 冷 请 了 二 百 人 与 他 同 去 ， 都 是 诚 诚 实 实 去 的 ， 并 不 知 道 其 中 的 真 情 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8402', '10', '15', '12', '押 沙 龙 献 祭 的 时 候 ， 打 发 人 去 将 大 卫 的 谋 士 、 基 罗 人 亚 希 多 弗 从 他 本 城 请 了 来 。 於 是 叛 逆 的 势 派 甚 大 ； 因 为 随 从 押 沙 龙 的 人 民 ， 日 渐 增 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8403', '10', '15', '13', '有 人 报 告 大 卫 说 ： 以 色 列 人 的 心 都 归 向 押 沙 龙 了 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8404', '10', '15', '14', '大 卫 就 对 耶 路 撒 冷 跟 随 他 的 臣 仆 说 ： 我 们 要 起 来 逃 走 ， 不 然 都 不 能 躲 避 押 沙 龙 了 ； 要 速 速 地 去 ， 恐 怕 他 忽 然 来 到 ， 加 害 於 我 们 ， 用 刀 杀 尽 合 城 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8405', '10', '15', '15', '王 的 臣 仆 对 王 说 ： 我 主 我 王 所 定 的 ， 仆 人 都 愿 遵 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8406', '10', '15', '16', '於 是 王 带 着 全 家 的 人 出 去 了 ， 但 留 下 十 个 妃 嫔 看 守 宫 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8407', '10', '15', '17', '王 出 去 ， 众 民 都 跟 随 他 ， 到 伯 墨 哈 ， 就 住 下 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8408', '10', '15', '18', '王 的 臣 仆 都 在 他 面 前 过 去 。 基 利 提 人 、 比 利 提 人 ， 就 是 从 迦 特 跟 随 王 来 的 六 百 人 ， 也 都 在 他 面 前 过 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8409', '10', '15', '19', '王 对 迦 特 人 以 太 说 ： 你 是 外 邦 逃 来 的 人 ， 为 甚 麽 与 我 们 同 去 呢 ？ 你 可 以 回 去 与 新 王 同 住 ， 或 者 回 你 本 地 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8410', '10', '15', '20', '你 来 的 日 子 不 多 ， 我 今 日 怎 好 叫 你 与 我 们 一 同 飘 流 、 没 有 一 定 的 住 处 呢 ？ 你 不 如 带 你 的 弟 兄 回 去 罢 ！ 愿 耶 和 华 用 慈 爱 诚 实 待 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8411', '10', '15', '21', '以 太 对 王 说 ： 我 指 着 永 生 的 耶 和 华 起 誓 ， 又 敢 在 王 面 前 起 誓 ： 无 论 生 死 ， 王 在 哪 里 ， 仆 人 也 必 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8412', '10', '15', '22', '大 卫 对 以 太 说 ： 你 前 去 过 河 罢 ！ 於 是 迦 特 人 以 太 带 着 跟 随 他 的 人 和 所 有 的 妇 人 孩 子 ， 就 都 过 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8413', '10', '15', '23', '本 地 的 人 都 放 声 大 哭 。 众 民 尽 都 过 去 ， 王 也 过 了 汲 沦 溪 ； 众 民 往 旷 野 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8414', '10', '15', '24', '撒 督 和 抬 　 神 约 柜 的 利 未 人 也 一 同 来 了 ， 将 　 神 的 约 柜 放 下 。 亚 比 亚 他 上 来 ， 等 着 众 民 从 城 里 出 来 过 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8415', '10', '15', '25', '王 对 撒 督 说 ： 你 将 　 神 的 约 柜 抬 回 城 去 。 我 若 在 耶 和 华 眼 前 蒙 恩 ， 他 必 使 我 回 来 ， 再 见 约 柜 和 他 的 居 所 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8416', '10', '15', '26', '倘 若 他 说 ： 我 不 喜 悦 你 ， 看 哪 ， 我 在 这 里 ， 愿 他 凭 自 己 的 意 旨 待 我 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8417', '10', '15', '27', '王 又 对 祭 司 撒 督 说 ： 你 不 是 先 见 麽 ？ 你 可 以 安 然 回 城 ； 你 儿 子 亚 希 玛 斯 和 亚 比 亚 他 的 儿 子 约 拿 单 都 可 以 与 你 同 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8418', '10', '15', '28', '我 在 旷 野 的 渡 口 那 里 等 你 们 报 信 给 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8419', '10', '15', '29', '於 是 撒 督 和 亚 比 亚 他 将 　 神 的 约 柜 抬 回 耶 路 撒 冷 ， 他 们 就 住 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8420', '10', '15', '30', '大 卫 蒙 头 赤 脚 上 橄 榄 山 ， 一 面 上 一 面 哭 。 跟 随 他 的 人 也 都 蒙 头 哭 着 上 去 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8421', '10', '15', '31', '有 人 告 诉 大 卫 说 ： 亚 希 多 弗 也 在 叛 党 之 中 ， 随 从 押 沙 龙 。 大 卫 祷 告 说 ： 耶 和 华 啊 ， 求 你 使 亚 希 多 弗 的 计 谋 变 为 愚 拙 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8422', '10', '15', '32', '大 卫 到 了 山 顶 、 敬 拜 　 神 的 地 方 ， 见 亚 基 人 户 筛 ， 衣 服 撕 裂 ， 头 蒙 灰 尘 来 迎 接 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8423', '10', '15', '33', '大 卫 对 他 说 ： 你 若 与 我 同 去 ， 必 累 赘 我 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8424', '10', '15', '34', '你 若 回 城 去 ， 对 押 沙 龙 说 ： 王 啊 ， 我 愿 作 你 的 仆 人 ； 我 向 来 作 你 父 亲 的 仆 人 ， 现 在 我 也 照 样 作 你 的 仆 人 。 这 样 ， 你 就 可 以 为 我 破 坏 亚 希 多 弗 的 计 谋 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8425', '10', '15', '35', '祭 司 撒 督 和 亚 比 亚 他 岂 不 都 在 那 里 麽 ？ 你 在 王 宫 里 听 见 甚 麽 ， 就 要 告 诉 祭 司 撒 督 和 亚 比 亚 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8426', '10', '15', '36', '撒 督 的 儿 子 亚 希 玛 斯 ， 亚 比 亚 他 的 儿 子 约 拿 单 ， 也 都 在 那 里 。 凡 你 们 所 听 见 的 可 以 托 这 二 人 来 报 告 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8427', '10', '15', '37', '於 是 ， 大 卫 的 朋 友 户 筛 进 了 城 ； 押 沙 龙 也 进 了 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8428', '10', '16', '1', '大 卫 刚 过 山 顶 ， 见 米 非 波 设 的 仆 人 洗 巴 拉 着 备 好 了 的 两 匹 驴 ， 驴 上 驮 着 二 百 面 饼 ， 一 百 葡 萄 饼 ， 一 百 个 夏 天 的 果 饼 ， 一 皮 袋 酒 来 迎 接 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8429', '10', '16', '2', '王 问 洗 巴 说 ： 你 带 这 些 来 是 甚 麽 意 思 呢 ？ 洗 巴 说 ： 驴 是 给 王 的 家 眷 骑 的 ； 面 饼 和 夏 天 的 果 饼 是 给 少 年 人 吃 的 ； 酒 是 给 在 旷 野 疲 乏 人 喝 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8430', '10', '16', '3', '王 问 说 ： 你 主 人 的 儿 子 在 哪 里 呢 ？ 洗 巴 回 答 王 说 ： 他 仍 在 耶 路 撒 冷 ， 因 他 说 ： 以 色 列 人 今 日 必 将 我 父 的 国 归 还 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8431', '10', '16', '4', '王 对 洗 巴 说 ： 凡 属 米 非 波 设 的 都 归 你 了 。 洗 巴 说 ： 我 叩 拜 我 主 我 王 ， 愿 我 在 你 眼 前 蒙 恩 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8432', '10', '16', '5', '大 卫 王 到 了 巴 户 琳 ， 见 有 一 个 人 出 来 ， 是 扫 罗 族 基 拉 的 儿 子 ， 名 叫 示 每 。 他 一 面 走 一 面 咒 骂 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8433', '10', '16', '6', '又 拿 石 头 砍 大 卫 王 和 王 的 臣 仆 ； 众 民 和 勇 士 都 在 王 的 左 右 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8434', '10', '16', '7', '示 每 咒 骂 说 ： 你 这 流 人 血 的 坏 人 哪 ， 去 罢 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8435', '10', '16', '8', '你 流 扫 罗 全 家 的 血 ， 接 续 他 作 王 ； 耶 和 华 把 这 罪 归 在 你 身 上 ， 将 这 国 交 给 你 儿 子 押 沙 龙 。 现 在 你 自 取 其 祸 ， 因 为 你 是 流 人 血 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8436', '10', '16', '9', '洗 鲁 雅 的 儿 子 亚 比 筛 对 王 说 ： 这 死 狗 岂 可 咒 骂 我 主 我 王 呢 ？ 求 你 容 我 过 去 ， 割 下 他 的 头 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8437', '10', '16', '10', '王 说 ： 洗 鲁 雅 的 儿 子 ， 我 与 你 们 有 何 关 涉 呢 ？ 他 咒 骂 是 因 耶 和 华 吩 咐 他 说 ： 你 要 咒 骂 大 卫 。 如 此 ， 谁 敢 说 你 为 甚 麽 这 样 行 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8438', '10', '16', '11', '大 卫 又 对 亚 比 筛 和 众 臣 仆 说 ： 我 亲 生 的 儿 子 尚 且 寻 索 我 的 性 命 ， 何 况 这 便 雅 悯 人 呢 ？ 由 他 咒 骂 罢 ！ 因 为 这 是 耶 和 华 吩 咐 他 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8439', '10', '16', '12', '或 者 耶 和 华 见 我 遭 难 ， 为 我 今 日 被 这 人 咒 骂 ， 就 施 恩 与 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8440', '10', '16', '13', '於 是 大 卫 和 跟 随 他 的 人 往 前 行 走 。 示 每 在 大 卫 对 面 山 坡 ， 一 面 行 走 一 面 咒 骂 ， 又 拿 石 头 砍 他 ， 拿 土 扬 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8441', '10', '16', '14', '王 和 跟 随 他 的 众 人 疲 疲 乏 乏 地 到 了 一 个 地 方 ， 就 在 那 里 歇 息 歇 息 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8442', '10', '16', '15', '押 沙 龙 和 以 色 列 众 人 来 到 耶 路 撒 冷 ； 亚 希 多 弗 也 与 他 同 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8443', '10', '16', '16', '大 卫 的 朋 友 亚 基 人 户 筛 去 见 押 沙 龙 ， 对 他 说 ： 愿 王 万 岁 ！ 愿 王 万 岁 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8444', '10', '16', '17', '押 沙 龙 问 户 筛 说 ： 这 是 你 恩 待 朋 友 麽 ？ 为 甚 麽 不 与 你 的 朋 友 同 去 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8445', '10', '16', '18', '户 筛 对 押 沙 龙 说 ： 不 然 ， 耶 和 华 和 这 民 ， 并 以 色 列 众 人 所 拣 选 的 ， 我 必 归 顺 他 ， 与 他 同 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8446', '10', '16', '19', '再 者 ， 我 当 服 事 谁 呢 ？ 岂 不 是 前 王 的 儿 子 麽 ？ 我 怎 样 服 事 你 父 亲 ， 也 必 照 样 服 事 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8447', '10', '16', '20', '押 沙 龙 对 亚 希 多 弗 说 ： 你 们 出 个 主 意 ， 我 们 怎 样 行 才 好 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8448', '10', '16', '21', '亚 希 多 弗 对 押 沙 龙 说 ： 你 父 所 留 下 看 守 宫 殿 的 妃 嫔 ， 你 可 以 与 他 们 亲 近 。 以 色 列 众 人 听 见 你 父 亲 憎 恶 你 ， 凡 归 顺 你 人 的 手 就 更 坚 强 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8449', '10', '16', '22', '於 是 人 为 押 沙 龙 在 宫 殿 的 平 顶 上 支 搭 帐 棚 ； 押 沙 龙 在 以 色 列 众 人 眼 前 ， 与 他 父 的 妃 嫔 亲 近 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8450', '10', '16', '23', '那 时 亚 希 多 弗 所 出 的 主 意 好 像 人 问 　 神 的 话 一 样 ； 他 昔 日 给 大 卫 ， 今 日 给 押 沙 龙 所 出 的 主 意 ， 都 是 这 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8451', '10', '17', '1', '亚 希 多 弗 又 对 押 沙 龙 说 ： 求 你 准 我 挑 选 一 万 二 千 人 ， 今 夜 我 就 起 身 追 赶 大 卫 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8452', '10', '17', '2', '趁 他 疲 乏 手 软 ， 我 忽 然 追 上 他 ， 使 他 惊 惶 ； 跟 随 他 的 民 必 都 逃 跑 ， 我 就 单 杀 王 一 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8453', '10', '17', '3', '使 众 民 都 归 顺 你 。 你 所 寻 找 的 人 既 然 死 了 ， 众 民 就 如 已 经 归 顺 你 ； 这 样 ， 也 都 平 安 无 事 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8454', '10', '17', '4', '押 沙 龙 和 以 色 列 的 长 老 都 以 这 话 为 美 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8455', '10', '17', '5', '押 沙 龙 说 ： 要 召 亚 基 人 户 筛 来 ， 我 们 也 要 听 他 怎 样 说 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8456', '10', '17', '6', '户 筛 到 了 押 沙 龙 面 前 ， 押 沙 龙 向 他 说 ： 亚 希 多 弗 是 如 此 如 此 说 的 ， 我 们 照 着 他 的 话 行 可 以 不 可 以 ？ 若 不 可 ， 你 就 说 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8457', '10', '17', '7', '户 筛 对 押 沙 龙 说 ： 亚 希 多 弗 这 次 所 定 的 谋 不 善 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8458', '10', '17', '8', '户 筛 又 说 ： 你 知 道 ， 你 父 亲 和 跟 随 他 的 人 都 是 勇 士 ， 现 在 他 们 心 里 恼 怒 ， 如 同 田 野 丢 崽 子 的 母 熊 一 般 ， 而 且 你 父 亲 是 个 战 士 ， 必 不 和 民 一 同 住 宿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8459', '10', '17', '9', '他 现 今 或 藏 在 坑 中 或 在 别 处 ， 若 有 人 首 先 被 杀 ， 凡 听 见 的 必 说 ： 跟 随 押 沙 龙 的 民 被 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8460', '10', '17', '10', '虽 有 人 胆 大 如 狮 子 ， 他 的 心 也 必 消 化 ； 因 为 以 色 列 人 都 知 道 你 父 亲 是 英 雄 ， 跟 随 他 的 人 也 都 是 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8461', '10', '17', '11', '依 我 之 计 ， 不 如 将 以 色 列 众 人 ─ 从 但 直 到 别 是 巴 ， 如 同 海 边 的 沙 那 样 多 ─ 聚 集 到 你 这 里 来 ， 你 也 亲 自 率 领 他 们 出 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8462', '10', '17', '12', '这 样 ， 我 们 在 何 处 遇 见 他 ， 就 下 到 他 那 里 ， 如 同 露 水 下 在 地 上 一 般 ， 连 他 带 跟 随 他 的 人 ， 一 个 也 不 留 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8463', '10', '17', '13', '他 若 进 了 哪 一 座 城 ， 以 色 列 众 人 必 带 绳 子 去 ， 将 那 城 拉 到 河 里 ， 甚 至 连 一 块 小 石 头 都 不 剩 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8464', '10', '17', '14', '押 沙 龙 和 以 色 列 众 人 说 ： 亚 基 人 户 筛 的 计 谋 比 亚 希 多 弗 的 计 谋 更 好 ！ 这 是 因 耶 和 华 定 意 破 坏 亚 希 多 弗 的 良 谋 ， 为 要 降 祸 与 押 沙 龙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8465', '10', '17', '15', '户 筛 对 祭 司 撒 督 和 亚 比 亚 他 说 ： 亚 希 多 弗 为 押 沙 龙 和 以 色 列 的 长 老 所 定 的 计 谋 是 如 此 如 此 ， 我 所 定 的 计 谋 是 如 此 如 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8466', '10', '17', '16', '现 在 你 们 要 急 速 打 发 人 去 ， 告 诉 大 卫 说 ： 今 夜 不 可 住 在 旷 野 的 渡 口 ， 务 要 过 河 ， 免 得 王 和 跟 随 他 的 人 都 被 吞 灭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8467', '10', '17', '17', '那 时 ， 约 拿 单 和 亚 希 玛 斯 在 隐 罗 结 那 里 等 候 ， 不 敢 进 城 ， 恐 怕 被 人 看 见 。 有 一 个 使 女 出 来 ， 将 这 话 告 诉 他 们 ， 他 们 就 去 报 信 给 大 卫 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8468', '10', '17', '18', '然 而 有 一 个 童 子 看 见 他 们 ， 就 去 告 诉 押 沙 龙 。 他 们 急 忙 跑 到 巴 户 琳 某 人 的 家 里 ； 那 人 院 中 有 一 口 井 ， 他 们 就 下 到 井 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8469', '10', '17', '19', '那 家 的 妇 人 用 盖 盖 上 井 口 ， 又 在 上 头 铺 上 碎 麦 ， 事 就 没 有 ? 漏 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8470', '10', '17', '20', '押 沙 龙 的 仆 人 来 到 那 家 ， 问 妇 人 说 ： 亚 希 玛 斯 和 约 拿 单 在 哪 里 ？ 妇 人 说 ： 他 们 过 了 河 了 。 仆 人 找 他 们 ， 找 不 着 ， 就 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8471', '10', '17', '21', '他 们 走 後 ， 二 人 从 井 里 上 来 ， 去 告 诉 大 卫 王 说 ： 亚 希 多 弗 如 此 如 此 定 计 害 你 ， 你 们 务 要 起 来 ， 快 快 过 河 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8472', '10', '17', '22', '於 是 大 卫 和 跟 随 他 的 人 都 起 来 ， 过 约 但 河 。 到 了 天 亮 ， 无 一 人 不 过 约 但 河 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8473', '10', '17', '23', '亚 希 多 弗 见 不 依 从 他 的 计 谋 ， 就 备 上 驴 ， 归 回 本 城 ； 到 了 家 ， 留 下 遗 言 ， 便 吊 死 了 ， 葬 在 他 父 亲 的 坟 墓 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8474', '10', '17', '24', '大 卫 到 了 玛 哈 念 ， 押 沙 龙 和 跟 随 他 的 以 色 列 人 也 都 过 了 约 但 河 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8475', '10', '17', '25', '押 沙 龙 立 亚 玛 撒 作 元 帅 ， 代 替 约 押 。 亚 玛 撒 是 以 实 玛 利 人 （ 又 作 以 色 列 人 ） 以 特 拉 的 儿 子 。 以 特 拉 曾 与 拿 辖 的 女 儿 亚 比 该 亲 近 ； 这 亚 比 该 与 约 押 的 母 亲 洗 鲁 雅 是 姊 妹 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8476', '10', '17', '26', '押 沙 龙 和 以 色 列 人 都 安 营 在 基 列 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8477', '10', '17', '27', '大 卫 到 了 玛 哈 念 ， 亚 扪 族 的 拉 巴 人 拿 辖 的 儿 子 朔 比 ， 罗 底 巴 人 亚 米 利 的 儿 子 玛 吉 ， 基 列 的 罗 基 琳 人 巴 西 莱 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8478', '10', '17', '28', '带 着 被 、 褥 、 盆 、 碗 、 瓦 器 、 小 麦 、 大 麦 、 麦 面 、 炒 谷 、 豆 子 、 红 豆 、 炒 豆 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8479', '10', '17', '29', '蜂 蜜 、 奶 油 、 绵 羊 、 奶 饼 ， 供 给 大 卫 和 跟 随 他 的 人 吃 ； 他 们 说 ： 民 在 旷 野 ， 必 饥 渴 困 乏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8480', '10', '18', '1', '大 卫 数 点 跟 随 他 的 人 ， 立 千 夫 长 、 百 夫 长 率 领 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8481', '10', '18', '2', '大 卫 打 发 军 兵 出 战 ， 分 为 三 队 ： 一 队 在 约 押 手 下 ， 一 队 在 洗 鲁 雅 的 儿 子 、 约 押 兄 弟 亚 比 筛 手 下 ， 一 队 在 迦 特 人 以 太 手 下 。 大 卫 对 军 兵 说 ： 我 必 与 你 们 一 同 出 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8482', '10', '18', '3', '军 兵 却 说 ： 你 不 可 出 战 。 若 是 我 们 逃 跑 ， 敌 人 必 不 介 意 ； 我 们 阵 亡 一 半 ， 敌 人 也 不 介 意 。 因 为 你 一 人 强 似 我 们 万 人 ， 你 不 如 在 城 里 预 备 帮 助 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8483', '10', '18', '4', '王 向 他 们 说 ： 你 们 以 为 怎 样 好 ， 我 就 怎 样 行 。 於 是 王 站 在 城 门 旁 ， 军 兵 或 百 或 千 地 挨 次 出 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8484', '10', '18', '5', '王 嘱 咐 约 押 、 亚 比 筛 、 以 太 说 ： 你 们 要 为 我 的 缘 故 宽 待 那 少 年 人 押 沙 龙 。 王 为 押 沙 龙 嘱 咐 众 将 的 话 ， 兵 都 听 见 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8485', '10', '18', '6', '兵 就 出 到 田 野 迎 着 以 色 列 人 ， 在 以 法 莲 树 林 里 交 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8486', '10', '18', '7', '以 色 列 人 败 在 大 卫 的 仆 人 面 前 ； 那 日 阵 亡 的 甚 多 ， 共 有 二 万 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8487', '10', '18', '8', '因 为 在 那 里 四 面 打 仗 ， 死 於 树 林 的 比 死 於 刀 剑 的 更 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8488', '10', '18', '9', '押 沙 龙 偶 然 遇 见 大 卫 的 仆 人 。 押 沙 龙 骑 着 骡 子 ， 从 大 橡 树 密 枝 底 下 经 过 ， 他 的 头 发 被 树 枝 绕 住 ， 就 悬 挂 起 来 ， 所 骑 的 骡 子 便 离 他 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8489', '10', '18', '10', '有 个 人 看 见 ， 就 告 诉 约 押 说 ： 我 看 见 押 沙 龙 挂 在 橡 树 上 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8490', '10', '18', '11', '约 押 对 报 信 的 人 说 ： 你 既 看 见 他 ， 为 甚 麽 不 将 他 打 死 落 在 地 上 呢 ？ 你 若 打 死 他 ， 我 就 赏 你 十 舍 客 勒 银 子 ， 一 条 带 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8491', '10', '18', '12', '那 人 对 约 押 说 ： 我 就 是 得 你 一 千 舍 客 勒 银 子 ， 我 也 不 敢 伸 手 害 王 的 儿 子 ； 因 为 我 们 听 见 王 嘱 咐 你 和 亚 比 筛 并 以 太 说 ： 你 们 要 谨 慎 ， 不 可 害 那 少 年 人 押 沙 龙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8492', '10', '18', '13', '我 若 妄 为 害 了 他 的 性 命 ， 就 是 你 自 己 也 必 与 我 为 敌 （ 原 来 ， 无 论 何 事 都 瞒 不 过 王 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8493', '10', '18', '14', '约 押 说 ： 我 不 能 与 你 留 连 。 约 押 手 拿 三 杆 短 枪 ， 趁 押 沙 龙 在 橡 树 上 还 活 着 ， 就 刺 透 他 的 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8494', '10', '18', '15', '给 约 押 拿 兵 器 的 十 个 少 年 人 围 绕 押 沙 龙 ， 将 他 杀 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8495', '10', '18', '16', '约 押 吹 角 ， 拦 阻 众 人 ， 他 们 就 回 来 ， 不 再 追 赶 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8496', '10', '18', '17', '他 们 将 押 沙 龙 丢 在 林 中 一 个 大 坑 里 ， 上 头 堆 起 一 大 堆 石 头 。 以 色 列 众 人 都 逃 跑 ， 各 回 各 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8497', '10', '18', '18', '押 沙 龙 活 着 的 时 候 ， 在 王 谷 立 了 一 根 石 柱 ， 因 他 说 ： 我 没 有 儿 子 为 我 留 名 。 他 就 以 自 己 的 名 称 那 石 柱 叫 押 沙 龙 柱 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8498', '10', '18', '19', '撒 督 的 儿 子 亚 希 玛 斯 说 ： 容 我 跑 去 ， 将 耶 和 华 向 仇 敌 给 王 报 仇 的 信 息 报 与 王 知 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8499', '10', '18', '20', '约 押 对 他 说 ： 你 今 日 不 可 去 报 信 ， 改 日 可 以 报 信 ； 因 为 今 日 王 的 儿 子 死 了 ， 所 以 你 不 可 去 报 信 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8500', '10', '18', '21', '约 押 对 古 示 人 说 ： 你 去 将 你 所 看 见 的 告 诉 王 。 古 示 人 在 约 押 面 前 下 拜 ， 就 跑 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8501', '10', '18', '22', '撒 督 的 儿 子 亚 希 玛 斯 又 对 约 押 说 ： 无 论 怎 样 ， 求 你 容 我 随 着 古 示 人 跑 去 。 约 押 说 ： 我 儿 ， 你 报 这 信 息 ， 既 不 得 赏 赐 ， 何 必 要 跑 去 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8502', '10', '18', '23', '他 又 说 ： 无 论 怎 样 ， 我 要 跑 去 。 约 押 说 ： 你 跑 去 罢 ！ 亚 希 玛 斯 就 从 平 原 往 前 跑 ， 跑 过 古 示 人 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8503', '10', '18', '24', '大 卫 正 坐 在 城 ? 里 。 守 望 的 人 上 城 门 楼 的 顶 上 ， 举 目 观 看 ， 见 有 一 个 人 独 自 跑 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8504', '10', '18', '25', '守 望 的 人 就 大 声 告 诉 王 。 王 说 ： 他 若 独 自 来 ， 必 是 报 口 信 的 。 那 人 跑 得 渐 渐 近 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8505', '10', '18', '26', '守 望 的 人 又 见 一 人 跑 来 ， 就 对 守 城 门 的 人 说 ： 又 有 一 人 独 自 跑 来 。 王 说 ： 这 也 必 是 报 信 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8506', '10', '18', '27', '守 望 的 人 说 ： 我 看 前 头 人 的 跑 法 ， 好 像 撒 督 的 儿 子 亚 希 玛 斯 的 跑 法 一 样 。 王 说 ： 他 是 个 好 人 ， 必 是 报 好 信 息 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8507', '10', '18', '28', '亚 希 玛 斯 向 王 呼 叫 说 ： 平 安 了 ！ 就 在 王 面 前 脸 伏 於 地 叩 拜 ， 说 ： 耶 和 华 ─ 你 的 　 神 是 应 当 称 颂 的 ， 因 他 已 将 那 举 手 攻 击 我 主 我 王 的 人 交 给 王 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8508', '10', '18', '29', '王 问 说 ： 少 年 人 押 沙 龙 平 安 不 平 安 ？ 亚 希 玛 斯 回 答 说 ： 约 押 打 发 王 的 仆 人 ， 那 时 仆 人 听 见 众 民 大 声 喧 哗 ， 却 不 知 道 是 甚 麽 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8509', '10', '18', '30', '王 说 ： 你 退 去 ， 站 在 旁 边 。 他 就 退 去 ， 站 在 旁 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8510', '10', '18', '31', '古 示 人 也 来 到 ， 说 ： 有 信 息 报 给 我 主 我 王 ！ 耶 和 华 今 日 向 一 切 兴 起 攻 击 你 的 人 给 你 报 仇 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8511', '10', '18', '32', '王 问 古 示 人 说 ： 少 年 人 押 沙 龙 平 安 不 平 安 ？ 古 示 人 回 答 说 ： 愿 我 主 我 王 的 仇 敌 ， 和 一 切 兴 起 要 杀 害 你 的 人 ， 都 与 那 少 年 人 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8512', '10', '18', '33', '王 就 心 里 伤 恸 ， 上 城 门 楼 去 哀 哭 ， 一 面 走 一 面 说 ： 我 儿 押 沙 龙 啊 ！ 我 儿 ， 我 儿 押 沙 龙 啊 ！ 我 恨 不 得 替 你 死 ， 押 沙 龙 啊 ， 我 儿 ！ 我 儿 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8513', '10', '19', '1', '有 人 告 诉 约 押 说 ： 王 为 押 沙 龙 哭 泣 悲 哀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8514', '10', '19', '2', '众 民 听 说 王 为 他 儿 子 忧 愁 ， 他 们 得 胜 的 欢 乐 却 变 成 悲 哀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8515', '10', '19', '3', '那 日 众 民 暗 暗 地 进 城 ， 就 如 败 阵 逃 跑 、 惭 愧 的 民 一 般 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8516', '10', '19', '4', '王 蒙 着 脸 ， 大 声 哭 号 说 ： 我 儿 押 沙 龙 啊 ！ 押 沙 龙 ， 我 儿 ， 我 儿 啊 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8517', '10', '19', '5', '约 押 进 去 见 王 ， 说 ： 你 今 日 使 你 一 切 仆 人 脸 面 惭 愧 了 ！ 他 们 今 日 救 了 你 的 性 命 和 你 儿 女 妻 妾 的 性 命 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8518', '10', '19', '6', '你 却 爱 那 恨 你 的 人 ， 恨 那 爱 你 的 人 。 你 今 日 明 明 地 不 以 将 帅 、 仆 人 为 念 。 我 今 日 看 明 ， 若 押 沙 龙 活 着 ， 我 们 都 死 亡 ， 你 就 喜 悦 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8519', '10', '19', '7', '现 在 你 当 出 去 ， 安 慰 你 仆 人 的 心 。 我 指 着 耶 和 华 起 誓 ： 你 若 不 出 去 ， 今 夜 必 无 一 人 与 你 同 在 一 处 ； 这 祸 患 就 比 你 从 幼 年 到 如 今 所 遭 的 更 甚 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8520', '10', '19', '8', '於 是 王 起 来 ， 坐 在 城 门 口 。 众 民 听 说 王 坐 在 城 门 口 ， 就 都 到 王 面 前 。 以 色 列 人 已 经 逃 跑 ， 各 回 各 家 . 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8521', '10', '19', '9', '以 色 列 众 支 派 的 人 纷 纷 议 论 说 ： 王 曾 救 我 们 脱 离 仇 敌 的 手 ， 又 救 我 们 脱 离 非 利 士 人 的 手 ， 现 在 他 躲 避 押 沙 龙 逃 走 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8522', '10', '19', '10', '我 们 膏 押 沙 龙 治 理 我 们 ， 他 已 经 阵 亡 。 现 在 为 甚 麽 不 出 一 言 请 王 回 来 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8523', '10', '19', '11', '大 卫 王 差 人 去 见 祭 司 撒 督 和 亚 比 亚 他 ， 说 ： 你 们 当 向 犹 大 长 老 说 ： 以 色 列 众 人 已 经 有 话 请 王 回 宫 ， 你 们 为 甚 麽 落 在 他 们 後 头 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8524', '10', '19', '12', '你 们 是 我 的 弟 兄 ， 是 我 的 骨 肉 ， 为 甚 麽 在 人 後 头 请 王 回 来 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8525', '10', '19', '13', '也 要 对 亚 玛 撒 说 ： 你 不 是 我 的 骨 肉 麽 ？ 我 若 不 立 你 替 约 押 常 作 元 帅 ， 愿 　 神 重 重 地 降 罚 与 我 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8526', '10', '19', '14', '如 此 就 挽 回 犹 大 众 人 的 心 ， 如 同 一 人 的 心 。 他 们 便 打 发 人 去 见 王 ， 说 ： 请 王 和 王 的 一 切 臣 仆 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8527', '10', '19', '15', '王 就 回 来 ， 到 了 约 但 河 。 犹 大 人 来 到 吉 甲 ， 要 去 迎 接 王 ， 请 他 过 约 但 河 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8528', '10', '19', '16', '巴 户 琳 的 便 雅 悯 人 、 基 拉 的 儿 子 示 每 急 忙 与 犹 大 人 一 同 下 去 迎 接 大 卫 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8529', '10', '19', '17', '跟 从 示 每 的 有 一 千 便 雅 悯 人 ， 还 有 扫 罗 家 的 仆 人 洗 巴 和 他 十 五 个 儿 子 ， 二 十 个 仆 人 ； 他 们 都 ? 过 约 但 河 迎 接 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8530', '10', '19', '18', '有 摆 渡 船 过 去 ， 渡 王 的 家 眷 ， 任 王 使 用 。 王 要 过 约 但 河 的 时 候 ， 基 拉 的 儿 子 示 每 就 俯 伏 在 王 面 前 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8531', '10', '19', '19', '对 王 说 ： 我 主 我 王 出 耶 路 撒 冷 的 时 候 ， 仆 人 行 悖 逆 的 事 ， 现 在 求 我 主 不 要 因 此 加 罪 与 仆 人 ， 不 要 记 念 ， 也 不 要 放 在 心 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8532', '10', '19', '20', '仆 人 明 知 自 己 有 罪 ， 所 以 约 瑟 全 家 之 中 ， 今 日 我 首 先 下 来 迎 接 我 主 我 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8533', '10', '19', '21', '洗 鲁 雅 的 儿 子 亚 比 筛 说 ： 示 每 既 咒 骂 耶 和 华 的 受 膏 者 ， 不 应 当 治 死 他 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8534', '10', '19', '22', '大 卫 说 ： 洗 鲁 雅 的 儿 子 ， 我 与 你 们 有 何 关 涉 ， 使 你 们 今 日 与 我 反 对 呢 ？ 今 日 在 以 色 列 中 岂 可 治 死 人 呢 ？ 我 岂 不 知 今 日 我 作 以 色 列 的 王 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8535', '10', '19', '23', '於 是 王 对 示 每 说 ： 你 必 不 死 。 王 就 向 他 起 誓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8536', '10', '19', '24', '扫 罗 的 孙 子 米 非 波 设 也 下 去 迎 接 王 。 他 自 从 王 去 的 日 子 ， 直 到 王 平 平 安 安 地 回 来 ， 没 有 修 脚 ， 没 有 剃 胡 须 ， 也 没 有 洗 衣 服 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8537', '10', '19', '25', '他 来 到 耶 路 撒 冷 迎 接 王 的 时 候 ， 王 问 他 说 ： 米 非 波 设 ， 你 为 甚 麽 没 有 与 我 同 去 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8538', '10', '19', '26', '他 回 答 说 ： 我 主 我 王 ， 仆 人 是 瘸 腿 的 。 那 日 我 想 要 备 驴 骑 上 ， 与 王 同 去 ， 无 奈 我 的 仆 人 欺 哄 了 我 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8539', '10', '19', '27', '又 在 我 主 我 王 面 前 谗 毁 我 。 然 而 我 主 我 王 如 同 　 神 的 使 者 一 般 ， 你 看 怎 样 好 ， 就 怎 样 行 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8540', '10', '19', '28', '因 为 我 祖 全 家 的 人 ， 在 我 主 我 王 面 前 都 算 为 死 人 ， 王 却 使 仆 人 在 王 的 席 上 同 人 吃 饭 ， 我 现 在 向 王 还 能 辨 理 诉 冤 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8541', '10', '19', '29', '王 对 他 说 ： 你 何 必 再 提 你 的 事 呢 ？ 我 说 ， 你 与 洗 巴 均 分 地 土 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8542', '10', '19', '30', '米 非 波 设 对 王 说 ： 我 主 我 王 既 平 平 安 安 地 回 宫 ， 就 任 凭 洗 巴 都 取 了 也 可 以 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8543', '10', '19', '31', '基 列 人 巴 西 莱 从 罗 基 琳 下 来 ， 要 送 王 过 约 但 河 ， 就 与 王 一 同 过 了 约 但 河 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8544', '10', '19', '32', '巴 西 莱 年 纪 老 迈 ， 已 经 八 十 岁 了 。 王 住 在 玛 哈 念 的 时 候 ， 他 就 拿 食 物 来 供 给 王 ； 他 原 是 大 富 户 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8545', '10', '19', '33', '王 对 巴 西 莱 说 ： 你 与 我 同 去 ， 我 要 在 耶 路 撒 冷 那 里 养 你 的 老 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8546', '10', '19', '34', '巴 西 莱 对 王 说 ： 我 在 世 的 年 日 还 能 有 多 少 ， 使 我 与 王 同 上 耶 路 撒 冷 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8547', '10', '19', '35', '仆 人 现 在 八 十 岁 了 ， 还 能 尝 出 饮 食 的 滋 味 、 辨 别 美 恶 麽 ？ 还 能 听 男 女 歌 唱 的 声 音 麽 ？ 仆 人 何 必 累 赘 我 主 我 王 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8548', '10', '19', '36', '仆 人 只 要 送 王 过 约 但 河 ， 王 何 必 赐 我 这 样 的 恩 典 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8549', '10', '19', '37', '求 你 准 我 回 去 ， 好 死 在 我 本 城 ， 葬 在 我 父 母 的 墓 旁 。 这 里 有 王 的 仆 人 金 罕 ， 让 他 同 我 主 我 王 过 去 ， 可 以 随 意 待 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8550', '10', '19', '38', '王 说 ： 金 罕 可 以 与 我 同 去 ， 我 必 照 你 的 心 愿 待 他 。 你 向 我 求 甚 麽 ， 我 都 必 为 你 成 就 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8551', '10', '19', '39', '於 是 众 民 过 约 但 河 ， 王 也 过 去 。 王 与 巴 西 莱 亲 嘴 ， 为 他 祝 福 ， 巴 西 莱 就 回 本 地 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8552', '10', '19', '40', '王 过 去 ， 到 了 吉 甲 ， 金 罕 也 跟 他 过 去 。 犹 大 众 民 和 以 色 列 民 的 一 半 也 都 送 王 过 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8553', '10', '19', '41', '以 色 列 众 人 来 见 王 ， 对 他 说 ： 我 们 弟 兄 犹 大 人 为 甚 麽 暗 暗 送 王 和 王 的 家 眷 ， 并 跟 随 王 的 人 过 约 但 河 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8554', '10', '19', '42', '犹 大 众 人 回 答 以 色 列 人 说 ： 因 为 王 与 我 们 是 亲 属 ， 你 们 为 何 因 这 事 发 怒 呢 ？ 我 们 吃 了 王 的 甚 麽 呢 ？ 王 赏 赐 了 我 们 甚 麽 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8555', '10', '19', '43', '以 色 列 人 回 答 犹 大 人 说 ： 按 支 派 ， 我 们 与 王 有 十 分 的 情 分 ； 在 大 卫 身 上 ， 我 们 也 比 你 们 更 有 情 分 。 你 们 为 何 藐 视 我 们 ， 请 王 回 来 不 先 与 我 们 商 量 呢 ？ 但 犹 大 人 的 话 比 以 色 列 人 的 话 更 硬 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8556', '10', '20', '1', '在 那 里 恰 巧 有 一 个 匪 徒 ， 名 叫 示 巴 ， 是 便 雅 悯 人 比 基 利 的 儿 子 。 他 吹 角 ， 说 ： 我 们 与 大 卫 无 分 ， 与 耶 西 的 儿 子 无 涉 。 以 色 列 人 哪 ， 你 们 各 回 各 家 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8557', '10', '20', '2', '於 是 以 色 列 人 都 离 开 大 卫 ， 跟 随 比 基 利 的 儿 子 示 巴 。 但 犹 大 人 从 约 但 河 直 到 耶 路 撒 冷 ， 都 紧 紧 跟 随 他 们 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8558', '10', '20', '3', '大 卫 王 来 到 耶 路 撒 冷 ， 进 了 宫 殿 ， 就 把 从 前 留 下 看 守 宫 殿 的 十 个 妃 嫔 禁 闭 在 冷 宫 ， 养 活 他 们 ， 不 与 他 们 亲 近 。 他 们 如 同 寡 妇 被 禁 ， 直 到 死 的 日 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8559', '10', '20', '4', '王 对 亚 玛 撒 说 ： 你 要 在 三 日 之 内 将 犹 大 人 招 聚 了 来 ， 你 也 回 到 这 里 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8560', '10', '20', '5', '亚 玛 撒 就 去 招 聚 犹 大 人 ， 却 耽 延 过 了 王 所 限 的 日 期 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8561', '10', '20', '6', '大 卫 对 亚 比 筛 说 ： 现 在 恐 怕 比 基 利 的 儿 子 示 巴 加 害 於 我 们 比 押 沙 龙 更 甚 。 你 要 带 领 你 主 的 仆 人 追 赶 他 ， 免 得 他 得 了 坚 固 城 ， 躲 避 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8562', '10', '20', '7', '约 押 的 人 和 基 利 提 人 、 比 利 提 人 ， 并 所 有 的 勇 士 ， 都 跟 着 亚 比 筛 ， 从 耶 路 撒 冷 出 去 追 赶 比 基 利 的 儿 子 示 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8563', '10', '20', '8', '他 们 到 了 基 遍 的 大 磐 石 那 里 ， 亚 玛 撒 来 迎 接 他 们 。 那 时 约 押 穿 着 战 衣 ， 腰 束 佩 刀 的 带 子 ， 刀 在 鞘 内 ； 约 押 前 行 ， 刀 从 鞘 内 掉 出 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8564', '10', '20', '9', '约 押 左 手 拾 起 刀 来 ， 对 亚 玛 撒 说 ： 我 兄 弟 ， 你 好 啊 ！ 就 用 右 手 抓 住 亚 玛 撒 的 胡 子 ， 要 与 他 亲 嘴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8565', '10', '20', '10', '亚 玛 撒 没 有 防 备 约 押 手 里 所 拿 的 刀 ； 约 押 用 刀 刺 入 他 的 肚 腹 ， 他 的 肠 子 流 在 地 上 ， 没 有 再 刺 他 ， 就 死 了 。 约 押 和 他 兄 弟 亚 比 筛 往 前 追 赶 比 基 利 的 儿 子 示 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8566', '10', '20', '11', '有 约 押 的 一 个 少 年 人 站 在 亚 玛 撒 尸 身 旁 边 ， 对 众 人 说 ： 谁 喜 悦 约 押 ， 谁 归 顺 大 卫 ， 就 当 跟 随 约 押 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8567', '10', '20', '12', '亚 玛 撒 在 道 路 上 滚 在 自 己 的 血 里 。 那 人 见 众 民 经 过 都 站 住 ， 就 把 亚 玛 撒 的 尸 身 从 路 上 挪 到 田 间 ， 用 衣 服 遮 盖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8568', '10', '20', '13', '尸 身 从 路 上 挪 移 之 後 ， 众 民 就 都 跟 随 约 押 去 追 赶 比 基 利 的 儿 子 示 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8569', '10', '20', '14', '他 走 遍 以 色 列 各 支 派 ， 直 到 伯 玛 迦 的 亚 比 拉 ， 并 比 利 人 的 全 地 ； 那 些 地 方 的 人 也 都 聚 集 跟 随 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8570', '10', '20', '15', '约 押 和 跟 随 的 人 到 了 伯 玛 迦 的 亚 比 拉 ， 围 困 示 巴 ， 就 对 着 城 筑 垒 ； 跟 随 约 押 的 众 民 用 锤 撞 城 ， 要 使 城 塌 陷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8571', '10', '20', '16', '有 一 个 聪 明 妇 人 从 城 上 呼 叫 说 ： 听 啊 ， 听 啊 ， 请 约 押 近 前 来 ， 我 好 与 他 说 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8572', '10', '20', '17', '约 押 就 近 前 来 ， 妇 人 问 他 说 ： 你 是 约 押 不 是 ？ 他 说 ： 我 是 。 妇 人 说 ： 求 你 听 婢 女 的 话 。 约 押 说 ： 我 听 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8573', '10', '20', '18', '妇 人 说 ： 古 时 有 话 说 ， 当 先 在 亚 比 拉 求 问 ， 然 後 事 就 定 妥 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8574', '10', '20', '19', '我 们 这 城 的 人 在 以 色 列 人 中 是 和 平 、 忠 厚 的 。 你 为 何 要 毁 坏 以 色 列 中 的 大 城 ， 吞 灭 耶 和 华 的 产 业 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8575', '10', '20', '20', '约 押 回 答 说 ： 我 决 不 吞 灭 毁 坏 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8576', '10', '20', '21', '乃 因 以 法 莲 山 地 的 一 个 人 ─ 比 基 利 的 儿 子 示 巴 ─ 举 手 攻 击 大 卫 王 ， 你 们 若 将 他 一 人 交 出 来 ， 我 便 离 城 而 去 。 妇 人 对 约 押 说 ： 那 人 的 首 级 必 从 城 墙 上 丢 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8577', '10', '20', '22', '妇 人 就 凭 他 的 智 慧 去 劝 众 人 。 他 们 便 割 下 比 基 利 的 儿 子 示 巴 的 首 级 ， 丢 给 约 押 。 约 押 吹 角 ， 众 人 就 离 城 而 散 ， 各 归 各 家 去 了 。 约 押 回 耶 路 撒 冷 ， 到 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8578', '10', '20', '23', '约 押 作 以 色 列 全 军 的 元 帅 ； 耶 何 耶 大 的 儿 子 比 拿 雅 统 辖 基 利 提 人 和 比 利 提 人 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8579', '10', '20', '24', '亚 多 兰 掌 管 服 苦 的 人 ； 亚 希 律 的 儿 子 约 沙 法 作 史 官 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8580', '10', '20', '25', '示 法 作 书 记 ； 撒 督 和 亚 比 亚 他 作 祭 司 长 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8581', '10', '20', '26', '睚 珥 人 以 拉 作 大 卫 的 宰 相 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8582', '10', '21', '1', '大 卫 年 间 有 饥 荒 ， 一 连 三 年 ， 大 卫 就 求 问 耶 和 华 。 耶 和 华 说 ： 这 饥 荒 是 因 扫 罗 和 他 流 人 血 之 家 杀 死 基 遍 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8583', '10', '21', '2', '原 来 这 基 遍 人 不 是 以 色 列 人 ， 乃 是 亚 摩 利 人 中 所 剩 的 ； 以 色 列 人 曾 向 他 们 起 誓 ， 不 杀 灭 他 们 ， 扫 罗 却 为 以 色 列 人 和 犹 大 人 发 热 心 ， 想 要 杀 灭 他 们 。 大 卫 王 召 了 他 们 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8584', '10', '21', '3', '问 他 们 说 ： 我 当 为 你 们 怎 样 行 呢 ？ 可 用 甚 麽 赎 这 罪 ， 使 你 们 为 耶 和 华 的 产 业 祝 福 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8585', '10', '21', '4', '基 遍 人 回 答 说 ： 我 们 和 扫 罗 与 他 家 的 事 并 不 关 乎 金 银 ， 也 不 要 因 我 们 的 缘 故 杀 一 个 以 色 列 人 。 大 卫 说 ： 你 们 怎 样 说 ， 我 就 为 你 们 怎 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8586', '10', '21', '5', '他 们 对 王 说 ： 那 从 前 谋 害 我 们 、 要 灭 我 们 、 使 我 们 不 得 再 住 以 色 列 境 内 的 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8587', '10', '21', '6', '现 在 愿 将 他 的 子 孙 七 人 交 给 我 们 ， 我 们 好 在 耶 和 华 面 前 ， 将 他 们 悬 挂 在 耶 和 华 拣 选 扫 罗 的 基 比 亚 。 王 说 ： 我 必 交 给 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8588', '10', '21', '7', '王 因 为 曾 与 扫 罗 的 儿 子 约 拿 单 指 着 耶 和 华 起 誓 结 盟 ， 就 爱 惜 扫 罗 的 孙 子 、 约 拿 单 的 儿 子 米 非 波 设 ， 不 交 出 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8589', '10', '21', '8', '却 把 爱 雅 的 女 儿 利 斯 巴 给 扫 罗 所 生 的 两 个 儿 子 亚 摩 尼 、 米 非 波 设 ， 和 扫 罗 女 儿 米 甲 的 姊 姊 给 米 何 拉 人 巴 西 莱 儿 子 亚 得 列 所 生 的 五 个 儿 子');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8590', '10', '21', '9', '交 在 基 遍 人 的 手 里 。 基 遍 人 就 把 他 们 ， 在 耶 和 华 面 前 ， 悬 挂 在 山 上 ， 这 七 人 就 一 同 死 亡 。 被 杀 的 时 候 正 是 收 割 的 日 子 ， 就 是 动 手 割 大 麦 的 时 候 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8591', '10', '21', '10', '爱 雅 的 女 儿 利 斯 巴 用 麻 布 在 磐 石 上 搭 棚 ， 从 动 手 收 割 的 时 候 直 到 天 降 雨 在 尸 身 上 的 时 候 ， 日 间 不 容 空 中 的 雀 鸟 落 在 尸 身 上 ， 夜 间 不 让 田 野 的 走 兽 前 来 糟 践 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8592', '10', '21', '11', '有 人 将 扫 罗 的 妃 嫔 爱 雅 女 儿 利 斯 巴 所 行 的 这 事 告 诉 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8593', '10', '21', '12', '大 卫 就 去 ， 从 基 列 雅 比 人 那 里 将 扫 罗 和 他 儿 子 约 拿 单 的 骸 骨 搬 了 来 （ 是 因 非 利 士 人 从 前 在 基 利 波 杀 扫 罗 ， 将 尸 身 悬 挂 在 伯 珊 的 街 市 上 ， 基 列 雅 比 人 把 尸 身 偷 了 去 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8594', '10', '21', '13', '大 卫 将 扫 罗 和 他 儿 子 约 拿 单 的 骸 骨 从 那 里 搬 了 来 ， 又 收 殓 被 悬 挂 七 人 的 骸 骨 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8595', '10', '21', '14', '将 扫 罗 和 他 儿 子 约 拿 单 的 骸 骨 葬 在 便 雅 悯 的 洗 拉 ， 在 扫 罗 父 亲 基 士 的 坟 墓 里 ； 众 人 行 了 王 所 吩 咐 的 。 此 後 　 神 垂 听 国 民 所 求 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8596', '10', '21', '15', '非 利 士 人 与 以 色 列 人 打 仗 ； 大 卫 带 领 仆 人 下 去 ， 与 非 利 士 人 接 战 ， 大 卫 就 疲 乏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8597', '10', '21', '16', '伟 人 的 一 个 儿 子 以 实 比 诺 要 杀 大 卫 ； 他 的 铜 枪 重 三 百 舍 客 勒 ， 又 佩 着 新 刀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8598', '10', '21', '17', '但 洗 鲁 雅 的 儿 子 亚 比 筛 帮 助 大 卫 ， 攻 打 非 利 士 人 ， 将 他 杀 死 。 当 日 ， 跟 随 大 卫 的 人 向 大 卫 起 誓 说 ： 以 後 你 不 可 再 与 我 们 一 同 出 战 ， 恐 怕 熄 灭 以 色 列 的 灯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8599', '10', '21', '18', '後 来 ， 以 色 列 人 在 歌 伯 与 非 利 士 人 打 仗 ， 户 沙 人 西 比 该 杀 了 伟 人 的 一 个 儿 子 撒 弗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8600', '10', '21', '19', '又 在 歌 伯 与 非 利 士 人 打 仗 ， 伯 利 恒 人 雅 雷 俄 珥 金 的 儿 子 伊 勒 哈 难 杀 了 迦 特 人 歌 利 亚 。 这 人 的 枪 杆 粗 如 织 布 的 机 轴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8601', '10', '21', '20', '又 在 迦 特 打 仗 ， 那 里 有 一 个 身 量 高 大 的 人 ， 手 脚 都 是 六 指 ， 共 有 二 十 四 个 指 头 ； 他 也 是 伟 人 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8602', '10', '21', '21', '这 人 向 以 色 列 人 骂 阵 ， 大 卫 的 哥 哥 示 米 亚 的 儿 子 约 拿 单 就 杀 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8603', '10', '21', '22', '这 四 个 人 是 迦 特 伟 人 的 儿 子 ， 都 死 在 大 卫 和 他 仆 人 的 手 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8604', '10', '22', '1', '当 耶 和 华 救 大 卫 脱 离 一 切 仇 敌 和 扫 罗 之 手 的 日 子 ， 他 向 耶 和 华 念 这 诗 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8605', '10', '22', '2', '说 ： 耶 和 华 是 我 的 岩 石 ， 我 的 山 寨 ， 我 的 救 主 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8606', '10', '22', '3', '我 的 　 神 ， 我 的 磐 石 ， 我 所 投 靠 的 。 他 是 我 的 盾 牌 ， 是 拯 救 我 的 角 ， 是 我 的 高 ? ， 是 我 的 避 难 所 。 我 的 救 主 啊 ， 你 是 救 我 脱 离 强 暴 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8607', '10', '22', '4', '我 要 求 告 当 赞 美 的 耶 和 华 ， 这 样 ， 我 必 从 仇 敌 手 中 被 救 出 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8608', '10', '22', '5', '曾 有 死 亡 的 波 浪 环 绕 我 ， 匪 类 的 急 流 使 我 惊 惧 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8609', '10', '22', '6', '阴 间 的 绳 索 缠 绕 我 ， 死 亡 的 网 罗 临 到 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8610', '10', '22', '7', '我 在 急 难 中 求 告 耶 和 华 ， 向 我 的 　 神 呼 求 。 他 从 殿 中 听 了 我 的 声 音 ； 我 的 呼 求 入 了 他 的 耳 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8611', '10', '22', '8', '那 时 因 他 发 怒 ， 地 就 摇 撼 战 抖 ； 天 的 根 基 也 震 动 摇 撼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8612', '10', '22', '9', '从 他 鼻 孔 冒 烟 上 腾 ； 从 他 口 中 发 火 焚 烧 ， 连 炭 也 着 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8613', '10', '22', '10', '他 又 使 天 下 垂 ， 亲 自 降 临 ； 有 黑 云 在 他 脚 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8614', '10', '22', '11', '他 坐 着 基 路 伯 飞 行 ， 在 风 的 翅 膀 上 显 现 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8615', '10', '22', '12', '他 以 黑 暗 和 聚 集 的 水 、 天 空 的 厚 云 为 他 四 围 的 行 宫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8616', '10', '22', '13', '因 他 面 前 的 光 辉 炭 都 着 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8617', '10', '22', '14', '耶 和 华 从 天 上 打 雷 ； 至 高 者 发 出 声 音 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8618', '10', '22', '15', '他 射 出 箭 来 ， 使 仇 敌 四 散 ， 发 出 闪 电 ， 使 他 们 扰 乱 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8619', '10', '22', '16', '耶 和 华 的 斥 责 一 发 ， 鼻 孔 的 气 一 出 ， 海 底 就 出 现 ， 大 地 的 根 基 也 显 露 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8620', '10', '22', '17', '他 从 高 天 伸 手 抓 住 我 ， 把 我 从 大 水 中 拉 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8621', '10', '22', '18', '他 救 我 脱 离 我 的 劲 敌 和 那 些 恨 我 的 人 ， 因 为 他 们 比 我 强 盛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8622', '10', '22', '19', '我 遭 遇 灾 难 的 日 子 ， 他 们 来 攻 击 我 ； 但 耶 和 华 是 我 的 倚 靠 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8623', '10', '22', '20', '他 又 领 我 到 宽 阔 之 处 ； 他 救 拔 我 ， 因 他 喜 悦 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8624', '10', '22', '21', '耶 和 华 按 着 我 的 公 义 报 答 我 ， 按 着 我 手 中 的 清 洁 赏 赐 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8625', '10', '22', '22', '因 为 我 遵 守 了 耶 和 华 的 道 ， 未 曾 作 恶 离 开 我 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8626', '10', '22', '23', '他 的 一 切 典 章 常 在 我 面 前 ； 他 的 律 例 ， 我 也 未 曾 离 弃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8627', '10', '22', '24', '我 在 他 面 前 作 了 完 全 人 ； 我 也 保 守 自 己 远 离 我 的 罪 孽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8628', '10', '22', '25', '所 以 耶 和 华 按 我 的 公 义 ， 按 我 在 他 眼 前 的 清 洁 赏 赐 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8629', '10', '22', '26', '慈 爱 的 人 ， 你 以 慈 爱 待 他 ； 完 全 的 人 ， 你 以 完 全 待 他 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8630', '10', '22', '27', '清 洁 的 人 ， 你 以 清 洁 待 他 ； 乖 僻 的 人 ， 你 以 弯 曲 待 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8631', '10', '22', '28', '困 苦 的 百 姓 ， 你 必 拯 救 ； 但 你 的 眼 目 察 看 高 傲 的 人 ， 使 他 降 卑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8632', '10', '22', '29', '耶 和 华 啊 ， 你 是 我 的 灯 ； 耶 和 华 必 照 明 我 的 黑 暗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8633', '10', '22', '30', '我 藉 着 你 冲 入 敌 军 ， 藉 着 我 的 　 神 跳 过 墙 垣 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8634', '10', '22', '31', '至 於 神 ， 他 的 道 是 完 全 的 ； 耶 和 华 的 话 是 炼 净 的 。 凡 投 靠 他 的 ， 他 便 作 他 们 的 盾 牌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8635', '10', '22', '32', '除 了 耶 和 华 ， 谁 是 神 呢 ？ 除 了 我 们 的 　 神 ， 谁 是 磐 石 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8636', '10', '22', '33', '神 是 我 坚 固 的 保 障 ； 他 引 导 完 全 人 行 他 的 路 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8637', '10', '22', '34', '他 使 我 的 脚 快 如 母 鹿 的 蹄 ， 又 使 我 在 高 处 安 稳 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8638', '10', '22', '35', '他 教 导 我 的 手 能 以 争 战 ， 甚 至 我 的 膀 臂 能 开 铜 弓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8639', '10', '22', '36', '你 把 你 的 救 恩 给 我 作 盾 牌 ； 你 的 温 和 使 我 为 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8640', '10', '22', '37', '你 使 我 脚 下 的 地 步 宽 阔 ； 我 的 脚 未 曾 滑 跌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8641', '10', '22', '38', '我 追 赶 我 的 仇 敌 ， 灭 绝 了 他 们 ， 未 灭 以 先 ， 我 没 有 归 回 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8642', '10', '22', '39', '我 灭 绝 了 他 们 ， 打 伤 了 他 们 ， 使 他 们 不 能 起 来 ； 他 们 都 倒 在 我 的 脚 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8643', '10', '22', '40', '因 为 你 曾 以 力 量 束 我 的 腰 ， 使 我 能 争 战 ； 你 也 使 那 起 来 攻 击 我 的 都 服 在 我 以 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8644', '10', '22', '41', '你 又 使 我 的 仇 敌 在 我 面 前 转 背 逃 跑 ， 叫 我 能 以 剪 除 那 恨 我 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8645', '10', '22', '42', '他 们 仰 望 ， 却 无 人 拯 救 ； 就 是 呼 求 耶 和 华 ， 他 也 不 应 允 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8646', '10', '22', '43', '我 捣 碎 他 们 ， 如 同 地 上 的 灰 尘 ， 践 踏 他 们 ， 四 散 在 地 ， 如 同 街 上 的 泥 土 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8647', '10', '22', '44', '你 救 我 脱 离 我 百 姓 的 争 竞 ， 保 护 我 作 列 国 的 元 首 ； 我 素 不 认 识 的 民 必 事 奉 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8648', '10', '22', '45', '外 邦 人 要 投 降 我 ， 一 听 见 我 的 名 声 就 必 顺 从 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8649', '10', '22', '46', '外 邦 人 要 衰 残 ， 战 战 兢 兢 地 出 他 们 的 营 寨 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8650', '10', '22', '47', '耶 和 华 是 活 神 ， 愿 我 的 磐 石 被 人 称 颂 ！ 愿 　 神 ─ 那 拯 救 我 的 磐 石 被 人 尊 崇 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8651', '10', '22', '48', '这 位 神 就 是 那 为 我 伸 冤 、 使 众 民 服 在 我 以 下 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8652', '10', '22', '49', '你 救 我 脱 离 仇 敌 ， 又 把 我 举 起 ， 高 过 那 些 起 来 攻 击 我 的 ； 你 救 我 脱 离 强 暴 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8653', '10', '22', '50', '耶 和 华 啊 ， 因 此 我 要 在 外 邦 中 称 谢 你 ， 歌 颂 你 的 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8654', '10', '22', '51', '耶 和 华 赐 极 大 的 救 恩 给 他 所 立 的 王 ， 施 慈 爱 给 他 的 受 膏 者 ， 就 是 给 大 卫 和 他 的 後 裔 ， 直 到 永 远 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8655', '10', '23', '1', '以 下 是 大 卫 末 了 的 话 。 耶 西 的 儿 子 大 卫 得 居 高 位 ， 是 雅 各 　 神 所 膏 的 ， 作 以 色 列 的 美 歌 者 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8656', '10', '23', '2', '耶 和 华 的 灵 藉 着 我 说 ： 他 的 话 在 我 口 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8657', '10', '23', '3', '以 色 列 的 　 神 、 以 色 列 的 磐 石 晓 谕 我 说 ： 那 以 公 义 治 理 人 民 的 ， 敬 畏 　 神 执 掌 权 柄 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8658', '10', '23', '4', '他 必 像 日 出 的 晨 光 ， 如 无 云 的 清 晨 ， 雨 後 的 晴 光 ， 使 地 发 生 嫩 草 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8659', '10', '23', '5', '我 家 在 神 面 前 并 非 如 此 ； 　 神 却 与 我 立 永 远 的 约 。 这 约 凡 事 坚 稳 ， 关 乎 我 的 一 切 救 恩 和 我 一 切 所 想 望 的 ， 他 岂 不 为 我 成 就 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8660', '10', '23', '6', '但 匪 类 都 必 像 荆 棘 被 丢 弃 ； 人 不 敢 用 手 拿 他 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8661', '10', '23', '7', '拿 他 的 人 必 带 铁 器 和 枪 杆 ， 终 久 他 必 被 火 焚 烧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8662', '10', '23', '8', '大 卫 勇 士 的 名 字 记 在 下 面 ： 他 革 扪 人 约 设 巴 设 ， 又 称 伊 斯 尼 人 亚 底 挪 ， 他 是 军 长 的 统 领 ， 一 时 击 杀 了 八 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8663', '10', '23', '9', '其 次 是 亚 合 人 朵 多 的 儿 子 以 利 亚 撒 。 从 前 非 利 士 人 聚 集 要 打 仗 ， 以 色 列 人 迎 着 上 去 ， 有 跟 随 大 卫 的 三 个 勇 士 向 非 利 士 人 骂 阵 ， 其 中 有 以 利 亚 撒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8664', '10', '23', '10', '他 起 来 击 杀 非 利 士 人 ， 直 到 手 臂 疲 乏 ， 手 黏 住 刀 把 。 那 日 耶 和 华 使 以 色 列 人 大 获 全 胜 ； 众 民 在 以 利 亚 撒 後 头 专 夺 财 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8665', '10', '23', '11', '其 次 是 哈 拉 人 亚 基 的 儿 子 沙 玛 。 一 日 ， 非 利 士 人 聚 集 成 群 ， 在 一 块 长 满 红 豆 的 田 里 ， 众 民 就 在 非 利 士 人 面 前 逃 跑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8666', '10', '23', '12', '沙 玛 却 站 在 那 田 间 击 杀 非 利 士 人 ， 救 护 了 那 田 。 耶 和 华 使 以 色 列 人 大 获 全 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8667', '10', '23', '13', '收 割 的 时 候 ， 有 三 十 个 勇 士 中 的 三 个 人 下 到 亚 杜 兰 洞 见 大 卫 。 非 利 士 的 军 兵 在 利 乏 音 谷 安 营 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8668', '10', '23', '14', '那 时 大 卫 在 山 寨 ， 非 利 士 人 的 防 营 在 伯 利 恒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8669', '10', '23', '15', '大 卫 渴 想 ， 说 ： 甚 愿 有 人 将 伯 利 恒 城 门 旁 、 井 里 的 水 打 来 给 我 喝 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8670', '10', '23', '16', '这 三 个 勇 士 就 闯 过 非 利 士 人 的 营 盘 ， 从 伯 利 恒 城 门 旁 的 井 里 打 水 ， 拿 来 奉 给 大 卫 。 他 却 不 肯 喝 ， 将 水 奠 在 耶 和 华 面 前 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8671', '10', '23', '17', '说 ： 耶 和 华 啊 ， 这 三 个 人 冒 死 去 打 水 ； 这 水 好 像 他 们 的 血 一 般 ， 我 断 不 敢 喝 。 如 此 ， 大 卫 不 肯 喝 。 这 是 三 个 勇 士 所 做 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8672', '10', '23', '18', '洗 鲁 雅 的 儿 子 、 约 押 的 兄 弟 亚 比 筛 是 这 三 个 勇 士 的 首 领 ； 他 举 枪 杀 了 三 百 人 ， 就 在 三 个 勇 士 里 得 了 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8673', '10', '23', '19', '他 在 这 三 个 勇 士 里 是 最 尊 贵 的 ， 所 以 作 他 们 的 首 领 ， 只 是 不 及 前 三 个 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8674', '10', '23', '20', '有 甲 薛 勇 士 耶 何 耶 大 的 儿 子 比 拿 雅 行 过 大 能 的 事 ； 他 杀 了 摩 押 人 亚 利 伊 勒 的 两 个 儿 子 ， 又 在 下 雪 的 时 候 下 坑 里 去 ， 杀 了 一 个 狮 子 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8675', '10', '23', '21', '又 杀 了 一 个 强 壮 的 埃 及 人 ； 埃 及 人 手 里 拿 着 枪 ， 比 拿 雅 只 拿 着 棍 子 下 去 ， 从 埃 及 人 手 里 夺 过 枪 来 ， 用 那 枪 将 他 杀 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8676', '10', '23', '22', '这 是 耶 何 耶 大 的 儿 子 比 拿 雅 所 行 的 事 ， 就 在 三 个 勇 士 里 得 了 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8677', '10', '23', '23', '他 比 那 三 十 个 勇 士 都 尊 贵 ， 只 是 不 及 前 三 个 勇 士 。 大 卫 立 他 作 护 卫 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8678', '10', '23', '24', '三 十 个 勇 士 里 有 约 押 的 兄 弟 亚 撒 黑 ， 伯 利 恒 人 朵 多 的 儿 子 伊 勒 哈 难 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8679', '10', '23', '25', '哈 律 人 沙 玛 ， 哈 律 人 以 利 加 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8680', '10', '23', '26', '帕 勒 提 人 希 利 斯 ， 提 哥 亚 人 益 吉 的 儿 子 以 拉 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8681', '10', '23', '27', '亚 拿 突 人 亚 比 以 谢 ， 户 沙 人 米 本 乃 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8682', '10', '23', '28', '亚 合 人 撒 们 ， 尼 陀 法 人 玛 哈 莱 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8683', '10', '23', '29', '尼 陀 法 人 巴 拿 的 儿 子 希 立 ， 便 雅 悯 族 、 基 比 亚 人 利 拜 的 儿 子 以 太 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8684', '10', '23', '30', '比 拉 顿 人 比 拿 雅 ， 迦 实 溪 人 希 太 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8685', '10', '23', '31', '伯 亚 拉 巴 人 亚 比 亚 本 ， 巴 鲁 米 人 押 斯 玛 弗 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8686', '10', '23', '32', '沙 本 人 以 利 雅 哈 巴 ， 雅 善 儿 子 中 的 约 拿 单 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8687', '10', '23', '33', '哈 拉 人 沙 玛 ， 哈 拉 人 沙 拉 的 儿 子 亚 希 暗 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8688', '10', '23', '34', '玛 迦 人 亚 哈 拜 的 儿 子 以 利 法 列 ， 基 罗 人 亚 希 多 弗 的 儿 子 以 连 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8689', '10', '23', '35', '迦 密 人 希 斯 莱 ， 亚 巴 人 帕 莱 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8690', '10', '23', '36', '琐 巴 人 拿 单 的 儿 子 以 甲 ， 迦 得 人 巴 尼 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8691', '10', '23', '37', '亚 扪 人 洗 勒 ， 比 录 人 拿 哈 莱 （ 是 给 洗 鲁 雅 的 儿 子 约 押 拿 兵 器 的 ） ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8692', '10', '23', '38', '以 帖 人 以 拉 ， 以 帖 人 迦 立 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8693', '10', '23', '39', '赫 人 乌 利 亚 ， 共 有 三 十 七 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8694', '10', '24', '1', '耶 和 华 又 向 以 色 列 人 发 怒 ， 就 激 动 大 卫 ， 使 他 吩 咐 人 去 数 点 以 色 列 人 和 犹 大 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8695', '10', '24', '2', '大 卫 就 吩 咐 跟 随 他 的 元 帅 约 押 说 ： 你 去 走 遍 以 色 列 众 支 派 ， 从 但 直 到 别 是 巴 ， 数 点 百 姓 ， 我 好 知 道 他 们 的 数 目 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8696', '10', '24', '3', '约 押 对 王 说 ： 无 论 百 姓 多 少 ， 愿 耶 和 华 ─ 你 的 　 神 再 加 增 百 倍 ， 使 我 主 我 王 亲 眼 得 见 。 我 主 我 王 何 必 喜 悦 行 这 事 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8697', '10', '24', '4', '但 王 的 命 令 胜 过 约 押 和 众 军 长 。 约 押 和 众 军 长 就 从 王 面 前 出 去 ， 数 点 以 色 列 的 百 姓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8698', '10', '24', '5', '他 们 过 了 约 但 河 ， 在 迦 得 谷 中 、 城 的 右 边 亚 罗 珥 安 营 ， 与 雅 谢 相 对 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8699', '10', '24', '6', '又 到 了 基 列 和 他 停 合 示 地 ， 又 到 了 但 雅 安 ， 绕 到 西 顿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8700', '10', '24', '7', '来 到 推 罗 的 保 障 ， 并 希 未 人 和 迦 南 人 的 各 城 ， 又 到 犹 大 南 方 的 别 是 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8701', '10', '24', '8', '他 们 走 遍 全 地 ， 过 了 九 个 月 零 二 十 天 ， 就 回 到 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8702', '10', '24', '9', '约 押 将 百 姓 的 总 数 奏 告 於 王 ： 以 色 列 拿 刀 的 勇 士 有 八 十 万 ； 犹 大 有 五 十 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8703', '10', '24', '10', '大 卫 数 点 百 姓 以 後 ， 就 心 中 自 责 ， 祷 告 耶 和 华 说 ： 我 行 这 事 大 有 罪 了 。 耶 和 华 啊 ， 求 你 除 掉 仆 人 的 罪 孽 ， 因 我 所 行 的 甚 是 愚 昧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8704', '10', '24', '11', '大 卫 早 晨 起 来 ， 耶 和 华 的 话 临 到 先 知 迦 得 ， 就 是 大 卫 的 先 见 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8705', '10', '24', '12', '你 去 告 诉 大 卫 ， 说 耶 和 华 如 此 说 ： 我 有 三 样 灾 ， 随 你 选 择 一 样 ， 我 好 降 与 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8706', '10', '24', '13', '於 是 迦 得 来 见 大 卫 ， 对 他 说 ： 你 愿 意 国 中 有 七 年 的 饥 荒 呢 ？ 是 在 你 敌 人 面 前 逃 跑 ， 被 追 赶 三 个 月 呢 ？ 是 在 你 国 中 有 三 日 的 瘟 疫 呢 ？ 现 在 你 要 揣 摩 思 想 ， 我 好 回 覆 那 差 我 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8707', '10', '24', '14', '大 卫 对 迦 得 说 ： 我 甚 为 难 ！ 我 愿 落 在 耶 和 华 的 手 里 ， 因 为 他 有 丰 盛 的 怜 悯 。 我 不 愿 落 在 人 的 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8708', '10', '24', '15', '於 是 ， 耶 和 华 降 瘟 疫 与 以 色 列 人 ， 自 早 晨 到 所 定 的 时 候 ； 从 但 直 到 别 是 巴 ， 民 间 死 了 七 万 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8709', '10', '24', '16', '天 使 向 耶 路 撒 冷 伸 手 要 灭 城 的 时 候 ， 耶 和 华 後 悔 ， 就 不 降 这 灾 了 ， 吩 咐 灭 民 的 天 使 说 ： 够 了 ！ 住 手 罢 ！ 那 时 耶 和 华 的 使 者 在 耶 布 斯 人 亚 劳 拿 的 禾 场 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8710', '10', '24', '17', '大 卫 看 见 灭 民 的 天 使 ， 就 祷 告 耶 和 华 说 ： 我 犯 了 罪 ， 行 了 恶 ； 但 这 群 羊 做 了 甚 麽 呢 ？ 愿 你 的 手 攻 击 我 和 我 的 父 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8711', '10', '24', '18', '当 日 ， 迦 得 来 见 大 卫 ， 对 他 说 ： 你 上 去 ， 在 耶 布 斯 人 亚 劳 拿 的 禾 场 上 为 耶 和 华 筑 一 座 坛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8712', '10', '24', '19', '大 卫 就 照 着 迦 得 奉 耶 和 华 名 所 说 的 话 上 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8713', '10', '24', '20', '亚 劳 拿 观 看 ， 见 王 和 他 臣 仆 前 来 ， 就 迎 接 出 去 ， 脸 伏 於 地 ， 向 王 下 拜 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8714', '10', '24', '21', '说 ： 我 主 我 王 为 何 来 到 仆 人 这 里 呢 ？ 大 卫 说 ： 我 要 买 你 这 禾 场 ， 为 耶 和 华 筑 一 座 坛 ， 使 民 间 的 瘟 疫 止 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8715', '10', '24', '22', '亚 劳 拿 对 大 卫 说 ： 我 主 我 王 ， 你 喜 悦 用 甚 麽 ， 就 拿 去 献 祭 。 看 哪 ， 这 里 有 牛 可 以 作 燔 祭 ， 有 打 粮 的 器 具 和 套 牛 的 轭 可 以 当 柴 烧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8716', '10', '24', '23', '王 啊 ， 这 一 切 ， 我 亚 劳 拿 都 奉 给 你 ； 又 对 王 说 ： 愿 耶 和 华 ─ 你 的 　 神 悦 纳 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8717', '10', '24', '24', '王 对 亚 劳 拿 说 ： 不 然 。 我 必 要 按 着 价 值 向 你 买 ； 我 不 肯 用 白 得 之 物 作 燔 祭 献 给 耶 和 华 ─ 我 的 　 神 。 大 卫 就 用 五 十 舍 客 勒 银 子 买 了 那 禾 场 与 牛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8718', '10', '24', '25', '大 卫 在 那 里 为 耶 和 华 筑 了 一 座 坛 ， 献 燔 祭 和 平 安 祭 。 如 此 ， 耶 和 华 垂 听 国 民 所 求 的 ， 瘟 疫 在 以 色 列 人 中 就 止 住 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8719', '11', '1', '1', '大 卫 王 年 纪 老 迈 ， 虽 用 被 遮 盖 ， 仍 不 觉 暖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8720', '11', '1', '2', '所 以 臣 仆 对 他 说 ： 不 如 为 我 主 我 王 寻 找 一 个 处 女 ， 使 他 伺 候 王 ， 奉 养 王 ， 睡 在 王 的 怀 中 ， 好 叫 我 主 我 王 得 暖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8721', '11', '1', '3', '於 是 在 以 色 列 全 境 寻 找 美 貌 的 童 女 ， 寻 得 书 念 的 一 个 童 女 亚 比 煞 ， 就 带 到 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8722', '11', '1', '4', '这 童 女 极 其 美 貌 ， 他 奉 养 王 ， 伺 候 王 ， 王 却 没 有 与 他 亲 近 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8723', '11', '1', '5', '那 时 ， 哈 及 的 儿 子 亚 多 尼 雅 自 尊 ， 说 ： 我 必 作 王 ， 就 为 自 己 预 备 车 辆 、 马 兵 ， 又 派 五 十 人 在 他 前 头 奔 走 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8724', '11', '1', '6', '他 父 亲 素 来 没 有 使 他 忧 闷 ， 说 ： 你 是 做 甚 麽 呢 ？ 他 甚 俊 美 ， 生 在 押 沙 龙 之 後 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8725', '11', '1', '7', '亚 多 尼 雅 与 洗 鲁 雅 的 儿 子 约 押 ， 和 祭 司 亚 比 亚 他 商 议 ； 二 人 就 顺 从 他 ， 帮 助 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8726', '11', '1', '8', '但 祭 司 撒 督 、 耶 何 耶 大 的 儿 子 比 拿 雅 、 先 知 拿 单 、 示 每 、 利 以 ， 并 大 卫 的 勇 士 都 不 顺 从 亚 多 尼 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8727', '11', '1', '9', '一 日 ， 亚 多 尼 雅 在 隐 罗 结 旁 、 琐 希 列 磐 石 那 里 宰 了 牛 羊 、 肥 犊 ， 请 他 的 诸 弟 兄 ， 就 是 王 的 众 子 ， 并 所 有 作 王 臣 仆 的 犹 大 人 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8728', '11', '1', '10', '惟 独 先 知 拿 单 和 比 拿 雅 并 勇 士 ， 与 他 的 兄 弟 所 罗 门 ， 他 都 没 有 请 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8729', '11', '1', '11', '拿 单 对 所 罗 门 的 母 亲 拔 示 巴 说 ： 哈 及 的 儿 子 亚 多 尼 雅 作 王 了 ， 你 没 有 听 见 麽 ？ 我 们 的 主 大 卫 却 不 知 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8730', '11', '1', '12', '现 在 我 可 以 给 你 出 个 主 意 ， 好 保 全 你 和 你 儿 子 所 罗 门 的 性 命 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8731', '11', '1', '13', '你 进 去 见 大 卫 王 ， 对 他 说 ： 我 主 我 王 啊 ， 你 不 曾 向 婢 女 起 誓 说 ： 你 儿 子 所 罗 门 必 接 续 我 作 王 ， 坐 在 我 的 位 上 麽 ？ 现 在 亚 多 尼 雅 怎 麽 作 了 王 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8732', '11', '1', '14', '你 还 与 王 说 话 的 时 候 ， 我 也 随 後 进 去 ， 证 实 你 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8733', '11', '1', '15', '拔 示 巴 进 入 内 室 见 王 ， 王 甚 老 迈 ， 书 念 的 童 女 亚 比 煞 正 伺 候 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8734', '11', '1', '16', '拔 示 巴 向 王 屈 身 下 拜 ； 王 说 ： 你 要 甚 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8735', '11', '1', '17', '他 说 ： 我 主 啊 ， 你 曾 向 婢 女 指 着 耶 和 华 ─ 你 的 　 神 起 誓 说 ： 你 儿 子 所 罗 门 必 接 续 我 作 王 ， 坐 在 我 的 位 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8736', '11', '1', '18', '现 在 亚 多 尼 雅 作 王 了 ， 我 主 我 王 却 不 知 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8737', '11', '1', '19', '他 宰 了 许 多 牛 羊 、 肥 犊 ， 请 了 王 的 众 子 和 祭 司 亚 比 亚 他 ， 并 元 帅 约 押 ； 惟 独 王 的 仆 人 所 罗 门 ， 他 没 有 请 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8738', '11', '1', '20', '我 主 我 王 啊 ， 以 色 列 众 人 的 眼 目 都 仰 望 你 ， 等 你 晓 谕 他 们 ， 在 我 主 我 王 之 後 谁 坐 你 的 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8739', '11', '1', '21', '若 不 然 ， 到 我 主 我 王 与 列 祖 同 睡 以 後 ， 我 和 我 儿 子 所 罗 门 必 算 为 罪 人 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8740', '11', '1', '22', '拔 示 巴 还 与 王 说 话 的 时 候 ， 先 知 拿 单 也 进 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8741', '11', '1', '23', '有 人 奏 告 王 说 ： 先 知 拿 单 来 了 。 拿 单 进 到 王 前 ， 脸 伏 於 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8742', '11', '1', '24', '拿 单 说 ： 我 主 我 王 果 然 应 许 亚 多 尼 雅 说 你 必 接 续 我 作 王 ， 坐 在 我 的 位 上 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8743', '11', '1', '25', '他 今 日 下 去 ， 宰 了 许 多 牛 羊 、 肥 犊 ， 请 了 王 的 众 子 和 军 长 ， 并 祭 司 亚 比 亚 他 ； 他 们 正 在 亚 多 尼 雅 面 前 吃 喝 ， 说 ： 愿 亚 多 尼 雅 王 万 岁 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8744', '11', '1', '26', '惟 独 我 ， 就 是 你 的 仆 人 和 祭 司 撒 督 ， 耶 何 耶 大 的 儿 子 比 拿 雅 ， 并 王 的 仆 人 所 罗 门 ， 他 都 没 有 请 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8745', '11', '1', '27', '这 事 果 然 出 乎 我 主 我 王 麽 ？ 王 却 没 有 告 诉 仆 人 们 ， 在 我 主 我 王 之 後 谁 坐 你 的 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8746', '11', '1', '28', '大 卫 王 吩 咐 说 ： 叫 拔 示 巴 来 。 拔 示 巴 就 进 来 ， 站 在 王 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8747', '11', '1', '29', '王 起 誓 说 ： 我 指 着 救 我 性 命 脱 离 一 切 苦 难 、 永 生 的 耶 和 华 起 誓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8748', '11', '1', '30', '我 既 然 指 着 耶 和 华 ─ 以 色 列 的 　 神 向 你 起 誓 说 ： 你 儿 子 所 罗 门 必 接 续 我 作 王 ， 坐 在 我 的 位 上 。 我 今 日 就 必 照 这 话 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8749', '11', '1', '31', '於 是 ， 拔 示 巴 脸 伏 於 地 ， 向 王 下 拜 ， 说 ： 愿 我 主 大 卫 王 万 岁 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8750', '11', '1', '32', '大 卫 王 又 吩 咐 说 ： 将 祭 司 撒 督 、 先 知 拿 单 、 耶 何 耶 大 的 儿 子 比 拿 雅 召 来 ！ 他 们 就 都 来 到 王 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8751', '11', '1', '33', '王 对 他 们 说 ： 要 带 领 你 们 主 的 仆 人 ， 使 我 儿 子 所 罗 门 骑 我 的 骡 子 ， 送 他 下 到 基 训 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8752', '11', '1', '34', '在 那 里 ， 祭 司 撒 督 和 先 知 拿 单 要 膏 他 作 以 色 列 的 王 ； 你 们 也 要 吹 角 ， 说 ： 愿 所 罗 门 王 万 岁 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8753', '11', '1', '35', '然 後 要 跟 随 他 上 来 ， 使 他 坐 在 我 的 位 上 ， 接 续 我 作 王 。 我 已 立 他 作 以 色 列 和 犹 大 的 君 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8754', '11', '1', '36', '耶 何 耶 大 的 儿 子 比 拿 雅 对 王 说 ： 阿 们 ！ 愿 耶 和 华 ─ 我 主 我 王 的 　 神 也 这 样 命 定 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8755', '11', '1', '37', '耶 和 华 怎 样 与 我 主 我 王 同 在 ， 愿 他 照 样 与 所 罗 门 同 在 ， 使 他 的 国 位 比 我 主 大 卫 王 的 国 位 更 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8756', '11', '1', '38', '於 是 ， 祭 司 撒 督 、 先 知 拿 单 、 耶 何 耶 大 的 儿 子 比 拿 雅 ， 和 基 利 提 人 、 比 利 提 人 都 下 去 使 所 罗 门 骑 大 卫 王 的 骡 子 ， 将 他 送 到 基 训 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8757', '11', '1', '39', '祭 司 撒 督 就 从 帐 幕 中 取 了 盛 膏 油 的 角 来 ， 用 膏 膏 所 罗 门 。 人 就 吹 角 ， 众 民 都 说 ： 愿 所 罗 门 王 万 岁 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8758', '11', '1', '40', '众 民 跟 随 他 上 来 ， 且 吹 笛 ， 大 大 欢 呼 ， 声 音 震 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8759', '11', '1', '41', '亚 多 尼 雅 和 所 请 的 众 客 筵 宴 方 毕 ， 听 见 这 声 音 ； 约 押 听 见 角 声 就 说 ： 城 中 为 何 有 这 响 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8760', '11', '1', '42', '他 正 说 话 的 时 候 ， 祭 司 亚 比 亚 他 的 儿 子 约 拿 单 来 了 。 亚 多 尼 雅 对 他 说 ： 进 来 罢 ！ 你 是 个 忠 义 的 人 ， 必 是 报 好 信 息 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8761', '11', '1', '43', '约 拿 单 对 亚 多 尼 雅 说 ： 我 们 的 主 大 卫 王 诚 然 立 所 罗 门 为 王 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8762', '11', '1', '44', '王 差 遣 祭 司 撒 督 、 先 知 拿 单 、 耶 何 耶 大 的 儿 子 比 拿 雅 ， 和 基 利 提 人 、 比 利 提 人 都 去 使 所 罗 门 骑 王 的 骡 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8763', '11', '1', '45', '祭 司 撒 督 和 先 知 拿 单 在 基 训 已 经 膏 他 作 王 。 众 人 都 从 那 里 欢 呼 着 上 来 ， 声 音 使 城 震 动 ， 这 就 是 你 们 所 听 见 的 声 音 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8764', '11', '1', '46', '并 且 所 罗 门 登 了 国 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8765', '11', '1', '47', '王 的 臣 仆 也 来 为 我 们 的 主 大 卫 王 祝 福 ， 说 ： 愿 王 的 　 神 使 所 罗 门 的 名 比 王 的 名 更 尊 荣 ； 使 他 的 国 位 比 王 的 国 位 更 大 。 王 就 在 床 上 屈 身 下 拜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8766', '11', '1', '48', '王 又 说 ： 耶 和 华 ─ 以 色 列 的 　 神 是 应 当 称 颂 的 ； 因 他 赐 我 一 人 今 日 坐 在 我 的 位 上 ， 我 也 亲 眼 看 见 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8767', '11', '1', '49', '亚 多 尼 雅 的 众 客 听 见 这 话 就 都 惊 惧 ， 起 来 四 散 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8768', '11', '1', '50', '亚 多 尼 雅 惧 怕 所 罗 门 ， 就 起 来 ， 去 抓 住 祭 坛 的 角 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8769', '11', '1', '51', '有 人 告 诉 所 罗 门 说 ： 亚 多 尼 雅 惧 怕 所 罗 门 王 ， 现 在 抓 住 祭 坛 的 角 ， 说 ： 愿 所 罗 门 王 今 日 向 我 起 誓 ， 必 不 用 刀 杀 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8770', '11', '1', '52', '所 罗 门 说 ： 他 若 作 忠 义 的 人 ， 连 一 根 头 发 也 不 致 落 在 地 上 ； 他 若 行 恶 ， 必 要 死 亡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8771', '11', '1', '53', '於 是 所 罗 门 王 差 遣 人 ， 使 亚 多 尼 雅 从 坛 上 下 来 ， 他 就 来 ， 向 所 罗 门 王 下 拜 ； 所 罗 门 对 他 说 ： 你 回 家 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8772', '11', '2', '1', '大 卫 的 死 期 临 近 了 ， 就 嘱 吩 他 儿 子 所 罗 门 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8773', '11', '2', '2', '我 现 在 要 走 世 人 必 走 的 路 。 所 以 ， 你 当 刚 强 ， 作 大 丈 夫 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8774', '11', '2', '3', '遵 守 耶 和 华 ─ 你 　 神 所 吩 咐 的 ， 照 着 摩 西 律 法 上 所 写 的 行 主 的 道 ， 谨 守 他 的 律 例 、 诫 命 、 典 章 、 法 度 。 这 样 ， 你 无 论 做 甚 麽 事 ， 不 拘 往 何 处 去 ， 尽 都 亨 通 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8775', '11', '2', '4', '耶 和 华 必 成 就 向 我 所 应 许 的 话 说 ： 你 的 子 孙 若 谨 慎 自 己 的 行 为 ， 尽 心 尽 意 诚 诚 实 实 地 行 在 我 面 前 ， 就 不 断 人 坐 以 色 列 的 国 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8776', '11', '2', '5', '你 知 道 洗 鲁 雅 的 儿 子 约 押 向 我 所 行 的 ， 就 是 杀 了 以 色 列 的 两 个 元 帅 ： 尼 珥 的 儿 子 押 尼 珥 和 益 帖 儿 子 亚 玛 撒 。 他 在 太 平 之 时 流 这 二 人 的 血 ， 如 在 争 战 之 时 一 样 ， 将 这 血 染 了 腰 间 束 的 带 和 脚 上 穿 的 鞋 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8777', '11', '2', '6', '所 以 你 要 照 你 的 智 慧 行 ， 不 容 他 白 头 安 然 下 阴 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8778', '11', '2', '7', '你 当 恩 待 基 列 人 巴 西 莱 的 众 子 ， 使 他 们 常 与 你 同 席 吃 饭 ； 因 为 我 躲 避 你 哥 哥 押 沙 龙 的 时 候 ， 他 们 拿 食 物 来 迎 接 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8779', '11', '2', '8', '在 你 这 里 有 巴 户 琳 的 便 雅 悯 人 ， 基 拉 的 儿 子 示 每 ； 我 往 玛 哈 念 去 的 那 日 ， 他 用 狠 毒 的 言 语 咒 骂 我 ， 後 来 却 下 约 但 河 迎 接 我 ， 我 就 指 着 耶 和 华 向 他 起 誓 说 ： 我 必 不 用 刀 杀 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8780', '11', '2', '9', '现 在 你 不 要 以 他 为 无 罪 。 你 是 聪 明 人 ， 必 知 道 怎 样 待 他 ， 使 他 白 头 见 杀 ， 流 血 下 到 阴 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8781', '11', '2', '10', '大 卫 与 他 列 祖 同 睡 ， 葬 在 大 卫 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8782', '11', '2', '11', '大 卫 作 以 色 列 王 四 十 年 ： 在 希 伯 仑 作 王 七 年 ， 在 耶 路 撒 冷 作 王 三 十 三 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8783', '11', '2', '12', '所 罗 门 坐 他 父 亲 大 卫 的 位 ， 他 的 国 甚 是 坚 固 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8784', '11', '2', '13', '哈 及 的 儿 子 亚 多 尼 雅 去 见 所 罗 门 的 母 亲 拔 示 巴 ， 拔 示 巴 问 他 说 ： 你 来 是 为 平 安 麽 ？ 回 答 说 ： 是 为 平 安 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8785', '11', '2', '14', '又 说 ： 我 有 话 对 你 说 。 拔 示 巴 说 ： 你 说 罢 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8786', '11', '2', '15', '亚 多 尼 雅 说 ： 你 知 道 国 原 是 归 我 的 ， 以 色 列 众 人 也 都 仰 望 我 作 王 ， 不 料 ， 国 反 归 了 我 兄 弟 ， 因 他 得 国 是 出 乎 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8787', '11', '2', '16', '现 在 我 有 一 件 事 求 你 ， 望 你 不 要 推 辞 。 拔 示 巴 说 ： 你 说 罢 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8788', '11', '2', '17', '他 说 ： 求 你 请 所 罗 门 王 将 书 念 的 女 子 亚 比 煞 赐 我 为 妻 ， 因 他 必 不 推 辞 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8789', '11', '2', '18', '拔 示 巴 说 ： 好 ， 我 必 为 你 对 王 提 说 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8790', '11', '2', '19', '於 是 ， 拔 示 巴 去 见 所 罗 门 王 ， 要 为 亚 多 尼 雅 提 说 ； 王 起 来 迎 接 ， 向 他 下 拜 ， 就 坐 在 位 上 ， 吩 咐 人 为 王 母 设 一 座 位 ， 他 便 坐 在 王 的 右 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8791', '11', '2', '20', '拔 示 巴 说 ： 我 有 一 件 小 事 求 你 ， 望 你 不 要 推 辞 。 王 说 ： 请 母 亲 说 ， 我 必 不 推 辞 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8792', '11', '2', '21', '拔 示 巴 说 ： 求 你 将 书 念 的 女 子 亚 比 煞 赐 给 你 哥 哥 亚 多 尼 雅 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8793', '11', '2', '22', '所 罗 门 王 对 他 母 亲 说 ： 为 何 单 替 他 求 书 念 的 女 子 亚 比 煞 呢 ？ 也 可 以 为 他 求 国 罢 ！ 他 是 我 的 哥 哥 ， 他 有 祭 司 亚 比 亚 他 和 洗 鲁 雅 的 儿 子 约 押 为 辅 佐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8794', '11', '2', '23', '所 罗 门 王 就 指 着 耶 和 华 起 誓 说 ： 亚 多 尼 雅 这 话 是 自 己 送 命 ， 不 然 ， 愿 　 神 重 重 地 降 罚 与 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8795', '11', '2', '24', '耶 和 华 坚 立 我 ， 使 我 坐 在 父 亲 大 卫 的 位 上 ， 照 着 所 应 许 的 话 为 我 建 立 家 室 ； 现 在 我 指 着 永 生 的 耶 和 华 起 誓 ， 亚 多 尼 雅 今 日 必 被 治 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8796', '11', '2', '25', '於 是 所 罗 门 王 差 遣 耶 何 耶 大 的 儿 子 比 拿 雅 ， 将 亚 多 尼 雅 杀 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8797', '11', '2', '26', '王 对 祭 司 亚 比 亚 他 说 ： 你 回 亚 拿 突 归 自 己 的 田 地 去 罢 ！ 你 本 是 该 死 的 ， 但 因 你 在 我 父 亲 大 卫 面 前 抬 过 主 耶 和 华 的 约 柜 ， 又 与 我 父 亲 同 受 一 切 苦 难 ， 所 以 我 今 日 不 将 你 杀 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8798', '11', '2', '27', '所 罗 门 就 革 除 亚 比 亚 他 ， 不 许 他 作 耶 和 华 的 祭 司 。 这 样 ， 便 应 验 耶 和 华 在 示 罗 论 以 利 家 所 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8799', '11', '2', '28', '约 押 虽 然 没 有 归 从 押 沙 龙 ， 却 归 从 了 亚 多 尼 雅 。 他 听 见 这 风 声 ， 就 逃 到 耶 和 华 的 帐 幕 ， 抓 住 祭 坛 的 角 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8800', '11', '2', '29', '有 人 告 诉 所 罗 门 王 说 ： 约 押 逃 到 耶 和 华 的 帐 幕 ， 现 今 在 祭 坛 的 旁 边 。 所 罗 门 就 差 遣 耶 何 耶 大 的 儿 子 比 拿 雅 ， 说 你 去 将 他 杀 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8801', '11', '2', '30', '比 拿 雅 来 到 耶 和 华 的 帐 幕 ， 对 约 押 说 ： 王 吩 咐 说 ， 你 出 来 罢 ！ 他 说 ： 我 不 出 去 ， 我 要 死 在 这 里 。 比 拿 雅 就 去 回 覆 王 ， 说 约 押 如 此 如 此 回 答 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8802', '11', '2', '31', '王 说 ： 你 可 以 照 着 他 的 话 行 ， 杀 死 他 ， 将 他 葬 埋 ， 好 叫 约 押 流 无 辜 人 血 的 罪 不 归 我 和 我 的 父 家 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8803', '11', '2', '32', '耶 和 华 必 使 约 押 流 人 血 的 罪 归 到 他 自 己 的 头 上 ； 因 为 他 用 刀 杀 了 两 个 比 他 又 义 又 好 的 人 ， 就 是 以 色 列 元 帅 尼 珥 的 儿 子 押 尼 珥 和 犹 大 元 帅 益 帖 的 儿 子 亚 玛 撒 ， 我 父 亲 大 卫 却 不 知 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8804', '11', '2', '33', '故 此 ， 流 这 二 人 血 的 罪 必 归 到 约 押 和 他 後 裔 的 头 上 ， 直 到 永 远 ； 惟 有 大 卫 和 他 的 後 裔 ， 并 他 的 家 与 国 ， 必 从 耶 和 华 那 里 得 平 安 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8805', '11', '2', '34', '於 是 耶 何 耶 大 的 儿 子 比 拿 雅 上 去 ， 将 约 押 杀 死 ， 葬 在 旷 野 约 押 自 己 的 坟 墓 ( 原 文 作 房 屋 ) 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8806', '11', '2', '35', '王 就 立 耶 何 耶 大 的 儿 子 比 拿 雅 作 元 帅 ， 代 替 约 押 ， 又 使 祭 司 撒 督 代 替 亚 比 亚 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8807', '11', '2', '36', '王 差 遣 人 将 示 每 召 来 ， 对 他 说 ： 你 要 在 耶 路 撒 冷 建 造 房 屋 居 住 ， 不 可 出 来 往 别 处 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8808', '11', '2', '37', '你 当 确 实 地 知 道 ， 你 何 日 出 来 过 汲 沦 溪 ， 何 日 必 死 ！ 你 的 罪 ( 原 文 作 血 ) 必 归 到 自 己 的 头 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8809', '11', '2', '38', '示 每 对 王 说 ： 这 话 甚 好 ！ 我 主 我 王 怎 样 说 ， 仆 人 必 怎 样 行 。 於 是 示 每 多 日 住 在 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8810', '11', '2', '39', '过 了 三 年 ， 示 每 的 两 个 仆 人 逃 到 迦 特 王 玛 迦 的 儿 子 亚 吉 那 里 去 。 有 人 告 诉 示 每 说 ： 你 的 仆 人 在 迦 特 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8811', '11', '2', '40', '示 每 起 来 ， 备 上 驴 ， 往 迦 特 到 亚 吉 那 里 去 找 他 的 仆 人 ， 就 从 迦 特 带 他 仆 人 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8812', '11', '2', '41', '有 人 告 诉 所 罗 门 说 ： 示 每 出 耶 路 撒 冷 往 迦 特 去 ， 回 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8813', '11', '2', '42', '王 就 差 遣 人 将 示 每 召 了 来 ， 对 他 说 ： 我 岂 不 是 叫 你 指 着 耶 和 华 起 誓 ， 并 且 警 戒 你 说 你 当 确 实 地 知 道 ， 你 哪 日 出 来 往 别 处 去 ， 那 日 必 死 麽 ？ 你 也 对 我 说 ： 这 话 甚 好 ， 我 必 听 从 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8814', '11', '2', '43', '现 在 你 为 何 不 遵 守 你 指 着 耶 和 华 起 的 誓 和 我 所 吩 咐 你 的 命 令 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8815', '11', '2', '44', '王 又 对 示 每 说 ： 你 向 我 父 亲 大 卫 所 行 的 一 切 恶 事 ， 你 自 己 心 里 也 知 道 ， 所 以 耶 和 华 必 使 你 的 罪 恶 归 到 自 己 的 头 上 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8816', '11', '2', '45', '惟 有 所 罗 门 王 必 得 福 ， 并 且 大 卫 的 国 位 必 在 耶 和 华 面 前 坚 定 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8817', '11', '2', '46', '於 是 王 吩 咐 耶 何 耶 大 的 儿 子 比 拿 雅 ， 他 就 去 杀 死 示 每 。 这 样 ， 便 坚 定 了 所 罗 门 的 国 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8818', '11', '3', '1', '所 罗 门 与 埃 及 王 法 老 结 亲 ， 娶 了 法 老 的 女 儿 为 妻 ， 接 他 进 入 大 卫 城 ， 直 等 到 造 完 了 自 己 的 宫 和 耶 和 华 的 殿 ， 并 耶 路 撒 冷 周 围 的 城 墙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8819', '11', '3', '2', '当 那 些 日 子 ， 百 姓 仍 在 邱 坛 献 祭 ， 因 为 还 没 有 为 耶 和 华 的 名 建 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8820', '11', '3', '3', '所 罗 门 爱 耶 和 华 ， 遵 行 他 父 亲 大 卫 的 律 例 ， 只 是 还 在 邱 坛 献 祭 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8821', '11', '3', '4', '所 罗 门 王 上 基 遍 去 献 祭 ； 因 为 在 那 里 有 极 大 ( 或 作 出 名 ) 的 邱 坛 ， 他 在 那 坛 上 献 一 千 牺 牲 作 燔 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8822', '11', '3', '5', '在 基 遍 ， 夜 间 梦 中 ， 耶 和 华 向 所 罗 门 显 现 ， 对 他 说 ： 你 愿 我 赐 你 甚 麽 ？ 你 可 以 求 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8823', '11', '3', '6', '所 罗 门 说 ： 你 仆 人 ─ 我 父 亲 大 卫 用 诚 实 、 公 义 、 正 直 的 心 行 在 你 面 前 ， 你 就 向 他 大 施 恩 典 ， 又 为 他 存 留 大 恩 ， 赐 他 一 个 儿 子 坐 在 他 的 位 上 ， 正 如 今 日 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8824', '11', '3', '7', '耶 和 华 ─ 我 的 　 神 啊 ， 如 今 你 使 仆 人 接 续 我 父 亲 大 卫 作 王 ； 但 我 是 幼 童 ， 不 知 道 应 当 怎 样 出 入 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8825', '11', '3', '8', '仆 人 住 在 你 所 拣 选 的 民 中 ， 这 民 多 得 不 可 胜 数 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8826', '11', '3', '9', '所 以 求 你 赐 我 智 慧 ， 可 以 判 断 你 的 民 ， 能 辨 别 是 非 。 不 然 ， 谁 能 判 断 这 众 多 的 民 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8827', '11', '3', '10', '所 罗 门 因 为 求 这 事 ， 就 蒙 主 喜 悦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8828', '11', '3', '11', '　 神 对 他 说 ： 你 既 然 求 这 事 ， 不 为 自 己 求 寿 、 求 富 ， 也 不 求 灭 绝 你 仇 敌 的 性 命 ， 单 求 智 慧 可 以 听 讼 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8829', '11', '3', '12', '我 就 应 允 你 所 求 的 ， 赐 你 聪 明 智 慧 ， 甚 至 在 你 以 前 没 有 像 你 的 ， 在 你 以 後 也 没 有 像 你 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8830', '11', '3', '13', '你 所 没 有 求 的 ， 我 也 赐 给 你 ， 就 是 富 足 、 尊 荣 ， 使 你 在 世 的 日 子 ， 列 王 中 没 有 一 个 能 比 你 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8831', '11', '3', '14', '你 若 效 法 你 父 亲 大 卫 ， 遵 行 我 的 道 ， 谨 守 我 的 律 例 、 诫 命 ， 我 必 使 你 长 寿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8832', '11', '3', '15', '所 罗 门 醒 了 ， 不 料 是 个 梦 。 他 就 回 到 耶 路 撒 冷 ， 站 在 耶 和 华 的 约 柜 前 ， 献 燔 祭 和 平 安 祭 ， 又 为 他 众 臣 仆 设 摆 筵 席 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8833', '11', '3', '16', '一 日 ， 有 两 个 妓 女 来 ， 站 在 王 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8834', '11', '3', '17', '一 个 说 ： 我 主 啊 ， 我 和 这 妇 人 同 住 一 房 ； 他 在 房 中 的 时 候 ， 我 生 了 一 个 男 孩 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8835', '11', '3', '18', '我 生 孩 子 後 第 三 日 ， 这 妇 人 也 生 了 孩 子 。 我 们 是 同 住 的 ， 除 了 我 们 二 人 之 外 ， 房 中 再 没 有 别 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8836', '11', '3', '19', '夜 间 ， 这 妇 人 睡 着 的 时 候 ， 压 死 了 他 的 孩 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8837', '11', '3', '20', '他 半 夜 起 来 ， 趁 我 睡 着 ， 从 我 旁 边 把 我 的 孩 子 抱 去 ， 放 在 他 怀 里 ， 将 他 的 死 孩 子 放 在 我 怀 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8838', '11', '3', '21', '天 要 亮 的 时 候 ， 我 起 来 要 给 我 的 孩 子 吃 奶 ， 不 料 ， 孩 子 死 了 ； 及 至 天 亮 ， 我 细 细 地 察 看 ， 不 是 我 所 生 的 孩 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8839', '11', '3', '22', '那 妇 人 说 ： 不 然 ， 活 孩 子 是 我 的 ， 死 孩 子 是 你 的 。 这 妇 人 说 ： 不 然 ， 死 孩 子 是 你 的 ， 活 孩 子 是 我 的 。 他 们 在 王 面 前 如 此 争 论 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8840', '11', '3', '23', '王 说 ： 这 妇 人 说 活 孩 子 是 我 的 ， 死 孩 子 是 你 的 ， 那 妇 人 说 不 然 ， 死 孩 子 是 你 的 ， 活 孩 子 是 我 的 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8841', '11', '3', '24', '就 吩 咐 说 ： 拿 刀 来 ！ 人 就 拿 刀 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8842', '11', '3', '25', '王 说 ： 将 活 孩 子 劈 成 两 半 ， 一 半 给 那 妇 人 ， 一 半 给 这 妇 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8843', '11', '3', '26', '活 孩 子 的 母 亲 为 自 己 的 孩 子 心 里 急 痛 ， 就 说 ： 求 我 主 将 活 孩 子 给 那 妇 人 罢 ， 万 不 可 杀 他 ！ 那 妇 人 说 ： 这 孩 子 也 不 归 我 ， 也 不 归 你 ， 把 他 劈 了 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8844', '11', '3', '27', '王 说 ： 将 活 孩 子 给 这 妇 人 ， 万 不 可 杀 他 ； 这 妇 人 实 在 是 他 的 母 亲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8845', '11', '3', '28', '以 色 列 众 人 听 见 王 这 样 判 断 ， 就 都 敬 畏 他 ； 因 为 见 他 心 里 有 　 神 的 智 慧 ， 能 以 断 案 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8846', '11', '4', '1', '所 罗 门 作 以 色 列 众 人 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8847', '11', '4', '2', '他 的 臣 子 记 在 下 面 ： 撒 督 的 儿 子 亚 撒 利 雅 作 祭 司 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8848', '11', '4', '3', '示 沙 的 两 个 儿 子 以 利 何 烈 、 亚 希 亚 作 书 记 ， 亚 希 律 的 儿 子 约 沙 法 作 史 官 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8849', '11', '4', '4', '耶 何 耶 大 的 儿 子 比 拿 雅 作 元 帅 ， 撒 督 和 亚 比 亚 他 作 祭 司 长 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8850', '11', '4', '5', '拿 单 的 儿 子 亚 撒 利 雅 作 众 吏 长 ， 王 的 朋 友 拿 单 的 儿 子 撒 布 得 作 领 袖 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8851', '11', '4', '6', '亚 希 煞 作 家 宰 ， 亚 比 大 的 儿 子 亚 多 尼 兰 掌 管 服 苦 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8852', '11', '4', '7', '所 罗 门 在 以 色 列 全 地 立 了 十 二 个 官 吏 ， 使 他 们 供 给 王 和 王 家 的 食 物 ， 每 年 各 人 供 给 一 月 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8853', '11', '4', '8', '他 们 的 名 字 记 在 下 面 ： 在 以 法 莲 山 地 有 便 户 珥 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8854', '11', '4', '9', '在 玛 迦 斯 、 沙 宾 、 伯 示 麦 、 以 伦 伯 哈 南 有 便 底 甲 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8855', '11', '4', '10', '在 亚 鲁 泊 有 便 希 悉 ， 他 管 理 梭 哥 和 希 弗 全 地 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8856', '11', '4', '11', '在 多 珥 山 冈 ( 或 作 全 境 ) 有 便 亚 比 拿 达 ， 他 娶 了 所 罗 门 的 女 儿 他 法 为 妻 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8857', '11', '4', '12', '在 他 纳 和 米 吉 多 ， 并 靠 近 撒 拉 他 拿 、 耶 斯 列 下 边 的 伯 善 全 地 ， 从 伯 善 到 亚 伯 米 何 拉 直 到 约 念 之 外 ， 有 亚 希 律 的 儿 子 巴 拿 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8858', '11', '4', '13', '在 基 列 的 拉 末 有 便 基 别 ， 他 管 理 在 基 列 的 玛 拿 西 子 孙 睚 珥 的 城 邑 ， 巴 珊 的 亚 珥 歌 伯 地 的 大 城 六 十 座 ， 都 有 城 墙 和 铜 闩 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8859', '11', '4', '14', '在 玛 哈 念 有 易 多 的 儿 子 亚 希 拿 达 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8860', '11', '4', '15', '在 拿 弗 他 利 有 亚 希 玛 斯 ， 他 也 娶 了 所 罗 门 的 一 个 女 儿 巴 实 抹 为 妻 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8861', '11', '4', '16', '在 亚 设 和 亚 禄 有 户 筛 的 儿 子 巴 拿 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8862', '11', '4', '17', '在 以 萨 迦 有 帕 路 亚 的 儿 子 约 沙 法 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8863', '11', '4', '18', '在 便 雅 悯 有 以 拉 的 儿 子 示 每 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8864', '11', '4', '19', '在 基 列 地 ， 就 是 从 前 属 亚 摩 利 王 西 宏 和 巴 珊 王 噩 之 地 ， 有 乌 利 的 儿 子 基 别 一 人 管 理 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8865', '11', '4', '20', '犹 大 人 和 以 色 列 人 如 同 海 边 的 沙 那 样 多 ， 都 吃 喝 快 乐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8866', '11', '4', '21', '所 罗 门 统 管 诸 国 ， 从 大 河 到 非 利 士 地 ， 直 到 埃 及 的 边 界 。 所 罗 门 在 世 的 日 子 ， 这 些 国 都 进 贡 服 事 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8867', '11', '4', '22', '所 罗 门 每 日 所 用 的 食 物 ： 细 面 三 十 歌 珥 ， 粗 面 六 十 歌 珥 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8868', '11', '4', '23', '肥 牛 十 只 ， 草 场 的 牛 二 十 只 ， 羊 一 百 只 ， 还 有 鹿 、 羚 羊 、 ? 子 ， 并 肥 禽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8869', '11', '4', '24', '所 罗 门 管 理 大 河 西 边 的 诸 王 ， 以 及 从 提 弗 萨 直 到 迦 萨 的 全 地 ， 四 境 尽 都 平 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8870', '11', '4', '25', '所 罗 门 在 世 的 日 子 ， 从 但 到 别 是 巴 的 犹 大 人 和 以 色 列 人 都 在 自 己 的 葡 萄 树 下 和 无 花 果 树 下 安 然 居 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8871', '11', '4', '26', '所 罗 门 有 套 车 的 马 四 万 ， 还 有 马 兵 一 万 二 千 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8872', '11', '4', '27', '那 十 二 个 官 吏 各 按 各 月 供 给 所 罗 门 王 ， 并 一 切 与 他 同 席 之 人 的 食 物 ， 一 无 所 缺 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8873', '11', '4', '28', '众 人 各 按 各 分 ， 将 养 马 与 快 马 的 大 麦 和 乾 草 送 到 官 吏 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8874', '11', '4', '29', '　 神 赐 给 所 罗 门 极 大 的 智 慧 聪 明 和 广 大 的 心 ， 如 同 海 沙 不 可 测 量 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8875', '11', '4', '30', '所 罗 门 的 智 慧 超 过 东 方 人 和 埃 及 人 的 一 切 智 慧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8876', '11', '4', '31', '他 的 智 慧 胜 过 万 人 ， 胜 过 以 斯 拉 人 以 探 ， 并 玛 曷 的 儿 子 希 幔 、 甲 各 、 达 大 的 智 慧 。 他 的 名 声 传 扬 在 四 围 的 列 国 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8877', '11', '4', '32', '他 作 箴 言 三 千 句 ， 诗 歌 一 千 零 五 首 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8878', '11', '4', '33', '他 讲 论 草 木 ， 自 利 巴 嫩 的 香 柏 树 直 到 墙 上 长 的 牛 膝 草 ， 又 讲 论 飞 禽 走 兽 、 昆 虫 水 族 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8879', '11', '4', '34', '天 下 列 王 听 见 所 罗 门 的 智 慧 ， 就 都 差 人 来 听 他 的 智 慧 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8880', '11', '5', '1', '推 罗 王 希 兰 ， 平 素 爱 大 卫 ； 他 听 见 以 色 列 人 膏 所 罗 门 ， 接 续 他 父 亲 作 王 ， 就 差 遣 臣 仆 来 见 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8881', '11', '5', '2', '所 罗 门 也 差 遣 人 去 见 希 兰 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8882', '11', '5', '3', '你 知 道 我 父 亲 大 卫 因 四 围 的 争 战 ， 不 能 为 耶 和 华 ─ 他 　 神 的 名 建 殿 ， 直 等 到 耶 和 华 使 仇 敌 都 服 在 他 脚 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8883', '11', '5', '4', '现 在 耶 和 华 ─ 我 的 　 神 使 我 四 围 平 安 ， 没 有 仇 敌 ， 没 有 灾 祸 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8884', '11', '5', '5', '我 定 意 要 为 耶 和 华 ─ 我 　 神 的 名 建 殿 ， 是 照 耶 和 华 应 许 我 父 亲 大 卫 的 话 说 ： 我 必 使 你 儿 子 接 续 你 坐 你 的 位 ， 他 必 为 我 的 名 建 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8885', '11', '5', '6', '所 以 求 你 吩 咐 你 的 仆 人 在 利 巴 嫩 为 我 砍 伐 香 柏 木 ， 我 的 仆 人 也 必 帮 助 他 们 ， 我 必 照 你 所 定 的 ， 给 你 仆 人 的 工 价 ； 因 为 你 知 道 ， 在 我 们 中 间 没 有 人 像 西 顿 人 善 於 砍 伐 树 木 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8886', '11', '5', '7', '希 兰 听 见 所 罗 门 的 话 ， 就 甚 喜 悦 ， 说 ： 今 日 应 当 称 颂 耶 和 华 ； 因 他 赐 给 大 卫 一 个 有 智 慧 的 儿 子 ， 治 理 这 众 多 的 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8887', '11', '5', '8', '希 兰 打 发 人 去 见 所 罗 门 ， 说 ： 你 差 遣 人 向 我 所 提 的 那 事 ， 我 都 听 见 了 ； 论 到 香 柏 木 和 松 木 ， 我 必 照 你 的 心 愿 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8888', '11', '5', '9', '我 的 仆 人 必 将 这 木 料 从 利 巴 嫩 运 到 海 里 ， 扎 成 筏 子 ， 浮 海 运 到 你 所 指 定 我 的 地 方 ， 在 那 里 拆 开 ， 你 就 可 以 收 取 ； 你 也 要 成 全 我 的 心 愿 ， 将 食 物 给 我 的 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8889', '11', '5', '10', '於 是 希 兰 照 着 所 罗 门 所 要 的 ， 给 他 香 柏 木 和 松 木 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8890', '11', '5', '11', '所 罗 门 给 希 兰 麦 子 二 万 歌 珥 ， 清 油 二 十 歌 珥 ， 作 他 家 的 食 物 。 所 罗 门 每 年 都 是 这 样 给 希 兰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8891', '11', '5', '12', '耶 和 华 照 着 所 应 许 的 赐 智 慧 给 所 罗 门 。 希 兰 与 所 罗 门 和 好 ， 彼 此 立 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8892', '11', '5', '13', '所 罗 门 王 从 以 色 列 人 中 挑 取 服 苦 的 人 共 有 三 万 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8893', '11', '5', '14', '派 他 们 轮 流 每 月 一 万 人 上 利 巴 嫩 去 ； 一 个 月 在 利 巴 嫩 ， 两 个 月 在 家 里 。 亚 多 尼 兰 掌 管 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8894', '11', '5', '15', '所 罗 门 用 七 万 扛 抬 的 ， 八 万 在 山 上 凿 石 头 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8895', '11', '5', '16', '此 外 ， 所 罗 门 用 三 千 三 百 督 工 的 ， 监 管 工 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8896', '11', '5', '17', '王 下 令 ， 人 就 凿 出 又 大 又 宝 贵 的 石 头 来 ， 用 以 立 殿 的 根 基 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8897', '11', '5', '18', '所 罗 门 的 匠 人 和 希 兰 的 匠 人 ， 并 迦 巴 勒 人 ， 都 将 石 头 凿 好 ， 预 备 木 料 和 石 头 建 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8898', '11', '6', '1', '以 色 列 人 出 埃 及 地 後 四 百 八 十 年 ， 所 罗 门 作 以 色 列 王 第 四 年 西 弗 月 ， 就 是 二 月 ， 开 工 建 造 耶 和 华 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8899', '11', '6', '2', '所 罗 门 王 为 耶 和 华 所 建 的 殿 ， 长 六 十 肘 ， 宽 二 十 肘 ， 高 三 十 肘 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8900', '11', '6', '3', '殿 前 的 廊 子 长 二 十 肘 ， 与 殿 的 宽 窄 一 样 ， 阔 十 肘 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8901', '11', '6', '4', '又 为 殿 做 了 严 紧 的 窗 棂 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8902', '11', '6', '5', '靠 着 殿 墙 ， 围 着 外 殿 内 殿 ， 造 了 三 层 旁 屋 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8903', '11', '6', '6', '下 层 宽 五 肘 ， 中 层 宽 六 肘 ， 上 层 宽 七 肘 。 殿 外 旁 屋 的 梁 木 搁 在 殿 墙 坎 上 ， 免 得 插 入 殿 墙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8904', '11', '6', '7', '建 殿 是 用 山 中 凿 成 的 石 头 。 建 殿 的 时 候 ， ? 子 、 斧 子 ， 和 别 样 铁 器 的 响 声 都 没 有 听 见 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8905', '11', '6', '8', '在 殿 右 边 当 中 的 旁 屋 有 门 ， 门 内 有 旋 螺 的 楼 梯 ， 可 以 上 到 第 二 层 ， 从 第 二 层 可 以 上 到 第 三 层 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8906', '11', '6', '9', '所 罗 门 建 殿 ， 安 置 香 柏 木 的 栋 梁 ， 又 用 香 柏 木 板 遮 盖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8907', '11', '6', '10', '靠 着 殿 所 造 的 旁 屋 ， 每 层 高 五 肘 ， 香 柏 木 的 栋 梁 搁 在 殿 墙 坎 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8908', '11', '6', '11', '耶 和 华 的 话 临 到 所 罗 门 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8909', '11', '6', '12', '论 到 你 所 建 的 这 殿 ， 你 若 遵 行 我 的 律 例 ， 谨 守 我 的 典 章 ， 遵 从 我 的 一 切 诫 命 ， 我 必 向 你 应 验 我 所 应 许 你 父 亲 大 卫 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8910', '11', '6', '13', '我 必 住 在 以 色 列 人 中 间 ， 并 不 丢 弃 我 民 以 色 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8911', '11', '6', '14', '所 罗 门 建 造 殿 宇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8912', '11', '6', '15', '殿 里 面 用 香 柏 木 板 贴 墙 ， 从 地 到 棚 顶 都 用 木 板 遮 蔽 ， 又 用 松 木 板 铺 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8913', '11', '6', '16', '内 殿 ， 就 是 至 圣 所 ， 长 二 十 肘 ， 从 地 到 棚 顶 用 香 柏 木 板 遮 蔽 ( 或 作 隔 断 ) 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8914', '11', '6', '17', '内 殿 前 的 外 殿 ， 长 四 十 肘 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8915', '11', '6', '18', '殿 里 一 点 石 头 都 不 显 露 ， 一 概 用 香 柏 木 遮 蔽 ； 上 面 刻 着 野 瓜 和 初 开 的 花 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8916', '11', '6', '19', '殿 里 预 备 了 内 殿 ， 好 安 放 耶 和 华 的 约 柜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8917', '11', '6', '20', '内 殿 长 二 十 肘 ， 宽 二 十 肘 ， 高 二 十 肘 ， 墙 面 都 贴 上 精 金 ； 又 用 香 柏 木 做 坛 ， 包 上 精 金 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8918', '11', '6', '21', '所 罗 门 用 精 金 贴 了 殿 内 的 墙 ， 又 用 金 炼 子 挂 在 内 殿 前 门 扇 ， 用 金 包 裹 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8919', '11', '6', '22', '全 殿 都 贴 上 金 子 ， 直 到 贴 完 ； 内 殿 前 的 坛 ， 也 都 用 金 包 裹 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8920', '11', '6', '23', '他 用 橄 榄 木 做 两 个 基 路 伯 ， 各 高 十 肘 ， 安 在 内 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8921', '11', '6', '24', '这 一 个 基 路 伯 有 两 个 翅 膀 ， 各 长 五 肘 ， 从 这 翅 膀 尖 到 那 翅 膀 尖 共 有 十 肘 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8922', '11', '6', '25', '那 一 个 基 路 伯 的 两 个 翅 膀 也 是 十 肘 ， 两 个 基 路 伯 的 尺 寸 、 形 像 都 是 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8923', '11', '6', '26', '这 基 路 伯 高 十 肘 ， 那 基 路 伯 也 是 如 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8924', '11', '6', '27', '他 将 两 个 基 路 伯 安 在 内 殿 里 ； 基 路 伯 的 翅 膀 是 张 开 的 ， 这 基 路 伯 的 一 个 翅 膀 挨 着 这 边 的 墙 ， 那 基 路 伯 的 一 个 翅 膀 挨 着 那 边 的 墙 ， 里 边 的 两 个 翅 膀 在 殿 中 间 彼 此 相 接 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8925', '11', '6', '28', '又 用 金 子 包 裹 二 基 路 伯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8926', '11', '6', '29', '内 殿 、 外 殿 周 围 的 墙 上 都 刻 着 基 路 伯 、 棕 树 ， 和 初 开 的 花 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8927', '11', '6', '30', '内 殿 、 外 殿 的 地 板 都 贴 上 金 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8928', '11', '6', '31', '又 用 橄 榄 木 制 造 内 殿 的 门 扇 、 门 楣 、 门 框 ； 门 口 有 墙 的 五 分 之 一 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8929', '11', '6', '32', '在 橄 榄 木 做 的 两 门 扇 上 刻 着 基 路 伯 、 棕 树 ， 和 初 开 的 花 ， 都 贴 上 金 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8930', '11', '6', '33', '又 用 橄 榄 木 制 造 外 殿 的 门 框 ， 门 口 有 墙 的 四 分 之 一 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8931', '11', '6', '34', '用 松 木 做 门 两 扇 。 这 扇 分 两 扇 ， 是 摺 叠 的 ； 那 扇 分 两 扇 ； 也 是 摺 叠 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8932', '11', '6', '35', '上 面 刻 着 基 路 伯 、 棕 树 ， 和 初 开 的 花 ， 都 用 金 子 贴 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8933', '11', '6', '36', '他 又 用 凿 成 的 石 头 三 层 、 香 柏 木 一 层 建 筑 内 院 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8934', '11', '6', '37', '所 罗 门 在 位 第 四 年 西 弗 月 ， 立 了 耶 和 华 殿 的 根 基 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8935', '11', '6', '38', '到 十 一 年 布 勒 月 ， 就 是 八 月 ， 殿 和 一 切 属 殿 的 都 按 着 样 式 造 成 。 他 建 殿 的 工 夫 共 有 七 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8936', '11', '7', '1', '所 罗 门 为 自 己 建 造 宫 室 ， 十 三 年 方 才 造 成 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8937', '11', '7', '2', '又 建 造 利 巴 嫩 林 宫 ， 长 一 百 肘 ， 宽 五 十 肘 ， 高 三 十 肘 ， 有 香 柏 木 柱 三 ( 原 文 作 四 ) 行 ， 柱 上 有 香 柏 木 柁 梁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8938', '11', '7', '3', '其 上 以 香 柏 木 为 盖 ， 每 行 柱 子 十 五 根 ， 共 有 四 十 五 根 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8939', '11', '7', '4', '有 窗 户 三 层 ， 窗 与 窗 相 对 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8940', '11', '7', '5', '所 有 的 门 框 都 是 厚 木 见 方 的 ， 有 窗 户 三 层 ， 窗 与 窗 相 对 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8941', '11', '7', '6', '并 建 造 有 柱 子 的 廊 子 ， 长 五 十 肘 ， 宽 三 十 肘 ； 在 这 廊 前 又 有 廊 子 ， 廊 外 有 柱 子 和 ? 阶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8942', '11', '7', '7', '又 建 造 一 廊 ， 其 中 设 立 审 判 的 座 位 ， 这 廊 从 地 到 顶 都 用 香 柏 木 遮 蔽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8943', '11', '7', '8', '廊 後 院 内 有 所 罗 门 住 的 宫 室 ； 工 作 与 这 工 作 相 同 。 所 罗 门 又 为 所 娶 法 老 的 女 儿 建 造 一 宫 ， 做 法 与 这 廊 子 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8944', '11', '7', '9', '建 造 这 一 切 所 用 的 石 头 都 是 宝 贵 的 ， 是 按 着 尺 寸 凿 成 的 ， 是 用 锯 里 外 锯 齐 的 ； 从 根 基 直 到 檐 石 ， 从 外 头 直 到 大 院 ， 都 是 如 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8945', '11', '7', '10', '根 基 是 宝 贵 的 大 石 头 ， 有 长 十 肘 的 ， 有 长 八 肘 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8946', '11', '7', '11', '上 面 有 香 柏 木 和 按 着 尺 寸 凿 成 宝 贵 的 石 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8947', '11', '7', '12', '大 院 周 围 有 凿 成 的 石 头 三 层 、 香 柏 木 一 层 ， 都 照 耶 和 华 殿 的 内 院 和 殿 廊 的 样 式 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8948', '11', '7', '13', '所 罗 门 王 差 遣 人 往 推 罗 去 ， 将 户 兰 召 了 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8949', '11', '7', '14', '他 是 拿 弗 他 利 支 派 中 一 个 寡 妇 的 儿 子 ， 他 父 亲 是 推 罗 人 ， 作 铜 匠 的 。 户 兰 满 有 智 慧 、 聪 明 、 技 能 ， 善 於 各 样 铜 作 。 他 来 到 所 罗 门 王 那 里 ， 做 王 一 切 所 要 做 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8950', '11', '7', '15', '他 制 造 两 根 铜 柱 ， 每 根 高 十 八 肘 ， 围 十 二 肘 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8951', '11', '7', '16', '又 用 铜 铸 了 两 个 柱 顶 安 在 柱 上 ， 各 高 五 肘 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8952', '11', '7', '17', '柱 顶 上 有 装 修 的 网 子 和 拧 成 的 炼 索 ， 每 顶 七 个 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8953', '11', '7', '18', '网 子 周 围 有 两 行 石 榴 遮 盖 柱 顶 ， 两 个 柱 顶 都 是 如 此 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8954', '11', '7', '19', '廊 子 的 柱 顶 径 四 肘 ， 刻 着 百 合 花 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8955', '11', '7', '20', '两 柱 顶 的 鼓 肚 上 挨 着 网 子 ， 各 有 两 行 石 榴 环 绕 ， 两 行 共 有 二 百 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8956', '11', '7', '21', '他 将 两 根 柱 子 立 在 殿 廊 前 头 ： 右 边 立 一 根 ， 起 名 叫 雅 斤 ； 左 边 立 一 根 ， 起 名 叫 波 阿 斯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8957', '11', '7', '22', '在 柱 顶 上 刻 着 百 合 花 。 这 样 ， 造 柱 子 的 工 就 完 毕 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8958', '11', '7', '23', '他 又 铸 一 个 铜 海 ， 样 式 是 圆 的 ， 高 五 肘 ， 径 十 肘 ， 围 三 十 肘 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8959', '11', '7', '24', '在 海 边 之 下 ， 周 围 有 野 瓜 的 样 式 ； 每 肘 十 瓜 ， 共 有 两 行 ， 是 铸 海 的 时 候 铸 上 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8960', '11', '7', '25', '有 十 二 只 铜 牛 驮 海 ： 三 只 向 北 ， 三 只 向 西 ， 三 只 向 南 ， 三 只 向 东 ； 海 在 牛 上 ， 牛 尾 都 向 内 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8961', '11', '7', '26', '海 厚 一 掌 ， 边 如 杯 边 ， 又 如 百 合 花 ， 可 容 二 千 罢 特 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8962', '11', '7', '27', '他 用 铜 制 造 十 个 盆 座 ， 每 座 长 四 肘 ， 宽 四 肘 ， 高 三 肘 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8963', '11', '7', '28', '座 的 造 法 是 这 样 ： 四 面 都 有 心 子 ， 心 子 在 边 子 当 中 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8964', '11', '7', '29', '心 子 上 有 狮 子 和 牛 ， 并 基 路 伯 ； 边 上 有 小 座 ， 狮 子 和 牛 以 下 有 垂 下 的 璎 珞 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8965', '11', '7', '30', '每 盆 座 有 四 个 铜 轮 和 铜 轴 。 小 座 的 四 角 上 在 盆 以 下 ， 有 铸 成 的 盆 架 ， 其 旁 都 有 璎 珞 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8966', '11', '7', '31', '小 座 高 一 肘 ， 口 是 圆 的 ， 彷 佛 座 的 样 式 ， 径 一 肘 半 ， 在 口 上 有 雕 工 ， 心 子 是 方 的 ， 不 是 圆 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8967', '11', '7', '32', '四 个 轮 子 在 心 子 以 下 ， 轮 轴 与 座 相 连 ， 每 轮 高 一 肘 半 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8968', '11', '7', '33', '轮 的 样 式 如 同 车 轮 ； 轴 、 辋 、 辐 、 毂 都 是 铸 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8969', '11', '7', '34', '每 座 四 角 上 都 有 盆 架 ， 是 与 座 一 同 铸 成 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8970', '11', '7', '35', '座 上 有 圆 架 ， 高 半 肘 ； 座 上 有 撑 子 和 心 子 ， 是 与 座 一 同 铸 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8971', '11', '7', '36', '在 撑 子 和 心 子 上 刻 着 基 路 伯 、 狮 子 ， 和 棕 树 ， 周 围 有 璎 珞 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8972', '11', '7', '37', '十 个 盆 座 都 是 这 样 ， 铸 法 、 尺 寸 、 样 式 相 同 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8973', '11', '7', '38', '又 用 铜 制 造 十 个 盆 ， 每 盆 可 容 四 十 罢 特 。 盆 径 四 肘 ， 在 那 十 座 上 ， 每 座 安 设 一 盆 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8974', '11', '7', '39', '五 个 安 在 殿 门 的 右 边 ， 五 个 放 在 殿 门 的 左 边 ； 又 将 海 放 在 殿 门 的 右 旁 ， 就 是 南 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8975', '11', '7', '40', '户 兰 又 造 了 盆 、 铲 子 ， 和 盘 子 。 这 样 ， 他 为 所 罗 门 王 做 完 了 耶 和 华 殿 的 一 切 工 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8976', '11', '7', '41', '所 造 的 就 是 ： 两 根 柱 子 和 柱 上 两 个 如 球 的 顶 ； 并 两 个 盖 柱 顶 的 网 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8977', '11', '7', '42', '和 四 百 石 榴 ， 安 在 两 个 网 子 上 ， 每 网 两 行 ， 盖 着 两 个 柱 上 如 球 的 顶 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8978', '11', '7', '43', '十 个 座 和 其 上 的 十 个 盆 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8979', '11', '7', '44', '海 和 海 下 的 十 二 只 牛 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8980', '11', '7', '45', '盆 、 铲 子 、 盘 子 。 这 一 切 都 是 户 兰 给 所 罗 门 王 用 光 亮 的 铜 为 耶 和 华 的 殿 造 成 的 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8981', '11', '7', '46', '是 遵 王 命 在 约 但 平 原 、 疏 割 和 撒 拉 但 中 间 藉 胶 泥 铸 成 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8982', '11', '7', '47', '这 一 切 所 罗 门 都 没 有 过 秤 ； 因 为 甚 多 ， 铜 的 轻 重 也 无 法 可 查 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8983', '11', '7', '48', '所 罗 门 又 造 耶 和 华 殿 里 的 金 坛 和 陈 设 饼 的 金 桌 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8984', '11', '7', '49', '内 殿 前 的 精 金 灯 ? ： 右 边 五 个 ， 左 边 五 个 ， 并 其 上 的 金 花 、 灯 盏 、 蜡 剪 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8985', '11', '7', '50', '与 精 金 的 杯 、 盘 、 镊 子 、 调 羹 、 火 鼎 ， 以 及 至 圣 所 、 内 殿 的 门 枢 ， 和 外 殿 的 门 枢 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8986', '11', '7', '51', '所 罗 门 王 做 完 了 耶 和 华 殿 的 一 切 工 ， 就 把 他 父 大 卫 分 别 为 圣 的 金 银 和 器 皿 都 带 来 放 在 耶 和 华 殿 的 府 库 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8987', '11', '8', '1', '那 时 ， 所 罗 门 将 以 色 列 的 长 老 和 各 支 派 的 首 领 ， 并 以 色 列 的 族 长 ， 招 聚 到 耶 路 撒 冷 ， 要 把 耶 和 华 的 约 柜 从 大 卫 城 ─ 就 是 锡 安 ─ 运 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8988', '11', '8', '2', '以 他 念 月 ， 就 是 七 月 ， 在 节 前 ， 以 色 列 人 都 聚 集 到 所 罗 门 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8989', '11', '8', '3', '以 色 列 长 老 来 到 ， 祭 司 便 抬 起 约 柜 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8990', '11', '8', '4', '祭 司 和 利 未 人 将 耶 和 华 的 约 柜 运 上 来 ， 又 将 会 幕 和 会 幕 的 一 切 圣 器 具 都 带 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8991', '11', '8', '5', '所 罗 门 王 和 聚 集 到 他 那 里 的 以 色 列 全 会 众 ， 一 同 在 约 柜 前 献 牛 羊 为 祭 ， 多 得 不 可 胜 数 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8992', '11', '8', '6', '祭 司 将 耶 和 华 的 约 柜 抬 进 内 殿 ， 就 是 至 圣 所 ， 放 在 两 个 基 路 伯 的 翅 膀 底 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8993', '11', '8', '7', '基 路 伯 张 着 翅 膀 在 约 柜 之 上 ， 遮 掩 约 柜 和 抬 柜 的 杠 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8994', '11', '8', '8', '这 杠 甚 长 ， 杠 头 在 内 殿 前 的 圣 所 可 以 看 见 ， 在 殿 外 却 不 能 看 见 ， 直 到 如 今 还 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8995', '11', '8', '9', '约 柜 里 惟 有 两 块 石 版 ， 就 是 以 色 列 人 出 埃 及 地 後 ， 耶 和 华 与 他 们 立 约 的 时 候 摩 西 在 何 烈 山 所 放 的 。 除 此 以 外 ， 并 无 别 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8996', '11', '8', '10', '祭 司 从 圣 所 出 来 的 时 候 ， 有 云 充 满 耶 和 华 的 殿 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8997', '11', '8', '11', '甚 至 祭 司 不 能 站 立 供 职 ， 因 为 耶 和 华 的 荣 光 充 满 了 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8998', '11', '8', '12', '那 时 所 罗 门 说 ： 耶 和 华 曾 说 ， 他 必 住 在 幽 暗 之 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('8999', '11', '8', '13', '我 已 经 建 造 殿 宇 作 你 的 居 所 ， 为 你 永 远 的 住 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9000', '11', '8', '14', '王 转 脸 为 以 色 列 会 众 祝 福 ， 以 色 列 会 众 就 都 站 立 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9001', '11', '8', '15', '所 罗 门 说 ： 耶 和 华 ─ 以 色 列 的 　 神 是 应 当 称 颂 的 ！ 因 他 亲 口 向 我 父 大 卫 所 应 许 的 ， 也 亲 手 成 就 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9002', '11', '8', '16', '他 说 ： 自 从 我 领 我 民 以 色 列 出 埃 及 以 来 ， 我 未 曾 在 以 色 列 各 支 派 中 选 择 一 城 建 造 殿 宇 ─ 为 我 名 的 居 所 ， 但 拣 选 大 卫 治 理 我 民 以 色 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9003', '11', '8', '17', '所 罗 门 说 ： 我 父 大 卫 曾 立 意 ， 要 为 耶 和 华 ─ 以 色 列 　 神 的 名 建 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9004', '11', '8', '18', '耶 和 华 却 对 我 父 大 卫 说 ： 你 立 意 为 我 的 名 建 殿 ， 这 意 思 甚 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9005', '11', '8', '19', '只 是 你 不 可 建 殿 ， 惟 你 所 生 的 儿 子 必 为 我 名 建 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9006', '11', '8', '20', '现 在 耶 和 华 成 就 了 他 所 应 许 的 话 ， 使 我 接 续 我 父 大 卫 坐 以 色 列 的 国 位 ， 又 为 耶 和 华 ─ 以 色 列 　 神 的 名 建 造 了 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9007', '11', '8', '21', '我 也 在 其 中 为 约 柜 预 备 一 处 。 约 柜 内 有 耶 和 华 的 约 ， 就 是 他 领 我 们 列 祖 出 埃 及 地 的 时 候 ， 与 他 们 所 立 的 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9008', '11', '8', '22', '所 罗 门 当 着 以 色 列 会 众 ， 站 在 耶 和 华 的 坛 前 ， 向 天 举 手 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9009', '11', '8', '23', '耶 和 华 ─ 以 色 列 的 　 神 啊 ， 天 上 地 下 没 有 　 神 可 比 你 的 ！ 你 向 那 尽 心 行 在 你 面 前 的 仆 人 守 约 施 慈 爱 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9010', '11', '8', '24', '向 你 仆 人 ─ 我 父 大 卫 所 应 许 的 话 现 在 应 验 了 。 你 亲 口 应 许 ， 亲 手 成 就 ， 正 如 今 日 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9011', '11', '8', '25', '耶 和 华 ─ 以 色 列 的 　 神 啊 ， 你 所 应 许 你 仆 人 ─ 我 父 大 卫 的 话 说 ： 你 的 子 孙 若 谨 慎 自 己 的 行 为 ， 在 我 面 前 行 事 像 你 所 行 的 一 样 ， 就 不 断 人 坐 以 色 列 的 国 位 。 现 在 求 你 应 验 这 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9012', '11', '8', '26', '以 色 列 的 　 神 啊 ， 求 你 成 就 向 你 仆 人 ─ 我 父 大 卫 所 应 许 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9013', '11', '8', '27', '　 神 果 真 住 在 地 上 麽 ？ 看 哪 ， 天 和 天 上 的 天 尚 且 不 足 你 居 住 的 ， 何 况 我 所 建 的 这 殿 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9014', '11', '8', '28', '惟 求 耶 和 华 ─ 我 的 　 神 垂 顾 仆 人 的 祷 告 祈 求 ， 俯 听 仆 人 今 日 在 你 面 前 的 祈 祷 呼 吁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9015', '11', '8', '29', '愿 你 昼 夜 看 顾 这 殿 ， 就 是 你 应 许 立 为 你 名 的 居 所 ； 求 你 垂 听 仆 人 向 此 处 祷 告 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9016', '11', '8', '30', '你 仆 人 和 你 民 以 色 列 向 此 处 祈 祷 的 时 候 ， 求 你 在 天 上 你 的 居 所 垂 听 ， 垂 听 而 赦 免 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9017', '11', '8', '31', '人 若 得 罪 邻 舍 ， 有 人 叫 他 起 誓 ， 他 来 到 这 殿 在 你 的 坛 前 起 誓 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9018', '11', '8', '32', '求 你 在 天 上 垂 听 ， 判 断 你 的 仆 人 ： 定 恶 人 有 罪 ， 照 他 所 行 的 报 应 在 他 头 上 ； 定 义 人 有 理 ， 照 他 的 义 赏 赐 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9019', '11', '8', '33', '你 的 民 以 色 列 若 得 罪 你 ， 败 在 仇 敌 面 前 ， 又 归 向 你 ， 承 认 你 的 名 ， 在 这 殿 里 祈 求 祷 告 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9020', '11', '8', '34', '求 你 在 天 上 垂 听 ， 赦 免 你 民 以 色 列 的 罪 ， 使 他 们 归 回 你 赐 给 他 们 列 祖 之 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9021', '11', '8', '35', '你 的 民 因 得 罪 你 ， 你 惩 罚 他 们 ， 使 天 闭 塞 不 下 雨 ； 他 们 若 向 此 处 祷 告 ， 承 认 你 的 名 ， 离 开 他 们 的 罪 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9022', '11', '8', '36', '求 你 在 天 上 垂 听 ， 赦 免 你 仆 人 以 色 列 民 的 罪 ， 将 当 行 的 善 道 指 教 他 们 ， 且 降 雨 在 你 的 地 ， 就 是 你 赐 给 你 民 为 业 之 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9023', '11', '8', '37', '国 中 若 有 饥 荒 、 瘟 疫 、 旱 风 、 霉 烂 、 蝗 虫 、 蚂 蚱 ， 或 有 仇 敌 犯 境 围 困 城 邑 ， 无 论 遭 遇 甚 麽 灾 祸 疾 病 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9024', '11', '8', '38', '你 的 民 以 色 列 ， 或 是 众 人 ， 或 是 一 人 ， 自 觉 有 罪 ( 原 文 作 灾 ) ， 向 这 殿 举 手 ， 无 论 祈 求 甚 麽 ， 祷 告 甚 麽 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9025', '11', '8', '39', '求 你 在 天 上 你 的 居 所 垂 听 赦 免 。 你 是 知 道 人 心 的 ， 要 照 各 人 所 行 的 待 他 们 （ 惟 有 你 知 道 世 人 的 心 ） ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9026', '11', '8', '40', '使 他 们 在 你 赐 给 我 们 列 祖 之 地 上 一 生 一 世 敬 畏 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9027', '11', '8', '41', '论 到 不 属 你 民 以 色 列 的 外 邦 人 ， 为 你 名 从 远 方 而 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9028', '11', '8', '42', '（ 他 们 听 人 论 说 你 的 大 名 和 大 能 的 手 ， 并 伸 出 来 的 膀 臂 ） 向 这 殿 祷 告 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9029', '11', '8', '43', '求 你 在 天 上 你 的 居 所 垂 听 ， 照 着 外 邦 人 所 祈 求 的 而 行 ， 使 天 下 万 民 都 认 识 你 的 名 ， 敬 畏 你 像 你 的 民 以 色 列 一 样 ； 又 使 他 们 知 道 我 建 造 的 这 殿 是 称 为 你 名 下 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9030', '11', '8', '44', '你 的 民 若 奉 你 的 差 遣 ， 无 论 往 何 处 去 与 仇 敌 争 战 ， 向 耶 和 华 所 选 择 的 城 与 我 为 你 名 所 建 造 的 殿 祷 告 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9031', '11', '8', '45', '求 你 在 天 上 垂 听 他 们 的 祷 告 祈 求 ， 使 他 们 得 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9032', '11', '8', '46', '你 的 民 若 得 罪 你 （ 世 上 没 有 不 犯 罪 的 人 ） ， 你 向 他 们 发 怒 ， 将 他 们 交 给 仇 敌 掳 到 仇 敌 之 地 ， 或 远 或 近 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9033', '11', '8', '47', '他 们 若 在 掳 到 之 地 想 起 罪 来 ， 回 心 转 意 ， 恳 求 你 说 ： 我 们 有 罪 了 ， 我 们 悖 逆 了 ， 我 们 作 恶 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9034', '11', '8', '48', '他 们 若 在 掳 到 之 地 尽 心 尽 性 归 服 你 ， 又 向 自 己 的 地 ， 就 是 你 赐 给 他 们 列 祖 之 地 和 你 所 选 择 的 城 ， 并 我 为 你 名 所 建 造 的 殿 祷 告 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9035', '11', '8', '49', '求 你 在 天 上 你 的 居 所 垂 听 他 们 的 祷 告 祈 求 ， 为 他 们 伸 冤 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9036', '11', '8', '50', '饶 恕 得 罪 你 的 民 ， 赦 免 他 们 的 一 切 过 犯 ， 使 他 们 在 掳 他 们 的 人 面 前 蒙 怜 恤 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9037', '11', '8', '51', '因 为 他 们 是 你 的 子 民 ， 你 的 产 业 ， 是 你 从 埃 及 领 出 来 脱 离 铁 炉 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9038', '11', '8', '52', '愿 你 的 眼 目 看 顾 仆 人 ， 听 你 民 以 色 列 的 祈 求 ， 无 论 何 时 向 你 祈 求 ， 愿 你 垂 听 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9039', '11', '8', '53', '主 耶 和 华 啊 ， 你 将 他 们 从 地 上 的 万 民 中 分 别 出 来 作 你 的 产 业 ， 是 照 你 领 我 们 列 祖 出 埃 及 的 时 候 ， 藉 你 仆 人 摩 西 所 应 许 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9040', '11', '8', '54', '所 罗 门 在 耶 和 华 的 坛 前 屈 膝 跪 着 ， 向 天 举 手 ， 在 耶 和 华 面 前 祷 告 祈 求 已 毕 ， 就 起 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9041', '11', '8', '55', '站 着 ， 大 声 为 以 色 列 全 会 众 祝 福 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9042', '11', '8', '56', '耶 和 华 是 应 当 称 颂 的 ！ 因 为 他 照 着 一 切 所 应 许 的 赐 平 安 给 他 的 民 以 色 列 人 ， 凡 藉 他 仆 人 摩 西 应 许 赐 福 的 话 ， 一 句 都 没 有 落 空 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9043', '11', '8', '57', '愿 耶 和 华 ─ 我 们 的 　 神 与 我 们 同 在 ， 像 与 我 们 列 祖 同 在 一 样 ， 不 撇 下 我 们 ， 不 丢 弃 我 们 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9044', '11', '8', '58', '使 我 们 的 心 归 向 他 ， 遵 行 他 的 道 ， 谨 守 他 吩 咐 我 们 列 祖 的 诫 命 、 律 例 、 典 章 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9045', '11', '8', '59', '我 在 耶 和 华 面 前 祈 求 的 这 些 话 ， 愿 耶 和 华 ─ 我 们 的 　 神 昼 夜 垂 念 ， 每 日 为 他 仆 人 与 他 民 以 色 列 伸 冤 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9046', '11', '8', '60', '使 地 上 的 万 民 都 知 道 惟 独 耶 和 华 是 　 神 ， 并 无 别 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9047', '11', '8', '61', '所 以 你 们 当 向 耶 和 华 ─ 我 们 的 　 神 存 诚 实 的 心 ， 遵 行 他 的 律 例 ， 谨 守 他 的 诫 命 ， 至 终 如 今 日 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9048', '11', '8', '62', '王 和 以 色 列 众 民 一 同 在 耶 和 华 面 前 献 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9049', '11', '8', '63', '所 罗 门 向 耶 和 华 献 平 安 祭 ， 用 牛 二 万 二 千 ， 羊 十 二 万 。 这 样 ， 王 和 以 色 列 众 民 为 耶 和 华 的 殿 行 奉 献 之 礼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9050', '11', '8', '64', '当 日 ， 王 因 耶 和 华 殿 前 的 铜 坛 太 小 ， 容 不 下 燔 祭 、 素 祭 ， 和 平 安 祭 牲 的 脂 油 ， 便 将 耶 和 华 殿 前 院 子 当 中 分 别 为 圣 ， 在 那 里 献 燔 祭 、 素 祭 ， 和 平 安 祭 牲 的 脂 油 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9051', '11', '8', '65', '那 时 ， 所 罗 门 和 以 色 列 众 人 ， 就 是 从 哈 马 口 直 到 埃 及 小 河 所 有 的 以 色 列 人 ， 都 聚 集 成 为 大 会 ， 在 耶 和 华 ─ 我 们 的 　 神 面 前 守 节 七 日 又 七 日 ， 共 十 四 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9052', '11', '8', '66', '第 八 日 ， 王 遣 散 众 民 ； 他 们 都 为 王 祝 福 。 因 见 耶 和 华 向 他 仆 人 大 卫 和 他 民 以 色 列 所 施 的 一 切 恩 惠 ， 就 都 心 中 喜 乐 ， 各 归 各 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9053', '11', '9', '1', '所 罗 门 建 造 耶 和 华 殿 和 王 宫 ， 并 一 切 所 愿 意 建 造 的 都 完 毕 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9054', '11', '9', '2', '耶 和 华 就 二 次 向 所 罗 门 显 现 ， 如 先 前 在 基 遍 向 他 显 现 一 样 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9055', '11', '9', '3', '对 他 说 ： 你 向 我 所 祷 告 祈 求 的 ， 我 都 应 允 了 。 我 已 将 你 所 建 的 这 殿 分 别 为 圣 ， 使 我 的 名 永 远 在 其 中 ； 我 的 眼 、 我 的 心 也 必 常 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9056', '11', '9', '4', '你 若 效 法 你 父 大 卫 ， 存 诚 实 正 直 的 心 行 在 我 面 前 ， 遵 行 我 一 切 所 吩 咐 你 的 ， 谨 守 我 的 律 例 典 章 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9057', '11', '9', '5', '我 就 必 坚 固 你 的 国 位 在 以 色 列 中 ， 直 到 永 远 ， 正 如 我 应 许 你 父 大 卫 说 ： 你 的 子 孙 必 不 断 人 坐 以 色 列 的 国 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9058', '11', '9', '6', '倘 若 你 们 和 你 们 的 子 孙 转 去 不 跟 从 我 ， 不 守 我 指 示 你 们 的 诫 命 律 例 ， 去 事 奉 敬 拜 别 　 神 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9059', '11', '9', '7', '我 就 必 将 以 色 列 人 从 我 赐 给 他 们 的 地 上 剪 除 ， 并 且 我 为 己 名 所 分 别 为 圣 的 殿 也 必 舍 弃 不 顾 ， 使 以 色 列 人 在 万 民 中 作 笑 谈 ， 被 讥 诮 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9060', '11', '9', '8', '这 殿 虽 然 甚 高 ， 将 来 经 过 的 人 必 惊 讶 、 嗤 笑 ， 说 ： 耶 和 华 为 何 向 这 地 和 这 殿 如 此 行 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9061', '11', '9', '9', '人 必 回 答 说 ： 是 因 此 地 的 人 离 弃 领 他 们 列 祖 出 埃 及 地 之 耶 和 华 ─ 他 们 的 　 神 ， 去 亲 近 别 　 神 ， 事 奉 敬 拜 他 ， 所 以 耶 和 华 使 这 一 切 灾 祸 临 到 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9062', '11', '9', '10', '所 罗 门 建 造 耶 和 华 殿 和 王 宫 ， 这 两 所 二 十 年 才 完 毕 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9063', '11', '9', '11', '推 罗 王 希 兰 曾 照 所 罗 门 所 要 的 ， 资 助 他 香 柏 木 、 松 木 ， 和 金 子 ； 所 罗 门 王 就 把 加 利 利 地 的 二 十 座 城 给 了 希 兰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9064', '11', '9', '12', '希 兰 从 推 罗 出 来 ， 察 看 所 罗 门 给 他 的 城 邑 ， 就 不 喜 悦 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9065', '11', '9', '13', '说 ： 我 兄 啊 ， 你 给 我 的 是 甚 麽 城 邑 呢 ？ 他 就 给 这 城 邑 之 地 起 名 叫 迦 步 勒 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9066', '11', '9', '14', '希 兰 给 所 罗 门 一 百 二 十 他 连 得 金 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9067', '11', '9', '15', '所 罗 门 王 挑 取 服 苦 的 人 ， 是 为 建 造 耶 和 华 的 殿 、 自 己 的 宫 、 米 罗 、 耶 路 撒 冷 的 城 墙 、 夏 琐 、 米 吉 多 ， 并 基 色 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9068', '11', '9', '16', '先 前 埃 及 王 法 老 上 来 攻 取 基 色 ， 用 火 焚 烧 ， 杀 了 城 内 居 住 的 迦 南 人 ， 将 城 赐 给 他 女 儿 所 罗 门 的 妻 作 妆 奁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9069', '11', '9', '17', '所 罗 门 建 造 基 色 、 下 伯 和 仑 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9070', '11', '9', '18', '巴 拉 ， 并 国 中 旷 野 里 的 达 莫 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9071', '11', '9', '19', '又 建 造 所 有 的 积 货 城 ， 并 屯 车 和 马 兵 的 城 ， 与 耶 路 撒 冷 、 利 巴 嫩 ， 以 及 自 己 治 理 的 全 国 中 所 愿 建 造 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9072', '11', '9', '20', '至 於 国 中 所 剩 下 不 属 以 色 列 人 的 亚 摩 利 人 、 赫 人 、 比 利 洗 人 、 希 未 人 、 耶 布 斯 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9073', '11', '9', '21', '就 是 以 色 列 人 不 能 灭 尽 的 ， 所 罗 门 挑 取 他 们 的 後 裔 作 服 苦 的 奴 仆 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9074', '11', '9', '22', '惟 有 以 色 列 人 ， 所 罗 门 不 使 他 们 作 奴 仆 ， 乃 是 作 他 的 战 士 、 臣 仆 、 统 领 、 军 长 、 车 兵 长 、 马 兵 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9075', '11', '9', '23', '所 罗 门 有 五 百 五 十 督 工 的 ， 监 管 工 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9076', '11', '9', '24', '法 老 的 女 儿 从 大 卫 城 搬 到 所 罗 门 为 他 建 造 的 宫 里 。 那 时 ， 所 罗 门 才 建 造 米 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9077', '11', '9', '25', '所 罗 门 每 年 三 次 在 他 为 耶 和 华 所 筑 的 坛 上 献 燔 祭 和 平 安 祭 ， 又 在 耶 和 华 面 前 的 坛 上 烧 香 。 这 样 ， 他 建 造 殿 的 工 程 完 毕 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9078', '11', '9', '26', '所 罗 门 王 在 以 东 地 红 海 边 ， 靠 近 以 禄 的 以 旬 迦 别 制 造 船 只 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9079', '11', '9', '27', '希 兰 差 遣 他 的 仆 人 ， 就 是 熟 悉 泛 海 的 船 家 ， 与 所 罗 门 的 仆 人 一 同 坐 船 航 海 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9080', '11', '9', '28', '他 们 到 了 俄 斐 ， 从 那 里 得 了 四 百 二 十 他 连 得 金 子 ， 运 到 所 罗 门 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9081', '11', '10', '1', '示 巴 女 王 听 见 所 罗 门 因 耶 和 华 之 名 所 得 的 名 声 ， 就 来 要 用 难 解 的 话 试 问 所 罗 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9082', '11', '10', '2', '跟 随 他 到 耶 路 撒 冷 的 人 甚 多 ， 又 有 骆 驼 驮 着 香 料 、 宝 石 ， 和 许 多 金 子 。 他 来 见 了 所 罗 门 王 ， 就 把 心 里 所 有 的 对 所 罗 门 都 说 出 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9083', '11', '10', '3', '所 罗 门 王 将 他 所 问 的 都 答 上 了 ， 没 有 一 句 不 明 白 、 不 能 答 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9084', '11', '10', '4', '示 巴 女 王 见 所 罗 门 大 有 智 慧 ， 和 他 所 建 造 的 宫 室 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9085', '11', '10', '5', '席 上 的 珍 馐 美 味 ， 群 臣 分 列 而 坐 ， 仆 人 两 旁 侍 立 ， 以 及 他 们 的 衣 服 装 饰 和 酒 政 的 衣 服 装 饰 ， 又 见 他 上 耶 和 华 殿 的 ? 阶 ( 或 作 他 在 耶 和 华 殿 里 所 献 的 燔 祭 ) ， 就 诧 异 得 神 不 守 舍 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9086', '11', '10', '6', '对 王 说 ： 我 在 本 国 里 所 听 见 论 到 你 的 事 和 你 的 智 慧 实 在 是 真 的 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9087', '11', '10', '7', '我 先 不 信 那 些 话 ， 及 至 我 来 亲 眼 见 了 才 知 道 人 所 告 诉 我 的 还 不 到 一 半 。 你 的 智 慧 和 你 的 福 分 越 过 我 所 听 见 的 风 声 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9088', '11', '10', '8', '你 的 臣 子 、 你 的 仆 人 常 侍 立 在 你 面 前 听 你 智 慧 的 话 是 有 福 的 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9089', '11', '10', '9', '耶 和 华 ─ 你 的 　 神 是 应 当 称 颂 的 ！ 他 喜 悦 你 ， 使 你 坐 以 色 列 的 国 位 ； 因 为 他 永 远 爱 以 色 列 ， 所 以 立 你 作 王 ， 使 你 秉 公 行 义 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9090', '11', '10', '10', '於 是 ， 示 巴 女 王 将 一 百 二 十 他 连 得 金 子 和 宝 石 ， 与 极 多 的 香 料 ， 送 给 所 罗 门 王 。 他 送 给 王 的 香 料 ， 以 後 奉 来 的 不 再 有 这 样 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9091', '11', '10', '11', '〈 希 兰 的 船 只 从 俄 斐 运 了 金 子 来 ， 又 从 俄 斐 运 了 许 多 檀 香 木 ( 或 作 乌 木 ； 下 同 ) 和 宝 石 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9092', '11', '10', '12', '王 用 檀 香 木 为 耶 和 华 殿 和 王 宫 做 栏 杆 ， 又 为 歌 唱 的 人 做 琴 瑟 。 以 後 再 没 有 这 样 的 檀 香 木 进 国 来 ， 也 没 有 人 看 见 过 ， 直 到 如 今 。 〉');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9093', '11', '10', '13', '示 巴 女 王 一 切 所 要 所 求 的 ， 所 罗 门 王 都 送 给 他 ， 另 外 照 自 己 的 厚 意 ? 送 他 。 於 是 女 王 和 他 臣 仆 转 回 本 国 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9094', '11', '10', '14', '所 罗 门 每 年 所 得 的 金 子 共 有 六 百 六 十 六 他 连 得 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9095', '11', '10', '15', '另 外 还 有 商 人 和 杂 族 ( 历 代 下 九 章14 节 作 亚 拉 伯 ) 的 诸 王 ， 与 国 中 的 省 长 所 进 的 金 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9096', '11', '10', '16', '所 罗 门 王 用 锤 出 来 的 金 子 打 成 挡 牌 二 百 面 ， 每 面 用 金 子 六 百 舍 客 勒 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9097', '11', '10', '17', '又 用 锤 出 来 的 金 子 打 成 盾 牌 三 百 面 ， 每 面 用 金 子 三 弥 那 ， 都 放 在 利 巴 嫩 林 宫 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9098', '11', '10', '18', '王 用 象 牙 制 造 一 个 宝 座 ， 用 精 金 包 裹 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9099', '11', '10', '19', '宝 座 有 六 层 ? 阶 ， 座 的 後 背 是 圆 的 ， 两 旁 有 扶 手 ， 靠 近 扶 手 有 两 个 狮 子 站 立 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9100', '11', '10', '20', '六 层 ? 阶 上 有 十 二 个 狮 子 站 立 ， 每 层 有 两 个 ： 左 边 一 个 ， 右 边 一 个 ； 在 列 国 中 没 有 这 样 做 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9101', '11', '10', '21', '所 罗 门 王 一 切 的 饮 器 都 是 金 子 的 。 利 巴 嫩 林 宫 里 的 一 切 器 皿 都 是 精 金 的 。 所 罗 门 年 间 ， 银 子 算 不 了 甚 麽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9102', '11', '10', '22', '因 为 王 有 他 施 船 只 与 希 兰 的 船 只 一 同 航 海 ， 三 年 一 次 ， 装 载 金 银 、 象 牙 、 猿 猴 、 孔 雀 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9103', '11', '10', '23', '所 罗 门 王 的 财 宝 与 智 慧 胜 过 天 下 的 列 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9104', '11', '10', '24', '普 天 下 的 王 都 求 见 所 罗 门 ， 要 听 　 神 赐 给 他 智 慧 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9105', '11', '10', '25', '他 们 各 带 贡 物 ， 就 是 金 器 、 银 器 、 衣 服 、 军 械 、 香 料 、 骡 马 ， 每 年 有 一 定 之 例 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9106', '11', '10', '26', '所 罗 门 聚 集 战 车 马 兵 ， 有 战 车 一 千 四 百 辆 ， 马 兵 一 万 二 千 名 ， 安 置 在 屯 车 的 城 邑 和 耶 路 撒 冷 ， 就 是 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9107', '11', '10', '27', '王 在 耶 路 撒 冷 使 银 子 多 如 石 头 ， 香 柏 木 多 如 高 原 的 桑 树 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9108', '11', '10', '28', '所 罗 门 的 马 是 从 埃 及 带 来 的 ， 是 王 的 商 人 一 群 一 群 按 着 定 价 买 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9109', '11', '10', '29', '从 埃 及 买 来 的 车 ， 每 辆 价 银 六 百 舍 客 勒 ， 马 每 匹 一 百 五 十 舍 客 勒 。 赫 人 诸 王 和 亚 兰 诸 王 所 买 的 车 马 ， 也 是 按 这 价 值 经 他 们 手 买 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9110', '11', '11', '1', '所 罗 门 王 在 法 老 的 女 儿 之 外 ， 又 宠 爱 许 多 外 邦 女 子 ， 就 是 摩 押 女 子 、 亚 扪 女 子 、 以 东 女 子 、 西 顿 女 子 、 赫 人 女 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9111', '11', '11', '2', '论 到 这 些 国 的 人 ， 耶 和 华 曾 晓 谕 以 色 列 人 说 ： 你 们 不 可 与 他 们 往 来 相 通 ， 因 为 他 们 必 诱 惑 你 们 的 心 去 随 从 他 们 的 　 神 。 所 罗 门 却 恋 爱 这 些 女 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9112', '11', '11', '3', '所 罗 门 有 妃 七 百 ， 都 是 公 主 ； 还 有 嫔 三 百 。 这 些 妃 嫔 诱 惑 他 的 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9113', '11', '11', '4', '所 罗 门 年 老 的 时 候 ， 他 的 妃 嫔 诱 惑 他 的 心 去 随 从 别 　 神 ， 不 效 法 他 父 亲 大 卫 诚 诚 实 实 地 顺 服 耶 和 华 ─ 他 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9114', '11', '11', '5', '因 为 所 罗 门 随 从 西 顿 人 的 女 　 神 亚 斯 他 录 和 亚 扪 人 可 憎 的 神 米 勒 公 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9115', '11', '11', '6', '所 罗 门 行 耶 和 华 眼 中 看 为 恶 的 事 ， 不 效 法 他 父 亲 大 卫 专 心 顺 从 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9116', '11', '11', '7', '所 罗 门 为 摩 押 可 憎 的 神 基 抹 和 亚 扪 人 可 憎 的 神 摩 洛 ， 在 耶 路 撒 冷 对 面 的 山 上 建 筑 邱 坛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9117', '11', '11', '8', '他 为 那 些 向 自 己 的 　 神 烧 香 献 祭 的 外 邦 女 子 ， 就 是 他 娶 来 的 妃 嫔 也 是 这 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9118', '11', '11', '9', '耶 和 华 向 所 罗 门 发 怒 ， 因 为 他 的 心 偏 离 向 他 两 次 显 现 的 耶 和 华 ─ 以 色 列 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9119', '11', '11', '10', '耶 和 华 曾 吩 咐 他 不 可 随 从 别 　 神 ， 他 却 没 有 遵 守 耶 和 华 所 吩 咐 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9120', '11', '11', '11', '所 以 耶 和 华 对 他 说 ： 你 既 行 了 这 事 ， 不 遵 守 我 所 吩 咐 你 守 的 约 和 律 例 ， 我 必 将 你 的 国 夺 回 ， 赐 给 你 的 臣 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9121', '11', '11', '12', '然 而 ， 因 你 父 亲 大 卫 的 缘 故 ， 我 不 在 你 活 着 的 日 子 行 这 事 ， 必 从 你 儿 子 的 手 中 将 国 夺 回 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9122', '11', '11', '13', '只 是 我 不 将 全 国 夺 回 ， 要 因 我 仆 人 大 卫 和 我 所 选 择 的 耶 路 撒 冷 ， 还 留 一 支 派 给 你 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9123', '11', '11', '14', '耶 和 华 使 以 东 人 哈 达 兴 起 ， 作 所 罗 门 的 敌 人 ； 他 是 以 东 王 的 後 裔 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9124', '11', '11', '15', '先 前 大 卫 攻 击 以 东 ， 元 帅 约 押 上 去 葬 埋 阵 亡 的 人 ， 将 以 东 的 男 丁 都 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9125', '11', '11', '16', '约 押 和 以 色 列 众 人 在 以 东 住 了 六 个 月 ， 直 到 将 以 东 的 男 丁 尽 都 剪 除 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9126', '11', '11', '17', '那 时 哈 达 还 是 幼 童 ； 他 和 他 父 亲 的 臣 仆 ， 几 个 以 东 人 逃 往 埃 及 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9127', '11', '11', '18', '他 们 从 米 甸 起 行 ， 到 了 巴 兰 ； 从 巴 兰 带 着 几 个 人 来 到 埃 及 见 埃 及 王 法 老 ； 法 老 为 他 派 定 粮 食 ， 又 给 他 房 屋 田 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9128', '11', '11', '19', '哈 达 在 法 老 面 前 大 蒙 恩 惠 ， 以 致 法 老 将 王 后 答 比 匿 的 妹 子 赐 他 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9129', '11', '11', '20', '答 比 匿 的 妹 子 给 哈 达 生 了 一 个 儿 子 ， 名 叫 基 努 拔 。 答 比 匿 使 基 努 拔 在 法 老 的 宫 里 断 奶 ， 基 努 拔 就 与 法 老 的 众 子 一 同 住 在 法 老 的 宫 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9130', '11', '11', '21', '哈 达 在 埃 及 听 见 大 卫 与 他 列 祖 同 睡 ， 元 帅 约 押 也 死 了 ， 就 对 法 老 说 ： 求 王 容 我 回 本 国 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9131', '11', '11', '22', '法 老 对 他 说 ： 你 在 我 这 里 有 甚 麽 缺 乏 ， 你 竟 要 回 你 本 国 去 呢 ？ 他 回 答 说 ： 我 没 有 缺 乏 甚 麽 ， 只 是 求 王 容 我 回 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9132', '11', '11', '23', '　 神 又 使 以 利 亚 大 的 儿 子 利 逊 兴 起 ， 作 所 罗 门 的 敌 人 。 他 先 前 逃 避 主 人 琐 巴 王 哈 大 底 谢 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9133', '11', '11', '24', '大 卫 击 杀 琐 巴 人 的 时 候 ， 利 逊 招 聚 了 一 群 人 ， 自 己 作 他 们 的 头 目 ， 往 大 马 色 居 住 ， 在 那 里 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9134', '11', '11', '25', '所 罗 门 活 着 的 时 候 ， 哈 达 为 患 之 外 ， 利 逊 也 作 以 色 列 的 敌 人 。 他 恨 恶 以 色 列 人 ， 且 作 了 亚 兰 人 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9135', '11', '11', '26', '所 罗 门 的 臣 仆 、 尼 八 的 儿 子 耶 罗 波 安 也 举 手 攻 击 王 。 他 是 以 法 莲 支 派 的 洗 利 达 人 ， 他 母 亲 是 寡 妇 ， 名 叫 洗 鲁 阿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9136', '11', '11', '27', '他 举 手 攻 击 王 的 缘 故 ， 乃 由 先 前 所 罗 门 建 造 米 罗 ， 修 补 他 父 亲 大 卫 城 的 破 口 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9137', '11', '11', '28', '耶 罗 波 安 是 大 有 才 能 的 人 。 所 罗 门 见 这 少 年 人 殷 勤 ， 就 派 他 监 管 约 瑟 家 的 一 切 工 程 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9138', '11', '11', '29', '一 日 ， 耶 罗 波 安 出 了 耶 路 撒 冷 ， 示 罗 人 先 知 亚 希 雅 在 路 上 遇 见 他 ； 亚 希 雅 身 上 穿 着 一 件 新 衣 。 他 们 二 人 在 田 野 ， 以 外 并 无 别 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9139', '11', '11', '30', '亚 希 雅 将 自 己 穿 的 那 件 新 衣 撕 成 十 二 片 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9140', '11', '11', '31', '对 耶 罗 波 安 说 ： 你 可 以 拿 十 片 。 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 我 必 将 国 从 所 罗 门 手 里 夺 回 ， 将 十 个 支 派 赐 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9141', '11', '11', '32', '（ 我 因 仆 人 大 卫 和 我 在 以 色 列 众 支 派 中 所 选 择 的 耶 路 撒 冷 城 的 缘 故 ， 仍 给 所 罗 门 留 一 个 支 派 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9142', '11', '11', '33', '因 为 他 离 弃 我 ， 敬 拜 西 顿 人 的 女 　 神 亚 斯 他 录 、 摩 押 的 　 神 基 抹 ， 和 亚 扪 人 的 　 神 米 勒 公 ， 没 有 遵 从 我 的 道 ， 行 我 眼 中 看 为 正 的 事 ， 守 我 的 律 例 典 章 ， 像 他 父 亲 大 卫 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9143', '11', '11', '34', '但 我 不 从 他 手 里 将 全 国 夺 回 ； 使 他 终 身 为 君 ， 是 因 我 所 拣 选 的 仆 人 大 卫 谨 守 我 的 诫 命 律 例 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9144', '11', '11', '35', '我 必 从 他 儿 子 的 手 里 将 国 夺 回 ， 以 十 个 支 派 赐 给 你 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9145', '11', '11', '36', '还 留 一 个 支 派 给 他 的 儿 子 ， 使 我 仆 人 大 卫 在 我 所 选 择 立 我 名 的 耶 路 撒 冷 城 里 ， 在 我 面 前 长 有 灯 光 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9146', '11', '11', '37', '我 必 拣 选 你 ， 使 你 照 心 里 一 切 所 愿 的 ， 作 王 治 理 以 色 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9147', '11', '11', '38', '你 若 听 从 我 一 切 所 吩 咐 你 的 ， 遵 行 我 的 道 ， 行 我 眼 中 看 为 正 的 事 ， 谨 守 我 的 律 例 诫 命 ， 像 我 仆 人 大 卫 所 行 的 ， 我 就 与 你 同 在 ， 为 你 立 坚 固 的 家 ， 像 我 为 大 卫 所 立 的 一 样 ， 将 以 色 列 人 赐 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9148', '11', '11', '39', '我 必 因 所 罗 门 所 行 的 使 大 卫 後 裔 受 患 难 ， 但 不 至 於 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9149', '11', '11', '40', '所 罗 门 因 此 想 要 杀 耶 罗 波 安 。 耶 罗 波 安 却 起 身 逃 往 埃 及 ； 到 了 埃 及 王 示 撒 那 里 ， 就 住 在 埃 及 ， 直 到 所 罗 门 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9150', '11', '11', '41', '所 罗 门 其 馀 的 事 ， 凡 他 所 行 的 和 他 的 智 慧 都 写 在 所 罗 门 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9151', '11', '11', '42', '所 罗 门 在 耶 路 撒 冷 作 以 色 列 众 人 的 王 共 四 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9152', '11', '11', '43', '所 罗 门 与 他 列 祖 同 睡 ， 葬 在 他 父 亲 大 卫 的 城 里 。 他 儿 子 罗 波 安 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9153', '11', '12', '1', '罗 波 安 往 示 剑 去 ； 因 为 以 色 列 人 都 到 了 示 剑 要 立 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9154', '11', '12', '2', '尼 八 的 儿 子 耶 罗 波 安 先 前 躲 避 所 罗 门 王 ， 逃 往 埃 及 ， 住 在 那 里 （ 他 听 见 这 事 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9155', '11', '12', '3', '以 色 列 人 打 发 人 去 请 他 来 ， 他 就 和 以 色 列 会 众 都 来 见 罗 波 安 ， 对 他 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9156', '11', '12', '4', '你 父 亲 使 我 们 负 重 轭 ， 做 苦 工 ， 现 在 求 你 使 我 们 做 的 苦 工 、 负 的 重 轭 轻 松 些 ， 我 们 就 事 奉 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9157', '11', '12', '5', '罗 波 安 对 他 们 说 ： 你 们 暂 且 去 ， 第 三 日 再 来 见 我 。 民 就 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9158', '11', '12', '6', '罗 波 安 之 父 所 罗 门 在 世 的 日 子 ， 有 侍 立 在 他 面 前 的 老 年 人 ， 罗 波 安 王 和 他 们 商 议 ， 说 ： 你 们 给 我 出 个 甚 麽 主 意 ， 我 好 回 覆 这 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9159', '11', '12', '7', '老 年 人 对 他 说 ： 现 在 王 若 服 事 这 民 如 仆 人 ， 用 好 话 回 答 他 们 ， 他 们 就 永 远 作 王 的 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9160', '11', '12', '8', '王 却 不 用 老 年 人 给 他 出 的 主 意 ， 就 和 那 些 与 他 一 同 长 大 、 在 他 面 前 侍 立 的 少 年 人 商 议 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9161', '11', '12', '9', '说 ： 这 民 对 我 说 ： 你 父 亲 使 我 们 负 重 轭 ， 求 你 使 我 们 轻 松 些 。 你 们 给 我 出 个 甚 麽 主 意 ， 我 好 回 覆 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9162', '11', '12', '10', '那 同 他 长 大 的 少 年 人 说 ： 这 民 对 王 说 ： 你 父 亲 使 我 们 负 重 轭 ， 求 你 使 我 们 轻 松 些 。 王 要 对 他 们 如 此 说 ： 我 的 小 拇 指 头 比 我 父 亲 的 腰 还 粗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9163', '11', '12', '11', '我 父 亲 使 你 们 负 重 轭 ， 我 必 使 你 们 负 更 重 的 轭 ！ 我 父 亲 用 鞭 子 责 打 你 们 ， 我 要 用 蝎 子 鞭 责 打 你 们 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9164', '11', '12', '12', '耶 罗 波 安 和 众 百 姓 遵 着 罗 波 安 王 所 说 你 们 第 三 日 再 来 见 我 的 那 话 ， 第 三 日 他 们 果 然 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9165', '11', '12', '13', '王 用 严 厉 的 话 回 答 百 姓 ， 不 用 老 年 人 给 他 所 出 的 主 意 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9166', '11', '12', '14', '照 着 少 年 人 所 出 的 主 意 对 民 说 ： 我 父 亲 使 你 们 负 重 轭 ， 我 必 使 你 们 负 更 重 的 轭 ！ 我 父 亲 用 鞭 子 责 打 你 们 ， 我 要 用 蝎 子 鞭 责 打 你 们 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9167', '11', '12', '15', '王 不 肯 依 从 百 姓 ， 这 事 乃 出 於 耶 和 华 ， 为 要 应 验 他 藉 示 罗 人 亚 希 雅 对 尼 八 的 儿 子 耶 罗 波 安 所 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9168', '11', '12', '16', '以 色 列 众 民 见 王 不 依 从 他 们 ， 就 对 王 说 ： 我 们 与 大 卫 有 甚 麽 分 儿 呢 ？ 与 耶 西 的 儿 子 并 没 有 关 涉 。 以 色 列 人 哪 ， 各 回 各 家 去 罢 ！ 大 卫 家 啊 ， 自 己 顾 自 己 罢 ！ 於 是 ， 以 色 列 人 都 回 自 己 家 里 去 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9169', '11', '12', '17', '惟 独 住 犹 大 城 邑 的 以 色 列 人 ， 罗 波 安 仍 作 他 们 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9170', '11', '12', '18', '罗 波 安 王 差 遣 掌 管 服 苦 之 人 的 亚 多 兰 往 以 色 列 人 那 里 去 ， 以 色 列 人 就 用 石 头 打 死 他 。 罗 波 安 王 急 忙 上 车 ， 逃 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9171', '11', '12', '19', '这 样 ， 以 色 列 人 背 叛 大 卫 家 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9172', '11', '12', '20', '以 色 列 众 人 听 见 耶 罗 波 安 回 来 了 ， 就 打 发 人 去 请 他 到 会 众 面 前 ， 立 他 作 以 色 列 众 人 的 王 。 除 了 犹 大 支 派 以 外 ， 没 有 顺 从 大 卫 家 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9173', '11', '12', '21', '罗 波 安 来 到 耶 路 撒 冷 ， 招 聚 犹 大 全 家 和 便 雅 悯 支 派 的 人 共 十 八 万 ， 都 是 挑 选 的 战 士 ， 要 与 以 色 列 家 争 战 ， 好 将 国 夺 回 ， 再 归 所 罗 门 的 儿 子 罗 波 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9174', '11', '12', '22', '但 　 神 的 话 临 到 　 神 人 示 玛 雅 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9175', '11', '12', '23', '你 去 告 诉 所 罗 门 的 儿 子 犹 大 王 罗 波 安 和 犹 大 、 便 雅 悯 全 家 ， 并 其 馀 的 民 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9176', '11', '12', '24', '耶 和 华 如 此 说 ： 你 们 不 可 上 去 与 你 们 的 弟 兄 以 色 列 人 争 战 。 各 归 各 家 去 罢 ！ 因 为 这 事 出 於 我 。 众 人 就 听 从 耶 和 华 的 话 ， 遵 着 耶 和 华 的 命 回 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9177', '11', '12', '25', '耶 罗 波 安 在 以 法 莲 山 地 建 筑 示 剑 ， 就 住 在 其 中 ； 又 从 示 剑 出 去 ， 建 筑 毗 努 伊 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9178', '11', '12', '26', '耶 罗 波 安 心 里 说 ： 恐 怕 这 国 仍 归 大 卫 家 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9179', '11', '12', '27', '这 民 若 上 耶 路 撒 冷 去 ， 在 耶 和 华 的 殿 里 献 祭 ， 他 们 的 心 必 归 向 他 们 的 主 ─ 犹 大 王 罗 波 安 ， 就 把 我 杀 了 ， 仍 归 犹 大 王 罗 波 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9180', '11', '12', '28', '耶 罗 波 安 王 就 筹 划 定 妥 ， 铸 造 了 两 个 金 牛 犊 ， 对 众 民 说 ： 以 色 列 人 哪 ， 你 们 上 耶 路 撒 冷 去 实 在 是 难 ； 这 就 是 领 你 们 出 埃 及 地 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9181', '11', '12', '29', '他 就 把 牛 犊 一 只 安 在 伯 特 利 ， 一 只 安 在 但 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9182', '11', '12', '30', '这 事 叫 百 姓 陷 在 罪 里 ， 因 为 他 们 往 但 去 拜 那 牛 犊 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9183', '11', '12', '31', '耶 罗 波 安 在 邱 坛 那 里 建 殿 ， 将 那 不 属 利 未 人 的 凡 民 立 为 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9184', '11', '12', '32', '耶 罗 波 安 定 八 月 十 五 日 为 节 期 ， 像 在 犹 大 的 节 期 一 样 ， 自 己 上 坛 献 祭 。 他 在 伯 特 利 也 这 样 向 他 所 铸 的 牛 犊 献 祭 ， 又 将 立 为 邱 坛 的 祭 司 安 置 在 伯 特 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9185', '11', '12', '33', '他 在 八 月 十 五 日 ， 就 是 他 私 自 所 定 的 月 日 ， 为 以 色 列 人 立 作 节 期 的 日 子 ， 在 伯 特 利 上 坛 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9186', '11', '13', '1', '那 时 ， 有 一 个 　 神 人 奉 耶 和 华 的 命 从 犹 大 来 到 伯 特 利 。 耶 罗 波 安 正 站 在 坛 旁 要 烧 香 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9187', '11', '13', '2', '神 人 奉 耶 和 华 的 命 向 坛 呼 叫 ， 说 ： 坛 哪 ， 坛 哪 ！ 耶 和 华 如 此 说 ： 大 卫 家 里 必 生 一 个 儿 子 ， 名 叫 约 西 亚 ， 他 必 将 邱 坛 的 祭 司 ， 就 是 在 你 上 面 烧 香 的 ， 杀 在 你 上 面 ， 人 的 骨 头 也 必 烧 在 你 上 面 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9188', '11', '13', '3', '当 日 ， 神 人 设 个 预 兆 ， 说 ： 这 坛 必 破 裂 ， 坛 上 的 灰 必 倾 撒 ， 这 是 耶 和 华 说 的 预 兆 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9189', '11', '13', '4', '耶 罗 波 安 王 听 见 　 神 人 向 伯 特 利 的 坛 所 呼 叫 的 话 ， 就 从 坛 上 伸 手 ， 说 ： 拿 住 他 罢 ！ 王 向 神 人 所 伸 的 手 就 枯 乾 了 ， 不 能 弯 回 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9190', '11', '13', '5', '坛 也 破 裂 了 ， 坛 上 的 灰 倾 撒 了 ， 正 如 　 神 人 奉 耶 和 华 的 命 所 设 的 预 兆 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9191', '11', '13', '6', '王 对 　 神 人 说 ： 请 你 为 我 祷 告 ， 求 耶 和 华 ─ 你 　 神 的 恩 典 使 我 的 手 复 原 。 於 是 　 神 人 祈 祷 耶 和 华 ， 王 的 手 就 复 了 原 ， 仍 如 寻 常 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9192', '11', '13', '7', '王 对 　 神 人 说 ： 请 你 同 我 回 去 吃 饭 ， 加 添 心 力 ， 我 也 必 给 你 赏 赐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9193', '11', '13', '8', '　 神 人 对 王 说 ： 你 就 是 把 你 的 宫 一 半 给 我 ， 我 也 不 同 你 进 去 ， 也 不 在 这 地 方 吃 饭 喝 水 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9194', '11', '13', '9', '因 为 有 耶 和 华 的 话 嘱 咐 我 ， 说 不 可 在 伯 特 利 吃 饭 喝 水 ， 也 不 可 从 你 去 的 原 路 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9195', '11', '13', '10', '於 是 神 人 从 别 的 路 回 去 ， 不 从 伯 特 利 来 的 原 路 回 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9196', '11', '13', '11', '有 一 个 老 先 知 住 在 伯 特 利 ， 他 儿 子 们 来 ， 将 　 神 人 当 日 在 伯 特 利 所 行 的 一 切 事 和 向 王 所 说 的 话 都 告 诉 了 父 亲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9197', '11', '13', '12', '父 亲 问 他 们 说 ： 神 人 从 哪 条 路 去 了 呢 ？ 儿 子 们 就 告 诉 他 ； 原 来 他 们 看 见 那 从 犹 大 来 的 　 神 人 所 去 的 路 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9198', '11', '13', '13', '老 先 知 就 吩 咐 他 儿 子 们 说 ： 你 们 为 我 备 驴 。 他 们 备 好 了 驴 ， 他 就 骑 上 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9199', '11', '13', '14', '去 追 赶 　 神 人 ， 遇 见 他 坐 在 橡 树 底 下 ， 就 问 他 说 ： 你 是 从 犹 大 来 的 　 神 人 不 是 ？ 他 说 ： 是 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9200', '11', '13', '15', '老 先 知 对 他 说 ： 请 你 同 我 回 家 吃 饭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9201', '11', '13', '16', '神 人 说 ： 我 不 可 同 你 回 去 进 你 的 家 ， 也 不 可 在 这 里 同 你 吃 饭 喝 水 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9202', '11', '13', '17', '因 为 有 耶 和 华 的 话 嘱 咐 我 说 ： 你 在 那 里 不 可 吃 饭 喝 水 ， 也 不 可 从 你 去 的 原 路 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9203', '11', '13', '18', '老 先 知 对 他 说 ： 我 也 是 先 知 ， 和 你 一 样 。 有 天 使 奉 耶 和 华 的 命 对 我 说 ： 你 去 把 他 带 回 你 的 家 ， 叫 他 吃 饭 喝 水 。 这 都 是 老 先 知 诓 哄 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9204', '11', '13', '19', '於 是 神 人 同 老 先 知 回 去 ， 在 他 家 里 吃 饭 喝 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9205', '11', '13', '20', '二 人 坐 席 的 时 候 ， 耶 和 华 的 话 临 到 那 带 神 人 回 来 的 先 知 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9206', '11', '13', '21', '他 就 对 那 从 犹 大 来 的 　 神 人 说 ： 耶 和 华 如 此 说 ： 你 既 违 背 耶 和 华 的 话 ， 不 遵 守 耶 和 华 ─ 你 　 神 的 命 令 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9207', '11', '13', '22', '反 倒 回 来 ， 在 耶 和 华 禁 止 你 吃 饭 喝 水 的 地 方 吃 了 喝 了 ， 因 此 你 的 尸 身 不 得 入 你 列 祖 的 坟 墓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9208', '11', '13', '23', '吃 喝 完 了 ， 老 先 知 为 所 带 回 来 的 先 知 备 驴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9209', '11', '13', '24', '他 就 去 了 ， 在 路 上 有 个 狮 子 遇 见 他 ， 将 他 咬 死 ， 尸 身 倒 在 路 上 ， 驴 站 在 尸 身 旁 边 ， 狮 子 也 站 在 尸 身 旁 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9210', '11', '13', '25', '有 人 从 那 里 经 过 ， 看 见 尸 身 倒 在 路 上 ， 狮 子 站 在 尸 身 旁 边 ， 就 来 到 老 先 知 所 住 的 城 里 述 说 这 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9211', '11', '13', '26', '那 带 神 人 回 来 的 先 知 听 见 这 事 ， 就 说 ： 这 是 那 违 背 了 耶 和 华 命 令 的 　 神 人 ， 所 以 耶 和 华 把 他 交 给 狮 子 ； 狮 子 抓 伤 他 ， 咬 死 他 ， 是 应 验 耶 和 华 对 他 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9212', '11', '13', '27', '老 先 知 就 吩 咐 他 儿 子 们 说 ： 你 们 为 我 备 驴 。 他 们 就 备 了 驴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9213', '11', '13', '28', '他 去 了 ， 看 见 神 人 的 尸 身 倒 在 路 上 ， 驴 和 狮 子 站 在 尸 身 旁 边 ， 狮 子 却 没 有 吃 尸 身 ， 也 没 有 抓 伤 驴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9214', '11', '13', '29', '老 先 知 就 把 　 神 人 的 尸 身 驮 在 驴 上 ， 带 回 自 己 的 城 里 ， 要 哀 哭 他 ， 葬 埋 他 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9215', '11', '13', '30', '就 把 他 的 尸 身 葬 在 自 己 的 坟 墓 里 ， 哀 哭 他 ， 说 ： 哀 哉 ！ 我 兄 啊 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9216', '11', '13', '31', '安 葬 之 後 ， 老 先 知 对 他 儿 子 们 说 ： 我 死 了 ， 你 们 要 葬 我 在 　 神 人 的 坟 墓 里 ， 使 我 的 尸 骨 靠 近 他 的 尸 骨 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9217', '11', '13', '32', '因 为 他 奉 耶 和 华 的 命 指 着 伯 特 利 的 坛 和 撒 玛 利 亚 各 城 有 邱 坛 之 殿 所 说 的 话 必 定 应 验 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9218', '11', '13', '33', '这 事 以 後 ， 耶 罗 波 安 仍 不 离 开 他 的 恶 道 ， 将 凡 民 立 为 邱 坛 的 祭 司 ； 凡 愿 意 的 ， 他 都 分 别 为 圣 ， 立 为 邱 坛 的 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9219', '11', '13', '34', '这 事 叫 耶 罗 波 安 的 家 陷 在 罪 里 ， 甚 至 他 的 家 从 地 上 除 灭 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9220', '11', '14', '1', '那 时 ， 耶 罗 波 安 的 儿 子 亚 比 雅 病 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9221', '11', '14', '2', '耶 罗 波 安 对 他 的 妻 说 ： 你 可 以 起 来 改 装 ， 使 人 不 知 道 你 是 耶 罗 波 安 的 妻 ， 往 示 罗 去 ， 在 那 里 有 先 知 亚 希 雅 。 他 曾 告 诉 我 说 ， 你 必 作 这 民 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9222', '11', '14', '3', '现 在 你 要 带 十 个 饼 ， 与 几 个 薄 饼 ， 和 一 瓶 蜜 去 见 他 ， 他 必 告 诉 你 儿 子 将 要 怎 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9223', '11', '14', '4', '耶 罗 波 安 的 妻 就 这 样 行 ， 起 身 往 示 罗 去 ， 到 了 亚 希 雅 的 家 。 亚 希 雅 因 年 纪 老 迈 ， 眼 目 发 直 ， 不 能 看 见 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9224', '11', '14', '5', '耶 和 华 先 晓 谕 亚 希 雅 说 ： 耶 罗 波 安 的 妻 要 来 问 你 ， 因 他 儿 子 病 了 ， 你 当 此 此 如 此 告 诉 他 。 他 进 来 的 时 候 必 装 作 别 的 妇 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9225', '11', '14', '6', '他 刚 进 门 ， 亚 希 雅 听 见 他 脚 步 的 响 声 ， 就 说 ： 耶 罗 波 安 的 妻 ， 进 来 罢 ！ 你 为 何 装 作 别 的 妇 人 呢 ？ 我 奉 差 遣 将 凶 事 告 诉 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9226', '11', '14', '7', '你 回 去 告 诉 耶 罗 波 安 说 ： 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 我 从 民 中 将 你 高 举 ， 立 你 作 我 民 以 色 列 的 君 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9227', '11', '14', '8', '将 国 从 大 卫 家 夺 回 赐 给 你 ； 你 却 不 效 法 我 仆 人 大 卫 ， 遵 守 我 的 诫 命 ， 一 心 顺 从 我 ， 行 我 眼 中 看 为 正 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9228', '11', '14', '9', '你 竟 行 恶 ， 比 那 在 你 以 先 的 更 甚 ， 为 自 己 立 了 别 　 神 ， 铸 了 偶 像 ， 惹 我 发 怒 ， 将 我 丢 在 背 後 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9229', '11', '14', '10', '因 此 ， 我 必 使 灾 祸 临 到 耶 罗 波 安 的 家 ， 将 属 耶 罗 波 安 的 男 丁 ， 无 论 困 住 的 、 自 由 的 都 从 以 色 列 中 剪 除 ， 必 除 尽 耶 罗 波 安 的 家 ， 如 人 除 尽 粪 土 一 般 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9230', '11', '14', '11', '凡 属 耶 罗 波 安 的 人 ， 死 在 城 中 的 必 被 狗 吃 ， 死 在 田 野 的 必 被 空 中 的 鸟 吃 。 这 是 耶 和 华 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9231', '11', '14', '12', '所 以 你 起 身 回 家 去 罢 ！ 你 的 脚 一 进 城 ， 你 儿 子 就 必 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9232', '11', '14', '13', '以 色 列 众 人 必 为 他 哀 哭 ， 将 他 葬 埋 。 凡 属 耶 罗 波 安 的 人 ， 惟 有 他 得 入 坟 墓 ； 因 为 在 耶 罗 波 安 的 家 中 ， 只 有 他 向 耶 和 华 ─ 以 色 列 的 　 神 显 出 善 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9233', '11', '14', '14', '耶 和 华 必 另 立 一 王 治 理 以 色 列 。 到 了 日 期 ， 他 必 剪 除 耶 罗 波 安 的 家 ； 那 日 期 已 经 到 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9234', '11', '14', '15', '耶 和 华 必 击 打 以 色 列 人 ， 使 他 们 摇 动 ， 像 水 中 的 芦 苇 一 般 ； 又 将 他 们 从 耶 和 华 赐 给 他 们 列 祖 的 美 地 上 拔 出 来 ， 分 散 在 大 河 那 边 ； 因 为 他 们 做 木 偶 ， 惹 耶 和 华 发 怒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9235', '11', '14', '16', '因 耶 罗 波 安 所 犯 的 罪 ， 又 使 以 色 列 人 陷 在 罪 里 ， 耶 和 华 必 将 以 色 列 人 交 给 仇 敌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9236', '11', '14', '17', '耶 罗 波 安 的 妻 起 身 回 去 ， 到 了 得 撒 ， 刚 到 门 槛 ， 儿 子 就 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9237', '11', '14', '18', '以 色 列 众 人 将 他 葬 埋 ， 为 他 哀 哭 ， 正 如 耶 和 华 藉 他 仆 人 先 知 亚 希 雅 所 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9238', '11', '14', '19', '耶 罗 波 安 其 馀 的 事 ， 他 怎 样 争 战 ， 怎 样 作 王 ， 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9239', '11', '14', '20', '耶 罗 波 安 作 王 二 十 二 年 ， 就 与 他 列 祖 同 睡 。 他 儿 子 拿 答 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9240', '11', '14', '21', '所 罗 门 的 儿 子 罗 波 安 作 犹 大 王 。 他 登 基 的 时 候 年 四 十 一 岁 ， 在 耶 路 撒 冷 ， 就 是 耶 和 华 从 以 色 列 众 支 派 中 所 选 择 立 他 名 的 城 ， 作 王 十 七 年 。 罗 波 安 的 母 亲 名 叫 拿 玛 ， 是 亚 扪 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9241', '11', '14', '22', '犹 大 人 行 耶 和 华 眼 中 看 为 恶 的 事 ， 犯 罪 触 动 他 的 愤 恨 ， 比 他 们 列 祖 更 甚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9242', '11', '14', '23', '因 为 他 们 在 各 高 冈 上 ， 各 青 翠 树 下 筑 坛 ， 立 柱 像 和 木 偶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9243', '11', '14', '24', '国 中 也 有 娈 童 。 犹 大 人 效 法 耶 和 华 在 以 色 列 人 面 前 所 赶 出 的 外 邦 人 ， 行 一 切 可 憎 恶 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9244', '11', '14', '25', '罗 波 安 王 第 五 年 ， 埃 及 王 示 撒 上 来 攻 取 耶 路 撒 冷 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9245', '11', '14', '26', '夺 了 耶 和 华 殿 和 王 宫 里 的 宝 物 ， 尽 都 带 走 ， 又 夺 去 所 罗 门 制 造 的 金 盾 牌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9246', '11', '14', '27', '罗 波 安 王 制 造 铜 盾 牌 代 替 那 金 盾 牌 ， 交 给 守 王 宫 门 的 护 卫 长 看 守 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9247', '11', '14', '28', '王 每 逢 进 耶 和 华 的 殿 ， 护 卫 兵 就 拿 这 盾 牌 ， 随 後 仍 将 盾 牌 送 回 ， 放 在 护 卫 房 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9248', '11', '14', '29', '罗 波 安 其 馀 的 事 ， 凡 他 所 行 的 ， 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9249', '11', '14', '30', '罗 波 安 与 耶 罗 波 安 时 常 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9250', '11', '14', '31', '罗 波 安 与 他 列 祖 同 睡 ， 葬 在 大 卫 城 他 列 祖 的 坟 地 里 。 他 母 亲 名 叫 拿 玛 ， 是 亚 扪 人 。 他 儿 子 亚 比 央 ( 又 名 亚 比 雅 ) 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9251', '11', '15', '1', '尼 八 的 儿 子 耶 罗 波 安 王 十 八 年 ， 亚 比 央 登 基 作 犹 大 王 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9252', '11', '15', '2', '在 耶 路 撒 冷 作 王 三 年 。 他 母 亲 名 叫 玛 迦 ， 是 押 沙 龙 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9253', '11', '15', '3', '亚 比 央 行 他 父 亲 在 他 以 前 所 行 的 一 切 恶 ， 他 的 心 不 像 他 祖 大 卫 的 心 ， 诚 诚 实 实 地 顺 服 耶 和 华 ─ 他 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9254', '11', '15', '4', '然 而 耶 和 华 ─ 他 的 　 神 因 大 卫 的 缘 故 ， 仍 使 他 在 耶 路 撒 冷 有 灯 光 ， 叫 他 儿 子 接 续 他 作 王 ， 坚 立 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9255', '11', '15', '5', '因 为 大 卫 除 了 赫 人 乌 利 亚 那 件 事 ， 都 是 行 耶 和 华 眼 中 看 为 正 的 事 ， 一 生 没 有 违 背 耶 和 华 一 切 所 吩 咐 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9256', '11', '15', '6', '罗 波 安 在 世 的 日 子 常 与 耶 罗 波 安 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9257', '11', '15', '7', '亚 比 央 其 馀 的 事 ， 凡 他 所 行 的 ， 都 写 在 犹 大 列 王 记 上 。 亚 比 央 常 与 耶 罗 波 安 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9258', '11', '15', '8', '亚 比 央 与 他 列 祖 同 睡 ， 葬 在 大 卫 的 城 里 。 他 儿 子 亚 撒 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9259', '11', '15', '9', '以 色 列 王 耶 罗 波 安 二 十 年 ， 亚 撒 登 基 作 犹 大 王 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9260', '11', '15', '10', '在 耶 路 撒 冷 作 王 四 十 一 年 。 他 祖 母 名 叫 玛 迦 ， 是 押 沙 龙 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9261', '11', '15', '11', '亚 撒 效 法 他 祖 大 卫 行 耶 和 华 眼 中 看 为 正 的 事 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9262', '11', '15', '12', '从 国 中 除 去 娈 童 ， 又 除 掉 他 列 祖 所 造 的 一 切 偶 像 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9263', '11', '15', '13', '并 且 贬 了 他 祖 母 玛 迦 太 后 的 位 ， 因 他 造 了 可 憎 的 偶 像 亚 舍 拉 。 亚 撒 砍 下 他 的 偶 像 ， 烧 在 汲 沦 溪 边 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9264', '11', '15', '14', '只 是 邱 坛 还 没 有 废 去 。 亚 撒 一 生 却 向 耶 和 华 存 诚 实 的 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9265', '11', '15', '15', '亚 撒 将 他 父 亲 所 分 别 为 圣 与 自 己 所 分 别 为 圣 的 金 银 和 器 皿 都 奉 到 耶 和 华 的 殿 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9266', '11', '15', '16', '亚 撒 和 以 色 列 王 巴 沙 在 世 的 日 子 常 常 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9267', '11', '15', '17', '以 色 列 王 巴 沙 上 来 要 攻 击 犹 大 ， 修 筑 拉 玛 ， 不 许 人 从 犹 大 王 亚 撒 那 里 出 入 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9268', '11', '15', '18', '於 是 亚 撒 将 耶 和 华 殿 和 王 宫 府 库 里 所 剩 下 的 金 银 都 交 在 他 臣 仆 手 中 ， 打 发 他 们 往 住 大 马 色 的 亚 兰 王 ─ 希 旬 的 孙 子 、 他 伯 利 们 的 儿 子 便 哈 达 那 里 去 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9269', '11', '15', '19', '说 ： 你 父 曾 与 我 父 立 约 ， 我 与 你 也 要 立 约 。 现 在 我 将 金 银 送 你 为 礼 物 ， 求 你 废 掉 你 与 以 色 列 王 巴 沙 所 立 的 约 ， 使 他 离 开 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9270', '11', '15', '20', '便 哈 达 听 从 亚 撒 王 的 话 ， 派 军 长 去 攻 击 以 色 列 的 城 邑 ； 他 们 就 攻 破 以 云 、 但 、 亚 伯 伯 玛 迦 、 基 尼 烈 全 境 、 拿 弗 他 利 全 境 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9271', '11', '15', '21', '巴 沙 听 见 ， 就 停 工 不 修 筑 拉 玛 了 ， 仍 住 在 得 撒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9272', '11', '15', '22', '於 是 亚 撒 王 宣 告 犹 大 众 人 ， 不 准 一 个 推 辞 ， 吩 咐 他 们 将 巴 沙 修 筑 拉 玛 所 用 的 石 头 、 木 头 都 运 去 ， 用 以 修 筑 便 雅 悯 的 迦 巴 和 米 斯 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9273', '11', '15', '23', '亚 撒 其 馀 的 事 ， 凡 他 所 行 的 ， 并 他 的 勇 力 与 他 所 建 筑 的 城 邑 ， 都 写 在 犹 大 列 王 记 上 。 亚 撒 年 老 的 时 候 ， 脚 上 有 病 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9274', '11', '15', '24', '亚 撒 与 他 列 祖 同 睡 ， 葬 在 他 祖 大 卫 城 他 列 祖 的 坟 地 里 。 他 儿 子 约 沙 法 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9275', '11', '15', '25', '犹 大 王 亚 撒 第 二 年 ， 耶 罗 波 安 的 儿 子 拿 答 登 基 作 以 色 列 王 共 二 年 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9276', '11', '15', '26', '拿 答 行 耶 和 华 眼 中 看 为 恶 的 事 ， 行 他 父 亲 所 行 的 ， 犯 他 父 亲 使 以 色 列 人 陷 在 罪 里 的 那 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9277', '11', '15', '27', '以 萨 迦 人 亚 希 雅 的 儿 子 巴 沙 背 叛 拿 答 ， 在 非 利 士 的 基 比 顿 杀 了 他 。 那 时 拿 答 和 以 色 列 众 人 正 围 困 基 比 顿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9278', '11', '15', '28', '在 犹 大 王 亚 撒 第 三 年 巴 沙 杀 了 他 ， 篡 了 他 的 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9279', '11', '15', '29', '巴 沙 一 作 王 就 杀 了 耶 罗 波 安 的 全 家 ， 凡 有 气 息 的 没 有 留 下 一 个 ， 都 灭 尽 了 ， 正 应 验 耶 和 华 藉 他 仆 人 示 罗 人 亚 希 雅 所 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9280', '11', '15', '30', '这 是 因 为 耶 罗 波 安 所 犯 的 罪 使 以 色 列 人 陷 在 罪 里 ， 惹 动 耶 和 华 ─ 以 色 列 　 神 的 怒 气 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9281', '11', '15', '31', '拿 答 其 馀 的 事 ， 凡 他 所 行 的 ， 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9282', '11', '15', '32', '亚 撒 和 以 色 列 王 巴 沙 在 世 的 日 子 常 常 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9283', '11', '15', '33', '犹 大 王 亚 撒 第 三 年 ， 亚 希 雅 的 儿 子 巴 沙 在 得 撒 登 基 作 以 色 列 众 人 的 王 共 廿 四 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9284', '11', '15', '34', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 行 耶 罗 波 安 所 行 的 道 ， 犯 他 使 以 色 列 人 陷 在 罪 里 的 那 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9285', '11', '16', '1', '耶 和 华 的 话 临 到 哈 拿 尼 的 儿 子 耶 户 ， 责 备 巴 沙 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9286', '11', '16', '2', '我 既 从 尘 埃 中 提 拔 你 ， 立 你 作 我 民 以 色 列 的 君 ， 你 竟 行 耶 罗 波 安 所 行 的 道 ， 使 我 民 以 色 列 陷 在 罪 里 ， 惹 我 发 怒 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9287', '11', '16', '3', '我 必 除 尽 你 和 你 的 家 ， 使 你 的 家 像 尼 八 的 儿 子 耶 罗 波 安 的 家 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9288', '11', '16', '4', '凡 属 巴 沙 的 人 ， 死 在 城 中 的 必 被 狗 吃 ， 死 在 田 野 的 必 被 空 中 的 鸟 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9289', '11', '16', '5', '巴 沙 其 馀 的 事 ， 凡 他 所 行 的 和 他 的 勇 力 ， 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9290', '11', '16', '6', '巴 沙 与 他 列 祖 同 睡 ， 葬 在 得 撒 。 他 儿 子 以 拉 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9291', '11', '16', '7', '耶 和 华 的 话 临 到 哈 拿 尼 的 儿 子 先 知 耶 户 ， 责 备 巴 沙 和 他 的 家 ， 因 他 行 耶 和 华 眼 中 看 为 恶 的 一 切 事 ， 以 他 手 所 做 的 惹 耶 和 华 发 怒 ， 像 耶 罗 波 安 的 家 一 样 ， 又 因 他 杀 了 耶 罗 波 安 的 全 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9292', '11', '16', '8', '犹 大 王 亚 撒 二 十 六 年 ， 巴 沙 的 儿 子 以 拉 在 得 撒 登 基 作 以 色 列 王 共 二 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9293', '11', '16', '9', '有 管 理 他 一 半 战 车 的 臣 子 心 利 背 叛 他 。 当 他 在 得 撒 家 宰 亚 杂 家 里 喝 醉 的 时 候 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9294', '11', '16', '10', '心 利 就 进 去 杀 了 他 ， 篡 了 他 的 位 。 这 是 犹 大 王 亚 撒 二 十 七 年 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9295', '11', '16', '11', '心 利 一 坐 王 位 就 杀 了 巴 沙 的 全 家 ， 连 他 的 亲 属 、 朋 友 也 没 有 留 下 一 个 男 丁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9296', '11', '16', '12', '心 利 这 样 灭 绝 巴 沙 的 全 家 ， 正 如 耶 和 华 藉 先 知 耶 户 责 备 巴 沙 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9297', '11', '16', '13', '这 是 因 巴 沙 和 他 儿 子 以 拉 的 一 切 罪 ， 就 是 他 们 使 以 色 列 人 陷 在 罪 里 的 那 罪 ， 以 虚 无 的 神 惹 耶 和 华 ─ 以 色 列 　 神 的 怒 气 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9298', '11', '16', '14', '以 拉 其 馀 的 事 ， 凡 他 所 行 的 ， 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9299', '11', '16', '15', '犹 大 王 亚 撒 二 十 七 年 ， 心 利 在 得 撒 作 王 七 日 。 那 时 民 正 安 营 围 攻 非 利 士 的 基 比 顿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9300', '11', '16', '16', '民 在 营 中 听 说 心 利 背 叛 ， 又 杀 了 王 ， 故 此 以 色 列 众 人 当 日 在 营 中 立 元 帅 暗 利 作 以 色 列 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9301', '11', '16', '17', '暗 利 率 领 以 色 列 众 人 ， 从 基 比 顿 上 去 ， 围 困 得 撒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9302', '11', '16', '18', '心 利 见 城 破 失 ， 就 进 了 王 宫 的 卫 所 ， 放 火 焚 烧 宫 殿 ， 自 焚 而 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9303', '11', '16', '19', '这 是 因 他 犯 罪 ， 行 耶 和 华 眼 中 看 为 恶 的 事 ， 行 耶 罗 波 安 所 行 的 ， 犯 他 使 以 色 列 人 陷 在 罪 里 的 那 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9304', '11', '16', '20', '心 利 其 馀 的 事 和 他 背 叛 的 情 形 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9305', '11', '16', '21', '那 时 ， 以 色 列 民 分 为 两 半 ： 一 半 随 从 基 纳 的 儿 子 提 比 尼 ， 要 立 他 作 王 ； 一 半 随 从 暗 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9306', '11', '16', '22', '但 随 从 暗 利 的 民 胜 过 随 从 基 纳 的 儿 子 提 比 尼 的 民 。 提 比 尼 死 了 ， 暗 利 就 作 了 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9307', '11', '16', '23', '犹 大 王 亚 撒 三 十 一 年 ， 暗 利 登 基 作 以 色 列 王 共 十 二 年 ； 在 得 撒 作 王 六 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9308', '11', '16', '24', '暗 利 用 二 他 连 得 银 子 向 撒 玛 买 了 撒 玛 利 亚 山 ， 在 山 上 造 城 ， 就 按 着 山 的 原 主 撒 玛 的 名 ， 给 所 造 的 城 起 名 叫 撒 玛 利 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9309', '11', '16', '25', '暗 利 行 耶 和 华 眼 中 看 为 恶 的 事 ， 比 他 以 前 的 列 王 作 恶 更 甚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9310', '11', '16', '26', '因 他 行 了 尼 八 的 儿 子 耶 罗 波 安 所 行 的 ， 犯 他 使 以 色 列 人 陷 在 罪 里 的 那 罪 ， 以 虚 无 的 神 惹 耶 和 华 ─ 以 色 列 　 神 的 怒 气 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9311', '11', '16', '27', '暗 利 其 馀 的 事 和 他 所 显 出 的 勇 力 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9312', '11', '16', '28', '暗 利 与 他 列 祖 同 睡 ， 葬 在 撒 玛 利 亚 。 他 儿 子 亚 哈 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9313', '11', '16', '29', '犹 大 王 亚 撒 三 十 八 年 ， 暗 利 的 儿 子 亚 哈 登 基 作 了 以 色 列 王 。 暗 利 的 儿 子 亚 哈 在 撒 玛 利 亚 作 以 色 列 王 二 十 二 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9314', '11', '16', '30', '暗 利 的 儿 子 亚 哈 行 耶 和 华 眼 中 看 为 恶 的 事 ， 比 他 以 前 的 列 王 更 甚 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9315', '11', '16', '31', '犯 了 尼 八 的 儿 子 耶 罗 波 安 所 犯 的 罪 ； 他 还 以 为 轻 ， 又 娶 了 西 顿 王 谒 巴 力 的 女 儿 耶 洗 别 为 妻 ， 去 事 奉 敬 拜 巴 力 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9316', '11', '16', '32', '在 撒 玛 利 亚 建 造 巴 力 的 庙 ， 在 庙 里 为 巴 力 筑 坛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9317', '11', '16', '33', '亚 哈 又 做 亚 舍 拉 ， 他 所 行 的 惹 耶 和 华 ─ 以 色 列 　 神 的 怒 气 ， 比 他 以 前 的 以 色 列 诸 王 更 甚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9318', '11', '16', '34', '亚 哈 在 位 的 时 候 ， 有 伯 特 利 人 希 伊 勒 重 修 耶 利 哥 城 ； 立 根 基 的 时 候 ， 丧 了 长 子 亚 比 兰 ； 安 门 的 时 候 ， 丧 了 幼 子 西 割 ， 正 如 耶 和 华 藉 嫩 的 儿 子 约 书 亚 所 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9319', '11', '17', '1', '基 列 寄 居 的 提 斯 比 人 以 利 亚 对 亚 哈 说 ： 我 指 着 所 事 奉 永 生 耶 和 华 ─ 以 色 列 的 　 神 起 誓 ， 这 几 年 我 若 不 祷 告 ， 必 不 降 露 ， 不 下 雨 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9320', '11', '17', '2', '耶 和 华 的 话 临 到 以 利 亚 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9321', '11', '17', '3', '你 离 开 这 里 往 东 去 ， 藏 在 约 但 河 东 边 的 基 立 溪 旁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9322', '11', '17', '4', '你 要 喝 那 溪 里 的 水 ， 我 已 吩 咐 乌 鸦 在 那 里 供 养 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9323', '11', '17', '5', '於 是 以 利 亚 照 着 耶 和 华 的 话 ， 去 住 在 约 但 河 东 的 基 立 溪 旁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9324', '11', '17', '6', '乌 鸦 早 晚 给 他 叼 饼 和 肉 来 ， 他 也 喝 那 溪 里 的 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9325', '11', '17', '7', '过 了 些 日 子 ， 溪 水 就 乾 了 ， 因 为 雨 没 有 下 在 地 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9326', '11', '17', '8', '耶 和 华 的 话 临 到 他 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9327', '11', '17', '9', '你 起 身 往 西 顿 的 撒 勒 法 ( 撒 勒 法 与 路 四26 同 ) 去 ， 住 在 那 里 ； 我 已 吩 咐 那 里 的 一 个 寡 妇 供 养 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9328', '11', '17', '10', '以 利 亚 就 起 身 往 撒 勒 法 去 。 到 了 城 门 ， 见 有 一 个 寡 妇 在 那 里 捡 柴 ， 以 利 亚 呼 叫 他 说 ： 求 你 用 器 皿 取 点 水 来 给 我 喝 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9329', '11', '17', '11', '他 去 取 水 的 时 候 ， 以 利 亚 又 呼 叫 他 说 ： 也 求 你 拿 点 饼 来 给 我 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9330', '11', '17', '12', '他 说 ： 我 指 着 永 生 耶 和 华 ─ 你 的 　 神 起 誓 ， 我 没 有 饼 ， ? 内 只 有 一 把 面 ， 瓶 里 只 有 一 点 油 ； 我 现 在 找 两 根 柴 ， 回 家 要 为 我 和 我 儿 子 做 饼 ； 我 们 吃 了 ， 死 就 死 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9331', '11', '17', '13', '以 利 亚 对 他 说 ： 不 要 惧 怕 ！ 可 以 照 你 所 说 的 去 做 罢 ！ 只 要 先 为 我 做 一 个 小 饼 拿 来 给 我 ， 然 後 为 你 和 你 的 儿 子 做 饼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9332', '11', '17', '14', '因 为 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： ? 内 的 面 必 不 减 少 ， 瓶 里 的 油 必 不 缺 短 ， 直 到 耶 和 华 使 雨 降 在 地 上 的 日 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9333', '11', '17', '15', '妇 人 就 照 以 利 亚 的 话 去 行 。 他 和 他 家 中 的 人 ， 并 以 利 亚 ， 吃 了 许 多 日 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9334', '11', '17', '16', '? 内 的 面 果 不 减 少 ， 瓶 里 的 油 也 不 缺 短 ， 正 如 耶 和 华 藉 以 利 亚 所 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9335', '11', '17', '17', '这 事 以 後 ， 作 那 家 主 母 的 妇 人 ， 他 儿 子 病 了 ； 病 得 甚 重 ， 以 致 身 无 气 息 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9336', '11', '17', '18', '妇 人 对 以 利 亚 说 ： 　 神 人 哪 ， 我 与 你 何 干 ？ 你 竟 到 我 这 里 来 ， 使 神 想 念 我 的 罪 ， 以 致 我 的 儿 子 死 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9337', '11', '17', '19', '以 利 亚 对 他 说 ： 把 你 儿 子 交 给 我 。 以 利 亚 就 从 妇 人 怀 中 将 孩 子 接 过 来 ， 抱 到 他 所 住 的 楼 中 ， 放 在 自 己 的 床 上 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9338', '11', '17', '20', '就 求 告 耶 和 华 说 ： 耶 和 华 ─ 我 的 　 神 啊 ， 我 寄 居 在 这 寡 妇 的 家 里 ， 你 就 降 祸 与 他 ， 使 他 的 儿 子 死 了 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9339', '11', '17', '21', '以 利 亚 三 次 伏 在 孩 子 的 身 上 ， 求 告 耶 和 华 说 ： 耶 和 华 ─ 我 的 　 神 啊 ， 求 你 使 这 孩 子 的 灵 魂 仍 入 他 的 身 体 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9340', '11', '17', '22', '耶 和 华 应 允 以 利 亚 的 话 ， 孩 子 的 灵 魂 仍 入 他 的 身 体 ， 他 就 活 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9341', '11', '17', '23', '以 利 亚 将 孩 子 从 楼 上 抱 下 来 ， 进 屋 子 交 给 他 母 亲 ， 说 ： 看 哪 ， 你 的 儿 子 活 了 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9342', '11', '17', '24', '妇 人 对 以 利 亚 说 ： 现 在 我 知 道 你 是 　 神 人 ， 耶 和 华 藉 你 口 所 说 的 话 是 真 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9343', '11', '18', '1', '过 了 许 久 ， 到 第 三 年 ， 耶 和 华 的 话 临 到 以 利 亚 说 ： 你 去 ， 使 亚 哈 得 见 你 ； 我 要 降 雨 在 地 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9344', '11', '18', '2', '以 利 亚 就 去 ， 要 使 亚 哈 得 见 他 。 那 时 ， 撒 玛 利 亚 有 大 饥 荒 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9345', '11', '18', '3', '亚 哈 将 他 的 家 宰 俄 巴 底 召 了 来 。 〈 俄 巴 底 甚 是 敬 畏 耶 和 华 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9346', '11', '18', '4', '耶 洗 别 杀 耶 和 华 众 先 知 的 时 候 ， 俄 巴 底 将 一 百 个 先 知 藏 了 ， 每 五 十 人 藏 在 一 个 洞 里 ， 拿 饼 和 水 供 养 他 们 。 〉');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9347', '11', '18', '5', '亚 哈 对 俄 巴 底 说 ： 我 们 走 遍 这 地 ， 到 一 切 水 泉 旁 和 一 切 溪 边 ， 或 者 找 得 着 青 草 ， 可 以 救 活 骡 马 ， 免 得 绝 了 牲 畜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9348', '11', '18', '6', '於 是 二 人 分 地 游 行 ， 亚 哈 独 走 一 路 ， 俄 巴 底 独 走 一 路 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9349', '11', '18', '7', '俄 巴 底 在 路 上 恰 与 以 利 亚 相 遇 ， 俄 巴 底 认 出 他 来 ， 就 俯 伏 在 地 ， 说 ： 你 是 我 主 以 利 亚 不 是 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9350', '11', '18', '8', '回 答 说 ： 是 。 你 去 告 诉 你 主 人 说 ， 以 利 亚 在 这 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9351', '11', '18', '9', '俄 巴 底 说 ： 仆 人 有 甚 麽 罪 ， 你 竟 要 将 我 交 在 亚 哈 手 里 ， 使 他 杀 我 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9352', '11', '18', '10', '我 指 着 永 生 耶 和 华 ─ 你 的 　 神 起 誓 ， 无 论 哪 一 邦 哪 一 国 ， 我 主 都 打 发 人 去 找 你 。 若 说 你 没 有 在 那 里 ， 就 必 使 那 邦 那 国 的 人 起 誓 说 ， 实 在 是 找 不 着 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9353', '11', '18', '11', '现 在 你 说 ， 要 去 告 诉 你 主 人 说 ， 以 利 亚 在 这 里 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9354', '11', '18', '12', '恐 怕 我 一 离 开 你 ， 耶 和 华 的 灵 就 提 你 到 我 所 不 知 道 的 地 方 去 。 这 样 ， 我 去 告 诉 亚 哈 ， 他 若 找 不 着 你 ， 就 必 杀 我 ； 仆 人 却 是 自 幼 敬 畏 耶 和 华 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9355', '11', '18', '13', '耶 洗 别 杀 耶 和 华 众 先 知 的 时 候 ， 我 将 耶 和 华 的 一 百 个 先 知 藏 了 ， 每 五 十 人 藏 在 一 个 洞 里 ， 拿 饼 和 水 供 养 他 们 ， 岂 没 有 人 将 这 事 告 诉 我 主 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9356', '11', '18', '14', '现 在 你 说 ， 要 去 告 诉 你 主 人 说 ， 以 利 亚 在 这 里 ， 他 必 杀 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9357', '11', '18', '15', '以 利 亚 说 ： 我 指 着 所 事 奉 永 生 的 万 军 之 耶 和 华 起 誓 ， 我 今 日 必 使 亚 哈 得 见 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9358', '11', '18', '16', '於 是 俄 巴 底 去 迎 着 亚 哈 ， 告 诉 他 ； 亚 哈 就 去 迎 着 以 利 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9359', '11', '18', '17', '亚 哈 见 了 以 利 亚 ， 便 说 ： 使 以 色 列 遭 灾 的 就 是 你 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9360', '11', '18', '18', '以 利 亚 说 ： 使 以 色 列 遭 灾 的 不 是 我 ， 乃 是 你 和 你 父 家 ； 因 为 你 们 离 弃 耶 和 华 的 诫 命 ， 去 随 从 巴 力 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9361', '11', '18', '19', '现 在 你 当 差 遣 人 ， 招 聚 以 色 列 众 人 和 事 奉 巴 力 的 那 四 百 五 十 个 先 知 ， 并 耶 洗 别 所 供 养 事 奉 亚 舍 拉 的 那 四 百 个 先 知 ， 使 他 们 都 上 迦 密 山 去 见 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9362', '11', '18', '20', '亚 哈 就 差 遣 人 招 聚 以 色 列 众 人 和 先 知 都 上 迦 密 山 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9363', '11', '18', '21', '以 利 亚 前 来 对 众 民 说 ： 你 们 心 持 两 意 要 到 几 时 呢 ？ 若 耶 和 华 是 　 神 ， 就 当 顺 从 耶 和 华 ； 若 巴 力 是 神 ， 就 当 顺 从 巴 力 。 众 民 一 言 不 答 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9364', '11', '18', '22', '以 利 亚 对 众 民 说 ： 作 耶 和 华 先 知 的 只 剩 下 我 一 个 人 ； 巴 力 的 先 知 却 有 四 百 五 十 个 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9365', '11', '18', '23', '当 给 我 们 两 只 牛 犊 ， 巴 力 的 先 知 可 以 挑 选 一 只 ， 切 成 块 子 ， 放 在 柴 上 ， 不 要 点 火 ； 我 也 预 备 一 只 牛 犊 放 在 柴 上 ， 也 不 点 火 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9366', '11', '18', '24', '你 们 求 告 你 们 　 神 的 名 ， 我 也 求 告 耶 和 华 的 名 。 那 降 火 显 应 的 　 神 ， 就 是 　 神 。 众 民 回 答 说 ： 这 话 甚 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9367', '11', '18', '25', '以 利 亚 对 巴 力 的 先 知 说 ： 你 们 既 是 人 多 ， 当 先 挑 选 一 只 牛 犊 ， 预 备 好 了 ， 就 求 告 你 们 　 神 的 名 ， 却 不 要 点 火 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9368', '11', '18', '26', '他 们 将 所 得 的 牛 犊 预 备 好 了 ， 从 早 晨 到 午 间 ， 求 告 巴 力 的 名 说 ： 巴 力 啊 ， 求 你 应 允 我 们 ！ 却 没 有 声 音 ， 没 有 应 允 的 。 他 们 在 所 筑 的 坛 四 围 踊 跳 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9369', '11', '18', '27', '到 了 正 午 ， 以 利 亚 嬉 笑 他 们 ， 说 ： 大 声 求 告 罢 ！ 因 为 他 是 　 神 ， 他 或 默 想 ， 或 走 到 一 边 ， 或 行 路 ， 或 睡 觉 ， 你 们 当 叫 醒 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9370', '11', '18', '28', '他 们 大 声 求 告 ， 按 着 他 们 的 规 矩 ， 用 刀 枪 自 割 、 自 刺 ， 直 到 身 体 流 血 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9371', '11', '18', '29', '从 午 後 直 到 献 晚 祭 的 时 候 ， 他 们 狂 呼 乱 叫 ， 却 没 有 声 音 ， 没 有 应 允 的 ， 也 没 有 理 会 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9372', '11', '18', '30', '以 利 亚 对 众 民 说 ： 你 们 到 我 这 里 来 。 众 民 就 到 他 那 里 。 他 便 重 修 已 经 毁 坏 耶 和 华 的 坛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9373', '11', '18', '31', '以 利 亚 照 雅 各 子 孙 支 派 的 数 目 ， 取 了 十 二 块 石 头 （ 耶 和 华 的 话 曾 临 到 雅 各 说 ： 你 的 名 要 叫 以 色 列 ） ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9374', '11', '18', '32', '用 这 些 石 头 为 耶 和 华 的 名 筑 一 座 坛 ， 在 坛 的 四 围 挖 沟 ， 可 容 谷 种 二 细 亚 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9375', '11', '18', '33', '又 在 坛 上 摆 好 了 柴 ， 把 牛 犊 切 成 块 子 放 在 柴 上 ， 对 众 人 说 ： 你 们 用 四 个 桶 盛 满 水 ， 倒 在 燔 祭 和 柴 上 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9376', '11', '18', '34', '又 说 ： 倒 第 二 次 。 他 们 就 倒 第 二 次 ； 又 说 ： 倒 第 三 次 。 他 们 就 倒 第 三 次 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9377', '11', '18', '35', '水 流 在 坛 的 四 围 ， 沟 里 也 满 了 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9378', '11', '18', '36', '到 了 献 晚 祭 的 时 候 ， 先 知 以 利 亚 近 前 来 ， 说 ： 亚 伯 拉 罕 、 以 撒 、 以 色 列 的 　 神 ， 耶 和 华 啊 ， 求 你 今 日 使 人 知 道 你 是 以 色 列 的 　 神 ， 也 知 道 我 是 你 的 仆 人 ， 又 是 奉 你 的 命 行 这 一 切 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9379', '11', '18', '37', '耶 和 华 啊 ， 求 你 应 允 我 ， 应 允 我 ！ 使 这 民 知 道 你 ─ 耶 和 华 是 　 神 ， 又 知 道 是 你 叫 这 民 的 心 回 转 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9380', '11', '18', '38', '於 是 ， 耶 和 华 降 下 火 来 ， 烧 尽 燔 祭 、 木 柴 、 石 头 、 尘 土 ， 又 烧 乾 沟 里 的 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9381', '11', '18', '39', '众 民 看 见 了 ， 就 俯 伏 在 地 ， 说 ： 耶 和 华 是 　 神 ！ 耶 和 华 是 　 神 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9382', '11', '18', '40', '以 利 亚 对 他 们 说 ： 拿 住 巴 力 的 先 知 ， 不 容 一 人 逃 脱 ！ 众 人 就 拿 住 他 们 。 以 利 亚 带 他 们 到 基 顺 河 边 ， 在 那 里 杀 了 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9383', '11', '18', '41', '以 利 亚 对 亚 哈 说 ： 你 现 在 可 以 上 去 吃 喝 ， 因 为 有 多 雨 的 响 声 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9384', '11', '18', '42', '亚 哈 就 上 去 吃 喝 。 以 利 亚 上 了 迦 密 山 顶 ， 屈 身 在 地 ， 将 脸 伏 在 两 膝 之 中 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9385', '11', '18', '43', '对 仆 人 说 ： 你 上 去 ， 向 海 观 看 。 仆 人 就 上 去 观 看 ， 说 ： 没 有 甚 麽 。 他 说 ： 你 再 去 观 看 。 如 此 七 次 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9386', '11', '18', '44', '第 七 次 仆 人 说 ： 我 看 见 有 一 小 片 云 从 海 里 上 来 ， 不 过 如 人 手 那 样 大 。 以 利 亚 说 ： 你 上 去 告 诉 亚 哈 ， 当 套 车 下 去 ， 免 得 被 雨 阻 挡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9387', '11', '18', '45', '霎 时 间 ， 天 因 风 云 黑 暗 ， 降 下 大 雨 。 亚 哈 就 坐 车 往 耶 斯 列 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9388', '11', '18', '46', '耶 和 华 的 灵 ( 原 文 是 手 ) 降 在 以 利 亚 身 上 ， 他 就 束 上 腰 ， 奔 在 亚 哈 前 头 ， 直 到 耶 斯 列 的 城 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9389', '11', '19', '1', '亚 哈 将 以 利 亚 一 切 所 行 的 和 他 用 刀 杀 众 先 知 的 事 都 告 诉 耶 洗 别 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9390', '11', '19', '2', '耶 洗 别 就 差 遣 人 去 见 以 利 亚 ， 告 诉 他 说 ： 明 日 约 在 这 时 候 ， 我 若 不 使 你 的 性 命 像 那 些 人 的 性 命 一 样 ， 愿 神 明 重 重 地 降 罚 与 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9391', '11', '19', '3', '以 利 亚 见 这 光 景 就 起 来 逃 命 ， 到 了 犹 大 的 别 是 巴 ， 将 仆 人 留 在 那 里 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9392', '11', '19', '4', '自 己 在 旷 野 走 了 一 日 的 路 程 ， 来 到 一 棵 罗 腾 ( 小 树 名 ， 松 类 ； 下 同 ) 树 下 ， 就 坐 在 那 里 求 死 ， 说 ： 耶 和 华 啊 ， 罢 了 ！ 求 你 取 我 的 性 命 ， 因 为 我 不 胜 於 我 的 列 祖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9393', '11', '19', '5', '他 就 躺 在 罗 腾 树 下 ， 睡 着 了 。 有 一 个 天 使 拍 他 ， 说 ： 起 来 吃 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9394', '11', '19', '6', '他 观 看 ， 见 头 旁 有 一 瓶 水 与 炭 火 烧 的 饼 ， 他 就 吃 了 喝 了 ， 仍 然 躺 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9395', '11', '19', '7', '耶 和 华 的 使 者 第 二 次 来 拍 他 ， 说 ： 起 来 吃 罢 ！ 因 为 你 当 走 的 路 甚 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9396', '11', '19', '8', '他 就 起 来 吃 了 喝 了 ， 仗 着 这 饮 食 的 力 ， 走 了 四 十 昼 夜 ， 到 了 　 神 的 山 ， 就 是 何 烈 山 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9397', '11', '19', '9', '他 在 那 里 进 了 一 个 洞 ， 就 住 在 洞 中 。 耶 和 华 的 话 临 到 他 说 ： 以 利 亚 啊 ， 你 在 这 里 做 甚 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9398', '11', '19', '10', '他 说 ： 我 为 耶 和 华 ─ 万 军 之 　 神 大 发 热 心 ； 因 为 以 色 列 人 背 弃 了 你 的 约 ， 毁 坏 了 你 的 坛 ， 用 刀 杀 了 你 的 先 知 ， 只 剩 下 我 一 个 人 ， 他 们 还 要 寻 索 我 的 命 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9399', '11', '19', '11', '耶 和 华 说 ： 你 出 来 站 在 山 上 ， 在 我 面 前 。 那 时 耶 和 华 从 那 里 经 过 ， 在 他 面 前 有 烈 风 大 作 ， 崩 山 碎 石 ， 耶 和 华 却 不 在 风 中 ； 风 後 地 震 ， 耶 和 华 却 不 在 其 中 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9400', '11', '19', '12', '地 震 後 有 火 ， 耶 和 华 也 不 在 火 中 ； 火 後 有 微 小 的 声 音 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9401', '11', '19', '13', '以 利 亚 听 见 ， 就 用 外 衣 蒙 上 脸 ， 出 来 站 在 洞 口 。 有 声 音 向 他 说 ： 以 利 亚 啊 ， 你 在 这 里 做 甚 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9402', '11', '19', '14', '他 说 ： 我 为 耶 和 华 ─ 万 军 之 　 神 大 发 热 心 ； 因 为 以 色 列 人 背 弃 了 你 的 约 ， 毁 坏 了 你 的 坛 ， 用 刀 杀 了 你 的 先 知 ， 只 剩 下 我 一 个 人 ， 他 们 还 要 寻 索 我 的 命 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9403', '11', '19', '15', '耶 和 华 对 他 说 ： 你 回 去 ， 从 旷 野 往 大 马 色 去 。 到 了 那 里 ， 就 要 膏 哈 薛 作 亚 兰 王 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9404', '11', '19', '16', '又 膏 宁 示 的 孙 子 耶 户 作 以 色 列 王 ， 并 膏 亚 伯 米 何 拉 人 沙 法 的 儿 子 以 利 沙 作 先 知 接 续 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9405', '11', '19', '17', '将 来 躲 避 哈 薛 之 刀 的 ， 必 被 耶 户 所 杀 ； 躲 避 耶 户 之 刀 的 ， 必 被 以 利 沙 所 杀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9406', '11', '19', '18', '但 我 在 以 色 列 人 中 为 自 己 留 下 七 千 人 ， 是 未 曾 向 巴 力 屈 膝 的 ， 未 曾 与 巴 力 亲 嘴 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9407', '11', '19', '19', '於 是 ， 以 利 亚 离 开 那 里 走 了 ， 遇 见 沙 法 的 儿 子 以 利 沙 耕 地 ； 在 他 前 头 有 十 二 对 牛 ， 自 己 赶 着 第 十 二 对 。 以 利 亚 到 他 那 里 去 ， 将 自 己 的 外 衣 搭 在 他 身 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9408', '11', '19', '20', '以 利 沙 就 离 开 牛 ， 跑 到 以 利 亚 那 里 ， 说 ： 求 你 容 我 先 与 父 母 亲 嘴 ， 然 後 我 便 跟 随 你 。 以 利 亚 对 他 说 ： 你 回 去 罢 ， 我 向 你 做 了 甚 麽 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9409', '11', '19', '21', '以 利 沙 就 离 开 他 回 去 ， 宰 了 一 对 牛 ， 用 套 牛 的 器 具 煮 肉 给 民 吃 ， 随 後 就 起 身 跟 随 以 利 亚 ， 服 事 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9410', '11', '20', '1', '亚 兰 王 便 哈 达 聚 集 他 的 全 军 ， 率 领 三 十 二 个 王 ， 带 着 车 马 上 来 围 攻 撒 玛 利 亚 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9411', '11', '20', '2', '又 差 遣 使 者 进 城 见 以 色 列 王 亚 哈 ， 对 他 说 ： 便 哈 达 如 此 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9412', '11', '20', '3', '你 的 金 银 都 要 归 我 ， 你 妻 子 儿 女 中 最 美 的 也 要 归 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9413', '11', '20', '4', '以 色 列 王 回 答 说 ： 我 主 我 王 啊 ， 可 以 依 着 你 的 话 ， 我 与 我 所 有 的 都 归 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9414', '11', '20', '5', '使 者 又 来 说 ： 便 哈 达 如 此 说 ： 我 已 差 遣 人 去 见 你 ， 要 你 将 你 的 金 银 、 妻 子 、 儿 女 都 给 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9415', '11', '20', '6', '但 明 日 约 在 这 时 候 ， 我 还 要 差 遣 臣 仆 到 你 那 里 ， 搜 查 你 的 家 和 你 仆 人 的 家 ， 将 你 眼 中 一 切 所 喜 爱 的 都 拿 了 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9416', '11', '20', '7', '以 色 列 王 召 了 国 中 的 长 老 来 ， 对 他 们 说 ： 请 你 们 看 看 ， 这 人 是 怎 样 地 谋 害 我 ， 他 先 差 遣 人 到 我 这 里 来 ， 要 我 的 妻 子 、 儿 女 ， 和 金 银 ， 我 并 没 有 推 辞 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9417', '11', '20', '8', '长 老 和 百 姓 对 王 说 ： 不 要 听 从 他 ， 也 不 要 应 允 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9418', '11', '20', '9', '故 此 ， 以 色 列 王 对 便 哈 达 的 使 者 说 ： 你 们 告 诉 我 主 我 王 说 ： 王 头 一 次 差 遣 人 向 仆 人 所 要 的 ， 仆 人 都 依 从 ； 但 这 次 所 要 的 ， 我 不 能 依 从 。 使 者 就 去 回 覆 便 哈 达 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9419', '11', '20', '10', '便 哈 达 又 差 遣 人 去 见 亚 哈 说 ： 撒 玛 利 亚 的 尘 土 若 够 跟 从 我 的 人 每 人 捧 一 捧 的 ， 愿 　 神 明 重 重 地 降 罚 与 我 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9420', '11', '20', '11', '以 色 列 王 说 ： 你 告 诉 他 说 ， 才 顶 盔 贯 甲 的 ， 休 要 像 摘 盔 卸 甲 的 夸 口 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9421', '11', '20', '12', '便 哈 达 和 诸 王 正 在 帐 幕 里 喝 酒 ， 听 见 这 话 ， 就 对 他 臣 仆 说 ： 摆 队 罢 ！ 他 们 就 摆 队 攻 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9422', '11', '20', '13', '有 一 个 先 知 来 见 以 色 列 王 亚 哈 ， 说 ： 耶 和 华 如 此 说 ： 这 一 大 群 人 你 看 见 了 麽 ？ 今 日 我 必 将 他 们 交 在 你 手 里 ， 你 就 知 道 我 是 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9423', '11', '20', '14', '亚 哈 说 ： 藉 着 谁 呢 ？ 他 回 答 说 ： 耶 和 华 说 ， 藉 着 跟 从 省 长 的 少 年 人 。 亚 哈 说 ： 要 谁 率 领 呢 ？ 他 说 ： 要 你 亲 自 率 领 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9424', '11', '20', '15', '於 是 亚 哈 数 点 跟 从 省 长 的 少 年 人 ， 共 有 二 百 三 十 二 名 ， 後 又 数 点 以 色 列 的 众 兵 ， 共 有 七 千 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9425', '11', '20', '16', '午 间 ， 他 们 就 出 城 ； 便 哈 达 和 帮 助 他 的 三 十 二 个 王 正 在 帐 幕 里 痛 饮 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9426', '11', '20', '17', '跟 从 省 长 的 少 年 人 先 出 城 ； 便 哈 达 差 遣 人 去 探 望 ， 他 们 回 报 说 ： 有 人 从 撒 玛 利 亚 出 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9427', '11', '20', '18', '他 说 ： 他 们 若 为 讲 和 出 来 ， 要 活 捉 他 们 ； 若 为 打 仗 出 来 ， 也 要 活 捉 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9428', '11', '20', '19', '跟 从 省 长 的 少 年 人 出 城 ， 军 兵 跟 随 他 们 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9429', '11', '20', '20', '各 人 遇 见 敌 人 就 杀 。 亚 兰 人 逃 跑 ， 以 色 列 人 追 赶 他 们 ； 亚 兰 王 便 哈 达 骑 着 马 和 马 兵 一 同 逃 跑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9430', '11', '20', '21', '以 色 列 王 出 城 攻 打 车 马 ， 大 大 击 杀 亚 兰 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9431', '11', '20', '22', '那 先 知 来 见 以 色 列 王 ， 对 他 说 ： 你 当 自 强 ， 留 心 怎 样 防 备 ； 因 为 到 明 年 这 时 候 ， 亚 兰 王 必 上 来 攻 击 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9432', '11', '20', '23', '亚 兰 王 的 臣 仆 对 亚 兰 王 说 ： 以 色 列 人 的 　 神 是 山 　 神 ， 所 以 他 们 胜 过 我 们 ； 但 在 平 原 与 他 们 打 仗 ， 我 们 必 定 得 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9433', '11', '20', '24', '王 当 这 样 行 ： 把 诸 王 革 去 ， 派 军 长 代 替 他 们 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9434', '11', '20', '25', '又 照 着 王 丧 失 军 兵 之 数 ， 再 招 募 一 军 ， 马 补 马 ， 车 补 车 ， 我 们 在 平 原 与 他 们 打 仗 ， 必 定 得 胜 。 王 便 听 臣 仆 的 话 去 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9435', '11', '20', '26', '次 年 ， 便 哈 达 果 然 点 齐 亚 兰 人 上 亚 弗 去 ， 要 与 以 色 列 人 打 仗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9436', '11', '20', '27', '以 色 列 人 也 点 齐 军 兵 ， 预 备 食 物 ， 迎 着 亚 兰 人 出 去 ， 对 着 他 们 安 营 ， 好 像 两 小 群 山 羊 羔 ； 亚 兰 人 却 满 了 地 面 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9437', '11', '20', '28', '有 　 神 人 来 见 以 色 列 王 ， 说 ： 耶 和 华 如 此 说 ： 亚 兰 人 既 说 我 ─ 耶 和 华 是 山 　 神 ， 不 是 平 原 的 　 神 ， 所 以 我 必 将 这 一 大 群 人 都 交 在 你 手 中 ， 你 们 就 知 道 我 是 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9438', '11', '20', '29', '以 色 列 人 与 亚 兰 人 相 对 安 营 七 日 ， 到 第 七 日 两 军 交 战 ； 那 一 日 以 色 列 人 杀 了 亚 兰 人 步 兵 十 万 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9439', '11', '20', '30', '其 馀 的 逃 入 亚 弗 城 ； 城 墙 塌 倒 ， 压 死 剩 下 的 二 万 七 千 人 。 便 哈 达 也 逃 入 城 ， 藏 在 严 密 的 屋 子 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9440', '11', '20', '31', '他 的 臣 仆 对 他 说 ： 我 们 听 说 以 色 列 王 都 是 仁 慈 的 王 ， 现 在 我 们 不 如 腰 束 麻 布 ， 头 套 绳 索 ， 出 去 投 降 以 色 列 王 ， 或 者 他 存 留 王 的 性 命 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9441', '11', '20', '32', '於 是 他 们 腰 束 麻 布 ， 头 套 绳 索 ， 去 见 以 色 列 王 ， 说 ： 王 的 仆 人 便 哈 达 说 ， 求 王 存 留 我 的 性 命 。 亚 哈 说 ： 他 还 活 着 麽 ？ 他 是 我 的 兄 弟 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9442', '11', '20', '33', '这 些 人 留 心 探 出 他 的 口 气 来 ， 便 急 忙 就 着 他 的 话 说 ： 便 哈 达 是 王 的 兄 弟 ！ 王 说 ： 你 们 去 请 他 来 。 便 哈 达 出 来 见 王 ， 王 就 请 他 上 车 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9443', '11', '20', '34', '便 哈 达 对 王 说 ： 我 父 从 你 父 那 里 所 夺 的 城 邑 ， 我 必 归 还 。 你 可 以 在 大 马 色 立 街 市 ， 像 我 父 在 撒 玛 利 亚 所 立 的 一 样 。 亚 哈 说 ： 我 照 此 立 约 ， 放 你 回 去 ， 就 与 他 立 约 ， 放 他 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9444', '11', '20', '35', '有 先 知 的 一 个 门 徒 奉 耶 和 华 的 命 对 他 的 同 伴 说 ： 你 打 我 罢 ！ 那 人 不 肯 打 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9445', '11', '20', '36', '他 就 对 那 人 说 ： 你 既 不 听 从 耶 和 华 的 话 ， 你 一 离 开 我 ， 必 有 狮 子 咬 死 你 。 那 人 一 离 开 他 ， 果 然 遇 见 狮 子 ， 把 他 咬 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9446', '11', '20', '37', '先 知 的 门 徒 又 遇 见 一 个 人 ， 对 他 说 ： 你 打 我 罢 ！ 那 人 就 打 他 ， 将 他 打 伤 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9447', '11', '20', '38', '他 就 去 了 ， 用 头 巾 蒙 眼 ， 改 换 面 目 ， 在 路 旁 等 候 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9448', '11', '20', '39', '王 从 那 里 经 过 ， 他 向 王 呼 叫 说 ： 仆 人 在 阵 上 的 时 候 ， 有 人 带 了 一 个 人 来 ， 对 我 说 ： 你 看 守 这 人 ， 若 把 他 失 了 ， 你 的 性 命 必 代 替 他 的 性 命 ； 不 然 ， 你 必 交 出 一 他 连 得 银 子 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9449', '11', '20', '40', '仆 人 正 在 忙 乱 之 间 ， 那 人 就 不 见 了 。 以 色 列 王 对 他 说 ： 你 自 己 定 妥 了 ， 必 照 样 判 断 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9450', '11', '20', '41', '他 急 忙 除 掉 蒙 眼 的 头 巾 ， 以 色 列 王 就 认 出 他 是 一 个 先 知 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9451', '11', '20', '42', '他 对 王 说 ： 耶 和 华 如 此 说 ： 因 你 将 我 定 要 灭 绝 的 人 放 去 ， 你 的 命 就 必 代 替 他 的 命 ， 你 的 民 也 必 代 替 他 的 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9452', '11', '20', '43', '於 是 以 色 列 王 闷 闷 不 乐 地 回 到 撒 玛 利 亚 ， 进 了 他 的 宫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9453', '11', '21', '1', '这 事 以 後 ， 又 有 一 事 。 耶 斯 列 人 拿 伯 在 耶 斯 列 有 一 个 葡 萄 园 ， 靠 近 撒 玛 利 亚 王 亚 哈 的 宫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9454', '11', '21', '2', '亚 哈 对 拿 伯 说 ： 你 将 你 的 葡 萄 园 给 我 作 菜 园 ， 因 为 是 靠 近 我 的 宫 ； 我 就 把 更 好 的 葡 萄 园 换 给 你 ， 或 是 你 要 银 子 ， 我 就 按 着 价 值 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9455', '11', '21', '3', '拿 伯 对 亚 哈 说 ： 我 敬 畏 耶 和 华 ， 万 不 敢 将 我 先 人 留 下 的 产 业 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9456', '11', '21', '4', '亚 哈 因 耶 斯 列 人 拿 伯 说 我 不 敢 将 我 先 人 留 下 的 产 业 给 你 ， 就 闷 闷 不 乐 地 回 宫 ， 躺 在 床 上 ， 转 脸 向 内 ， 也 不 吃 饭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9457', '11', '21', '5', '王 后 耶 洗 别 来 问 他 说 ： 你 为 甚 麽 心 里 这 样 忧 闷 ， 不 吃 饭 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9458', '11', '21', '6', '他 回 答 说 ： 因 我 向 耶 斯 列 人 拿 伯 说 ： 你 将 你 的 葡 萄 园 给 我 ， 我 给 你 价 银 ， 或 是 你 愿 意 ， 我 就 把 别 的 葡 萄 园 换 给 你 ； 他 却 说 ： 我 不 将 我 的 葡 萄 园 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9459', '11', '21', '7', '王 后 耶 洗 别 对 亚 哈 说 ： 你 现 在 是 治 理 以 色 列 国 不 是 ？ 只 管 起 来 ， 心 里 畅 畅 快 快 地 吃 饭 ， 我 必 将 耶 斯 列 人 拿 伯 的 葡 萄 园 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9460', '11', '21', '8', '於 是 托 亚 哈 的 名 写 信 ， 用 王 的 印 印 上 ， 送 给 那 些 与 拿 伯 同 城 居 住 的 长 老 贵 胄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9461', '11', '21', '9', '信 上 写 着 说 ： 你 们 当 宣 告 禁 食 ， 叫 拿 伯 坐 在 民 间 的 高 位 上 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9462', '11', '21', '10', '又 叫 两 个 匪 徒 坐 在 拿 伯 对 面 ， 作 见 证 告 他 说 ： 你 谤 渎 　 神 和 王 了 ； 随 後 就 把 他 拉 出 去 用 石 头 打 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9463', '11', '21', '11', '那 些 与 拿 伯 同 城 居 住 的 长 老 贵 胄 得 了 耶 洗 别 的 信 ， 就 照 信 而 行 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9464', '11', '21', '12', '宣 告 禁 食 ， 叫 拿 伯 坐 在 民 间 的 高 位 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9465', '11', '21', '13', '有 两 个 匪 徒 来 ， 坐 在 拿 伯 的 对 面 ， 当 着 众 民 作 见 证 告 他 说 ： 拿 伯 谤 渎 　 神 和 王 了 ！ 众 人 就 把 他 拉 到 城 外 ， 用 石 头 打 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9466', '11', '21', '14', '於 是 打 发 人 去 见 耶 洗 别 ， 说 ： 拿 伯 被 石 头 打 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9467', '11', '21', '15', '耶 洗 别 听 见 拿 伯 被 石 头 打 死 ， 就 对 亚 哈 说 ： 你 起 来 得 耶 斯 列 人 拿 伯 不 肯 为 价 银 给 你 的 葡 萄 园 罢 ！ 现 在 他 已 经 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9468', '11', '21', '16', '亚 哈 听 见 拿 伯 死 了 ， 就 起 来 ， 下 去 要 得 耶 斯 列 人 拿 伯 的 葡 萄 园 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9469', '11', '21', '17', '耶 和 华 的 话 临 到 提 斯 比 人 以 利 亚 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9470', '11', '21', '18', '你 起 来 ， 去 见 住 撒 玛 利 亚 的 以 色 列 王 亚 哈 ， 他 下 去 要 得 拿 伯 的 葡 萄 园 ， 现 今 正 在 那 园 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9471', '11', '21', '19', '你 要 对 他 说 ： 耶 和 华 如 此 说 ： 你 杀 了 人 ， 又 得 他 的 产 业 麽 ？ 又 要 对 他 说 ： 耶 和 华 如 此 说 ： 狗 在 何 处 舔 拿 伯 的 血 ， 也 必 在 何 处 舔 你 的 血 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9472', '11', '21', '20', '亚 哈 对 以 利 亚 说 ： 我 仇 敌 啊 ， 你 找 到 我 麽 ？ 他 回 答 说 ： 我 找 到 你 了 ； 因 为 你 卖 了 自 己 ， 行 耶 和 华 眼 中 看 为 恶 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9473', '11', '21', '21', '耶 和 华 说 ： 我 必 使 灾 祸 临 到 你 ， 将 你 除 尽 。 凡 属 你 的 男 丁 ， 无 论 困 住 的 、 自 由 的 ， 都 从 以 色 列 中 剪 除 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9474', '11', '21', '22', '我 必 使 你 的 家 像 尼 八 的 儿 子 耶 罗 波 安 的 家 ， 又 像 亚 希 雅 的 儿 子 巴 沙 的 家 ； 因 为 你 惹 我 发 怒 ， 又 使 以 色 列 人 陷 在 罪 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9475', '11', '21', '23', '论 到 耶 洗 别 ， 耶 和 华 也 说 ： 狗 在 耶 斯 列 的 外 郭 必 吃 耶 洗 别 的 肉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9476', '11', '21', '24', '凡 属 亚 哈 的 人 ， 死 在 城 中 的 必 被 狗 吃 ， 死 在 田 野 的 必 被 空 中 的 鸟 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9477', '11', '21', '25', '（ 从 来 没 有 像 亚 哈 的 ， 因 他 自 卖 ， 行 耶 和 华 眼 中 看 为 恶 的 事 ， 受 了 王 后 耶 洗 别 的 耸 动 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9478', '11', '21', '26', '就 照 耶 和 华 在 以 色 列 人 面 前 所 赶 出 的 亚 摩 利 人 ， 行 了 最 可 憎 恶 的 事 ， 信 从 偶 像 。 ）');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9479', '11', '21', '27', '亚 哈 听 见 这 话 ， 就 撕 裂 衣 服 ， 禁 食 ， 身 穿 麻 布 ， 睡 卧 也 穿 着 麻 布 ， 并 且 缓 缓 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9480', '11', '21', '28', '耶 和 华 的 话 临 到 提 斯 比 人 以 利 亚 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9481', '11', '21', '29', '亚 哈 在 我 面 前 这 样 自 卑 ， 你 看 见 了 麽 ？ 因 他 在 我 面 前 自 卑 ， 他 还 在 世 的 时 候 ， 我 不 降 这 祸 ； 到 他 儿 子 的 时 候 ， 我 必 降 这 祸 与 他 的 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9482', '11', '22', '1', '亚 兰 国 和 以 色 列 国 三 年 没 有 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9483', '11', '22', '2', '到 第 三 年 ， 犹 大 王 约 沙 法 下 去 见 以 色 列 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9484', '11', '22', '3', '以 色 列 王 对 臣 仆 说 ： 你 们 不 知 道 基 列 的 拉 末 是 属 我 们 的 麽 ？ 我 们 岂 可 静 坐 不 动 ， 不 从 亚 兰 王 手 里 夺 回 来 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9485', '11', '22', '4', '亚 哈 问 约 沙 法 说 ： 你 肯 同 我 去 攻 取 基 列 的 拉 末 吗 ？ 约 沙 法 对 以 色 列 王 说 ： 你 我 不 分 彼 此 ， 我 的 民 与 你 的 民 一 样 ， 我 的 马 与 你 的 马 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9486', '11', '22', '5', '约 沙 法 对 以 色 列 王 说 ： 请 你 先 求 问 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9487', '11', '22', '6', '於 是 以 色 列 王 招 聚 先 知 ， 约 有 四 百 人 ， 问 他 们 说 ： 我 上 去 攻 取 基 列 的 拉 末 可 以 不 可 以 ？ 他 们 说 ： 可 以 上 去 ， 因 为 主 必 将 那 城 交 在 王 的 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9488', '11', '22', '7', '约 沙 法 说 ： 这 里 不 是 还 有 耶 和 华 的 先 知 ， 我 们 可 以 求 问 他 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9489', '11', '22', '8', '以 色 列 王 对 约 沙 法 说 ： 还 有 一 个 人 ， 是 音 拉 的 儿 子 米 该 雅 ， 我 们 可 以 托 他 求 问 耶 和 华 。 只 是 我 恨 他 ； 因 为 他 指 着 我 所 说 的 预 言 ， 不 说 吉 语 ， 单 说 凶 言 。 约 沙 法 说 ： 王 不 必 这 样 说 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9490', '11', '22', '9', '以 色 列 王 就 召 了 一 个 太 监 来 ， 说 ： 你 快 去 ， 将 音 拉 的 儿 子 米 该 雅 召 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9491', '11', '22', '10', '以 色 列 王 和 犹 大 王 约 沙 法 在 撒 玛 利 亚 城 门 前 的 空 场 上 ， 各 穿 朝 服 ， 坐 在 位 上 ， 所 有 的 先 知 都 在 他 们 面 前 说 预 言 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9492', '11', '22', '11', '基 拿 拿 的 儿 子 西 底 家 造 了 两 个 铁 角 ， 说 ： 耶 和 华 如 此 说 ： 你 要 用 这 角 ? 触 亚 兰 人 ， 直 到 将 他 们 灭 尽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9493', '11', '22', '12', '所 有 的 先 知 也 都 这 样 预 言 说 ： 可 以 上 基 列 的 拉 末 去 ， 必 然 得 胜 ， 因 为 耶 和 华 必 将 那 城 交 在 王 的 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9494', '11', '22', '13', '那 去 召 米 该 雅 的 使 者 对 米 该 雅 说 ； 众 先 知 一 口 同 音 地 都 向 王 说 吉 言 ， 你 不 如 与 他 们 说 一 样 的 话 ， 也 说 吉 言 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9495', '11', '22', '14', '米 该 雅 说 ： 我 指 着 永 生 的 耶 和 华 起 誓 ， 耶 和 华 对 我 说 甚 麽 ， 我 就 说 甚 麽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9496', '11', '22', '15', '米 该 雅 到 王 面 前 ， 王 问 他 说 ： 米 该 雅 啊 ， 我 们 上 去 攻 取 基 列 的 拉 末 可 以 不 可 以 ？ 他 回 答 说 ： 可 以 上 去 ， 必 然 得 胜 ， 耶 和 华 必 将 那 城 交 在 王 的 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9497', '11', '22', '16', '王 对 他 说 ： 我 当 嘱 咐 你 几 次 ， 你 才 奉 耶 和 华 的 名 向 我 说 实 话 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9498', '11', '22', '17', '米 该 雅 说 ： 我 看 见 以 色 列 众 民 散 在 山 上 ， 如 同 没 有 牧 人 的 羊 群 一 般 。 耶 和 华 说 ： 这 民 没 有 主 人 ， 他 们 可 以 平 平 安 安 地 各 归 各 家 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9499', '11', '22', '18', '以 色 列 王 对 约 沙 法 说 ： 我 岂 没 有 告 诉 你 ， 这 人 指 着 我 所 说 的 预 言 ， 不 说 吉 语 单 说 凶 言 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9500', '11', '22', '19', '米 该 雅 说 ： 你 要 听 耶 和 华 的 话 ！ 我 看 见 耶 和 华 坐 在 宝 座 上 ， 天 上 的 万 军 侍 立 在 他 左 右 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9501', '11', '22', '20', '耶 和 华 说 ： 谁 去 引 诱 亚 哈 上 基 列 的 拉 末 去 阵 亡 呢 ？ 这 个 就 这 样 说 ， 那 个 就 那 样 说 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9502', '11', '22', '21', '随 後 有 一 个 神 灵 出 来 ， 站 在 耶 和 华 面 前 ， 说 ： 我 去 引 诱 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9503', '11', '22', '22', '耶 和 华 问 他 说 ： 你 用 何 法 呢 ？ 他 说 ： 我 去 ， 要 在 他 众 先 知 口 中 作 谎 言 的 灵 。 耶 和 华 说 ： 这 样 ， 你 必 能 引 诱 他 ， 你 去 如 此 行 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9504', '11', '22', '23', '现 在 耶 和 华 使 谎 言 的 灵 入 了 你 这 些 先 知 的 口 ， 并 且 耶 和 华 已 经 命 定 降 祸 与 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9505', '11', '22', '24', '基 拿 拿 的 儿 子 西 底 家 前 来 ， 打 米 该 雅 的 脸 ， 说 ： 耶 和 华 的 灵 从 哪 里 离 开 我 与 你 说 话 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9506', '11', '22', '25', '米 该 雅 说 ： 你 进 严 密 的 屋 子 藏 躲 的 那 日 ， 就 必 看 见 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9507', '11', '22', '26', '以 色 列 王 说 ： 将 米 该 雅 带 回 ， 交 给 邑 宰 亚 们 和 王 的 儿 子 约 阿 施 ， 说');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9508', '11', '22', '27', '王 如 此 说 ， 把 这 个 人 下 在 监 里 ， 使 他 受 苦 ， 吃 不 饱 喝 不 足 ， 等 候 我 平 平 安 安 地 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9509', '11', '22', '28', '米 该 雅 说 ： 你 若 能 平 平 安 安 地 回 来 ， 那 就 是 耶 和 华 没 有 藉 我 说 这 话 了 ； 又 说 ： 众 民 哪 ， 你 们 都 要 听 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9510', '11', '22', '29', '以 色 列 王 和 犹 大 王 约 沙 法 上 基 列 的 拉 末 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9511', '11', '22', '30', '以 色 列 王 对 约 沙 法 说 ： 我 要 改 装 上 阵 ， 你 可 以 仍 穿 王 服 。 以 色 列 王 就 改 装 上 阵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9512', '11', '22', '31', '先 是 亚 兰 王 吩 咐 他 的 三 十 二 个 车 兵 长 说 ： 他 们 的 兵 将 ， 无 论 大 小 ， 你 们 都 不 可 与 他 们 争 战 ， 只 要 与 以 色 列 王 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9513', '11', '22', '32', '车 兵 长 看 见 约 沙 法 ， 便 说 ： 这 必 是 以 色 列 王 ！ 就 转 过 去 与 他 争 战 ， 约 沙 法 便 呼 喊 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9514', '11', '22', '33', '车 兵 长 见 不 是 以 色 列 王 ， 就 转 去 不 追 他 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9515', '11', '22', '34', '有 一 人 随 便 开 弓 ， 恰 巧 射 入 以 色 列 王 的 甲 缝 里 。 王 对 赶 车 的 说 ： 我 受 了 重 伤 ， 你 转 过 车 来 ， 拉 我 出 阵 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9516', '11', '22', '35', '那 日 ， 阵 势 越 战 越 猛 ， 有 人 扶 王 站 在 车 上 ， 抵 挡 亚 兰 人 。 到 晚 上 ， 王 就 死 了 ， 血 从 伤 处 流 在 车 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9517', '11', '22', '36', '约 在 日 落 的 时 候 ， 有 号 令 传 遍 军 中 ， 说 ： 各 归 本 城 ， 各 归 本 地 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9518', '11', '22', '37', '王 既 死 了 ， 众 人 将 他 送 到 撒 玛 利 亚 ， 就 葬 在 那 里 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9519', '11', '22', '38', '又 有 人 把 他 的 车 洗 在 撒 玛 利 亚 的 池 旁 （ 妓 女 在 那 里 洗 澡 ） ， 狗 来 舔 他 的 血 ， 正 如 耶 和 华 所 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9520', '11', '22', '39', '亚 哈 其 馀 的 事 ， 凡 他 所 行 的 和 他 所 修 造 的 象 牙 宫 ， 并 所 建 筑 的 一 切 城 邑 ， 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9521', '11', '22', '40', '亚 哈 与 他 列 祖 同 睡 。 他 儿 子 亚 哈 谢 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9522', '11', '22', '41', '以 色 列 王 亚 哈 第 四 年 ， 亚 撒 的 儿 子 约 沙 法 登 基 作 了 犹 大 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9523', '11', '22', '42', '约 沙 法 登 基 的 时 候 年 三 十 五 岁 ， 在 耶 路 撒 冷 作 王 二 十 五 年 。 他 母 亲 名 叫 阿 苏 巴 ， 乃 示 利 希 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9524', '11', '22', '43', '约 沙 法 行 他 父 亲 亚 撒 所 行 的 道 ， 不 偏 离 左 右 ， 行 耶 和 华 眼 中 看 为 正 的 事 ； 只 是 邱 坛 还 没 有 废 去 ， 百 姓 仍 在 那 里 献 祭 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9525', '11', '22', '44', '约 沙 法 与 以 色 列 王 和 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9526', '11', '22', '45', '约 沙 法 其 馀 的 事 和 他 所 显 出 的 勇 力 ， 并 他 怎 样 争 战 ， 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9527', '11', '22', '46', '约 沙 法 将 他 父 亲 亚 撒 在 世 所 剩 下 的 娈 童 都 从 国 中 除 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9528', '11', '22', '47', '那 时 以 东 没 有 王 ， 有 总 督 治 理 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9529', '11', '22', '48', '约 沙 法 制 造 他 施 船 只 ， 要 往 俄 斐 去 ， 将 金 子 运 来 ； 只 是 没 有 去 ， 因 为 船 在 以 旬 迦 别 破 坏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9530', '11', '22', '49', '亚 哈 的 儿 子 亚 哈 谢 对 约 沙 法 说 ： 容 我 的 仆 人 和 你 的 仆 人 坐 船 同 去 罢 ！ 约 沙 法 却 不 肯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9531', '11', '22', '50', '约 沙 法 与 列 祖 同 睡 。 葬 在 大 卫 城 他 列 祖 的 坟 地 里 。 他 儿 子 约 兰 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9532', '11', '22', '51', '犹 大 王 约 沙 法 十 七 年 ， 亚 哈 的 儿 子 亚 哈 谢 在 撒 玛 利 亚 登 基 ， 作 以 色 列 王 共 二 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9533', '11', '22', '52', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 效 法 他 的 父 母 ， 又 行 尼 八 的 儿 子 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9534', '11', '22', '53', '他 照 他 父 亲 一 切 所 行 的 ， 事 奉 敬 拜 巴 力 ， 惹 耶 和 华 ─ 以 色 列 　 神 的 怒 气 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9535', '12', '1', '1', '亚 哈 死 後 ， 摩 押 背 叛 以 色 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9536', '12', '1', '2', '亚 哈 谢 在 撒 玛 利 亚 ， 一 日 从 楼 上 的 栏 杆 里 掉 下 来 ， 就 病 了 ； 於 是 差 遣 使 者 说 ： 你 们 去 问 以 革 伦 的 　 神 巴 力 西 卜 ， 我 这 病 能 好 不 能 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9537', '12', '1', '3', '但 耶 和 华 的 使 者 对 提 斯 比 人 以 利 亚 说 ： 你 起 来 ， 去 迎 着 撒 玛 利 亚 王 的 使 者 ， 对 他 们 说 ： 你 们 去 问 以 革 伦 　 神 巴 力 西 卜 ， 岂 因 以 色 列 中 没 有 　 神 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9538', '12', '1', '4', '所 以 耶 和 华 如 此 说 ： 你 必 不 下 你 所 上 的 床 ， 必 定 要 死 ！ 以 利 亚 就 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9539', '12', '1', '5', '使 者 回 来 见 王 ， 王 问 他 们 说 ： 你 们 为 甚 麽 回 来 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9540', '12', '1', '6', '使 者 回 答 说 ： 有 一 个 人 迎 着 我 们 来 ， 对 我 们 说 ： 你 们 回 去 见 差 你 们 来 的 王 ， 对 他 说 ： 耶 和 华 如 此 说 ， 你 差 人 去 问 以 革 伦 　 神 巴 力 西 卜 ， 岂 因 以 色 列 中 没 有 　 神 麽 ？ 所 以 你 必 不 下 所 上 的 床 ， 必 定 要 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9541', '12', '1', '7', '王 问 他 们 说 ： 迎 着 你 们 来 告 诉 你 们 这 话 的 ， 是 怎 样 的 人 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9542', '12', '1', '8', '回 答 说 ： 他 身 穿 毛 衣 ， 腰 束 皮 带 。 王 说 ： 这 必 是 提 斯 比 人 以 利 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9543', '12', '1', '9', '於 是 ， 王 差 遣 五 十 夫 长 ， 带 领 五 十 人 去 见 以 利 亚 ， 他 就 上 到 以 利 亚 那 里 ； 以 利 亚 正 坐 在 山 顶 上 。 五 十 夫 长 对 他 说 ： 　 神 人 哪 ， 王 吩 咐 你 下 来 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9544', '12', '1', '10', '以 利 亚 回 答 说 ： 我 若 是 　 神 人 ， 愿 火 从 天 上 降 下 来 ， 烧 灭 你 和 你 那 五 十 人 ！ 於 是 有 火 从 天 上 降 下 来 ， 烧 灭 五 十 夫 长 和 他 那 五 十 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9545', '12', '1', '11', '王 第 二 次 差 遣 一 个 五 十 夫 长 ， 带 领 五 十 人 去 见 以 利 亚 。 五 十 夫 长 对 以 利 亚 说 ： 　 神 人 哪 ， 王 吩 咐 你 快 快 下 来 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9546', '12', '1', '12', '以 利 亚 回 答 说 ： 我 若 是 　 神 人 ， 愿 火 从 天 上 降 下 来 ， 烧 灭 你 和 你 那 五 十 人 ！ 於 是 　 神 的 火 从 天 上 降 下 来 ， 烧 灭 五 十 夫 长 和 他 那 五 十 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9547', '12', '1', '13', '王 第 三 次 差 遣 一 个 五 十 夫 长 ， 带 领 五 十 人 去 。 这 五 十 夫 长 上 去 ， 双 膝 跪 在 以 利 亚 面 前 ， 哀 求 他 说 ： 　 神 人 哪 ， 愿 我 的 性 命 和 你 这 五 十 个 仆 人 的 性 命 在 你 眼 前 看 为 宝 贵 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9548', '12', '1', '14', '已 经 有 火 从 天 上 降 下 来 ， 烧 灭 前 两 次 来 的 五 十 夫 长 和 他 们 各 自 带 的 五 十 人 ； 现 在 愿 我 的 性 命 在 你 眼 前 看 为 宝 贵 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9549', '12', '1', '15', '耶 和 华 的 使 者 对 以 利 亚 说 ： 你 同 着 他 下 去 ， 不 要 怕 他 ！ 以 利 亚 就 起 来 ， 同 着 他 下 去 见 王 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9550', '12', '1', '16', '对 王 说 ： 耶 和 华 如 此 说 ： 你 差 人 去 问 以 革 伦 　 神 巴 力 西 卜 ， 岂 因 以 色 列 中 没 有 　 神 可 以 求 问 麽 ？ 所 以 你 必 不 下 所 上 的 床 ， 必 定 要 死 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9551', '12', '1', '17', '亚 哈 谢 果 然 死 了 ， 正 如 耶 和 华 藉 以 利 亚 所 说 的 话 。 因 他 没 有 儿 子 ， 他 兄 弟 约 兰 接 续 他 作 王 ， 正 在 犹 大 王 约 沙 法 的 儿 子 约 兰 第 二 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9552', '12', '1', '18', '亚 哈 谢 其 馀 所 行 的 事 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9553', '12', '2', '1', '耶 和 华 要 用 旋 风 接 以 利 亚 升 天 的 时 候 ， 以 利 亚 与 以 利 沙 从 吉 甲 前 往 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9554', '12', '2', '2', '以 利 亚 对 以 利 沙 说 ： 耶 和 华 差 我 往 伯 特 利 去 ， 你 可 以 在 这 里 等 候 。 以 利 沙 说 ： 我 指 着 永 生 的 耶 和 华 ， 又 敢 在 你 面 前 起 誓 ， 我 必 不 离 开 你 。 於 是 二 人 下 到 伯 特 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9555', '12', '2', '3', '住 伯 特 利 的 先 知 门 徒 出 来 见 以 利 沙 ， 对 他 说 ： 耶 和 华 今 日 要 接 你 的 师 傅 离 开 你 ， 你 知 道 不 知 道 ？ 他 说 ： 我 知 道 ， 你 们 不 要 作 声 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9556', '12', '2', '4', '以 利 亚 对 以 利 沙 说 ： 耶 和 华 差 遣 我 往 耶 利 哥 去 ， 你 可 以 在 这 里 等 候 。 以 利 沙 说 ： 我 指 着 永 生 的 耶 和 华 ， 又 敢 在 你 面 前 起 誓 ， 我 必 不 离 开 你 。 於 是 二 人 到 了 耶 利 哥 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9557', '12', '2', '5', '住 耶 利 哥 的 先 知 门 徒 就 近 以 利 沙 ， 对 他 说 ： 耶 和 华 今 日 要 接 你 的 师 傅 离 开 你 ， 你 知 道 不 知 道 ？ 他 说 ： 我 知 道 ， 你 们 不 要 作 声 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9558', '12', '2', '6', '以 利 亚 对 以 利 沙 说 ： 耶 和 华 差 遣 我 往 约 但 河 去 ， 你 可 以 在 这 里 等 候 。 以 利 沙 说 ： 我 指 着 永 生 的 耶 和 华 ， 又 敢 在 你 面 前 起 誓 ， 我 必 不 离 开 你 。 於 是 二 人 一 同 前 往 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9559', '12', '2', '7', '有 先 知 门 徒 去 了 五 十 人 ， 远 远 地 站 在 他 们 对 面 ； 二 人 在 约 但 河 边 站 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9560', '12', '2', '8', '以 利 亚 将 自 己 的 外 衣 卷 起 来 ， 用 以 打 水 ， 水 就 左 右 分 开 ， 二 人 走 乾 地 而 过 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9561', '12', '2', '9', '过 去 之 後 ， 以 利 亚 对 以 利 沙 说 ： 我 未 曾 被 接 去 离 开 你 ， 你 要 我 为 你 做 甚 麽 ， 只 管 求 我 。 以 利 沙 说 ： 愿 感 动 你 的 灵 加 倍 地 感 动 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9562', '12', '2', '10', '以 利 亚 说 ： 你 所 求 的 难 得 。 虽 然 如 此 ， 我 被 接 去 离 开 你 的 时 候 ， 你 若 看 见 我 ， 就 必 得 着 ； 不 然 ， 必 得 不 着 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9563', '12', '2', '11', '他 们 正 走 着 说 话 ， 忽 有 火 车 火 马 将 二 人 隔 开 ， 以 利 亚 就 乘 旋 风 升 天 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9564', '12', '2', '12', '以 利 沙 看 见 ， 就 呼 叫 说 ： 我 父 啊 ！ 我 父 啊 ！ 以 色 列 的 战 车 马 兵 啊 ！ 以 後 不 再 见 他 了 。 於 是 以 利 沙 把 自 己 的 衣 服 撕 为 两 片 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9565', '12', '2', '13', '他 拾 起 以 利 亚 身 上 掉 下 来 的 外 衣 ， 回 去 站 在 约 但 河 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9566', '12', '2', '14', '他 用 以 利 亚 身 上 掉 下 来 的 外 衣 打 水 ， 说 ： 耶 和 华 ─ 以 利 亚 的 　 神 在 哪 里 呢 ？ 打 水 之 後 ， 水 也 左 右 分 开 ， 以 利 沙 就 过 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9567', '12', '2', '15', '住 耶 利 哥 的 先 知 门 徒 从 对 面 看 见 他 ， 就 说 ： 感 动 以 利 亚 的 灵 感 动 以 利 沙 了 。 他 们 就 来 迎 接 他 ， 在 他 面 前 俯 伏 於 地 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9568', '12', '2', '16', '对 他 说 ： 仆 人 们 这 里 有 五 十 个 壮 士 ， 求 你 容 他 们 去 寻 找 你 师 傅 ， 或 者 耶 和 华 的 灵 将 他 提 起 来 ， 投 在 某 山 某 谷 。 以 利 沙 说 ： 你 们 不 必 打 发 人 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9569', '12', '2', '17', '他 们 再 三 催 促 他 ， 他 难 以 推 辞 ， 就 说 ： 你 们 打 发 人 去 罢 ！ 他 们 便 打 发 五 十 人 去 ， 寻 找 了 三 天 ， 也 没 有 找 着 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9570', '12', '2', '18', '以 利 沙 仍 然 在 耶 利 哥 等 候 他 们 回 到 他 那 里 ； 他 对 他 们 说 ： 我 岂 没 有 告 诉 你 们 不 必 去 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9571', '12', '2', '19', '耶 利 哥 城 的 人 对 以 利 沙 说 ： 这 城 的 地 势 美 好 ， 我 主 看 见 了 ； 只 是 水 恶 劣 ， 土 产 不 熟 而 落 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9572', '12', '2', '20', '以 利 沙 说 ： 你 们 拿 一 个 新 瓶 来 ， 装 盐 给 我 ； 他 们 就 拿 来 给 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9573', '12', '2', '21', '他 出 到 水 源 ， 将 盐 倒 在 水 中 ， 说 ： 耶 和 华 如 此 说 ： 我 治 好 了 这 水 ， 从 此 必 不 再 使 人 死 ， 也 不 再 使 地 土 不 生 产 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9574', '12', '2', '22', '於 是 那 水 治 好 了 ， 直 到 今 日 ， 正 如 以 利 沙 所 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9575', '12', '2', '23', '以 利 沙 从 那 里 上 伯 特 利 去 ， 正 上 去 的 时 候 ， 有 些 童 子 从 城 里 出 来 ， 戏 笑 他 说 ： 秃 头 的 上 去 罢 ！ 秃 头 的 上 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9576', '12', '2', '24', '他 回 头 看 见 ， 就 奉 耶 和 华 的 名 咒 诅 他 们 。 於 是 有 两 个 母 熊 从 林 中 出 来 ， 撕 裂 他 们 中 间 四 十 二 个 童 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9577', '12', '2', '25', '以 利 沙 从 伯 特 利 上 迦 密 山 ， 又 从 迦 密 山 回 到 撒 玛 利 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9578', '12', '3', '1', '犹 大 王 约 沙 法 十 八 年 ， 亚 哈 的 儿 子 约 兰 在 撒 玛 利 亚 登 基 作 了 以 色 列 王 十 二 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9579', '12', '3', '2', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 但 不 至 像 他 父 母 所 行 的 ， 因 为 除 掉 他 父 所 造 巴 力 的 柱 像 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9580', '12', '3', '3', '然 而 ， 他 贴 近 尼 八 的 儿 子 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 那 罪 ， 总 不 离 开 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9581', '12', '3', '4', '摩 押 王 米 沙 牧 养 许 多 羊 ， 每 年 将 十 万 羊 羔 的 毛 和 十 万 公 绵 羊 的 毛 给 以 色 列 王 进 贡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9582', '12', '3', '5', '亚 哈 死 後 ， 摩 押 王 背 叛 以 色 列 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9583', '12', '3', '6', '那 时 约 兰 王 出 撒 玛 利 亚 ， 数 点 以 色 列 众 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9584', '12', '3', '7', '前 行 的 时 候 ， 差 人 去 见 犹 大 王 约 沙 法 ， 说 ： 摩 押 王 背 叛 我 ， 你 肯 同 我 去 攻 打 摩 押 麽 ？ 他 说 ： 我 肯 上 去 ， 你 我 不 分 彼 此 ， 我 的 民 与 你 的 民 一 样 ， 我 的 马 与 你 的 马 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9585', '12', '3', '8', '约 兰 说 ： 我 们 从 哪 条 路 上 去 呢 ？ 回 答 说 ： 从 以 东 旷 野 的 路 上 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9586', '12', '3', '9', '於 是 ， 以 色 列 王 和 犹 大 王 ， 并 以 东 王 ， 都 一 同 去 绕 行 七 日 的 路 程 ； 军 队 和 所 带 的 牲 畜 没 有 水 喝 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9587', '12', '3', '10', '以 色 列 王 说 ： 哀 哉 ！ 耶 和 华 招 聚 我 们 这 三 王 ， 乃 要 交 在 摩 押 人 的 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9588', '12', '3', '11', '约 沙 法 说 ： 这 里 不 是 有 耶 和 华 的 先 知 麽 ？ 我 们 可 以 托 他 求 问 耶 和 华 。 以 色 列 王 的 一 个 臣 子 回 答 说 ： 这 里 有 沙 法 的 儿 子 以 利 沙 ， 就 是 从 前 服 事 以 利 亚 的 ( 原 文 作 倒 水 在 以 利 亚 手 上 的 ) 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9589', '12', '3', '12', '约 沙 法 说 ： 他 必 有 耶 和 华 的 话 。 於 是 以 色 列 王 和 约 沙 法 ， 并 以 东 王 都 下 去 见 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9590', '12', '3', '13', '以 利 沙 对 以 色 列 王 说 ： 我 与 你 何 干 ？ 去 问 你 父 亲 的 先 知 和 你 母 亲 的 先 知 罢 ！ 以 色 列 王 对 他 说 ： 不 要 这 样 说 ， 耶 和 华 招 聚 我 们 这 三 王 ， 乃 要 交 在 摩 押 人 的 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9591', '12', '3', '14', '以 利 沙 说 ： 我 指 着 所 事 奉 永 生 的 万 军 耶 和 华 起 誓 ， 我 若 不 看 犹 大 王 约 沙 法 的 情 面 ， 必 不 理 你 ， 不 顾 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9592', '12', '3', '15', '现 在 你 们 给 我 找 一 个 弹 琴 的 来 。 弹 琴 的 时 候 ， 耶 和 华 的 灵 ( 原 文 作 手 ) 就 降 在 以 利 沙 身 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9593', '12', '3', '16', '他 便 说 ： 耶 和 华 如 此 说 ： 你 们 要 在 这 谷 中 满 处 挖 沟 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9594', '12', '3', '17', '因 为 耶 和 华 如 此 说 ： 你 们 虽 不 见 风 ， 不 见 雨 ， 这 谷 必 满 了 水 ， 使 你 们 和 牲 畜 有 水 喝 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9595', '12', '3', '18', '在 耶 和 华 眼 中 这 还 算 为 小 事 ， 他 也 必 将 摩 押 人 交 在 你 们 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9596', '12', '3', '19', '你 们 必 攻 破 一 切 坚 城 美 邑 ， 砍 伐 各 种 佳 树 ， 塞 住 一 切 水 泉 ， 用 石 头 糟 踏 一 切 美 田 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9597', '12', '3', '20', '次 日 早 晨 ， 约 在 献 祭 的 时 候 ， 有 水 从 以 东 而 来 ， 遍 地 就 满 了 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9598', '12', '3', '21', '摩 押 众 人 听 见 这 三 王 上 来 要 与 他 们 争 战 ， 凡 能 顶 盔 贯 甲 的 ， 无 论 老 少 ， 尽 都 聚 集 站 在 边 界 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9599', '12', '3', '22', '次 日 早 晨 ， 日 光 照 在 水 上 ， 摩 押 人 起 来 ， 看 见 对 面 水 红 如 血 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9600', '12', '3', '23', '就 说 ： 这 是 血 啊 ！ 必 是 三 王 互 相 击 杀 ， 俱 都 灭 亡 。 摩 押 人 哪 ， 我 们 现 在 去 抢 夺 财 物 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9601', '12', '3', '24', '摩 押 人 到 了 以 色 列 营 ， 以 色 列 人 就 起 来 攻 打 他 们 ， 以 致 他 们 在 以 色 列 人 面 前 逃 跑 。 以 色 列 人 往 前 追 杀 摩 押 人 ， 直 杀 入 摩 押 的 境 内 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9602', '12', '3', '25', '拆 毁 摩 押 的 城 邑 ， 各 人 抛 石 填 满 一 切 美 田 ， 塞 住 一 切 水 泉 ， 砍 伐 各 种 佳 树 ， 只 剩 下 吉 珥 哈 列 设 的 石 墙 ； 甩 石 的 兵 在 四 围 攻 打 那 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9603', '12', '3', '26', '摩 押 王 见 阵 势 甚 大 ， 难 以 对 敌 ， 就 率 领 七 百 拿 刀 的 兵 ， 要 冲 过 阵 去 到 以 东 王 那 里 ， 却 是 不 能 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9604', '12', '3', '27', '便 将 那 应 当 接 续 他 作 王 的 长 子 ， 在 城 上 献 为 燔 祭 。 以 色 列 人 遭 遇 耶 和 华 的 大 怒 ( 或 作 招 人 痛 恨 ) ， 於 是 三 王 离 开 摩 押 王 ， 各 回 本 国 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9605', '12', '4', '1', '有 一 个 先 知 门 徒 的 妻 哀 求 以 利 沙 说 ： 你 仆 人 ─ 我 丈 夫 死 了 ， 他 敬 畏 耶 和 华 是 你 所 知 道 的 。 现 在 有 债 主 来 ， 要 取 我 两 个 儿 子 作 奴 仆 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9606', '12', '4', '2', '以 利 沙 问 他 说 ： 我 可 以 为 你 做 甚 麽 呢 ？ 你 告 诉 我 ， 你 家 里 有 甚 麽 ？ 他 说 ： 婢 女 家 中 除 了 一 瓶 油 之 外 ， 没 有 甚 麽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9607', '12', '4', '3', '以 利 沙 说 ： 你 去 ， 向 你 众 邻 舍 借 空 器 皿 ， 不 要 少 借 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9608', '12', '4', '4', '回 到 家 里 ， 关 上 门 ， 你 和 你 儿 子 在 里 面 将 油 倒 在 所 有 的 器 皿 里 ， 倒 满 了 的 放 在 一 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9609', '12', '4', '5', '於 是 ， 妇 人 离 开 以 利 沙 去 了 ， 关 上 门 ， 自 己 和 儿 子 在 里 面 ； 儿 子 把 器 皿 拿 来 ， 他 就 倒 油 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9610', '12', '4', '6', '器 皿 都 满 了 ， 他 对 儿 子 说 ： 再 给 我 拿 器 皿 来 。 儿 子 说 ： 再 没 有 器 皿 了 。 油 就 止 住 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9611', '12', '4', '7', '妇 人 去 告 诉 　 神 人 ， 神 人 说 ： 你 去 卖 油 还 债 ， 所 剩 的 你 和 你 儿 子 可 以 靠 着 度 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9612', '12', '4', '8', '一 日 ， 以 利 沙 走 到 书 念 ， 在 那 里 有 一 个 大 户 的 妇 人 强 留 他 吃 饭 。 此 後 ， 以 利 沙 每 从 那 里 经 过 就 进 去 吃 饭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9613', '12', '4', '9', '妇 人 对 丈 夫 说 ： 我 看 出 那 常 从 我 们 这 里 经 过 的 是 圣 洁 的 　 神 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9614', '12', '4', '10', '我 们 可 以 为 他 在 墙 上 盖 一 间 小 楼 ， 在 其 中 安 放 床 榻 、 桌 子 、 椅 子 、 灯 ? ， 他 来 到 我 们 这 里 ， 就 可 以 住 在 其 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9615', '12', '4', '11', '一 日 ， 以 利 沙 来 到 那 里 ， 就 进 了 那 楼 躺 卧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9616', '12', '4', '12', '以 利 沙 吩 咐 仆 人 基 哈 西 说 ： 你 叫 这 书 念 妇 人 来 。 他 就 把 妇 人 叫 了 来 ， 妇 人 站 在 以 利 沙 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9617', '12', '4', '13', '以 利 沙 吩 咐 仆 人 说 ： 你 对 他 说 ： 你 既 为 我 们 费 了 许 多 心 思 ， 可 以 为 你 做 甚 麽 呢 ？ 你 向 王 或 元 帅 有 所 求 的 没 有 ？ 他 回 答 说 ： 我 在 我 本 乡 安 居 无 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9618', '12', '4', '14', '以 利 沙 对 仆 人 说 ： 究 竟 当 为 他 做 甚 麽 呢 ？ 基 哈 西 说 ： 他 没 有 儿 子 ， 他 丈 夫 也 老 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9619', '12', '4', '15', '以 利 沙 说 ： 再 叫 他 来 。 於 是 叫 了 他 来 ， 他 就 站 在 门 口 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9620', '12', '4', '16', '以 利 沙 说 ： 明 年 到 这 时 候 ， 你 必 抱 一 个 儿 子 。 他 说 ： 　 神 人 ， 我 主 啊 ， 不 要 那 样 欺 哄 婢 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9621', '12', '4', '17', '妇 人 果 然 怀 孕 ， 到 了 那 时 候 ， 生 了 一 个 儿 子 ， 正 如 以 利 沙 所 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9622', '12', '4', '18', '孩 子 渐 渐 长 大 ， 一 日 到 他 父 亲 和 收 割 的 人 那 里 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9623', '12', '4', '19', '他 对 父 亲 说 ： 我 的 头 啊 ， 我 的 头 啊 ！ 他 父 亲 对 仆 人 说 ： 把 他 抱 到 他 母 亲 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9624', '12', '4', '20', '仆 人 抱 去 ， 交 给 他 母 亲 ； 孩 子 坐 在 母 亲 的 膝 上 ， 到 晌 午 就 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9625', '12', '4', '21', '他 母 亲 抱 他 上 了 楼 ， 将 他 放 在 　 神 人 的 床 上 ， 关 上 门 出 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9626', '12', '4', '22', '呼 叫 他 丈 夫 说 ： 你 叫 一 个 仆 人 给 我 牵 一 匹 驴 来 ， 我 要 快 快 地 去 见 　 神 人 ， 就 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9627', '12', '4', '23', '丈 夫 说 ： 今 日 不 是 月 朔 ， 也 不 是 安 息 日 ， 你 为 何 要 去 见 他 呢 ？ 妇 人 说 ： 平 安 无 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9628', '12', '4', '24', '於 是 备 上 驴 ， 对 仆 人 说 ： 你 快 快 赶 着 走 ， 我 若 不 吩 咐 你 ， 就 不 要 迟 慢 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9629', '12', '4', '25', '妇 人 就 往 迦 密 山 去 见 　 神 人 。 　 神 人 远 远 地 看 见 他 ， 对 仆 人 基 哈 西 说 ： 看 哪 ， 书 念 的 妇 人 来 了 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9630', '12', '4', '26', '你 跑 去 迎 接 他 ， 问 他 说 ： 你 平 安 麽 ？ 你 丈 夫 平 安 麽 ？ 孩 子 平 安 麽 ？ 他 说 ： 平 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9631', '12', '4', '27', '妇 人 上 了 山 ， 到 　 神 人 那 里 ， 就 抱 住 神 人 的 脚 。 基 哈 西 前 来 要 推 开 他 ， 　 神 人 说 ： 由 他 罢 ！ 因 为 他 心 里 愁 苦 ， 耶 和 华 向 我 隐 瞒 ， 没 有 指 示 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9632', '12', '4', '28', '妇 人 说 ： 我 何 尝 向 我 主 求 过 儿 子 呢 ？ 我 岂 没 有 说 过 ， 不 要 欺 哄 我 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9633', '12', '4', '29', '以 利 沙 吩 咐 基 哈 西 说 ： 你 束 上 腰 ， 手 拿 我 的 杖 前 去 ； 若 遇 见 人 ， 不 要 向 他 问 安 ； 人 若 向 你 问 安 ， 也 不 要 回 答 ； 要 把 我 的 杖 放 在 孩 子 脸 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9634', '12', '4', '30', '孩 子 的 母 亲 说 ： 我 指 着 永 生 的 耶 和 华 ， 又 敢 在 你 面 前 起 誓 ， 我 必 不 离 开 你 。 於 是 以 利 沙 起 身 ， 随 着 他 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9635', '12', '4', '31', '基 哈 西 先 去 ， 把 杖 放 在 孩 子 脸 上 ， 却 没 有 声 音 ， 也 没 有 动 静 。 基 哈 西 就 迎 着 以 利 沙 回 来 ， 告 诉 他 说 ： 孩 子 还 没 有 醒 过 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9636', '12', '4', '32', '以 利 沙 来 到 ， 进 了 屋 子 ， 看 见 孩 子 死 了 ， 放 在 自 己 的 床 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9637', '12', '4', '33', '他 就 关 上 门 ， 只 有 自 己 和 孩 子 在 里 面 ， 他 便 祈 祷 耶 和 华 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9638', '12', '4', '34', '上 床 伏 在 孩 子 身 上 ， 口 对 口 ， 眼 对 眼 ， 手 对 手 ； 既 伏 在 孩 子 身 上 ， 孩 子 的 身 体 就 渐 渐 温 和 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9639', '12', '4', '35', '然 後 他 下 来 ， 在 屋 里 来 往 走 了 一 趟 ， 又 上 去 伏 在 孩 子 身 上 ， 孩 子 打 了 七 个 喷 嚏 ， 就 睁 开 眼 睛 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9640', '12', '4', '36', '以 利 沙 叫 基 哈 西 说 ： 你 叫 这 书 念 妇 人 来 ； 於 是 叫 了 他 来 。 以 利 沙 说 ： 将 你 儿 子 抱 起 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9641', '12', '4', '37', '妇 人 就 进 来 ， 在 以 利 沙 脚 前 俯 伏 於 地 ， 抱 起 他 儿 子 出 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9642', '12', '4', '38', '以 利 沙 又 来 到 吉 甲 ， 那 地 正 有 饥 荒 。 先 知 门 徒 坐 在 他 面 前 ， 他 吩 咐 仆 人 说 ： 你 将 大 锅 放 在 火 上 ， 给 先 知 门 徒 熬 汤 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9643', '12', '4', '39', '有 一 个 人 去 到 田 野 掐 菜 ， 遇 见 一 棵 野 瓜 ? ， 就 摘 了 一 兜 野 瓜 回 来 ， 切 了 搁 在 熬 汤 的 锅 中 ， 因 为 他 们 不 知 道 是 甚 麽 东 西 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9644', '12', '4', '40', '倒 出 来 给 众 人 吃 ， 吃 的 时 候 ， 都 喊 叫 说 ： 　 神 人 哪 ， 锅 中 有 致 死 的 毒 物 ！ 所 以 众 人 不 能 吃 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9645', '12', '4', '41', '以 利 沙 说 ： 拿 点 面 来 ， 就 把 面 撒 在 锅 中 ， 说 ： 倒 出 来 ， 给 众 人 吃 罢 ！ 锅 中 就 没 有 毒 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9646', '12', '4', '42', '有 一 个 人 从 巴 力 沙 利 沙 来 ， 带 着 初 熟 大 麦 做 的 饼 二 十 个 ， 并 新 穗 子 ， 装 在 口 袋 里 送 给 　 神 人 。 神 人 说 ： 把 这 些 给 众 人 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9647', '12', '4', '43', '仆 人 说 ： 这 一 点 岂 可 摆 给 一 百 人 吃 呢 ？ 以 利 沙 说 ： 你 只 管 给 众 人 吃 罢 ！ 因 为 耶 和 华 如 此 说 ， 众 人 必 吃 了 ， 还 剩 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9648', '12', '4', '44', '仆 人 就 摆 在 众 人 面 前 ， 他 们 吃 了 ， 果 然 还 剩 下 ， 正 如 耶 和 华 所 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9649', '12', '5', '1', '亚 兰 王 的 元 帅 乃 缦 在 他 主 人 面 前 为 尊 为 大 ， 因 耶 和 华 曾 藉 他 使 亚 兰 人 得 胜 ； 他 又 是 大 能 的 勇 士 ， 只 是 长 了 大 ? 疯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9650', '12', '5', '2', '先 前 亚 兰 人 成 群 地 出 去 ， 从 以 色 列 国 掳 了 一 个 小 女 子 ， 这 女 子 就 服 事 乃 缦 的 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9651', '12', '5', '3', '他 对 主 母 说 ： 巴 不 得 我 主 人 去 见 撒 玛 利 亚 的 先 知 ， 必 能 治 好 他 的 大 ? 疯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9652', '12', '5', '4', '乃 缦 进 去 ， 告 诉 他 主 人 说 ， 以 色 列 国 的 女 子 如 此 如 此 说 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9653', '12', '5', '5', '亚 兰 王 说 ： 你 可 以 去 ， 我 也 达 信 於 以 色 列 王 。 於 是 乃 缦 带 银 子 十 他 连 得 ， 金 子 六 千 舍 客 勒 ， 衣 裳 十 套 ， 就 去 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9654', '12', '5', '6', '且 带 信 给 以 色 列 王 ， 信 上 说 ： 我 打 发 臣 仆 乃 缦 去 见 你 ， 你 接 到 这 信 ， 就 要 治 好 他 的 大 ? 疯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9655', '12', '5', '7', '以 色 列 王 看 了 信 就 撕 裂 衣 服 ， 说 ： 我 岂 是 　 神 ， 能 使 人 死 使 人 活 呢 ？ 这 人 竟 打 发 人 来 ， 叫 我 治 好 他 的 大 ? 疯 。 你 们 看 一 看 ， 这 人 何 以 寻 隙 攻 击 我 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9656', '12', '5', '8', '　 神 人 以 利 沙 听 见 以 色 列 王 撕 裂 衣 服 ， 就 打 发 人 去 见 王 ， 说 ： 你 为 甚 麽 撕 了 衣 服 呢 ？ 可 使 那 人 到 我 这 里 来 ， 他 就 知 道 以 色 列 中 有 先 知 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9657', '12', '5', '9', '於 是 ， 乃 缦 带 着 车 马 到 了 以 利 沙 的 家 ， 站 在 门 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9658', '12', '5', '10', '以 利 沙 打 发 一 个 使 者 ， 对 乃 缦 说 ： 你 去 在 约 但 河 中 沐 浴 七 回 ， 你 的 肉 就 必 复 原 ， 而 得 洁 净 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9659', '12', '5', '11', '乃 缦 却 发 怒 走 了 ， 说 ： 我 想 他 必 定 出 来 见 我 ， 站 着 求 告 耶 和 华 ─ 他 　 神 的 名 ， 在 患 处 以 上 摇 手 ， 治 好 这 大 ? 疯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9660', '12', '5', '12', '大 马 色 的 河 亚 罢 拿 和 法 珥 法 岂 不 比 以 色 列 的 一 切 水 更 好 麽 ？ 我 在 那 里 沐 浴 不 得 洁 净 麽 ？ 於 是 气 忿 忿 地 转 身 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9661', '12', '5', '13', '他 的 仆 人 进 前 来 ， 对 他 说 ： 我 父 啊 ， 先 知 若 吩 咐 你 做 一 件 大 事 ， 你 岂 不 做 麽 ？ 何 况 说 你 去 沐 浴 而 得 洁 净 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9662', '12', '5', '14', '於 是 乃 缦 下 去 ， 照 着 　 神 人 的 话 ， 在 约 但 河 里 沐 浴 七 回 ； 他 的 肉 复 原 ， 好 像 小 孩 子 的 肉 ， 他 就 洁 净 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9663', '12', '5', '15', '乃 缦 带 着 一 切 跟 随 他 的 人 ， 回 到 　 神 人 那 里 ， 站 在 他 面 前 ， 说 ： 如 今 我 知 道 ， 除 了 以 色 列 之 外 ， 普 天 下 没 有 　 神 。 现 在 求 你 收 点 仆 人 的 礼 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9664', '12', '5', '16', '以 利 沙 说 ： 我 指 着 所 事 奉 永 生 的 耶 和 华 起 誓 ， 我 必 不 受 。 乃 缦 再 三 地 求 他 ， 他 却 不 受 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9665', '12', '5', '17', '乃 缦 说 ： 你 若 不 肯 受 ， 请 将 两 骡 子 驮 的 土 赐 给 仆 人 。 从 今 以 後 ， 仆 人 必 不 再 将 燔 祭 或 平 安 祭 献 与 别 　 神 ， 只 献 给 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9666', '12', '5', '18', '惟 有 一 件 事 ， 愿 耶 和 华 饶 恕 你 仆 人 ： 我 主 人 进 临 门 庙 叩 拜 的 时 候 ， 我 用 手 搀 他 在 临 门 庙 ， 我 也 屈 身 。 我 在 临 门 庙 屈 身 的 这 事 ， 愿 耶 和 华 饶 恕 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9667', '12', '5', '19', '以 利 沙 对 他 说 ： 你 可 以 平 平 安 安 地 回 去 ！ 乃 缦 就 离 开 他 去 了 ； 走 了 不 远 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9668', '12', '5', '20', '　 神 人 以 利 沙 的 仆 人 基 哈 西 心 里 说 ： 我 主 人 不 愿 从 这 亚 兰 人 乃 缦 手 里 受 他 带 来 的 礼 物 ， 我 指 着 永 生 的 耶 和 华 起 誓 ， 我 必 跑 去 追 上 他 ， 向 他 要 些 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9669', '12', '5', '21', '於 是 基 哈 西 追 赶 乃 缦 。 乃 缦 看 见 有 人 追 赶 ， 就 急 忙 下 车 迎 着 他 ， 说 ： 都 平 安 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9670', '12', '5', '22', '说 ： 都 平 安 。 我 主 人 打 发 我 来 说 ： 刚 才 有 两 个 少 年 人 ， 是 先 知 门 徒 ， 从 以 法 莲 山 地 来 见 我 ， 请 你 赐 他 们 一 他 连 得 银 子 ， 两 套 衣 裳 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9671', '12', '5', '23', '乃 缦 说 ： 请 受 二 他 连 得 ； 再 三 地 请 受 ， 便 将 二 他 连 得 银 子 装 在 两 个 口 袋 里 ， 又 将 两 套 衣 裳 交 给 两 个 仆 人 ； 他 们 就 在 基 哈 西 前 头 抬 着 走 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9672', '12', '5', '24', '到 了 山 冈 ， 基 哈 西 从 他 们 手 中 接 过 来 ， 放 在 屋 里 ， 打 发 他 们 回 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9673', '12', '5', '25', '基 哈 西 进 去 ， 站 在 他 主 人 面 前 。 以 利 沙 问 他 说 ： 基 哈 西 你 从 哪 里 来 ？ 回 答 说 ： 仆 人 没 有 往 哪 里 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9674', '12', '5', '26', '以 利 沙 对 他 说 ： 那 人 下 车 转 回 迎 你 的 时 候 ， 我 的 心 岂 没 有 去 呢 ？ 这 岂 是 受 银 子 、 衣 裳 、 买 橄 榄 园 、 葡 萄 园 、 牛 羊 、 仆 婢 的 时 候 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9675', '12', '5', '27', '因 此 ， 乃 缦 的 大 ? 疯 必 沾 染 你 和 你 的 後 裔 ， 直 到 永 远 。 基 哈 西 从 以 利 沙 面 前 退 出 去 ， 就 长 了 大 ? 疯 ， 像 雪 那 样 白 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9676', '12', '6', '1', '先 知 门 徒 对 以 利 沙 说 ： 看 哪 ， 我 们 同 你 所 住 的 地 方 过 於 窄 小 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9677', '12', '6', '2', '求 你 容 我 们 往 约 但 河 去 ， 各 人 从 那 里 取 一 根 木 料 建 造 房 屋 居 住 。 他 说 ： 你 们 去 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9678', '12', '6', '3', '有 一 人 说 ： 求 你 与 仆 人 同 去 。 回 答 说 ： 我 可 以 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9679', '12', '6', '4', '於 是 以 利 沙 与 他 们 同 去 。 到 了 约 但 河 ， 就 砍 伐 树 木 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9680', '12', '6', '5', '有 一 人 砍 树 的 时 候 ， 斧 头 掉 在 水 里 ， 他 就 呼 叫 说 ： 哀 哉 ！ 我 主 啊 ， 这 斧 子 是 借 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9681', '12', '6', '6', '　 神 人 问 说 ： 掉 在 哪 里 了 ？ 他 将 那 地 方 指 给 以 利 沙 看 。 以 利 沙 砍 了 一 根 木 头 ， 抛 在 水 里 ， 斧 头 就 漂 上 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9682', '12', '6', '7', '以 利 沙 说 ： 拿 起 来 罢 ！ 那 人 就 伸 手 拿 起 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9683', '12', '6', '8', '亚 兰 王 与 以 色 列 人 争 战 ， 和 他 的 臣 仆 商 议 说 ： 我 要 在 某 处 某 处 安 营 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9684', '12', '6', '9', '　 神 人 打 发 人 去 见 以 色 列 王 ， 说 ： 你 要 谨 慎 ， 不 要 从 某 处 经 过 ， 因 为 亚 兰 人 从 那 里 下 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9685', '12', '6', '10', '以 色 列 王 差 人 去 窥 探 　 神 人 所 告 诉 所 警 戒 他 去 的 地 方 ， 就 防 备 未 受 其 害 ， 不 止 一 两 次 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9686', '12', '6', '11', '亚 兰 王 因 这 事 心 里 惊 疑 ， 召 了 臣 仆 来 ， 对 他 们 说 ： 我 们 这 里 有 谁 帮 助 以 色 列 王 ， 你 们 不 指 给 我 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9687', '12', '6', '12', '有 一 个 臣 仆 说 ： 我 主 ， 我 王 ！ 无 人 帮 助 他 ， 只 有 以 色 列 中 的 先 知 以 利 沙 ， 将 王 在 卧 房 所 说 的 话 告 诉 以 色 列 王 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9688', '12', '6', '13', '王 说 ： 你 们 去 探 他 在 哪 里 ， 我 好 打 发 人 去 捉 拿 他 。 有 人 告 诉 王 说 ： 他 在 多 坍 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9689', '12', '6', '14', '王 就 打 发 车 马 和 大 军 往 那 里 去 ， 夜 间 到 了 ， 围 困 那 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9690', '12', '6', '15', '　 神 人 的 仆 人 清 早 起 来 出 去 ， 看 见 车 马 军 兵 围 困 了 城 。 仆 人 对 神 人 说 ： 哀 哉 ！ 我 主 啊 ， 我 们 怎 样 行 才 好 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9691', '12', '6', '16', '神 人 说 ： 不 要 惧 怕 ！ 与 我 们 同 在 的 比 与 他 们 同 在 的 更 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9692', '12', '6', '17', '以 利 沙 祷 告 说 ： 耶 和 华 啊 ， 求 你 开 这 少 年 人 的 眼 目 ， 使 他 能 看 见 。 耶 和 华 开 他 的 眼 目 ， 他 就 看 见 满 山 有 火 车 火 马 围 绕 以 利 沙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9693', '12', '6', '18', '敌 人 下 到 以 利 沙 那 里 ， 以 利 沙 祷 告 耶 和 华 说 ： 求 你 使 这 些 人 的 眼 目 昏 迷 。 耶 和 华 就 照 以 利 沙 的 话 ， 使 他 们 的 眼 目 昏 迷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9694', '12', '6', '19', '以 利 沙 对 他 们 说 ： 这 不 是 那 道 ， 也 不 是 那 城 ； 你 们 跟 我 去 ， 我 必 领 你 们 到 所 寻 找 的 人 那 里 。 於 是 领 他 们 到 了 撒 玛 利 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9695', '12', '6', '20', '他 们 进 了 撒 玛 利 亚 ， 以 利 沙 祷 告 说 ： 耶 和 华 啊 ， 求 你 开 这 些 人 的 眼 目 ， 使 他 们 能 看 见 。 耶 和 华 开 他 们 的 眼 目 ， 他 们 就 看 见 了 ， 不 料 ， 是 在 撒 玛 利 亚 的 城 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9696', '12', '6', '21', '以 色 列 王 见 了 他 们 ， 就 问 以 利 沙 说 ： 我 父 啊 ， 我 可 以 击 杀 他 们 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9697', '12', '6', '22', '回 答 说 ： 不 可 击 杀 他 们 ！ 就 是 你 用 刀 用 弓 掳 来 的 ， 岂 可 击 杀 他 们 麽 ( 或 作 也 不 可 击 杀 ， 何 况 这 些 人 呢 ) ？ 当 在 他 们 面 前 设 摆 饮 食 ， 使 他 们 吃 喝 回 到 他 们 的 主 人 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9698', '12', '6', '23', '王 就 为 他 们 预 备 了 许 多 食 物 ； 他 们 吃 喝 完 了 ， 打 发 他 们 回 到 他 们 主 人 那 里 。 从 此 ， 亚 兰 军 不 再 犯 以 色 列 境 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9699', '12', '6', '24', '此 後 ， 亚 兰 王 便 哈 达 聚 集 他 的 全 军 ， 上 来 围 困 撒 玛 利 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9700', '12', '6', '25', '於 是 撒 玛 利 亚 被 围 困 ， 有 饥 荒 ， 甚 至 一 个 驴 头 值 银 八 十 舍 客 勒 ， 二 升 鸽 子 粪 值 银 五 舍 客 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9701', '12', '6', '26', '一 日 ， 以 色 列 王 在 城 上 经 过 ， 有 一 个 妇 人 向 他 呼 叫 说 ： 我 主 ， 我 王 啊 ！ 求 你 帮 助 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9702', '12', '6', '27', '王 说 ： 耶 和 华 不 帮 助 你 ， 我 从 何 处 帮 助 你 ？ 是 从 禾 场 ， 是 从 酒 ? 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9703', '12', '6', '28', '王 问 妇 人 说 ： 你 有 甚 麽 苦 处 ？ 他 回 答 说 ： 这 妇 人 对 我 说 ： 将 你 的 儿 子 取 来 ， 我 们 今 日 可 以 吃 ， 明 日 可 以 吃 我 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9704', '12', '6', '29', '我 们 就 煮 了 我 的 儿 子 吃 了 。 次 日 我 对 他 说 ： 要 将 你 的 儿 子 取 来 ， 我 们 可 以 吃 。 他 却 将 他 的 儿 子 藏 起 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9705', '12', '6', '30', '王 听 见 妇 人 的 话 ， 就 撕 裂 衣 服 ； （ 王 在 城 上 经 过 ） 百 姓 看 见 王 贴 身 穿 着 麻 衣 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9706', '12', '6', '31', '王 说 ： 我 今 日 若 容 沙 法 的 儿 子 以 利 沙 的 头 仍 在 他 项 上 ， 愿 　 神 重 重 地 降 罚 与 我 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9707', '12', '6', '32', '那 时 ， 以 利 沙 正 坐 在 家 中 ， 长 老 也 与 他 同 坐 。 王 打 发 一 个 伺 候 他 的 人 去 ； 他 还 没 有 到 ， 以 利 沙 对 长 老 说 ： 你 们 看 这 凶 手 之 子 ， 打 发 人 来 斩 我 的 头 ； 你 们 看 着 使 者 来 到 ， 就 关 上 门 ， 用 门 将 他 推 出 去 。 在 他 後 头 不 是 有 他 主 人 脚 步 的 响 声 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9708', '12', '6', '33', '正 说 话 的 时 候 ， 使 者 来 到 ， 王 也 到 了 ， 说 ： 这 灾 祸 是 从 耶 和 华 那 里 来 的 ， 我 何 必 再 仰 望 耶 和 华 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9709', '12', '7', '1', '以 利 沙 说 ： 你 们 要 听 耶 和 华 的 话 ， 耶 和 华 如 此 说 ： 明 日 约 到 这 时 候 ， 在 撒 玛 利 亚 城 门 口 ， 一 细 亚 细 面 要 卖 银 一 舍 客 勒 ， 二 细 亚 大 麦 也 要 卖 银 一 舍 客 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9710', '12', '7', '2', '有 一 个 搀 扶 王 的 军 长 对 　 神 人 说 ： 即 便 耶 和 华 使 天 开 了 窗 户 ， 也 不 能 有 这 事 。 以 利 沙 说 ： 你 必 亲 眼 看 见 ， 却 不 得 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9711', '12', '7', '3', '在 城 门 那 里 有 四 个 长 大 ? 疯 的 人 ， 他 们 彼 此 说 ： 我 们 为 何 坐 在 这 里 等 死 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9712', '12', '7', '4', '我 们 若 说 ， 进 城 去 罢 ！ 城 里 有 饥 荒 ， 必 死 在 那 里 ； 若 在 这 里 坐 着 不 动 ， 也 必 是 死 。 来 罢 ， 我 们 去 投 降 亚 兰 人 的 军 队 ， 他 们 若 留 我 们 的 活 命 ， 就 活 着 ； 若 杀 我 们 ， 就 死 了 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9713', '12', '7', '5', '黄 昏 的 时 候 ， 他 们 起 来 往 亚 兰 人 的 营 盘 去 ； 到 了 * 营 边 ， 不 见 一 人 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9714', '12', '7', '6', '因 为 主 使 亚 兰 人 的 军 队 听 见 车 马 的 声 音 ， 是 大 军 的 声 音 ； 他 们 就 彼 此 说 ： 这 必 是 以 色 列 王 贿 买 赫 人 的 诸 王 和 埃 及 人 的 诸 王 来 攻 击 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9715', '12', '7', '7', '所 以 ， 在 黄 昏 的 时 候 他 们 起 来 逃 跑 ， 撇 下 帐 棚 、 马 、 驴 ， 营 盘 照 旧 ， 只 顾 逃 命 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9716', '12', '7', '8', '那 些 长 大 ? 疯 的 到 了 营 边 ， 进 了 帐 棚 ， 吃 了 喝 了 ， 且 从 其 中 拿 出 金 银 和 衣 服 来 ， 去 收 藏 了 ； 回 来 又 进 了 一 座 帐 棚 ， 从 其 中 拿 出 财 物 来 去 收 藏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9717', '12', '7', '9', '那 时 ， 他 们 彼 此 说 ： 我 们 所 做 的 不 好 ！ 今 日 是 有 好 信 息 的 日 子 ， 我 们 竟 不 作 声 ！ 若 等 到 天 亮 ， 罪 必 临 到 我 们 。 来 罢 ， 我 们 与 王 家 报 信 去 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9718', '12', '7', '10', '他 们 就 去 叫 守 城 门 的 ， 告 诉 他 们 说 ： 我 们 到 了 亚 兰 人 的 营 ， 不 见 一 人 在 那 里 ， 也 无 人 声 ， 只 有 拴 着 的 马 和 驴 ， 帐 棚 都 照 旧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9719', '12', '7', '11', '守 城 门 的 叫 了 众 守 门 的 人 来 ， 他 们 就 进 去 与 王 家 报 信 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9720', '12', '7', '12', '王 夜 间 起 来 ， 对 臣 仆 说 ： 我 告 诉 你 们 亚 兰 人 向 我 们 如 何 行 。 他 们 知 道 我 们 饥 饿 ， 所 以 离 营 ， 埋 伏 在 田 野 ， 说 ： 以 色 列 人 出 城 的 时 候 ， 我 们 就 活 捉 他 们 ， 得 以 进 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9721', '12', '7', '13', '有 一 个 臣 仆 对 王 说 ： 我 们 不 如 用 城 里 剩 下 之 马 中 的 五 匹 马 （ 马 和 城 里 剩 下 的 以 色 列 人 都 是 一 样 ， 快 要 灭 绝 ） ， 打 发 人 去 窥 探 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9722', '12', '7', '14', '於 是 取 了 两 辆 车 和 马 ， 王 差 人 去 追 寻 亚 兰 军 ， 说 ： 你 们 去 窥 探 窥 探 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9723', '12', '7', '15', '他 们 就 追 寻 到 约 但 河 ， 看 见 满 道 上 都 是 亚 兰 人 急 跑 时 丢 弃 的 衣 服 器 具 ， 使 者 就 回 来 报 告 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9724', '12', '7', '16', '众 人 就 出 去 ， 掳 掠 亚 兰 人 的 营 盘 。 於 是 一 细 亚 细 面 卖 银 一 舍 客 勒 ， 二 细 亚 大 麦 也 卖 银 一 舍 客 勒 ， 正 如 耶 和 华 所 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9725', '12', '7', '17', '王 派 搀 扶 他 的 那 军 长 在 城 门 口 弹 压 ， 众 人 在 那 里 将 他 践 踏 ， 他 就 死 了 ， 正 如 　 神 人 在 王 下 来 见 他 的 时 候 所 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9726', '12', '7', '18', '　 神 人 曾 对 王 说 ： 明 日 约 到 这 时 候 ， 在 撒 玛 利 亚 城 门 口 ， 二 细 亚 大 麦 要 卖 银 一 舍 客 勒 ， 一 细 亚 细 面 也 要 卖 银 一 舍 客 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9727', '12', '7', '19', '那 军 长 对 　 神 人 说 ： 即 便 耶 和 华 使 天 开 了 窗 户 ， 也 不 能 有 这 事 。 神 人 说 ： 你 必 亲 眼 看 见 ， 却 不 得 吃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9728', '12', '7', '20', '这 话 果 然 应 验 在 他 身 上 ； 因 为 众 人 在 城 门 口 将 他 践 踏 ， 他 就 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9729', '12', '8', '1', '以 利 沙 曾 对 所 救 活 之 子 的 那 妇 人 说 ： 你 和 你 的 全 家 要 起 身 往 你 可 住 的 地 方 去 住 ， 因 为 耶 和 华 命 饥 荒 降 在 这 地 七 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9730', '12', '8', '2', '妇 人 就 起 身 ， 照 　 神 人 的 话 带 着 全 家 往 非 利 士 地 去 ， 住 了 七 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9731', '12', '8', '3', '七 年 完 了 ， 那 妇 人 从 非 利 士 地 回 来 ， 就 出 去 为 自 己 的 房 屋 田 地 哀 告 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9732', '12', '8', '4', '那 时 王 正 与 　 神 人 的 仆 人 基 哈 西 说 ： 请 你 将 以 利 沙 所 行 的 一 切 大 事 告 诉 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9733', '12', '8', '5', '基 哈 西 告 诉 王 以 利 沙 如 何 使 死 人 复 活 ， 恰 巧 以 利 沙 所 救 活 、 他 儿 子 的 那 妇 人 为 自 己 的 房 屋 田 地 来 哀 告 王 。 基 哈 西 说 ： 我 主 我 王 ， 这 就 是 那 妇 人 ， 这 是 他 的 儿 子 ， 就 是 以 利 沙 所 救 活 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9734', '12', '8', '6', '王 问 那 妇 人 ， 他 就 把 那 事 告 诉 王 。 於 是 王 为 他 派 一 个 太 监 ， 说 ： 凡 属 这 妇 人 的 都 还 给 他 ， 自 从 他 离 开 本 地 直 到 今 日 ， 他 田 地 的 出 产 也 都 还 给 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9735', '12', '8', '7', '以 利 沙 来 到 大 马 色 ， 亚 兰 王 便 哈 达 正 患 病 。 有 人 告 诉 王 说 ： 　 神 人 来 到 这 里 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9736', '12', '8', '8', '王 就 吩 咐 哈 薛 说 ： 你 带 着 礼 物 去 见 　 神 人 ， 托 他 求 问 耶 和 华 ， 我 这 病 能 好 不 能 好 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9737', '12', '8', '9', '於 是 哈 薛 用 四 十 个 骆 驼 ， 驮 着 大 马 色 的 各 样 美 物 为 礼 物 ， 去 见 以 利 沙 。 到 了 他 那 里 ， 站 在 他 面 前 ， 说 ： 你 儿 子 亚 兰 王 便 哈 达 打 发 我 来 见 你 ， 他 问 说 ： 我 这 病 能 好 不 能 好 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9738', '12', '8', '10', '以 利 沙 对 哈 薛 说 ： 你 回 去 告 诉 他 说 ， 这 病 必 能 好 ； 但 耶 和 华 指 示 我 ， 他 必 要 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9739', '12', '8', '11', '神 人 定 睛 看 着 哈 薛 ， 甚 至 他 惭 愧 。 　 神 人 就 哭 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9740', '12', '8', '12', '哈 薛 说 ： 我 主 为 甚 麽 哭 ？ 回 答 说 ： 因 为 我 知 道 你 必 苦 害 以 色 列 人 ， 用 火 焚 烧 他 们 的 保 障 ， 用 刀 杀 死 他 们 的 壮 丁 ， 摔 死 他 们 的 婴 孩 ， 剖 开 他 们 的 孕 妇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9741', '12', '8', '13', '哈 薛 说 ： 你 仆 人 算 甚 麽 ， 不 过 是 一 条 狗 ， 焉 能 行 这 大 事 呢 ？ 以 利 沙 回 答 说 ： 耶 和 华 指 示 我 ， 你 必 作 亚 兰 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9742', '12', '8', '14', '哈 薛 离 开 以 利 沙 ， 回 去 见 他 的 主 人 。 主 人 问 他 说 ： 以 利 沙 对 你 说 甚 麽 ？ 回 答 说 ： 他 告 诉 我 你 必 能 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9743', '12', '8', '15', '次 日 ， 哈 薛 拿 被 窝 浸 在 水 中 ， 蒙 住 王 的 脸 ， 王 就 死 了 。 於 是 哈 薛 篡 了 他 的 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9744', '12', '8', '16', '以 色 列 王 亚 哈 的 儿 子 约 兰 第 五 年 ， 犹 大 王 约 沙 法 还 在 位 的 时 候 ， 约 沙 法 的 儿 子 约 兰 登 基 作 了 犹 大 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9745', '12', '8', '17', '约 兰 登 基 的 时 候 年 三 十 二 岁 ， 在 耶 路 撒 冷 作 王 八 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9746', '12', '8', '18', '他 行 以 色 列 诸 王 所 行 的 ， 与 亚 哈 家 一 样 ； 因 为 他 娶 了 亚 哈 的 女 儿 为 妻 ， 行 耶 和 华 眼 中 看 为 恶 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9747', '12', '8', '19', '耶 和 华 却 因 他 仆 人 大 卫 的 缘 故 ， 仍 不 肯 灭 绝 犹 大 ， 照 他 所 应 许 大 卫 的 话 ， 永 远 赐 灯 光 与 他 的 子 孙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9748', '12', '8', '20', '约 兰 年 间 ， 以 东 人 背 叛 犹 大 ， 脱 离 他 的 权 下 ， 自 己 立 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9749', '12', '8', '21', '约 兰 率 领 所 有 的 战 车 往 撒 益 去 ， 夜 间 起 来 ， 攻 打 围 困 他 的 以 东 人 和 车 兵 长 ； 犹 大 兵 就 逃 跑 ， 各 回 各 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9750', '12', '8', '22', '这 样 ， 以 东 人 背 叛 犹 大 ， 脱 离 他 的 权 下 ， 直 到 今 日 。 那 时 立 拿 人 也 背 叛 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9751', '12', '8', '23', '约 兰 其 馀 的 事 ， 凡 他 所 行 的 ， 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9752', '12', '8', '24', '约 兰 与 他 列 祖 同 睡 ， 葬 在 大 卫 城 他 列 祖 的 坟 地 里 。 他 儿 子 亚 哈 谢 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9753', '12', '8', '25', '以 色 列 王 亚 哈 的 儿 子 约 兰 十 二 年 ， 犹 大 王 约 兰 的 儿 子 亚 哈 谢 登 基 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9754', '12', '8', '26', '他 登 基 的 时 候 年 二 十 二 岁 ， 在 耶 路 撒 冷 作 王 一 年 。 他 母 亲 名 叫 亚 他 利 雅 ， 是 以 色 列 王 暗 利 的 孙 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9755', '12', '8', '27', '亚 哈 谢 效 法 亚 哈 家 行 耶 和 华 眼 中 看 为 恶 的 事 ， 与 亚 哈 家 一 样 ， 因 为 他 是 亚 哈 家 的 女 婿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9756', '12', '8', '28', '他 与 亚 哈 的 儿 子 约 兰 同 往 基 列 的 拉 末 去 ， 与 亚 兰 王 哈 薛 争 战 。 亚 兰 人 打 伤 了 约 兰 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9757', '12', '8', '29', '约 兰 王 回 到 耶 斯 列 ， 医 治 在 拉 末 与 亚 兰 王 哈 薛 打 仗 的 时 候 所 受 的 伤 。 犹 大 王 约 兰 的 儿 子 亚 哈 谢 因 为 亚 哈 的 儿 子 约 兰 病 了 ， 就 下 到 耶 斯 列 看 望 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9758', '12', '9', '1', '先 知 以 利 沙 叫 了 一 个 先 知 门 徒 来 ， 吩 咐 他 说 ： 你 束 上 腰 ， 手 拿 这 瓶 膏 油 往 基 列 的 拉 末 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9759', '12', '9', '2', '到 了 那 里 ， 要 寻 找 宁 示 的 孙 子 、 约 沙 法 的 儿 子 耶 户 ， 使 他 从 同 僚 中 起 来 ， 带 他 进 严 密 的 屋 子 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9760', '12', '9', '3', '将 瓶 里 的 膏 油 倒 在 他 头 上 ， 说 ： 耶 和 华 如 此 说 ： 我 膏 你 作 以 色 列 王 。 说 完 了 ， 就 开 门 逃 跑 ， 不 要 迟 延 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9761', '12', '9', '4', '於 是 那 少 年 先 知 往 基 列 的 拉 末 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9762', '12', '9', '5', '到 了 那 里 ， 看 见 众 军 长 都 坐 着 ， 就 说 ： 将 军 哪 ， 我 有 话 对 你 说 。 耶 户 说 ： 我 们 众 人 里 ， 你 要 对 哪 一 个 说 呢 ？ 回 答 说 ： 将 军 哪 ， 我 要 对 你 说 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9763', '12', '9', '6', '耶 户 就 起 来 ， 进 了 屋 子 ， 少 年 人 将 膏 油 倒 在 他 头 上 ， 对 他 说 ： 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 我 膏 你 作 耶 和 华 民 以 色 列 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9764', '12', '9', '7', '你 要 击 杀 你 主 人 亚 哈 的 全 家 ， 我 好 在 耶 洗 别 身 上 伸 我 仆 人 众 先 知 和 耶 和 华 一 切 仆 人 流 血 的 冤 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9765', '12', '9', '8', '亚 哈 全 家 必 都 灭 亡 ， 凡 属 亚 哈 的 男 丁 ， 无 论 是 困 住 的 、 自 由 的 ， 我 必 从 以 色 列 中 剪 除 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9766', '12', '9', '9', '使 亚 哈 的 家 像 尼 八 儿 子 耶 罗 波 安 的 家 ， 又 像 亚 希 雅 儿 子 巴 沙 的 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9767', '12', '9', '10', '耶 洗 别 必 在 耶 斯 列 田 里 被 狗 所 吃 ， 无 人 葬 埋 。 说 完 了 ， 少 年 人 就 开 门 逃 跑 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9768', '12', '9', '11', '耶 户 出 来 ， 回 到 他 主 人 的 臣 仆 那 里 ， 有 一 人 问 他 说 ： 平 安 麽 ？ 这 狂 妄 的 人 来 见 你 有 甚 麽 事 呢 ？ 回 答 说 ： 你 们 认 得 那 人 ， 也 知 道 他 说 甚 麽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9769', '12', '9', '12', '他 们 说 ： 这 是 假 话 ， 你 据 实 地 告 诉 我 们 。 回 答 说 ： 他 如 此 如 此 对 我 说 。 他 说 ： 耶 和 华 如 此 说 ： 我 膏 你 作 以 色 列 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9770', '12', '9', '13', '他 们 就 急 忙 各 将 自 己 的 衣 服 铺 在 上 层 ? 阶 ， 使 耶 户 坐 在 其 上 ； 他 们 吹 角 ， 说 ： 耶 户 作 王 了 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9771', '12', '9', '14', '这 样 ， 宁 示 的 孙 子 、 约 沙 法 的 儿 子 耶 户 背 叛 约 兰 。 先 是 约 兰 和 以 色 列 众 人 因 为 亚 兰 王 哈 薛 的 缘 故 ， 把 守 基 列 的 拉 末 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9772', '12', '9', '15', '但 约 兰 王 回 到 耶 斯 列 ， 医 治 与 亚 兰 王 哈 薛 打 仗 所 受 的 伤 。 耶 户 说 ： 若 合 你 们 的 意 思 ， 就 不 容 人 逃 出 城 往 耶 斯 列 报 信 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9773', '12', '9', '16', '於 是 耶 户 坐 车 往 耶 斯 列 去 ， 因 为 约 兰 病 卧 在 那 里 。 犹 大 王 亚 哈 谢 已 经 下 去 看 望 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9774', '12', '9', '17', '有 一 个 守 望 的 人 站 在 耶 斯 列 的 楼 上 ， 看 见 耶 户 带 着 一 群 人 来 ， 就 说 ： 我 看 见 一 群 人 。 约 兰 说 ： 打 发 一 个 骑 马 的 去 迎 接 他 们 ， 问 说 ： 平 安 不 平 安 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9775', '12', '9', '18', '骑 马 的 就 去 迎 接 耶 户 ， 说 ： 王 问 说 ， 平 安 不 平 安 ？ 耶 户 说 ： 平 安 不 平 安 与 你 何 干 ？ 你 转 在 我 後 头 罢 ！ 守 望 的 人 又 说 ： 使 者 到 了 他 们 那 里 ， 却 不 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9776', '12', '9', '19', '王 又 打 发 一 个 骑 马 的 去 。 这 人 到 了 他 们 那 里 ， 说 ： 王 问 说 ， 平 安 不 平 安 ？ 耶 户 说 ： 平 安 不 平 安 与 你 何 干 ？ 你 转 在 我 後 头 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9777', '12', '9', '20', '守 望 的 人 又 说 ： 他 到 了 他 们 那 里 ， 也 不 回 来 ； 车 赶 得 甚 猛 ， 像 宁 示 的 孙 子 耶 户 的 赶 法 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9778', '12', '9', '21', '约 兰 吩 咐 说 ： 套 车 ！ 人 就 给 他 套 车 。 以 色 列 王 约 兰 和 犹 大 王 亚 哈 谢 各 坐 自 己 的 车 出 去 迎 接 耶 户 ， 在 耶 斯 列 人 拿 伯 的 田 那 里 遇 见 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9779', '12', '9', '22', '约 兰 见 耶 户 就 说 ： 耶 户 啊 ， 平 安 麽 ？ 耶 户 说 ： 你 母 亲 耶 洗 别 的 淫 行 邪 术 这 样 多 ， 焉 能 平 安 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9780', '12', '9', '23', '约 兰 就 转 车 逃 跑 ， 对 亚 哈 谢 说 ： 亚 哈 谢 啊 ， 反 了 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9781', '12', '9', '24', '耶 户 开 满 了 弓 ， 射 中 约 兰 的 脊 背 ， 箭 从 心 窝 穿 出 ， 约 兰 就 仆 倒 在 车 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9782', '12', '9', '25', '耶 户 对 他 的 军 长 毕 甲 说 ： 你 把 他 抛 在 耶 斯 列 人 拿 伯 的 田 间 。 你 当 追 想 ， 你 我 一 同 坐 车 跟 随 他 父 亚 哈 的 时 候 ， 耶 和 华 对 亚 哈 所 说 的 预 言 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9783', '12', '9', '26', '说 ： 我 昨 日 看 见 拿 伯 的 血 和 他 众 子 的 血 ， 我 必 在 这 块 田 上 报 应 你 。 这 是 耶 和 华 说 的 ， 现 在 你 要 照 着 耶 和 华 的 话 ， 把 他 抛 在 这 田 间 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9784', '12', '9', '27', '犹 大 王 亚 哈 谢 见 这 光 景 ， 就 从 园 亭 之 路 逃 跑 。 耶 户 追 赶 他 ， 说 ： 把 这 人 也 杀 在 车 上 。 到 了 靠 近 以 伯 莲 的 姑 珥 坡 上 击 伤 了 他 。 他 逃 到 米 吉 多 ， 就 死 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9785', '12', '9', '28', '他 的 臣 仆 用 车 将 他 的 尸 首 送 到 耶 路 撒 冷 ， 葬 在 大 卫 城 他 自 己 的 坟 墓 里 ， 与 他 列 祖 同 葬 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9786', '12', '9', '29', '亚 哈 谢 登 基 作 犹 大 王 的 时 候 ， 是 在 亚 哈 的 儿 子 约 兰 第 十 一 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9787', '12', '9', '30', '耶 户 到 了 耶 斯 列 ； 耶 洗 别 听 见 就 擦 粉 、 梳 头 ， 从 窗 户 里 往 外 观 看 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9788', '12', '9', '31', '耶 户 进 门 的 时 候 ， 耶 洗 别 说 ： 杀 主 人 的 心 利 啊 ， 平 安 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9789', '12', '9', '32', '耶 户 抬 头 向 窗 户 观 看 ， 说 ： 谁 顺 从 我 ？ 有 两 三 个 太 监 从 窗 户 往 外 看 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9790', '12', '9', '33', '耶 户 说 ： 把 他 扔 下 来 ！ 他 们 就 把 他 扔 下 来 。 他 的 血 溅 在 墙 上 和 马 上 ； 於 是 把 他 践 踏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9791', '12', '9', '34', '耶 户 进 去 ， 吃 了 喝 了 ， 吩 咐 说 ： 你 们 把 这 被 咒 诅 的 妇 人 葬 埋 了 ， 因 为 他 是 王 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9792', '12', '9', '35', '他 们 就 去 葬 埋 他 ， 只 寻 得 他 的 头 骨 和 脚 ， 并 手 掌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9793', '12', '9', '36', '他 们 回 去 告 诉 耶 户 ， 耶 户 说 ： 这 正 应 验 耶 和 华 藉 他 仆 人 提 斯 比 人 以 利 亚 所 说 的 话 ， 说 ： 在 耶 斯 列 田 间 ， 狗 必 吃 耶 洗 别 的 肉 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9794', '12', '9', '37', '耶 洗 别 的 尸 首 必 在 耶 斯 列 田 间 如 同 粪 土 ， 甚 至 人 不 能 说 这 是 耶 洗 别 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9795', '12', '10', '1', '亚 哈 有 七 十 个 儿 子 在 撒 玛 利 亚 。 耶 户 写 信 送 到 撒 玛 利 亚 ， 通 知 耶 斯 列 的 首 领 ， 就 是 长 老 和 教 养 亚 哈 众 子 的 人 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9796', '12', '10', '2', '你 们 那 里 既 有 你 们 主 人 的 众 子 和 车 马 、 器 械 、 坚 固 城 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9797', '12', '10', '3', '接 了 这 信 ， 就 可 以 在 你 们 主 人 的 众 子 中 选 择 一 个 贤 能 合 宜 的 ， 使 他 坐 他 父 亲 的 位 ， 你 们 也 可 以 为 你 们 主 人 的 家 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9798', '12', '10', '4', '他 们 却 甚 惧 怕 ， 彼 此 说 ： 二 王 在 他 面 前 尚 且 站 立 不 住 ， 我 们 怎 能 站 得 住 呢 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9799', '12', '10', '5', '家 宰 、 邑 宰 ， 和 长 老 ， 并 教 养 众 子 的 人 ， 打 发 人 去 见 耶 户 ， 说 ： 我 们 是 你 的 仆 人 ， 凡 你 所 吩 咐 我 们 的 都 必 遵 行 ， 我 们 不 立 谁 作 王 ， 你 看 怎 样 好 就 怎 样 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9800', '12', '10', '6', '耶 户 又 给 他 们 写 信 说 ： 你 们 若 归 顺 我 ， 听 从 我 的 话 ， 明 日 这 时 候 ， 要 将 你 们 主 人 众 子 的 首 级 带 到 耶 斯 列 来 见 我 。 那 时 王 的 儿 子 七 十 人 都 住 在 教 养 他 们 那 城 中 的 尊 贵 人 家 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9801', '12', '10', '7', '信 一 到 ， 他 们 就 把 王 的 七 十 个 儿 子 杀 了 ， 将 首 级 装 在 筐 里 ， 送 到 在 耶 斯 列 的 耶 户 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9802', '12', '10', '8', '有 使 者 来 告 诉 耶 户 说 ： 他 们 将 王 众 子 的 首 级 送 来 了 。 耶 户 说 ： 将 首 级 在 城 门 口 堆 作 两 堆 ， 搁 到 明 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9803', '12', '10', '9', '次 日 早 晨 ， 耶 户 出 来 ， 站 着 对 众 民 说 ： 你 们 都 是 公 义 的 ， 我 背 叛 我 主 人 ， 将 他 杀 了 ； 这 些 人 却 是 谁 杀 的 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9804', '12', '10', '10', '由 此 可 知 ， 耶 和 华 指 着 亚 哈 家 所 说 的 话 一 句 没 有 落 空 ， 因 为 耶 和 华 藉 他 仆 人 以 利 亚 所 说 的 话 都 成 就 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9805', '12', '10', '11', '凡 亚 哈 家 在 耶 斯 列 所 剩 下 的 人 和 他 的 大 臣 、 密 友 、 祭 司 ， 耶 户 尽 都 杀 了 ， 没 有 留 下 一 个 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9806', '12', '10', '12', '耶 户 起 身 往 撒 玛 利 亚 去 。 在 路 上 、 牧 人 剪 羊 毛 之 处 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9807', '12', '10', '13', '遇 见 犹 大 王 亚 哈 谢 的 弟 兄 ， 问 他 们 说 ： 你 们 是 谁 ？ 回 答 说 ： 我 们 是 亚 哈 谢 的 弟 兄 ， 现 在 下 去 要 问 王 和 太 后 的 众 子 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9808', '12', '10', '14', '耶 户 吩 咐 说 ： 活 捉 他 们 ！ 跟 从 的 人 就 活 捉 了 他 们 ， 将 他 们 杀 在 剪 羊 毛 之 处 的 坑 边 ， 共 四 十 二 人 ， 没 有 留 下 一 个 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9809', '12', '10', '15', '耶 户 从 那 里 前 行 ， 恰 遇 利 甲 的 儿 子 约 拿 达 来 迎 接 他 ， 耶 户 问 他 安 ， 对 他 说 ： 你 诚 心 待 我 像 我 诚 心 待 你 麽 ？ 约 拿 达 回 答 说 ： 是 。 耶 户 说 ： 若 是 这 样 ， 你 向 我 伸 手 ， 他 就 伸 手 ； 耶 户 拉 他 上 车 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9810', '12', '10', '16', '耶 户 说 ： 你 和 我 同 去 ， 看 我 为 耶 和 华 怎 样 热 心 ； 於 是 请 他 坐 在 车 上 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9811', '12', '10', '17', '到 了 撒 玛 利 亚 ， 就 把 撒 玛 利 亚 的 亚 哈 家 剩 下 的 人 都 杀 了 ， 直 到 灭 尽 ， 正 如 耶 和 华 对 以 利 亚 所 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9812', '12', '10', '18', '耶 户 招 聚 众 民 ， 对 他 们 说 ： 亚 哈 事 奉 巴 力 还 冷 淡 ， 耶 户 却 更 热 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9813', '12', '10', '19', '现 在 我 要 给 巴 力 献 大 祭 。 应 当 叫 巴 力 的 众 先 知 和 一 切 拜 巴 力 的 人 ， 并 巴 力 的 众 祭 司 ， 都 到 我 这 里 来 ， 不 可 缺 少 一 个 ； 凡 不 来 的 必 不 得 活 。 耶 户 这 样 行 ， 是 用 诡 计 要 杀 尽 拜 巴 力 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9814', '12', '10', '20', '耶 户 说 ： 要 为 巴 力 宣 告 严 肃 会 ！ 於 是 宣 告 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9815', '12', '10', '21', '耶 户 差 人 走 遍 以 色 列 地 ； 凡 拜 巴 力 的 人 都 来 齐 了 ， 没 有 一 个 不 来 的 。 他 们 进 了 巴 力 庙 ， 巴 力 庙 中 从 前 边 直 到 後 边 都 满 了 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9816', '12', '10', '22', '耶 户 吩 咐 掌 管 礼 服 的 人 说 ： 拿 出 礼 服 来 ， 给 一 切 拜 巴 力 的 人 穿 。 他 就 拿 出 礼 服 来 给 了 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9817', '12', '10', '23', '耶 户 和 利 甲 的 儿 子 约 拿 达 进 了 巴 力 庙 ， 对 拜 巴 力 的 人 说 ： 你 们 察 看 察 看 ， 在 你 们 这 里 不 可 有 耶 和 华 的 仆 人 ， 只 可 容 留 拜 巴 力 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9818', '12', '10', '24', '耶 户 和 约 拿 达 进 去 ， 献 平 安 祭 和 燔 祭 。 耶 户 先 安 排 八 十 人 在 庙 外 ， 吩 咐 说 ： 我 将 这 些 人 交 在 你 们 手 中 ， 若 有 一 人 脱 逃 ， 谁 放 的 必 叫 他 偿 命 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9819', '12', '10', '25', '耶 户 献 完 了 燔 祭 ， 就 出 来 吩 咐 护 卫 兵 和 众 军 长 说 ： 你 们 进 去 杀 他 们 ， 不 容 一 人 出 来 ！ 护 卫 兵 和 军 长 就 用 刀 杀 他 们 ， 将 尸 首 抛 出 去 ， 便 到 巴 力 庙 的 城 去 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9820', '12', '10', '26', '将 巴 力 庙 中 的 柱 像 都 拿 出 来 烧 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9821', '12', '10', '27', '毁 坏 了 巴 力 柱 像 ， 拆 毁 了 巴 力 庙 作 为 厕 所 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9822', '12', '10', '28', '这 样 ， 耶 户 在 以 色 列 中 灭 了 巴 力 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9823', '12', '10', '29', '只 是 耶 户 不 离 开 尼 八 的 儿 子 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 那 罪 ， 就 是 拜 伯 特 利 和 但 的 金 牛 犊 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9824', '12', '10', '30', '耶 和 华 对 耶 户 说 ： 因 你 办 好 我 眼 中 看 为 正 的 事 ， 照 我 的 心 意 待 亚 哈 家 ， 你 的 子 孙 必 接 续 你 坐 以 色 列 的 国 位 ， 直 到 四 代 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9825', '12', '10', '31', '只 是 耶 户 不 尽 心 遵 守 耶 和 华 ─ 以 色 列 　 神 的 律 法 ， 不 离 开 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 那 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9826', '12', '10', '32', '在 那 些 日 子 ， 耶 和 华 才 割 裂 以 色 列 国 ， 使 哈 薛 攻 击 以 色 列 的 境 界 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9827', '12', '10', '33', '乃 是 约 但 河 东 、 基 列 全 地 ， 从 靠 近 亚 嫩 谷 边 的 亚 罗 珥 起 ， 就 是 基 列 和 巴 珊 的 迦 得 人 、 流 便 人 、 玛 拿 西 人 之 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9828', '12', '10', '34', '耶 户 其 馀 的 事 ， 凡 他 所 行 的 和 他 的 勇 力 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9829', '12', '10', '35', '耶 户 与 他 列 祖 同 睡 ， 葬 在 撒 玛 利 亚 ； 他 儿 子 约 哈 斯 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9830', '12', '10', '36', '耶 户 在 撒 玛 利 亚 作 以 色 列 王 二 十 八 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9831', '12', '11', '1', '亚 哈 谢 的 母 亲 亚 他 利 雅 见 他 儿 子 死 了 ， 就 起 来 剿 灭 王 室 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9832', '12', '11', '2', '但 约 兰 王 的 女 儿 ， 亚 哈 谢 的 妹 子 约 示 巴 ， 将 亚 哈 谢 的 儿 子 约 阿 施 从 那 被 杀 的 王 子 中 偷 出 来 ， 把 他 和 他 的 乳 母 都 藏 在 卧 房 里 ， 躲 避 亚 他 利 雅 ， 免 得 被 杀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9833', '12', '11', '3', '约 阿 施 和 他 的 乳 母 藏 在 耶 和 华 的 殿 里 六 年 ； 亚 他 利 雅 篡 了 国 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9834', '12', '11', '4', '第 七 年 ， 耶 何 耶 大 打 发 人 叫 迦 利 人 ( 或 作 亲 兵 ) 和 护 卫 兵 的 众 百 夫 长 来 ， 领 他 们 进 了 耶 和 华 的 殿 ， 与 他 们 立 约 ， 使 他 们 在 耶 和 华 殿 里 起 誓 ， 又 将 王 的 儿 子 指 给 他 们 看 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9835', '12', '11', '5', '吩 咐 他 们 说 ： 你 们 当 这 样 行 ： 凡 安 息 日 进 班 的 三 分 之 一 要 看 守 王 宫 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9836', '12', '11', '6', '三 分 之 一 要 在 苏 珥 门 ， 三 分 之 一 要 在 护 卫 兵 院 的 後 门 。 这 样 把 守 王 宫 ， 拦 阻 ? 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9837', '12', '11', '7', '你 们 安 息 日 所 有 出 班 的 三 分 之 二 要 在 耶 和 华 的 殿 里 护 卫 王 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9838', '12', '11', '8', '各 人 手 拿 兵 器 ， 四 围 护 卫 王 。 凡 擅 入 你 们 班 次 的 必 当 治 死 ， 王 出 入 的 时 候 ， 你 们 当 跟 随 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9839', '12', '11', '9', '众 百 夫 长 就 照 着 祭 司 耶 何 耶 大 一 切 所 吩 咐 的 去 行 ， 各 带 所 管 安 息 日 进 班 出 班 的 人 来 见 祭 司 耶 何 耶 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9840', '12', '11', '10', '祭 司 便 将 耶 和 华 殿 里 所 藏 大 卫 王 的 枪 和 盾 牌 交 给 百 夫 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9841', '12', '11', '11', '护 卫 兵 手 中 各 拿 兵 器 ， 在 坛 和 殿 那 里 ， 从 殿 右 直 到 殿 左 ， 站 在 王 子 的 四 围 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9842', '12', '11', '12', '祭 司 领 王 子 出 来 ， 给 他 戴 上 冠 冕 ， 将 律 法 书 交 给 他 ， 膏 他 作 王 ； 众 人 就 拍 掌 说 ： 愿 王 万 岁 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9843', '12', '11', '13', '亚 他 利 雅 听 见 护 卫 兵 和 民 的 声 音 ， 就 到 民 那 里 ， 进 耶 和 华 的 殿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9844', '12', '11', '14', '看 见 王 照 例 站 在 柱 旁 ， 百 夫 长 和 吹 号 的 人 侍 立 在 王 左 右 ， 国 中 的 众 民 欢 乐 吹 号 ； 亚 他 利 雅 就 撕 裂 衣 服 ， 喊 叫 说 ： 反 了 ！ 反 了 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9845', '12', '11', '15', '祭 司 耶 何 耶 大 吩 咐 管 辖 军 兵 的 百 夫 长 说 ： 将 他 赶 出 班 外 ， 凡 跟 随 他 的 必 用 刀 杀 死 ！ 因 为 祭 司 说 不 可 在 耶 和 华 殿 里 杀 他 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9846', '12', '11', '16', '众 兵 就 闪 开 让 他 去 ； 他 从 马 路 上 王 宫 去 ， 便 在 那 里 被 杀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9847', '12', '11', '17', '耶 何 耶 大 使 王 和 民 与 耶 和 华 立 约 ， 作 耶 和 华 的 民 ； 又 使 王 与 民 立 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9848', '12', '11', '18', '於 是 国 民 都 到 巴 力 庙 ， 拆 毁 了 庙 ， 打 碎 坛 和 像 ， 又 在 坛 前 将 巴 力 的 祭 司 玛 坦 杀 了 。 祭 司 耶 何 耶 大 派 官 看 守 耶 和 华 的 殿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9849', '12', '11', '19', '又 率 领 百 夫 长 和 迦 利 人 ( 或 作 亲 兵 ) 与 护 卫 兵 ， 以 及 国 中 的 众 民 ， 请 王 从 耶 和 华 殿 下 来 ， 由 护 卫 兵 的 门 进 入 王 宫 ， 他 就 坐 了 王 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9850', '12', '11', '20', '国 民 都 欢 乐 ， 阖 城 都 安 静 。 众 人 已 将 亚 他 利 雅 在 王 宫 那 里 用 刀 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9851', '12', '11', '21', '约 阿 施 登 基 的 时 候 年 方 七 岁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9852', '12', '12', '1', '耶 户 第 七 年 ， 约 阿 施 登 基 ， 在 耶 路 撒 冷 作 王 四 十 年 。 他 母 亲 名 叫 西 比 亚 ， 是 别 是 巴 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9853', '12', '12', '2', '约 阿 施 在 祭 司 耶 何 耶 大 教 训 他 的 时 候 ， 就 行 耶 和 华 眼 中 看 为 正 的 事 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9854', '12', '12', '3', '只 是 邱 坛 还 没 有 废 去 ， 百 姓 仍 在 那 里 献 祭 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9855', '12', '12', '4', '约 阿 施 对 众 祭 司 说 ： 凡 奉 到 耶 和 华 殿 分 别 为 圣 之 物 所 值 通 用 的 银 子 ， 或 各 人 当 纳 的 身 价 ， 或 乐 意 奉 到 耶 和 华 殿 的 银 子 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9856', '12', '12', '5', '你 们 当 从 所 认 识 的 人 收 了 来 ， 修 理 殿 的 一 切 破 坏 之 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9857', '12', '12', '6', '无 奈 到 了 约 阿 施 王 二 十 三 年 ， 祭 司 仍 未 修 理 殿 的 破 坏 之 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9858', '12', '12', '7', '所 以 约 阿 施 王 召 了 大 祭 司 耶 何 耶 大 和 众 祭 司 来 ， 对 他 们 说 ： 你 们 怎 麽 不 修 理 殿 的 破 坏 之 处 呢 ？ 从 今 以 後 ， 你 们 不 要 从 所 认 识 的 人 再 收 银 子 ， 要 将 所 收 的 交 出 来 ， 修 理 殿 的 破 坏 之 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9859', '12', '12', '8', '众 祭 司 答 应 不 再 收 百 姓 的 银 子 ， 也 不 修 理 殿 的 破 坏 之 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9860', '12', '12', '9', '祭 司 耶 何 耶 大 取 了 一 个 柜 子 ， 在 柜 盖 上 钻 了 一 个 窟 窿 ， 放 於 坛 旁 ， 在 进 耶 和 华 殿 的 右 边 ； 守 门 的 祭 司 将 奉 到 耶 和 华 殿 的 一 切 银 子 投 在 柜 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9861', '12', '12', '10', '他 们 见 柜 里 的 银 子 多 了 ， 便 叫 王 的 书 记 和 大 祭 司 上 来 ， 将 耶 和 华 殿 里 的 银 子 数 算 包 起 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9862', '12', '12', '11', '把 所 平 的 银 子 交 给 督 工 的 ， 就 是 耶 和 华 殿 里 办 事 的 人 ； 他 们 把 银 子 转 交 修 理 耶 和 华 殿 的 木 匠 和 工 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9863', '12', '12', '12', '并 瓦 匠 、 石 匠 ， 又 买 木 料 和 凿 成 的 石 头 ， 修 理 耶 和 华 殿 的 破 坏 之 处 ， 以 及 修 理 殿 的 各 样 使 用 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9864', '12', '12', '13', '但 那 奉 到 耶 和 华 殿 的 银 子 ， 没 有 用 以 做 耶 和 华 殿 里 的 银 杯 、 蜡 剪 、 碗 、 号 ， 和 别 样 的 金 银 器 皿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9865', '12', '12', '14', '乃 将 那 银 子 交 给 督 工 的 人 修 理 耶 和 华 的 殿 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9866', '12', '12', '15', '且 将 银 子 交 给 办 事 的 人 转 交 做 工 的 人 ， 不 与 他 们 算 账 ， 因 为 他 们 办 事 诚 实 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9867', '12', '12', '16', '惟 有 赎 愆 祭 、 赎 罪 祭 的 银 子 没 有 奉 到 耶 和 华 的 殿 ， 都 归 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9868', '12', '12', '17', '那 时 ， 亚 兰 王 哈 薛 上 来 攻 打 迦 特 ， 攻 取 了 ， 就 定 意 上 来 攻 打 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9869', '12', '12', '18', '犹 大 王 约 阿 施 将 他 列 祖 犹 大 王 约 沙 法 、 约 兰 、 亚 哈 谢 所 分 别 为 圣 的 物 和 自 己 所 分 别 为 圣 的 物 ， 并 耶 和 华 殿 与 王 宫 府 库 里 所 有 的 金 子 都 送 给 亚 兰 王 哈 薛 ； 哈 薛 就 不 上 耶 路 撒 冷 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9870', '12', '12', '19', '约 阿 施 其 馀 的 事 ， 凡 他 所 行 的 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9871', '12', '12', '20', '约 阿 施 的 臣 仆 起 来 背 叛 ， 在 下 悉 拉 的 米 罗 宫 那 里 将 他 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9872', '12', '12', '21', '杀 他 的 那 臣 仆 就 是 示 米 押 的 儿 子 约 撒 甲 和 朔 默 的 儿 子 约 萨 拔 。 众 人 将 他 葬 在 大 卫 城 他 列 祖 的 坟 地 里 。 他 儿 子 亚 玛 谢 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9873', '12', '13', '1', '犹 大 王 亚 哈 谢 的 儿 子 约 阿 施 二 十 三 年 ， 耶 户 的 儿 子 约 哈 斯 在 撒 玛 利 亚 登 基 作 以 色 列 王 十 七 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9874', '12', '13', '2', '约 哈 斯 行 耶 和 华 眼 中 看 为 恶 的 事 ， 效 法 尼 八 的 儿 子 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 那 罪 ， 总 不 离 开 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9875', '12', '13', '3', '於 是 ， 耶 和 华 的 怒 气 向 以 色 列 人 发 作 ， 将 他 们 屡 次 交 在 亚 兰 王 哈 薛 和 他 儿 子 便 哈 达 的 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9876', '12', '13', '4', '约 哈 斯 恳 求 耶 和 华 ， 耶 和 华 就 应 允 他 ， 因 为 见 以 色 列 人 所 受 亚 兰 王 的 欺 压 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9877', '12', '13', '5', '耶 和 华 赐 给 以 色 列 人 一 位 拯 救 者 ， 使 他 们 脱 离 亚 兰 人 的 手 ； 於 是 以 色 列 人 仍 旧 安 居 在 家 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9878', '12', '13', '6', '然 而 他 们 不 离 开 耶 罗 波 安 家 使 以 色 列 人 陷 在 罪 里 的 那 罪 ， 仍 然 去 行 ， 并 且 在 撒 玛 利 亚 留 下 亚 舍 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9879', '12', '13', '7', '亚 兰 王 灭 绝 约 哈 斯 的 民 ， 践 踏 他 们 如 禾 场 上 的 尘 沙 ， 只 给 约 哈 斯 留 下 五 十 马 兵 ， 十 辆 战 车 ， 一 万 步 兵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9880', '12', '13', '8', '约 哈 斯 其 馀 的 事 ， 凡 他 所 行 的 和 他 的 勇 力 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9881', '12', '13', '9', '约 哈 斯 与 他 列 祖 同 睡 ， 葬 在 撒 玛 利 亚 。 他 儿 子 约 阿 施 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9882', '12', '13', '10', '犹 大 王 约 阿 施 三 十 七 年 ， 约 哈 斯 的 儿 子 约 阿 施 在 撒 玛 利 亚 登 基 作 以 色 列 王 十 六 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9883', '12', '13', '11', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 不 离 开 尼 八 的 儿 子 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 一 切 罪 ， 仍 然 去 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9884', '12', '13', '12', '约 阿 施 其 馀 的 事 ， 凡 他 所 行 的 和 他 与 犹 大 王 亚 玛 谢 争 战 的 勇 力 ， 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9885', '12', '13', '13', '约 阿 施 与 他 列 祖 同 睡 ， 耶 罗 波 安 坐 了 他 的 位 。 约 阿 施 与 以 色 列 诸 王 一 同 葬 在 撒 玛 利 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9886', '12', '13', '14', '以 利 沙 得 了 必 死 的 病 ， 以 色 列 王 约 阿 施 下 来 看 他 ， 伏 在 他 脸 上 哭 泣 ， 说 ： 我 父 啊 ！ 我 父 啊 ！ 以 色 列 的 战 车 马 兵 啊 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9887', '12', '13', '15', '以 利 沙 对 他 说 ： 你 取 弓 箭 来 。 王 就 取 了 弓 箭 来 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9888', '12', '13', '16', '又 对 以 色 列 王 说 ： 你 用 手 拿 弓 。 王 就 用 手 拿 弓 。 以 利 沙 按 手 在 王 的 手 上 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9889', '12', '13', '17', '说 ： 你 开 朝 东 的 窗 户 。 他 就 开 了 。 以 利 沙 说 ： 射 箭 罢 ！ 他 就 射 箭 。 以 利 沙 说 ： 这 是 耶 和 华 的 得 胜 箭 ， 就 是 战 胜 亚 兰 人 的 箭 ； 因 为 你 必 在 亚 弗 攻 打 亚 兰 人 ， 直 到 灭 尽 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9890', '12', '13', '18', '以 利 沙 又 说 ： 取 几 枝 箭 来 。 他 就 取 了 来 。 以 利 沙 说 ： 打 地 罢 ！ 他 打 了 三 次 ， 便 止 住 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9891', '12', '13', '19', '　 神 人 向 他 发 怒 ， 说 ： 应 当 击 打 五 六 次 ， 就 能 攻 打 亚 兰 人 直 到 灭 尽 ； 现 在 只 能 打 败 亚 兰 人 三 次 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9892', '12', '13', '20', '以 利 沙 死 了 ， 人 将 他 葬 埋 。 到 了 新 年 ， 有 一 群 摩 押 人 犯 境 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9893', '12', '13', '21', '有 人 正 葬 死 人 ， 忽 然 看 见 一 群 人 ， 就 把 死 人 抛 在 以 利 沙 的 坟 墓 里 ， 一 碰 着 以 利 沙 的 骸 骨 ， 死 人 就 复 活 ， 站 起 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9894', '12', '13', '22', '约 哈 斯 年 间 ， 亚 兰 王 哈 薛 屡 次 欺 压 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9895', '12', '13', '23', '耶 和 华 却 因 与 亚 伯 拉 罕 、 以 撒 、 雅 各 所 立 的 约 ， 仍 施 恩 给 以 色 列 人 ， 怜 恤 他 们 ， 眷 顾 他 们 ， 不 肯 灭 尽 他 们 ， 尚 未 赶 逐 他 们 离 开 自 己 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9896', '12', '13', '24', '亚 兰 王 哈 薛 死 了 ， 他 儿 子 便 哈 达 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9897', '12', '13', '25', '从 前 哈 薛 和 约 阿 施 的 父 亲 约 哈 斯 争 战 ， 攻 取 了 些 城 邑 ， 现 在 约 哈 斯 的 儿 子 约 阿 施 三 次 打 败 哈 薛 的 儿 子 便 哈 达 ， 就 收 回 了 以 色 列 的 城 邑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9898', '12', '14', '1', '以 色 列 王 约 哈 斯 的 儿 子 约 阿 施 第 二 年 ， 犹 大 王 约 阿 施 的 儿 子 亚 玛 谢 登 基 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9899', '12', '14', '2', '他 登 基 的 时 候 年 二 十 五 岁 ， 在 耶 路 撒 冷 作 王 二 十 九 年 。 他 母 亲 名 叫 约 耶 但 ， 是 耶 路 撒 冷 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9900', '12', '14', '3', '亚 玛 谢 行 耶 和 华 眼 中 看 为 正 的 事 ， 但 不 如 他 祖 大 卫 ， 乃 效 法 他 父 约 阿 施 一 切 所 行 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9901', '12', '14', '4', '只 是 邱 坛 还 没 有 废 去 ， 百 姓 仍 在 那 里 献 祭 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9902', '12', '14', '5', '国 一 坚 定 ， 就 把 杀 他 父 王 的 臣 仆 杀 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9903', '12', '14', '6', '却 没 有 治 死 杀 王 之 人 的 儿 子 ， 是 照 摩 西 律 法 书 上 耶 和 华 所 吩 咐 的 说 ： 不 可 因 子 杀 父 ， 也 不 可 因 父 杀 子 ， 各 人 要 为 本 身 的 罪 而 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9904', '12', '14', '7', '亚 玛 谢 在 盐 谷 杀 了 以 东 人 一 万 ， 又 攻 取 了 西 拉 ， 改 名 叫 约 帖 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9905', '12', '14', '8', '那 时 ， 亚 玛 谢 差 遣 使 者 去 见 耶 户 的 孙 子 约 哈 斯 的 儿 子 以 色 列 王 约 阿 施 ， 说 ： 你 来 ， 我 们 二 人 相 见 於 战 场 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9906', '12', '14', '9', '以 色 列 王 约 阿 施 差 遣 使 者 去 见 犹 大 王 亚 玛 谢 ， 说 ： 利 巴 嫩 的 蒺 藜 差 遣 使 者 去 见 利 巴 嫩 的 香 柏 树 ， 说 ： 将 你 的 女 儿 给 我 儿 子 为 妻 。 後 来 利 巴 嫩 有 一 个 野 兽 经 过 ， 把 蒺 藜 践 踏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9907', '12', '14', '10', '你 打 败 了 以 东 人 就 心 高 气 傲 ， 你 以 此 为 荣 耀 ， 在 家 里 安 居 就 罢 了 ， 为 何 要 惹 祸 ， 使 自 己 和 犹 大 国 一 同 败 亡 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9908', '12', '14', '11', '亚 玛 谢 却 不 肯 听 这 话 。 於 是 以 色 列 王 约 阿 施 上 来 ， 在 犹 大 的 伯 示 麦 与 犹 大 王 亚 玛 谢 相 见 於 战 场 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9909', '12', '14', '12', '犹 大 人 败 在 以 色 列 人 面 前 ， 各 自 逃 回 家 里 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9910', '12', '14', '13', '以 色 列 王 约 阿 施 在 伯 示 麦 擒 住 亚 哈 谢 的 孙 子 、 约 阿 施 的 儿 子 犹 大 王 亚 玛 谢 ， 就 来 到 耶 路 撒 冷 ， 拆 毁 耶 路 撒 冷 的 城 墙 ， 从 以 法 莲 门 直 到 角 门 共 四 百 肘 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9911', '12', '14', '14', '又 将 耶 和 华 殿 里 与 王 宫 府 库 里 所 有 的 金 银 和 器 皿 都 拿 了 去 ， 并 带 人 去 为 质 ， 就 回 撒 玛 利 亚 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9912', '12', '14', '15', '约 阿 施 其 馀 所 行 的 事 和 他 的 勇 力 ， 并 与 犹 大 王 亚 玛 谢 争 战 的 事 ， 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9913', '12', '14', '16', '约 阿 施 与 他 列 祖 同 睡 ， 葬 在 撒 玛 利 亚 ， 以 色 列 诸 王 的 坟 地 里 。 他 儿 子 耶 罗 波 安 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9914', '12', '14', '17', '以 色 列 王 约 哈 斯 的 儿 子 约 阿 施 死 後 ， 犹 大 王 约 阿 施 的 儿 子 亚 玛 谢 又 活 了 十 五 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9915', '12', '14', '18', '亚 玛 谢 其 馀 的 事 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9916', '12', '14', '19', '耶 路 撒 冷 有 人 背 叛 亚 玛 谢 ， 他 就 逃 到 拉 吉 ； 叛 党 却 打 发 人 到 拉 吉 将 他 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9917', '12', '14', '20', '人 就 用 马 将 他 的 尸 首 驮 到 耶 路 撒 冷 ， 葬 在 大 卫 城 他 列 祖 的 坟 地 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9918', '12', '14', '21', '犹 大 众 民 立 亚 玛 谢 的 儿 子 亚 撒 利 雅 ( 又 名 乌 西 雅 ) 接 续 他 父 作 王 ， 那 时 他 年 十 六 岁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9919', '12', '14', '22', '亚 玛 谢 与 他 列 祖 同 睡 之 後 ， 亚 撒 利 雅 收 回 以 拉 他 仍 归 犹 大 ， 又 重 新 修 理 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9920', '12', '14', '23', '犹 大 王 约 阿 施 的 儿 子 亚 玛 谢 十 五 年 ， 以 色 列 王 约 阿 施 的 儿 子 耶 罗 波 安 在 撒 玛 利 亚 登 基 ， 作 王 四 十 一 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9921', '12', '14', '24', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 不 离 开 尼 八 的 儿 子 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 一 切 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9922', '12', '14', '25', '他 收 回 以 色 列 边 界 之 地 ， 从 哈 马 口 直 到 亚 拉 巴 海 ， 正 如 耶 和 华 ─ 以 色 列 的 　 神 藉 他 仆 人 迦 特 希 弗 人 亚 米 太 的 儿 子 先 知 约 拿 所 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9923', '12', '14', '26', '因 为 耶 和 华 看 见 以 色 列 人 甚 是 艰 苦 ， 无 论 困 住 的 、 自 由 的 都 没 有 了 ， 也 无 人 帮 助 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9924', '12', '14', '27', '耶 和 华 并 没 有 说 要 将 以 色 列 的 名 从 天 下 涂 抹 ， 乃 藉 约 阿 施 的 儿 子 耶 罗 波 安 拯 救 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9925', '12', '14', '28', '耶 罗 波 安 其 馀 的 事 ， 凡 他 所 行 的 和 他 的 勇 力 ， 他 怎 样 争 战 ， 怎 样 收 回 大 马 色 和 先 前 属 犹 大 的 哈 马 归 以 色 列 ， 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9926', '12', '14', '29', '耶 罗 波 安 与 他 列 祖 以 色 列 诸 王 同 睡 。 他 儿 子 撒 迦 利 雅 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9927', '12', '15', '1', '以 色 列 王 耶 罗 波 安 二 十 七 年 ， 犹 大 王 亚 玛 谢 的 儿 子 亚 撒 利 雅 登 基 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9928', '12', '15', '2', '他 登 基 的 时 候 年 十 六 岁 ， 在 耶 路 撒 冷 作 王 五 十 二 年 。 他 母 亲 名 叫 耶 可 利 雅 ， 是 耶 路 撒 冷 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9929', '12', '15', '3', '亚 撒 利 雅 行 耶 和 华 眼 中 看 为 正 的 事 ， 效 法 他 父 亲 亚 玛 谢 一 切 所 行 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9930', '12', '15', '4', '只 是 邱 坛 还 没 有 废 去 ， 百 姓 仍 在 那 里 献 祭 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9931', '12', '15', '5', '耶 和 华 降 灾 与 王 ， 使 他 长 大 ? 疯 ， 直 到 死 日 ， 他 就 住 在 别 的 宫 里 。 他 的 儿 子 约 坦 管 理 家 事 ， 治 理 国 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9932', '12', '15', '6', '亚 撒 利 雅 其 馀 的 事 ， 凡 他 所 行 的 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9933', '12', '15', '7', '亚 撒 利 雅 与 他 列 祖 同 睡 ， 葬 在 大 卫 城 他 列 祖 的 坟 地 里 。 他 儿 子 约 坦 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9934', '12', '15', '8', '犹 大 王 亚 撒 利 雅 三 十 八 年 ， 耶 罗 波 安 的 儿 子 撒 迦 利 雅 在 撒 玛 利 亚 作 以 色 列 王 六 个 月 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9935', '12', '15', '9', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 效 法 他 列 祖 所 行 的 ， 不 离 开 尼 八 的 儿 子 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 那 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9936', '12', '15', '10', '雅 比 的 儿 子 沙 龙 背 叛 他 ， 在 百 姓 面 前 击 杀 他 ， 篡 了 他 的 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9937', '12', '15', '11', '撒 迦 利 雅 其 馀 的 事 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9938', '12', '15', '12', '这 是 从 前 耶 和 华 应 许 耶 户 说 ： 你 的 子 孙 必 坐 以 色 列 的 国 位 直 到 四 代 。 这 话 果 然 应 验 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9939', '12', '15', '13', '犹 大 王 乌 西 雅 ( 就 是 亚 撒 利 雅 ) 三 十 九 年 ， 雅 比 的 儿 子 沙 龙 登 基 在 撒 玛 利 亚 作 王 一 个 月 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9940', '12', '15', '14', '迦 底 的 儿 子 米 拿 现 从 得 撒 上 撒 玛 利 亚 ， 杀 了 雅 比 的 儿 子 沙 龙 ， 篡 了 他 的 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9941', '12', '15', '15', '沙 龙 其 馀 的 事 和 他 背 叛 的 情 形 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9942', '12', '15', '16', '那 时 米 拿 现 从 得 撒 起 攻 打 提 斐 萨 和 其 四 境 ， 击 杀 城 中 一 切 的 人 ， 剖 开 其 中 所 有 的 孕 妇 ， 都 因 他 们 没 有 给 他 开 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9943', '12', '15', '17', '犹 大 王 亚 撒 利 雅 三 十 九 年 ， 迦 底 的 儿 子 米 拿 现 登 基 ， 在 撒 玛 利 亚 作 以 色 列 王 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9944', '12', '15', '18', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 终 身 不 离 开 尼 八 的 儿 子 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 那 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9945', '12', '15', '19', '亚 述 王 普 勒 来 攻 击 以 色 列 国 ， 米 拿 现 给 他 一 千 他 连 得 银 子 ， 请 普 勒 帮 助 他 坚 定 国 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9946', '12', '15', '20', '米 拿 现 向 以 色 列 一 切 大 富 户 索 要 银 子 ， 使 他 们 各 出 五 十 舍 客 勒 ， 就 给 了 亚 述 王 。 於 是 亚 述 王 回 去 ， 不 在 国 中 停 留 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9947', '12', '15', '21', '米 拿 现 其 馀 的 事 ， 凡 他 所 行 的 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9948', '12', '15', '22', '米 拿 现 与 他 列 祖 同 睡 。 他 儿 子 比 加 辖 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9949', '12', '15', '23', '犹 大 王 亚 撒 利 雅 五 十 年 ， 米 拿 现 的 儿 子 比 加 辖 在 撒 玛 利 亚 登 基 作 以 色 列 王 二 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9950', '12', '15', '24', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 不 离 开 尼 八 的 儿 子 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 那 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9951', '12', '15', '25', '比 加 辖 的 将 军 、 利 玛 利 的 儿 子 比 加 背 叛 他 ， 在 撒 玛 利 亚 王 宫 里 的 卫 所 杀 了 他 。 亚 珥 歌 伯 和 亚 利 耶 并 基 列 的 五 十 人 帮 助 比 加 ； 比 加 击 杀 他 ， 篡 了 他 的 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9952', '12', '15', '26', '比 加 辖 其 馀 的 事 ， 凡 他 所 行 的 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9953', '12', '15', '27', '犹 大 王 亚 撒 利 雅 五 十 二 年 ， 利 玛 利 的 儿 子 比 加 在 撒 玛 利 亚 登 基 作 以 色 列 王 二 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9954', '12', '15', '28', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 不 离 开 尼 八 的 儿 子 耶 罗 波 安 使 以 色 列 人 陷 在 罪 里 的 那 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9955', '12', '15', '29', '以 色 列 王 比 加 年 间 ， 亚 述 王 提 革 拉 毗 列 色 来 夺 了 以 云 、 亚 伯 伯 玛 迦 、 亚 挪 、 基 低 斯 、 夏 琐 、 基 列 、 加 利 利 ， 和 拿 弗 他 利 全 地 ， 将 这 些 地 方 的 居 民 都 掳 到 亚 述 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9956', '12', '15', '30', '乌 西 雅 的 儿 子 约 坦 二 十 年 ， 以 拉 的 儿 子 何 细 亚 背 叛 利 玛 利 的 儿 子 比 加 ， 击 杀 他 ， 篡 了 他 的 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9957', '12', '15', '31', '比 加 其 馀 的 事 ， 凡 他 所 行 的 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9958', '12', '15', '32', '以 色 列 王 利 玛 利 的 儿 子 比 加 第 二 年 ， 犹 大 王 乌 西 雅 的 儿 子 约 坦 登 基 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9959', '12', '15', '33', '他 登 基 的 时 候 年 二 十 五 岁 ， 在 耶 路 撒 冷 作 王 十 六 年 。 他 母 亲 名 叫 耶 路 沙 ， 是 撒 督 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9960', '12', '15', '34', '约 坦 行 耶 和 华 眼 中 看 为 正 的 事 ， 效 法 他 父 亲 乌 西 雅 一 切 所 行 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9961', '12', '15', '35', '只 是 邱 坛 还 没 有 废 去 ， 百 姓 仍 在 那 里 献 祭 烧 香 。 约 坦 建 立 耶 和 华 殿 的 上 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9962', '12', '15', '36', '约 坦 其 馀 的 事 ， 凡 他 所 行 的 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9963', '12', '15', '37', '在 那 些 日 子 ， 耶 和 华 才 使 亚 兰 王 利 汛 和 利 玛 利 的 儿 子 比 加 去 攻 击 犹 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9964', '12', '15', '38', '约 坦 与 他 列 祖 同 睡 ， 葬 在 他 祖 大 卫 城 他 列 祖 的 坟 地 里 。 他 儿 子 亚 哈 斯 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9965', '12', '16', '1', '利 玛 利 的 儿 子 比 加 十 七 年 ， 犹 大 王 约 坦 的 儿 子 亚 哈 斯 登 基 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9966', '12', '16', '2', '他 登 基 的 时 候 年 二 十 岁 ， 在 耶 路 撒 冷 作 王 十 六 年 ； 不 像 他 祖 大 卫 行 耶 和 华 ─ 他 　 神 眼 中 看 为 正 的 事 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9967', '12', '16', '3', '却 效 法 以 色 列 诸 王 所 行 的 ， 又 照 着 耶 和 华 从 以 色 列 人 面 前 赶 出 的 外 邦 人 所 行 可 憎 的 事 ， 使 他 的 儿 子 经 火 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9968', '12', '16', '4', '并 在 邱 坛 上 、 山 冈 上 、 各 青 翠 树 下 献 祭 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9969', '12', '16', '5', '亚 兰 王 利 汛 和 以 色 列 王 利 玛 利 的 儿 子 比 加 上 来 攻 打 耶 路 撒 冷 ， 围 困 亚 哈 斯 ， 却 不 能 胜 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9970', '12', '16', '6', '当 时 亚 兰 王 利 汛 收 回 以 拉 他 归 与 亚 兰 ， 将 犹 大 人 从 以 拉 他 赶 出 去 。 亚 兰 人 ( 有 作 以 东 人 的 ) 就 来 到 以 拉 他 ， 住 在 那 里 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9971', '12', '16', '7', '亚 哈 斯 差 遣 使 者 去 见 亚 述 王 提 革 拉 毗 列 色 ， 说 ： 我 是 你 的 仆 人 、 你 的 儿 子 。 现 在 亚 兰 王 和 以 色 列 王 攻 击 我 ， 求 你 来 救 我 脱 离 他 们 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9972', '12', '16', '8', '亚 哈 斯 将 耶 和 华 殿 里 和 王 宫 府 库 里 所 有 的 金 银 都 送 给 亚 述 王 为 礼 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9973', '12', '16', '9', '亚 述 王 应 允 了 他 ， 就 上 去 攻 打 大 马 色 ， 将 城 攻 取 ， 杀 了 利 汛 ， 把 居 民 掳 到 吉 珥 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9974', '12', '16', '10', '亚 哈 斯 王 上 大 马 色 去 迎 接 亚 述 王 提 革 拉 毗 列 色 ， 在 大 马 色 看 见 一 座 坛 ， 就 照 坛 的 规 模 样 式 作 法 画 了 图 样 ， 送 到 祭 司 乌 利 亚 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9975', '12', '16', '11', '祭 司 乌 利 亚 照 着 亚 哈 斯 王 从 大 马 色 送 来 的 图 样 ， 在 亚 哈 斯 王 没 有 从 大 马 色 回 来 之 先 ， 建 筑 一 座 坛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9976', '12', '16', '12', '王 从 大 马 色 回 来 看 见 坛 ， 就 近 前 来 ， 在 坛 上 献 祭 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9977', '12', '16', '13', '烧 燔 祭 、 素 祭 、 浇 奠 祭 ， 将 平 安 祭 牲 的 血 ? 在 坛 上 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9978', '12', '16', '14', '又 将 耶 和 华 面 前 的 铜 坛 从 耶 和 华 殿 和 新 坛 的 中 间 搬 到 新 坛 的 北 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9979', '12', '16', '15', '亚 哈 斯 王 吩 咐 祭 司 乌 利 亚 说 ： 早 晨 的 燔 祭 、 晚 上 的 素 祭 ， 王 的 燔 祭 、 素 祭 ， 国 内 众 民 的 燔 祭 、 素 祭 、 奠 祭 都 要 烧 在 大 坛 上 。 燔 祭 牲 和 平 安 祭 牲 的 血 也 要 ? 在 这 坛 上 ， 只 是 铜 坛 我 要 用 以 求 问 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9980', '12', '16', '16', '祭 司 乌 利 亚 就 照 着 亚 哈 斯 王 所 吩 咐 的 行 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9981', '12', '16', '17', '亚 哈 斯 王 打 掉 盆 座 四 面 镶 着 的 心 子 ， 把 盆 从 座 上 挪 下 来 ， 又 将 铜 海 从 驮 海 的 铜 牛 上 搬 下 来 ， 放 在 铺 石 地 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9982', '12', '16', '18', '又 因 亚 述 王 的 缘 故 ， 将 耶 和 华 殿 为 安 息 日 所 盖 的 廊 子 和 王 从 外 入 殿 的 廊 子 挪 移 ， 围 绕 耶 和 华 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9983', '12', '16', '19', '亚 哈 斯 其 馀 所 行 的 事 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9984', '12', '16', '20', '亚 哈 斯 与 他 列 祖 同 睡 ， 葬 在 大 卫 城 他 列 祖 的 坟 地 里 。 他 儿 子 希 西 家 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9985', '12', '17', '1', '犹 大 王 亚 哈 斯 十 二 年 ， 以 拉 的 儿 子 何 细 亚 在 撒 玛 利 亚 登 基 作 以 色 列 王 九 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9986', '12', '17', '2', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 只 是 不 像 在 他 以 前 的 以 色 列 诸 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9987', '12', '17', '3', '亚 述 王 撒 缦 以 色 上 来 攻 击 何 细 亚 ， 何 细 亚 就 服 事 他 ， 给 他 进 贡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9988', '12', '17', '4', '何 细 亚 背 叛 ， 差 人 去 见 埃 及 王 梭 ， 不 照 往 年 所 行 的 与 亚 述 王 进 贡 。 亚 述 王 知 道 了 ， 就 把 他 锁 禁 ， 囚 在 监 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9989', '12', '17', '5', '亚 述 王 上 来 攻 击 以 色 列 遍 地 ， 上 到 撒 玛 利 亚 ， 围 困 三 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9990', '12', '17', '6', '何 细 亚 第 九 年 亚 述 王 攻 取 了 撒 玛 利 亚 ， 将 以 色 列 人 掳 到 亚 述 ， 把 他 们 安 置 在 哈 腊 与 歌 散 的 哈 博 河 边 ， 并 玛 代 人 的 城 邑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9991', '12', '17', '7', '这 是 因 以 色 列 人 得 罪 那 领 他 们 出 埃 及 地 、 脱 离 埃 及 王 法 老 手 的 耶 和 华 ─ 他 们 的 　 神 ， 去 敬 畏 别 　 神 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9992', '12', '17', '8', '随 从 耶 和 华 在 他 们 面 前 所 赶 出 外 邦 人 的 风 俗 和 以 色 列 诸 王 所 立 的 条 规 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9993', '12', '17', '9', '以 色 列 人 暗 中 行 不 正 的 事 ， 违 背 耶 和 华 ─ 他 们 的 　 神 ， 在 他 们 所 有 的 城 邑 ， 从 了 望 楼 直 到 坚 固 城 ， 建 筑 邱 坛 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9994', '12', '17', '10', '在 各 高 冈 上 、 各 青 翠 树 下 立 柱 像 和 木 偶 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9995', '12', '17', '11', '在 邱 坛 上 烧 香 ， 效 法 耶 和 华 在 他 们 面 前 赶 出 的 外 邦 人 所 行 的 ， 又 行 恶 事 惹 动 耶 和 华 的 怒 气 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9996', '12', '17', '12', '且 事 奉 偶 像 ， 就 是 耶 和 华 警 戒 他 们 不 可 行 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9997', '12', '17', '13', '但 耶 和 华 藉 众 先 知 、 先 见 劝 戒 以 色 列 人 和 犹 大 人 说 ： 当 离 开 你 们 的 恶 行 ， 谨 守 我 的 诫 命 律 例 ， 遵 行 我 吩 咐 你 们 列 祖 ， 并 藉 我 仆 人 众 先 知 所 传 给 你 们 的 律 法 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9998', '12', '17', '14', '他 们 却 不 听 从 ， 竟 硬 着 颈 项 ， 效 法 他 们 列 祖 ， 不 信 服 耶 和 华 ─ 他 们 的 　 神 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('9999', '12', '17', '15', '厌 弃 他 的 律 例 和 他 与 他 们 列 祖 所 立 的 约 ， 并 劝 戒 他 们 的 话 ， 随 从 虚 无 的 　 神 ， 自 己 成 为 虚 妄 ， 效 法 周 围 的 外 邦 人 ， 就 是 耶 和 华 嘱 咐 他 们 不 可 效 法 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10000', '12', '17', '16', '离 弃 耶 和 华 ─ 他 们 　 神 的 一 切 诫 命 ， 为 自 己 铸 了 两 个 牛 犊 的 像 ， 立 了 亚 舍 拉 ， 敬 拜 天 上 的 万 象 ， 事 奉 巴 力 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10001', '12', '17', '17', '又 使 他 们 的 儿 女 经 火 ， 用 占 卜 ， 行 法 术 卖 了 自 己 ， 行 耶 和 华 眼 中 看 为 恶 的 事 ， 惹 动 他 的 怒 气 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10002', '12', '17', '18', '所 以 耶 和 华 向 以 色 列 人 大 大 发 怒 ， 从 自 己 面 前 赶 出 他 们 ， 只 剩 下 犹 大 一 个 支 派 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10003', '12', '17', '19', '犹 大 人 也 不 遵 守 耶 和 华 ─ 他 们 　 神 的 诫 命 ， 随 从 以 色 列 人 所 立 的 条 规 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10004', '12', '17', '20', '耶 和 华 就 厌 弃 以 色 列 全 族 ， 使 他 们 受 苦 ， 把 他 们 交 在 抢 夺 他 们 的 人 手 中 ， 以 致 赶 出 他 们 离 开 自 己 面 前 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10005', '12', '17', '21', '将 以 色 列 国 从 大 卫 家 夺 回 ； 他 们 就 立 尼 八 的 儿 子 耶 罗 波 安 作 王 。 耶 罗 波 安 引 诱 以 色 列 人 不 随 从 耶 和 华 ， 陷 在 大 罪 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10006', '12', '17', '22', '以 色 列 人 犯 耶 罗 波 安 所 犯 的 一 切 罪 ， 总 不 离 开 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10007', '12', '17', '23', '以 致 耶 和 华 从 自 己 面 前 赶 出 他 们 ， 正 如 藉 他 仆 人 众 先 知 所 说 的 。 这 样 ， 以 色 列 人 从 本 地 被 掳 到 亚 述 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10008', '12', '17', '24', '亚 述 王 从 巴 比 伦 、 古 他 、 亚 瓦 、 哈 马 ， 和 西 法 瓦 音 迁 移 人 来 ， 安 置 在 撒 玛 利 亚 的 城 邑 ， 代 替 以 色 列 人 ； 他 们 就 得 了 撒 玛 利 亚 ， 住 在 其 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10009', '12', '17', '25', '他 们 才 住 那 里 的 时 候 ， 不 敬 畏 耶 和 华 ， 所 以 耶 和 华 叫 狮 子 进 入 他 们 中 间 ， 咬 死 了 些 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10010', '12', '17', '26', '有 人 告 诉 亚 述 王 说 ： 你 所 迁 移 安 置 在 撒 玛 利 亚 各 城 的 那 些 民 ， 不 知 道 那 地 之 　 神 的 规 矩 ， 所 以 那 　 神 叫 狮 子 进 入 他 们 中 间 ， 咬 死 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10011', '12', '17', '27', '亚 述 王 就 吩 咐 说 ： 叫 所 掳 来 的 祭 司 回 去 一 个 ， 使 他 住 在 那 里 ， 将 那 地 之 　 神 的 规 矩 指 教 那 些 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10012', '12', '17', '28', '於 是 有 一 个 从 撒 玛 利 亚 掳 去 的 祭 司 回 来 ， 住 在 伯 特 利 ， 指 教 他 们 怎 样 敬 畏 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10013', '12', '17', '29', '然 而 ， 各 族 之 人 在 所 住 的 城 里 各 为 自 己 制 造 　 神 像 ， 安 置 在 撒 玛 利 亚 人 所 造 有 邱 坛 的 殿 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10014', '12', '17', '30', '巴 比 伦 人 造 疏 割 ． 比 讷 像 ； 古 他 人 造 匿 甲 像 ； 哈 马 人 造 亚 示 玛 像 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10015', '12', '17', '31', '亚 瓦 人 造 匿 哈 和 他 珥 他 像 ； 西 法 瓦 音 人 用 火 焚 烧 儿 女 ， 献 给 西 法 瓦 音 的 　 神 亚 得 米 勒 和 亚 拿 米 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10016', '12', '17', '32', '他 们 惧 怕 耶 和 华 ， 也 从 他 们 中 间 立 邱 坛 的 祭 司 ， 为 他 们 在 有 邱 坛 的 殿 中 献 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10017', '12', '17', '33', '他 们 又 惧 怕 耶 和 华 ， 又 事 奉 自 己 的 　 神 ， 从 何 邦 迁 移 ， 就 随 何 邦 的 风 俗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10018', '12', '17', '34', '他 们 直 到 如 今 仍 照 先 前 的 风 俗 去 行 ， 不 专 心 敬 畏 耶 和 华 ， 不 全 守 自 己 的 规 矩 、 典 章 ， 也 不 遵 守 耶 和 华 吩 咐 雅 各 後 裔 的 律 法 、 诫 命 。 〈 雅 各 ， 就 是 从 前 耶 和 华 起 名 叫 以 色 列 的 。 〉');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10019', '12', '17', '35', '耶 和 华 曾 与 他 们 立 约 ， 嘱 咐 他 们 说 ： 不 可 敬 畏 别 　 神 ， 不 可 跪 拜 事 奉 他 ， 也 不 可 向 他 献 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10020', '12', '17', '36', '但 那 用 大 能 和 伸 出 来 的 膀 臂 领 你 们 出 埃 及 地 的 耶 和 华 ， 你 们 当 敬 畏 ， 跪 拜 ， 向 他 献 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10021', '12', '17', '37', '他 给 你 们 写 的 律 例 、 典 章 、 律 法 、 诫 命 ， 你 们 应 当 永 远 谨 守 遵 行 ， 不 可 敬 畏 别 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10022', '12', '17', '38', '我 ─ 耶 和 华 与 你 们 所 立 的 约 你 们 不 可 忘 记 ， 也 不 可 敬 畏 别 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10023', '12', '17', '39', '但 要 敬 畏 耶 和 华 ─ 你 们 的 　 神 ， 他 必 救 你 们 脱 离 一 切 仇 敌 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10024', '12', '17', '40', '他 们 却 不 听 从 ， 仍 照 先 前 的 风 俗 去 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10025', '12', '17', '41', '如 此 这 些 民 又 惧 怕 耶 和 华 ， 又 事 奉 他 们 的 偶 像 。 他 们 子 子 孙 孙 也 都 照 样 行 ， 效 法 他 们 的 祖 宗 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10026', '12', '18', '1', '以 色 列 王 以 拉 的 儿 子 何 细 亚 第 三 年 ， 犹 大 王 亚 哈 斯 的 儿 子 希 西 家 登 基 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10027', '12', '18', '2', '他 登 基 的 时 候 年 二 十 五 岁 ， 在 耶 路 撒 冷 作 王 二 十 九 年 。 他 母 亲 名 叫 亚 比 ， 是 撒 迦 利 雅 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10028', '12', '18', '3', '希 西 家 行 耶 和 华 眼 中 看 为 正 的 事 ， 效 法 他 祖 大 卫 一 切 所 行 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10029', '12', '18', '4', '他 废 去 邱 坛 ， 毁 坏 柱 像 ， 砍 下 木 偶 ， 打 碎 摩 西 所 造 的 铜 蛇 ， 因 为 到 那 时 以 色 列 人 仍 向 铜 蛇 烧 香 。 希 西 家 叫 铜 蛇 为 铜 块 ( 或 作 人 称 铜 蛇 为 铜 像 ) 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10030', '12', '18', '5', '希 西 家 倚 靠 耶 和 华 ─ 以 色 列 的 　 神 ， 在 他 前 後 的 犹 大 列 王 中 没 有 一 个 及 他 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10031', '12', '18', '6', '因 为 他 专 靠 耶 和 华 ， 总 不 离 开 ， 谨 守 耶 和 华 所 吩 咐 摩 西 的 诫 命 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10032', '12', '18', '7', '耶 和 华 与 他 同 在 ， 他 无 论 往 何 处 去 尽 都 亨 通 。 他 背 叛 、 不 肯 事 奉 亚 述 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10033', '12', '18', '8', '希 西 家 攻 击 非 利 士 人 ， 直 到 迦 萨 ， 并 迦 萨 的 四 境 ， 从 了 望 楼 到 坚 固 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10034', '12', '18', '9', '希 西 家 王 第 四 年 ， 就 是 以 色 列 王 以 拉 的 儿 子 何 细 亚 第 七 年 ， 亚 述 王 撒 缦 以 色 上 来 围 困 撒 玛 利 亚 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10035', '12', '18', '10', '过 了 三 年 就 攻 取 了 城 。 希 西 家 第 六 年 ， 以 色 列 王 何 细 亚 第 九 年 ， 撒 玛 利 亚 被 攻 取 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10036', '12', '18', '11', '亚 述 王 将 以 色 列 人 掳 到 亚 述 ， 把 他 们 安 置 在 哈 腊 与 歌 散 的 哈 博 河 边 ， 并 玛 代 人 的 城 邑 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10037', '12', '18', '12', '都 因 他 们 不 听 从 耶 和 华 ─ 他 们 　 神 的 话 ， 违 背 他 的 约 ， 就 是 耶 和 华 仆 人 摩 西 吩 咐 他 们 所 当 守 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10038', '12', '18', '13', '希 西 家 王 十 四 年 ， 亚 述 王 西 拿 基 立 上 来 攻 击 犹 大 的 一 切 坚 固 城 ， 将 城 攻 取 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10039', '12', '18', '14', '犹 大 王 希 西 家 差 人 往 拉 吉 去 见 亚 述 王 ， 说 ： 我 有 罪 了 ， 求 你 离 开 我 ； 凡 你 罚 我 的 ， 我 必 承 当 。 於 是 亚 述 王 罚 犹 大 王 希 西 家 银 子 三 百 他 连 得 ， 金 子 三 十 他 连 得 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10040', '12', '18', '15', '希 西 家 就 把 耶 和 华 殿 里 和 王 宫 府 库 里 所 有 的 银 子 都 给 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10041', '12', '18', '16', '那 时 ， 犹 大 王 希 西 家 将 耶 和 华 殿 门 上 的 金 子 和 他 自 己 包 在 柱 上 的 金 子 都 刮 下 来 ， 给 了 亚 述 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10042', '12', '18', '17', '亚 述 王 从 拉 吉 差 遣 他 珥 探 、 拉 伯 撒 利 ， 和 拉 伯 沙 基 率 领 大 军 往 耶 路 撒 冷 ， 到 希 西 家 王 那 里 去 。 他 们 上 到 耶 路 撒 冷 ， 就 站 在 上 池 的 水 沟 旁 ， 在 漂 布 地 的 大 路 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10043', '12', '18', '18', '他 们 呼 叫 王 的 时 候 ， 就 有 希 勒 家 的 儿 子 家 宰 以 利 亚 敬 ， 并 书 记 舍 伯 那 和 亚 萨 的 儿 子 史 官 约 亚 ， 出 来 见 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10044', '12', '18', '19', '拉 伯 沙 基 说 ： 你 们 去 告 诉 希 西 家 说 ， 亚 述 大 王 如 此 说 ： 你 所 倚 靠 的 有 甚 麽 可 仗 赖 的 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10045', '12', '18', '20', '你 说 有 打 仗 的 计 谋 和 能 力 ， 我 看 不 过 是 虚 话 。 你 到 底 倚 靠 谁 才 背 叛 我 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10046', '12', '18', '21', '看 哪 ， 你 所 倚 靠 的 埃 及 是 那 压 伤 的 苇 杖 ； 人 若 靠 这 杖 ， 就 必 刺 透 他 的 手 。 埃 及 王 法 老 向 一 切 倚 靠 他 的 人 也 是 这 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10047', '12', '18', '22', '你 们 若 对 我 说 ： 我 们 倚 靠 耶 和 华 ─ 我 们 的 　 神 ， 希 西 家 岂 不 是 将 　 神 的 邱 坛 和 祭 坛 废 去 ， 且 对 犹 大 和 耶 路 撒 冷 的 人 说 ： 你 们 当 在 耶 路 撒 冷 这 坛 前 敬 拜 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10048', '12', '18', '23', '现 在 你 把 当 头 给 我 主 亚 述 王 ， 我 给 你 二 千 匹 马 ， 看 你 这 一 面 骑 马 的 人 够 不 够 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10049', '12', '18', '24', '若 不 然 ， 怎 能 打 败 我 主 臣 仆 中 最 小 的 军 长 呢 ？ 你 竟 倚 靠 埃 及 的 战 车 马 兵 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10050', '12', '18', '25', '现 在 我 上 来 攻 击 毁 灭 这 地 ， 岂 没 有 耶 和 华 的 意 思 麽 ？ 耶 和 华 吩 咐 我 说 ： 你 上 去 攻 击 毁 灭 这 地 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10051', '12', '18', '26', '希 勒 家 的 儿 子 以 利 亚 敬 和 舍 伯 那 ， 并 约 亚 ， 对 拉 伯 沙 基 说 ： 求 你 用 亚 兰 言 语 和 仆 人 说 话 ， 因 为 我 们 懂 得 ； 不 要 用 犹 大 言 语 和 我 们 说 话 ， 达 到 城 上 百 姓 的 耳 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10052', '12', '18', '27', '拉 伯 沙 基 说 ： 我 主 差 遣 我 来 ， 岂 是 单 对 你 和 你 的 主 说 这 些 话 麽 ？ 不 也 是 对 这 些 坐 在 城 上 、 要 与 你 们 一 同 吃 自 己 粪 、 喝 自 己 尿 的 人 说 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10053', '12', '18', '28', '於 是 拉 伯 沙 基 站 着 ， 用 犹 大 言 语 大 声 喊 着 说 ： 你 们 当 听 亚 述 大 王 的 话 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10054', '12', '18', '29', '王 如 此 说 ： 你 们 不 要 被 希 西 家 欺 哄 了 ； 因 他 不 能 救 你 们 脱 离 我 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10055', '12', '18', '30', '也 不 要 听 希 西 家 使 你 们 倚 靠 耶 和 华 ， 说 耶 和 华 必 要 拯 救 我 们 ， 这 城 必 不 交 在 亚 述 王 的 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10056', '12', '18', '31', '不 要 听 希 西 家 的 话 ！ 因 亚 述 王 如 此 说 ： 你 们 要 与 我 和 好 ， 出 来 投 降 我 ， 各 人 就 可 以 吃 自 己 葡 萄 树 和 无 花 果 树 的 果 子 ， 喝 自 己 井 里 的 水 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10057', '12', '18', '32', '等 我 来 领 你 们 到 一 个 地 方 与 你 们 本 地 一 样 ， 就 是 有 五 谷 和 新 酒 之 地 ， 有 粮 食 和 葡 萄 园 之 地 ， 有 橄 榄 树 和 蜂 蜜 之 地 ， 好 使 你 们 存 活 ， 不 至 於 死 。 希 西 家 劝 导 你 们 ， 说 耶 和 华 必 拯 救 我 们 ； 你 们 不 要 听 他 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10058', '12', '18', '33', '列 国 的 　 神 有 哪 一 个 救 他 本 国 脱 离 亚 述 王 的 手 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10059', '12', '18', '34', '哈 马 、 亚 珥 拔 的 　 神 在 哪 里 呢 ？ 西 法 瓦 音 、 希 拿 、 以 瓦 的 　 神 在 哪 里 呢 ？ 他 们 曾 救 撒 玛 利 亚 脱 离 我 的 手 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10060', '12', '18', '35', '这 些 国 的 　 神 有 谁 曾 救 自 己 的 国 脱 离 我 的 手 呢 ？ 难 道 耶 和 华 能 救 耶 路 撒 冷 脱 离 我 的 手 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10061', '12', '18', '36', '百 姓 静 默 不 言 ， 并 不 回 答 一 句 ， 因 为 王 曾 吩 咐 说 ： 不 要 回 答 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10062', '12', '18', '37', '当 下 ， 希 勒 家 的 儿 子 家 宰 以 利 亚 敬 和 书 记 舍 伯 那 ， 并 亚 萨 的 儿 子 史 官 约 亚 ， 都 撕 裂 衣 服 ， 来 到 希 西 家 那 里 ， 将 拉 伯 沙 基 的 话 告 诉 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10063', '12', '19', '1', '希 西 家 王 听 见 ， 就 撕 裂 衣 服 ， 披 上 麻 布 ， 进 了 耶 和 华 的 殿 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10064', '12', '19', '2', '使 家 宰 以 利 亚 敬 和 书 记 舍 伯 那 ， 并 祭 司 中 的 长 老 ， 都 披 上 麻 布 ， 去 见 亚 摩 斯 的 儿 子 先 知 以 赛 亚 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10065', '12', '19', '3', '对 他 说 ： 希 西 家 如 此 说 ： 今 日 是 急 难 、 责 罚 、 凌 辱 的 日 子 ， 就 如 妇 人 将 要 生 产 婴 孩 ， 却 没 有 力 量 生 产 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10066', '12', '19', '4', '或 者 耶 和 华 ─ 你 的 　 神 听 见 拉 伯 沙 基 的 一 切 话 ， 就 是 他 主 人 亚 述 王 打 发 他 来 辱 骂 永 生 　 神 的 话 ， 耶 和 华 ─ 你 的 　 神 听 见 这 话 ， 就 发 斥 责 。 故 此 ， 求 你 为 馀 剩 的 民 扬 声 祷 告 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10067', '12', '19', '5', '希 西 家 王 的 臣 仆 就 去 见 以 赛 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10068', '12', '19', '6', '以 赛 亚 对 他 们 说 ： 要 这 样 对 你 们 的 主 人 说 ， 耶 和 华 如 此 说 ： 你 听 见 亚 述 王 的 仆 人 亵 渎 我 的 话 ， 不 要 惧 怕 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10069', '12', '19', '7', '我 必 惊 动 ( 原 文 作 使 灵 进 入 ) 他 的 心 ， 他 要 听 见 风 声 就 归 回 本 地 。 我 必 使 他 在 那 里 倒 在 刀 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10070', '12', '19', '8', '拉 伯 沙 基 回 去 ， 正 遇 见 亚 述 王 攻 打 立 拿 ， 原 来 他 早 听 见 亚 述 王 拔 营 离 开 拉 吉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10071', '12', '19', '9', '亚 述 王 听 见 人 论 古 实 王 特 哈 加 说 ： 他 出 来 要 与 你 争 战 。 於 是 亚 述 王 又 打 发 使 者 去 见 希 西 家 ， 吩 咐 他 们 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10072', '12', '19', '10', '你 们 对 犹 大 王 希 西 家 如 此 说 ： 不 要 听 你 所 倚 靠 的 　 神 欺 哄 你 ， 说 耶 路 撒 冷 必 不 交 在 亚 述 王 的 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10073', '12', '19', '11', '你 总 听 说 亚 述 诸 王 向 列 国 所 行 的 ， 乃 是 尽 行 灭 绝 ， 难 道 你 还 能 得 救 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10074', '12', '19', '12', '我 列 祖 所 毁 灭 的 ， 就 是 歌 散 、 哈 兰 、 利 色 ， 和 属 提 ． 拉 撒 的 伊 甸 人 ， 这 些 国 的 　 神 何 曾 拯 救 这 些 国 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10075', '12', '19', '13', '哈 马 的 王 、 亚 珥 拔 的 王 、 西 法 瓦 音 城 的 王 、 希 拿 ， 和 以 瓦 的 王 都 在 哪 里 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10076', '12', '19', '14', '希 西 家 从 使 者 手 里 接 过 书 信 来 ， 看 完 了 ， 就 上 耶 和 华 的 殿 ， 将 书 信 在 耶 和 华 面 前 展 开 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10077', '12', '19', '15', '希 西 家 向 耶 和 华 祷 告 说 ： 坐 在 二 基 路 伯 上 耶 和 华 ─ 以 色 列 的 　 神 啊 ， 你 是 天 下 万 国 的 　 神 ， 你 曾 创 造 天 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10078', '12', '19', '16', '耶 和 华 啊 ， 求 你 侧 耳 而 听 ！ 耶 和 华 啊 ， 求 你 睁 眼 而 看 ！ 要 听 西 拿 基 立 打 发 使 者 来 辱 骂 永 生 　 神 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10079', '12', '19', '17', '耶 和 华 啊 ， 亚 述 诸 王 果 然 使 列 国 和 列 国 之 地 变 为 荒 凉 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10080', '12', '19', '18', '将 列 国 的 　 神 像 都 扔 在 火 里 ； 因 为 他 本 不 是 　 神 ， 乃 是 人 手 所 造 的 ， 是 木 头 石 头 的 ， 所 以 灭 绝 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10081', '12', '19', '19', '耶 和 华 ─ 我 们 的 　 神 啊 ， 现 在 求 你 救 我 们 脱 离 亚 述 王 的 手 ， 使 天 下 万 国 都 知 道 惟 独 你 ─ 耶 和 华 是 　 神 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10082', '12', '19', '20', '亚 摩 斯 的 儿 子 以 赛 亚 就 打 发 人 去 见 希 西 家 ， 说 ： 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 你 既 然 求 我 攻 击 亚 述 王 西 拿 基 立 ， 我 已 听 见 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10083', '12', '19', '21', '耶 和 华 论 他 这 样 说 ： 锡 安 的 处 女 藐 视 你 ， 嗤 笑 你 ； 耶 路 撒 冷 的 女 子 向 你 摇 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10084', '12', '19', '22', '你 辱 骂 谁 ？ 亵 渎 谁 ？ 扬 起 声 来 ， 高 举 眼 目 攻 击 谁 呢 ？ 乃 是 攻 击 以 色 列 的 圣 者 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10085', '12', '19', '23', '你 藉 你 的 使 者 辱 骂 主 ， 并 说 ： 我 率 领 许 多 战 车 上 山 顶 ， 到 利 巴 嫩 极 深 之 处 ； 我 要 砍 伐 其 中 高 大 的 香 柏 树 和 佳 美 的 松 树 ； 我 必 上 极 高 之 处 ， 进 入 肥 田 的 树 林 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10086', '12', '19', '24', '我 已 经 在 外 邦 挖 井 喝 水 ； 我 必 用 脚 掌 踏 乾 埃 及 的 一 切 河 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10087', '12', '19', '25', '耶 和 华 说 ， 我 早 先 所 做 的 ， 古 时 所 立 的 ， 就 是 现 在 藉 你 使 坚 固 城 荒 废 ， 变 为 乱 堆 ， 这 事 你 岂 没 有 听 见 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10088', '12', '19', '26', '所 以 其 中 的 居 民 力 量 甚 小 ， 惊 惶 羞 愧 。 他 们 像 野 草 ， 像 青 菜 ， 如 房 顶 上 的 草 ， 又 如 未 长 成 而 枯 乾 的 禾 稼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10089', '12', '19', '27', '你 坐 下 ， 你 出 去 ， 你 进 来 ， 你 向 我 发 烈 怒 ， 我 都 知 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10090', '12', '19', '28', '因 你 向 我 发 烈 怒 ， 又 因 你 狂 傲 的 话 达 到 我 耳 中 ， 我 就 要 用 钩 子 钩 上 你 的 鼻 子 ， 把 嚼 环 放 在 你 口 里 ， 使 你 从 你 来 的 路 转 回 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10091', '12', '19', '29', '以 色 列 人 哪 ， 我 赐 你 们 一 个 证 据 ： 你 们 今 年 要 吃 自 生 的 ， 明 年 也 要 吃 自 长 的 ； 至 於 後 年 ， 你 们 要 耕 种 收 割 ， 栽 植 葡 萄 园 ， 吃 其 中 的 果 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10092', '12', '19', '30', '犹 大 家 所 逃 脱 馀 剩 的 ， 仍 要 往 下 扎 根 ， 向 上 结 果 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10093', '12', '19', '31', '必 有 馀 剩 的 民 从 耶 路 撒 冷 而 出 ； 必 有 逃 脱 的 人 从 锡 安 山 而 来 。 耶 和 华 的 热 心 必 成 就 这 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10094', '12', '19', '32', '所 以 ， 耶 和 华 论 亚 述 王 如 此 说 ： 他 必 不 得 来 到 这 城 ， 也 不 在 这 里 射 箭 ， 不 得 拿 盾 牌 到 城 前 ， 也 不 筑 垒 攻 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10095', '12', '19', '33', '他 从 哪 条 路 来 ， 必 从 那 条 路 回 去 ， 必 不 得 来 到 这 城 。 这 是 耶 和 华 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10096', '12', '19', '34', '因 我 为 自 己 的 缘 故 ， 又 为 我 仆 人 大 卫 的 缘 故 ， 必 保 护 拯 救 这 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10097', '12', '19', '35', '当 夜 ， 耶 和 华 的 使 者 出 去 ， 在 亚 述 营 中 杀 了 十 八 万 五 千 人 。 清 早 有 人 起 来 ， 一 看 ， 都 是 死 尸 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10098', '12', '19', '36', '亚 述 王 西 拿 基 立 就 拔 营 回 去 ， 住 在 尼 尼 微 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10099', '12', '19', '37', '一 日 在 他 的 　 神 尼 斯 洛 庙 里 叩 拜 ， 他 儿 子 亚 得 米 勒 和 沙 利 色 用 刀 杀 了 他 ， 就 逃 到 亚 拉 腊 地 。 他 儿 子 以 撒 哈 顿 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10100', '12', '20', '1', '那 时 ， 希 西 家 病 得 要 死 。 亚 摩 斯 的 儿 子 先 知 以 赛 亚 去 见 他 ， 对 他 说 ： 耶 和 华 如 此 说 ： 你 当 留 遗 命 与 你 的 家 ， 因 为 你 必 死 ， 不 能 活 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10101', '12', '20', '2', '希 西 家 就 转 脸 朝 墙 ， 祷 告 耶 和 华 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10102', '12', '20', '3', '耶 和 华 啊 ， 求 你 记 念 我 在 你 面 前 怎 样 存 完 全 的 心 ， 按 诚 实 行 事 ， 又 做 你 眼 中 所 看 为 善 的 。 希 西 家 就 痛 哭 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10103', '12', '20', '4', '以 赛 亚 出 来 ， 还 没 有 到 中 院 ( 院 或 作 城 ) ， 耶 和 华 的 话 就 临 到 他 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10104', '12', '20', '5', '你 回 去 告 诉 我 民 的 君 希 西 家 说 ： 耶 和 华 ─ 你 祖 大 卫 的 　 神 如 此 说 ： 我 听 见 了 你 的 祷 告 ， 看 见 了 你 的 眼 泪 ， 我 必 医 治 你 ； 到 第 三 日 ， 你 必 上 到 耶 和 华 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10105', '12', '20', '6', '我 必 加 增 你 十 五 年 的 寿 数 ， 并 且 我 要 救 你 和 这 城 脱 离 亚 述 王 的 手 。 我 为 自 己 和 我 仆 人 大 卫 的 缘 故 ， 必 保 护 这 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10106', '12', '20', '7', '以 赛 亚 说 ： 当 取 一 块 无 花 果 饼 来 。 人 就 取 了 来 ， 贴 在 疮 上 ， 王 便 痊 愈 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10107', '12', '20', '8', '希 西 家 问 以 赛 亚 说 ： 耶 和 华 必 医 治 我 ， 到 第 三 日 ， 我 能 上 耶 和 华 的 殿 ， 有 甚 麽 兆 头 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10108', '12', '20', '9', '以 赛 亚 说 ： 耶 和 华 必 成 就 他 所 说 的 。 这 是 他 给 你 的 兆 头 ： 你 要 日 影 向 前 进 十 度 呢 ？ 是 要 往 後 退 十 度 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10109', '12', '20', '10', '希 西 家 回 答 说 ： 日 影 向 前 进 十 度 容 易 ， 我 要 日 影 往 後 退 十 度 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10110', '12', '20', '11', '先 知 以 赛 亚 求 告 耶 和 华 ， 耶 和 就 使 亚 哈 斯 的 日 晷 向 前 进 的 日 影 ， 往 後 退 了 十 度 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10111', '12', '20', '12', '那 时 ， 巴 比 伦 王 巴 拉 但 的 儿 子 比 罗 达 ． 巴 拉 但 听 见 希 西 家 病 而 痊 愈 ， 就 送 书 信 和 礼 物 给 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10112', '12', '20', '13', '希 西 家 听 从 使 者 的 话 ， 就 把 他 宝 库 的 金 子 、 银 子 、 香 料 、 贵 重 的 膏 油 ， 和 他 武 库 的 一 切 军 器 ， 并 他 所 有 的 财 宝 ， 都 给 他 们 看 。 他 家 中 和 他 全 国 之 内 ， 希 西 家 没 有 一 样 不 给 他 们 看 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10113', '12', '20', '14', '於 是 先 知 以 赛 亚 来 见 希 西 家 王 ， 问 他 说 ： 这 些 人 说 甚 麽 ？ 他 们 从 哪 里 来 见 你 ？ 希 西 家 说 ： 他 们 从 远 方 的 巴 比 伦 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10114', '12', '20', '15', '以 赛 亚 说 ： 他 们 在 你 家 里 看 见 了 甚 麽 ？ 希 西 家 说 ： 凡 我 家 中 所 有 的 ， 他 们 都 看 见 了 ； 我 财 宝 中 没 有 一 样 不 给 他 们 看 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10115', '12', '20', '16', '以 赛 亚 对 希 西 家 说 ： 你 要 听 耶 和 华 的 话 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10116', '12', '20', '17', '日 子 必 到 ， 凡 你 家 里 所 有 的 ， 并 你 列 祖 积 蓄 到 如 今 的 ， 都 要 被 掳 到 巴 比 伦 去 ， 不 留 下 一 样 。 这 是 耶 和 华 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10117', '12', '20', '18', '并 且 从 你 本 身 所 生 的 众 子 ， 其 中 必 有 被 掳 去 在 巴 比 伦 王 宫 里 当 太 监 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10118', '12', '20', '19', '希 西 家 对 以 赛 亚 说 ： 你 所 说 耶 和 华 的 话 甚 好 ！ 若 在 我 的 年 日 中 有 太 平 和 稳 固 的 景 况 ， 岂 不 是 好 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10119', '12', '20', '20', '希 西 家 其 馀 的 事 和 他 的 勇 力 ， 他 怎 样 挖 池 、 挖 沟 、 引 水 入 城 ， 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10120', '12', '20', '21', '希 西 家 与 他 列 祖 同 睡 。 他 儿 子 玛 拿 西 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10121', '12', '21', '1', '玛 拿 西 登 基 的 时 候 年 十 二 岁 ， 在 耶 路 撒 冷 作 王 五 十 五 年 。 他 母 亲 名 叫 协 西 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10122', '12', '21', '2', '玛 拿 西 行 耶 和 华 眼 中 看 为 恶 的 事 ， 效 法 耶 和 华 在 以 色 列 人 面 前 赶 出 的 外 邦 人 所 行 可 憎 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10123', '12', '21', '3', '重 新 建 筑 他 父 希 西 家 所 毁 坏 的 邱 坛 ， 又 为 巴 力 筑 坛 ， 做 亚 舍 拉 像 ， 效 法 以 色 列 王 亚 哈 所 行 的 ， 且 敬 拜 事 奉 天 上 的 万 象 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10124', '12', '21', '4', '在 耶 和 华 殿 宇 中 筑 坛 。 耶 和 华 曾 指 着 这 殿 说 ： 我 必 立 我 的 名 在 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10125', '12', '21', '5', '他 在 耶 和 华 殿 的 两 院 中 为 天 上 的 万 象 筑 坛 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10126', '12', '21', '6', '并 使 他 的 儿 子 经 火 ， 又 观 兆 ， 用 法 术 ， 立 交 鬼 的 和 行 巫 术 的 ， 多 行 耶 和 华 眼 中 看 为 恶 的 事 ， 惹 动 他 的 怒 气 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10127', '12', '21', '7', '又 在 殿 内 立 雕 刻 的 亚 舍 拉 像 。 耶 和 华 曾 对 大 卫 和 他 儿 子 所 罗 门 说 ： 我 在 以 色 列 众 支 派 中 所 选 择 的 耶 路 撒 冷 和 这 殿 ， 必 立 我 的 名 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10128', '12', '21', '8', '以 色 列 人 若 谨 守 遵 行 我 一 切 所 吩 咐 他 们 的 和 我 仆 人 摩 西 所 吩 咐 他 们 的 一 切 律 法 ， 我 就 不 再 使 他 们 挪 移 离 开 我 所 赐 给 他 们 列 祖 之 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10129', '12', '21', '9', '他 们 却 不 听 从 。 玛 拿 西 引 诱 他 们 行 恶 ， 比 耶 和 华 在 以 色 列 人 面 前 所 灭 的 列 国 更 甚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10130', '12', '21', '10', '耶 和 华 藉 他 仆 人 众 先 知 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10131', '12', '21', '11', '因 犹 大 王 玛 拿 西 行 这 些 可 憎 的 恶 事 比 先 前 亚 摩 利 人 所 行 的 更 甚 ， 使 犹 大 人 拜 他 的 偶 像 ， 陷 在 罪 里 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10132', '12', '21', '12', '所 以 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 我 必 降 祸 与 耶 路 撒 冷 和 犹 大 ， 叫 一 切 听 见 的 人 无 不 耳 鸣 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10133', '12', '21', '13', '我 必 用 量 撒 玛 利 亚 的 准 绳 和 亚 哈 家 的 线 铊 拉 在 耶 路 撒 冷 上 ， 必 擦 净 耶 路 撒 冷 ， 如 人 擦 盘 ， 将 盘 倒 扣 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10134', '12', '21', '14', '我 必 弃 掉 所 馀 剩 的 子 民 ( 原 文 作 产 业 ) ， 把 他 们 交 在 仇 敌 手 中 ， 使 他 们 成 为 一 切 仇 敌 掳 掠 之 物 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10135', '12', '21', '15', '是 因 他 们 自 从 列 祖 出 埃 及 直 到 如 今 ， 常 行 我 眼 中 看 为 恶 的 事 ， 惹 动 我 的 怒 气 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10136', '12', '21', '16', '玛 拿 西 行 耶 和 华 眼 中 看 为 恶 的 事 ， 使 犹 大 人 陷 在 罪 里 ， 又 流 许 多 无 辜 人 的 血 ， 充 满 了 耶 路 撒 冷 ， 从 这 边 直 到 那 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10137', '12', '21', '17', '玛 拿 西 其 馀 的 事 ， 凡 他 所 行 的 和 他 所 犯 的 罪 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10138', '12', '21', '18', '玛 拿 西 与 他 列 祖 同 睡 ， 葬 在 自 己 宫 院 乌 撒 的 园 内 ； 他 儿 子 亚 们 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10139', '12', '21', '19', '亚 们 登 基 的 时 候 年 二 十 二 岁 ， 在 耶 路 撒 冷 作 王 二 年 。 他 母 亲 名 叫 米 舒 利 密 ， 是 约 提 巴 人 哈 鲁 斯 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10140', '12', '21', '20', '亚 们 行 耶 和 华 眼 中 看 为 恶 的 事 ， 与 他 父 亲 玛 拿 西 所 行 的 一 样 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10141', '12', '21', '21', '行 他 父 亲 一 切 所 行 的 ， 敬 奉 他 父 亲 所 敬 奉 的 偶 像 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10142', '12', '21', '22', '离 弃 耶 和 华 ─ 他 列 祖 的 　 神 ， 不 遵 行 耶 和 华 的 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10143', '12', '21', '23', '亚 们 王 的 臣 仆 背 叛 他 ， 在 宫 里 杀 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10144', '12', '21', '24', '但 国 民 杀 了 那 些 背 叛 亚 们 王 的 人 ， 立 他 儿 子 约 西 亚 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10145', '12', '21', '25', '亚 们 其 馀 所 行 的 事 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10146', '12', '21', '26', '亚 们 葬 在 乌 撒 的 园 内 自 己 的 坟 墓 里 。 他 儿 子 约 西 亚 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10147', '12', '22', '1', '约 西 亚 登 基 的 时 候 年 八 岁 ， 在 耶 路 撒 冷 作 王 三 十 一 年 。 他 母 亲 名 叫 耶 底 大 ， 是 波 斯 加 人 亚 大 雅 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10148', '12', '22', '2', '约 西 亚 行 耶 和 华 眼 中 看 为 正 的 事 ， 行 他 祖 大 卫 一 切 所 行 的 ， 不 偏 左 右 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10149', '12', '22', '3', '约 西 亚 王 十 八 年 ， 王 差 遣 米 书 兰 的 孙 子 、 亚 萨 利 的 儿 子 ─ 书 记 沙 番 上 耶 和 华 殿 去 ， 吩 咐 他 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10150', '12', '22', '4', '你 去 见 大 祭 司 希 勒 家 ， 使 他 将 奉 到 耶 和 华 殿 的 银 子 ， 就 是 守 门 的 从 民 中 收 聚 的 银 子 ， 数 算 数 算 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10151', '12', '22', '5', '交 给 耶 和 华 殿 里 办 事 的 人 ， 使 他 们 转 交 耶 和 华 殿 里 做 工 的 人 ， 好 修 理 殿 的 破 坏 之 处 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10152', '12', '22', '6', '就 是 转 交 木 匠 和 工 人 ， 并 瓦 匠 ， 又 买 木 料 和 凿 成 的 石 头 修 理 殿 宇 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10153', '12', '22', '7', '将 银 子 交 在 办 事 的 人 手 里 ， 不 与 他 们 算 帐 ， 因 为 他 们 办 事 诚 实 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10154', '12', '22', '8', '大 祭 司 希 勒 家 对 书 记 沙 番 说 ： 我 在 耶 和 华 殿 里 得 了 律 法 书 。 希 勒 家 将 书 递 给 沙 番 ， 沙 番 就 看 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10155', '12', '22', '9', '书 记 沙 番 到 王 那 里 ， 回 覆 王 说 ： 你 的 仆 人 已 将 殿 里 的 银 子 倒 出 数 算 ， 交 给 耶 和 华 殿 里 办 事 的 人 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10156', '12', '22', '10', '书 记 沙 番 又 对 王 说 ： 祭 司 希 勒 家 递 给 我 一 卷 书 。 沙 番 就 在 王 面 前 读 那 书 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10157', '12', '22', '11', '王 听 见 律 法 书 上 的 话 ， 便 撕 裂 衣 服 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10158', '12', '22', '12', '吩 咐 祭 司 希 勒 家 与 沙 番 的 儿 子 亚 希 甘 、 米 该 亚 的 儿 子 亚 革 波 、 书 记 沙 番 和 王 的 臣 仆 亚 撒 雅 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10159', '12', '22', '13', '你 们 去 为 我 、 为 民 、 为 犹 大 众 人 ， 以 这 书 上 的 话 求 问 耶 和 华 ； 因 为 我 们 列 祖 没 有 听 从 这 书 上 的 言 语 ， 没 有 遵 着 书 上 所 吩 咐 我 们 的 去 行 ， 耶 和 华 就 向 我 们 大 发 烈 怒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10160', '12', '22', '14', '於 是 ， 祭 司 希 勒 家 和 亚 希 甘 、 亚 革 波 、 沙 番 、 亚 撒 雅 都 去 见 女 先 知 户 勒 大 。 户 勒 大 是 掌 管 礼 服 沙 龙 的 妻 ； 沙 龙 是 哈 珥 哈 斯 的 孙 子 、 特 瓦 的 儿 子 。 户 勒 大 住 在 耶 路 撒 冷 第 二 区 。 他 们 请 问 於 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10161', '12', '22', '15', '他 对 他 们 说 ： 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 你 们 可 以 回 覆 那 差 遣 你 们 来 见 我 的 人 说 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10162', '12', '22', '16', '耶 和 华 如 此 说 ： 我 必 照 着 犹 大 王 所 读 那 书 上 的 一 切 话 ， 降 祸 与 这 地 和 其 上 的 居 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10163', '12', '22', '17', '因 为 他 们 离 弃 我 ， 向 别 　 神 烧 香 ， 用 他 们 手 所 做 的 惹 我 发 怒 ， 所 以 我 的 忿 怒 必 向 这 地 发 作 ， 总 不 止 息 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10164', '12', '22', '18', '然 而 ， 差 遣 你 们 来 求 问 耶 和 华 的 犹 大 王 ， 你 们 要 这 样 回 覆 他 说 ： 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 至 於 你 所 听 见 的 话 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10165', '12', '22', '19', '就 是 听 见 我 指 着 这 地 和 其 上 的 居 民 所 说 、 要 使 这 地 变 为 荒 场 、 民 受 咒 诅 的 话 ， 你 便 心 里 敬 服 ， 在 我 面 前 自 卑 ， 撕 裂 衣 服 ， 向 我 哭 泣 ， 因 此 我 应 允 了 你 。 这 是 我 ─ 耶 和 华 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10166', '12', '22', '20', '我 必 使 你 平 平 安 安 地 归 到 坟 墓 到 你 列 祖 那 里 ； 我 要 降 与 这 地 的 一 切 灾 祸 ， 你 也 不 至 亲 眼 看 见 。 他 们 就 回 覆 王 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10167', '12', '23', '1', '王 差 遣 人 招 聚 犹 大 和 耶 路 撒 冷 的 众 长 老 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10168', '12', '23', '2', '王 和 犹 大 众 人 与 耶 路 撒 冷 的 居 民 ， 并 祭 司 、 先 知 ， 和 所 有 的 百 姓 ， 无 论 大 小 ， 都 一 同 上 到 耶 和 华 的 殿 ； 王 就 把 耶 和 华 殿 里 所 得 的 约 书 念 给 他 们 听 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10169', '12', '23', '3', '王 站 在 柱 旁 ， 在 耶 和 华 面 前 立 约 ， 要 尽 心 尽 性 地 顺 从 耶 和 华 ， 遵 守 他 的 诫 命 、 法 度 、 律 例 ， 成 就 这 书 上 所 记 的 约 言 。 众 民 都 服 从 这 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10170', '12', '23', '4', '王 吩 咐 大 祭 司 希 勒 家 和 副 祭 司 ， 并 把 门 的 ， 将 那 为 巴 力 和 亚 舍 拉 ， 并 天 上 万 象 所 造 的 器 皿 ， 都 从 耶 和 华 殿 里 搬 出 来 ， 在 耶 路 撒 冷 外 汲 沦 溪 旁 的 田 间 烧 了 ， 把 灰 拿 到 伯 特 利 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10171', '12', '23', '5', '从 前 犹 大 列 王 所 立 拜 偶 像 的 祭 司 ， 在 犹 大 城 邑 的 邱 坛 和 耶 路 撒 冷 的 周 围 烧 香 ， 现 在 王 都 废 去 ， 又 废 去 向 巴 力 和 日 、 月 、 行 星 ( 或 作 十 二 宫 ) ， 并 天 上 万 象 烧 香 的 人 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10172', '12', '23', '6', '又 从 耶 和 华 殿 里 将 亚 舍 拉 搬 到 耶 路 撒 冷 外 汲 沦 溪 边 焚 烧 ， 打 碎 成 灰 ， 将 灰 撒 在 平 民 的 坟 上 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10173', '12', '23', '7', '又 拆 毁 耶 和 华 殿 里 娈 童 的 屋 子 ， 就 是 妇 女 为 亚 舍 拉 织 帐 子 的 屋 子 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10174', '12', '23', '8', '并 且 从 犹 大 的 城 邑 带 众 祭 司 来 ， 污 秽 祭 司 烧 香 的 邱 坛 ， 从 迦 巴 直 到 别 是 巴 ， 又 拆 毁 城 门 旁 的 邱 坛 ， 这 邱 坛 在 邑 宰 约 书 亚 门 前 ， 进 城 门 的 左 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10175', '12', '23', '9', '但 是 邱 坛 的 祭 司 不 登 耶 路 撒 冷 耶 和 华 的 坛 ， 只 在 他 们 弟 兄 中 间 吃 无 酵 饼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10176', '12', '23', '10', '又 污 秽 欣 嫩 子 谷 的 陀 斐 特 ， 不 许 人 在 那 里 使 儿 女 经 火 献 给 摩 洛 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10177', '12', '23', '11', '又 将 犹 大 列 王 在 耶 和 华 殿 门 旁 、 太 监 拿 单 米 勒 靠 近 游 廊 的 屋 子 、 向 日 头 所 献 的 马 废 去 ， 且 用 火 焚 烧 日 车 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10178', '12', '23', '12', '犹 大 列 王 在 亚 哈 斯 楼 顶 上 所 筑 的 坛 和 玛 拿 西 在 耶 和 华 殿 两 院 中 所 筑 的 坛 ， 王 都 拆 毁 打 碎 了 ， 就 把 灰 倒 在 汲 沦 溪 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10179', '12', '23', '13', '从 前 以 色 列 王 所 罗 门 在 耶 路 撒 冷 前 、 邪 僻 山 右 边 为 西 顿 人 可 憎 的 神 亚 斯 他 录 、 摩 押 人 可 憎 的 神 基 抹 、 亚 扪 人 可 憎 的 神 米 勒 公 所 筑 的 邱 坛 ， 王 都 污 秽 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10180', '12', '23', '14', '又 打 碎 柱 像 ， 砍 下 木 偶 ， 将 人 的 骨 头 充 满 了 那 地 方 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10181', '12', '23', '15', '他 将 伯 特 利 的 坛 ， 就 是 叫 以 色 列 人 陷 在 罪 里 、 尼 八 的 儿 子 耶 罗 波 安 所 筑 的 那 坛 ， 都 拆 毁 焚 烧 ， 打 碎 成 灰 ， 并 焚 烧 了 亚 舍 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10182', '12', '23', '16', '约 西 亚 回 头 ， 看 见 山 上 的 坟 墓 ， 就 打 发 人 将 坟 墓 里 的 骸 骨 取 出 来 ， 烧 在 坛 上 ， 污 秽 了 坛 ， 正 如 从 前 　 神 人 宣 传 耶 和 华 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10183', '12', '23', '17', '约 西 亚 问 说 ： 我 所 看 见 的 是 甚 麽 碑 ？ 那 城 里 的 人 回 答 说 ： 先 前 有 　 神 人 从 犹 大 来 ， 预 先 说 王 现 在 向 伯 特 利 坛 所 行 的 事 ， 这 就 是 他 的 墓 碑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10184', '12', '23', '18', '约 西 亚 说 ： 由 他 罢 ！ 不 要 挪 移 他 的 骸 骨 。 他 们 就 不 动 他 的 骸 骨 ， 也 不 动 从 撒 玛 利 亚 来 那 先 知 的 骸 骨 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10185', '12', '23', '19', '从 前 以 色 列 诸 王 在 撒 玛 利 亚 的 城 邑 建 筑 邱 坛 的 殿 ， 惹 动 耶 和 华 的 怒 气 ， 现 在 约 西 亚 都 废 去 了 ， 就 如 他 在 伯 特 利 所 行 的 一 般 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10186', '12', '23', '20', '又 将 邱 坛 的 祭 司 都 杀 在 坛 上 ， 并 在 坛 上 烧 人 的 骨 头 ， 就 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10187', '12', '23', '21', '王 吩 咐 众 民 说 ： 你 们 当 照 这 约 书 上 所 写 的 ， 向 耶 和 华 ─ 你 们 的 　 神 守 逾 越 节 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10188', '12', '23', '22', '自 从 士 师 治 理 以 色 列 人 和 以 色 列 王 、 犹 大 王 的 时 候 ， 直 到 如 今 ， 实 在 没 有 守 过 这 样 的 逾 越 节 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10189', '12', '23', '23', '只 有 约 西 亚 王 十 八 年 在 耶 路 撒 冷 向 耶 和 华 守 这 逾 越 节 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10190', '12', '23', '24', '凡 犹 大 国 和 耶 路 撒 冷 所 有 交 鬼 的 、 行 巫 术 的 ， 与 家 中 的 神 像 和 偶 像 ， 并 一 切 可 憎 之 物 ， 约 西 亚 尽 都 除 掉 ， 成 就 了 祭 司 希 勒 家 在 耶 和 华 殿 里 所 得 律 法 书 上 所 写 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10191', '12', '23', '25', '在 约 西 亚 以 前 没 有 王 像 他 尽 心 、 尽 性 、 尽 力 地 归 向 耶 和 华 ， 遵 行 摩 西 的 一 切 律 法 ； 在 他 以 後 也 没 有 兴 起 一 个 王 像 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10192', '12', '23', '26', '然 而 ， 耶 和 华 向 犹 大 所 发 猛 烈 的 怒 气 仍 不 止 息 ， 是 因 玛 拿 西 诸 事 惹 动 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10193', '12', '23', '27', '耶 和 华 说 ： 我 必 将 犹 大 人 从 我 面 前 赶 出 ， 如 同 赶 出 以 色 列 人 一 般 ； 我 必 弃 掉 我 从 前 所 选 择 的 这 城 ─ 耶 路 撒 冷 和 我 所 说 立 我 名 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10194', '12', '23', '28', '约 西 亚 其 馀 的 事 ， 凡 他 所 行 的 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10195', '12', '23', '29', '约 西 亚 年 间 ， 埃 及 王 法 老 尼 哥 上 到 伯 拉 河 攻 击 亚 述 王 ； 约 西 亚 王 去 抵 挡 他 。 埃 及 王 遇 见 约 西 亚 在 米 吉 多 ， 就 杀 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10196', '12', '23', '30', '他 的 臣 仆 用 车 将 他 的 尸 首 从 米 吉 多 送 到 耶 路 撒 冷 ， 葬 在 他 自 己 的 坟 墓 里 。 国 民 膏 约 西 亚 的 儿 子 约 哈 斯 接 续 他 父 亲 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10197', '12', '23', '31', '约 哈 斯 登 基 的 时 候 年 二 十 三 岁 ， 在 耶 路 撒 冷 作 王 三 个 月 。 他 母 亲 名 叫 哈 慕 他 ， 是 立 拿 人 耶 利 米 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10198', '12', '23', '32', '约 哈 斯 行 耶 和 华 眼 中 看 为 恶 的 事 ， 效 法 他 列 祖 一 切 所 行 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10199', '12', '23', '33', '法 老 尼 哥 将 约 哈 斯 锁 禁 在 哈 马 地 的 利 比 拉 ， 不 许 他 在 耶 路 撒 冷 作 王 ， 又 罚 犹 大 国 银 子 一 百 他 连 得 ， 金 子 一 他 连 得 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10200', '12', '23', '34', '法 老 尼 哥 立 约 西 亚 的 儿 子 以 利 亚 敬 接 续 他 父 亲 约 西 亚 作 王 ， 给 他 改 名 叫 约 雅 敬 ， 却 将 约 哈 斯 带 到 埃 及 ， 他 就 死 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10201', '12', '23', '35', '约 雅 敬 将 金 银 给 法 老 ， 遵 着 法 老 的 命 向 国 民 徵 取 金 银 ， 按 着 各 人 的 力 量 派 定 ， 索 要 金 银 ， 好 给 法 老 尼 哥 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10202', '12', '23', '36', '约 雅 敬 登 基 的 时 候 年 二 十 五 岁 ， 在 耶 路 撒 冷 作 王 十 一 年 。 他 母 亲 名 叫 西 布 大 ， 是 鲁 玛 人 毗 大 雅 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10203', '12', '23', '37', '约 雅 敬 行 耶 和 华 眼 中 看 为 恶 的 事 ， 效 法 他 列 祖 一 切 所 行 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10204', '12', '24', '1', '约 雅 敬 年 间 ， 巴 比 伦 王 尼 布 甲 尼 撒 上 到 犹 大 ； 约 雅 敬 服 事 他 三 年 ， 然 後 背 叛 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10205', '12', '24', '2', '耶 和 华 使 迦 勒 底 军 、 亚 兰 军 、 摩 押 军 ， 和 亚 扪 人 的 军 来 攻 击 约 雅 敬 ， 毁 灭 犹 大 ， 正 如 耶 和 华 藉 他 仆 人 众 先 知 所 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10206', '12', '24', '3', '这 祸 临 到 犹 大 人 ， 诚 然 是 耶 和 华 所 命 的 ， 要 将 他 们 从 自 己 面 前 赶 出 ， 是 因 玛 拿 西 所 犯 的 一 切 罪 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10207', '12', '24', '4', '又 因 他 流 无 辜 人 的 血 ， 充 满 了 耶 路 撒 冷 ； 耶 和 华 决 不 肯 赦 免 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10208', '12', '24', '5', '约 雅 敬 其 馀 的 事 ， 凡 他 所 行 的 都 写 在 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10209', '12', '24', '6', '约 雅 敬 与 他 列 祖 同 睡 。 他 儿 子 约 雅 斤 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10210', '12', '24', '7', '埃 及 王 不 再 从 他 国 中 出 来 ； 因 为 巴 比 伦 王 将 埃 及 王 所 管 之 地 ， 从 埃 及 小 河 直 到 伯 拉 河 都 夺 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10211', '12', '24', '8', '约 雅 斤 登 基 的 时 候 年 十 八 岁 ， 在 耶 路 撒 冷 作 王 三 个 月 。 他 母 亲 名 叫 尼 护 施 他 ， 是 耶 路 撒 冷 人 以 利 拿 单 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10212', '12', '24', '9', '约 雅 斤 行 耶 和 华 眼 中 看 为 恶 的 事 ， 效 法 他 父 亲 一 切 所 行 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10213', '12', '24', '10', '那 时 ， 巴 比 伦 王 尼 布 甲 尼 撒 的 军 兵 上 到 耶 路 撒 冷 ， 围 困 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10214', '12', '24', '11', '当 他 军 兵 围 困 城 的 时 候 ， 巴 比 伦 王 尼 布 甲 尼 撒 就 亲 自 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10215', '12', '24', '12', '犹 大 王 约 雅 斤 和 他 母 亲 、 臣 仆 、 首 领 、 太 监 一 同 出 城 ， 投 降 巴 比 伦 王 ； 巴 比 伦 王 便 拿 住 他 。 那 时 是 巴 比 伦 王 第 八 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10216', '12', '24', '13', '巴 比 伦 王 将 耶 和 华 殿 和 王 宫 里 的 宝 物 都 拿 去 了 ， 将 以 色 列 王 所 罗 门 所 造 耶 和 华 殿 里 的 金 器 都 毁 坏 了 ， 正 如 耶 和 华 所 说 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10217', '12', '24', '14', '又 将 耶 路 撒 冷 的 众 民 和 众 首 领 ， 并 所 有 大 能 的 勇 士 ， 共 一 万 人 ， 连 一 切 木 匠 、 铁 匠 都 掳 了 去 ； 除 了 国 中 极 贫 穷 的 人 以 外 ， 没 有 剩 下 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10218', '12', '24', '15', '并 将 约 雅 斤 和 王 母 、 后 妃 、 太 监 ， 与 国 中 的 大 官 ， 都 从 耶 路 撒 冷 掳 到 巴 比 伦 去 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10219', '12', '24', '16', '又 将 一 切 勇 士 七 千 人 和 木 匠 、 铁 匠 一 千 人 ， 都 是 能 上 阵 的 勇 士 ， 全 掳 到 巴 比 伦 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10220', '12', '24', '17', '巴 比 伦 王 立 约 雅 斤 的 叔 叔 玛 探 雅 代 替 他 作 王 ， 给 玛 探 雅 改 名 叫 西 底 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10221', '12', '24', '18', '西 底 家 登 基 的 时 候 年 二 十 一 岁 ， 在 耶 路 撒 冷 作 王 十 一 年 。 他 母 亲 名 叫 哈 慕 他 ， 是 立 拿 人 耶 利 米 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10222', '12', '24', '19', '西 底 家 行 耶 和 华 眼 中 看 为 恶 的 事 ， 是 照 约 雅 敬 一 切 所 行 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10223', '12', '24', '20', '因 此 耶 和 华 的 怒 气 在 耶 路 撒 冷 和 犹 大 发 作 ， 以 致 将 人 民 从 自 己 面 前 赶 出 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10224', '12', '25', '1', '西 底 家 背 叛 巴 比 伦 王 。 他 作 王 第 九 年 十 月 初 十 日 ， 巴 比 伦 王 尼 布 甲 尼 撒 率 领 全 军 来 攻 击 耶 路 撒 冷 ， 对 城 安 营 ， 四 围 筑 垒 攻 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10225', '12', '25', '2', '於 是 城 被 围 困 ， 直 到 西 底 家 王 十 一 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10226', '12', '25', '3', '四 月 初 九 日 ， 城 里 有 大 饥 荒 ， 甚 至 百 姓 都 没 有 粮 食 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10227', '12', '25', '4', '城 被 攻 破 ， 一 切 兵 丁 就 在 夜 间 从 靠 近 王 园 两 城 中 间 的 门 逃 跑 。 迦 勒 底 人 正 在 四 围 攻 城 ， 王 就 向 亚 拉 巴 逃 走 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10228', '12', '25', '5', '迦 勒 底 的 军 队 追 赶 王 ， 在 耶 利 哥 的 平 原 追 上 他 ； 他 的 全 军 都 离 开 他 四 散 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10229', '12', '25', '6', '迦 勒 底 人 就 拿 住 王 ， 带 他 到 在 利 比 拉 的 巴 比 伦 王 那 里 审 判 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10230', '12', '25', '7', '在 西 底 家 眼 前 杀 了 他 的 众 子 ， 并 且 剜 了 西 底 家 的 眼 睛 ， 用 铜 炼 锁 着 他 ， 带 到 巴 比 伦 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10231', '12', '25', '8', '巴 比 伦 王 尼 布 甲 尼 撒 十 九 年 五 月 初 七 日 ， 巴 比 伦 王 的 臣 仆 、 护 卫 长 尼 布 撒 拉 旦 来 到 耶 路 撒 冷 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10232', '12', '25', '9', '用 火 焚 烧 耶 和 华 的 殿 和 王 宫 ， 又 焚 烧 耶 路 撒 冷 的 房 屋 ， 就 是 各 大 户 家 的 房 屋 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10233', '12', '25', '10', '跟 从 护 卫 长 迦 勒 底 的 全 军 就 拆 毁 耶 路 撒 冷 四 围 的 城 墙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10234', '12', '25', '11', '那 时 护 卫 长 尼 布 撒 拉 旦 将 城 里 所 剩 下 的 百 姓 ， 并 已 经 投 降 巴 比 伦 王 的 人 ， 以 及 大 众 所 剩 下 的 人 ， 都 掳 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10235', '12', '25', '12', '但 护 卫 长 留 下 些 民 中 最 穷 的 ， 使 他 们 修 理 葡 萄 园 ， 耕 种 田 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10236', '12', '25', '13', '耶 和 华 殿 的 铜 柱 ， 并 耶 和 华 殿 的 盆 座 和 铜 海 ， 迦 勒 底 人 都 打 碎 了 ， 将 那 铜 运 到 巴 比 伦 去 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10237', '12', '25', '14', '又 带 去 锅 、 铲 子 、 蜡 剪 、 调 羹 ， 并 所 用 的 一 切 铜 器 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10238', '12', '25', '15', '火 鼎 、 碗 ， 无 论 金 的 银 的 ， 护 卫 长 也 都 带 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10239', '12', '25', '16', '所 罗 门 为 耶 和 华 殿 所 造 的 两 根 铜 柱 、 一 个 铜 海 ， 和 几 个 盆 座 ， 这 一 切 的 铜 ， 多 得 无 法 可 称 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10240', '12', '25', '17', '这 一 根 柱 子 高 十 八 肘 ， 柱 上 有 铜 顶 ， 高 三 肘 ； 铜 顶 的 周 围 有 网 子 和 石 榴 ， 都 是 铜 的 。 那 一 根 柱 子 ， 照 此 一 样 ， 也 有 网 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10241', '12', '25', '18', '护 卫 长 拿 住 大 祭 司 西 莱 雅 、 副 祭 司 西 番 亚 ， 和 三 个 把 门 的 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10242', '12', '25', '19', '又 从 城 中 拿 住 一 个 管 理 兵 丁 的 官 ( 或 作 太 监 ) ， 并 在 城 里 所 遇 常 见 王 面 的 五 个 人 和 检 点 国 民 军 长 的 书 记 ， 以 及 城 里 遇 见 的 国 民 六 十 个 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10243', '12', '25', '20', '护 卫 长 尼 布 撒 拉 旦 将 这 些 人 带 到 在 利 比 拉 的 巴 比 伦 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10244', '12', '25', '21', '巴 比 伦 王 就 把 他 们 击 杀 在 哈 马 地 的 利 比 拉 。 这 样 ， 犹 大 人 被 掳 去 离 开 本 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10245', '12', '25', '22', '至 於 犹 大 国 剩 下 的 民 ， 就 是 巴 比 伦 王 尼 布 甲 尼 撒 所 剩 下 的 ， 巴 比 伦 王 立 了 沙 番 的 孙 子 、 亚 希 甘 的 儿 子 基 大 利 作 他 们 的 省 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10246', '12', '25', '23', '众 军 长 和 属 他 们 的 人 听 见 巴 比 伦 王 立 了 基 大 利 作 省 长 ， 於 是 军 长 尼 探 雅 的 儿 子 以 实 玛 利 、 加 利 亚 的 儿 子 约 哈 难 、 尼 陀 法 人 单 户 蔑 的 儿 子 西 莱 雅 、 玛 迦 人 的 儿 子 雅 撒 尼 亚 ， 和 属 他 们 的 人 都 到 米 斯 巴 见 基 大 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10247', '12', '25', '24', '基 大 利 向 他 们 和 属 他 们 的 人 起 誓 说 ： 你 们 不 必 惧 怕 迦 勒 底 臣 仆 ， 只 管 住 在 这 地 服 事 巴 比 伦 王 ， 就 可 以 得 福 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10248', '12', '25', '25', '七 月 间 ， 宗 室 以 利 沙 玛 的 孙 子 、 尼 探 雅 的 儿 子 以 实 玛 利 带 着 十 个 人 来 ， 杀 了 基 大 利 和 同 他 在 米 斯 巴 的 犹 大 人 与 迦 勒 底 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10249', '12', '25', '26', '於 是 众 民 ， 无 论 大 小 ， 连 众 军 长 ； 因 为 惧 怕 迦 勒 底 人 ， 都 起 身 往 埃 及 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10250', '12', '25', '27', '犹 大 王 约 雅 斤 被 掳 後 三 十 七 年 ， 巴 比 伦 王 以 未 米 罗 达 元 年 十 二 月 二 十 七 日 ， 使 犹 大 王 约 雅 斤 抬 头 ， 提 他 出 监 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10251', '12', '25', '28', '又 对 他 说 恩 言 ， 使 他 的 位 高 过 与 他 一 同 在 巴 比 伦 众 王 的 位 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10252', '12', '25', '29', '给 他 脱 了 囚 服 。 他 终 身 常 在 巴 比 伦 王 面 前 吃 饭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10253', '12', '25', '30', '王 赐 他 所 需 用 的 食 物 ， 日 日 赐 他 一 分 ， 终 身 都 是 这 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10254', '13', '1', '1', '亚 当 生 塞 特 ； 塞 特 生 以 挪 士 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10255', '13', '1', '2', '以 挪 士 生 该 南 ； 该 南 生 玛 勒 列 ； 玛 勒 列 生 雅 列 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10256', '13', '1', '3', '雅 列 生 以 诺 ； 以 诺 生 玛 土 撒 拉 ； 玛 土 撒 拉 生 拉 麦 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10257', '13', '1', '4', '拉 麦 生 挪 亚 ； 挪 亚 生 闪 、 含 、 雅 弗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10258', '13', '1', '5', '雅 弗 的 儿 子 是 歌 篾 、 玛 各 、 玛 代 、 雅 完 、 土 巴 、 米 设 、 提 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10259', '13', '1', '6', '歌 篾 的 儿 子 是 亚 实 基 拿 、 低 法 ( 创 十 章 三 节 作 利 法 ) 、 陀 迦 玛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10260', '13', '1', '7', '雅 完 的 儿 子 是 以 利 沙 、 他 施 、 基 提 、 多 单 ( 有 作 罗 单 的 ) 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10261', '13', '1', '8', '含 的 儿 子 是 古 实 、 麦 西 、 弗 、 迦 南 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10262', '13', '1', '9', '古 实 的 儿 子 是 西 巴 、 哈 腓 拉 、 撒 弗 他 、 拉 玛 、 撒 弗 提 迦 。 拉 玛 的 儿 子 是 示 巴 、 底 但 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10263', '13', '1', '10', '古 实 生 宁 录 ； 他 为 世 上 英 雄 之 首 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10264', '13', '1', '11', '麦 西 生 路 低 人 、 亚 拿 米 人 、 利 哈 比 人 、 拿 弗 土 希 人 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10265', '13', '1', '12', '帕 斯 鲁 细 人 、 迦 斯 路 希 人 、 迦 斐 托 人 ； 从 迦 斐 托 出 来 的 有 非 利 士 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10266', '13', '1', '13', '迦 南 生 长 子 西 顿 ， 又 生 赫');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10267', '13', '1', '14', '和 耶 布 斯 人 、 亚 摩 利 人 、 革 迦 撒 人 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10268', '13', '1', '15', '希 未 人 、 亚 基 人 、 西 尼 人 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10269', '13', '1', '16', '亚 瓦 底 人 、 洗 玛 利 人 ， 并 哈 马 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10270', '13', '1', '17', '闪 的 儿 子 是 以 拦 、 亚 述 、 亚 法 撒 、 路 德 、 亚 兰 、 乌 斯 、 户 勒 、 基 帖 、 米 设 ( 创 十23 作 玛 施 ) 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10271', '13', '1', '18', '亚 法 撒 生 沙 拉 ； 沙 拉 生 希 伯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10272', '13', '1', '19', '希 伯 生 了 两 个 儿 子 ： 一 个 名 叫 法 勒 ( 就 是 分 的 意 思 ) ， 因 为 那 时 人 就 分 地 居 住 ； 法 勒 的 兄 弟 名 叫 约 坍 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10273', '13', '1', '20', '约 坍 生 亚 摩 答 、 沙 列 、 哈 萨 玛 非 、 耶 拉 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10274', '13', '1', '21', '哈 多 兰 、 乌 萨 、 德 拉 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10275', '13', '1', '22', '以 巴 录 、 亚 比 玛 利 、 示 巴 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10276', '13', '1', '23', '阿 斐 、 哈 腓 拉 、 约 巴 。 这 都 是 约 坍 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10277', '13', '1', '24', '闪 生 亚 法 撒 ； 亚 法 撒 生 沙 拉 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10278', '13', '1', '25', '沙 拉 生 希 伯 ； 希 伯 生 法 勒 ； 法 勒 生 拉 吴 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10279', '13', '1', '26', '拉 吴 生 西 鹿 ； 西 鹿 生 拿 鹤 ； 拿 鹤 生 他 拉 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10280', '13', '1', '27', '他 拉 生 亚 伯 兰 ， 亚 伯 兰 就 是 亚 伯 拉 罕 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10281', '13', '1', '28', '亚 伯 拉 罕 的 儿 子 是 以 撒 、 以 实 玛 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10282', '13', '1', '29', '以 实 玛 利 的 儿 子 记 在 下 面 ： 以 实 玛 利 的 长 子 是 尼 拜 约 ， 其 次 是 基 达 、 押 德 别 、 米 比 衫 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10283', '13', '1', '30', '米 施 玛 、 度 玛 、 玛 撒 、 哈 达 、 提 玛 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10284', '13', '1', '31', '伊 突 、 拿 非 施 、 基 底 玛 。 这 都 是 以 实 玛 利 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10285', '13', '1', '32', '亚 伯 拉 罕 的 妾 基 土 拉 所 生 的 儿 子 ， 就 是 心 兰 、 约 珊 、 米 但 、 米 甸 、 伊 施 巴 、 书 亚 。 约 珊 的 儿 子 是 示 巴 、 底 但 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10286', '13', '1', '33', '米 甸 的 儿 子 是 以 法 、 以 弗 、 哈 诺 、 亚 比 大 、 以 勒 大 。 这 都 是 基 土 拉 的 子 孙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10287', '13', '1', '34', '亚 伯 拉 罕 生 以 撒 ； 以 撒 的 儿 子 是 以 扫 和 以 色 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10288', '13', '1', '35', '以 扫 的 儿 子 是 以 利 法 、 流 珥 、 耶 乌 施 、 雅 兰 、 可 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10289', '13', '1', '36', '以 利 法 的 儿 子 是 提 幔 、 阿 抹 、 洗 玻 、 迦 坦 、 基 纳 斯 、 亭 纳 、 亚 玛 力 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10290', '13', '1', '37', '流 珥 的 儿 子 是 拿 哈 、 谢 拉 、 沙 玛 、 米 撒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10291', '13', '1', '38', '西 珥 的 儿 子 是 罗 坍 、 朔 巴 、 祭 便 、 亚 拿 、 底 顺 、 以 察 、 底 珊 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10292', '13', '1', '39', '罗 坍 的 儿 子 是 何 利 、 荷 幔 ； 罗 坍 的 妹 子 是 亭 纳 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10293', '13', '1', '40', '朔 巴 的 儿 子 是 亚 勒 文 、 玛 拿 辖 、 以 巴 录 、 示 非 、 阿 南 。 祭 便 的 儿 子 是 亚 雅 、 亚 拿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10294', '13', '1', '41', '亚 拿 的 儿 子 是 底 顺 。 底 顺 的 儿 子 是 哈 默 兰 、 伊 是 班 、 益 兰 、 基 兰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10295', '13', '1', '42', '以 察 的 儿 子 是 辟 罕 、 撒 番 、 亚 干 。 底 珊 的 儿 子 是 乌 斯 、 亚 兰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10296', '13', '1', '43', '以 色 列 人 未 有 君 王 治 理 之 先 ， 在 以 东 地 作 王 的 记 在 下 面 ： 有 比 珥 的 儿 子 比 拉 ， 他 的 京 城 名 叫 亭 哈 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10297', '13', '1', '44', '比 拉 死 了 ， 波 斯 拉 人 谢 拉 的 儿 子 约 巴 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10298', '13', '1', '45', '约 巴 死 了 ， 提 幔 地 的 人 户 珊 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10299', '13', '1', '46', '户 珊 死 了 ， 比 达 的 儿 子 哈 达 接 续 他 作 王 。 这 哈 达 就 是 在 摩 押 地 杀 败 米 甸 人 的 ， 他 的 京 城 名 叫 亚 未 得 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10300', '13', '1', '47', '哈 达 死 了 ， 玛 士 利 加 人 桑 拉 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10301', '13', '1', '48', '桑 拉 死 了 ， 大 河 边 的 利 河 伯 人 扫 罗 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10302', '13', '1', '49', '扫 罗 死 了 ， 亚 革 波 的 儿 子 巴 勒 哈 南 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10303', '13', '1', '50', '巴 勒 哈 南 死 了 ， 哈 达 接 续 他 作 王 。 他 的 京 城 名 叫 巴 伊 ， 他 的 妻 子 名 叫 米 希 他 别 ， 是 米 萨 合 的 孙 女 ， 玛 特 列 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10304', '13', '1', '51', '哈 达 死 了 ， 以 东 人 的 族 长 有 亭 纳 族 长 、 亚 勒 瓦 族 长 、 耶 帖 族 长 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10305', '13', '1', '52', '亚 何 利 巴 玛 族 长 、 以 拉 族 长 、 比 嫩 族 长 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10306', '13', '1', '53', '基 纳 斯 族 长 、 提 幔 族 长 、 米 比 萨 族 长 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10307', '13', '1', '54', '玛 基 叠 族 长 、 以 兰 族 长 。 这 都 是 以 东 人 的 族 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10308', '13', '2', '1', '以 色 列 的 儿 子 是 流 便 、 西 缅 、 利 未 、 犹 大 、 以 萨 迦 、 西 布 伦 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10309', '13', '2', '2', '但 、 约 瑟 、 便 雅 悯 、 拿 弗 他 利 、 迦 得 、 亚 设 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10310', '13', '2', '3', '犹 大 的 儿 子 是 珥 、 俄 南 、 示 拉 ， 这 三 人 是 迦 南 人 书 亚 女 儿 所 生 的 。 犹 大 的 长 子 珥 在 耶 和 华 眼 中 看 为 恶 ， 耶 和 华 就 使 他 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10311', '13', '2', '4', '犹 大 的 儿 妇 他 玛 给 犹 大 生 法 勒 斯 和 谢 拉 。 犹 大 共 有 五 个 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10312', '13', '2', '5', '法 勒 斯 的 儿 子 是 希 斯 仑 、 哈 母 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10313', '13', '2', '6', '谢 拉 的 儿 子 是 心 利 、 以 探 、 希 幔 、 甲 各 、 大 拉 ( 即 达 大 ) ， 共 五 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10314', '13', '2', '7', '迦 米 的 儿 子 是 亚 干 ， 这 亚 干 在 当 灭 的 物 上 犯 了 罪 ， 连 累 了 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10315', '13', '2', '8', '以 探 的 儿 子 是 亚 撒 利 雅 . 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10316', '13', '2', '9', '希 斯 仑 所 生 的 儿 子 是 耶 拉 篾 、 兰 、 基 路 拜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10317', '13', '2', '10', '兰 生 亚 米 拿 达 ； 亚 米 拿 达 生 拿 顺 。 拿 顺 作 犹 大 人 的 首 领 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10318', '13', '2', '11', '拿 顺 生 撒 门 ； 撒 门 生 波 阿 斯 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10319', '13', '2', '12', '波 阿 斯 生 俄 备 得 ； 俄 备 得 生 耶 西 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10320', '13', '2', '13', '耶 西 生 长 子 以 利 押 ， 次 子 亚 比 拿 达 ， 三 子 示 米 亚 ( 即 沙 玛 ， 见 撒 上 十 六 章 九 节 ) ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10321', '13', '2', '14', '四 子 拿 坦 业 ， 五 子 拉 代 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10322', '13', '2', '15', '六 子 阿 鲜 ， 七 子 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10323', '13', '2', '16', '他 们 的 姊 妹 是 洗 鲁 雅 和 亚 比 该 。 洗 鲁 雅 的 儿 子 是 亚 比 筛 、 约 押 、 亚 撒 黑 ， 共 三 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10324', '13', '2', '17', '亚 比 该 生 亚 玛 撒 ； 亚 玛 撒 的 父 亲 是 以 实 玛 利 人 益 帖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10325', '13', '2', '18', '希 斯 仑 的 儿 子 迦 勒 娶 阿 苏 巴 和 耶 略 为 妻 ， 阿 苏 巴 的 儿 子 是 耶 设 、 朔 罢 、 押 墩 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10326', '13', '2', '19', '阿 苏 巴 死 了 ， 迦 勒 又 娶 以 法 他 ， 生 了 户 珥 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10327', '13', '2', '20', '户 珥 生 乌 利 ； 乌 利 生 比 撒 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10328', '13', '2', '21', '希 斯 仑 正 六 十 岁 娶 了 基 列 父 亲 玛 吉 的 女 儿 ， 与 他 同 房 ； 玛 吉 的 女 儿 生 了 西 割 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10329', '13', '2', '22', '西 割 生 睚 珥 。 睚 珥 在 基 列 地 有 二 十 三 个 城 邑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10330', '13', '2', '23', '後 来 基 述 人 和 亚 兰 人 夺 了 睚 珥 的 城 邑 ， 并 基 纳 和 其 乡 村 ， 共 六 十 个 。 这 都 是 基 列 父 亲 玛 吉 之 子 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10331', '13', '2', '24', '希 斯 仑 在 迦 勒 以 法 他 死 後 ， 他 的 妻 亚 比 雅 给 他 生 了 亚 施 户 ； 亚 施 户 是 提 哥 亚 的 父 亲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10332', '13', '2', '25', '希 斯 仑 的 长 子 耶 拉 篾 生 长 子 兰 ， 又 生 布 拿 、 阿 连 、 阿 鲜 、 亚 希 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10333', '13', '2', '26', '耶 拉 篾 又 娶 一 妻 名 叫 亚 他 拉 ， 是 阿 南 的 母 亲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10334', '13', '2', '27', '耶 拉 篾 长 子 兰 的 儿 子 是 玛 斯 、 雅 悯 、 以 结 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10335', '13', '2', '28', '阿 南 的 儿 子 是 沙 买 、 雅 大 。 沙 买 的 儿 子 是 拿 答 、 亚 比 述 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10336', '13', '2', '29', '亚 比 述 的 妻 名 叫 亚 比 孩 ， 亚 比 孩 给 他 生 了 亚 办 和 摩 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10337', '13', '2', '30', '拿 答 的 儿 子 是 西 列 、 亚 遍 ； 西 列 死 了 没 有 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10338', '13', '2', '31', '亚 遍 的 儿 子 是 以 示 ； 以 示 的 儿 子 是 示 珊 ； 示 珊 的 儿 子 是 亚 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10339', '13', '2', '32', '沙 买 兄 弟 雅 大 的 儿 子 是 益 帖 、 约 拿 单 ； 益 帖 死 了 没 有 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10340', '13', '2', '33', '约 拿 单 的 儿 子 是 比 勒 、 撒 萨 。 这 都 是 耶 拉 篾 的 子 孙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10341', '13', '2', '34', '示 珊 没 有 儿 子 ， 只 有 女 儿 。 示 珊 有 一 个 仆 人 名 叫 耶 哈 ， 是 埃 及 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10342', '13', '2', '35', '示 珊 将 女 儿 给 了 仆 人 耶 哈 为 妻 ， 给 他 生 了 亚 太 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10343', '13', '2', '36', '亚 太 生 拿 单 ； 拿 单 生 撒 拔 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10344', '13', '2', '37', '撒 拔 生 以 弗 拉 ； 以 弗 拉 生 俄 备 得 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10345', '13', '2', '38', '俄 备 得 生 耶 户 ； 耶 户 生 亚 撒 利 雅 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10346', '13', '2', '39', '亚 撒 利 雅 生 希 利 斯 ； 希 利 斯 生 以 利 亚 萨 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10347', '13', '2', '40', '以 利 亚 萨 生 西 斯 买 ； 西 斯 买 生 沙 龙 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10348', '13', '2', '41', '沙 龙 生 耶 加 米 雅 ； 耶 加 米 雅 生 以 利 沙 玛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10349', '13', '2', '42', '耶 拉 篾 兄 弟 迦 勒 的 长 子 米 沙 ， 是 西 弗 之 祖 玛 利 沙 的 儿 子 ， 是 希 伯 仑 之 祖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10350', '13', '2', '43', '希 伯 仑 的 儿 子 是 可 拉 、 他 普 亚 、 利 肯 、 示 玛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10351', '13', '2', '44', '示 玛 生 拉 含 ， 是 约 干 之 祖 。 利 肯 生 沙 买 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10352', '13', '2', '45', '沙 买 的 儿 子 是 玛 云 ； 玛 云 是 伯 夙 之 祖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10353', '13', '2', '46', '迦 勒 的 妾 以 法 生 哈 兰 、 摩 撒 、 迦 谢 ； 哈 兰 生 迦 卸 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10354', '13', '2', '47', '〈 雅 代 的 儿 子 是 利 健 、 约 坦 、 基 珊 、 毗 力 、 以 法 、 沙 亚 弗 。 〉');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10355', '13', '2', '48', '迦 勒 的 妾 玛 迦 生 示 别 、 特 哈 拿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10356', '13', '2', '49', '又 生 麦 玛 拿 之 祖 沙 亚 弗 、 抹 比 拿 和 基 比 亚 之 祖 示 法 。 迦 勒 的 女 儿 是 押 撒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10357', '13', '2', '50', '迦 勒 的 子 孙 就 是 以 法 他 的 长 子 、 户 珥 的 儿 子 ， 记 在 下 面 ： 基 列 耶 琳 之 祖 朔 巴 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10358', '13', '2', '51', '伯 利 恒 之 祖 萨 玛 ， 伯 迦 得 之 祖 哈 勒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10359', '13', '2', '52', '基 列 耶 琳 之 祖 朔 巴 的 子 孙 是 哈 罗 以 和 一 半 米 努 哈 人 ( 即 玛 拿 哈 人 ) 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10360', '13', '2', '53', '基 列 耶 琳 的 诸 族 是 以 帖 人 、 布 特 人 、 舒 玛 人 、 密 来 人 ， 又 从 这 些 族 中 生 出 琐 拉 人 和 以 实 陶 人 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10361', '13', '2', '54', '萨 玛 的 子 孙 是 伯 利 恒 人 、 尼 陀 法 人 、 亚 他 绿 伯 约 押 人 、 一 半 玛 拿 哈 人 、 琐 利 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10362', '13', '2', '55', '和 住 雅 比 斯 众 文 士 家 的 特 拉 人 、 示 米 押 人 、 苏 甲 人 。 这 都 是 基 尼 人 利 甲 家 之 祖 哈 末 所 生 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10363', '13', '3', '1', '大 卫 在 希 伯 仑 所 生 的 儿 子 记 在 下 面 ： 长 子 暗 嫩 是 耶 斯 列 人 亚 希 暖 生 的 。 次 子 但 以 利 是 迦 密 人 亚 比 该 生 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10364', '13', '3', '2', '三 子 押 沙 龙 是 基 述 王 达 买 的 女 儿 玛 迦 生 的 。 四 子 亚 多 尼 雅 是 哈 及 生 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10365', '13', '3', '3', '五 子 示 法 提 雅 是 亚 比 他 生 的 。 六 子 以 特 念 是 大 卫 的 妻 以 格 拉 生 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10366', '13', '3', '4', '这 六 人 都 是 大 卫 在 希 伯 仑 生 的 。 大 卫 在 希 伯 仑 作 王 七 年 零 六 个 月 ， 在 耶 路 撒 冷 作 王 三 十 三 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10367', '13', '3', '5', '大 卫 在 耶 路 撒 冷 所 生 的 儿 子 是 示 米 亚 、 朔 罢 、 拿 单 、 所 罗 门 。 这 四 人 是 亚 米 利 的 女 儿 拔 书 亚 生 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10368', '13', '3', '6', '还 有 益 辖 、 以 利 沙 玛 、 以 利 法 列 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10369', '13', '3', '7', '挪 迦 、 尼 斐 、 雅 非 亚 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10370', '13', '3', '8', '以 利 沙 玛 、 以 利 雅 大 、 以 利 法 列 ， 共 九 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10371', '13', '3', '9', '这 都 是 大 卫 的 儿 子 ， 还 有 他 们 的 妹 子 他 玛 ， 妃 嫔 的 儿 子 不 在 其 内 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10372', '13', '3', '10', '所 罗 门 的 儿 子 是 罗 波 安 ； 罗 波 安 的 儿 子 是 亚 比 雅 ； 亚 比 雅 的 儿 子 是 亚 撒 ； 亚 撒 的 儿 子 是 约 沙 法 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10373', '13', '3', '11', '约 沙 法 的 儿 子 是 约 兰 ； 约 兰 的 儿 子 是 亚 哈 谢 ； 亚 哈 谢 的 儿 子 是 约 阿 施 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10374', '13', '3', '12', '约 阿 施 的 儿 子 是 亚 玛 谢 ； 亚 玛 谢 的 儿 子 是 亚 撒 利 雅 ； 亚 撒 利 雅 的 儿 子 是 约 坦 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10375', '13', '3', '13', '约 坦 的 儿 子 是 亚 哈 斯 ； 亚 哈 斯 的 儿 子 是 希 西 家 ； 希 西 家 的 儿 子 是 玛 拿 西 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10376', '13', '3', '14', '玛 拿 西 的 儿 子 是 亚 们 ； 亚 们 的 儿 子 是 约 西 亚 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10377', '13', '3', '15', '约 西 亚 的 长 子 是 约 哈 难 ， 次 子 是 约 雅 敬 ， 三 子 是 西 底 家 ， 四 子 是 沙 龙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10378', '13', '3', '16', '约 雅 敬 的 儿 子 是 耶 哥 尼 雅 和 西 底 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10379', '13', '3', '17', '耶 哥 尼 雅 被 掳 。 他 的 儿 子 是 撒 拉 铁 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10380', '13', '3', '18', '玛 基 兰 、 毗 大 雅 、 示 拿 萨 、 耶 加 米 、 何 沙 玛 、 尼 大 比 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10381', '13', '3', '19', '毗 大 雅 的 儿 子 是 所 罗 巴 伯 、 示 每 。 所 罗 巴 伯 的 儿 子 是 米 书 兰 、 哈 拿 尼 雅 ， 他 们 的 妹 子 名 叫 示 罗 密 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10382', '13', '3', '20', '米 书 兰 的 儿 子 是 哈 舒 巴 、 阿 黑 、 比 利 家 、 哈 撒 底 、 于 沙 希 悉 ， 共 五 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10383', '13', '3', '21', '哈 拿 尼 雅 的 儿 子 是 毗 拉 提 、 耶 筛 亚 。 还 有 利 法 雅 的 众 子 ， 亚 珥 难 的 众 子 ， 俄 巴 底 亚 的 众 子 ， 示 迦 尼 的 众 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10384', '13', '3', '22', '示 迦 尼 的 儿 子 是 示 玛 雅 ； 示 玛 雅 的 儿 子 是 哈 突 、 以 甲 、 巴 利 亚 、 尼 利 雅 、 沙 法 ， 共 六 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10385', '13', '3', '23', '尼 利 雅 的 儿 子 是 以 利 约 乃 、 希 西 家 、 亚 斯 利 干 ， 共 三 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10386', '13', '3', '24', '以 利 约 乃 的 儿 子 是 何 大 雅 、 以 利 亚 实 、 毗 莱 雅 、 阿 谷 、 约 哈 难 、 第 莱 雅 、 阿 拿 尼 ， 共 七 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10387', '13', '4', '1', '犹 大 的 儿 子 是 法 勒 斯 、 希 斯 仑 、 迦 米 、 户 珥 、 朔 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10388', '13', '4', '2', '朔 巴 的 儿 子 利 亚 雅 生 雅 哈 ； 雅 哈 生 亚 户 买 和 拉 哈 。 这 是 琐 拉 人 的 诸 族 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10389', '13', '4', '3', '以 坦 之 祖 的 儿 子 是 耶 斯 列 、 伊 施 玛 、 伊 得 巴 ； 他 们 的 妹 子 名 叫 哈 悉 勒 玻 尼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10390', '13', '4', '4', '基 多 之 祖 是 毗 努 伊 勒 。 户 沙 之 祖 是 以 谢 珥 。 这 都 是 伯 利 恒 之 祖 以 法 他 的 长 子 户 珥 所 生 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10391', '13', '4', '5', '提 哥 亚 之 祖 亚 施 户 有 两 个 妻 子 ： 一 名 希 拉 ， 一 名 拿 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10392', '13', '4', '6', '拿 拉 给 亚 施 户 生 亚 户 撒 、 希 弗 、 提 米 尼 、 哈 辖 斯 他 利 。 这 都 是 拿 拉 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10393', '13', '4', '7', '希 拉 的 儿 子 是 洗 列 、 琐 辖 、 伊 提 南 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10394', '13', '4', '8', '哥 斯 生 亚 诺 、 琐 比 巴 ， 并 哈 仑 儿 子 亚 哈 黑 的 诸 族 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10395', '13', '4', '9', '雅 比 斯 比 他 众 弟 兄 更 尊 贵 ， 他 母 亲 给 他 起 名 叫 雅 比 斯 ， 意 思 说 ： 我 生 他 甚 是 痛 苦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10396', '13', '4', '10', '雅 比 斯 求 告 以 色 列 的 　 神 说 ： 甚 愿 你 赐 福 与 我 ， 扩 张 我 的 境 界 ， 常 与 我 同 在 ， 保 佑 我 不 遭 患 难 ， 不 受 艰 苦 。 　 神 就 应 允 他 所 求 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10397', '13', '4', '11', '书 哈 的 弟 兄 基 绿 生 米 黑 ， 米 黑 是 伊 施 屯 之 祖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10398', '13', '4', '12', '伊 施 屯 生 伯 拉 巴 、 巴 西 亚 ， 并 珥 拿 辖 之 祖 提 欣 拿 ， 这 都 是 利 迦 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10399', '13', '4', '13', '基 纳 斯 的 儿 子 是 俄 陀 聂 、 西 莱 雅 。 俄 陀 聂 的 儿 子 是 哈 塔 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10400', '13', '4', '14', '悯 挪 太 生 俄 弗 拉 ； 西 莱 雅 生 革 夏 纳 欣 人 之 祖 约 押 。 他 们 都 是 匠 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10401', '13', '4', '15', '耶 孚 尼 的 儿 子 是 迦 勒 ； 迦 勒 的 儿 子 是 以 路 、 以 拉 、 拿 安 。 以 拉 的 儿 子 是 基 纳 斯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10402', '13', '4', '16', '耶 哈 利 勒 的 儿 子 是 西 弗 、 西 法 、 提 利 、 亚 撒 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10403', '13', '4', '17', '以 斯 拉 的 儿 子 是 益 帖 、 米 列 、 以 弗 、 雅 伦 。 米 列 娶 法 老 女 儿 比 提 雅 为 妻 ， 生 米 利 暗 、 沙 买 ， 和 以 实 提 摩 之 祖 益 巴 。 米 列 又 娶 犹 大 女 子 为 妻 ， 生 基 多 之 祖 雅 列 ， 梭 哥 之 祖 希 伯 ， 和 撒 挪 亚 之 祖 耶 古 铁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10404', '13', '4', '18', 'a');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10405', '13', '4', '19', '荷 第 雅 的 妻 是 拿 含 的 妹 子 ， 他 所 生 的 儿 子 是 迦 米 人 基 伊 拉 和 玛 迦 人 以 实 提 摩 之 祖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10406', '13', '4', '20', '示 门 的 儿 子 是 暗 嫩 、 林 拿 、 便 哈 南 、 提 伦 。 以 示 的 儿 子 是 梭 黑 与 便 梭 黑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10407', '13', '4', '21', '犹 大 的 儿 子 是 示 拉 ； 示 拉 的 儿 子 是 利 迦 之 祖 珥 ， 玛 利 沙 之 祖 拉 大 ， 和 属 亚 实 比 族 织 细 麻 布 的 各 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10408', '13', '4', '22', '还 有 约 敬 、 哥 西 巴 人 、 约 阿 施 、 萨 拉 ， 就 是 在 摩 押 地 掌 权 的 ， 又 有 雅 叔 比 利 恒 。 这 都 是 古 时 所 记 载 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10409', '13', '4', '23', '这 些 人 都 是 窑 匠 ， 是 尼 他 应 和 基 低 拉 的 居 民 ； 与 王 同 处 ， 为 王 做 工 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10410', '13', '4', '24', '西 缅 的 儿 子 是 尼 母 利 、 雅 悯 、 雅 立 、 谢 拉 、 扫 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10411', '13', '4', '25', '扫 罗 的 儿 子 是 沙 龙 ； 沙 龙 的 儿 子 是 米 比 衫 ； 米 比 衫 的 儿 子 是 米 施 玛 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10412', '13', '4', '26', '米 施 玛 的 儿 子 是 哈 母 利 ； 哈 母 利 的 儿 子 是 撒 刻 ； 撒 刻 的 儿 子 是 示 每 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10413', '13', '4', '27', '示 每 有 十 六 个 儿 子 ， 六 个 女 儿 ， 他 弟 兄 的 儿 女 不 多 ， 他 们 各 家 不 如 犹 大 族 的 人 丁 增 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10414', '13', '4', '28', '西 缅 人 住 在 别 是 巴 、 摩 拉 大 、 哈 萨 书 亚 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10415', '13', '4', '29', '辟 拉 、 以 森 、 陀 腊 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10416', '13', '4', '30', '彼 土 利 、 何 珥 玛 、 洗 革 拉 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10417', '13', '4', '31', '伯 玛 嘉 博 、 哈 萨 苏 撒 、 伯 比 利 、 沙 拉 音 ， 这 些 城 邑 直 到 大 卫 作 王 的 时 候 都 是 属 西 缅 人 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10418', '13', '4', '32', '他 们 的 五 个 城 邑 是 以 坦 、 亚 因 、 临 门 、 陀 健 、 亚 珊 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10419', '13', '4', '33', '还 有 属 城 的 乡 村 ， 直 到 巴 力 。 这 是 他 们 的 住 处 ， 他 们 都 有 家 谱 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10420', '13', '4', '34', '还 有 米 所 巴 、 雅 米 勒 、 亚 玛 谢 的 儿 子 约 沙 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10421', '13', '4', '35', '约 珥 、 约 示 比 的 儿 子 耶 户 ； 约 示 比 是 西 莱 雅 的 儿 子 ； 西 莱 雅 是 亚 薛 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10422', '13', '4', '36', '还 有 以 利 约 乃 、 雅 哥 巴 、 约 朔 海 、 亚 帅 雅 、 亚 底 业 、 耶 西 篾 、 比 拿 雅 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10423', '13', '4', '37', '示 非 的 儿 子 细 撒 。 示 非 是 亚 龙 的 儿 子 ； 亚 龙 是 耶 大 雅 的 儿 子 ； 耶 大 雅 是 申 利 的 儿 子 ； 申 利 是 示 玛 雅 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10424', '13', '4', '38', '以 上 所 记 的 人 名 都 是 作 族 长 的 ， 他 们 宗 族 的 人 数 增 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10425', '13', '4', '39', '他 们 往 平 原 东 边 基 多 口 去 ， 寻 找 牧 放 羊 群 的 草 场 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10426', '13', '4', '40', '寻 得 肥 美 的 草 场 地 ， 又 宽 阔 又 平 静 。 从 前 住 那 里 的 是 含 族 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10427', '13', '4', '41', '以 上 录 名 的 人 ， 在 犹 大 王 希 西 家 年 间 ， 来 攻 击 含 族 人 的 帐 棚 和 那 里 所 有 的 米 乌 尼 人 ， 将 他 们 灭 尽 ， 就 住 在 他 们 的 地 方 ， 直 到 今 日 ， 因 为 那 里 有 草 场 可 以 牧 放 羊 群 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10428', '13', '4', '42', '这 西 缅 人 中 ， 有 五 百 人 上 西 珥 山 ， 率 领 他 们 的 是 以 示 的 儿 子 毗 拉 提 、 尼 利 雅 、 利 法 雅 ， 和 乌 薛 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10429', '13', '4', '43', '杀 了 逃 脱 剩 下 的 亚 玛 力 人 ， 就 住 在 那 里 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10430', '13', '5', '1', '以 色 列 的 长 子 原 是 流 便 ； 因 他 污 秽 了 父 亲 的 床 ， 他 长 子 的 名 分 就 归 了 约 瑟 。 只 是 按 家 谱 他 不 算 长 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10431', '13', '5', '2', '犹 大 胜 过 一 切 弟 兄 ， 君 王 也 是 从 他 而 出 ； 长 子 的 名 分 却 归 约 瑟 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10432', '13', '5', '3', '以 色 列 长 子 流 便 的 儿 子 是 哈 诺 、 法 路 、 希 斯 伦 、 迦 米 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10433', '13', '5', '4', '约 珥 的 儿 子 是 示 玛 雅 ； 示 玛 雅 的 儿 子 是 歌 革 ； 歌 革 的 儿 子 是 示 每 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10434', '13', '5', '5', '示 每 的 儿 子 是 米 迦 ； 米 迦 的 儿 子 是 利 亚 雅 ； 利 亚 雅 的 儿 子 是 巴 力 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10435', '13', '5', '6', '巴 力 的 儿 子 是 备 拉 。 这 备 拉 作 流 便 支 派 的 首 领 ， 被 亚 述 王 提 革 拉 毗 尼 色 掳 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10436', '13', '5', '7', '他 的 弟 兄 照 着 宗 族 ， 按 着 家 谱 作 族 长 的 是 耶 利 、 撒 迦 利 雅 、 比 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10437', '13', '5', '8', '比 拉 是 亚 撒 的 儿 子 ； 亚 撒 是 示 玛 的 儿 子 ； 示 玛 是 约 珥 的 儿 子 ； 约 珥 所 住 的 地 方 是 从 亚 罗 珥 直 到 尼 波 和 巴 力 免 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10438', '13', '5', '9', '又 向 东 延 到 伯 拉 河 这 边 的 旷 野 ， 因 为 他 们 在 基 列 地 牲 畜 增 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10439', '13', '5', '10', '扫 罗 年 间 ， 他 们 与 夏 甲 人 争 战 ， 夏 甲 人 倒 在 他 们 手 下 ， 他 们 就 在 基 列 东 边 的 全 地 ， 住 在 夏 甲 人 的 帐 棚 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10440', '13', '5', '11', '迦 得 的 子 孙 在 流 便 对 面 ， 住 在 巴 珊 地 ， 延 到 撒 迦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10441', '13', '5', '12', '他 们 中 间 有 作 族 长 的 约 珥 ， 有 作 副 族 长 的 沙 番 ， 还 有 雅 乃 和 住 在 巴 珊 的 沙 法 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10442', '13', '5', '13', '他 们 族 弟 兄 是 米 迦 勒 、 米 书 兰 、 示 巴 、 约 赖 、 雅 干 、 细 亚 、 希 伯 ， 共 七 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10443', '13', '5', '14', '这 都 是 亚 比 孩 的 儿 子 。 亚 比 孩 是 户 利 的 儿 子 ； 户 利 是 耶 罗 亚 的 儿 子 ； 耶 罗 亚 是 基 列 的 儿 子 ； 基 列 是 米 迦 勒 的 儿 子 ； 米 迦 勒 是 耶 示 筛 的 儿 子 ； 耶 示 筛 是 耶 哈 多 的 儿 子 ； 耶 哈 多 是 布 斯 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10444', '13', '5', '15', '还 有 古 尼 的 孙 子 、 押 比 叠 的 儿 子 亚 希 。 这 都 是 作 族 长 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10445', '13', '5', '16', '他 们 住 在 基 列 与 巴 珊 和 巴 珊 的 乡 村 ， 并 沙 仑 的 郊 野 ， 直 到 四 围 的 交 界 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10446', '13', '5', '17', '这 些 人 在 犹 大 王 约 坦 并 在 以 色 列 王 耶 罗 波 安 年 间 ， 都 载 入 家 谱 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10447', '13', '5', '18', '流 便 人 、 迦 得 人 ， 和 玛 拿 西 半 支 派 的 人 ， 能 拿 盾 牌 和 刀 剑 、 拉 弓 射 箭 、 出 征 善 战 的 勇 士 共 有 四 万 四 千 七 百 六 十 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10448', '13', '5', '19', '他 们 与 夏 甲 人 、 伊 突 人 、 拿 非 施 人 、 挪 答 人 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10449', '13', '5', '20', '他 们 得 了 神 的 帮 助 ， 夏 甲 人 和 跟 随 夏 甲 的 人 都 交 在 他 们 手 中 ； 因 为 他 们 在 阵 上 呼 求 　 神 ， 倚 赖 神 ， 神 就 应 允 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10450', '13', '5', '21', '他 们 掳 掠 了 夏 甲 人 的 牲 畜 ， 有 骆 驼 五 万 ， 羊 二 十 五 万 ， 驴 二 千 ； 又 有 人 十 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10451', '13', '5', '22', '敌 人 被 杀 仆 倒 的 甚 多 ， 因 为 这 争 战 是 出 乎 　 神 。 他 们 就 住 在 敌 人 的 地 上 ， 直 到 被 掳 的 时 候 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10452', '13', '5', '23', '玛 拿 西 半 支 派 的 人 住 在 那 地 。 从 巴 珊 延 到 巴 力 黑 们 、 示 尼 珥 与 黑 门 山 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10453', '13', '5', '24', '他 们 的 族 长 是 以 弗 、 以 示 、 以 列 、 亚 斯 列 、 耶 利 米 、 何 达 威 雅 、 雅 叠 ， 都 是 大 能 的 勇 士 ， 是 有 名 的 人 ， 也 是 作 族 长 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10454', '13', '5', '25', '他 们 得 罪 了 他 们 列 祖 的 　 神 ， 随 从 那 地 之 民 的 　 神 行 邪 淫 ； 这 民 就 是 　 神 在 他 们 面 前 所 除 灭 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10455', '13', '5', '26', '故 此 ， 以 色 列 的 　 神 激 动 亚 述 王 普 勒 和 亚 述 王 提 革 拉 毗 尼 色 的 心 ， 他 们 就 把 流 便 人 、 迦 得 人 、 玛 拿 西 半 支 派 的 人 掳 到 哈 腊 、 哈 博 、 哈 拉 与 歌 散 河 边 ， 直 到 今 日 还 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10456', '13', '6', '1', '利 未 的 儿 子 是 革 顺 、 哥 辖 、 米 拉 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10457', '13', '6', '2', '哥 辖 的 儿 子 是 暗 兰 、 以 斯 哈 、 希 伯 伦 、 乌 薛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10458', '13', '6', '3', '暗 兰 的 儿 子 是 亚 伦 、 摩 西 ， 还 有 女 儿 米 利 暗 。 亚 伦 的 儿 子 是 拿 答 、 亚 比 户 、 以 利 亚 撒 、 以 他 玛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10459', '13', '6', '4', '以 利 亚 撒 生 非 尼 哈 ； 非 尼 哈 生 亚 比 书 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10460', '13', '6', '5', '亚 比 书 生 布 基 ； 布 基 生 乌 西 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10461', '13', '6', '6', '乌 西 生 西 拉 希 雅 ； 西 拉 希 雅 生 米 拉 约 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10462', '13', '6', '7', '米 拉 约 生 亚 玛 利 雅 ； 亚 玛 利 雅 生 亚 希 突 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10463', '13', '6', '8', '亚 希 突 生 撒 督 ； 撒 督 生 亚 希 玛 斯 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10464', '13', '6', '9', '亚 希 玛 斯 生 亚 撒 利 雅 ； 亚 撒 利 雅 生 约 哈 难 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10465', '13', '6', '10', '约 哈 难 生 亚 撒 利 雅 （ 这 亚 撒 利 雅 在 所 罗 门 於 耶 路 撒 冷 所 建 造 的 殿 中 ， 供 祭 司 的 职 分 ） ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10466', '13', '6', '11', '亚 撒 利 雅 生 亚 玛 利 雅 ； 亚 玛 利 雅 生 亚 希 突 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10467', '13', '6', '12', '亚 希 突 生 撒 督 ； 撒 督 生 沙 龙 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10468', '13', '6', '13', '沙 龙 生 希 勒 家 ； 希 勒 家 生 亚 撒 利 雅 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10469', '13', '6', '14', '亚 撒 利 雅 生 西 莱 雅 ； 西 莱 雅 生 约 萨 答 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10470', '13', '6', '15', '当 耶 和 华 藉 尼 布 甲 尼 撒 的 手 掳 掠 犹 大 和 耶 路 撒 冷 人 的 时 候 ， 这 约 萨 答 也 被 掳 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10471', '13', '6', '16', '利 未 的 儿 子 是 革 顺 、 哥 辖 、 米 拉 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10472', '13', '6', '17', '革 顺 的 儿 子 名 叫 立 尼 、 示 每 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10473', '13', '6', '18', '哥 辖 的 儿 子 是 暗 兰 、 以 斯 哈 、 希 伯 伦 、 乌 薛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10474', '13', '6', '19', '米 拉 利 的 儿 子 是 抹 利 、 母 示 。 这 是 按 着 利 未 人 宗 族 分 的 各 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10475', '13', '6', '20', '革 顺 的 儿 子 是 立 尼 ； 立 尼 的 儿 子 是 雅 哈 ； 雅 哈 的 儿 子 是 薪 玛 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10476', '13', '6', '21', '薪 玛 的 儿 子 是 约 亚 ； 约 亚 的 儿 子 是 易 多 ； 易 多 的 儿 子 是 谢 拉 ； 谢 拉 的 儿 子 是 耶 特 赖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10477', '13', '6', '22', '哥 辖 的 儿 子 是 亚 米 拿 达 ； 亚 米 拿 达 的 儿 子 是 可 拉 ； 可 拉 的 儿 子 是 亚 惜 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10478', '13', '6', '23', '亚 惜 的 儿 子 是 以 利 加 拿 ； 以 利 加 拿 的 儿 子 是 以 比 雅 撒 ； 以 比 雅 撒 的 儿 子 是 亚 惜 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10479', '13', '6', '24', '亚 惜 的 儿 子 是 他 哈 ； 他 哈 的 儿 子 是 乌 列 ； 乌 列 的 儿 子 是 乌 西 雅 ； 乌 西 雅 的 儿 子 是 少 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10480', '13', '6', '25', '以 利 加 拿 的 儿 子 是 亚 玛 赛 和 亚 希 摩 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10481', '13', '6', '26', '亚 希 摩 的 儿 子 是 以 利 加 拿 ； 以 利 加 拿 的 儿 子 是 琐 菲 ； 琐 菲 的 儿 子 是 拿 哈 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10482', '13', '6', '27', '拿 哈 的 儿 子 是 以 利 押 ； 以 利 押 的 儿 子 是 耶 罗 罕 ； 耶 罗 罕 的 儿 子 是 以 利 加 拿 ； 以 利 加 拿 的 儿 子 是 撒 母 耳 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10483', '13', '6', '28', '撒 母 耳 的 长 子 是 约 珥 ， 次 子 是 亚 比 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10484', '13', '6', '29', '米 拉 利 的 儿 子 是 抹 利 ； 抹 利 的 儿 子 是 立 尼 ； 立 尼 的 儿 子 是 示 每 ； 示 每 的 儿 子 是 乌 撒 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10485', '13', '6', '30', '乌 撒 的 儿 子 是 示 米 亚 ； 示 米 亚 的 儿 子 是 哈 基 雅 ； 哈 基 雅 的 儿 子 是 亚 帅 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10486', '13', '6', '31', '约 柜 安 设 之 後 ， 大 卫 派 人 在 耶 和 华 殿 中 管 理 歌 唱 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10487', '13', '6', '32', '他 们 就 在 会 幕 前 当 歌 唱 的 差 ， 及 至 所 罗 门 在 耶 路 撒 冷 建 造 了 耶 和 华 的 殿 ， 他 们 便 按 着 班 次 供 职 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10488', '13', '6', '33', '供 职 的 人 和 他 们 的 子 孙 记 在 下 面 ： 哥 辖 的 子 孙 中 有 歌 唱 的 希 幔 。 希 幔 是 约 珥 的 儿 子 ； 约 珥 是 撒 母 耳 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10489', '13', '6', '34', '撒 母 耳 是 以 利 加 拿 的 儿 子 ； 以 利 加 拿 是 耶 罗 罕 的 儿 子 ； 耶 罗 罕 是 以 列 的 儿 子 ； 以 列 是 陀 亚 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10490', '13', '6', '35', '陀 亚 是 苏 弗 的 儿 子 ； 苏 弗 是 以 利 加 拿 的 儿 子 ； 以 利 加 拿 是 玛 哈 的 儿 子 ； 玛 哈 是 亚 玛 赛 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10491', '13', '6', '36', '亚 玛 赛 是 以 利 加 拿 的 儿 子 ； 以 利 加 拿 是 约 珥 的 儿 子 ； 约 珥 是 亚 撒 利 雅 的 儿 子 ； 亚 撒 利 雅 是 西 番 雅 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10492', '13', '6', '37', '西 番 雅 是 他 哈 的 儿 子 ； 他 哈 是 亚 惜 的 儿 子 ； 亚 惜 是 以 比 雅 撒 的 儿 子 ； 以 比 雅 撒 是 可 拉 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10493', '13', '6', '38', '可 拉 是 以 斯 哈 的 儿 子 ； 以 斯 哈 是 哥 辖 的 儿 子 ； 哥 辖 是 利 未 的 儿 子 ； 利 未 是 以 色 列 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10494', '13', '6', '39', '希 幔 的 族 兄 亚 萨 是 比 利 家 的 儿 子 ， 亚 萨 在 希 幔 右 边 供 职 。 比 利 家 是 示 米 亚 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10495', '13', '6', '40', '示 米 亚 是 米 迦 勒 的 儿 子 ； 米 迦 勒 是 巴 西 雅 的 儿 子 ； 巴 西 雅 是 玛 基 雅 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10496', '13', '6', '41', '玛 基 雅 是 伊 特 尼 的 儿 子 ； 伊 特 尼 是 谢 拉 的 儿 子 ； 谢 拉 是 亚 大 雅 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10497', '13', '6', '42', '亚 大 雅 是 以 探 的 儿 子 ； 以 探 是 薪 玛 的 儿 子 ； 薪 玛 是 示 每 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10498', '13', '6', '43', '示 每 是 雅 哈 的 儿 子 ； 雅 哈 是 革 顺 的 儿 子 。 革 顺 是 利 未 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10499', '13', '6', '44', '他 们 的 族 弟 兄 米 拉 利 的 子 孙 ， 在 他 们 左 边 供 职 的 有 以 探 。 以 探 是 基 示 的 儿 子 ； 基 示 是 亚 伯 底 的 儿 子 ； 亚 伯 底 是 玛 鹿 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10500', '13', '6', '45', '玛 鹿 是 哈 沙 比 雅 的 儿 子 ； 哈 沙 比 雅 是 亚 玛 谢 的 儿 子 ； 亚 玛 谢 是 希 勒 家 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10501', '13', '6', '46', '希 勒 家 是 暗 西 的 儿 子 ； 暗 西 是 巴 尼 的 儿 子 ； 巴 尼 是 沙 麦 的 儿 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10502', '13', '6', '47', '沙 麦 是 末 力 的 儿 子 ； 末 力 是 母 示 的 儿 子 ； 母 示 是 米 拉 利 的 儿 子 ； 米 拉 利 是 利 未 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10503', '13', '6', '48', '他 们 的 族 弟 兄 利 未 人 也 被 派 办 　 神 殿 中 的 一 切 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10504', '13', '6', '49', '亚 伦 和 他 的 子 孙 在 燔 祭 坛 和 香 坛 上 献 祭 烧 香 ， 又 在 至 圣 所 办 理 一 切 的 事 ， 为 以 色 列 人 赎 罪 ， 是 照 　 神 仆 人 摩 西 所 吩 咐 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10505', '13', '6', '50', '亚 伦 的 儿 子 是 以 利 亚 撒 ； 以 利 亚 撒 的 儿 子 是 非 尼 哈 ； 非 尼 哈 的 儿 子 是 亚 比 书 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10506', '13', '6', '51', '亚 比 书 的 儿 子 是 布 基 ； 布 基 的 儿 子 是 乌 西 ； 乌 西 的 儿 子 是 西 拉 希 雅 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10507', '13', '6', '52', '西 拉 希 雅 的 儿 子 是 米 拉 约 ； 米 拉 约 的 儿 子 是 亚 玛 利 雅 ； 亚 玛 利 雅 的 儿 子 是 亚 希 突 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10508', '13', '6', '53', '亚 希 突 的 儿 子 是 撒 督 ； 撒 督 的 儿 子 是 亚 希 玛 斯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10509', '13', '6', '54', '他 们 的 住 处 按 着 境 内 的 营 寨 ， 记 在 下 面 ： 哥 辖 族 亚 伦 的 子 孙 先 拈 阄 得 地 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10510', '13', '6', '55', '在 犹 大 地 中 得 了 希 伯 仑 和 四 围 的 郊 野 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10511', '13', '6', '56', '只 是 属 城 的 田 地 和 村 庄 都 为 耶 孚 尼 的 儿 子 迦 勒 所 得 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10512', '13', '6', '57', '亚 伦 的 子 孙 得 了 逃 城 希 伯 仑 ， 又 得 了 立 拿 与 其 郊 野 ， 雅 提 珥 、 以 实 提 莫 与 其 郊 野 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10513', '13', '6', '58', '希 仑 与 其 郊 野 ， 底 璧 与 其 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10514', '13', '6', '59', '亚 珊 与 其 郊 野 ， 伯 示 麦 与 其 郊 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10515', '13', '6', '60', '在 便 雅 悯 支 派 的 地 中 ， 得 了 迦 巴 与 其 郊 野 ， 阿 勒 篾 与 其 郊 野 ， 亚 拿 突 与 其 郊 野 。 他 们 诸 家 所 得 的 城 共 十 三 座 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10516', '13', '6', '61', '哥 辖 族 其 馀 的 人 又 拈 阄 ， 在 玛 拿 西 半 支 派 的 地 中 得 了 十 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10517', '13', '6', '62', '革 顺 族 按 着 宗 族 ， 在 以 萨 迦 支 派 的 地 中 ， 亚 设 支 派 的 地 中 ， 拿 弗 他 利 支 派 的 地 中 ， 巴 珊 内 玛 拿 西 支 派 的 地 中 ， 得 了 十 三 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10518', '13', '6', '63', '米 拉 利 族 按 着 宗 族 拈 阄 ， 在 流 便 支 派 的 地 中 ， 迦 得 支 派 的 地 中 ， 西 布 伦 支 派 的 地 中 ， 得 了 十 二 座 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10519', '13', '6', '64', '以 色 列 人 将 这 些 城 与 其 郊 野 给 了 利 未 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10520', '13', '6', '65', '这 以 上 录 名 的 城 ， 在 犹 大 、 西 缅 、 便 雅 悯 三 支 派 的 地 中 ， 以 色 列 人 拈 阄 给 了 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10521', '13', '6', '66', '哥 辖 族 中 有 几 家 在 以 法 莲 支 派 的 地 中 也 得 了 城 邑 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10522', '13', '6', '67', '在 以 法 莲 山 地 得 了 逃 城 示 剑 与 其 郊 野 ， 又 得 了 基 色 与 其 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10523', '13', '6', '68', '约 缅 与 其 郊 野 ， 伯 和 仑 与 其 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10524', '13', '6', '69', '亚 雅 仑 与 其 郊 野 ， 迦 特 临 门 与 其 郊 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10525', '13', '6', '70', '哥 辖 族 其 馀 的 人 在 玛 拿 西 半 支 派 的 地 中 得 了 亚 乃 与 其 郊 野 ， 比 连 与 其 郊 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10526', '13', '6', '71', '革 顺 族 在 玛 拿 西 半 支 派 的 地 中 得 了 巴 珊 的 哥 兰 与 其 郊 野 ， 亚 斯 他 录 与 其 郊 野 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10527', '13', '6', '72', '又 在 以 萨 迦 支 派 的 地 中 得 了 基 低 斯 与 其 郊 野 ， 大 比 拉 与 其 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10528', '13', '6', '73', '拉 末 与 其 郊 野 ， 亚 年 与 其 郊 野 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10529', '13', '6', '74', '在 亚 设 支 派 的 地 中 得 了 玛 沙 与 其 郊 野 ， 押 顿 与 其 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10530', '13', '6', '75', '户 割 与 其 郊 野 ， 利 合 与 其 郊 野 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10531', '13', '6', '76', '在 拿 弗 他 利 支 派 的 地 中 得 了 加 利 利 的 基 低 斯 与 其 郊 野 ， 哈 们 与 其 郊 野 ， 基 列 亭 与 其 郊 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10532', '13', '6', '77', '还 有 米 拉 利 族 的 人 在 西 布 伦 支 派 的 地 中 得 了 临 摩 挪 与 其 郊 野 ， 他 泊 与 其 郊 野 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10533', '13', '6', '78', '又 在 耶 利 哥 的 约 但 河 东 ， 在 流 便 支 派 的 地 中 得 了 旷 野 的 比 悉 与 其 郊 野 ， 雅 哈 撒 与 其 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10534', '13', '6', '79', '基 底 莫 与 其 郊 野 ， 米 法 押 与 其 郊 野 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10535', '13', '6', '80', '又 在 迦 得 支 派 的 地 中 得 了 基 列 的 拉 末 与 其 郊 野 ， 玛 哈 念 与 其 郊 野 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10536', '13', '6', '81', '希 实 本 与 其 郊 野 ， 雅 谢 与 其 郊 野 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10537', '13', '7', '1', '以 萨 迦 的 儿 子 是 陀 拉 、 普 瓦 、 雅 述 ( 创 四 六13 是 约 伯 ) 、 伸 仑 ， 共 四 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10538', '13', '7', '2', '陀 拉 的 儿 子 是 乌 西 、 利 法 雅 、 耶 勒 、 雅 买 、 易 伯 散 、 示 母 利 ， 都 是 陀 拉 的 族 长 ， 是 大 能 的 勇 士 。 到 大 卫 年 间 ， 他 们 的 人 数 共 有 二 万 二 千 六 百 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10539', '13', '7', '3', '乌 西 的 儿 子 是 伊 斯 拉 希 ； 伊 斯 拉 希 的 儿 子 是 米 迦 勒 、 俄 巴 底 亚 、 约 珥 、 伊 示 雅 ， 共 五 人 ， 都 是 族 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10540', '13', '7', '4', '他 们 所 率 领 的 ， 按 着 宗 族 出 战 的 军 队 ， 共 有 三 万 六 千 人 ， 因 为 他 们 的 妻 和 子 众 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10541', '13', '7', '5', '他 们 的 族 弟 兄 在 以 萨 迦 各 族 中 都 是 大 能 的 勇 士 ， 按 着 家 谱 计 算 共 有 八 万 七 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10542', '13', '7', '6', '便 雅 悯 的 儿 子 是 比 拉 、 比 结 、 耶 叠 ， 共 三 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10543', '13', '7', '7', '比 拉 的 儿 子 是 以 斯 本 、 乌 西 、 乌 薛 、 耶 利 摩 、 以 利 ， 共 五 人 ， 都 是 族 长 ， 是 大 能 的 勇 士 。 按 着 家 谱 计 算 ， 他 们 的 子 孙 共 有 二 万 二 千 零 三 十 四 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10544', '13', '7', '8', '比 结 的 儿 子 是 细 米 拉 、 约 阿 施 、 以 利 以 谢 、 以 利 约 乃 、 暗 利 、 耶 利 摩 、 亚 比 雅 、 亚 拿 突 、 亚 拉 篾 。 这 都 是 比 结 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10545', '13', '7', '9', '他 们 都 是 族 长 ， 是 大 能 的 勇 士 。 按 着 家 谱 计 算 ， 他 们 的 子 孙 共 有 二 万 零 二 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10546', '13', '7', '10', '耶 叠 的 儿 子 是 比 勒 罕 ； 比 勒 罕 的 儿 子 是 耶 乌 施 、 便 雅 悯 、 以 忽 、 基 拿 拿 、 细 坦 、 他 施 、 亚 希 沙 哈 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10547', '13', '7', '11', '这 都 是 耶 叠 的 儿 子 ， 都 是 族 长 ， 是 大 能 的 勇 士 ； 他 们 的 子 孙 能 上 阵 打 仗 的 ， 共 有 一 万 七 千 二 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10548', '13', '7', '12', '还 有 以 珥 的 儿 子 书 品 、 户 品 ， 并 亚 黑 的 儿 子 户 伸 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10549', '13', '7', '13', '拿 弗 他 利 的 儿 子 是 雅 薛 、 沽 尼 、 耶 色 、 沙 龙 。 这 都 是 辟 拉 的 子 孙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10550', '13', '7', '14', '玛 拿 西 的 儿 子 亚 斯 列 是 他 妾 亚 兰 人 所 生 的 ， 又 生 了 基 列 之 父 玛 吉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10551', '13', '7', '15', '玛 吉 娶 的 妻 是 户 品 、 书 品 的 妹 子 ， 名 叫 玛 迦 。 玛 拿 西 的 次 子 名 叫 西 罗 非 哈 ； 西 罗 非 哈 但 有 几 个 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10552', '13', '7', '16', '玛 吉 的 妻 玛 迦 生 了 一 个 儿 子 ， 起 名 叫 毗 利 施 。 毗 利 施 的 兄 弟 名 叫 示 利 施 ； 示 利 施 的 儿 子 是 乌 兰 和 利 金 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10553', '13', '7', '17', '乌 兰 的 儿 子 是 比 但 。 这 都 是 基 列 的 子 孙 。 基 列 是 玛 吉 的 儿 子 ， 玛 吉 是 玛 拿 西 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10554', '13', '7', '18', '基 列 的 妹 子 哈 摩 利 吉 生 了 伊 施 荷 、 亚 比 以 谢 、 玛 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10555', '13', '7', '19', '〈 示 米 大 的 儿 子 是 亚 现 、 示 剑 、 利 克 希 、 阿 尼 安 。 〉');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10556', '13', '7', '20', '以 法 莲 的 儿 子 是 书 提 拉 ； 书 提 拉 的 儿 子 是 比 列 ； 比 列 的 儿 子 是 他 哈 ； 他 哈 的 儿 子 是 以 拉 大 ； 以 拉 大 的 儿 子 是 他 哈 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10557', '13', '7', '21', '他 哈 的 儿 子 是 撒 拔 ； 撒 拔 的 儿 子 是 书 提 拉 。 以 法 莲 又 生 以 谢 、 以 列 ； 这 二 人 因 为 下 去 夺 取 迦 特 人 的 牲 畜 ， 被 本 地 的 迦 特 人 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10558', '13', '7', '22', '他 们 的 父 亲 以 法 莲 为 他 们 悲 哀 了 多 日 ， 他 的 弟 兄 都 来 安 慰 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10559', '13', '7', '23', '以 法 莲 与 妻 同 房 ， 他 妻 就 怀 孕 生 了 一 子 ， 以 法 莲 因 为 家 里 遭 祸 ， 就 给 这 儿 子 起 名 叫 比 利 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10560', '13', '7', '24', '他 的 女 儿 名 叫 舍 伊 拉 ， 就 是 建 筑 上 伯 和 仑 、 下 伯 和 仑 与 乌 羡 舍 伊 拉 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10561', '13', '7', '25', '比 利 阿 的 儿 子 是 利 法 和 利 悉 。 利 悉 的 儿 子 是 他 拉 ； 他 拉 的 儿 子 是 他 罕 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10562', '13', '7', '26', '他 罕 的 儿 子 是 拉 但 ； 拉 但 的 儿 子 是 亚 米 忽 ； 亚 米 忽 的 儿 子 是 以 利 沙 玛 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10563', '13', '7', '27', '以 利 沙 玛 的 儿 子 是 嫩 ； 嫩 的 儿 子 是 约 书 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10564', '13', '7', '28', '以 法 莲 人 的 地 业 和 住 处 是 伯 特 利 与 其 村 庄 ； 东 边 拿 兰 ， 西 边 基 色 与 其 村 庄 ； 示 剑 与 其 村 庄 ， 直 到 迦 萨 与 其 村 庄 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10565', '13', '7', '29', '还 有 靠 近 玛 拿 西 人 的 境 界 ， 伯 善 与 其 村 庄 ； 他 纳 与 其 村 庄 ； 米 吉 多 与 其 村 庄 ； 多 珥 与 其 村 庄 。 以 色 列 儿 子 约 瑟 的 子 孙 住 在 这 些 地 方 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10566', '13', '7', '30', '亚 设 的 儿 子 是 音 拿 、 亦 施 瓦 、 亦 施 韦 、 比 利 亚 ， 还 有 他 们 的 妹 子 西 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10567', '13', '7', '31', '比 利 亚 的 儿 子 是 希 别 、 玛 结 ； 玛 结 是 比 撒 威 的 父 亲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10568', '13', '7', '32', '希 别 生 雅 弗 勒 、 朔 默 、 何 坦 ， 和 他 们 的 妹 子 书 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10569', '13', '7', '33', '雅 弗 勒 的 儿 子 是 巴 萨 、 宾 哈 、 亚 施 法 。 这 都 是 雅 弗 勒 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10570', '13', '7', '34', '朔 默 的 儿 子 是 亚 希 、 罗 迦 、 耶 户 巴 、 亚 兰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10571', '13', '7', '35', '朔 默 兄 弟 希 连 的 儿 子 是 琐 法 、 音 那 、 示 利 斯 、 亚 抹 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10572', '13', '7', '36', '琐 法 的 儿 子 是 书 亚 、 哈 尼 弗 、 书 阿 勒 、 比 利 、 音 拉 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10573', '13', '7', '37', '比 悉 、 河 得 、 珊 玛 、 施 沙 、 益 兰 、 比 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10574', '13', '7', '38', '益 帖 的 儿 子 是 耶 孚 尼 、 毗 斯 巴 、 亚 拉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10575', '13', '7', '39', '乌 拉 的 儿 子 是 亚 拉 、 汉 尼 业 、 利 写 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10576', '13', '7', '40', '这 都 是 亚 设 的 子 孙 ， 都 是 族 长 ， 是 精 壮 大 能 的 勇 士 ， 也 是 首 领 中 的 头 目 ， 按 着 家 谱 计 算 ， 他 们 的 子 孙 能 出 战 的 共 有 二 万 六 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10577', '13', '8', '1', '便 雅 悯 的 长 子 比 拉 ， 次 子 亚 实 别 ， 三 子 亚 哈 拉 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10578', '13', '8', '2', '四 子 挪 哈 ， 五 子 拉 法 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10579', '13', '8', '3', '比 拉 的 儿 子 是 亚 大 、 基 拉 、 亚 比 忽 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10580', '13', '8', '4', '亚 比 书 、 乃 幔 、 亚 何 亚 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10581', '13', '8', '5', '基 拉 、 示 孚 汛 、 户 兰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10582', '13', '8', '6', '以 忽 的 儿 子 作 迦 巴 居 民 的 族 长 ， 被 掳 到 玛 拿 辖 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10583', '13', '8', '7', '以 忽 的 儿 子 乃 幔 、 亚 希 亚 、 基 拉 也 被 掳 去 。 基 拉 生 乌 撒 、 亚 希 忽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10584', '13', '8', '8', '沙 哈 连 休 他 二 妻 户 伸 和 巴 拉 之 後 ， 在 摩 押 地 生 了 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10585', '13', '8', '9', '他 与 妻 贺 得 同 房 ， 生 了 约 巴 、 洗 比 雅 、 米 沙 、 玛 拉 干 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10586', '13', '8', '10', '耶 乌 斯 、 沙 迦 、 米 玛 。 他 这 些 儿 子 都 是 族 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10587', '13', '8', '11', '他 的 妻 户 伸 给 他 生 的 儿 子 有 亚 比 突 、 以 利 巴 力 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10588', '13', '8', '12', '以 利 巴 力 的 儿 子 是 希 伯 、 米 珊 、 沙 麦 。 沙 麦 建 立 阿 挪 和 罗 德 二 城 与 其 村 庄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10589', '13', '8', '13', '又 有 比 利 亚 和 示 玛 是 亚 雅 仑 居 民 的 族 长 ， 是 驱 逐 迦 特 人 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10590', '13', '8', '14', '亚 希 约 、 沙 煞 、 耶 利 末 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10591', '13', '8', '15', '西 巴 第 雅 、 亚 拉 得 、 亚 得 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10592', '13', '8', '16', '米 迦 勒 、 伊 施 巴 、 约 哈 都 是 比 利 亚 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10593', '13', '8', '17', '西 巴 第 雅 、 米 书 兰 、 希 西 基 、 希 伯 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10594', '13', '8', '18', '伊 施 米 莱 、 伊 斯 利 亚 、 约 巴 都 是 以 利 巴 力 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10595', '13', '8', '19', '雅 金 、 细 基 利 、 撒 底 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10596', '13', '8', '20', '以 利 乃 、 洗 勒 太 、 以 列 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10597', '13', '8', '21', '亚 大 雅 、 比 拉 雅 、 申 拉 都 是 示 每 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10598', '13', '8', '22', '伊 施 班 、 希 伯 、 以 列 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10599', '13', '8', '23', '亚 伯 顿 、 细 基 利 、 哈 难 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10600', '13', '8', '24', '哈 拿 尼 雅 、 以 拦 、 安 陀 提 雅 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10601', '13', '8', '25', '伊 弗 底 雅 、 毗 努 伊 勒 都 是 沙 煞 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10602', '13', '8', '26', '珊 示 莱 、 示 哈 利 、 亚 他 利 雅 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10603', '13', '8', '27', '雅 利 西 、 以 利 亚 、 细 基 利 都 是 耶 罗 罕 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10604', '13', '8', '28', '这 些 人 都 是 着 名 的 族 长 ， 住 在 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10605', '13', '8', '29', '在 基 遍 住 的 有 基 遍 的 父 亲 耶 利 。 他 的 妻 名 叫 玛 迦 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10606', '13', '8', '30', '他 长 子 是 亚 伯 顿 。 他 又 生 苏 珥 、 基 士 、 巴 力 、 拿 答 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10607', '13', '8', '31', '基 多 、 亚 希 约 、 撒 迦 、 米 基 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10608', '13', '8', '32', '米 基 罗 生 示 米 暗 。 这 些 人 和 他 们 的 弟 兄 在 耶 路 撒 冷 对 面 居 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10609', '13', '8', '33', '尼 珥 生 基 士 ； 基 士 生 扫 罗 ； 扫 罗 生 约 拿 单 、 麦 基 舒 亚 、 亚 比 拿 达 、 伊 施 巴 力 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10610', '13', '8', '34', '约 拿 单 的 儿 子 是 米 力 巴 力 ( 撒 下 四 章 四 节 作 米 非 波 设 ) ； 米 力 巴 力 生 米 迦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10611', '13', '8', '35', '米 迦 的 儿 子 是 毗 敦 、 米 勒 、 他 利 亚 、 亚 哈 斯 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10612', '13', '8', '36', '亚 哈 斯 生 耶 何 阿 达 ； 耶 何 阿 达 生 亚 拉 篾 、 亚 斯 玛 威 、 心 利 ； 心 利 生 摩 撒 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10613', '13', '8', '37', '摩 撒 生 比 尼 亚 ； 比 尼 亚 的 儿 子 是 拉 法 ； 拉 法 的 儿 子 是 以 利 亚 萨 ； 以 利 亚 萨 的 儿 子 是 亚 悉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10614', '13', '8', '38', '亚 悉 有 六 个 儿 子 ， 他 们 的 名 字 是 亚 斯 利 干 、 波 基 路 、 以 实 玛 利 、 示 亚 利 雅 、 俄 巴 底 雅 、 哈 难 。 这 都 是 亚 悉 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10615', '13', '8', '39', '亚 悉 兄 弟 以 设 的 长 子 是 乌 兰 ， 次 子 耶 乌 施 ， 三 子 是 以 利 法 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10616', '13', '8', '40', '乌 兰 的 儿 子 都 是 大 能 的 勇 士 ， 是 弓 箭 手 ， 他 们 有 许 多 的 子 孙 ， 共 一 百 五 十 名 ， 都 是 便 雅 悯 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10617', '13', '9', '1', '以 色 列 人 都 按 家 谱 计 算 ， 写 在 以 色 列 诸 王 记 上 。 犹 大 人 因 犯 罪 就 被 掳 到 巴 比 伦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10618', '13', '9', '2', '先 从 巴 比 伦 回 来 ， 住 在 自 己 地 业 城 邑 中 的 有 以 色 列 人 、 祭 司 、 利 未 人 、 尼 提 宁 的 首 领 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10619', '13', '9', '3', '住 在 耶 路 撒 冷 的 有 犹 大 人 、 便 雅 悯 人 、 以 法 莲 人 、 玛 拿 西 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10620', '13', '9', '4', '犹 大 儿 子 法 勒 斯 的 子 孙 中 有 乌 太 。 乌 太 是 亚 米 忽 的 儿 子 ； 亚 米 忽 是 暗 利 的 儿 子 ； 暗 利 是 音 利 的 儿 子 ； 音 利 是 巴 尼 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10621', '13', '9', '5', '示 罗 的 子 孙 中 有 长 子 亚 帅 雅 和 他 的 众 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10622', '13', '9', '6', '谢 拉 的 子 孙 中 有 耶 乌 利 和 他 的 弟 兄 ， 共 六 百 九 十 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10623', '13', '9', '7', '便 雅 悯 人 中 有 哈 西 努 的 曾 孙 、 何 达 威 雅 的 孙 子 、 米 书 兰 的 儿 子 撒 路 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10624', '13', '9', '8', '又 有 耶 罗 罕 的 儿 子 伊 比 尼 雅 ， 米 基 立 的 孙 子 、 乌 西 的 儿 子 以 拉 ， 伊 比 尼 雅 的 曾 孙 、 流 珥 的 孙 子 、 示 法 提 雅 的 儿 子 米 书 兰 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10625', '13', '9', '9', '和 他 们 的 族 弟 兄 ， 按 着 家 谱 计 算 共 有 九 百 五 十 六 名 。 这 些 人 都 是 他 们 的 族 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10626', '13', '9', '10', '祭 司 中 有 耶 大 雅 、 耶 何 雅 立 、 雅 斤 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10627', '13', '9', '11', '还 有 管 理 　 神 殿 希 勒 家 的 儿 子 亚 萨 利 雅 。 希 勒 家 是 米 书 兰 的 儿 子 ； 米 书 兰 是 撒 督 的 儿 子 ； 撒 督 是 米 拉 约 的 儿 子 ； 米 拉 约 是 亚 希 突 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10628', '13', '9', '12', '有 玛 基 雅 的 曾 孙 、 巴 施 户 珥 的 孙 子 、 耶 罗 罕 的 儿 子 亚 大 雅 ， 又 有 亚 第 业 的 儿 子 玛 赛 ； 亚 第 业 是 雅 希 细 拉 的 儿 子 ； 雅 希 细 拉 是 米 书 兰 的 儿 子 ； 米 书 兰 是 米 实 利 密 的 儿 子 ； 米 实 利 密 是 音 麦 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10629', '13', '9', '13', '他 们 和 众 弟 兄 都 是 族 长 ， 共 有 一 千 七 百 六 十 人 ， 是 善 於 做 　 神 殿 使 用 之 工 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10630', '13', '9', '14', '利 未 人 米 拉 利 的 子 孙 中 ， 有 哈 沙 比 雅 的 曾 孙 、 押 利 甘 的 孙 子 、 哈 述 的 儿 子 示 玛 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10631', '13', '9', '15', '有 拔 巴 甲 、 黑 勒 施 、 迦 拉 ， 并 亚 萨 的 曾 孙 、 细 基 利 的 孙 子 、 米 迦 的 儿 子 玛 探 雅 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10632', '13', '9', '16', '又 有 耶 杜 顿 的 曾 孙 、 迦 拉 的 孙 子 、 示 玛 雅 的 儿 子 俄 巴 底 ， 还 有 以 利 加 拿 的 孙 子 、 亚 撒 的 儿 子 比 利 家 。 他 们 都 住 在 尼 陀 法 人 的 村 庄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10633', '13', '9', '17', '守 门 的 是 沙 龙 、 亚 谷 、 达 们 、 亚 希 幔 ， 和 他 们 的 弟 兄 ； 沙 龙 为 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10634', '13', '9', '18', '从 前 这 些 人 看 守 朝 东 的 王 门 ， 如 今 是 利 未 营 中 守 门 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10635', '13', '9', '19', '可 拉 的 曾 孙 、 以 比 雅 撒 的 孙 子 、 可 利 的 儿 子 沙 龙 ， 和 他 的 族 弟 兄 可 拉 人 都 管 理 使 用 之 工 ， 并 守 会 幕 的 门 。 他 们 的 祖 宗 曾 管 理 耶 和 华 的 营 盘 ， 又 把 守 营 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10636', '13', '9', '20', '从 前 以 利 亚 撒 的 儿 子 非 尼 哈 管 理 他 们 ， 耶 和 华 也 与 他 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10637', '13', '9', '21', '米 施 利 米 雅 的 儿 子 撒 迦 利 雅 是 看 守 会 幕 之 门 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10638', '13', '9', '22', '被 选 守 门 的 人 共 有 二 百 一 十 二 名 。 他 们 在 自 己 的 村 庄 ， 按 着 家 谱 计 算 ， 是 大 卫 和 先 见 撒 母 耳 所 派 当 这 紧 要 职 任 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10639', '13', '9', '23', '他 们 和 他 们 的 子 孙 按 着 班 次 看 守 耶 和 华 殿 的 门 ， 就 是 会 幕 的 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10640', '13', '9', '24', '在 东 西 南 北 ， 四 方 都 有 守 门 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10641', '13', '9', '25', '他 们 的 族 弟 兄 住 在 村 庄 ， 每 七 日 来 与 他 们 换 班 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10642', '13', '9', '26', '这 四 个 门 领 都 是 利 未 人 ， 各 有 紧 要 的 职 任 ， 看 守 　 神 殿 的 仓 库 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10643', '13', '9', '27', '他 们 住 在 　 神 殿 的 四 围 ， 是 因 委 托 他 们 守 殿 ， 要 每 日 早 晨 开 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10644', '13', '9', '28', '利 未 人 中 有 管 理 使 用 器 皿 的 ， 按 着 数 目 拿 出 拿 入 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10645', '13', '9', '29', '又 有 人 管 理 器 具 和 圣 所 的 器 皿 ， 并 细 面 、 酒 、 油 、 乳 香 、 香 料 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10646', '13', '9', '30', '祭 司 中 有 人 用 香 料 做 膏 油 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10647', '13', '9', '31', '利 未 人 玛 他 提 雅 是 可 拉 族 沙 龙 的 长 子 ， 他 紧 要 的 职 任 是 管 理 盘 中 烤 的 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10648', '13', '9', '32', '他 们 族 弟 兄 哥 辖 子 孙 中 ， 有 管 理 陈 设 饼 的 ， 每 安 息 日 预 备 摆 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10649', '13', '9', '33', '歌 唱 的 有 利 未 人 的 族 长 ， 住 在 属 殿 的 房 屋 ， 昼 夜 供 职 ， 不 做 别 样 的 工 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10650', '13', '9', '34', '以 上 都 是 利 未 人 着 名 的 族 长 ， 住 在 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10651', '13', '9', '35', '在 基 遍 住 的 有 基 遍 的 父 亲 耶 利 。 他 的 妻 名 叫 玛 迦 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10652', '13', '9', '36', '他 长 子 是 亚 伯 顿 。 他 又 生 苏 珥 、 基 士 、 巴 力 、 尼 珥 、 拿 答 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10653', '13', '9', '37', '基 多 、 亚 希 约 、 撒 迦 利 雅 、 米 基 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10654', '13', '9', '38', '米 基 罗 生 示 米 暗 。 这 些 人 和 他 们 的 弟 兄 在 耶 路 撒 冷 对 面 居 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10655', '13', '9', '39', '尼 珥 生 基 士 ； 基 士 生 扫 罗 ； 扫 罗 生 约 拿 单 、 麦 基 舒 亚 、 亚 比 拿 达 、 伊 施 巴 力 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10656', '13', '9', '40', '约 拿 单 的 儿 子 是 米 力 巴 力 ( 即 米 非 波 设 ) ； 米 力 巴 力 生 米 迦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10657', '13', '9', '41', '米 迦 的 儿 子 是 毗 敦 、 米 勒 、 他 利 亚 、 亚 哈 斯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10658', '13', '9', '42', '亚 哈 斯 生 雅 拉 ； 雅 拉 生 亚 拉 篾 、 亚 斯 玛 威 、 心 利 ； 心 利 生 摩 撒 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10659', '13', '9', '43', '摩 撒 生 比 尼 亚 ； 比 尼 亚 生 利 法 雅 ； 利 法 雅 的 儿 子 是 以 利 亚 萨 ； 以 利 亚 萨 的 儿 子 是 亚 悉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10660', '13', '9', '44', '亚 悉 有 六 个 儿 子 ， 他 们 的 名 字 是 亚 斯 利 干 、 波 基 路 、 以 实 玛 利 、 示 亚 利 雅 、 俄 巴 底 雅 、 哈 难 。 这 都 是 亚 悉 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10661', '13', '10', '1', '非 利 士 人 与 以 色 列 人 争 战 ， 以 色 列 人 在 非 利 士 人 面 前 逃 跑 ， 在 基 利 波 山 有 被 杀 仆 倒 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10662', '13', '10', '2', '非 利 士 人 紧 追 扫 罗 和 他 儿 子 们 ， 就 杀 了 扫 罗 的 儿 子 约 拿 单 、 亚 比 拿 达 、 麦 基 舒 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10663', '13', '10', '3', '势 派 甚 大 ， 扫 罗 被 弓 箭 手 追 上 ， 射 伤 甚 重 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10664', '13', '10', '4', '就 吩 咐 拿 他 兵 器 的 人 说 ： 你 拔 出 刀 来 ， 将 我 刺 死 ， 免 得 那 些 未 受 割 礼 的 人 来 凌 辱 我 。 但 拿 兵 器 的 人 甚 惧 怕 ， 不 肯 刺 他 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10665', '13', '10', '5', '扫 罗 就 自 己 伏 在 刀 上 死 了 。 拿 兵 器 的 人 见 扫 罗 已 死 ， 也 伏 在 刀 上 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10666', '13', '10', '6', '这 样 ， 扫 罗 和 他 三 个 儿 子 ， 并 他 的 全 家 都 一 同 死 亡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10667', '13', '10', '7', '住 平 原 的 以 色 列 众 人 见 以 色 列 军 兵 逃 跑 ， 扫 罗 和 他 儿 子 都 死 了 ， 也 就 弃 城 逃 跑 ， 非 利 士 人 便 来 住 在 其 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10668', '13', '10', '8', '次 日 ， 非 利 士 人 来 剥 那 被 杀 之 人 的 衣 服 ， 看 见 扫 罗 和 他 儿 子 仆 倒 在 基 利 波 山 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10669', '13', '10', '9', '就 剥 了 他 的 军 装 ， 割 下 他 的 首 级 ， 打 发 人 到 ( 或 作 送 到 ) 非 利 士 地 的 四 境 报 信 与 他 们 的 偶 像 和 众 民 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10670', '13', '10', '10', '又 将 扫 罗 的 军 装 放 在 他 们 　 神 的 庙 里 ， 将 他 的 首 级 钉 在 大 衮 庙 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10671', '13', '10', '11', '基 列 雅 比 人 听 见 非 利 士 人 向 扫 罗 所 行 的 一 切 事 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10672', '13', '10', '12', '他 们 中 间 所 有 的 勇 士 就 起 身 前 去 ， 将 扫 罗 和 他 儿 子 的 尸 身 送 到 雅 比 ， 将 他 们 的 尸 骨 葬 在 雅 比 的 橡 树 下 ， 就 禁 食 七 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10673', '13', '10', '13', '这 样 ， 扫 罗 死 了 。 因 为 他 干 犯 耶 和 华 ， 没 有 遵 守 耶 和 华 的 命 ； 又 因 他 求 问 交 鬼 的 妇 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10674', '13', '10', '14', '没 有 求 问 耶 和 华 ， 所 以 耶 和 华 使 他 被 杀 ， 把 国 归 於 耶 西 的 儿 子 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10675', '13', '11', '1', '以 色 列 众 人 聚 集 到 希 伯 仑 见 大 卫 ， 说 ： 我 们 原 是 你 的 骨 肉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10676', '13', '11', '2', '从 前 扫 罗 作 王 的 时 候 ， 率 领 以 色 列 人 出 入 的 是 你 ； 耶 和 华 ─ 你 的 　 神 也 曾 应 许 你 说 ： 你 必 牧 养 我 的 民 以 色 列 ， 作 以 色 列 的 君 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10677', '13', '11', '3', '於 是 以 色 列 的 长 老 都 来 到 希 伯 仑 见 大 卫 王 。 大 卫 在 希 伯 仑 耶 和 华 面 前 与 他 们 立 约 ， 他 们 就 膏 大 卫 作 以 色 列 的 王 ， 是 照 耶 和 华 藉 撒 母 耳 所 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10678', '13', '11', '4', '大 卫 和 以 色 列 众 人 到 了 耶 路 撒 冷 ， 就 是 耶 布 斯 ； 那 时 耶 布 斯 人 住 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10679', '13', '11', '5', '耶 布 斯 人 对 大 卫 说 ： 你 决 不 能 进 这 地 方 。 然 而 大 卫 攻 取 锡 安 的 保 障 ， 就 是 大 卫 的 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10680', '13', '11', '6', '大 卫 说 ： 谁 先 攻 打 耶 布 斯 人 ， 必 作 首 领 元 帅 。 洗 鲁 雅 的 儿 子 约 押 先 上 去 ， 就 作 了 元 帅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10681', '13', '11', '7', '大 卫 住 在 保 障 里 ， 所 以 那 保 障 叫 作 大 卫 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10682', '13', '11', '8', '大 卫 又 从 米 罗 起 ， 四 围 建 筑 城 墙 ， 其 馀 的 是 约 押 修 理 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10683', '13', '11', '9', '大 卫 日 见 强 盛 ， 因 为 万 军 之 耶 和 华 与 他 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10684', '13', '11', '10', '以 下 记 录 跟 随 大 卫 勇 士 的 首 领 ， 就 是 奋 勇 帮 助 他 得 国 、 照 着 耶 和 华 吩 咐 以 色 列 人 的 话 、 与 以 色 列 人 一 同 立 他 作 王 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10685', '13', '11', '11', '大 卫 勇 士 的 数 目 记 在 下 面 ： 哈 革 摩 尼 的 儿 子 雅 朔 班 ， 他 是 军 长 的 统 领 ， 一 时 举 枪 杀 了 三 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10686', '13', '11', '12', '其 次 是 亚 合 人 犰 多 的 儿 子 以 利 亚 撒 ， 他 是 三 个 勇 士 里 的 一 个 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10687', '13', '11', '13', '他 从 前 与 大 卫 在 巴 斯 达 闵 ， 非 利 士 人 聚 集 要 打 仗 。 那 里 有 一 块 长 满 大 麦 的 田 ， 众 民 就 在 非 利 士 人 面 前 逃 跑 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10688', '13', '11', '14', '这 勇 士 便 站 在 那 田 间 击 杀 非 利 士 人 ， 救 护 了 那 田 。 耶 和 华 使 以 色 列 人 大 获 全 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10689', '13', '11', '15', '三 十 个 勇 士 中 的 三 个 人 下 到 磐 石 那 里 ， 进 了 亚 杜 兰 洞 见 大 卫 ； 非 利 士 的 军 队 在 利 乏 音 谷 安 营 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10690', '13', '11', '16', '那 时 大 卫 在 山 寨 ， 非 利 士 人 的 防 营 在 伯 利 恒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10691', '13', '11', '17', '大 卫 渴 想 ， 说 ： 甚 愿 有 人 将 伯 利 恒 城 门 旁 井 里 的 水 打 来 给 我 喝 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10692', '13', '11', '18', '这 三 个 勇 士 就 闯 过 非 利 士 人 的 营 盘 ， 从 伯 利 恒 城 门 旁 的 井 里 打 水 ， 拿 来 奉 给 大 卫 。 他 却 不 肯 喝 ， 将 水 奠 在 耶 和 华 面 前 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10693', '13', '11', '19', '说 ： 我 的 　 神 啊 ， 这 三 个 人 冒 死 去 打 水 ， 这 水 好 像 他 们 的 血 一 般 ， 我 断 不 敢 喝 ！ 如 此 ， 大 卫 不 肯 喝 。 这 是 三 个 勇 士 所 做 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10694', '13', '11', '20', '约 押 的 兄 弟 亚 比 筛 是 这 三 个 勇 士 的 首 领 ； 他 举 枪 杀 了 三 百 人 ， 就 在 三 个 勇 士 里 得 了 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10695', '13', '11', '21', '他 在 这 三 个 勇 士 里 是 最 尊 贵 的 ， 所 以 作 他 们 的 首 领 ； 只 是 不 及 前 三 个 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10696', '13', '11', '22', '有 甲 薛 勇 士 耶 何 耶 大 的 儿 子 比 拿 雅 行 过 大 能 的 事 ： 他 杀 了 摩 押 人 亚 利 伊 勒 的 两 个 儿 子 ， 又 在 下 雪 的 时 候 下 坑 里 去 杀 了 一 个 狮 子 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10697', '13', '11', '23', '又 杀 了 一 个 埃 及 人 。 埃 及 人 身 高 五 肘 ， 手 里 拿 着 枪 ， 枪 杆 粗 如 织 布 的 机 轴 ； 比 拿 雅 只 拿 着 棍 子 下 去 ， 从 埃 及 人 手 里 夺 过 枪 来 ， 用 那 枪 将 他 刺 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10698', '13', '11', '24', '这 是 耶 何 耶 大 的 儿 子 比 拿 雅 所 行 的 事 ， 就 在 三 个 勇 士 里 得 了 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10699', '13', '11', '25', '他 比 那 三 十 个 勇 士 都 尊 贵 ， 只 是 不 及 前 三 个 勇 士 。 大 卫 立 他 作 护 卫 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10700', '13', '11', '26', '军 中 的 勇 士 有 约 押 的 兄 弟 亚 撒 黑 ， 伯 利 恒 人 朵 多 的 儿 子 伊 勒 哈 难 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10701', '13', '11', '27', '哈 律 人 沙 玛 ， 比 伦 人 希 利 斯 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10702', '13', '11', '28', '提 哥 亚 人 益 吉 的 儿 子 以 拉 ， 亚 拿 突 人 亚 比 以 谢 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10703', '13', '11', '29', '户 沙 人 西 比 该 ， 亚 合 人 以 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10704', '13', '11', '30', '尼 陀 法 人 玛 哈 莱 ， 尼 陀 法 人 巴 拿 的 儿 子 希 立 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10705', '13', '11', '31', '便 雅 悯 族 基 比 亚 人 利 拜 的 儿 子 以 太 ， 比 拉 顿 人 比 拿 雅 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10706', '13', '11', '32', '迦 实 溪 人 户 莱 ， 亚 拉 巴 人 亚 比 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10707', '13', '11', '33', '巴 路 米 人 押 斯 玛 弗 ， 沙 本 人 以 利 雅 哈 巴 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10708', '13', '11', '34', '基 孙 人 哈 深 的 众 子 ， 哈 拉 人 沙 基 的 儿 子 约 拿 单 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10709', '13', '11', '35', '哈 拉 人 沙 甲 的 儿 子 亚 希 暗 ， 吾 珥 的 儿 子 以 利 法 勒 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10710', '13', '11', '36', '米 基 拉 人 希 弗 ， 比 伦 人 亚 希 雅 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10711', '13', '11', '37', '迦 密 人 希 斯 罗 ， 伊 斯 拜 的 儿 子 拿 莱 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10712', '13', '11', '38', '拿 单 的 兄 弟 约 珥 ， 哈 基 利 的 儿 子 弥 伯 哈 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10713', '13', '11', '39', '亚 扪 人 洗 勒 ， 比 录 人 拿 哈 莱 〈 拿 哈 莱 是 给 洗 鲁 雅 的 儿 子 约 押 拿 兵 器 的 〉 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10714', '13', '11', '40', '以 帖 人 以 拉 ， 以 帖 人 迦 立 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10715', '13', '11', '41', '赫 人 乌 利 亚 ， 亚 莱 的 儿 子 撒 拔 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10716', '13', '11', '42', '流 便 人 示 撒 的 儿 子 亚 第 拿 〈 他 是 流 便 支 派 中 的 一 个 族 长 ， 率 领 三 十 人 〉 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10717', '13', '11', '43', '玛 迦 的 儿 子 哈 难 ， 弥 特 尼 人 约 沙 法 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10718', '13', '11', '44', '亚 施 他 拉 人 乌 西 亚 ， 亚 罗 珥 人 何 坦 的 儿 子 沙 玛 、 耶 利 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10719', '13', '11', '45', '提 洗 人 申 利 的 儿 子 耶 叠 和 他 的 兄 弟 约 哈 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10720', '13', '11', '46', '玛 哈 未 人 以 利 业 ， 伊 利 拿 安 的 儿 子 耶 利 拜 、 约 沙 未 雅 ， 摩 押 人 伊 特 玛 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10721', '13', '11', '47', '以 利 业 、 俄 备 得 ， 并 米 琐 八 人 雅 西 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10722', '13', '12', '1', '大 卫 因 怕 基 士 的 儿 子 扫 罗 ， 躲 在 洗 革 拉 的 时 候 ， 有 勇 士 到 他 那 里 帮 助 他 打 仗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10723', '13', '12', '2', '他 们 善 於 拉 弓 ， 能 用 左 右 两 手 甩 石 射 箭 ， 都 是 便 雅 悯 人 扫 罗 的 族 弟 兄 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10724', '13', '12', '3', '为 首 的 是 亚 希 以 谢 ， 其 次 是 约 阿 施 ， 都 是 基 比 亚 人 示 玛 的 儿 子 。 还 有 亚 斯 玛 威 的 儿 子 耶 薛 和 毗 力 ， 又 有 比 拉 迦 ， 并 亚 拿 突 人 耶 户 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10725', '13', '12', '4', '基 遍 人 以 实 买 雅 〈 他 在 三 十 人 中 是 勇 士 ， 管 理 他 们 〉 ， 且 有 耶 利 米 、 雅 哈 悉 、 约 哈 难 ， 和 基 得 拉 人 约 撒 拔 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10726', '13', '12', '5', '伊 利 乌 赛 、 耶 利 摩 、 比 亚 利 雅 、 示 玛 利 雅 ， 哈 律 弗 人 示 法 提 雅 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10727', '13', '12', '6', '可 拉 人 以 利 加 拿 、 耶 西 亚 、 亚 萨 列 、 约 以 谢 、 雅 朔 班 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10728', '13', '12', '7', '基 多 人 耶 罗 罕 的 儿 子 犹 拉 和 西 巴 第 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10729', '13', '12', '8', '迦 得 支 派 中 有 人 到 旷 野 的 山 寨 投 奔 大 卫 ， 都 是 大 能 的 勇 士 ， 能 拿 盾 牌 和 枪 的 战 士 。 他 们 的 面 貌 好 像 狮 子 ， 快 跑 如 同 山 上 的 鹿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10730', '13', '12', '9', '第 一 以 薛 ， 第 二 俄 巴 底 雅 ， 第 三 以 利 押 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10731', '13', '12', '10', '第 四 弥 施 玛 拿 ， 第 五 耶 利 米 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10732', '13', '12', '11', '第 六 亚 太 ， 第 七 以 利 业 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10733', '13', '12', '12', '第 八 约 哈 难 ， 第 九 以 利 萨 巴 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10734', '13', '12', '13', '第 十 耶 利 米 ， 第 十 一 末 巴 奈 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10735', '13', '12', '14', '这 都 是 迦 得 人 中 的 军 长 ， 至 小 的 能 抵 一 百 人 ， 至 大 的 能 抵 一 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10736', '13', '12', '15', '正 月 ， 约 但 河 水 涨 过 两 岸 的 时 候 ， 他 们 过 河 ， 使 一 切 住 平 原 的 人 东 奔 西 逃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10737', '13', '12', '16', '又 有 便 雅 悯 和 犹 大 人 到 山 寨 大 卫 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10738', '13', '12', '17', '大 卫 出 去 迎 接 他 们 ， 对 他 们 说 ： 你 们 若 是 和 和 平 平 地 来 帮 助 我 ， 我 心 就 与 你 们 相 契 ； 你 们 若 是 将 我 这 无 罪 的 人 卖 在 敌 人 手 里 ， 愿 我 们 列 祖 的 　 神 察 看 责 罚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10739', '13', '12', '18', '那 时 神 的 灵 感 动 那 三 十 个 勇 士 的 首 领 亚 玛 撒 ， 他 就 说 ： 大 卫 啊 ， 我 们 是 归 於 你 的 ！ 耶 西 的 儿 子 啊 ， 我 们 是 帮 助 你 的 ！ 愿 你 平 平 安 安 ， 愿 帮 助 你 的 也 都 平 安 ！ 因 为 你 的 　 神 帮 助 你 。 大 卫 就 收 留 他 们 ， 立 他 们 作 军 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10740', '13', '12', '19', '大 卫 从 前 与 非 利 士 人 同 去 ， 要 与 扫 罗 争 战 ， 有 些 玛 拿 西 人 来 投 奔 大 卫 ， 他 们 却 没 有 帮 助 非 利 士 人 ； 因 为 非 利 士 人 的 首 领 商 议 ， 打 发 他 们 回 去 ， 说 ： 恐 怕 大 卫 拿 我 们 的 首 级 ， 归 降 他 的 主 人 扫 罗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10741', '13', '12', '20', '大 卫 往 洗 革 拉 去 的 时 候 ， 有 玛 拿 西 人 的 千 夫 长 押 拿 、 约 撒 拔 、 耶 叠 、 米 迦 勒 、 约 撒 拔 、 以 利 户 、 洗 勒 太 都 来 投 奔 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10742', '13', '12', '21', '这 些 人 帮 助 大 卫 攻 击 群 贼 ； 他 们 都 是 大 能 的 勇 士 ， 且 作 军 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10743', '13', '12', '22', '那 时 天 天 有 人 来 帮 助 大 卫 ， 以 致 成 了 大 军 ， 如 　 神 的 军 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10744', '13', '12', '23', '预 备 打 仗 的 兵 来 到 希 伯 仑 见 大 卫 ， 要 照 着 耶 和 华 的 话 将 扫 罗 的 国 位 归 与 大 卫 。 他 们 的 数 目 如 下 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10745', '13', '12', '24', '犹 大 支 派 ， 拿 盾 牌 和 枪 预 备 打 仗 的 有 六 千 八 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10746', '13', '12', '25', '西 缅 支 派 ， 能 上 阵 大 能 的 勇 士 有 七 千 一 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10747', '13', '12', '26', '利 未 支 派 有 四 千 六 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10748', '13', '12', '27', '耶 何 耶 大 是 亚 伦 家 的 首 领 ， 跟 从 他 的 有 三 千 七 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10749', '13', '12', '28', '还 有 少 年 大 能 的 勇 士 撒 督 ， 同 着 他 的 有 族 长 二 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10750', '13', '12', '29', '便 雅 悯 支 派 ， 扫 罗 的 族 弟 兄 也 有 三 千 人 ， 他 们 向 来 大 半 归 顺 扫 罗 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10751', '13', '12', '30', '以 法 莲 支 派 大 能 的 勇 士 ， 在 本 族 着 名 的 有 二 万 零 八 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10752', '13', '12', '31', '玛 拿 西 半 支 派 ， 册 上 有 名 的 共 一 万 八 千 人 ， 都 来 立 大 卫 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10753', '13', '12', '32', '以 萨 迦 支 派 ， 有 二 百 族 长 都 通 达 时 务 ， 知 道 以 色 列 人 所 当 行 的 ； 他 们 族 弟 兄 都 听 从 他 们 的 命 令 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10754', '13', '12', '33', '西 布 伦 支 派 ， 能 上 阵 用 各 样 兵 器 打 仗 、 行 伍 整 齐 、 不 生 二 心 的 有 五 万 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10755', '13', '12', '34', '拿 弗 他 利 支 派 ， 有 一 千 军 长 ； 跟 从 他 们 、 拿 盾 牌 和 枪 的 有 三 万 七 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10756', '13', '12', '35', '但 支 派 ， 能 摆 阵 的 有 二 万 八 千 六 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10757', '13', '12', '36', '亚 设 支 派 ， 能 上 阵 打 仗 的 有 四 万 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10758', '13', '12', '37', '约 但 河 东 的 流 便 支 派 、 迦 得 支 派 、 玛 拿 西 半 支 派 ， 拿 着 各 样 兵 器 打 仗 的 有 十 二 万 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10759', '13', '12', '38', '以 上 都 是 能 守 行 伍 的 战 士 ， 他 们 都 诚 心 来 到 希 伯 仑 ， 要 立 大 卫 作 以 色 列 的 王 。 以 色 列 其 馀 的 人 也 都 一 心 要 立 大 卫 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10760', '13', '12', '39', '他 们 在 那 里 三 日 ， 与 大 卫 一 同 吃 喝 ， 因 为 他 们 的 族 弟 兄 给 他 们 预 备 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10761', '13', '12', '40', '靠 近 他 们 的 人 以 及 以 萨 迦 、 西 布 伦 、 拿 弗 他 利 人 将 许 多 面 饼 、 无 花 果 饼 、 乾 葡 萄 、 酒 、 油 ， 用 驴 、 骆 驼 、 骡 子 、 牛 驮 来 ， 又 带 了 许 多 的 牛 和 羊 来 ， 因 为 以 色 列 人 甚 是 欢 乐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10762', '13', '13', '1', '大 卫 与 千 夫 长 、 百 夫 长 ， 就 是 一 切 首 领 商 议 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10763', '13', '13', '2', '大 卫 对 以 色 列 全 会 众 说 ： 你 们 若 以 为 美 ， 见 这 事 是 出 於 耶 和 华 ─ 我 们 的 　 神 ， 我 们 就 差 遣 人 走 遍 以 色 列 地 ， 见 我 们 未 来 的 弟 兄 ， 又 见 住 在 有 郊 野 之 城 的 祭 司 利 未 人 ， 使 他 们 都 到 这 里 来 聚 集 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10764', '13', '13', '3', '我 们 要 把 　 神 的 约 柜 运 到 我 们 这 里 来 ； 因 为 在 扫 罗 年 间 ， 我 们 没 有 在 约 柜 前 求 问 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10765', '13', '13', '4', '全 会 众 都 说 可 以 如 此 行 ； 这 事 在 众 民 眼 中 都 看 为 好 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10766', '13', '13', '5', '於 是 ， 大 卫 将 以 色 列 人 从 埃 及 的 西 曷 河 直 到 哈 马 口 都 招 聚 了 来 ， 要 从 基 列 耶 琳 将 　 神 的 约 柜 运 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10767', '13', '13', '6', '大 卫 率 领 以 色 列 众 人 上 到 巴 拉 ， 就 是 属 犹 大 的 基 列 耶 琳 ， 要 从 那 里 将 约 柜 运 来 。 这 约 柜 就 是 坐 在 二 基 路 伯 上 耶 和 华 　 神 留 名 的 约 柜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10768', '13', '13', '7', '他 们 将 　 神 的 约 柜 从 亚 比 拿 达 的 家 里 抬 出 来 ， 放 在 新 车 上 。 乌 撒 和 亚 希 约 赶 车 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10769', '13', '13', '8', '大 卫 和 以 色 列 众 人 在 　 神 前 用 琴 、 瑟 、 锣 、 鼓 、 号 作 乐 ， 极 力 跳 舞 歌 唱 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10770', '13', '13', '9', '到 了 基 顿 ( 撒 下 六 章 六 节 作 拿 艮 ) 的 禾 场 ； 因 为 牛 失 前 蹄 ( 或 作 惊 跳 ) ， 乌 撒 就 伸 手 扶 住 约 柜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10771', '13', '13', '10', '耶 和 华 向 他 发 怒 ， 因 他 伸 手 扶 住 约 柜 击 杀 他 ， 他 就 死 在 　 神 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10772', '13', '13', '11', '大 卫 因 耶 和 华 击 杀 ( 原 文 作 闯 杀 ) 乌 撒 ， 心 里 愁 烦 ， 就 称 那 地 方 为 毗 列 斯 乌 撒 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10773', '13', '13', '12', '那 日 ， 大 卫 惧 怕 　 神 ， 说 ： 　 神 的 约 柜 怎 可 运 到 我 这 里 来 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10774', '13', '13', '13', '於 是 大 卫 不 将 约 柜 运 进 大 卫 的 城 ， 却 运 到 迦 特 人 俄 别 以 东 的 家 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10775', '13', '13', '14', '　 神 的 约 柜 在 俄 别 以 东 家 中 三 个 月 ， 耶 和 华 赐 福 给 俄 别 以 东 的 家 和 他 一 切 所 有 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10776', '13', '14', '1', '推 罗 王 希 兰 将 香 柏 木 运 到 大 卫 那 里 ， 又 差 遣 使 者 和 石 匠 、 木 匠 给 大 卫 建 造 宫 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10777', '13', '14', '2', '大 卫 就 知 道 耶 和 华 坚 立 他 作 以 色 列 王 ， 又 为 自 己 的 民 以 色 列 ， 使 他 的 国 兴 旺 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10778', '13', '14', '3', '大 卫 在 耶 路 撒 冷 又 立 后 妃 ， 又 生 儿 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10779', '13', '14', '4', '在 耶 路 撒 冷 所 生 的 众 子 是 沙 母 亚 、 朔 罢 、 拿 单 、 所 罗 门 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10780', '13', '14', '5', '益 辖 、 以 利 书 亚 、 以 法 列 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10781', '13', '14', '6', '挪 迦 、 尼 斐 、 雅 非 亚 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10782', '13', '14', '7', '以 利 沙 玛 、 比 利 雅 大 、 以 利 法 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10783', '13', '14', '8', '非 利 士 人 听 见 大 卫 受 膏 作 以 色 列 众 人 的 王 ， 非 利 士 众 人 就 上 来 寻 索 大 卫 。 大 卫 听 见 ， 就 出 去 迎 敌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10784', '13', '14', '9', '非 利 士 人 来 了 ， 布 散 在 利 乏 音 谷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10785', '13', '14', '10', '大 卫 求 问 　 神 ， 说 ： 我 可 以 上 去 攻 打 非 利 士 人 麽 ？ 你 将 他 们 交 在 我 手 里 麽 ？ 耶 和 华 说 ： 你 可 以 上 去 ， 我 必 将 他 们 交 在 你 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10786', '13', '14', '11', '非 利 士 人 来 到 巴 力 毗 拉 心 ， 大 卫 在 那 里 杀 败 他 们 。 大 卫 说 ： 　 神 藉 我 的 手 冲 破 敌 人 ， 如 同 水 冲 去 一 般 ； 因 此 称 那 地 方 为 巴 力 毗 拉 心 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10787', '13', '14', '12', '非 利 士 人 将 神 像 撇 在 那 里 ， 大 卫 吩 咐 人 用 火 焚 烧 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10788', '13', '14', '13', '非 利 士 人 又 布 散 在 利 乏 音 谷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10789', '13', '14', '14', '大 卫 又 求 问 　 神 。 　 神 说 ： 不 要 一 直 地 上 去 ， 要 转 到 他 们 後 头 ， 从 桑 林 对 面 攻 打 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10790', '13', '14', '15', '你 听 见 桑 树 梢 上 有 脚 步 的 声 音 ， 就 要 出 战 ， 因 为 　 神 已 经 在 你 前 头 去 攻 打 非 利 士 人 的 军 队 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10791', '13', '14', '16', '大 卫 就 遵 着 　 神 所 吩 咐 的 ， 攻 打 非 利 士 人 的 军 队 ， 从 基 遍 直 到 基 色 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10792', '13', '14', '17', '於 是 大 卫 的 名 传 扬 到 列 国 ， 耶 和 华 使 列 国 都 惧 怕 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10793', '13', '15', '1', '大 卫 在 大 卫 城 为 自 己 建 造 宫 殿 ， 又 为 　 神 的 约 柜 预 备 地 方 ， 支 搭 帐 幕 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10794', '13', '15', '2', '那 时 大 卫 说 ： 除 了 利 未 人 之 外 ， 无 人 可 抬 　 神 的 约 柜 ； 因 为 耶 和 华 拣 选 他 们 抬 　 神 的 约 柜 ， 且 永 远 事 奉 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10795', '13', '15', '3', '大 卫 招 聚 以 色 列 众 人 众 人 到 耶 路 撒 冷 ， 要 将 耶 和 华 的 约 柜 抬 到 他 所 预 备 的 地 方 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10796', '13', '15', '4', '大 卫 又 聚 集 亚 伦 的 子 孙 和 利 未 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10797', '13', '15', '5', '哥 辖 子 孙 中 有 族 长 乌 列 和 他 的 弟 兄 一 百 二 十 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10798', '13', '15', '6', '米 拉 利 子 孙 中 有 族 长 亚 帅 雅 和 他 的 弟 兄 二 百 二 十 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10799', '13', '15', '7', '革 顺 子 孙 中 有 族 长 约 珥 和 他 的 弟 兄 一 百 三 十 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10800', '13', '15', '8', '以 利 撒 反 子 孙 中 有 族 长 示 玛 雅 和 他 的 弟 兄 二 百 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10801', '13', '15', '9', '希 伯 仑 子 孙 中 有 族 长 以 列 和 他 的 弟 兄 八 十 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10802', '13', '15', '10', '乌 薛 子 孙 中 有 族 长 亚 米 拿 达 和 他 的 弟 兄 一 百 一 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10803', '13', '15', '11', '大 卫 将 祭 司 撒 督 和 亚 比 亚 他 ， 并 利 未 人 乌 列 、 亚 帅 雅 、 约 珥 、 示 玛 雅 、 以 列 、 亚 米 拿 达 召 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10804', '13', '15', '12', '对 他 们 说 ： 你 们 是 利 未 人 的 族 长 ， 你 们 和 你 们 的 弟 兄 应 当 自 洁 ， 好 将 耶 和 华 ─ 以 色 列 　 神 的 约 柜 抬 到 我 所 预 备 的 地 方 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10805', '13', '15', '13', '因 你 们 先 前 没 有 抬 这 约 柜 ， 按 定 例 求 问 耶 和 华 ─ 我 们 的 　 神 ， 所 以 他 刑 罚 ( 原 文 作 闯 杀 ) 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10806', '13', '15', '14', '於 是 祭 司 利 未 人 自 洁 ， 好 将 耶 和 华 ─ 以 色 列 　 神 的 约 柜 抬 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10807', '13', '15', '15', '利 未 子 孙 就 用 杠 ， 肩 抬 　 神 的 约 柜 ， 是 照 耶 和 华 藉 摩 西 所 吩 咐 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10808', '13', '15', '16', '大 卫 吩 咐 利 未 人 的 族 长 ， 派 他 们 歌 唱 的 弟 兄 用 琴 瑟 和 钹 作 乐 ， 欢 欢 喜 喜 地 大 声 歌 颂 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10809', '13', '15', '17', '於 是 利 未 人 派 约 珥 的 儿 子 希 幔 和 他 弟 兄 中 比 利 家 的 儿 子 亚 萨 ， 并 他 们 族 弟 兄 米 拉 利 子 孙 里 古 沙 雅 的 儿 子 以 探 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10810', '13', '15', '18', '其 次 还 有 他 们 的 弟 兄 撒 迦 利 雅 、 便 雅 薛 、 示 米 拉 末 、 耶 歇 、 乌 尼 、 以 利 押 、 比 拿 雅 、 玛 西 雅 、 玛 他 提 雅 、 以 利 斐 利 户 、 弥 克 尼 雅 ， 并 守 门 的 俄 别 以 东 和 耶 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10811', '13', '15', '19', '这 样 ， 派 歌 唱 的 希 幔 、 亚 萨 、 以 探 敲 铜 钹 ， 大 发 响 声 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10812', '13', '15', '20', '派 撒 迦 利 雅 、 雅 薛 、 示 米 拉 末 、 耶 歇 、 乌 尼 、 以 利 押 、 玛 西 雅 、 比 拿 雅 鼓 瑟 ， 调 用 女 音 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10813', '13', '15', '21', '又 派 玛 他 提 雅 、 以 利 斐 利 户 、 弥 克 尼 雅 、 俄 别 以 东 、 耶 利 、 亚 撒 西 雅 领 首 弹 琴 ， 调 用 第 八 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10814', '13', '15', '22', '利 未 人 的 族 长 基 拿 尼 雅 是 歌 唱 人 的 首 领 ， 又 教 训 人 歌 唱 ， 因 为 他 精 通 此 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10815', '13', '15', '23', '比 利 家 、 以 利 加 拿 是 约 柜 前 守 门 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10816', '13', '15', '24', '祭 司 示 巴 尼 、 约 沙 法 、 拿 坦 业 、 亚 玛 赛 、 撒 迦 利 雅 、 比 拿 亚 、 以 利 以 谢 在 　 神 的 约 柜 前 吹 号 。 俄 别 以 东 和 耶 希 亚 也 是 约 柜 前 守 门 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10817', '13', '15', '25', '於 是 ， 大 卫 和 以 色 列 的 长 老 ， 并 千 夫 长 都 去 从 俄 别 以 东 的 家 欢 欢 喜 喜 地 将 耶 和 华 的 约 柜 抬 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10818', '13', '15', '26', '　 神 赐 恩 与 抬 耶 和 华 约 柜 的 利 未 人 ， 他 们 就 献 上 七 只 公 牛 ， 七 只 公 羊 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10819', '13', '15', '27', '大 卫 和 抬 约 柜 的 利 未 人 ， 并 歌 唱 人 的 首 领 基 拿 尼 雅 ， 以 及 歌 唱 的 人 ， 都 穿 着 细 麻 布 的 外 袍 ； 大 卫 另 外 穿 着 细 麻 布 的 以 弗 得 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10820', '13', '15', '28', '这 样 ， 以 色 列 众 人 欢 呼 吹 角 、 吹 号 、 敲 钹 、 鼓 瑟 、 弹 琴 ， 大 发 响 声 ， 将 耶 和 华 的 约 柜 抬 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10821', '13', '15', '29', '耶 和 华 的 约 柜 进 了 大 卫 城 的 时 候 ， 扫 罗 的 女 儿 米 甲 从 窗 户 里 观 看 ， 见 大 卫 王 踊 跃 跳 舞 ， 心 里 就 轻 视 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10822', '13', '16', '1', '众 人 将 　 神 的 约 柜 请 进 去 ， 安 放 在 大 卫 所 搭 的 帐 幕 里 ， 就 在 　 神 面 前 献 燔 祭 和 平 安 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10823', '13', '16', '2', '大 卫 献 完 了 燔 祭 和 平 安 祭 ， 就 奉 耶 和 华 的 名 给 民 祝 福 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10824', '13', '16', '3', '并 且 分 给 以 色 列 人 ， 无 论 男 女 ， 每 人 一 个 饼 ， 一 块 肉 ， 一 个 葡 萄 饼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10825', '13', '16', '4', '大 卫 派 几 个 利 未 人 在 耶 和 华 的 约 柜 前 事 奉 ， 颂 扬 ， 称 谢 ， 赞 美 耶 和 华 ─ 以 色 列 的 　 神 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10826', '13', '16', '5', '为 首 的 是 亚 萨 ， 其 次 是 撒 迦 利 雅 、 雅 薛 、 示 米 拉 末 、 耶 歇 、 玛 他 提 雅 、 以 利 押 、 比 拿 雅 、 俄 别 以 东 、 耶 利 ， 鼓 瑟 弹 琴 ； 惟 有 亚 萨 敲 钹 ， 大 发 响 声 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10827', '13', '16', '6', '祭 司 比 拿 雅 和 雅 哈 悉 常 在 　 神 的 约 柜 前 吹 号 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10828', '13', '16', '7', '那 日 ， 大 卫 初 次 藉 亚 萨 和 他 的 弟 兄 以 诗 歌 称 颂 耶 和 华 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10829', '13', '16', '8', '你 们 要 称 谢 耶 和 华 ， 求 告 他 的 名 ， 在 万 民 中 传 扬 他 的 作 为 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10830', '13', '16', '9', '要 向 他 唱 诗 、 歌 颂 ， 谈 论 他 一 切 奇 妙 的 作 为 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10831', '13', '16', '10', '要 以 他 的 圣 名 夸 耀 ； 寻 求 耶 和 华 的 人 ， 心 中 应 当 欢 喜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10832', '13', '16', '11', '要 寻 求 耶 和 华 与 他 的 能 力 ， 时 常 寻 求 他 的 面 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10833', '13', '16', '12', '他 仆 人 以 色 列 的 後 裔 ， 他 所 拣 选 雅 各 的 子 孙 哪 ， 你 们 要 记 念 他 奇 妙 的 作 为 和 他 的 奇 事 ， 并 他 口 中 的 判 语 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10834', '13', '16', '13', 'a');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10835', '13', '16', '14', '他 是 耶 和 华 ─ 我 们 的 　 神 ， 全 地 都 有 他 的 判 断 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10836', '13', '16', '15', '你 们 要 记 念 他 的 约 ， 直 到 永 远 ； 他 所 吩 咐 的 话 ， 直 到 千 代 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10837', '13', '16', '16', '就 是 与 亚 伯 拉 罕 所 立 的 约 ， 向 以 撒 所 起 的 誓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10838', '13', '16', '17', '他 又 将 这 约 向 雅 各 定 为 律 例 ， 向 以 色 列 定 为 永 远 的 约 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10839', '13', '16', '18', '说 ： 我 必 将 迦 南 地 赐 给 你 ， 作 你 产 业 的 分 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10840', '13', '16', '19', '当 时 你 们 人 丁 有 限 ， 数 目 稀 少 ， 并 且 在 那 地 为 寄 居 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10841', '13', '16', '20', '他 们 从 这 邦 游 到 那 邦 ， 从 这 国 行 到 那 国 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10842', '13', '16', '21', '耶 和 华 不 容 甚 麽 人 欺 负 他 们 ， 为 他 们 的 缘 故 责 备 君 王 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10843', '13', '16', '22', '说 ： 不 可 难 为 我 受 膏 的 人 ， 也 不 可 恶 待 我 的 先 知 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10844', '13', '16', '23', '全 地 都 要 向 耶 和 华 歌 唱 ！ 天 天 传 扬 他 的 救 恩 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10845', '13', '16', '24', '在 列 邦 中 述 说 他 的 荣 耀 ， 在 万 民 中 述 说 他 的 奇 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10846', '13', '16', '25', '因 耶 和 华 为 大 ， 当 受 极 大 的 赞 美 ； 他 在 万 　 神 之 上 ， 当 受 敬 畏 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10847', '13', '16', '26', '外 邦 的 　 神 都 属 虚 无 ， 惟 独 耶 和 华 创 造 诸 天 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10848', '13', '16', '27', '有 尊 荣 和 威 严 在 他 面 前 ， 有 能 力 和 喜 乐 在 他 圣 所 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10849', '13', '16', '28', '民 中 的 万 族 啊 ， 你 们 要 将 荣 耀 能 力 归 给 耶 和 华 ， 都 归 给 耶 和 华 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10850', '13', '16', '29', '要 将 耶 和 华 的 名 所 当 得 的 荣 耀 归 给 他 ， 拿 供 物 来 奉 到 他 面 前 ； 当 以 圣 洁 的 ( 的 或 作 为 ) 妆 饰 敬 拜 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10851', '13', '16', '30', '全 地 要 在 他 面 前 战 抖 ， 世 界 也 坚 定 不 得 动 摇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10852', '13', '16', '31', '愿 天 欢 喜 ， 愿 地 快 乐 ； 愿 人 在 列 邦 中 说 ： 耶 和 华 作 王 了');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10853', '13', '16', '32', '愿 海 和 其 中 所 充 满 的 澎 湃 ； 愿 田 和 其 中 所 有 的 都 欢 乐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10854', '13', '16', '33', '那 时 ， 林 中 的 树 木 都 要 在 耶 和 华 面 前 欢 呼 ， 因 为 他 来 要 审 判 全 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10855', '13', '16', '34', '应 当 称 谢 耶 和 华 ； 因 他 本 为 善 ， 他 的 慈 爱 永 远 长 存 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10856', '13', '16', '35', '要 说 ： 拯 救 我 们 的 　 神 啊 ， 求 你 救 我 们 ， 聚 集 我 们 ， 使 我 们 脱 离 外 邦 ， 我 们 好 称 赞 你 的 圣 名 ， 以 赞 美 你 为 夸 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10857', '13', '16', '36', '耶 和 华 ─ 以 色 列 的 　 神 ， 从 亘 古 直 到 永 远 ， 是 应 当 称 颂 的 ！ 众 民 都 说 ： 阿 们 ！ 并 且 赞 美 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10858', '13', '16', '37', '大 卫 派 亚 萨 和 他 的 弟 兄 在 约 柜 前 常 常 事 奉 耶 和 华 ， 一 日 尽 一 日 的 职 分 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10859', '13', '16', '38', '又 派 俄 别 以 东 和 他 的 弟 兄 六 十 八 人 ， 与 耶 杜 顿 的 儿 子 俄 别 以 东 ， 并 何 萨 作 守 门 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10860', '13', '16', '39', '且 派 祭 司 撒 督 和 他 弟 兄 众 祭 司 在 基 遍 的 邱 坛 、 耶 和 华 的 帐 幕 前 燔 祭 坛 上 ， 每 日 早 晚 ， 照 着 耶 和 华 律 法 书 上 所 吩 咐 以 色 列 人 的 ， 常 给 耶 和 华 献 燔 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10861', '13', '16', '40', 'a');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10862', '13', '16', '41', '与 他 们 一 同 被 派 的 有 希 幔 、 耶 杜 顿 ， 和 其 馀 被 选 名 字 录 在 册 上 的 ， 称 谢 耶 和 华 ， 因 他 的 慈 爱 永 远 长 存 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10863', '13', '16', '42', '希 幔 、 耶 杜 顿 同 着 他 们 吹 号 、 敲 钹 ， 大 发 响 声 ， 并 用 别 的 乐 器 随 着 歌 颂 　 神 。 耶 杜 顿 的 子 孙 作 守 门 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10864', '13', '16', '43', '於 是 众 民 各 归 各 家 ； 大 卫 也 回 去 为 家 眷 祝 福 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10865', '13', '17', '1', '大 卫 住 在 自 己 宫 中 ， 对 先 知 拿 单 说 ： 看 哪 ， 我 住 在 香 柏 木 的 宫 中 ， 耶 和 华 的 约 柜 反 在 幔 子 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10866', '13', '17', '2', '拿 单 对 大 卫 说 ： 你 可 以 照 你 的 心 意 而 行 ， 因 为 　 神 与 你 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10867', '13', '17', '3', '当 夜 ， 　 神 的 话 临 到 拿 单 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10868', '13', '17', '4', '你 去 告 诉 我 仆 人 大 卫 ， 说 耶 和 华 如 此 说 ： 你 不 可 建 造 殿 宇 给 我 居 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10869', '13', '17', '5', '自 从 我 领 以 色 列 人 出 埃 及 ， 直 到 今 日 ， 我 未 曾 住 过 殿 宇 ， 乃 从 这 会 幕 到 那 会 幕 ， 从 这 帐 幕 到 那 帐 幕 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10870', '13', '17', '6', '凡 我 同 以 色 列 人 所 走 的 地 方 ， 我 何 曾 向 以 色 列 的 一 个 士 师 ， 就 是 我 吩 咐 牧 养 我 民 的 说 ： 你 为 何 不 给 我 建 造 香 柏 木 的 殿 宇 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10871', '13', '17', '7', '现 在 你 要 告 诉 我 仆 人 大 卫 ， 说 万 军 之 耶 和 华 如 此 说 ： 我 从 羊 圈 中 将 你 召 来 ， 叫 你 不 再 跟 从 羊 群 ， 立 你 作 我 民 以 色 列 的 君 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10872', '13', '17', '8', '你 无 论 往 哪 里 去 ， 我 常 与 你 同 在 ， 剪 除 你 的 一 切 仇 敌 ； 我 必 使 你 得 大 名 ， 好 像 世 上 大 大 有 名 的 人 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10873', '13', '17', '9', '我 必 为 我 民 以 色 列 选 定 一 个 地 方 ， 栽 培 他 们 ， 使 他 们 住 自 己 的 地 方 ， 不 再 迁 移 ； 凶 恶 之 子 也 不 像 从 前 扰 害 他 们 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10874', '13', '17', '10', '并 不 像 我 命 士 师 治 理 我 民 以 色 列 的 时 候 一 样 。 我 必 治 服 你 的 一 切 仇 敌 ， 并 且 我 ─ 耶 和 华 应 许 你 ， 必 为 你 建 立 家 室 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10875', '13', '17', '11', '你 寿 数 满 足 归 你 列 祖 的 时 候 ， 我 必 使 你 的 後 裔 接 续 你 的 位 ， 我 也 必 坚 定 他 的 国 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10876', '13', '17', '12', '他 必 为 我 建 造 殿 宇 ； 我 必 坚 定 他 的 国 位 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10877', '13', '17', '13', '我 要 作 他 的 父 ， 他 要 作 我 的 子 ； 并 不 使 我 的 慈 爱 离 开 他 ， 像 离 开 在 你 以 前 的 扫 罗 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10878', '13', '17', '14', '我 却 要 将 他 永 远 坚 立 在 我 家 里 和 我 国 里 ； 他 的 国 位 也 必 坚 定 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10879', '13', '17', '15', '拿 单 就 按 这 一 切 话 ， 照 这 默 示 告 诉 大 卫 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10880', '13', '17', '16', '於 是 大 卫 王 进 去 ， 坐 在 耶 和 华 面 前 ， 说 ： 耶 和 华 　 神 啊 ， 我 是 谁 ， 我 的 家 算 甚 麽 ， 你 竟 使 我 到 这 地 步 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10881', '13', '17', '17', '　 神 啊 ， 这 在 你 眼 中 还 看 为 小 ， 又 应 许 你 仆 人 的 家 至 於 久 远 。 耶 和 华 　 神 啊 ， 你 看 顾 我 好 像 看 顾 高 贵 的 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10882', '13', '17', '18', '你 加 於 仆 人 的 尊 荣 ， 我 还 有 何 言 可 说 呢 ？ 因 为 你 知 道 你 的 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10883', '13', '17', '19', '耶 和 华 啊 ， 你 行 了 这 大 事 ， 并 且 显 明 出 来 ， 是 因 你 仆 人 的 缘 故 ， 也 是 照 你 的 心 意 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10884', '13', '17', '20', '耶 和 华 啊 ， 照 我 们 耳 中 听 见 ， 没 有 可 比 你 的 ， 除 你 以 外 再 无 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10885', '13', '17', '21', '世 上 有 何 民 能 比 你 的 民 以 色 列 呢 ？ 你 　 神 从 埃 及 救 赎 他 们 作 自 己 的 子 民 ， 又 在 你 赎 出 来 的 民 面 前 行 大 而 可 畏 的 事 ， 驱 逐 列 邦 人 ， 显 出 你 的 大 名 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10886', '13', '17', '22', '你 使 以 色 列 人 作 你 的 子 民 ， 直 到 永 远 ； 你 ─ 耶 和 华 也 作 他 们 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10887', '13', '17', '23', '耶 和 华 啊 ， 你 所 应 许 仆 人 和 仆 人 家 的 话 ， 求 你 坚 定 ， 直 到 永 远 ， 照 你 所 说 的 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10888', '13', '17', '24', '愿 你 的 名 永 远 坚 立 ， 被 尊 为 大 ， 说 ： 万 军 之 耶 和 华 是 以 色 列 的 　 神 ， 是 治 理 以 色 列 的 　 神 。 这 样 ， 你 仆 人 大 卫 的 家 必 在 你 面 前 坚 立 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10889', '13', '17', '25', '我 的 　 神 啊 ， 因 你 启 示 仆 人 说 ， 我 必 为 你 建 立 家 室 ， 所 以 仆 人 大 胆 在 你 面 前 祈 祷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10890', '13', '17', '26', '耶 和 华 啊 ， 惟 有 你 是 　 神 ， 你 也 应 许 将 这 福 气 赐 给 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10891', '13', '17', '27', '现 在 你 喜 悦 赐 福 与 仆 人 的 家 ， 可 以 永 存 在 你 面 前 。 耶 和 华 啊 ， 你 已 经 赐 福 ， 还 要 赐 福 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10892', '13', '18', '1', '此 後 ， 大 卫 攻 打 非 利 士 人 ， 把 他 们 治 服 ， 从 他 们 手 下 夺 取 了 迦 特 和 属 迦 特 的 村 庄 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10893', '13', '18', '2', '又 攻 打 摩 押 ， 摩 押 人 就 归 服 大 卫 ， 给 他 进 贡 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10894', '13', '18', '3', '琐 巴 王 哈 大 利 谢 ( 撒 下 八 章 三 节 作 哈 大 底 谢 ) 往 伯 拉 河 去 ， 要 坚 定 自 己 的 国 权 ， 大 卫 就 攻 打 他 ， 直 到 哈 马 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10895', '13', '18', '4', '夺 了 他 的 战 车 一 千 ， 马 兵 七 千 ， 步 兵 二 万 ， 将 拉 战 车 的 马 砍 断 蹄 筋 ， 但 留 下 一 百 辆 车 的 马 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10896', '13', '18', '5', '大 马 色 的 亚 兰 人 来 帮 助 琐 巴 王 哈 大 利 谢 ， 大 卫 就 杀 了 亚 兰 人 二 万 二 千 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10897', '13', '18', '6', '於 是 大 卫 在 大 马 色 的 亚 兰 地 设 立 防 营 ， 亚 兰 人 就 归 服 他 ， 给 他 进 贡 。 大 卫 无 论 往 哪 里 去 ， 耶 和 华 都 使 他 得 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10898', '13', '18', '7', '他 夺 了 哈 大 利 谢 臣 仆 所 拿 的 金 盾 牌 带 到 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10899', '13', '18', '8', '大 卫 又 从 属 哈 大 利 谢 的 提 巴 ( 或 作 比 他 ) 和 均 二 城 中 夺 取 了 许 多 的 铜 。 後 来 所 罗 门 用 此 制 造 铜 海 、 铜 柱 ， 和 一 切 的 铜 器 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10900', '13', '18', '9', '哈 马 王 陀 乌 听 见 大 卫 杀 败 琐 巴 王 哈 大 利 谢 的 全 军 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10901', '13', '18', '10', '就 打 发 他 儿 子 哈 多 兰 去 见 大 卫 王 ， 问 他 的 安 ， 为 他 祝 福 ， 因 为 他 杀 败 了 哈 大 利 谢 〈 原 来 陀 乌 与 哈 大 利 谢 常 常 争 战 〉 。 哈 多 兰 带 了 金 银 铜 的 各 样 器 皿 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10902', '13', '18', '11', '大 卫 王 将 这 些 器 皿 ， 并 从 各 国 夺 来 的 金 银 ， 就 是 从 以 东 、 摩 押 、 亚 扪 、 非 利 士 、 亚 玛 力 人 所 夺 来 的 ， 都 分 别 为 圣 献 给 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10903', '13', '18', '12', '洗 鲁 雅 的 儿 子 亚 比 筛 在 盐 谷 击 杀 了 以 东 一 万 八 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10904', '13', '18', '13', '大 卫 在 以 东 地 设 立 防 营 ， 以 东 人 就 都 归 服 他 。 大 卫 无 论 往 哪 里 去 ， 耶 和 华 都 使 他 得 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10905', '13', '18', '14', '大 卫 作 以 色 列 众 人 的 王 ， 又 向 众 民 秉 公 行 义 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10906', '13', '18', '15', '洗 鲁 雅 的 儿 子 约 押 作 元 帅 ； 亚 希 律 的 儿 子 约 沙 法 作 史 官 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10907', '13', '18', '16', '亚 希 突 的 儿 子 撒 督 和 亚 比 亚 他 的 儿 子 亚 希 米 勒 作 祭 司 长 ； 沙 威 沙 作 书 记 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10908', '13', '18', '17', '耶 何 耶 大 的 儿 子 比 拿 雅 统 辖 基 利 提 人 和 比 利 提 人 。 大 卫 的 众 子 都 在 王 的 左 右 作 领 袖 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10909', '13', '19', '1', '此 後 ， 亚 扪 人 的 王 拿 辖 死 了 ， 他 儿 子 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10910', '13', '19', '2', '大 卫 说 ： 我 要 照 哈 嫩 的 父 亲 拿 辖 厚 待 我 的 恩 典 厚 待 哈 嫩 。 於 是 大 卫 差 遣 使 者 为 他 丧 父 安 慰 他 。 大 卫 的 臣 仆 到 了 亚 扪 人 的 境 内 见 哈 嫩 ， 要 安 慰 他 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10911', '13', '19', '3', '但 亚 扪 人 的 首 领 对 哈 嫩 说 ： 大 卫 差 人 来 安 慰 你 ， 你 想 他 是 尊 敬 你 父 亲 麽 ？ 他 的 臣 仆 来 见 你 不 是 为 详 察 窥 探 、 倾 覆 这 地 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10912', '13', '19', '4', '哈 嫩 便 将 大 卫 臣 仆 的 胡 须 剃 去 一 半 ， 又 割 断 他 们 下 半 截 的 衣 服 ， 使 他 们 露 出 下 体 ， 打 发 他 们 回 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10913', '13', '19', '5', '有 人 将 臣 仆 所 遇 的 事 告 诉 大 卫 ， 他 就 差 人 去 迎 接 他 们 ， 因 为 他 们 甚 觉 羞 耻 ； 告 诉 他 们 说 ： 可 以 住 在 耶 利 哥 ， 等 到 胡 须 长 起 再 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10914', '13', '19', '6', '亚 扪 人 知 道 大 卫 憎 恶 他 们 ， 哈 嫩 和 亚 扪 人 就 打 发 人 拿 一 千 他 连 得 银 子 ， 从 米 所 波 大 米 、 亚 兰 、 玛 迦 、 琐 巴 雇 战 车 和 马 兵 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10915', '13', '19', '7', '於 是 雇 了 三 万 二 千 辆 战 车 和 玛 迦 王 并 他 的 军 兵 ； 他 们 来 安 营 在 米 底 巴 前 。 亚 扪 人 也 从 他 们 的 城 里 出 来 ， 聚 集 交 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10916', '13', '19', '8', '大 卫 听 见 了 ， 就 差 派 约 押 统 带 勇 猛 的 全 军 出 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10917', '13', '19', '9', '亚 扪 人 出 来 在 城 门 前 摆 阵 ， 所 来 的 诸 王 另 在 郊 野 摆 阵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10918', '13', '19', '10', '约 押 看 见 敌 人 在 他 前 後 摆 阵 ， 就 从 以 色 列 军 中 挑 选 精 兵 ， 使 他 们 对 着 亚 兰 人 摆 阵 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10919', '13', '19', '11', '其 馀 的 兵 交 与 他 兄 弟 亚 比 筛 ， 对 着 亚 扪 人 摆 阵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10920', '13', '19', '12', '约 押 对 亚 比 筛 说 ： 亚 兰 人 若 强 过 我 ， 你 就 来 帮 助 我 ； 亚 扪 人 若 强 过 你 ， 我 就 去 帮 助 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10921', '13', '19', '13', '我 们 都 当 刚 强 ， 为 本 国 的 民 和 　 神 的 城 邑 作 大 丈 夫 ， 愿 耶 和 华 凭 他 的 意 旨 而 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10922', '13', '19', '14', '於 是 约 押 和 跟 随 他 的 人 前 进 攻 打 亚 兰 人 ； 亚 兰 人 在 约 押 面 前 逃 跑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10923', '13', '19', '15', '亚 扪 人 见 亚 兰 人 逃 跑 ， 他 们 也 在 约 押 的 兄 弟 亚 比 筛 面 前 逃 跑 进 城 。 约 押 就 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10924', '13', '19', '16', '亚 兰 人 见 自 己 被 以 色 列 人 打 败 ， 就 打 发 使 者 将 大 河 那 边 的 亚 兰 人 调 来 ， 哈 大 利 谢 的 将 军 朔 法 率 领 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10925', '13', '19', '17', '有 人 告 诉 大 卫 ， 他 就 聚 集 以 色 列 众 人 过 约 但 河 ， 来 到 亚 兰 人 那 里 ， 迎 着 他 们 摆 阵 。 大 卫 既 摆 阵 攻 击 亚 兰 人 ， 亚 兰 人 就 与 他 打 仗 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10926', '13', '19', '18', '亚 兰 人 在 以 色 列 人 面 前 逃 跑 。 大 卫 杀 了 亚 兰 七 千 辆 战 车 的 人 ， 四 万 步 兵 ， 又 杀 了 亚 兰 的 将 军 朔 法 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10927', '13', '19', '19', '属 哈 大 利 谢 的 诸 王 见 自 己 被 以 色 列 人 打 败 ， 就 与 大 卫 和 好 ， 归 服 他 。 於 是 亚 兰 人 不 敢 再 帮 助 亚 扪 人 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10928', '13', '20', '1', '过 了 一 年 ， 到 列 王 出 战 的 时 候 ， 约 押 率 领 军 兵 毁 坏 亚 扪 人 的 地 ， 围 攻 拉 巴 ； 大 卫 仍 住 在 耶 路 撒 冷 。 约 押 攻 打 拉 巴 ， 将 城 倾 覆 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10929', '13', '20', '2', '大 卫 夺 了 亚 扪 人 之 王 ( 王 或 作 玛 勒 堪 。 玛 勒 堪 即 米 勒 公 ， 是 亚 扪 族 之 　 神 名 ) 所 戴 的 金 冠 冕 ， 其 上 的 金 子 重 一 他 连 得 ， 又 嵌 着 宝 石 ； 人 将 这 冠 冕 戴 在 大 卫 头 上 。 大 卫 从 城 里 夺 了 许 多 财 物 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10930', '13', '20', '3', '将 城 里 的 人 拉 出 来 ， 放 在 锯 下 ， 或 铁 耙 下 ， 或 铁 斧 下 ( 或 作 强 他 们 用 锯 ， 或 用 打 粮 食 的 铁 器 ， 或 用 铁 斧 作 工 ) ， 大 卫 待 亚 扪 各 城 的 居 民 都 是 如 此 。 其 後 大 卫 和 众 军 都 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10931', '13', '20', '4', '後 来 ， 以 色 列 人 在 基 色 与 非 利 士 人 打 仗 。 户 沙 人 西 比 该 杀 了 伟 人 的 一 个 儿 子 细 派 ， 非 利 士 人 就 被 制 伏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10932', '13', '20', '5', '又 与 非 利 士 人 打 仗 。 睚 珥 的 儿 子 伊 勒 哈 难 杀 了 迦 特 人 歌 利 亚 的 兄 弟 拉 哈 米 ； 这 人 的 枪 杆 粗 如 织 布 的 机 轴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10933', '13', '20', '6', '又 在 迦 特 打 仗 。 那 里 有 一 个 身 量 高 大 的 人 ， 手 脚 都 是 六 指 ， 共 有 二 十 四 个 指 头 ， 他 也 是 伟 人 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10934', '13', '20', '7', '这 人 向 以 色 列 人 骂 阵 ， 大 卫 的 哥 哥 示 米 亚 的 儿 子 约 拿 单 就 杀 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10935', '13', '20', '8', '这 三 个 人 是 迦 特 伟 人 的 儿 子 ， 都 死 在 大 卫 和 他 仆 人 的 手 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10936', '13', '21', '1', '撒 但 起 来 攻 击 以 色 列 人 ， 激 动 大 卫 数 点 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10937', '13', '21', '2', '大 卫 就 吩 咐 约 押 和 民 中 的 首 领 说 ： 你 们 去 数 点 以 色 列 人 ， 从 别 是 巴 直 到 但 ， 回 来 告 诉 我 ， 我 好 知 道 他 们 的 数 目 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10938', '13', '21', '3', '约 押 说 ： 愿 耶 和 华 使 他 的 百 姓 比 现 在 加 增 百 倍 。 我 主 我 王 啊 ， 他 们 不 都 是 你 的 仆 人 麽 ？ 我 主 为 何 吩 咐 行 这 事 ， 为 何 使 以 色 列 人 陷 在 罪 里 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10939', '13', '21', '4', '但 王 的 命 令 胜 过 约 押 。 约 押 就 出 去 ， 走 遍 以 色 列 地 ， 回 到 耶 路 撒 冷 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10940', '13', '21', '5', '将 百 姓 的 总 数 奏 告 大 卫 ： 以 色 列 人 拿 刀 的 有 一 百 一 十 万 ； 犹 大 人 拿 刀 的 有 四 十 七 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10941', '13', '21', '6', '惟 有 利 未 人 和 便 雅 悯 人 没 有 数 在 其 中 ， 因 为 约 押 厌 恶 王 的 这 命 令 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10942', '13', '21', '7', '　 神 不 喜 悦 这 数 点 百 姓 的 事 ， 便 降 灾 给 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10943', '13', '21', '8', '大 卫 祷 告 　 神 说 ： 我 行 这 事 大 有 罪 了 ！ 现 在 求 你 除 掉 仆 人 的 罪 孽 ， 因 我 所 行 的 甚 是 愚 昧 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10944', '13', '21', '9', '耶 和 华 吩 咐 大 卫 的 先 见 迦 得 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10945', '13', '21', '10', '你 去 告 诉 大 卫 说 ， 耶 和 华 如 此 说 ： 我 有 三 样 灾 ， 随 你 选 择 一 样 ， 我 好 降 与 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10946', '13', '21', '11', '於 是 ， 迦 得 来 见 大 卫 ， 对 他 说 ： 耶 和 华 如 此 说 ： 你 可 以 随 意 选 择 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10947', '13', '21', '12', '或 三 年 的 饥 荒 ； 或 败 在 你 敌 人 面 前 ， 被 敌 人 的 刀 追 杀 三 个 月 ； 或 在 你 国 中 有 耶 和 华 的 刀 ， 就 是 三 日 的 瘟 疫 ， 耶 和 华 的 使 者 在 以 色 列 的 四 境 施 行 毁 灭 。 现 在 你 要 想 一 想 ， 我 好 回 覆 那 差 我 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10948', '13', '21', '13', '大 卫 对 迦 得 说 ： 我 甚 为 难 。 我 愿 落 在 耶 和 华 的 手 里 ， 因 为 他 有 丰 盛 的 怜 悯 ； 我 不 愿 落 在 人 的 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10949', '13', '21', '14', '於 是 ， 耶 和 华 降 瘟 疫 与 以 色 列 人 ， 以 色 列 人 就 死 了 七 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10950', '13', '21', '15', '　 神 差 遣 使 者 去 灭 耶 路 撒 冷 ， 刚 要 灭 的 时 候 ， 耶 和 华 看 见 後 悔 ， 就 不 降 这 灾 了 ， 吩 咐 灭 城 的 天 使 说 ： 够 了 ， 住 手 罢 ！ 那 时 ， 耶 和 华 的 使 者 站 在 耶 布 斯 人 阿 珥 楠 的 禾 场 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10951', '13', '21', '16', '大 卫 举 目 ， 看 见 耶 和 华 的 使 者 站 在 天 地 间 ， 手 里 有 拔 出 来 的 刀 ， 伸 在 耶 路 撒 冷 以 上 。 大 卫 和 长 老 都 身 穿 麻 衣 ， 面 伏 於 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10952', '13', '21', '17', '大 卫 祷 告 　 神 说 ： 吩 咐 数 点 百 姓 的 不 是 我 麽 ？ 我 犯 了 罪 ， 行 了 恶 ， 但 这 群 羊 做 了 甚 麽 呢 ？ 愿 耶 和 华 ─ 我 　 神 的 手 攻 击 我 和 我 的 父 家 ， 不 要 攻 击 你 的 民 ， 降 瘟 疫 与 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10953', '13', '21', '18', '耶 和 华 的 使 者 吩 咐 迦 得 去 告 诉 大 卫 ， 叫 他 上 去 ， 在 耶 布 斯 人 阿 珥 楠 的 禾 场 上 为 耶 和 华 筑 一 座 坛 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10954', '13', '21', '19', '大 卫 就 照 着 迦 得 奉 耶 和 华 名 所 说 的 话 上 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10955', '13', '21', '20', '那 时 阿 珥 楠 正 打 麦 子 ， 回 头 看 见 天 使 ， 就 和 他 四 个 儿 子 都 藏 起 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10956', '13', '21', '21', '大 卫 到 了 阿 珥 楠 那 里 ， 阿 珥 楠 看 见 大 卫 ， 就 从 禾 场 上 出 去 ， 脸 伏 於 地 ， 向 他 下 拜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10957', '13', '21', '22', '大 卫 对 阿 珥 楠 说 ： 你 将 这 禾 场 与 相 连 之 地 卖 给 我 ， 我 必 给 你 足 价 ， 我 好 在 其 上 为 耶 和 华 筑 一 座 坛 ， 使 民 间 的 瘟 疫 止 住 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10958', '13', '21', '23', '阿 珥 楠 对 大 卫 说 ： 你 可 以 用 这 禾 场 ， 愿 我 主 我 王 照 你 所 喜 悦 的 去 行 。 我 也 将 牛 给 你 作 燔 祭 ， 把 打 粮 的 器 具 当 柴 烧 ， 拿 麦 子 作 素 祭 。 这 些 我 都 送 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10959', '13', '21', '24', '大 卫 王 对 阿 珥 楠 说 ： 不 然 ！ 我 必 要 用 足 价 向 你 买 。 我 不 用 你 的 物 献 给 耶 和 华 ， 也 不 用 白 得 之 物 献 为 燔 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10960', '13', '21', '25', '於 是 大 卫 为 那 块 地 平 了 六 百 舍 客 勒 金 子 给 阿 珥 楠 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10961', '13', '21', '26', '大 卫 在 那 里 为 耶 和 华 筑 了 一 座 坛 ， 献 燔 祭 和 平 安 祭 ， 求 告 耶 和 华 。 耶 和 华 就 应 允 他 ， 使 火 从 天 降 在 燔 祭 坛 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10962', '13', '21', '27', '耶 和 华 吩 咐 使 者 ， 他 就 收 刀 入 鞘 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10963', '13', '21', '28', '那 时 ， 大 卫 见 耶 和 华 在 耶 布 斯 人 阿 珥 楠 的 禾 场 上 应 允 了 他 ， 就 在 那 里 献 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10964', '13', '21', '29', '摩 西 在 旷 野 所 造 之 耶 和 华 的 帐 幕 和 燔 祭 坛 都 在 基 遍 的 高 处 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10965', '13', '21', '30', '只 是 大 卫 不 敢 前 去 求 问 　 神 ， 因 为 惧 怕 耶 和 华 使 者 的 刀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10966', '13', '22', '1', '大 卫 说 ： 这 就 是 耶 和 华 　 神 的 殿 ， 为 以 色 列 人 献 燔 祭 的 坛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10967', '13', '22', '2', '大 卫 吩 咐 聚 集 住 以 色 列 地 的 外 邦 人 ， 从 其 中 派 石 匠 凿 石 头 ， 要 建 造 　 神 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10968', '13', '22', '3', '大 卫 预 备 许 多 铁 做 门 上 的 钉 子 和 钩 子 ， 又 预 备 许 多 铜 ， 多 得 无 法 可 称 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10969', '13', '22', '4', '又 预 备 无 数 的 香 柏 木 ， 因 为 西 顿 人 和 推 罗 人 给 大 卫 运 了 许 多 香 柏 木 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10970', '13', '22', '5', '大 卫 说 ： 我 儿 子 所 罗 门 还 年 幼 娇 嫩 ， 要 为 耶 和 华 建 造 的 殿 宇 必 须 高 大 辉 煌 ， 使 名 誉 荣 耀 传 遍 万 国 ； 所 以 我 要 为 殿 预 备 材 料 。 於 是 ， 大 卫 在 未 死 之 先 预 备 的 材 料 甚 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10971', '13', '22', '6', '大 卫 召 了 他 儿 子 所 罗 门 来 ， 嘱 咐 他 给 耶 和 华 ─ 以 色 列 的 　 神 建 造 殿 宇 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10972', '13', '22', '7', '对 所 罗 门 说 ： 我 儿 啊 ， 我 心 里 本 想 为 耶 和 华 ─ 我 　 神 的 名 建 造 殿 宇 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10973', '13', '22', '8', '只 是 耶 和 华 的 话 临 到 我 说 ： 你 流 了 多 人 的 血 ， 打 了 多 次 大 仗 ， 你 不 可 为 我 的 名 建 造 殿 宇 ， 因 为 你 在 我 眼 前 使 多 人 的 血 流 在 地 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10974', '13', '22', '9', '你 要 生 一 个 儿 子 ， 他 必 作 太 平 的 人 ； 我 必 使 他 安 静 ， 不 被 四 围 的 仇 敌 扰 乱 。 他 的 名 要 叫 所 罗 门 ( 即 太 平 之 意 ) 。 他 在 位 的 日 子 ， 我 必 使 以 色 列 人 平 安 康 泰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10975', '13', '22', '10', '他 必 为 我 的 名 建 造 殿 宇 。 他 要 作 我 的 子 ； 我 要 作 他 的 父 。 他 作 以 色 列 王 ； 我 必 坚 定 他 的 国 位 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10976', '13', '22', '11', '我 儿 啊 ， 现 今 愿 耶 和 华 与 你 同 在 ， 使 你 亨 通 ， 照 他 指 着 你 说 的 话 ， 建 造 耶 和 华 ─ 你 　 神 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10977', '13', '22', '12', '但 愿 耶 和 华 赐 你 聪 明 智 慧 ， 好 治 理 以 色 列 国 ， 遵 行 耶 和 华 ─ 你 　 神 的 律 法 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10978', '13', '22', '13', '你 若 谨 守 遵 行 耶 和 华 藉 摩 西 吩 咐 以 色 列 的 律 例 典 章 ， 就 得 亨 通 。 你 当 刚 强 壮 胆 ， 不 要 惧 怕 ， 也 不 要 惊 惶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10979', '13', '22', '14', '我 在 困 难 之 中 为 耶 和 华 的 殿 预 备 了 金 子 十 万 他 连 得 ， 银 子 一 百 万 他 连 得 ， 铜 和 铁 多 得 无 法 可 称 ； 我 也 预 备 了 木 头 、 石 头 ， 你 还 可 以 增 添 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10980', '13', '22', '15', '你 有 许 多 匠 人 ， 就 是 石 匠 、 木 匠 ， 和 一 切 能 做 各 样 工 的 巧 匠 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10981', '13', '22', '16', '并 有 无 数 的 金 银 铜 铁 。 你 当 起 来 办 事 ， 愿 耶 和 华 与 你 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10982', '13', '22', '17', '大 卫 又 吩 咐 以 色 列 的 众 首 领 帮 助 他 儿 子 所 罗 门 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10983', '13', '22', '18', '耶 和 华 ─ 你 们 的 　 神 不 是 与 你 们 同 在 麽 ？ 不 是 叫 你 们 四 围 都 平 安 麽 ？ 因 他 已 将 这 地 的 居 民 交 在 我 手 中 ， 这 地 就 在 耶 和 华 与 他 百 姓 面 前 制 伏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10984', '13', '22', '19', '现 在 你 们 应 当 立 定 心 意 ， 寻 求 耶 和 华 ─ 你 们 的 　 神 ； 也 当 起 来 建 造 耶 和 华 　 神 的 圣 所 ， 好 将 耶 和 华 的 约 柜 和 供 奉 　 神 的 圣 器 皿 都 搬 进 为 耶 和 华 名 建 造 的 殿 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10985', '13', '23', '1', '大 卫 年 纪 老 迈 ， 日 子 满 足 ， 就 立 他 儿 子 所 罗 门 作 以 色 列 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10986', '13', '23', '2', '大 卫 招 聚 以 色 列 的 众 首 领 和 祭 司 利 未 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10987', '13', '23', '3', '利 未 人 从 三 十 岁 以 外 的 都 被 数 点 ， 他 们 男 丁 的 数 目 共 有 三 万 八 千 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10988', '13', '23', '4', '其 中 有 二 万 四 千 人 管 理 耶 和 华 殿 的 事 ， 有 六 千 人 作 官 长 和 士 师 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10989', '13', '23', '5', '有 四 千 人 作 守 门 的 ， 又 有 四 千 人 用 大 卫 所 做 的 乐 器 颂 赞 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10990', '13', '23', '6', '大 卫 将 利 未 人 革 顺 、 哥 辖 、 米 拉 利 的 子 孙 分 了 班 次 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10991', '13', '23', '7', '革 顺 的 子 孙 有 拉 但 和 示 每 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10992', '13', '23', '8', '拉 但 的 长 子 是 耶 歇 ， 还 有 细 坦 和 约 珥 ， 共 三 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10993', '13', '23', '9', '示 每 的 儿 子 是 示 罗 密 、 哈 薛 、 哈 兰 三 人 。 这 是 拉 但 族 的 族 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10994', '13', '23', '10', '示 每 的 儿 子 是 雅 哈 、 细 拿 、 耶 乌 施 、 比 利 亚 共 四 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10995', '13', '23', '11', '雅 哈 是 长 子 ， 细 撒 是 次 子 。 但 耶 乌 施 和 比 利 亚 的 子 孙 不 多 ， 所 以 算 为 一 族 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10996', '13', '23', '12', '哥 辖 的 儿 子 是 暗 兰 、 以 斯 哈 、 希 伯 伦 、 乌 薛 共 四 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10997', '13', '23', '13', '暗 兰 的 儿 子 是 亚 伦 、 摩 西 。 亚 伦 和 他 的 子 孙 分 出 来 ， 好 分 别 至 圣 的 物 ， 在 耶 和 华 面 前 烧 香 、 事 奉 他 ， 奉 他 的 名 祝 福 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10998', '13', '23', '14', '至 於 　 神 人 摩 西 ， 他 的 子 孙 名 字 记 在 利 未 支 派 的 册 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('10999', '13', '23', '15', '摩 西 的 儿 子 是 革 舜 和 以 利 以 谢 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11000', '13', '23', '16', '革 舜 的 长 子 是 细 布 业 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11001', '13', '23', '17', '以 利 以 谢 的 儿 子 是 利 哈 比 雅 。 以 利 以 谢 没 有 别 的 儿 子 ， 但 利 哈 比 雅 的 子 孙 甚 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11002', '13', '23', '18', '以 斯 哈 的 长 子 是 示 罗 密 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11003', '13', '23', '19', '希 伯 伦 的 长 子 是 耶 利 雅 ， 次 子 是 亚 玛 利 亚 ， 三 子 是 雅 哈 悉 ， 四 子 是 耶 加 面 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11004', '13', '23', '20', '乌 薛 的 长 子 是 米 迦 ， 次 子 是 耶 西 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11005', '13', '23', '21', '米 拉 利 的 儿 子 是 抹 利 、 母 示 。 抹 利 的 儿 子 是 以 利 亚 撒 、 基 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11006', '13', '23', '22', '以 利 亚 撒 死 了 ， 没 有 儿 子 ， 只 有 女 儿 ， 他 们 本 族 基 士 的 儿 子 娶 了 他 们 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11007', '13', '23', '23', '母 示 的 儿 子 是 末 力 、 以 得 、 耶 利 摩 共 三 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11008', '13', '23', '24', '以 上 利 未 子 孙 作 族 长 的 ， 照 着 男 丁 的 数 目 ， 从 二 十 岁 以 外 ， 都 办 耶 和 华 殿 的 事 务 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11009', '13', '23', '25', '大 卫 说 ： 耶 和 华 ─ 以 色 列 的 　 神 已 经 使 他 的 百 姓 平 安 ， 他 永 远 住 在 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11010', '13', '23', '26', '利 未 人 不 必 再 抬 帐 幕 和 其 中 所 用 的 一 切 器 皿 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11011', '13', '23', '27', '照 着 大 卫 临 终 所 吩 咐 的 ， 利 未 人 从 二 十 岁 以 外 的 都 被 数 点 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11012', '13', '23', '28', '他 们 的 职 任 是 服 事 亚 伦 的 子 孙 ， 在 耶 和 华 的 殿 和 院 子 ， 并 屋 中 办 事 ， 洁 净 一 切 圣 物 ， 就 是 办 　 神 殿 的 事 务 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11013', '13', '23', '29', '并 管 理 陈 设 饼 ， 素 祭 的 细 面 ， 或 无 酵 薄 饼 ， 或 用 盘 烤 ， 或 用 油 调 和 的 物 ， 又 管 理 各 样 的 升 斗 尺 度 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11014', '13', '23', '30', '每 日 早 晚 ， 站 立 称 谢 赞 美 耶 和 华 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11015', '13', '23', '31', '又 在 安 息 日 、 月 朔 ， 并 节 期 ， 按 数 照 例 ， 将 燔 祭 常 常 献 给 耶 和 华 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11016', '13', '23', '32', '又 看 守 会 幕 和 圣 所 ， 并 守 耶 和 华 吩 咐 他 们 弟 兄 亚 伦 子 孙 的 ， 办 耶 和 华 殿 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11017', '13', '24', '1', '亚 伦 子 孙 的 班 次 记 在 下 面 ： 亚 伦 的 儿 子 是 拿 答 、 亚 比 户 、 以 利 亚 撒 、 以 他 玛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11018', '13', '24', '2', '拿 答 、 亚 比 户 死 在 他 们 父 亲 之 先 ， 没 有 留 下 儿 子 ； 故 此 ， 以 利 亚 撒 、 以 他 玛 供 祭 司 的 职 分 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11019', '13', '24', '3', '以 利 亚 撒 的 子 孙 撒 督 和 以 他 玛 的 子 孙 亚 希 米 勒 ， 同 着 大 卫 将 他 们 的 族 弟 兄 分 成 班 次 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11020', '13', '24', '4', '以 利 亚 撒 子 孙 中 为 首 的 比 以 他 玛 子 孙 中 为 首 的 更 多 ， 分 班 如 下 ： 以 利 亚 撒 的 子 孙 中 有 十 六 个 族 长 ， 以 他 玛 的 子 孙 中 有 八 个 族 长 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11021', '13', '24', '5', '都 掣 签 分 立 ， 彼 此 一 样 。 在 圣 所 和 　 神 面 前 作 首 领 的 有 以 利 亚 撒 的 子 孙 ， 也 有 以 他 玛 的 子 孙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11022', '13', '24', '6', '作 书 记 的 利 未 人 拿 坦 业 的 儿 子 示 玛 雅 在 王 和 首 领 ， 与 祭 司 撒 督 、 亚 比 亚 他 的 儿 子 亚 希 米 勒 ， 并 祭 司 利 未 人 的 族 长 面 前 记 录 他 们 的 名 字 。 在 以 利 亚 撒 的 子 孙 中 取 一 族 ， 在 以 他 玛 的 子 孙 中 取 一 族 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11023', '13', '24', '7', '掣 签 的 时 候 ， 第 一 掣 出 来 的 是 耶 何 雅 立 ， 第 二 是 耶 大 雅 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11024', '13', '24', '8', '第 三 是 哈 琳 ， 第 四 是 梭 琳 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11025', '13', '24', '9', '第 五 是 玛 基 雅 ， 第 六 是 米 雅 民 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11026', '13', '24', '10', '第 七 是 哈 歌 斯 ， 第 八 是 亚 比 雅 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11027', '13', '24', '11', '第 九 是 耶 书 亚 ， 第 十 是 示 迦 尼 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11028', '13', '24', '12', '第 十 一 是 以 利 亚 实 ， 第 十 二 是 雅 金 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11029', '13', '24', '13', '第 十 三 是 胡 巴 ， 第 十 四 是 耶 是 比 押 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11030', '13', '24', '14', '第 十 五 是 璧 迦 ， 第 十 六 是 音 麦 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11031', '13', '24', '15', '第 十 七 是 希 悉 ， 第 十 八 是 哈 辟 悉 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11032', '13', '24', '16', '第 十 九 是 毗 他 希 雅 ， 第 二 十 是 以 西 结 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11033', '13', '24', '17', '第 二 十 一 是 雅 斤 ， 第 二 十 二 是 迦 末 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11034', '13', '24', '18', '第 二 十 三 是 第 来 雅 ， 第 二 十 四 是 玛 西 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11035', '13', '24', '19', '这 就 是 他 们 的 班 次 ， 要 照 耶 和 华 ─ 以 色 列 的 　 神 藉 他 们 祖 宗 亚 伦 所 吩 咐 的 条 例 进 入 耶 和 华 的 殿 办 理 事 务 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11036', '13', '24', '20', '利 未 其 馀 的 子 孙 如 下 ： 暗 兰 的 子 孙 里 有 书 巴 业 ； 书 巴 业 的 子 孙 里 有 耶 希 底 亚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11037', '13', '24', '21', '利 哈 比 雅 的 子 孙 里 有 长 子 伊 示 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11038', '13', '24', '22', '以 斯 哈 的 子 孙 里 有 示 罗 摩 ； 示 罗 摩 的 子 孙 里 有 雅 哈 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11039', '13', '24', '23', '希 伯 伦 的 子 孙 里 有 长 子 耶 利 雅 ， 次 子 亚 玛 利 亚 ， 三 子 雅 哈 悉 ， 四 子 耶 加 面 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11040', '13', '24', '24', '乌 薛 的 子 孙 里 有 米 迦 ； 米 迦 的 子 孙 里 有 沙 密 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11041', '13', '24', '25', '米 迦 的 兄 弟 是 伊 示 雅 ； 伊 示 雅 的 子 孙 里 有 撒 迦 利 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11042', '13', '24', '26', '米 拉 利 的 儿 子 是 抹 利 、 母 示 、 雅 西 雅 ； 雅 西 雅 的 儿 子 有 比 挪 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11043', '13', '24', '27', '米 拉 利 的 子 孙 里 有 雅 西 雅 的 儿 子 比 挪 、 朔 含 、 撒 刻 、 伊 比 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11044', '13', '24', '28', '抹 利 的 儿 子 是 以 利 亚 撒 ； 以 利 亚 撒 没 有 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11045', '13', '24', '29', '基 士 的 子 孙 里 有 耶 拉 篾 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11046', '13', '24', '30', '母 示 的 儿 子 是 末 力 、 以 得 、 耶 利 摩 。 按 着 宗 族 这 都 是 利 未 的 子 孙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11047', '13', '24', '31', '他 们 在 大 卫 王 和 撒 督 ， 并 亚 希 米 勒 与 祭 司 利 未 人 的 族 长 面 前 掣 签 ， 正 如 他 们 弟 兄 亚 伦 的 子 孙 一 般 。 各 族 的 长 者 与 兄 弟 没 有 分 别 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11048', '13', '25', '1', '大 卫 和 众 首 领 分 派 亚 萨 、 希 幔 ， 并 耶 杜 顿 的 子 孙 弹 琴 、 鼓 瑟 、 敲 钹 、 唱 歌 ( 原 文 作 说 预 言 ； 本 章 同 ) 。 他 们 供 职 的 人 数 记 在 下 面 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11049', '13', '25', '2', '亚 萨 的 儿 子 撒 刻 、 约 瑟 、 尼 探 雅 、 亚 萨 利 拉 都 归 亚 萨 指 教 ， 遵 王 的 旨 意 唱 歌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11050', '13', '25', '3', '耶 杜 顿 的 儿 子 基 大 利 、 西 利 、 耶 筛 亚 、 哈 沙 比 雅 、 玛 他 提 雅 、 示 每 共 六 人 ， 都 归 他 们 父 亲 耶 杜 顿 指 教 ， 弹 琴 ， 唱 歌 ， 称 谢 ， 颂 赞 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11051', '13', '25', '4', '希 幔 的 儿 子 布 基 雅 、 玛 探 雅 、 乌 薛 、 细 布 业 、 耶 利 摩 、 哈 拿 尼 雅 、 哈 拿 尼 、 以 利 亚 他 、 基 大 利 提 、 罗 幔 提 ． 以 谢 、 约 施 比 加 沙 、 玛 罗 提 、 何 提 、 玛 哈 秀 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11052', '13', '25', '5', '这 都 是 希 幔 的 儿 子 ， 吹 角 颂 赞 。 希 幔 奉 　 神 之 命 作 王 的 先 见 。 　 神 赐 给 希 幔 十 四 个 儿 子 ， 三 个 女 儿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11053', '13', '25', '6', '都 归 他 们 父 亲 指 教 ， 在 耶 和 华 的 殿 唱 歌 、 敲 钹 、 弹 琴 、 鼓 瑟 ， 办 　 神 殿 的 事 务 。 亚 萨 、 耶 杜 顿 、 希 幔 都 是 王 所 命 定 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11054', '13', '25', '7', '他 们 和 他 们 的 弟 兄 学 习 颂 赞 耶 和 华 ； 善 於 歌 唱 的 共 有 二 百 八 十 八 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11055', '13', '25', '8', '这 些 人 无 论 大 小 ， 为 师 的 、 为 徒 的 ， 都 一 同 掣 签 分 了 班 次 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11056', '13', '25', '9', '掣 签 的 时 候 ， 第 一 掣 出 来 的 是 亚 萨 的 儿 子 约 瑟 。 第 二 是 基 大 利 ； 他 和 他 弟 兄 并 儿 子 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11057', '13', '25', '10', '第 三 是 撒 刻 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11058', '13', '25', '11', '第 四 是 伊 洗 利 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11059', '13', '25', '12', '第 五 是 尼 探 雅 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11060', '13', '25', '13', '第 六 是 布 基 雅 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11061', '13', '25', '14', '第 七 是 耶 萨 利 拉 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11062', '13', '25', '15', '第 八 是 耶 筛 亚 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11063', '13', '25', '16', '第 九 是 玛 探 雅 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11064', '13', '25', '17', '第 十 是 示 每 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11065', '13', '25', '18', '第 十 一 是 亚 萨 烈 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11066', '13', '25', '19', '第 十 二 是 哈 沙 比 雅 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11067', '13', '25', '20', '第 十 三 是 书 巴 业 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11068', '13', '25', '21', '第 十 四 是 玛 他 提 雅 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11069', '13', '25', '22', '第 十 五 是 耶 利 摩 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11070', '13', '25', '23', '第 十 六 是 哈 拿 尼 雅 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11071', '13', '25', '24', '第 十 七 是 约 施 比 加 沙 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11072', '13', '25', '25', '第 十 八 是 哈 拿 尼 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11073', '13', '25', '26', '第 十 九 是 玛 罗 提 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11074', '13', '25', '27', '第 二 十 是 以 利 亚 他 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11075', '13', '25', '28', '第 二 十 一 是 何 提 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11076', '13', '25', '29', '第 二 十 二 是 基 大 利 提 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11077', '13', '25', '30', '第 二 十 三 是 玛 哈 秀 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11078', '13', '25', '31', '第 二 十 四 是 罗 幔 提 ． 以 谢 ； 他 和 他 儿 子 并 弟 兄 共 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11079', '13', '26', '1', '守 门 的 班 次 记 在 下 面 ： 可 拉 族 亚 萨 的 子 孙 中 ， 有 可 利 的 儿 子 米 施 利 米 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11080', '13', '26', '2', '米 施 利 米 雅 的 长 子 是 撒 迦 利 亚 ， 次 子 是 耶 叠 ， 三 子 是 西 巴 第 雅 ， 四 子 是 耶 提 聂 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11081', '13', '26', '3', '五 子 是 以 拦 ， 六 子 是 约 哈 难 ， 七 子 是 以 利 约 乃 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11082', '13', '26', '4', '俄 别 以 东 的 长 子 是 示 玛 雅 ， 次 子 是 约 萨 拔 ， 三 子 是 约 亚 ， 四 子 是 沙 甲 ， 五 子 是 拿 坦 业 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11083', '13', '26', '5', '六 子 是 亚 米 利 ， 七 子 是 以 萨 迦 ， 八 子 是 毗 乌 利 太 ， 因 为 　 神 赐 福 与 俄 别 以 东 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11084', '13', '26', '6', '他 的 儿 子 示 玛 雅 有 几 个 儿 子 ， 都 是 大 能 的 壮 士 ， 掌 管 父 亲 的 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11085', '13', '26', '7', '示 玛 雅 的 儿 子 是 俄 得 尼 、 利 法 益 、 俄 备 得 、 以 利 萨 巴 。 以 利 萨 巴 的 弟 兄 是 壮 士 ， 还 有 以 利 户 和 西 玛 迦 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11086', '13', '26', '8', '这 都 是 俄 别 以 东 的 子 孙 ， 他 们 和 他 们 的 儿 子 并 弟 兄 ， 都 是 善 於 办 事 的 壮 士 。 俄 别 以 东 的 子 孙 共 六 十 二 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11087', '13', '26', '9', '米 施 利 米 雅 的 儿 子 和 弟 兄 都 是 壮 士 ， 共 十 八 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11088', '13', '26', '10', '米 拉 利 子 孙 何 萨 有 几 个 儿 子 ： 长 子 是 申 利 ， 他 原 不 是 长 子 ， 是 他 父 亲 立 他 作 长 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11089', '13', '26', '11', '次 子 是 希 勒 家 ， 三 子 是 底 巴 利 雅 ， 四 子 是 撒 迦 利 亚 。 何 萨 的 儿 子 并 弟 兄 共 十 三 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11090', '13', '26', '12', '这 些 人 都 是 守 门 的 班 长 ， 与 他 们 的 弟 兄 一 同 在 耶 和 华 殿 里 按 班 供 职 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11091', '13', '26', '13', '他 们 无 论 大 小 ， 都 按 着 宗 族 掣 签 分 守 各 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11092', '13', '26', '14', '掣 签 守 东 门 的 是 示 利 米 雅 ； 他 的 儿 子 撒 迦 利 亚 是 精 明 的 谋 士 ， 掣 签 守 北 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11093', '13', '26', '15', '俄 别 以 东 守 南 门 ， 他 的 儿 子 守 库 房 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11094', '13', '26', '16', '书 聘 与 何 萨 守 西 门 ， 在 靠 近 沙 利 基 门 、 通 着 往 上 去 的 街 道 上 ， 班 与 班 相 对 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11095', '13', '26', '17', '每 日 东 门 有 六 个 利 未 人 ， 北 门 有 四 个 ， 南 门 有 四 个 ， 库 房 有 两 个 ， 又 有 两 个 轮 班 替 换 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11096', '13', '26', '18', '在 西 面 街 道 上 有 四 个 ， 在 游 廊 上 有 两 个 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11097', '13', '26', '19', '以 上 是 可 拉 子 孙 和 米 拉 利 子 孙 守 门 的 班 次 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11098', '13', '26', '20', '利 未 子 孙 中 有 亚 希 雅 掌 管 　 神 殿 的 府 库 和 圣 物 的 府 库 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11099', '13', '26', '21', '革 顺 族 、 拉 但 子 孙 里 ， 作 族 长 的 是 革 顺 族 拉 但 的 子 孙 耶 希 伊 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11100', '13', '26', '22', '耶 希 伊 利 的 儿 子 西 坦 和 他 兄 弟 约 珥 掌 管 耶 和 华 殿 里 的 府 库 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11101', '13', '26', '23', '暗 兰 族 、 以 斯 哈 族 、 希 伯 伦 族 、 乌 泄 族 也 有 职 分 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11102', '13', '26', '24', '摩 西 的 孙 子 、 革 舜 的 儿 子 细 布 业 掌 管 府 库 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11103', '13', '26', '25', '还 有 他 的 弟 兄 以 利 以 谢 。 以 利 以 谢 的 儿 子 是 利 哈 比 雅 ； 利 哈 比 雅 的 儿 子 是 耶 筛 亚 ； 耶 筛 亚 的 儿 子 是 约 兰 ； 约 兰 的 儿 子 是 细 基 利 ； 细 基 利 的 儿 子 是 示 罗 密 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11104', '13', '26', '26', '这 示 罗 密 和 他 的 弟 兄 掌 管 府 库 的 圣 物 ， 就 是 大 卫 王 和 众 族 长 、 千 夫 长 、 百 夫 长 ， 并 军 长 所 分 别 为 圣 的 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11105', '13', '26', '27', '他 们 将 争 战 时 所 夺 的 财 物 分 别 为 圣 ， 以 备 修 造 耶 和 华 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11106', '13', '26', '28', '先 见 撒 母 耳 、 基 士 的 儿 子 扫 罗 、 尼 珥 的 儿 子 押 尼 珥 、 洗 鲁 雅 的 儿 子 约 押 所 分 别 为 圣 的 物 都 归 示 罗 密 和 他 的 弟 兄 掌 管 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11107', '13', '26', '29', '以 斯 哈 族 有 基 拿 尼 雅 和 他 众 子 作 官 长 和 士 师 ， 管 理 以 色 列 的 外 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11108', '13', '26', '30', '希 伯 伦 族 有 哈 沙 比 雅 和 他 弟 兄 一 千 七 百 人 ， 都 是 壮 士 ， 在 约 但 河 西 、 以 色 列 地 办 理 耶 和 华 与 王 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11109', '13', '26', '31', '希 伯 伦 族 中 有 耶 利 雅 作 族 长 。 大 卫 作 王 第 四 十 年 ， 在 基 列 的 雅 谢 ， 从 这 族 中 寻 得 大 能 的 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11110', '13', '26', '32', '耶 利 雅 的 弟 兄 有 二 千 七 百 人 ， 都 是 壮 士 ， 且 作 族 长 ； 大 卫 王 派 他 们 在 流 便 支 派 、 迦 得 支 派 、 玛 拿 西 半 支 派 中 办 理 　 神 和 王 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11111', '13', '27', '1', '以 色 列 人 的 族 长 、 千 夫 长 、 百 夫 长 ， 和 官 长 都 分 定 班 次 ， 每 班 是 二 万 四 千 人 ， 周 年 按 月 轮 流 ， 替 换 出 入 服 事 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11112', '13', '27', '2', '正 月 第 一 班 的 班 长 是 撒 巴 第 业 的 儿 子 雅 朔 班 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11113', '13', '27', '3', '他 是 法 勒 斯 的 子 孙 ， 统 管 正 月 班 的 一 切 军 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11114', '13', '27', '4', '二 月 的 班 长 是 亚 哈 希 人 朵 代 ， 还 有 副 官 密 基 罗 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11115', '13', '27', '5', '三 月 第 三 班 的 班 长 ( 原 文 作 军 长 ； 下 同 ) 是 祭 司 耶 何 耶 大 的 儿 子 比 拿 雅 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11116', '13', '27', '6', '这 比 拿 雅 是 那 三 十 人 中 的 勇 士 ， 管 理 那 三 十 人 ； 他 班 内 又 有 他 儿 子 暗 米 萨 拔 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11117', '13', '27', '7', '四 月 第 四 班 的 班 长 是 约 押 的 兄 弟 亚 撒 黑 。 接 续 他 的 是 他 儿 子 西 巴 第 雅 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11118', '13', '27', '8', '五 月 第 五 班 的 班 长 是 伊 斯 拉 人 珊 合 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11119', '13', '27', '9', '六 月 第 六 班 的 班 长 是 提 哥 亚 人 益 吉 的 儿 子 以 拉 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11120', '13', '27', '10', '七 月 第 七 班 的 班 长 是 以 法 莲 族 比 伦 人 希 利 斯 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11121', '13', '27', '11', '八 月 第 八 班 的 班 长 是 谢 拉 族 户 沙 人 西 比 该 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11122', '13', '27', '12', '九 月 第 九 班 的 班 长 是 便 雅 悯 族 亚 拿 突 人 亚 比 以 谢 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11123', '13', '27', '13', '十 月 第 十 班 的 班 长 是 谢 拉 族 尼 陀 法 人 玛 哈 莱 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11124', '13', '27', '14', '十 一 月 第 十 一 班 的 班 长 是 以 法 莲 族 比 拉 顿 人 比 拿 雅 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11125', '13', '27', '15', '十 二 月 第 十 二 班 的 班 长 是 俄 陀 聂 族 尼 陀 法 人 黑 玳 ； 他 班 内 有 二 万 四 千 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11126', '13', '27', '16', '管 理 以 色 列 众 支 派 的 记 在 下 面 ： 管 流 便 人 的 是 细 基 利 的 儿 子 以 利 以 谢 ； 管 西 缅 人 的 是 玛 迦 的 儿 子 示 法 提 雅 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11127', '13', '27', '17', '管 利 未 人 的 是 基 母 利 的 儿 子 哈 沙 比 雅 ； 管 亚 伦 子 孙 的 是 撒 督 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11128', '13', '27', '18', '管 犹 大 人 的 是 大 卫 的 一 个 哥 哥 以 利 户 ， 管 以 萨 迦 人 的 是 米 迦 勒 的 儿 子 暗 利 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11129', '13', '27', '19', '管 西 布 伦 人 的 是 俄 巴 第 雅 的 儿 子 伊 施 玛 雅 ； 管 拿 弗 他 利 人 的 是 亚 斯 列 的 儿 子 耶 利 摩 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11130', '13', '27', '20', '管 以 法 莲 人 的 是 阿 撒 细 雅 的 儿 子 何 细 亚 ； 管 玛 拿 西 半 支 派 的 是 毗 大 雅 的 儿 子 约 珥 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11131', '13', '27', '21', '管 基 列 地 玛 拿 西 那 半 支 派 的 是 撒 迦 利 亚 的 儿 子 易 多 ； 管 便 雅 悯 人 的 是 押 尼 珥 的 儿 子 雅 西 业 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11132', '13', '27', '22', '管 但 人 的 是 耶 罗 罕 的 儿 子 亚 萨 列 。 以 上 是 以 色 列 众 支 派 的 首 领 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11133', '13', '27', '23', '以 色 列 人 二 十 岁 以 内 的 ， 大 卫 没 有 记 其 数 目 ； 因 耶 和 华 曾 应 许 说 ， 必 加 增 以 色 列 人 如 天 上 的 星 那 样 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11134', '13', '27', '24', '洗 鲁 雅 的 儿 子 约 押 动 手 数 点 ， 当 时 耶 和 华 的 烈 怒 临 到 以 色 列 人 ； 因 此 ， 没 有 点 完 ， 数 目 也 没 有 写 在 大 卫 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11135', '13', '27', '25', '掌 管 王 府 库 的 是 亚 叠 的 儿 子 押 斯 马 威 。 掌 管 田 野 城 邑 村 庄 保 障 之 仓 库 的 是 乌 西 雅 的 儿 子 约 拿 单 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11136', '13', '27', '26', '掌 管 耕 田 种 地 的 是 基 绿 的 儿 子 以 斯 利 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11137', '13', '27', '27', '掌 管 葡 萄 园 的 是 拉 玛 人 示 每 。 掌 管 葡 萄 园 酒 窖 的 是 实 弗 米 人 撒 巴 底 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11138', '13', '27', '28', '掌 管 高 原 橄 榄 树 和 桑 树 的 是 基 第 利 人 巴 勒 哈 南 。 掌 管 油 库 的 是 约 阿 施 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11139', '13', '27', '29', '掌 管 沙 仑 牧 放 牛 群 的 是 沙 仑 人 施 提 赉 。 掌 管 山 谷 牧 养 牛 群 的 是 亚 第 赉 的 儿 子 沙 法 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11140', '13', '27', '30', '掌 管 驼 群 的 是 以 实 玛 利 人 阿 比 勒 。 掌 管 驴 群 的 是 米 仑 人 耶 希 底 亚 。 掌 管 羊 群 的 是 夏 甲 人 雅 悉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11141', '13', '27', '31', '这 都 是 给 大 卫 王 掌 管 产 业 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11142', '13', '27', '32', '大 卫 的 叔 叔 约 拿 单 作 谋 士 ； 这 人 有 智 慧 ， 又 作 书 记 。 哈 摩 尼 的 儿 子 耶 歇 作 王 众 子 的 师 傅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11143', '13', '27', '33', '亚 希 多 弗 也 作 王 的 谋 士 。 亚 基 人 户 筛 作 王 的 陪 伴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11144', '13', '27', '34', '亚 希 多 弗 之 後 ， 有 比 拿 雅 的 儿 子 耶 何 耶 大 和 亚 比 亚 他 接 续 他 作 谋 士 。 约 押 作 王 的 元 帅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11145', '13', '28', '1', '大 卫 招 聚 以 色 列 各 支 派 的 首 领 和 轮 班 服 事 王 的 军 长 ， 与 千 夫 长 、 百 夫 长 ， 掌 管 王 和 王 子 产 业 牲 畜 的 ， 并 太 监 ， 以 及 大 能 的 勇 士 ， 都 到 耶 路 撒 冷 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11146', '13', '28', '2', '大 卫 王 就 站 起 来 ， 说 ： 我 的 弟 兄 ， 我 的 百 姓 啊 ， 你 们 当 听 我 言 ， 我 心 里 本 想 建 造 殿 宇 ， 安 放 耶 和 华 的 约 柜 ， 作 为 我 　 神 的 脚 凳 ； 我 已 经 预 备 建 造 的 材 料 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11147', '13', '28', '3', '只 是 　 神 对 我 说 ： 你 不 可 为 我 的 名 建 造 殿 宇 ； 因 你 是 战 士 ， 流 了 人 的 血 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11148', '13', '28', '4', '然 而 ， 耶 和 华 ─ 以 色 列 的 　 神 在 我 父 的 全 家 拣 选 我 作 以 色 列 的 王 ， 直 到 永 远 。 因 他 拣 选 犹 大 为 首 领 ； 在 犹 大 支 派 中 拣 选 我 父 家 ， 在 我 父 的 众 子 里 喜 悦 我 ， 立 我 作 以 色 列 众 人 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11149', '13', '28', '5', '耶 和 华 赐 我 许 多 儿 子 ， 在 我 儿 子 中 拣 选 所 罗 门 坐 耶 和 华 的 国 位 ， 治 理 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11150', '13', '28', '6', '耶 和 华 对 我 说 ： 你 儿 子 所 罗 门 必 建 造 我 的 殿 和 院 宇 ； 因 为 我 拣 选 他 作 我 的 子 ， 我 也 必 作 他 的 父 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11151', '13', '28', '7', '他 若 恒 久 遵 行 我 的 诫 命 典 章 如 今 日 一 样 ， 我 就 必 坚 定 他 的 国 位 ， 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11152', '13', '28', '8', '现 今 在 耶 和 华 的 会 中 ， 以 色 列 众 人 眼 前 所 说 的 ， 我 们 的 　 神 也 听 见 了 。 你 们 应 当 寻 求 耶 和 华 ─ 你 们 　 神 的 一 切 诫 命 ， 谨 守 遵 行 ， 如 此 你 们 可 以 承 受 这 美 地 ， 遗 留 给 你 们 的 子 孙 ， 永 远 为 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11153', '13', '28', '9', '我 儿 所 罗 门 哪 ， 你 当 认 识 耶 和 华 ─ 你 父 的 　 神 ， 诚 心 乐 意 地 事 奉 他 ； 因 为 他 鉴 察 众 人 的 心 ， 知 道 一 切 心 思 意 念 。 你 若 寻 求 他 ， 他 必 使 你 寻 见 ； 你 若 离 弃 他 ， 他 必 永 远 丢 弃 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11154', '13', '28', '10', '你 当 谨 慎 ， 因 耶 和 华 拣 选 你 建 造 殿 宇 作 为 圣 所 。 你 当 刚 强 去 行 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11155', '13', '28', '11', '大 卫 将 殿 的 游 廊 、 旁 屋 、 府 库 、 楼 房 、 内 殿 ， 和 施 恩 所 的 样 式 指 示 他 儿 子 所 罗 门 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11156', '13', '28', '12', '又 将 被 灵 感 动 所 得 的 样 式 ， 就 是 耶 和 华 　 神 殿 的 院 子 、 周 围 的 房 屋 、 殿 的 府 库 ， 和 圣 物 府 库 的 一 切 样 式 都 指 示 他 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11157', '13', '28', '13', '又 指 示 他 祭 司 和 利 未 人 的 班 次 与 耶 和 华 殿 里 各 样 的 工 作 ， 并 耶 和 华 殿 里 一 切 器 皿 的 样 式 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11158', '13', '28', '14', '以 及 各 样 应 用 金 器 的 分 两 和 各 样 应 用 银 器 的 分 两 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11159', '13', '28', '15', '金 灯 ? 和 金 灯 的 分 两 ， 银 灯 ? 和 银 灯 的 分 两 ， 轻 重 各 都 合 宜 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11160', '13', '28', '16', '陈 设 饼 金 桌 子 的 分 两 ， 银 桌 子 的 分 两 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11161', '13', '28', '17', '精 金 的 肉 叉 子 、 盘 子 ， 和 爵 的 分 两 ， 各 金 碗 与 各 银 碗 的 分 两 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11162', '13', '28', '18', '精 金 香 坛 的 分 两 ， 并 用 金 子 做 基 路 伯 ( 原 文 作 用 金 子 做 车 式 的 基 路 伯 ) ； 基 路 伯 张 开 翅 膀 ， 遮 掩 耶 和 华 的 约 柜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11163', '13', '28', '19', '大 卫 说 ： 这 一 切 工 作 的 样 式 都 是 耶 和 华 用 手 划 出 来 使 我 明 白 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11164', '13', '28', '20', '大 卫 又 对 他 儿 子 所 罗 门 说 ： 你 当 刚 强 壮 胆 去 行 ！ 不 要 惧 怕 ， 也 不 要 惊 惶 。 因 为 耶 和 华 　 神 就 是 我 的 　 神 ， 与 你 同 在 ； 他 必 不 撇 下 你 ， 也 不 丢 弃 你 ， 直 到 耶 和 华 殿 的 工 作 都 完 毕 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11165', '13', '28', '21', '有 祭 司 和 利 未 人 的 各 班 ， 为 要 办 理 　 神 殿 各 样 的 事 ， 又 有 灵 巧 的 人 在 各 样 的 工 作 上 乐 意 帮 助 你 ； 并 有 众 首 领 和 众 民 一 心 听 从 你 的 命 令 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11166', '13', '29', '1', '大 卫 王 对 会 众 说 ： 我 儿 子 所 罗 门 是 　 神 特 选 的 ， 还 年 幼 娇 嫩 ； 这 工 程 甚 大 ， 因 这 殿 不 是 为 人 ， 乃 是 为 耶 和 华 　 神 建 造 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11167', '13', '29', '2', '我 为 我 　 神 的 殿 已 经 尽 力 ， 预 备 金 子 做 金 器 ， 银 子 做 银 器 ， 铜 做 铜 器 ， 铁 做 铁 器 ， 木 做 木 器 ， 还 有 红 玛 瑙 可 镶 嵌 的 宝 石 ， 彩 石 和 一 切 的 宝 石 ， 并 许 多 汉 白 玉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11168', '13', '29', '3', '且 因 我 心 中 爱 慕 我 　 神 的 殿 ， 就 在 预 备 建 造 圣 殿 的 材 料 之 外 ， 又 将 我 自 己 积 蓄 的 金 银 献 上 ， 建 造 我 　 神 的 殿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11169', '13', '29', '4', '就 是 俄 斐 金 三 千 他 连 得 、 精 炼 的 银 子 七 千 他 连 得 ， 以 贴 殿 墙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11170', '13', '29', '5', '金 子 做 金 器 ， 银 子 做 银 器 ， 并 藉 匠 人 的 手 制 造 一 切 。 今 日 有 谁 乐 意 将 自 己 献 给 耶 和 华 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11171', '13', '29', '6', '於 是 ， 众 族 长 和 以 色 列 各 支 派 的 首 领 、 千 夫 长 、 百 夫 长 ， 并 监 管 王 工 的 官 长 ， 都 乐 意 献 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11172', '13', '29', '7', '他 们 为 　 神 殿 的 使 用 献 上 金 子 五 千 他 连 得 零 一 万 达 利 克 ， 银 子 一 万 他 连 得 ， 铜 一 万 八 千 他 连 得 ， 铁 十 万 他 连 得 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11173', '13', '29', '8', '凡 有 宝 石 的 都 交 给 革 顺 人 耶 歇 ， 送 入 耶 和 华 殿 的 府 库 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11174', '13', '29', '9', '因 这 些 人 诚 心 乐 意 献 给 耶 和 华 ， 百 姓 就 欢 喜 ， 大 卫 王 也 大 大 欢 喜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11175', '13', '29', '10', '所 以 ， 大 卫 在 会 众 面 前 称 颂 耶 和 华 说 ： 耶 和 华 ─ 我 们 的 父 ， 以 色 列 的 　 神 是 应 当 称 颂 ， 直 到 永 永 远 远 的 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11176', '13', '29', '11', '耶 和 华 啊 ， 尊 大 、 能 力 、 荣 耀 、 强 胜 、 威 严 都 是 你 的 ； 凡 天 上 地 下 的 都 是 你 的 ； 国 度 也 是 你 的 ， 并 且 你 为 至 高 ， 为 万 有 之 首 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11177', '13', '29', '12', '丰 富 尊 荣 都 从 你 而 来 ， 你 也 治 理 万 物 。 在 你 手 里 有 大 能 大 力 ， 使 人 尊 大 强 盛 都 出 於 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11178', '13', '29', '13', '我 们 的 　 神 啊 ， 现 在 我 们 称 谢 你 ， 赞 美 你 荣 耀 之 名 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11179', '13', '29', '14', '我 算 甚 麽 ， 我 的 民 算 甚 麽 ， 竟 能 如 此 乐 意 奉 献 ？ 因 为 万 物 都 从 你 而 来 ， 我 们 把 从 你 而 得 的 献 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11180', '13', '29', '15', '我 们 在 你 面 前 是 客 旅 ， 是 寄 居 的 ， 与 我 们 列 祖 一 样 。 我 们 在 世 的 日 子 如 影 儿 ， 不 能 长 存 ( 或 作 没 有 长 存 的 指 望 ) 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11181', '13', '29', '16', '耶 和 华 ─ 我 们 的 　 神 啊 ， 我 们 预 备 这 许 多 材 料 ， 要 为 你 的 圣 名 建 造 殿 宇 ， 都 是 从 你 而 来 ， 都 是 属 你 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11182', '13', '29', '17', '我 的 　 神 啊 ， 我 知 道 你 察 验 人 心 ， 喜 悦 正 直 ； 我 以 正 直 的 心 乐 意 献 上 这 一 切 物 。 现 在 我 喜 欢 见 你 的 民 在 这 里 都 乐 意 奉 献 与 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11183', '13', '29', '18', '耶 和 华 ─ 我 们 列 祖 亚 伯 拉 罕 、 以 撒 、 以 色 列 的 　 神 啊 ， 求 你 使 你 的 民 常 存 这 样 的 心 思 意 念 ， 坚 定 他 们 的 心 归 向 你 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11184', '13', '29', '19', '又 求 你 赐 我 儿 子 所 罗 门 诚 实 的 心 ， 遵 守 你 的 命 令 、 法 度 、 律 例 ， 成 就 这 一 切 的 事 ， 用 我 所 预 备 的 建 造 殿 宇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11185', '13', '29', '20', '大 卫 对 全 会 众 说 ： 你 们 应 当 称 颂 耶 和 华 ─ 你 们 的 　 神 。 於 是 会 众 称 颂 耶 和 华 ─ 他 们 列 祖 的 　 神 ， 低 头 拜 耶 和 华 与 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11186', '13', '29', '21', '次 日 ， 他 们 向 耶 和 华 献 平 安 祭 和 燔 祭 ， 就 是 献 公 牛 一 千 只 ， 公 绵 羊 一 千 只 ， 羊 羔 一 千 只 ， 并 同 献 的 奠 祭 ； 又 为 以 色 列 众 人 献 许 多 的 祭 。 那 日 ， 他 们 在 耶 和 华 面 前 吃 喝 ， 大 大 欢 乐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11187', '13', '29', '22', '他 们 奉 耶 和 华 的 命 再 膏 大 卫 的 儿 子 所 罗 门 作 王 ， 又 膏 撒 督 作 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11188', '13', '29', '23', '於 是 所 罗 门 坐 在 耶 和 华 所 赐 的 位 上 ， 接 续 他 父 亲 大 卫 作 王 ， 万 事 亨 通 ； 以 色 列 众 人 也 都 听 从 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11189', '13', '29', '24', '众 首 领 和 勇 士 ， 并 大 卫 王 的 众 子 ， 都 顺 服 所 罗 门 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11190', '13', '29', '25', '耶 和 华 使 所 罗 门 在 以 色 列 众 人 眼 前 甚 为 尊 大 ， 极 其 威 严 ， 胜 过 在 他 以 前 的 以 色 列 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11191', '13', '29', '26', '耶 西 的 儿 子 大 卫 作 以 色 列 众 人 的 王 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11192', '13', '29', '27', '作 王 共 四 十 年 ： 在 希 伯 仑 作 王 七 年 ， 在 耶 路 撒 冷 作 王 三 十 三 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11193', '13', '29', '28', '他 年 纪 老 迈 ， 日 子 满 足 ， 享 受 丰 富 、 尊 荣 ， 就 死 了 。 他 儿 子 所 罗 门 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11194', '13', '29', '29', '大 卫 王 始 终 的 事 都 写 在 先 见 撒 母 耳 的 书 上 和 先 知 拿 单 并 先 见 迦 得 的 书 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11195', '13', '29', '30', '他 的 国 事 和 他 的 勇 力 ， 以 及 他 和 以 色 列 并 列 国 所 经 过 的 事 都 写 在 这 书 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11196', '14', '1', '1', '大 卫 的 儿 子 所 罗 门 国 位 坚 固 ； 耶 和 华 ─ 他 的 　 神 与 他 同 在 ， 使 他 甚 为 尊 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11197', '14', '1', '2', '所 罗 门 吩 咐 以 色 列 众 人 ， 就 是 千 夫 长 、 百 夫 长 、 审 判 官 、 首 领 与 族 长 都 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11198', '14', '1', '3', '所 罗 门 和 会 众 都 往 基 遍 的 邱 坛 去 ， 因 那 里 有 　 神 的 会 幕 ， 就 是 耶 和 华 仆 人 摩 西 在 旷 野 所 制 造 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11199', '14', '1', '4', '只 是 　 神 的 约 柜 ， 大 卫 已 经 从 基 列 耶 琳 搬 到 他 所 预 备 的 地 方 ， 因 他 曾 在 耶 路 撒 冷 为 约 柜 支 搭 了 帐 幕 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11200', '14', '1', '5', '并 且 户 珥 的 孙 子 、 乌 利 的 儿 子 比 撒 列 所 造 的 铜 坛 也 在 基 遍 耶 和 华 的 会 幕 前 。 所 罗 门 和 会 众 都 就 近 坛 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11201', '14', '1', '6', '所 罗 门 上 到 耶 和 华 面 前 会 幕 的 铜 坛 那 里 ， 献 一 千 牺 牲 为 燔 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11202', '14', '1', '7', '当 夜 ， 　 神 向 所 罗 门 显 现 ， 对 他 说 ： 你 愿 我 赐 你 甚 麽 ， 你 可 以 求 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11203', '14', '1', '8', '所 罗 门 对 神 说 ： 你 曾 向 我 父 大 卫 大 施 慈 爱 ， 使 我 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11204', '14', '1', '9', '耶 和 华 　 神 啊 ， 现 在 求 你 成 就 向 我 父 大 卫 所 应 许 的 话 ； 因 你 立 我 作 这 民 的 王 ， 他 们 如 同 地 上 尘 沙 那 样 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11205', '14', '1', '10', '求 你 赐 我 智 慧 聪 明 ， 我 好 在 这 民 前 出 入 ； 不 然 ， 谁 能 判 断 这 众 多 的 民 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11206', '14', '1', '11', '　 神 对 所 罗 门 说 ： 我 已 立 你 作 我 民 的 王 。 你 既 有 这 心 意 ， 并 不 求 资 财 、 丰 富 、 尊 荣 ， 也 不 求 灭 绝 那 恨 你 之 人 的 性 命 ， 又 不 求 大 寿 数 ， 只 求 智 慧 聪 明 好 判 断 我 的 民 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11207', '14', '1', '12', '我 必 赐 你 智 慧 聪 明 ， 也 必 赐 你 资 财 、 丰 富 、 尊 荣 。 在 你 以 前 的 列 王 都 没 有 这 样 ， 在 你 以 後 也 必 没 有 这 样 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11208', '14', '1', '13', '於 是 ， 所 罗 门 从 基 遍 邱 坛 会 幕 前 回 到 耶 路 撒 冷 ， 治 理 以 色 列 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11209', '14', '1', '14', '所 罗 门 聚 集 战 车 马 兵 ， 有 战 车 一 千 四 百 辆 ， 马 兵 一 万 二 千 名 ， 安 置 在 屯 车 的 城 邑 和 耶 路 撒 冷 ， 就 是 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11210', '14', '1', '15', '王 在 耶 路 撒 冷 使 金 银 多 如 石 头 ， 香 柏 木 多 如 高 原 的 桑 树 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11211', '14', '1', '16', '所 罗 门 的 马 是 从 埃 及 带 来 的 ， 是 王 的 商 人 一 群 一 群 按 着 定 价 买 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11212', '14', '1', '17', '他 们 从 埃 及 买 来 的 车 ， 每 辆 价 银 六 百 舍 客 勒 ， 马 每 匹 一 百 五 十 舍 客 勒 。 赫 人 诸 王 和 亚 兰 诸 王 所 买 的 车 马 ， 也 是 按 这 价 值 经 他 们 手 买 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11213', '14', '2', '1', '所 罗 门 定 意 要 为 耶 和 华 的 名 建 造 殿 宇 ， 又 为 自 己 的 国 建 造 宫 室 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11214', '14', '2', '2', '所 罗 门 就 挑 选 七 万 扛 抬 的 ， 八 万 在 山 上 凿 石 头 的 ， 三 千 六 百 督 工 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11215', '14', '2', '3', '所 罗 门 差 人 去 见 推 罗 王 希 兰 ， 说 ： 你 曾 运 香 柏 木 与 我 父 大 卫 建 宫 居 住 ， 求 你 也 这 样 待 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11216', '14', '2', '4', '我 要 为 耶 和 华 ─ 我 　 神 的 名 建 造 殿 宇 ， 分 别 为 圣 献 给 他 ， 在 他 面 前 焚 烧 美 香 ， 常 摆 陈 设 饼 ， 每 早 晚 、 安 息 日 、 月 朔 ， 并 耶 和 华 ─ 我 们 　 神 所 定 的 节 期 献 燔 祭 。 这 是 以 色 列 人 永 远 的 定 例 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11217', '14', '2', '5', '我 所 要 建 造 的 殿 宇 甚 大 ； 因 为 我 们 的 　 神 至 大 ， 超 乎 诸 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11218', '14', '2', '6', '天 和 天 上 的 天 ， 尚 且 不 足 他 居 住 的 ， 谁 能 为 他 建 造 殿 宇 呢 ？ 我 是 谁 ？ 能 为 他 建 造 殿 宇 吗 ？ 不 过 在 他 面 前 烧 香 而 已 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11219', '14', '2', '7', '现 在 求 你 差 一 个 巧 匠 来 ， 就 是 善 用 金 、 银 、 铜 、 铁 ， 和 紫 色 、 朱 红 色 、 蓝 色 线 ， 并 精 於 雕 刻 之 工 的 巧 匠 ， 与 我 父 大 卫 在 犹 大 和 耶 路 撒 冷 所 预 备 的 巧 匠 一 同 做 工 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11220', '14', '2', '8', '又 求 你 从 利 巴 嫩 运 些 香 柏 木 、 松 木 、 檀 香 木 到 我 这 里 来 ， 因 我 知 道 你 的 仆 人 善 於 砍 伐 利 巴 嫩 的 树 木 。 我 的 仆 人 也 必 与 你 的 仆 人 同 工 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11221', '14', '2', '9', '这 样 ， 可 以 给 我 预 备 许 多 的 木 料 ， 因 我 要 建 造 的 殿 宇 高 大 出 奇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11222', '14', '2', '10', '你 的 仆 人 砍 伐 树 木 ， 我 必 给 他 们 打 好 了 的 小 麦 二 万 歌 珥 ， 大 麦 二 万 歌 珥 ， 酒 二 万 罢 特 ， 油 二 万 罢 特 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11223', '14', '2', '11', '推 罗 王 希 兰 写 信 回 答 所 罗 门 说 ： 耶 和 华 因 为 爱 他 的 子 民 ， 所 以 立 你 作 他 们 的 王 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11224', '14', '2', '12', '又 说 ： 创 造 天 地 的 耶 和 华 ─ 以 色 列 的 　 神 是 应 当 称 颂 的 ！ 他 赐 给 大 卫 王 一 个 有 智 慧 的 儿 子 ， 使 他 有 谋 略 聪 明 ， 可 以 为 耶 和 华 建 造 殿 宇 ， 又 为 自 己 的 国 建 造 宫 室 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11225', '14', '2', '13', '现 在 我 打 发 一 个 精 巧 有 聪 明 的 人 去 ， 他 是 我 父 亲 希 兰 所 用 的 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11226', '14', '2', '14', '是 但 支 派 一 个 妇 人 的 儿 子 。 他 父 亲 是 推 罗 人 ， 他 善 用 金 、 银 、 铜 、 铁 、 石 、 木 ， 和 紫 色 、 蓝 色 、 朱 红 色 线 与 细 麻 制 造 各 物 ， 并 精 於 雕 刻 ， 又 能 想 出 各 样 的 巧 工 。 请 你 派 定 这 人 ， 与 你 的 巧 匠 和 你 父 ─ 我 主 大 卫 的 巧 匠 一 同 做 工 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11227', '14', '2', '15', '我 主 所 说 的 小 麦 、 大 麦 、 酒 、 油 ， 愿 我 主 运 来 给 众 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11228', '14', '2', '16', '我 们 必 照 你 所 需 用 的 ， 从 利 巴 嫩 砍 伐 树 木 ， 扎 成 筏 子 ， 浮 海 运 到 约 帕 ； 你 可 以 从 那 里 运 到 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11229', '14', '2', '17', '所 罗 门 仿 照 他 父 大 卫 数 点 住 在 以 色 列 地 所 有 寄 居 的 外 邦 人 ， 共 有 十 五 万 三 千 六 百 名 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11230', '14', '2', '18', '使 七 万 人 扛 抬 材 料 ， 八 万 人 在 山 上 凿 石 头 ， 三 千 六 百 人 督 理 工 作 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11231', '14', '3', '1', '所 罗 门 就 在 耶 路 撒 冷 、 耶 和 华 向 他 父 大 卫 显 现 的 摩 利 亚 山 上 ， 就 是 耶 布 斯 人 阿 珥 楠 的 禾 场 上 、 大 卫 所 指 定 的 地 方 预 备 好 了 ， 开 工 建 造 耶 和 华 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11232', '14', '3', '2', '所 罗 门 作 王 第 四 年 二 月 初 二 日 开 工 建 造 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11233', '14', '3', '3', '所 罗 门 建 筑 　 神 殿 的 根 基 ， 乃 是 这 样 ： 长 六 十 肘 ， 宽 二 十 肘 ， 都 按 着 古 时 的 尺 寸 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11234', '14', '3', '4', '殿 前 的 廊 子 长 二 十 肘 ， 与 殿 的 宽 窄 一 样 ， 高 一 百 二 十 肘 ； 里 面 贴 上 精 金 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11235', '14', '3', '5', '大 殿 的 墙 都 用 松 木 板 遮 蔽 ， 又 贴 了 精 金 ， 上 面 雕 刻 棕 树 和 炼 子 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11236', '14', '3', '6', '又 用 宝 石 装 饰 殿 墙 ， 使 殿 华 美 ； 所 用 的 金 子 都 是 巴 瓦 音 的 金 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11237', '14', '3', '7', '又 用 金 子 贴 殿 和 殿 的 栋 梁 、 门 槛 、 墙 壁 、 门 扇 ； 墙 上 雕 刻 基 路 伯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11238', '14', '3', '8', '又 建 造 至 圣 所 ， 长 二 十 肘 ， 与 殿 的 宽 窄 一 样 ， 宽 也 是 二 十 肘 ； 贴 上 精 金 ， 共 用 金 子 六 百 他 连 得 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11239', '14', '3', '9', '金 钉 重 五 十 舍 客 勒 。 楼 房 都 贴 上 金 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11240', '14', '3', '10', '在 至 圣 所 按 造 像 的 法 子 造 两 个 基 路 伯 ， 用 金 子 包 裹 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11241', '14', '3', '11', '两 个 基 路 伯 的 翅 膀 共 长 二 十 肘 。 这 基 路 伯 的 一 个 翅 膀 长 五 肘 ， 挨 着 殿 这 边 的 墙 ； 那 一 个 翅 膀 也 长 五 肘 ， 与 那 基 路 伯 翅 膀 相 接 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11242', '14', '3', '12', '那 基 路 伯 的 一 个 翅 膀 长 五 肘 ， 挨 着 殿 那 边 的 墙 ； 那 一 个 翅 膀 也 长 五 肘 ， 与 这 基 路 伯 的 翅 膀 相 接 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11243', '14', '3', '13', '两 个 基 路 伯 张 开 翅 膀 ， 共 长 二 十 肘 ， 面 向 外 殿 而 立 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11244', '14', '3', '14', '又 用 蓝 色 、 紫 色 、 朱 红 色 线 和 细 麻 织 幔 子 ， 在 其 上 绣 出 基 路 伯 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11245', '14', '3', '15', '在 殿 前 造 了 两 根 柱 子 ， 高 三 十 五 肘 ； 每 柱 顶 高 五 肘 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11246', '14', '3', '16', '又 照 圣 所 内 炼 子 的 样 式 做 炼 子 ， 安 在 柱 顶 上 ； 又 做 一 百 石 榴 ， 安 在 炼 子 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11247', '14', '3', '17', '将 两 根 柱 子 立 在 殿 前 ， 一 根 在 右 边 ， 一 根 在 左 边 ； 右 边 的 起 名 叫 雅 斤 ， 左 边 的 起 名 叫 波 阿 斯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11248', '14', '4', '1', '他 又 制 造 一 座 铜 坛 ， 长 二 十 肘 ， 宽 二 十 肘 ， 高 十 肘 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11249', '14', '4', '2', '又 铸 一 个 铜 海 ， 样 式 是 圆 的 ， 高 五 肘 ， 径 十 肘 ， 围 三 十 肘 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11250', '14', '4', '3', '海 周 围 有 野 瓜 ( 原 文 作 牛 ) 的 样 式 ， 每 肘 十 瓜 ， 共 有 两 行 ， 是 铸 海 的 时 候 铸 上 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11251', '14', '4', '4', '有 十 二 只 铜 牛 驮 海 ： 三 只 向 北 ， 三 只 向 西 ， 三 只 向 南 ， 三 只 向 东 ； 海 在 牛 上 ， 牛 尾 向 内 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11252', '14', '4', '5', '海 厚 一 掌 ， 边 如 杯 边 ， 又 如 百 合 花 ， 可 容 三 千 罢 特 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11253', '14', '4', '6', '又 制 造 十 个 盆 ： 五 个 放 在 右 边 ， 五 个 放 在 左 边 ， 献 燔 祭 所 用 之 物 都 洗 在 其 内 ； 但 海 是 为 祭 司 沐 浴 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11254', '14', '4', '7', '他 又 照 所 定 的 样 式 造 十 个 金 灯 ? 放 在 殿 里 ： 五 个 在 右 边 ， 五 个 在 左 边 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11255', '14', '4', '8', '又 造 十 张 桌 子 放 在 殿 里 ： 五 张 在 右 边 ， 五 张 在 左 边 ； 又 造 一 百 个 金 碗 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11256', '14', '4', '9', '又 建 立 祭 司 院 和 大 院 ， 并 院 门 ， 用 铜 包 裹 门 扇 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11257', '14', '4', '10', '将 海 安 在 殿 门 的 右 边 ， 就 是 南 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11258', '14', '4', '11', '户 兰 又 造 了 盆 、 铲 、 碗 。 这 样 ， 他 为 所 罗 门 王 做 完 了 　 神 殿 的 工 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11259', '14', '4', '12', '所 造 的 就 是 ： 两 根 柱 子 和 柱 上 两 个 如 球 的 顶 ， 并 两 个 盖 柱 顶 的 网 子');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11260', '14', '4', '13', '和 四 百 石 榴 ， 安 在 两 个 网 子 上 〈 每 网 两 行 盖 着 两 个 柱 上 如 球 的 顶 〉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11261', '14', '4', '14', '盆 座 和 其 上 的 盆 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11262', '14', '4', '15', '海 和 海 下 的 十 二 只 牛 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11263', '14', '4', '16', '盆 、 铲 子 、 肉 锸 子 ， 与 耶 和 华 殿 里 的 一 切 器 皿 ， 都 是 巧 匠 户 兰 用 光 亮 的 铜 为 所 罗 门 王 造 成 的 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11264', '14', '4', '17', '是 在 约 但 平 原 疏 割 和 撒 利 但 中 间 藉 胶 泥 铸 成 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11265', '14', '4', '18', '所 罗 门 制 造 的 这 一 切 甚 多 ， 铜 的 轻 重 无 法 可 查 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11266', '14', '4', '19', '所 罗 门 又 造 　 神 殿 里 的 金 坛 和 陈 设 饼 的 桌 子 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11267', '14', '4', '20', '并 精 金 的 灯 ? 和 灯 盏 ， 可 以 照 例 点 在 内 殿 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11268', '14', '4', '21', '灯 ? 上 的 花 和 灯 盏 ， 并 蜡 剪 都 是 金 的 ， 且 是 纯 金 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11269', '14', '4', '22', '又 用 精 金 制 造 镊 子 、 盘 子 、 调 羹 、 火 鼎 。 至 於 殿 门 和 至 圣 所 的 门 扇 ， 并 殿 的 门 扇 ， 都 是 金 子 妆 饰 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11270', '14', '5', '1', '所 罗 门 做 完 了 耶 和 华 殿 的 一 切 工 ， 就 把 他 父 大 卫 分 别 为 圣 的 金 银 和 器 皿 都 带 来 ， 放 在 　 神 殿 的 府 库 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11271', '14', '5', '2', '那 时 ， 所 罗 门 将 以 色 列 的 长 老 、 各 支 派 的 首 领 ， 并 以 色 列 的 族 长 招 聚 到 耶 路 撒 冷 ， 要 把 耶 和 华 的 约 柜 从 大 卫 城 ─ 就 是 锡 安 ─ 运 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11272', '14', '5', '3', '於 是 以 色 列 众 人 在 七 月 节 前 都 聚 集 到 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11273', '14', '5', '4', '以 色 列 众 长 老 来 到 ， 利 未 人 便 抬 起 约 柜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11274', '14', '5', '5', '祭 司 利 未 人 将 约 柜 运 上 来 ， 又 将 会 幕 和 会 幕 的 一 切 圣 器 具 都 带 上 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11275', '14', '5', '6', '所 罗 门 王 和 聚 集 到 他 那 里 的 以 色 列 全 会 众 都 在 约 柜 前 献 牛 羊 为 祭 ， 多 得 不 可 胜 数 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11276', '14', '5', '7', '祭 司 将 耶 和 华 的 约 柜 抬 进 内 殿 ， 就 是 至 圣 所 ， 放 在 两 个 基 路 伯 的 翅 膀 底 下 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11277', '14', '5', '8', '基 路 伯 张 着 翅 膀 在 约 柜 之 上 ， 遮 掩 约 柜 和 抬 柜 的 杠 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11278', '14', '5', '9', '这 杠 甚 长 ， 杠 头 在 内 殿 前 可 以 看 见 ， 在 殿 外 却 不 能 看 见 ， 直 到 如 今 还 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11279', '14', '5', '10', '约 柜 里 惟 有 两 块 石 版 ， 就 是 以 色 列 人 出 埃 及 後 ， 耶 和 华 与 他 们 立 约 的 时 候 ， 摩 西 在 何 烈 山 所 放 的 。 除 此 以 外 ， 并 无 别 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11280', '14', '5', '11', '当 时 ， 在 那 里 所 有 的 祭 司 都 已 自 洁 ， 并 不 分 班 供 职 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11281', '14', '5', '12', '他 们 出 圣 所 的 时 候 ， 歌 唱 的 利 未 人 亚 萨 、 希 幔 、 耶 杜 顿 ， 和 他 们 的 众 子 众 弟 兄 都 穿 细 麻 布 衣 服 ， 站 在 坛 的 东 边 ， 敲 钹 、 鼓 瑟 、 弹 琴 ， 同 着 他 们 有 一 百 二 十 个 祭 司 吹 号 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11282', '14', '5', '13', '吹 号 的 、 歌 唱 的 都 一 齐 发 声 ， 声 合 为 一 ， 赞 美 感 谢 耶 和 华 。 吹 号 、 敲 钹 ， 用 各 种 乐 器 ， 扬 声 赞 美 耶 和 华 说 ： 耶 和 华 本 为 善 ， 他 的 慈 爱 永 远 长 存 ！ 那 时 ， 耶 和 华 的 殿 有 云 充 满 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11283', '14', '5', '14', '甚 至 祭 司 不 能 站 立 供 职 ， 因 为 耶 和 华 的 荣 光 充 满 了 　 神 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11284', '14', '6', '1', '那 时 ， 所 罗 门 说 ： 耶 和 华 曾 说 他 必 住 在 幽 暗 之 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11285', '14', '6', '2', '但 我 已 经 建 造 殿 宇 作 你 的 居 所 ， 为 你 永 远 的 住 处 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11286', '14', '6', '3', '王 转 脸 为 以 色 列 会 众 祝 福 ， 以 色 列 会 众 就 都 站 立 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11287', '14', '6', '4', '所 罗 门 说 ： 耶 和 华 ─ 以 色 列 的 　 神 是 应 当 称 颂 的 ！ 因 他 亲 口 向 我 父 大 卫 所 应 许 的 ， 也 亲 手 成 就 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11288', '14', '6', '5', '他 说 ： 自 从 我 领 我 民 出 埃 及 地 以 来 ， 我 未 曾 在 以 色 列 众 支 派 中 选 择 一 城 建 造 殿 宇 为 我 名 的 居 所 ， 也 未 曾 拣 选 一 人 作 我 民 以 色 列 的 君 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11289', '14', '6', '6', '但 选 择 耶 路 撒 冷 为 我 名 的 居 所 ， 又 拣 选 大 卫 治 理 我 民 以 色 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11290', '14', '6', '7', '所 罗 门 说 ： 我 父 大 卫 曾 立 意 要 为 耶 和 华 ─ 以 色 列 　 神 的 名 建 殿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11291', '14', '6', '8', '耶 和 华 却 对 我 父 大 卫 说 ： 你 立 意 要 为 我 的 名 建 殿 ， 这 意 思 甚 好 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11292', '14', '6', '9', '只 是 你 不 可 建 殿 ， 惟 你 所 生 的 儿 子 必 为 我 名 建 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11293', '14', '6', '10', '现 在 耶 和 华 成 就 了 他 所 应 许 的 话 ， 使 我 接 续 我 父 大 卫 坐 以 色 列 的 国 位 ， 是 照 耶 和 华 所 说 的 ， 又 为 耶 和 华 ─ 以 色 列 　 神 的 名 建 造 了 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11294', '14', '6', '11', '我 将 约 柜 安 置 在 其 中 ， 柜 内 有 耶 和 华 的 约 ， 就 是 他 与 以 色 列 人 所 立 的 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11295', '14', '6', '12', '所 罗 门 当 着 以 色 列 会 众 ， 站 在 耶 和 华 的 坛 前 ， 举 起 手 来 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11296', '14', '6', '13', '〈 所 罗 门 曾 造 一 个 铜 ? ， 长 五 肘 ， 宽 五 肘 ， 高 三 肘 ， 放 在 院 中 〉 就 站 在 ? 上 ， 当 着 以 色 列 的 会 众 跪 下 ， 向 天 举 手 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11297', '14', '6', '14', '说 ： 耶 和 华 ─ 以 色 列 的 　 神 啊 ， 天 上 地 下 没 有 　 神 可 比 你 的 ！ 你 向 那 尽 心 行 在 你 面 前 的 仆 人 守 约 施 慈 爱 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11298', '14', '6', '15', '向 你 仆 人 ─ 我 父 大 卫 所 应 许 的 话 现 在 应 验 了 。 你 亲 口 应 许 ， 亲 手 成 就 ， 正 如 今 日 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11299', '14', '6', '16', '耶 和 华 ─ 以 色 列 的 　 神 啊 ， 你 所 应 许 你 仆 人 ─ 我 父 大 卫 的 话 说 ： 你 的 子 孙 若 谨 慎 自 己 的 行 为 ， 遵 守 我 的 律 法 ， 像 你 在 我 面 前 所 行 的 一 样 ， 就 不 断 人 坐 以 色 列 的 国 位 。 现 在 求 你 应 验 这 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11300', '14', '6', '17', '耶 和 华 ─ 以 色 列 的 　 神 啊 ， 求 你 成 就 向 你 仆 人 大 卫 所 应 许 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11301', '14', '6', '18', '　 神 果 真 与 世 人 同 住 在 地 上 麽 ？ 看 哪 ， 天 和 天 上 的 天 尚 且 不 足 你 居 住 的 ， 何 况 我 所 建 的 这 殿 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11302', '14', '6', '19', '惟 求 耶 和 华 ─ 我 的 　 神 垂 顾 仆 人 的 祷 告 祈 求 ， 俯 听 仆 人 在 你 面 前 的 祈 祷 呼 吁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11303', '14', '6', '20', '愿 你 昼 夜 看 顾 这 殿 ， 就 是 你 应 许 立 为 你 名 的 居 所 ； 求 你 垂 听 仆 人 向 此 处 祷 告 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11304', '14', '6', '21', '你 仆 人 和 你 民 以 色 列 向 此 处 祈 祷 的 时 候 ， 求 你 从 天 上 你 的 居 所 垂 听 ， 垂 听 而 赦 免 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11305', '14', '6', '22', '人 若 得 罪 邻 舍 ， 有 人 叫 他 起 誓 ， 他 来 到 这 殿 ， 在 你 的 坛 前 起 誓 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11306', '14', '6', '23', '求 你 从 天 上 垂 听 ， 判 断 你 的 仆 人 ， 定 恶 人 有 罪 ， 照 他 所 行 的 报 应 在 他 头 上 ； 定 义 人 有 理 ， 照 他 的 义 赏 赐 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11307', '14', '6', '24', '你 的 民 以 色 列 若 得 罪 你 ， 败 在 仇 敌 面 前 ， 又 回 心 转 意 承 认 你 的 名 ， 在 这 殿 里 向 你 祈 求 祷 告 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11308', '14', '6', '25', '求 你 从 天 上 垂 听 ， 赦 免 你 民 以 色 列 的 罪 ， 使 他 们 归 回 你 赐 给 他 们 和 他 们 列 祖 之 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11309', '14', '6', '26', '你 的 民 因 得 罪 你 ， 你 惩 罚 他 们 ， 使 天 闭 塞 不 下 雨 ， 他 们 若 向 此 处 祷 告 ， 承 认 你 的 名 ， 离 开 他 们 的 罪 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11310', '14', '6', '27', '求 你 在 天 上 垂 听 ， 赦 免 你 仆 人 和 你 民 以 色 列 的 罪 ， 将 当 行 的 善 道 指 教 他 们 ， 且 降 雨 在 你 的 地 ， 就 是 你 赐 给 你 民 为 业 之 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11311', '14', '6', '28', '国 中 若 有 饥 荒 、 瘟 疫 、 旱 风 、 霉 烂 、 蝗 虫 、 蚂 蚱 ， 或 有 仇 敌 犯 境 ， 围 困 城 邑 ， 无 论 遭 遇 甚 麽 灾 祸 疾 病 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11312', '14', '6', '29', '你 的 民 以 色 列 ， 或 是 众 人 ， 或 是 一 人 ， 自 觉 灾 祸 甚 苦 ， 向 这 殿 举 手 ， 无 论 祈 求 甚 麽 ， 祷 告 甚 麽 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11313', '14', '6', '30', '求 你 从 天 上 你 的 居 所 垂 听 赦 免 。 你 是 知 道 人 心 的 ， 要 照 各 人 所 行 的 待 他 们 （ 惟 有 你 知 道 世 人 的 心 ） ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11314', '14', '6', '31', '使 他 们 在 你 赐 给 我 们 列 祖 之 地 上 一 生 一 世 敬 畏 你 ， 遵 行 你 的 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11315', '14', '6', '32', '论 到 不 属 你 民 以 色 列 的 外 邦 人 ， 为 你 的 大 名 和 大 能 的 手 ， 并 伸 出 来 的 膀 臂 ， 从 远 方 而 来 ， 向 这 殿 祷 告 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11316', '14', '6', '33', '求 你 从 天 上 你 的 居 所 垂 听 ， 照 着 外 邦 人 所 祈 求 的 而 行 ， 使 天 下 万 民 都 认 识 你 的 名 ， 敬 畏 你 ， 像 你 的 民 以 色 列 一 样 ， 又 使 他 们 知 道 我 建 造 的 这 殿 是 称 为 你 名 下 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11317', '14', '6', '34', '你 的 民 若 奉 你 的 差 遣 ， 无 论 往 何 处 去 与 仇 敌 争 战 ， 向 你 所 选 择 的 城 与 我 为 你 名 所 建 造 的 殿 祷 告 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11318', '14', '6', '35', '求 你 从 天 上 垂 听 他 们 的 祷 告 祈 求 ， 使 他 们 得 胜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11319', '14', '6', '36', '你 的 民 若 得 罪 你 （ 世 上 没 有 不 犯 罪 的 人 ） ， 你 向 他 们 发 怒 ， 将 他 们 交 给 仇 敌 掳 到 或 远 或 近 之 地 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11320', '14', '6', '37', '他 们 若 在 掳 到 之 地 想 起 罪 来 ， 回 心 转 意 ， 恳 求 你 说 ： 我 们 有 罪 了 ， 我 们 悖 逆 了 ， 我 们 作 恶 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11321', '14', '6', '38', '他 们 若 在 掳 到 之 地 尽 心 尽 性 归 服 你 ， 又 向 自 己 的 地 ， 就 是 你 赐 给 他 们 列 祖 之 地 和 你 所 选 择 的 城 ， 并 我 为 你 名 所 建 造 的 殿 祷 告 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11322', '14', '6', '39', '求 你 从 天 上 你 的 居 所 垂 听 你 民 的 祷 告 祈 求 ， 为 他 们 伸 冤 ， 赦 免 他 们 的 过 犯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11323', '14', '6', '40', '我 的 　 神 啊 ， 现 在 求 你 睁 眼 看 ， 侧 耳 听 在 此 处 所 献 的 祷 告 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11324', '14', '6', '41', '耶 和 华 　 神 啊 ， 求 你 起 来 ， 和 你 有 能 力 的 约 柜 同 入 安 息 之 所 。 耶 和 华 　 神 啊 ， 愿 你 的 祭 司 披 上 救 恩 ； 愿 你 的 圣 民 蒙 福 欢 乐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11325', '14', '6', '42', '耶 和 华 　 神 啊 ， 求 你 不 要 厌 弃 你 的 受 膏 者 ， 要 记 念 向 你 仆 人 大 卫 所 施 的 慈 爱 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11326', '14', '7', '1', '所 罗 门 祈 祷 已 毕 ， 就 有 火 从 天 上 降 下 来 ， 烧 尽 燔 祭 和 别 的 祭 。 耶 和 华 的 荣 光 充 满 了 殿 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11327', '14', '7', '2', '因 耶 和 华 的 荣 光 充 满 了 耶 和 华 殿 ， 所 以 祭 司 不 能 进 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11328', '14', '7', '3', '那 火 降 下 、 耶 和 华 的 荣 光 在 殿 上 的 时 候 ， 以 色 列 众 人 看 见 ， 就 在 铺 石 地 俯 伏 叩 拜 ， 称 谢 耶 和 华 说 ： 耶 和 华 本 为 善 ， 他 的 慈 爱 永 远 长 存 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11329', '14', '7', '4', '王 和 众 民 在 耶 和 华 面 前 献 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11330', '14', '7', '5', '所 罗 门 王 用 牛 二 万 二 千 ， 羊 十 二 万 献 祭 。 这 样 ， 王 和 众 民 为 　 神 的 殿 行 奉 献 之 礼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11331', '14', '7', '6', '祭 司 侍 立 ， 各 供 其 职 ； 利 未 人 也 拿 着 耶 和 华 的 乐 器 ， 就 是 大 卫 王 造 出 来 、 藉 利 未 人 颂 赞 耶 和 华 的 。 （ 他 的 慈 爱 永 远 长 存 ！ ） 祭 司 在 众 人 面 前 吹 号 ， 以 色 列 人 都 站 立 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11332', '14', '7', '7', '所 罗 门 因 他 所 造 的 铜 坛 容 不 下 燔 祭 、 素 祭 ， 和 脂 油 ， 便 将 耶 和 华 殿 前 院 子 当 中 分 别 为 圣 ， 在 那 里 献 燔 祭 和 平 安 祭 牲 的 脂 油 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11333', '14', '7', '8', '那 时 所 罗 门 和 以 色 列 众 人 ， 就 是 从 哈 马 口 直 到 埃 及 小 河 ， 所 有 的 以 色 列 人 都 聚 集 成 为 大 会 ， 守 节 七 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11334', '14', '7', '9', '第 八 日 设 立 严 肃 会 ， 行 奉 献 坛 的 礼 七 日 ， 守 节 七 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11335', '14', '7', '10', '七 月 二 十 三 日 ， 王 遣 散 众 民 ； 他 们 因 见 耶 和 华 向 大 卫 和 所 罗 门 与 他 民 以 色 列 所 施 的 恩 惠 ， 就 都 心 中 喜 乐 ， 各 归 各 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11336', '14', '7', '11', '所 罗 门 造 成 了 耶 和 华 殿 和 王 宫 ； 在 耶 和 华 殿 和 王 宫 凡 他 心 中 所 要 做 的 ， 都 顺 顺 利 利 地 做 成 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11337', '14', '7', '12', '夜 间 耶 和 华 向 所 罗 门 显 现 ， 对 他 说 ： 我 已 听 了 你 的 祷 告 ， 也 选 择 这 地 方 作 为 祭 祀 我 的 殿 宇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11338', '14', '7', '13', '我 若 使 天 闭 塞 不 下 雨 ， 或 使 蝗 虫 吃 这 地 的 出 产 ， 或 使 瘟 疫 流 行 在 我 民 中 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11339', '14', '7', '14', '这 称 为 我 名 下 的 子 民 ， 若 是 自 卑 、 祷 告 ， 寻 求 我 的 面 ， 转 离 他 们 的 恶 行 ， 我 必 从 天 上 垂 听 ， 赦 免 他 们 的 罪 ， 医 治 他 们 的 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11340', '14', '7', '15', '我 必 睁 眼 看 、 侧 耳 听 在 此 处 所 献 的 祷 告 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11341', '14', '7', '16', '现 在 我 已 选 择 这 殿 ， 分 别 为 圣 ， 使 我 的 名 永 在 其 中 ， 我 的 眼 、 我 的 心 也 必 常 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11342', '14', '7', '17', '你 若 在 我 面 前 效 法 你 父 大 卫 所 行 的 ， 遵 行 我 一 切 所 吩 咐 你 的 ， 谨 守 我 的 律 例 典 章 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11343', '14', '7', '18', '我 就 必 坚 固 你 的 国 位 ， 正 如 我 与 你 父 大 卫 所 立 的 约 ， 说 ： 你 的 子 孙 必 不 断 人 作 以 色 列 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11344', '14', '7', '19', '倘 若 你 们 转 去 丢 弃 我 指 示 你 们 的 律 例 诫 命 ， 去 事 奉 敬 拜 别 　 神 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11345', '14', '7', '20', '我 就 必 将 以 色 列 人 从 我 赐 给 他 们 的 地 上 拔 出 根 来 ， 并 且 我 为 己 名 所 分 别 为 圣 的 殿 也 必 舍 弃 不 顾 ， 使 他 在 万 民 中 作 笑 谈 ， 被 讥 诮 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11346', '14', '7', '21', '这 殿 虽 然 甚 高 ， 将 来 经 过 的 人 必 惊 讶 说 ： 耶 和 华 为 何 向 这 地 和 这 殿 如 此 行 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11347', '14', '7', '22', '人 必 回 答 说 ： 是 因 此 地 的 人 离 弃 耶 和 华 ─ 他 们 列 祖 的 　 神 ， 就 是 领 他 们 出 埃 及 地 的 　 神 ， 去 亲 近 别 　 神 ， 敬 拜 事 奉 他 ， 所 以 耶 和 华 使 这 一 切 灾 祸 临 到 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11348', '14', '8', '1', '所 罗 门 建 造 耶 和 华 殿 和 王 宫 ， 二 十 年 才 完 毕 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11349', '14', '8', '2', '以 後 所 罗 门 重 新 修 筑 希 兰 送 给 他 的 那 些 城 邑 ， 使 以 色 列 人 住 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11350', '14', '8', '3', '所 罗 门 往 哈 马 琐 巴 去 ， 攻 取 了 那 地 方 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11351', '14', '8', '4', '所 罗 门 建 造 旷 野 里 的 达 莫 ， 又 建 造 哈 马 所 有 的 积 货 城 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11352', '14', '8', '5', '又 建 造 上 伯 和 仑 、 下 伯 和 仑 作 为 保 障 ， 都 有 墙 ， 有 门 ， 有 闩 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11353', '14', '8', '6', '又 建 造 巴 拉 和 所 有 的 积 货 城 ， 并 屯 车 辆 马 兵 的 城 ， 与 耶 路 撒 冷 、 利 巴 嫩 ， 以 及 自 己 治 理 的 全 国 中 所 愿 意 建 造 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11354', '14', '8', '7', '至 於 国 中 所 剩 下 不 属 以 色 列 人 的 赫 人 、 亚 摩 利 人 、 比 利 洗 人 、 希 未 人 、 耶 布 斯 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11355', '14', '8', '8', '就 是 以 色 列 人 未 曾 灭 绝 的 ， 所 罗 门 挑 取 他 们 的 後 裔 作 服 苦 的 奴 仆 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11356', '14', '8', '9', '惟 有 以 色 列 人 ， 所 罗 门 不 使 他 们 当 奴 仆 做 工 ， 乃 是 作 他 的 战 士 、 军 长 的 统 领 、 车 兵 长 、 马 兵 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11357', '14', '8', '10', '所 罗 门 王 有 二 百 五 十 督 工 的 ， 监 管 工 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11358', '14', '8', '11', '所 罗 门 将 法 老 的 女 儿 带 出 大 卫 城 ， 上 到 为 他 建 造 的 宫 里 ； 因 所 罗 门 说 ： 耶 和 华 约 柜 所 到 之 处 都 为 圣 地 ， 所 以 我 的 妻 不 可 住 在 以 色 列 王 大 卫 的 宫 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11359', '14', '8', '12', '所 罗 门 在 耶 和 华 的 坛 上 ， 就 是 在 廊 子 前 他 所 筑 的 坛 上 ， 与 耶 和 华 献 燔 祭 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11360', '14', '8', '13', '又 遵 着 摩 西 的 吩 咐 在 安 息 日 、 月 朔 ， 并 一 年 三 节 ， 就 是 除 酵 节 、 七 七 节 、 住 棚 节 ， 献 每 日 所 当 献 的 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11361', '14', '8', '14', '所 罗 门 照 着 他 父 大 卫 所 定 的 例 ， 派 定 祭 司 的 班 次 ， 使 他 们 各 供 己 事 ， 又 使 利 未 人 各 尽 其 职 ， 赞 美 耶 和 华 ， 在 祭 司 面 前 做 每 日 所 当 做 的 ； 又 派 守 门 的 按 着 班 次 看 守 各 门 ， 因 为 　 神 人 大 卫 是 这 样 吩 咐 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11362', '14', '8', '15', '王 所 吩 咐 众 祭 司 和 利 未 人 的 ， 无 论 是 管 府 库 或 办 别 的 事 ， 他 们 都 不 违 背 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11363', '14', '8', '16', '所 罗 门 建 造 耶 和 华 的 殿 ， 从 立 根 基 直 到 成 功 的 日 子 ， 工 料 俱 备 。 这 样 ， 耶 和 华 的 殿 全 然 完 毕 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11364', '14', '8', '17', '那 时 ， 所 罗 门 往 以 东 地 靠 海 的 以 旬 迦 别 和 以 禄 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11365', '14', '8', '18', '希 兰 差 遣 他 的 臣 仆 ， 将 船 只 和 熟 悉 泛 海 的 仆 人 送 到 所 罗 门 那 里 。 他 们 同 着 所 罗 门 的 仆 人 到 了 俄 斐 ， 得 了 四 百 五 十 他 连 得 金 子 ， 运 到 所 罗 门 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11366', '14', '9', '1', '示 巴 女 王 听 见 所 罗 门 的 名 声 ， 就 来 到 耶 路 撒 冷 ， 要 用 难 解 的 话 试 问 所 罗 门 ； 跟 随 他 的 人 甚 多 ， 又 有 骆 驼 驮 着 香 料 、 宝 石 ， 和 许 多 金 子 。 他 来 见 了 所 罗 门 ， 就 把 心 里 所 有 的 对 所 罗 门 都 说 出 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11367', '14', '9', '2', '所 罗 门 将 他 所 问 的 都 答 上 了 ， 没 有 一 句 不 明 白 、 不 能 答 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11368', '14', '9', '3', '示 巴 女 王 见 所 罗 门 的 智 慧 和 他 所 建 造 的 宫 室 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11369', '14', '9', '4', '席 上 的 珍 馐 美 味 、 群 臣 分 列 而 坐 、 仆 人 两 旁 侍 立 ， 以 及 他 们 的 衣 服 装 饰 、 酒 政 ， 和 酒 政 的 衣 服 装 饰 ， 又 见 他 上 耶 和 华 殿 的 ? 阶 ， 就 诧 异 得 神 不 守 舍 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11370', '14', '9', '5', '对 王 说 ： 我 在 本 国 里 所 听 见 论 到 你 的 事 和 你 的 智 慧 实 在 是 真 的 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11371', '14', '9', '6', '我 先 不 信 那 些 话 ， 及 至 我 来 亲 眼 见 了 ， 才 知 道 你 的 大 智 慧 ； 人 所 告 诉 我 的 ， 还 不 到 一 半 ； 你 的 实 迹 越 过 我 所 听 见 的 名 声 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11372', '14', '9', '7', '你 的 群 臣 、 你 的 仆 人 常 侍 立 在 你 面 前 听 你 智 慧 的 话 是 有 福 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11373', '14', '9', '8', '耶 和 华 ─ 你 的 　 神 是 应 当 称 颂 的 ！ 他 喜 悦 你 ， 使 你 坐 他 的 国 位 ， 为 耶 和 华 ─ 你 的 　 神 作 王 ； 因 为 你 的 　 神 爱 以 色 列 人 ， 要 永 远 坚 立 他 们 ， 所 以 立 你 作 他 们 的 王 ， 使 你 秉 公 行 义 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11374', '14', '9', '9', '於 是 示 巴 女 王 将 一 百 二 十 他 连 得 金 子 和 宝 石 ， 与 极 多 的 香 料 送 给 所 罗 门 王 ； 他 送 给 王 的 香 料 ， 以 後 再 没 有 这 样 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11375', '14', '9', '10', '希 兰 的 仆 人 和 所 罗 门 的 仆 人 从 俄 斐 运 了 金 子 来 ， 也 运 了 檀 香 木 ( 或 作 乌 木 ； 下 同 ) 和 宝 石 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11376', '14', '9', '11', '王 用 檀 香 木 为 耶 和 华 殿 和 王 宫 做 ? ， 又 为 歌 唱 的 人 做 琴 瑟 ； 犹 大 地 从 来 没 有 见 过 这 样 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11377', '14', '9', '12', '所 罗 门 王 按 示 巴 女 王 所 带 来 的 ， 还 他 礼 物 ， 另 外 照 他 一 切 所 要 所 求 的 ， 都 送 给 他 。 於 是 女 王 和 他 臣 仆 转 回 本 国 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11378', '14', '9', '13', '所 罗 门 每 年 所 得 的 金 子 共 有 六 百 六 十 六 他 连 得 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11379', '14', '9', '14', '另 外 还 有 商 人 所 进 的 金 子 ， 并 且 亚 拉 伯 诸 王 与 属 国 的 省 长 都 带 金 银 给 所 罗 门 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11380', '14', '9', '15', '所 罗 门 王 用 锤 出 来 的 金 子 打 成 挡 牌 二 百 面 ， 每 面 用 金 子 六 百 舍 客 勒 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11381', '14', '9', '16', '又 用 锤 出 来 的 金 子 打 成 盾 牌 三 百 面 ， 每 面 用 金 子 三 百 舍 客 勒 ， 都 放 在 利 巴 嫩 林 宫 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11382', '14', '9', '17', '王 用 象 牙 制 造 一 个 大 宝 座 ， 用 精 金 包 裹 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11383', '14', '9', '18', '宝 座 有 六 层 ? 阶 ， 又 有 金 脚 凳 ， 与 宝 座 相 连 。 宝 座 两 旁 有 扶 手 ， 靠 近 扶 手 有 两 个 狮 子 站 立 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11384', '14', '9', '19', '六 层 ? 阶 上 有 十 二 个 狮 子 站 立 ， 每 层 有 两 个 ： 左 边 一 个 ， 右 边 一 个 ； 在 列 国 中 没 有 这 样 做 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11385', '14', '9', '20', '所 罗 门 王 一 切 的 饮 器 都 是 金 的 ， 利 巴 嫩 林 宫 里 的 一 切 器 皿 都 是 精 金 的 。 所 罗 门 年 间 ， 银 子 算 不 了 甚 麽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11386', '14', '9', '21', '因 为 王 的 船 只 与 希 兰 的 仆 人 一 同 往 他 施 去 ； 他 施 船 只 三 年 一 次 装 载 金 、 银 、 象 牙 、 猿 猴 、 孔 雀 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11387', '14', '9', '22', '所 罗 门 王 的 财 宝 与 智 慧 胜 过 天 下 的 列 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11388', '14', '9', '23', '普 天 下 的 王 都 求 见 所 罗 门 ， 要 听 　 神 赐 给 他 智 慧 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11389', '14', '9', '24', '他 们 各 带 贡 物 ， 就 是 金 器 、 银 器 、 衣 服 、 军 械 、 香 料 、 骡 马 ， 每 年 有 一 定 之 例 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11390', '14', '9', '25', '所 罗 门 有 套 车 的 马 四 千 棚 ， 有 马 兵 一 万 二 千 ， 安 置 在 屯 车 的 城 邑 和 耶 路 撒 冷 ， 就 是 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11391', '14', '9', '26', '所 罗 门 统 管 诸 王 ， 从 大 河 到 非 利 士 地 ， 直 到 埃 及 的 边 界 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11392', '14', '9', '27', '王 在 耶 路 撒 冷 使 银 子 多 如 石 头 ， 香 柏 木 多 如 高 原 的 桑 树 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11393', '14', '9', '28', '有 人 从 埃 及 和 各 国 为 所 罗 门 赶 马 群 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11394', '14', '9', '29', '所 罗 门 其 馀 的 事 ， 自 始 至 终 ， 不 都 写 在 先 知 拿 单 的 书 上 和 示 罗 人 亚 希 雅 的 预 言 书 上 ， 并 先 见 易 多 论 尼 八 儿 子 耶 罗 波 安 的 默 示 书 上 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11395', '14', '9', '30', '所 罗 门 在 耶 路 撒 冷 作 以 色 列 众 人 的 王 共 四 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11396', '14', '9', '31', '所 罗 门 与 他 列 祖 同 睡 ， 葬 在 他 父 大 卫 城 里 。 他 儿 子 罗 波 安 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11397', '14', '10', '1', '罗 波 安 往 示 剑 去 ， 因 为 以 色 列 人 都 到 了 示 剑 ， 要 立 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11398', '14', '10', '2', '尼 八 的 儿 子 耶 罗 波 安 先 前 躲 避 所 罗 门 王 ， 逃 往 埃 及 ， 住 在 那 里 ； 他 听 见 这 事 ， 就 从 埃 及 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11399', '14', '10', '3', '以 色 列 人 打 发 人 去 请 他 ， 他 就 和 以 色 列 众 人 来 见 罗 波 安 ， 对 他 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11400', '14', '10', '4', '你 父 亲 使 我 们 负 重 轭 做 苦 工 ， 现 在 求 你 使 我 们 做 的 苦 工 负 的 重 轭 轻 松 些 ， 我 们 就 事 奉 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11401', '14', '10', '5', '罗 波 安 对 他 们 说 ： 第 三 日 再 来 见 我 罢 ！ 民 就 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11402', '14', '10', '6', '罗 波 安 之 父 所 罗 门 在 世 的 日 子 ， 有 侍 立 在 他 面 前 的 老 年 人 ， 罗 波 安 王 和 他 们 商 议 ， 说 ： 你 们 给 我 出 个 甚 麽 主 意 ， 我 好 回 覆 这 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11403', '14', '10', '7', '老 年 人 对 他 说 ： 王 若 恩 待 这 民 ， 使 他 们 喜 悦 ， 用 好 话 回 覆 他 们 ， 他 们 就 永 远 作 王 的 仆 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11404', '14', '10', '8', '王 却 不 用 老 年 人 给 他 出 的 主 意 ， 就 和 那 些 与 他 一 同 长 大 、 在 他 面 前 侍 立 的 少 年 人 商 议 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11405', '14', '10', '9', '说 ： 这 民 对 我 说 ： 你 父 亲 使 我 们 负 重 轭 ， 求 你 使 我 们 轻 松 些 ； 你 们 给 我 出 个 甚 麽 主 意 ， 我 好 回 覆 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11406', '14', '10', '10', '那 同 他 长 大 的 少 年 人 说 ： 这 民 对 王 说 ： 你 父 亲 使 我 们 负 重 轭 ， 求 你 使 我 们 轻 松 些 ； 王 要 对 他 们 如 此 说 ： 我 的 小 拇 指 比 我 父 亲 的 腰 还 粗 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11407', '14', '10', '11', '我 父 亲 使 你 们 负 重 轭 ， 我 必 使 你 们 负 更 重 的 轭 ； 我 父 亲 用 鞭 子 责 打 你 们 ， 我 要 用 蝎 子 鞭 责 打 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11408', '14', '10', '12', '耶 罗 波 安 和 众 百 姓 遵 着 罗 波 安 王 所 说 你 们 第 三 日 再 来 见 我 的 那 话 ， 第 三 日 他 们 果 然 来 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11409', '14', '10', '13', '罗 波 安 王 用 严 厉 的 话 回 覆 他 们 ， 不 用 老 年 人 所 出 的 主 意 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11410', '14', '10', '14', '照 着 少 年 人 所 出 的 主 意 对 他 们 说 ： 我 父 亲 使 你 们 负 重 轭 ， 我 必 使 你 们 负 更 重 的 轭 ； 我 父 亲 用 鞭 子 责 打 你 们 ， 我 要 用 蝎 子 鞭 责 打 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11411', '14', '10', '15', '王 不 肯 依 从 百 姓 ； 这 事 乃 出 於 　 神 ， 为 要 应 验 耶 和 华 藉 示 罗 人 亚 希 雅 对 尼 八 儿 子 耶 罗 波 安 所 说 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11412', '14', '10', '16', '以 色 列 众 民 见 王 不 依 从 他 们 ， 就 对 王 说 ： 我 们 与 大 卫 有 甚 麽 分 儿 呢 ？ 与 耶 西 的 儿 子 并 没 有 关 涉 ！ 以 色 列 人 哪 ， 各 回 各 家 去 罢 ！ 大 卫 家 啊 ， 自 己 顾 自 己 罢 ！ 於 是 ， 以 色 列 众 人 都 回 自 己 家 里 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11413', '14', '10', '17', '惟 独 住 在 犹 大 城 邑 的 以 色 列 人 ， 罗 波 安 仍 作 他 们 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11414', '14', '10', '18', '罗 波 安 王 差 遣 掌 管 服 苦 之 人 的 哈 多 兰 往 以 色 列 人 那 里 去 ， 以 色 列 人 就 用 石 头 打 死 他 。 罗 波 安 王 急 忙 上 车 ， 逃 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11415', '14', '10', '19', '这 样 ， 以 色 列 人 背 叛 大 卫 家 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11416', '14', '11', '1', '罗 波 安 来 到 耶 路 撒 冷 ， 招 聚 犹 大 家 和 便 雅 悯 家 ， 共 十 八 万 人 ， 都 是 挑 选 的 战 士 ， 要 与 以 色 列 人 争 战 ， 好 将 国 夺 回 再 归 自 己 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11417', '14', '11', '2', '但 耶 和 华 的 话 临 到 　 神 人 示 玛 雅 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11418', '14', '11', '3', '你 去 告 诉 所 罗 门 的 儿 子 犹 大 王 罗 波 安 和 住 犹 大 、 便 雅 悯 的 以 色 列 众 人 说 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11419', '14', '11', '4', '耶 和 华 如 此 说 ： 你 们 不 可 上 去 与 你 们 的 弟 兄 争 战 ， 各 归 各 家 去 罢 ！ 因 为 这 事 出 於 我 。 众 人 就 听 从 耶 和 华 的 话 归 回 ， 不 去 与 耶 罗 波 安 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11420', '14', '11', '5', '罗 波 安 住 在 耶 路 撒 冷 ， 在 犹 大 地 修 筑 城 邑 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11421', '14', '11', '6', '为 保 障 修 筑 伯 利 恒 、 以 坦 、 提 哥 亚 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11422', '14', '11', '7', '伯 夙 、 梭 哥 、 亚 杜 兰 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11423', '14', '11', '8', '迦 特 、 玛 利 沙 、 西 弗 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11424', '14', '11', '9', '亚 多 莱 音 、 拉 吉 、 亚 西 加 、');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11425', '14', '11', '10', '琐 拉 、 亚 雅 仑 、 希 伯 仑 。 这 都 是 犹 大 和 便 雅 悯 的 坚 固 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11426', '14', '11', '11', '罗 波 安 又 坚 固 各 处 的 保 障 ， 在 其 中 安 置 军 长 ， 又 预 备 下 粮 食 、 油 、 酒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11427', '14', '11', '12', '他 在 各 城 里 预 备 盾 牌 和 枪 ， 且 使 城 极 其 坚 固 。 犹 大 和 便 雅 悯 都 归 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11428', '14', '11', '13', '以 色 列 全 地 的 祭 司 和 利 未 人 都 从 四 方 来 归 罗 波 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11429', '14', '11', '14', '利 未 人 撇 下 他 们 的 郊 野 和 产 业 ， 来 到 犹 大 与 耶 路 撒 冷 ， 是 因 耶 罗 波 安 和 他 的 儿 子 拒 绝 他 们 ， 不 许 他 们 供 祭 司 职 分 事 奉 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11430', '14', '11', '15', '耶 罗 波 安 为 邱 坛 、 为 鬼 魔 ( 原 文 作 公 山 羊 ) 、 为 自 己 所 铸 造 的 牛 犊 设 立 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11431', '14', '11', '16', '以 色 列 各 支 派 中 ， 凡 立 定 心 意 寻 求 耶 和 华 ─ 以 色 列 　 神 的 ， 都 随 从 利 未 人 ， 来 到 耶 路 撒 冷 祭 祀 耶 和 华 ─ 他 们 列 祖 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11432', '14', '11', '17', '这 样 ， 就 坚 固 犹 大 国 ， 使 所 罗 门 的 儿 子 罗 波 安 强 盛 三 年 ， 因 为 他 们 三 年 遵 行 大 卫 和 所 罗 门 的 道 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11433', '14', '11', '18', '罗 波 安 娶 大 卫 儿 子 耶 利 摩 的 女 儿 玛 哈 拉 为 妻 ， 又 娶 耶 西 儿 子 以 利 押 的 女 儿 亚 比 孩 为 妻 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11434', '14', '11', '19', '从 他 生 了 几 个 儿 子 ， 就 是 耶 乌 施 、 示 玛 利 雅 、 撒 罕 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11435', '14', '11', '20', '後 来 又 娶 押 沙 龙 的 女 儿 玛 迦 ( 十 三 章 二 节 作 乌 列 的 女 儿 米 该 雅 ) ， 从 他 生 了 亚 比 雅 、 亚 太 、 细 撒 、 示 罗 密 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11436', '14', '11', '21', '罗 波 安 娶 十 八 个 妻 ， 立 六 十 个 妾 ， 生 二 十 八 个 儿 子 ， 六 十 个 女 儿 ； 他 却 爱 押 沙 龙 的 女 儿 玛 迦 ， 比 爱 别 的 妻 妾 更 甚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11437', '14', '11', '22', '罗 波 安 立 玛 迦 的 儿 子 亚 比 雅 作 太 子 ， 在 他 弟 兄 中 为 首 ， 因 为 想 要 立 他 接 续 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11438', '14', '11', '23', '罗 波 安 办 事 精 明 ， 使 他 众 子 分 散 在 犹 大 和 便 雅 悯 全 地 各 坚 固 城 里 ， 又 赐 他 们 许 多 粮 食 ， 为 他 们 多 寻 妻 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11439', '14', '12', '1', '罗 波 安 的 国 坚 立 ， 他 强 盛 的 时 候 就 离 弃 耶 和 华 的 律 法 ， 以 色 列 人 也 都 随 从 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11440', '14', '12', '2', '罗 波 安 王 第 五 年 ， 埃 及 王 示 撒 上 来 攻 打 耶 路 撒 冷 ， 因 为 王 和 民 得 罪 了 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11441', '14', '12', '3', '示 撒 带 战 车 一 千 二 百 辆 ， 马 兵 六 万 ， 并 且 跟 从 他 出 埃 及 的 路 比 人 、 苏 基 人 ， 和 古 实 人 ， 多 得 不 可 胜 数 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11442', '14', '12', '4', '他 攻 取 了 犹 大 的 坚 固 城 ， 就 来 到 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11443', '14', '12', '5', '那 时 ， 犹 大 的 首 领 因 为 示 撒 就 聚 集 在 耶 路 撒 冷 。 有 先 知 示 玛 雅 去 见 罗 波 安 和 众 首 领 ， 对 他 们 说 ： 耶 和 华 如 此 说 ： 你 们 离 弃 了 我 ， 所 以 我 使 你 们 落 在 示 撒 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11444', '14', '12', '6', '於 是 王 和 以 色 列 的 众 首 领 都 自 卑 说 ： 耶 和 华 是 公 义 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11445', '14', '12', '7', '耶 和 华 见 他 们 自 卑 ， 耶 和 华 的 话 就 临 到 示 玛 雅 说 ： 他 们 既 自 卑 ， 我 必 不 灭 绝 他 们 ； 必 使 他 们 略 得 拯 救 ， 我 不 藉 着 示 撒 的 手 将 我 的 怒 气 倒 在 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11446', '14', '12', '8', '然 而 他 们 必 作 示 撒 的 仆 人 ， 好 叫 他 们 知 道 ， 服 事 我 与 服 事 外 邦 人 有 何 分 别 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11447', '14', '12', '9', '於 是 ， 埃 及 王 示 撒 上 来 攻 取 耶 路 撒 冷 ， 夺 了 耶 和 华 殿 和 王 宫 里 的 宝 物 ， 尽 都 带 走 ， 又 夺 去 所 罗 门 制 造 的 金 盾 牌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11448', '14', '12', '10', '罗 波 安 王 制 造 铜 盾 牌 代 替 那 金 盾 牌 ， 交 给 守 王 宫 门 的 护 卫 长 看 守 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11449', '14', '12', '11', '王 每 逢 进 耶 和 华 的 殿 ， 护 卫 兵 就 拿 这 盾 牌 ， 随 後 仍 将 盾 牌 送 回 ， 放 在 护 卫 房 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11450', '14', '12', '12', '王 自 卑 的 时 候 ， 耶 和 华 的 怒 气 就 转 消 了 ， 不 将 他 灭 尽 ， 并 且 在 犹 大 中 间 也 有 善 益 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11451', '14', '12', '13', '罗 波 安 王 自 强 ， 在 耶 路 撒 冷 作 王 。 他 登 基 的 时 候 年 四 十 一 岁 ， 在 耶 路 撒 冷 ， 就 是 耶 和 华 从 以 色 列 众 支 派 中 所 选 择 立 他 名 的 城 ， 作 王 十 七 年 。 罗 波 安 的 母 亲 名 叫 拿 玛 ， 是 亚 扪 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11452', '14', '12', '14', '罗 波 安 行 恶 ， 因 他 不 立 定 心 意 寻 求 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11453', '14', '12', '15', '罗 波 安 所 行 的 事 ， 自 始 至 终 不 都 写 在 先 知 示 玛 雅 和 先 见 易 多 的 史 记 上 麽 ？ 罗 波 安 与 耶 罗 波 安 时 常 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11454', '14', '12', '16', '罗 波 安 与 他 列 祖 同 睡 ， 葬 在 大 卫 城 里 。 他 儿 子 亚 比 雅 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11455', '14', '13', '1', '耶 罗 波 安 王 十 八 年 ， 亚 比 雅 登 基 作 犹 大 王 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11456', '14', '13', '2', '在 耶 路 撒 冷 作 王 三 年 。 他 母 亲 名 叫 米 该 亚 ( 又 作 玛 迦 ) ， 是 基 比 亚 人 乌 列 的 女 儿 。 亚 比 雅 常 与 耶 罗 波 安 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11457', '14', '13', '3', '有 一 次 亚 比 雅 率 领 挑 选 的 兵 四 十 万 摆 阵 ， 都 是 勇 敢 的 战 士 ； 耶 罗 波 安 也 挑 选 大 能 的 勇 士 八 十 万 ， 对 亚 比 雅 摆 阵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11458', '14', '13', '4', '亚 比 雅 站 在 以 法 莲 山 地 中 的 洗 玛 脸 山 上 ， 说 ： 耶 罗 波 安 和 以 色 列 众 人 哪 ， 要 听 我 说 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11459', '14', '13', '5', '耶 和 华 ─ 以 色 列 的 　 神 曾 立 盐 ( 即 不 废 坏 的 意 思 ) 约 ， 将 以 色 列 国 永 远 赐 给 大 卫 和 他 的 子 孙 ， 你 们 不 知 道 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11460', '14', '13', '6', '无 奈 大 卫 儿 子 所 罗 门 的 臣 仆 、 尼 八 儿 子 耶 罗 波 安 起 来 背 叛 他 的 主 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11461', '14', '13', '7', '有 些 无 赖 的 匪 徒 聚 集 跟 从 他 ， 逞 强 攻 击 所 罗 门 的 儿 子 罗 波 安 ； 那 时 罗 波 安 还 幼 弱 ， 不 能 抵 挡 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11462', '14', '13', '8', '现 在 你 们 有 意 抗 拒 大 卫 子 孙 手 下 所 治 耶 和 华 的 国 ， 你 们 的 人 也 甚 多 ， 你 们 那 里 又 有 耶 罗 波 安 为 你 们 所 造 当 作 　 神 的 金 牛 犊 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11463', '14', '13', '9', '你 们 不 是 驱 逐 耶 和 华 的 祭 司 亚 伦 的 後 裔 和 利 未 人 麽 ？ 不 是 照 着 外 邦 人 的 恶 俗 为 自 己 立 祭 司 麽 ？ 无 论 何 人 牵 一 只 公 牛 犊 、 七 只 公 绵 羊 将 自 己 分 别 出 来 ， 就 可 作 虚 无 之 　 神 的 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11464', '14', '13', '10', '至 於 我 们 ， 耶 和 华 是 我 们 的 　 神 ， 我 们 并 没 有 离 弃 他 。 我 们 有 事 奉 耶 和 华 的 祭 司 ， 都 是 亚 伦 的 後 裔 ， 并 有 利 未 人 各 尽 其 职 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11465', '14', '13', '11', '每 日 早 晚 向 耶 和 华 献 燔 祭 ， 烧 美 香 ， 又 在 精 金 的 桌 子 上 摆 陈 设 饼 ； 又 有 金 灯 ? 和 灯 盏 ， 每 晚 点 起 ， 因 为 我 们 遵 守 耶 和 华 ─ 我 们 　 神 的 命 ； 惟 有 你 们 离 弃 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11466', '14', '13', '12', '率 领 我 们 的 是 　 神 ， 我 们 这 里 也 有 　 神 的 祭 司 拿 号 向 你 们 吹 出 大 声 。 以 色 列 人 哪 ， 不 要 与 耶 和 华 ─ 你 们 列 祖 的 　 神 争 战 ， 因 你 们 必 不 能 亨 通 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11467', '14', '13', '13', '耶 罗 波 安 却 在 犹 大 人 的 後 头 设 伏 兵 。 这 样 ， 以 色 列 人 在 犹 大 人 的 前 头 ， 伏 兵 在 犹 大 人 的 後 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11468', '14', '13', '14', '犹 大 人 回 头 观 看 ， 见 前 後 都 有 敌 兵 ， 就 呼 求 耶 和 华 ， 祭 司 也 吹 号 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11469', '14', '13', '15', '於 是 犹 大 人 呐 喊 ； 犹 大 人 呐 喊 的 时 候 ， 　 神 就 使 耶 罗 波 安 和 以 色 列 众 人 败 在 亚 比 雅 与 犹 大 人 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11470', '14', '13', '16', '以 色 列 人 在 犹 大 人 面 前 逃 跑 ， 　 神 将 他 们 交 在 犹 大 人 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11471', '14', '13', '17', '亚 比 雅 和 他 的 军 兵 大 大 杀 戮 以 色 列 人 ， 以 色 列 人 仆 倒 死 亡 的 精 兵 有 五 十 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11472', '14', '13', '18', '那 时 ， 以 色 列 人 被 制 伏 了 ， 犹 大 人 得 胜 ， 是 因 倚 靠 耶 和 华 ─ 他 们 列 祖 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11473', '14', '13', '19', '亚 比 雅 追 赶 耶 罗 波 安 ， 攻 取 了 他 的 几 座 城 ， 就 是 伯 特 利 和 属 伯 特 利 的 镇 市 ， 耶 沙 拿 和 属 耶 沙 拿 的 镇 市 ， 以 法 拉 音 ( 或 作 以 弗 伦 ) 和 属 以 法 拉 音 的 镇 市 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11474', '14', '13', '20', '亚 比 雅 在 世 的 时 候 ， 耶 罗 波 安 不 能 再 强 盛 ； 耶 和 华 攻 击 他 ， 他 就 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11475', '14', '13', '21', '亚 比 雅 却 渐 渐 强 盛 ， 娶 妻 妾 十 四 个 ， 生 了 二 十 二 个 儿 子 ， 十 六 个 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11476', '14', '13', '22', '亚 比 雅 其 馀 的 事 和 他 的 言 行 都 写 在 先 知 易 多 的 传 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11477', '14', '14', '1', '亚 比 雅 与 他 列 祖 同 睡 ， 葬 在 大 卫 城 里 。 他 儿 子 亚 撒 接 续 他 作 王 。 亚 撒 年 间 ， 国 中 太 平 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11478', '14', '14', '2', '亚 撒 行 耶 和 华 ─ 他 　 神 眼 中 看 为 善 为 正 的 事 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11479', '14', '14', '3', '除 掉 外 邦 神 的 坛 和 邱 坛 ， 打 碎 柱 像 ， 砍 下 木 偶 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11480', '14', '14', '4', '吩 咐 犹 大 人 寻 求 耶 和 华 ─ 他 们 列 祖 的 　 神 ， 遵 行 他 的 律 法 、 诫 命 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11481', '14', '14', '5', '又 在 犹 大 各 城 邑 除 掉 邱 坛 和 日 像 ， 那 时 国 享 太 平 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11482', '14', '14', '6', '又 在 犹 大 建 造 了 几 座 坚 固 城 。 国 中 太 平 数 年 ， 没 有 战 争 ， 因 为 耶 和 华 赐 他 平 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11483', '14', '14', '7', '他 对 犹 大 人 说 ： 我 们 要 建 造 这 些 城 邑 ， 四 围 筑 墙 ， 盖 楼 ， 安 门 ， 做 闩 ； 地 还 属 我 们 ， 是 因 寻 求 耶 和 华 ─ 我 们 的 　 神 ； 我 们 既 寻 求 他 ， 他 就 赐 我 们 四 境 平 安 。 於 是 建 造 城 邑 ， 诸 事 亨 通 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11484', '14', '14', '8', '亚 撒 的 军 兵 ， 出 自 犹 大 拿 盾 牌 拿 枪 的 三 十 万 人 ； 出 自 便 雅 悯 拿 盾 牌 拉 弓 的 二 十 八 万 人 。 这 都 是 大 能 的 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11485', '14', '14', '9', '有 古 实 王 谢 拉 率 领 军 兵 一 百 万 ， 战 车 三 百 辆 ， 出 来 攻 击 犹 大 人 ， 到 了 玛 利 沙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11486', '14', '14', '10', '於 是 亚 撒 出 去 与 他 迎 敌 ， 就 在 玛 利 沙 的 洗 法 谷 彼 此 摆 阵 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11487', '14', '14', '11', '亚 撒 呼 求 耶 和 华 ─ 他 的 　 神 说 ： 耶 和 华 啊 ， 惟 有 你 能 帮 助 软 弱 的 ， 胜 过 强 盛 的 。 耶 和 华 ─ 我 们 的 　 神 啊 ， 求 你 帮 助 我 们 ； 因 为 我 们 仰 赖 你 ， 奉 你 的 名 来 攻 击 这 大 军 。 耶 和 华 啊 ， 你 是 我 们 的 　 神 ， 不 要 容 人 胜 过 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11488', '14', '14', '12', '於 是 耶 和 华 使 古 实 人 败 在 亚 撒 和 犹 大 人 面 前 ， 古 实 人 就 逃 跑 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11489', '14', '14', '13', '亚 撒 和 跟 随 他 的 军 兵 追 赶 他 们 ， 直 到 基 拉 耳 。 古 实 人 被 杀 的 甚 多 ， 不 能 再 强 盛 ， 因 为 败 在 耶 和 华 与 他 军 兵 面 前 。 犹 大 人 就 夺 了 许 多 财 物 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11490', '14', '14', '14', '又 打 破 基 拉 耳 四 围 的 城 邑 ； 耶 和 华 使 其 中 的 人 都 甚 恐 惧 。 犹 大 人 又 将 所 有 的 城 掳 掠 一 空 ， 因 其 中 的 财 物 甚 多 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11491', '14', '14', '15', '又 毁 坏 了 群 畜 的 圈 ， 夺 取 许 多 的 羊 和 骆 驼 ， 就 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11492', '14', '15', '1', '　 神 的 灵 感 动 俄 德 的 儿 子 亚 撒 利 雅 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11493', '14', '15', '2', '他 出 来 迎 接 亚 撒 ， 对 他 说 ： 亚 撒 和 犹 大 、 便 雅 悯 众 人 哪 ， 要 听 我 说 ： 你 们 若 顺 从 耶 和 华 ， 耶 和 华 必 与 你 们 同 在 ； 你 们 若 寻 求 他 ， 就 必 寻 见 ； 你 们 若 离 弃 他 ， 他 必 离 弃 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11494', '14', '15', '3', '以 色 列 人 不 信 真 　 神 ， 没 有 训 诲 的 祭 司 ， 也 没 有 律 法 ， 已 经 好 久 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11495', '14', '15', '4', '但 他 们 在 急 难 的 时 候 归 向 耶 和 华 ─ 以 色 列 的 　 神 ， 寻 求 他 ， 他 就 被 他 们 寻 见 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11496', '14', '15', '5', '那 时 ， 出 入 的 人 不 得 平 安 ， 列 国 的 居 民 都 遭 大 乱 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11497', '14', '15', '6', '这 国 攻 击 那 国 ， 这 城 攻 击 那 城 ， 互 相 破 坏 ， 因 为 　 神 用 各 样 灾 难 扰 乱 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11498', '14', '15', '7', '现 在 你 们 要 刚 强 ， 不 要 手 软 ， 因 你 们 所 行 的 必 得 赏 赐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11499', '14', '15', '8', '亚 撒 听 见 这 话 和 俄 德 儿 子 先 知 亚 撒 利 雅 的 预 言 ， 就 壮 起 胆 来 ， 在 犹 大 、 便 雅 悯 全 地 ， 并 以 法 莲 山 地 所 夺 的 各 城 ， 将 可 憎 之 物 尽 都 除 掉 ， 又 在 耶 和 华 殿 的 廊 前 重 新 修 筑 耶 和 华 的 坛 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11500', '14', '15', '9', '又 招 聚 犹 大 、 便 雅 悯 的 众 人 ， 并 他 们 中 间 寄 居 的 以 法 莲 人 、 玛 拿 西 人 、 西 缅 人 。 有 许 多 以 色 列 人 归 降 亚 撒 ， 因 见 耶 和 华 ─ 他 的 　 神 与 他 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11501', '14', '15', '10', '亚 撒 十 五 年 三 月 ， 他 们 都 聚 集 在 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11502', '14', '15', '11', '当 日 他 们 从 所 取 的 掳 物 中 ， 将 牛 七 百 只 、 羊 七 千 只 献 给 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11503', '14', '15', '12', '他 们 就 立 约 ， 要 尽 心 尽 性 地 寻 求 耶 和 华 ─ 他 们 列 祖 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11504', '14', '15', '13', '凡 不 寻 求 耶 和 华 ─ 以 色 列 　 神 的 ， 无 论 大 小 、 男 女 ， 必 被 治 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11505', '14', '15', '14', '他 们 就 大 声 欢 呼 ， 吹 号 吹 角 ， 向 耶 和 华 起 誓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11506', '14', '15', '15', '犹 大 众 人 为 所 起 的 誓 欢 喜 ； 因 他 们 是 尽 心 起 誓 ， 尽 意 寻 求 耶 和 华 ， 耶 和 华 就 被 他 们 寻 见 ， 且 赐 他 们 四 境 平 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11507', '14', '15', '16', '亚 撒 王 贬 了 他 祖 母 玛 迦 太 后 的 位 ， 因 他 造 了 可 憎 的 偶 像 亚 舍 拉 。 亚 撒 砍 下 他 的 偶 像 ， 捣 得 粉 碎 ， 烧 在 汲 沦 溪 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11508', '14', '15', '17', '只 是 邱 坛 还 没 有 从 以 色 列 中 废 去 ， 然 而 亚 撒 的 心 一 生 诚 实 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11509', '14', '15', '18', '亚 撒 将 他 父 所 分 别 为 圣 、 与 自 己 所 分 别 为 圣 的 金 银 和 器 皿 都 奉 到 　 神 的 殿 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11510', '14', '15', '19', '从 这 时 直 到 亚 撒 三 十 五 年 ， 都 没 有 争 战 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11511', '14', '16', '1', '亚 撒 三 十 六 年 ， 以 色 列 王 巴 沙 上 来 攻 击 犹 大 ， 修 筑 拉 玛 ， 不 许 人 从 犹 大 王 亚 撒 那 里 出 入 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11512', '14', '16', '2', '於 是 亚 撒 从 耶 和 华 殿 和 王 宫 的 府 库 里 拿 出 金 银 来 ， 送 与 住 大 马 色 的 亚 兰 王 便 哈 达 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11513', '14', '16', '3', '你 父 曾 与 我 父 立 约 ， 我 与 你 也 要 立 约 。 现 在 我 将 金 银 送 给 你 ， 求 你 废 掉 你 与 以 色 列 王 巴 沙 所 立 的 约 ， 使 他 离 开 我 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11514', '14', '16', '4', '便 哈 达 听 从 亚 撒 王 的 话 ， 派 军 长 去 攻 击 以 色 列 的 城 邑 。 他 们 就 攻 破 以 云 、 但 、 亚 伯 玛 音 ， 和 拿 弗 他 利 一 切 的 积 货 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11515', '14', '16', '5', '巴 沙 听 见 就 停 工 ， 不 修 筑 拉 玛 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11516', '14', '16', '6', '於 是 亚 撒 王 率 领 犹 大 众 人 ， 将 巴 沙 修 筑 拉 玛 所 用 的 石 头 、 木 头 都 运 去 ， 用 以 修 筑 迦 巴 和 米 斯 巴 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11517', '14', '16', '7', '那 时 ， 先 见 哈 拿 尼 来 见 犹 大 王 亚 撒 ， 对 他 说 ： 因 你 仰 赖 亚 兰 王 ， 没 有 仰 赖 耶 和 华 ─ 你 的 　 神 ， 所 以 亚 兰 王 的 军 兵 脱 离 了 你 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11518', '14', '16', '8', '古 实 人 、 路 比 人 的 军 队 不 是 甚 大 麽 ？ 战 车 马 兵 不 是 极 多 麽 ？ 只 因 你 仰 赖 耶 和 华 ， 他 便 将 他 们 交 在 你 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11519', '14', '16', '9', '耶 和 华 的 眼 目 遍 察 全 地 ， 要 显 大 能 帮 助 向 他 心 存 诚 实 的 人 。 你 这 事 行 得 愚 昧 ； 此 後 ， 你 必 有 争 战 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11520', '14', '16', '10', '亚 撒 因 此 恼 恨 先 见 ， 将 他 囚 在 监 里 。 那 时 亚 撒 也 虐 待 一 些 人 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11521', '14', '16', '11', '亚 撒 所 行 的 事 ， 自 始 至 终 都 写 在 犹 大 和 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11522', '14', '16', '12', '亚 撒 作 王 三 十 九 年 ， 他 脚 上 有 病 ， 而 且 甚 重 。 病 的 时 候 没 有 求 耶 和 华 ， 只 求 医 生 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11523', '14', '16', '13', '他 作 王 四 十 一 年 而 死 ， 与 他 列 祖 同 睡 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11524', '14', '16', '14', '葬 在 大 卫 城 自 己 所 凿 的 坟 墓 里 ， 放 在 床 上 ， 其 床 堆 满 各 样 馨 香 的 香 料 ， 就 是 按 做 香 的 作 法 调 和 的 香 料 ， 又 为 他 烧 了 许 多 的 物 件 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11525', '14', '17', '1', '亚 撒 的 儿 子 约 沙 法 接 续 他 作 王 ， 奋 勇 自 强 ， 防 备 以 色 列 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11526', '14', '17', '2', '安 置 军 兵 在 犹 大 一 切 坚 固 城 里 ， 又 安 置 防 兵 在 犹 大 地 和 他 父 亚 撒 所 得 以 法 莲 的 城 邑 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11527', '14', '17', '3', '耶 和 华 与 约 沙 法 同 在 ； 因 为 他 行 他 祖 大 卫 初 行 的 道 ， 不 寻 求 巴 力 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11528', '14', '17', '4', '只 寻 求 他 父 亲 的 　 神 ， 遵 行 他 的 诫 命 ， 不 效 法 以 色 列 人 的 行 为 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11529', '14', '17', '5', '所 以 耶 和 华 坚 定 他 的 国 ， 犹 大 众 人 给 他 进 贡 ； 约 沙 法 大 有 尊 荣 资 财 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11530', '14', '17', '6', '他 高 兴 遵 行 耶 和 华 的 道 ， 并 且 从 犹 大 除 掉 一 切 邱 坛 和 木 偶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11531', '14', '17', '7', '他 作 王 第 三 年 ， 就 差 遣 臣 子 便 亥 伊 勒 、 俄 巴 底 、 撒 迦 利 雅 、 拿 坦 业 、 米 该 亚 往 犹 大 各 城 去 教 训 百 姓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11532', '14', '17', '8', '同 着 他 们 有 利 未 人 示 玛 雅 、 尼 探 雅 、 西 巴 第 雅 、 亚 撒 黑 、 示 米 拉 末 、 约 拿 单 、 亚 多 尼 雅 、 多 比 雅 、 驼 巴 多 尼 雅 ， 又 有 祭 司 以 利 沙 玛 、 约 兰 同 着 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11533', '14', '17', '9', '他 们 带 着 耶 和 华 的 律 法 书 ， 走 遍 犹 大 各 城 教 训 百 姓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11534', '14', '17', '10', '耶 和 华 使 犹 大 四 围 的 列 国 都 甚 恐 惧 ， 不 敢 与 约 沙 法 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11535', '14', '17', '11', '有 些 非 利 士 人 与 约 沙 法 送 礼 物 ， 纳 贡 银 。 亚 拉 伯 人 也 送 他 公 绵 羊 七 千 七 百 只 ， 公 山 羊 七 千 七 百 只 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11536', '14', '17', '12', '约 沙 法 日 渐 强 大 ， 在 犹 大 建 造 营 寨 和 积 货 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11537', '14', '17', '13', '他 在 犹 大 城 邑 中 有 许 多 工 程 ， 又 在 耶 路 撒 冷 有 战 士 ， 就 是 大 能 的 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11538', '14', '17', '14', '他 们 的 数 目 ， 按 着 宗 族 ， 记 在 下 面 ： 犹 大 族 的 ， 千 夫 长 押 拿 为 首 率 领 大 能 的 勇 士 ─ 三 十 万 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11539', '14', '17', '15', '其 次 是 ， 千 夫 长 约 哈 难 率 领 大 能 的 勇 士 ─ 二 十 八 万 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11540', '14', '17', '16', '其 次 是 ， 细 基 利 的 儿 子 亚 玛 斯 雅 〈 他 为 耶 和 华 牺 牲 自 己 〉 率 领 大 能 的 勇 士 ─ 二 十 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11541', '14', '17', '17', '便 雅 悯 族 ， 是 大 能 的 勇 士 以 利 雅 大 率 领 ， 拿 弓 箭 和 盾 牌 的 ─ 二 十 万 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11542', '14', '17', '18', '其 次 是 ， 约 萨 拔 率 领 预 备 打 仗 的 ─ 十 八 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11543', '14', '17', '19', '这 都 是 伺 候 王 的 ， 还 有 王 在 犹 大 全 地 坚 固 城 所 安 置 的 不 在 其 内 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11544', '14', '18', '1', '约 沙 法 大 有 尊 荣 资 财 ， 就 与 亚 哈 结 亲 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11545', '14', '18', '2', '过 了 几 年 ， 他 下 到 撒 玛 利 亚 去 见 亚 哈 ； 亚 哈 为 他 和 跟 从 他 的 人 宰 了 许 多 牛 羊 ， 劝 他 与 自 己 同 去 攻 取 基 列 的 拉 末 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11546', '14', '18', '3', '以 色 列 王 亚 哈 问 犹 大 王 约 沙 法 说 ： 你 肯 同 我 去 攻 取 基 列 的 拉 末 麽 ？ 他 回 答 说 ： 你 我 不 分 彼 此 ， 我 的 民 与 你 的 民 一 样 ， 必 与 你 同 去 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11547', '14', '18', '4', '约 沙 法 对 以 色 列 王 说 ： 请 你 先 求 问 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11548', '14', '18', '5', '於 是 以 色 列 王 招 聚 先 知 四 百 人 ， 问 他 们 说 ： 我 们 上 去 攻 取 基 列 的 拉 末 可 以 不 可 以 ？ 他 们 说 ： 可 以 上 去 ， 因 为 　 神 必 将 那 城 交 在 王 的 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11549', '14', '18', '6', '约 沙 法 说 ： 这 里 不 是 还 有 耶 和 华 的 先 知 ， 我 们 可 以 求 问 他 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11550', '14', '18', '7', '以 色 列 王 对 约 沙 法 说 ： 还 有 一 个 人 ， 是 音 拉 的 儿 子 米 该 雅 。 我 们 可 以 托 他 求 问 耶 和 华 ， 只 是 我 恨 他 ； 因 为 他 指 着 我 所 说 的 预 言 ， 不 说 吉 语 ， 常 说 凶 言 。 约 沙 法 说 ： 王 不 必 这 样 说 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11551', '14', '18', '8', '以 色 列 王 就 召 了 一 个 太 监 来 ， 说 ： 你 快 去 将 音 拉 的 儿 子 米 该 雅 召 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11552', '14', '18', '9', '以 色 列 王 和 犹 大 王 约 沙 法 在 撒 玛 利 亚 城 门 前 的 空 场 上 ， 各 穿 朝 服 坐 在 位 上 ， 所 有 的 先 知 都 在 他 们 面 前 说 预 言 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11553', '14', '18', '10', '基 拿 拿 的 儿 子 西 底 家 造 了 两 个 铁 角 ， 说 ： 耶 和 华 如 此 说 ： 你 要 用 这 角 ? 触 亚 兰 人 ， 直 到 将 他 们 灭 尽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11554', '14', '18', '11', '所 有 的 先 知 也 都 这 样 预 言 说 ： 可 以 上 基 列 的 拉 末 去 ， 必 然 得 胜 ， 因 为 耶 和 华 必 将 那 城 交 在 王 的 手 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11555', '14', '18', '12', '那 去 召 米 该 雅 的 使 者 对 米 该 雅 说 ： 众 先 知 一 口 同 音 地 都 向 王 说 吉 言 ， 你 不 如 与 他 们 说 一 样 的 话 ， 也 说 吉 言 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11556', '14', '18', '13', '米 该 雅 说 ： 我 指 着 永 生 的 耶 和 华 起 誓 ， 我 的 　 神 说 甚 麽 ， 我 就 说 甚 麽 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11557', '14', '18', '14', '米 该 雅 到 王 面 前 ， 王 问 他 说 ： 米 该 雅 啊 ， 我 们 上 去 攻 取 基 列 的 拉 末 可 以 不 可 以 ？ 他 说 ： 可 以 上 去 ， 必 然 得 胜 ， 敌 人 必 交 在 你 们 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11558', '14', '18', '15', '王 对 他 说 ： 我 当 嘱 咐 你 几 次 ， 你 才 奉 耶 和 华 的 名 向 我 说 实 话 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11559', '14', '18', '16', '米 该 雅 说 ： 我 看 见 以 色 列 众 民 散 在 山 上 ， 如 同 没 有 牧 人 的 羊 群 一 般 。 耶 和 华 说 ： 这 民 没 有 主 人 ， 他 们 可 以 平 平 安 安 地 各 归 各 家 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11560', '14', '18', '17', '以 色 列 王 对 约 沙 法 说 ： 我 岂 没 有 告 诉 你 ， 这 人 指 着 我 所 说 的 预 言 ， 不 说 吉 语 ， 单 说 凶 言 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11561', '14', '18', '18', '米 该 雅 说 ： 你 们 要 听 耶 和 华 的 话 。 我 看 见 耶 和 华 坐 在 宝 座 上 ， 天 上 的 万 军 侍 立 在 他 左 右 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11562', '14', '18', '19', '耶 和 华 说 ： 谁 去 引 诱 以 色 列 王 亚 哈 上 基 列 的 拉 末 去 阵 亡 呢 ？ 这 个 就 这 样 说 ， 那 个 就 那 样 说 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11563', '14', '18', '20', '随 後 ， 有 一 个 神 灵 出 来 ， 站 在 耶 和 华 面 前 说 ： 我 去 引 诱 他 。 耶 和 华 问 他 说 ： 你 用 何 法 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11564', '14', '18', '21', '他 说 ： 我 去 ， 要 在 他 众 先 知 口 中 作 谎 言 的 灵 。 耶 和 华 说 ： 这 样 ， 你 必 能 引 诱 他 ， 你 去 如 此 行 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11565', '14', '18', '22', '现 在 耶 和 华 使 谎 言 的 灵 入 了 你 这 些 先 知 的 口 ， 并 且 耶 和 华 已 经 命 定 降 祸 与 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11566', '14', '18', '23', '基 拿 拿 的 儿 子 西 底 家 前 来 打 米 该 雅 的 脸 ， 说 ： 耶 和 华 的 灵 从 哪 里 离 开 我 与 你 说 话 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11567', '14', '18', '24', '米 该 雅 说 ： 你 进 严 密 的 屋 子 藏 躲 的 那 日 ， 就 必 看 见 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11568', '14', '18', '25', '以 色 列 王 说 ： 将 米 该 雅 带 回 ， 交 给 邑 宰 亚 们 和 王 的 儿 子 约 阿 施 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11569', '14', '18', '26', '王 如 此 说 ： 把 这 个 人 下 在 监 里 ， 使 他 受 苦 ， 吃 不 饱 喝 不 足 ， 等 候 我 平 平 安 安 地 回 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11570', '14', '18', '27', '米 该 雅 说 ： 你 若 能 平 安 回 来 ， 那 就 是 耶 和 华 没 有 藉 我 说 这 话 了 ； 又 说 ： 众 民 哪 ， 你 们 都 要 听 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11571', '14', '18', '28', '以 色 列 王 和 犹 大 王 约 沙 法 上 基 列 的 拉 末 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11572', '14', '18', '29', '以 色 列 王 对 约 沙 法 说 ： 我 要 改 装 上 阵 ， 你 可 以 仍 穿 王 服 。 於 是 以 色 列 王 改 装 ， 他 们 就 上 阵 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11573', '14', '18', '30', '先 是 亚 兰 王 吩 咐 车 兵 长 说 ： 他 们 的 兵 将 ， 无 论 大 小 ， 你 们 都 不 可 与 他 们 争 战 ， 只 要 与 以 色 列 王 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11574', '14', '18', '31', '车 兵 长 看 见 约 沙 法 便 说 ， 这 必 是 以 色 列 王 ， 就 转 过 去 与 他 争 战 。 约 沙 法 一 呼 喊 ， 耶 和 华 就 帮 助 他 ， 　 神 又 感 动 他 们 离 开 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11575', '14', '18', '32', '车 兵 长 见 不 是 以 色 列 王 ， 就 转 去 不 追 他 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11576', '14', '18', '33', '有 一 人 随 便 开 弓 ， 恰 巧 射 入 以 色 列 王 的 甲 缝 里 。 王 对 赶 车 的 说 ： 我 受 了 重 伤 ， 你 转 过 车 来 ， 拉 我 出 阵 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11577', '14', '18', '34', '那 日 阵 势 越 战 越 猛 ， 以 色 列 王 勉 强 站 在 车 上 抵 挡 亚 兰 人 ， 直 到 晚 上 。 约 在 日 落 的 时 候 ， 王 就 死 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11578', '14', '19', '1', '犹 大 王 约 沙 法 平 平 安 安 地 回 耶 路 撒 冷 ， 到 宫 里 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11579', '14', '19', '2', '先 见 哈 拿 尼 的 儿 子 耶 户 出 来 迎 接 约 沙 法 王 ， 对 他 说 ： 你 岂 当 帮 助 恶 人 ， 爱 那 恨 恶 耶 和 华 的 人 呢 ？ 因 此 耶 和 华 的 忿 怒 临 到 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11580', '14', '19', '3', '然 而 你 还 有 善 行 ， 因 你 从 国 中 除 掉 木 偶 ， 立 定 心 意 寻 求 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11581', '14', '19', '4', '约 沙 法 住 在 耶 路 撒 冷 ， 以 後 又 出 巡 民 间 ， 从 别 是 巴 直 到 以 法 莲 山 地 ， 引 导 民 归 向 耶 和 华 ─ 他 们 列 祖 的 　 神 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11582', '14', '19', '5', '又 在 犹 大 国 中 遍 地 的 坚 固 城 里 设 立 审 判 官 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11583', '14', '19', '6', '对 他 们 说 ： 你 们 办 事 应 当 谨 慎 ； 因 为 你 们 判 断 不 是 为 人 ， 乃 是 为 耶 和 华 。 判 断 的 时 候 ， 他 必 与 你 们 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11584', '14', '19', '7', '现 在 你 们 应 当 敬 畏 耶 和 华 ， 谨 慎 办 事 ； 因 为 耶 和 华 ─ 我 们 的 　 神 没 有 不 义 ， 不 偏 待 人 ， 也 不 受 贿 赂 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11585', '14', '19', '8', '约 沙 法 从 利 未 人 和 祭 司 ， 并 以 色 列 族 长 中 派 定 人 ， 在 耶 路 撒 冷 为 耶 和 华 判 断 ， 听 民 间 的 争 讼 ， 就 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11586', '14', '19', '9', '约 沙 法 嘱 咐 他 们 说 ： 你 们 当 敬 畏 耶 和 华 ， 忠 心 诚 实 办 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11587', '14', '19', '10', '住 在 各 城 里 你 们 的 弟 兄 ， 若 有 争 讼 的 事 来 到 你 们 这 里 ， 或 为 流 血 ， 或 犯 律 法 、 诫 命 、 律 例 、 典 章 ， 你 们 要 警 戒 他 们 ， 免 得 他 们 得 罪 耶 和 华 ， 以 致 他 的 忿 怒 临 到 你 们 和 你 们 的 弟 兄 ； 这 样 行 ， 你 们 就 没 有 罪 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11588', '14', '19', '11', '凡 属 耶 和 华 的 事 ， 有 大 祭 司 亚 玛 利 雅 管 理 你 们 ； 凡 属 王 的 事 ， 有 犹 大 支 派 的 族 长 以 实 玛 利 的 儿 子 西 巴 第 雅 管 理 你 们 ； 在 你 们 面 前 有 利 未 人 作 官 长 。 你 们 应 当 壮 胆 办 事 ， 愿 耶 和 华 与 善 人 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11589', '14', '20', '1', '此 後 ， 摩 押 人 和 亚 扪 人 ， 又 有 米 乌 尼 人 ， 一 同 来 攻 击 约 沙 法 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11590', '14', '20', '2', '有 人 来 报 告 约 沙 法 说 ： 从 海 外 亚 兰 ( 又 作 以 东 ) 那 边 有 大 军 来 攻 击 你 ， 如 今 他 们 在 哈 洗 逊 他 玛 ， 就 是 隐 基 底 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11591', '14', '20', '3', '约 沙 法 便 惧 怕 ， 定 意 寻 求 耶 和 华 ， 在 犹 大 全 地 宣 告 禁 食 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11592', '14', '20', '4', '於 是 犹 大 人 聚 会 ， 求 耶 和 华 帮 助 。 犹 大 各 城 都 有 人 出 来 寻 求 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11593', '14', '20', '5', '约 沙 法 就 在 犹 大 和 耶 路 撒 冷 的 会 中 ， 站 在 耶 和 华 殿 的 新 院 前 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11594', '14', '20', '6', '说 ： 耶 和 华 ─ 我 们 列 祖 的 　 神 啊 ， 你 不 是 天 上 的 　 神 麽 ？ 你 不 是 万 邦 万 国 的 主 宰 麽 ？ 在 你 手 中 有 大 能 大 力 ， 无 人 能 抵 挡 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11595', '14', '20', '7', '我 们 的 　 神 啊 ， 你 不 是 曾 在 你 民 以 色 列 人 面 前 驱 逐 这 地 的 居 民 ， 将 这 地 赐 给 你 朋 友 亚 伯 拉 罕 的 後 裔 永 远 为 业 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11596', '14', '20', '8', '他 们 住 在 这 地 ， 又 为 你 的 名 建 造 圣 所 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11597', '14', '20', '9', '倘 有 祸 患 临 到 我 们 ， 或 刀 兵 灾 殃 ， 或 瘟 疫 饥 荒 ， 我 们 在 急 难 的 时 候 ， 站 在 这 殿 前 向 你 呼 求 ， 你 必 垂 听 而 拯 救 ， 因 为 你 的 名 在 这 殿 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11598', '14', '20', '10', '从 前 以 色 列 人 出 埃 及 地 的 时 候 ， 你 不 容 以 色 列 人 侵 犯 亚 扪 人 、 摩 押 人 ， 和 西 珥 山 人 ， 以 色 列 人 就 离 开 他 们 ， 不 灭 绝 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11599', '14', '20', '11', '看 哪 ， 他 们 怎 样 报 复 我 们 ， 要 来 驱 逐 我 们 出 离 你 的 地 ， 就 是 你 赐 给 我 们 为 业 之 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11600', '14', '20', '12', '我 们 的 　 神 啊 ， 你 不 惩 罚 他 们 麽 ？ 因 为 我 们 无 力 抵 挡 这 来 攻 击 我 们 的 大 军 ， 我 们 也 不 知 道 怎 样 行 ， 我 们 的 眼 目 单 仰 望 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11601', '14', '20', '13', '犹 大 众 人 和 他 们 的 婴 孩 、 妻 子 、 儿 女 都 站 在 耶 和 华 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11602', '14', '20', '14', '那 时 ， 耶 和 华 的 灵 在 会 中 临 到 利 未 人 亚 萨 的 後 裔 ─ 玛 探 雅 的 玄 孙 ， 耶 利 的 曾 孙 ， 比 拿 雅 的 孙 子 ， 撒 迦 利 雅 的 儿 子 雅 哈 悉 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11603', '14', '20', '15', '他 说 ： 犹 大 众 人 、 耶 路 撒 冷 的 居 民 ， 和 约 沙 法 王 ， 你 们 请 听 。 耶 和 华 对 你 们 如 此 说 ： 不 要 因 这 大 军 恐 惧 惊 惶 ； 因 为 胜 败 不 在 乎 你 们 ， 乃 在 乎 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11604', '14', '20', '16', '明 日 你 们 要 下 去 迎 敌 ， 他 们 是 从 洗 斯 坡 上 来 ， 你 们 必 在 耶 鲁 伊 勒 旷 野 前 的 谷 口 遇 见 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11605', '14', '20', '17', '犹 大 和 耶 路 撒 冷 人 哪 ， 这 次 你 们 不 要 争 战 ， 要 摆 阵 站 着 ， 看 耶 和 华 为 你 们 施 行 拯 救 。 不 要 恐 惧 ， 也 不 要 惊 惶 。 明 日 当 出 去 迎 敌 ， 因 为 耶 和 华 与 你 们 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11606', '14', '20', '18', '约 沙 法 就 面 伏 於 地 ， 犹 大 众 人 和 耶 路 撒 冷 的 居 民 也 俯 伏 在 耶 和 华 面 前 ， 叩 拜 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11607', '14', '20', '19', '哥 辖 族 和 可 拉 族 的 利 未 人 都 起 来 ， 用 极 大 的 声 音 赞 美 耶 和 华 以 色 列 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11608', '14', '20', '20', '次 日 清 早 ， 众 人 起 来 往 提 哥 亚 的 旷 野 去 。 出 去 的 时 候 ， 约 沙 法 站 着 说 ： 犹 大 人 和 耶 路 撒 冷 的 居 民 哪 ， 要 听 我 说 ： 信 耶 和 华 ─ 你 们 的 　 神 就 必 立 稳 ； 信 他 的 先 知 就 必 亨 通 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11609', '14', '20', '21', '约 沙 法 既 与 民 商 议 了 ， 就 设 立 歌 唱 的 人 ， 颂 赞 耶 和 华 ， 使 他 们 穿 上 圣 洁 的 礼 服 ， 走 在 军 前 赞 美 耶 和 华 说 ： 当 称 谢 耶 和 华 ， 因 他 的 慈 爱 永 远 长 存 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11610', '14', '20', '22', '众 人 方 唱 歌 赞 美 的 时 候 ， 耶 和 华 就 派 伏 兵 击 杀 那 来 攻 击 犹 大 人 的 亚 扪 人 、 摩 押 人 ， 和 西 珥 山 人 ， 他 们 就 被 打 败 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11611', '14', '20', '23', '因 为 亚 扪 人 和 摩 押 人 起 来 ， 击 杀 住 西 珥 山 的 人 ， 将 他 们 灭 尽 ； 灭 尽 住 西 珥 山 的 人 之 後 ， 他 们 又 彼 此 自 相 击 杀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11612', '14', '20', '24', '犹 大 人 来 到 旷 野 的 望 楼 ， 向 那 大 军 观 看 ， 见 尸 横 遍 地 ， 没 有 一 个 逃 脱 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11613', '14', '20', '25', '约 沙 法 和 他 的 百 姓 就 来 收 取 敌 人 的 财 物 ， 在 尸 首 中 见 了 许 多 财 物 、 珍 宝 ， 他 们 剥 脱 下 来 的 多 得 不 可 携 带 ； 因 为 甚 多 ， 直 收 取 了 三 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11614', '14', '20', '26', '第 四 日 众 人 聚 集 在 比 拉 迦 谷 ( 就 是 称 颂 的 意 思 ) ， 在 那 里 称 颂 耶 和 华 。 因 此 那 地 方 名 叫 比 拉 迦 谷 ， 直 到 今 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11615', '14', '20', '27', '犹 大 人 和 耶 路 撒 冷 人 都 欢 欢 喜 喜 地 回 耶 路 撒 冷 ， 约 沙 法 率 领 他 们 ； 因 为 耶 和 华 使 他 们 战 胜 仇 敌 ， 就 欢 喜 快 乐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11616', '14', '20', '28', '他 们 弹 琴 、 鼓 瑟 、 吹 号 来 到 耶 路 撒 冷 ， 进 了 耶 和 华 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11617', '14', '20', '29', '列 邦 诸 国 听 见 耶 和 华 战 败 以 色 列 的 仇 敌 ， 就 甚 惧 怕 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11618', '14', '20', '30', '这 样 ， 约 沙 法 的 国 得 享 太 平 ， 因 为 　 神 赐 他 四 境 平 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11619', '14', '20', '31', '约 沙 法 作 犹 大 王 ， 登 基 的 时 候 年 三 十 五 岁 ， 在 耶 路 撒 冷 作 王 二 十 五 年 。 他 母 亲 名 叫 阿 苏 巴 ， 乃 示 利 希 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11620', '14', '20', '32', '约 沙 法 效 法 他 父 亚 撒 所 行 的 ， 不 偏 左 右 ， 行 耶 和 华 眼 中 看 为 正 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11621', '14', '20', '33', '只 是 邱 坛 还 没 有 废 去 ， 百 姓 也 没 有 立 定 心 意 归 向 他 们 列 祖 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11622', '14', '20', '34', '约 沙 法 其 馀 的 事 ， 自 始 至 终 都 写 在 哈 拿 尼 的 儿 子 耶 户 的 书 上 ， 也 载 入 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11623', '14', '20', '35', '此 後 ， 犹 大 王 约 沙 法 与 以 色 列 王 亚 哈 谢 交 好 ； 亚 哈 谢 行 恶 太 甚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11624', '14', '20', '36', '二 王 合 夥 造 船 要 往 他 施 去 ， 遂 在 以 旬 迦 别 造 船 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11625', '14', '20', '37', '那 时 玛 利 沙 人 、 多 大 瓦 的 儿 子 以 利 以 谢 向 约 沙 法 预 言 说 ： 因 你 与 亚 哈 谢 交 好 ， 耶 和 华 必 破 坏 你 所 造 的 。 後 来 那 船 果 然 破 坏 ， 不 能 往 他 施 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11626', '14', '21', '1', '约 沙 法 与 他 列 祖 同 睡 ， 葬 在 大 卫 城 他 列 祖 的 坟 地 里 。 他 儿 子 约 兰 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11627', '14', '21', '2', '约 兰 有 几 个 兄 弟 ， 就 是 约 沙 法 的 儿 子 亚 撒 利 雅 、 耶 歇 、 撒 迦 利 雅 、 亚 撒 利 雅 、 米 迦 勒 、 示 法 提 雅 。 这 都 是 犹 大 王 约 沙 法 的 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11628', '14', '21', '3', '他 们 的 父 亲 将 许 多 金 银 、 财 宝 ， 和 犹 大 地 的 坚 固 城 赐 给 他 们 ； 但 将 国 赐 给 约 兰 ， 因 为 他 是 长 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11629', '14', '21', '4', '约 兰 兴 起 坐 他 父 的 位 ， 奋 勇 自 强 ， 就 用 刀 杀 了 他 的 众 兄 弟 和 以 色 列 的 几 个 首 领 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11630', '14', '21', '5', '约 兰 登 基 的 时 候 年 三 十 二 岁 ， 在 耶 路 撒 冷 作 王 八 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11631', '14', '21', '6', '他 行 以 色 列 诸 王 的 道 ， 与 亚 哈 家 一 样 ； 因 他 娶 了 亚 哈 的 女 儿 为 妻 ， 行 耶 和 华 眼 中 看 为 恶 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11632', '14', '21', '7', '耶 和 华 却 因 自 己 与 大 卫 所 立 的 约 ， 不 肯 灭 大 卫 的 家 ， 照 他 所 应 许 的 ， 永 远 赐 灯 光 与 大 卫 和 他 的 子 孙 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11633', '14', '21', '8', '约 兰 年 间 ， 以 东 人 背 叛 犹 大 ， 脱 离 他 的 权 下 ， 自 己 立 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11634', '14', '21', '9', '约 兰 就 率 领 军 长 和 所 有 的 战 车 ， 夜 间 起 来 ， 攻 击 围 困 他 的 以 东 人 和 车 兵 长 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11635', '14', '21', '10', '这 样 ， 以 东 人 背 叛 犹 大 ， 脱 离 他 的 权 下 ， 直 到 今 日 。 那 时 ， 立 拿 人 也 背 叛 了 ， 因 为 约 兰 离 弃 耶 和 华 ─ 他 列 祖 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11636', '14', '21', '11', '他 又 在 犹 大 诸 山 建 筑 邱 坛 ， 使 耶 路 撒 冷 的 居 民 行 邪 淫 ， 诱 惑 犹 大 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11637', '14', '21', '12', '先 知 以 利 亚 达 信 与 约 兰 说 ： 耶 和 华 ─ 你 祖 大 卫 的 　 神 如 此 说 ： 因 为 你 不 行 你 父 约 沙 法 和 犹 大 王 亚 撒 的 道 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11638', '14', '21', '13', '乃 行 以 色 列 诸 王 的 道 ， 使 犹 大 人 和 耶 路 撒 冷 的 居 民 行 邪 淫 ， 像 亚 哈 家 一 样 ， 又 杀 了 你 父 家 比 你 好 的 诸 兄 弟 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11639', '14', '21', '14', '故 此 ， 耶 和 华 降 大 灾 与 你 的 百 姓 和 你 的 妻 子 、 儿 女 ， 并 你 一 切 所 有 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11640', '14', '21', '15', '你 的 肠 子 必 患 病 ， 日 加 沉 重 ， 以 致 你 的 肠 子 坠 落 下 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11641', '14', '21', '16', '以 後 ， 耶 和 华 激 动 非 利 士 人 和 靠 近 古 实 的 亚 拉 伯 人 来 攻 击 约 兰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11642', '14', '21', '17', '他 们 上 来 攻 击 犹 大 ， 侵 入 境 内 ， 掳 掠 了 王 宫 里 所 有 的 财 货 和 他 的 妻 子 、 儿 女 ， 除 了 他 小 儿 子 约 哈 斯 ( 又 名 亚 哈 谢 ) 之 外 ， 没 有 留 下 一 个 儿 子 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11643', '14', '21', '18', '这 些 事 以 後 ， 耶 和 华 使 约 兰 的 肠 子 患 不 能 医 治 的 病 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11644', '14', '21', '19', '他 患 此 病 缠 绵 日 久 ， 过 了 二 年 ， 肠 子 坠 落 下 来 ， 病 重 而 死 。 他 的 民 没 有 为 他 烧 甚 麽 物 件 ， 像 从 前 为 他 列 祖 所 烧 的 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11645', '14', '21', '20', '约 兰 登 基 的 时 候 年 三 十 二 岁 ， 在 耶 路 撒 冷 作 王 八 年 。 他 去 世 无 人 思 慕 ， 众 人 葬 他 在 大 卫 城 ， 只 是 不 在 列 王 的 坟 墓 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11646', '14', '22', '1', '耶 路 撒 冷 的 居 民 立 约 兰 的 小 儿 子 亚 哈 谢 接 续 他 作 王 ； 因 为 跟 随 亚 拉 伯 人 来 攻 营 的 军 兵 曾 杀 了 亚 哈 谢 的 众 兄 长 。 这 样 ， 犹 大 王 约 兰 的 儿 子 亚 哈 谢 作 了 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11647', '14', '22', '2', '亚 哈 谢 登 基 的 时 候 年 四 十 二 岁 ( 王 下 八26 作 二 十 二 岁 ) ， 在 耶 路 撒 冷 作 王 一 年 。 他 母 亲 名 叫 亚 他 利 雅 ， 是 暗 利 的 孙 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11648', '14', '22', '3', '亚 哈 谢 也 行 亚 哈 家 的 道 ； 因 为 他 母 亲 给 他 主 谋 ， 使 他 行 恶 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11649', '14', '22', '4', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 像 亚 哈 家 一 样 ； 因 他 父 亲 死 後 有 亚 哈 家 的 人 给 他 主 谋 ， 以 致 败 坏 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11650', '14', '22', '5', '他 听 从 亚 哈 家 的 计 谋 ， 同 以 色 列 王 亚 哈 的 儿 子 约 兰 往 基 列 的 拉 末 去 ， 与 亚 兰 王 哈 薛 争 战 ； 亚 兰 人 打 伤 了 约 兰 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11651', '14', '22', '6', '约 兰 回 到 耶 斯 列 ， 医 治 在 拉 末 与 亚 兰 王 哈 薛 打 仗 所 受 的 伤 ， 犹 大 王 约 兰 的 儿 子 亚 撒 利 雅 ( 即 亚 哈 谢 ) 因 为 亚 哈 的 儿 子 约 兰 病 了 ， 就 下 到 耶 斯 列 看 望 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11652', '14', '22', '7', '亚 哈 谢 去 见 约 兰 就 被 害 了 ， 这 是 出 乎 　 神 ； 因 为 他 到 了 ， 就 同 约 兰 出 去 攻 击 宁 示 的 孙 子 耶 户 。 这 耶 户 是 耶 和 华 所 膏 、 使 他 剪 除 亚 哈 家 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11653', '14', '22', '8', '耶 户 讨 亚 哈 家 罪 的 时 候 ， 遇 见 犹 大 的 众 首 领 和 亚 哈 谢 的 众 侄 子 服 事 亚 哈 谢 ， 就 把 他 们 都 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11654', '14', '22', '9', '亚 哈 谢 藏 在 撒 玛 利 亚 ， 耶 户 寻 找 他 ， 众 人 将 他 拿 住 ， 送 到 耶 户 那 里 ， 就 杀 了 他 ， 将 他 葬 埋 ； 因 他 们 说 ， 他 是 那 尽 心 寻 求 耶 和 华 之 约 沙 法 的 儿 子 。 这 样 ， 亚 哈 谢 的 家 无 力 保 守 国 权 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11655', '14', '22', '10', '亚 哈 谢 的 母 亲 亚 他 利 雅 见 他 儿 子 死 了 ， 就 起 来 剿 灭 犹 大 王 室 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11656', '14', '22', '11', '但 王 的 女 儿 约 示 巴 将 亚 哈 谢 的 儿 子 约 阿 施 从 那 被 杀 的 王 子 中 偷 出 来 ， 把 他 和 他 的 乳 母 都 藏 在 卧 房 里 。 约 示 巴 是 约 兰 王 的 女 儿 ， 亚 哈 谢 的 妹 子 ， 祭 司 耶 何 耶 大 的 妻 。 他 收 藏 约 阿 施 ， 躲 避 亚 他 利 雅 ， 免 得 被 杀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11657', '14', '22', '12', '约 阿 施 和 他 们 一 同 藏 在 　 神 殿 里 六 年 ； 亚 他 利 雅 篡 了 国 位 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11658', '14', '23', '1', '第 七 年 ， 耶 何 耶 大 奋 勇 自 强 ， 将 百 夫 长 耶 罗 罕 的 儿 子 亚 撒 利 雅 ， 约 哈 难 的 儿 子 以 实 玛 利 ， 俄 备 得 的 儿 子 亚 撒 利 雅 ， 亚 大 雅 的 儿 子 玛 西 雅 ， 细 基 利 的 儿 子 以 利 沙 法 召 来 ， 与 他 们 立 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11659', '14', '23', '2', '他 们 走 遍 犹 大 ， 从 犹 大 各 城 里 招 聚 利 未 人 和 以 色 列 的 众 族 长 到 耶 路 撒 冷 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11660', '14', '23', '3', '会 众 在 　 神 殿 里 与 王 立 约 。 耶 何 耶 大 对 他 们 说 ： 看 哪 ， 王 的 儿 子 必 当 作 王 ， 正 如 耶 和 华 指 着 大 卫 子 孙 所 应 许 的 话 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11661', '14', '23', '4', '又 说 ： 你 们 当 这 样 行 ： 祭 司 和 利 未 人 凡 安 息 日 进 班 的 ， 三 分 之 一 要 把 守 各 门 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11662', '14', '23', '5', '三 分 之 一 要 在 王 宫 ， 三 分 之 一 要 在 基 址 门 ； 众 百 姓 要 在 耶 和 华 殿 的 院 内 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11663', '14', '23', '6', '除 了 祭 司 和 供 职 的 利 未 人 之 外 ， 不 准 别 人 进 耶 和 华 的 殿 ； 惟 独 他 们 可 以 进 去 ， 因 为 他 们 圣 洁 。 众 百 姓 要 遵 守 耶 和 华 所 吩 咐 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11664', '14', '23', '7', '利 未 人 要 手 中 各 拿 兵 器 ， 四 围 护 卫 王 ； 凡 擅 入 殿 宇 的 ， 必 当 治 死 。 王 出 入 的 时 候 ， 你 们 当 跟 随 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11665', '14', '23', '8', '利 未 人 和 犹 大 众 人 都 照 着 祭 司 耶 何 耶 大 一 切 所 吩 咐 的 去 行 ， 各 带 所 管 安 息 日 进 班 出 班 的 人 来 ， 因 为 祭 司 耶 何 耶 大 不 许 他 们 下 班 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11666', '14', '23', '9', '祭 司 耶 何 耶 大 便 将 　 神 殿 里 所 藏 大 卫 王 的 枪 、 盾 牌 、 挡 牌 交 给 百 夫 长 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11667', '14', '23', '10', '又 分 派 众 民 手 中 各 拿 兵 器 ， 在 坛 和 殿 那 里 ， 从 殿 右 直 到 殿 左 ， 站 在 王 子 的 四 围 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11668', '14', '23', '11', '於 是 领 王 子 出 来 ， 给 他 戴 上 冠 冕 ， 将 律 法 书 交 给 他 ， 立 他 作 王 。 耶 何 耶 大 和 众 子 膏 他 ， 众 人 说 ： 愿 王 万 岁 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11669', '14', '23', '12', '亚 他 利 雅 听 见 民 奔 走 赞 美 王 的 声 音 ， 就 到 民 那 里 ， 进 耶 和 华 的 殿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11670', '14', '23', '13', '看 见 王 站 在 殿 门 的 柱 旁 ， 百 夫 长 和 吹 号 的 人 侍 立 在 王 左 右 ， 国 民 都 欢 乐 吹 号 ， 又 有 歌 唱 的 ， 用 各 样 的 乐 器 领 人 歌 唱 赞 美 ； 亚 他 利 雅 就 撕 裂 衣 服 ， 喊 叫 说 ： 反 了 ！ 反 了 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11671', '14', '23', '14', '祭 司 耶 何 耶 大 带 管 辖 军 兵 的 百 夫 长 出 来 ， 吩 咐 他 们 说 ： 将 他 赶 到 班 外 ， 凡 跟 随 他 的 必 用 刀 杀 死 ！ 因 为 祭 司 说 ： 不 可 在 耶 和 华 殿 里 杀 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11672', '14', '23', '15', '众 兵 就 闪 开 ， 让 他 去 ； 他 走 到 王 宫 的 马 门 ， 便 在 那 里 把 他 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11673', '14', '23', '16', '耶 何 耶 大 与 众 民 和 王 立 约 ， 都 要 作 耶 和 华 的 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11674', '14', '23', '17', '於 是 众 民 都 到 巴 力 庙 ， 拆 毁 了 庙 ， 打 碎 坛 和 像 ， 又 在 坛 前 将 巴 力 的 祭 司 玛 坦 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11675', '14', '23', '18', '耶 何 耶 大 派 官 看 守 耶 和 华 的 殿 ， 是 在 祭 司 利 未 人 手 下 。 这 祭 司 利 未 人 是 大 卫 分 派 在 耶 和 华 殿 中 、 照 摩 西 律 法 上 所 写 的 ， 给 耶 和 华 献 燔 祭 ， 又 按 大 卫 所 定 的 例 ， 欢 乐 歌 唱 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11676', '14', '23', '19', '且 设 立 守 门 的 把 守 耶 和 华 殿 的 各 门 ， 无 论 为 何 事 ， 不 洁 净 的 人 都 不 准 进 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11677', '14', '23', '20', '又 率 领 百 夫 长 和 贵 胄 ， 与 民 间 的 官 长 ， 并 国 中 的 众 民 ， 请 王 从 耶 和 华 殿 下 来 ， 由 上 门 进 入 王 宫 ， 立 王 坐 在 国 位 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11678', '14', '23', '21', '国 民 都 欢 乐 ， 合 城 都 安 静 。 众 人 已 将 亚 他 利 雅 用 刀 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11679', '14', '24', '1', '约 阿 施 登 基 的 时 候 年 七 岁 ， 在 耶 路 撒 冷 作 王 四 十 年 。 他 母 亲 名 叫 西 比 亚 ， 是 别 是 巴 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11680', '14', '24', '2', '祭 司 耶 何 耶 大 在 世 的 时 候 ， 约 阿 施 行 耶 和 华 眼 中 看 为 正 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11681', '14', '24', '3', '耶 何 耶 大 为 他 娶 了 两 个 妻 ， 并 且 生 儿 养 女 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11682', '14', '24', '4', '此 後 ， 约 阿 施 有 意 重 修 耶 和 华 的 殿 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11683', '14', '24', '5', '便 召 聚 众 祭 司 和 利 未 人 ， 吩 咐 他 们 说 ： 你 们 要 往 犹 大 各 城 去 ， 使 以 色 列 众 人 捐 纳 银 子 ， 每 年 可 以 修 理 你 们 　 神 的 殿 ； 你 们 要 急 速 办 理 这 事 。 只 是 利 未 人 不 急 速 办 理 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11684', '14', '24', '6', '王 召 了 大 祭 司 耶 何 耶 大 来 ， 对 他 说 ： 从 前 耶 和 华 的 仆 人 摩 西 ， 为 法 柜 的 帐 幕 与 以 色 列 会 众 所 定 的 捐 项 ， 你 为 何 不 叫 利 未 人 照 这 例 从 犹 大 和 耶 路 撒 冷 带 来 作 殿 的 费 用 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11685', '14', '24', '7', '〈 因 为 那 恶 妇 亚 他 利 雅 的 众 子 曾 拆 毁 　 神 的 殿 ， 又 用 耶 和 华 殿 中 分 别 为 圣 的 物 供 奉 巴 力 。 〉');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11686', '14', '24', '8', '於 是 王 下 令 ， 众 人 做 了 一 柜 ， 放 在 耶 和 华 殿 的 门 外 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11687', '14', '24', '9', '又 通 告 犹 大 和 耶 路 撒 冷 的 百 姓 ， 要 将 　 神 仆 人 摩 西 在 旷 野 所 吩 咐 以 色 列 人 的 捐 项 给 耶 和 华 送 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11688', '14', '24', '10', '众 首 领 和 百 姓 都 欢 欢 喜 喜 地 将 银 子 送 来 ， 投 入 柜 中 ， 直 到 捐 完 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11689', '14', '24', '11', '利 未 人 见 银 子 多 了 ， 就 把 柜 抬 到 王 所 派 的 司 事 面 前 ； 王 的 书 记 和 大 祭 司 的 属 员 来 将 柜 倒 空 ， 仍 放 在 原 处 。 日 日 都 是 这 样 ， 积 蓄 的 银 子 甚 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11690', '14', '24', '12', '王 与 耶 何 耶 大 将 银 子 交 给 耶 和 华 殿 里 办 事 的 人 ， 他 们 就 雇 了 石 匠 、 木 匠 重 修 耶 和 华 的 殿 ， 又 雇 了 铁 匠 、 铜 匠 修 理 耶 和 华 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11691', '14', '24', '13', '工 人 操 作 ， 渐 渐 修 成 ， 将 　 神 殿 修 造 得 与 从 前 一 样 ， 而 且 甚 是 坚 固 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11692', '14', '24', '14', '工 程 完 了 ， 他 们 就 把 其 馀 的 银 子 拿 到 王 与 耶 何 耶 大 面 前 ， 用 以 制 造 耶 和 华 殿 供 奉 所 用 的 器 皿 和 调 羹 ， 并 金 银 的 器 皿 。 耶 何 耶 大 在 世 的 时 候 ， 众 人 常 在 耶 和 华 殿 里 献 燔 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11693', '14', '24', '15', '耶 何 耶 大 年 纪 老 迈 ， 日 子 满 足 而 死 。 死 的 时 候 年 一 百 三 十 岁 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11694', '14', '24', '16', '葬 在 大 卫 城 列 王 的 坟 墓 里 ； 因 为 他 在 以 色 列 人 中 行 善 ， 又 事 奉 　 神 ， 修 理 神 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11695', '14', '24', '17', '耶 何 耶 大 死 後 ， 犹 大 的 众 首 领 来 朝 拜 王 ； 王 就 听 从 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11696', '14', '24', '18', '他 们 离 弃 耶 和 华 ─ 他 们 列 祖 　 神 的 殿 ， 去 事 奉 亚 舍 拉 和 偶 像 ； 因 他 们 这 罪 ， 就 有 忿 怒 临 到 犹 大 和 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11697', '14', '24', '19', '但 　 神 仍 遣 先 知 到 他 们 那 里 ， 引 导 他 们 归 向 耶 和 华 。 这 先 知 警 戒 他 们 ， 他 们 却 不 肯 听 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11698', '14', '24', '20', '那 时 ， 　 神 的 灵 感 动 祭 司 耶 何 耶 大 的 儿 子 撒 迦 利 亚 ， 他 就 站 在 上 面 对 民 说 ： 　 神 如 此 说 ： 你 们 为 何 干 犯 耶 和 华 的 诫 命 ， 以 致 不 得 亨 通 呢 ？ 因 为 你 们 离 弃 耶 和 华 ， 所 以 他 也 离 弃 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11699', '14', '24', '21', '众 民 同 心 谋 害 撒 迦 利 亚 ， 就 照 王 的 吩 咐 ， 在 耶 和 华 殿 的 院 内 用 石 头 打 死 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11700', '14', '24', '22', '这 样 ， 约 阿 施 王 不 想 念 撒 迦 利 亚 的 父 亲 耶 何 耶 大 向 自 己 所 施 的 恩 ， 杀 了 他 的 儿 子 。 撒 迦 利 亚 临 死 的 时 候 说 ： 愿 耶 和 华 鉴 察 伸 冤 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11701', '14', '24', '23', '满 了 一 年 ， 亚 兰 的 军 兵 上 来 攻 击 约 阿 施 ， 来 到 犹 大 和 耶 路 撒 冷 ， 杀 了 民 中 的 众 首 领 ， 将 所 掠 的 财 货 送 到 大 马 色 王 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11702', '14', '24', '24', '亚 兰 的 军 兵 虽 来 了 一 小 队 ， 耶 和 华 却 将 大 队 的 军 兵 交 在 他 们 手 里 ， 是 因 犹 大 人 离 弃 耶 和 华 ─ 他 们 列 祖 的 　 神 ， 所 以 藉 亚 兰 人 惩 罚 约 阿 施 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11703', '14', '24', '25', '亚 兰 人 离 开 约 阿 施 的 时 候 ， 他 患 重 病 ； 臣 仆 背 叛 他 ， 要 报 祭 司 耶 何 耶 大 儿 子 流 血 之 仇 ， 杀 他 在 床 上 ， 葬 他 在 大 卫 城 ， 只 是 不 葬 在 列 王 的 坟 墓 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11704', '14', '24', '26', '背 叛 他 的 是 亚 扪 妇 人 示 米 押 的 儿 子 撒 拔 和 摩 押 妇 人 示 米 利 的 儿 子 约 萨 拔 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11705', '14', '24', '27', '至 於 他 的 众 子 和 他 所 受 的 警 戒 ， 并 他 重 修 　 神 殿 的 事 ， 都 写 在 列 王 的 传 上 。 他 儿 子 亚 玛 谢 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11706', '14', '25', '1', '亚 玛 谢 登 基 的 时 候 年 二 十 五 岁 ， 在 耶 路 撒 冷 作 王 二 十 九 年 。 他 母 亲 名 叫 约 耶 但 ， 是 耶 路 撒 冷 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11707', '14', '25', '2', '亚 玛 谢 行 耶 和 华 眼 中 看 为 正 的 事 ， 只 是 心 不 专 诚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11708', '14', '25', '3', '国 一 坚 定 ， 就 把 杀 他 父 王 的 臣 仆 杀 了 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11709', '14', '25', '4', '却 没 有 治 死 他 们 的 儿 子 ， 是 照 摩 西 律 法 书 上 耶 和 华 所 吩 咐 的 说 ： 不 可 因 子 杀 父 ， 也 不 可 因 父 杀 子 ， 各 人 要 为 本 身 的 罪 而 死 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11710', '14', '25', '5', '亚 玛 谢 招 聚 犹 大 人 ， 按 着 犹 大 和 便 雅 悯 的 宗 族 设 立 千 夫 长 、 百 夫 长 ， 又 数 点 人 数 ， 从 二 十 岁 以 外 ， 能 拿 枪 拿 盾 牌 出 去 打 仗 的 精 兵 共 有 三 十 万 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11711', '14', '25', '6', '又 用 银 子 一 百 他 连 得 ， 从 以 色 列 招 募 了 十 万 大 能 的 勇 士 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11712', '14', '25', '7', '有 一 个 　 神 人 来 见 亚 玛 谢 ， 对 他 说 ： 王 啊 ， 不 要 使 以 色 列 的 军 兵 与 你 同 去 ， 因 为 耶 和 华 不 与 以 色 列 人 以 法 莲 的 後 裔 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11713', '14', '25', '8', '你 若 一 定 要 去 ， 就 奋 勇 争 战 罢 ！ 但 　 神 必 使 你 败 在 敌 人 面 前 ； 因 为 　 神 能 助 人 得 胜 ， 也 能 使 人 倾 败 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11714', '14', '25', '9', '亚 玛 谢 问 　 神 人 说 ： 我 给 了 以 色 列 军 的 那 一 百 他 连 得 银 子 怎 麽 样 呢 ？ 　 神 人 回 答 说 ： 耶 和 华 能 把 更 多 的 赐 给 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11715', '14', '25', '10', '於 是 亚 玛 谢 将 那 从 以 法 莲 来 的 军 兵 分 别 出 来 ， 叫 他 们 回 家 去 。 故 此 ， 他 们 甚 恼 怒 犹 大 人 ， 气 忿 忿 地 回 家 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11716', '14', '25', '11', '亚 玛 谢 壮 起 胆 来 ， 率 领 他 的 民 到 盐 谷 ， 杀 了 西 珥 人 一 万 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11717', '14', '25', '12', '犹 大 人 又 生 擒 了 一 万 带 到 山 崖 上 ， 从 那 里 把 他 们 扔 下 去 ， 以 致 他 们 都 摔 碎 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11718', '14', '25', '13', '但 亚 玛 谢 所 打 发 回 去 、 不 许 一 同 出 征 的 那 些 军 兵 攻 打 犹 大 各 城 ， 从 撒 玛 利 亚 直 到 伯 和 仑 ， 杀 了 三 千 人 ， 抢 了 许 多 财 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11719', '14', '25', '14', '亚 玛 谢 杀 了 以 东 人 回 来 ， 就 把 西 珥 的 神 像 带 回 ， 立 为 自 己 的 　 神 ， 在 他 面 前 叩 拜 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11720', '14', '25', '15', '因 此 ， 耶 和 华 的 怒 气 向 亚 玛 谢 发 作 ， 就 差 一 个 先 知 去 见 他 ， 说 ： 这 些 　 神 不 能 救 他 的 民 脱 离 你 的 手 ， 你 为 何 寻 求 他 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11721', '14', '25', '16', '先 知 与 王 说 话 的 时 候 ， 王 对 他 说 ： 谁 立 你 作 王 的 谋 士 呢 ？ 你 住 口 罢 ！ 为 何 找 打 呢 ？ 先 知 就 止 住 了 ， 又 说 ： 你 行 这 事 ， 不 听 从 我 的 劝 戒 ， 我 知 道 　 神 定 意 要 灭 你 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11722', '14', '25', '17', '犹 大 王 亚 玛 谢 与 群 臣 商 议 ， 就 差 遣 使 者 去 见 耶 户 的 孙 子 、 约 哈 斯 的 儿 子 、 以 色 列 王 约 阿 施 ， 说 ： 你 来 ， 我 们 二 人 相 见 於 战 场 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11723', '14', '25', '18', '以 色 列 王 约 阿 施 差 遣 使 者 去 见 犹 大 王 亚 玛 谢 ， 说 ： 利 巴 嫩 的 蒺 藜 差 遣 使 者 去 见 利 巴 嫩 的 香 柏 树 ， 说 ： 将 你 的 女 儿 给 我 儿 子 为 妻 。 後 来 利 巴 嫩 有 一 个 野 兽 经 过 ， 把 蒺 藜 践 踏 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11724', '14', '25', '19', '你 说 ： 看 哪 ， 我 打 败 了 以 东 人 ， 你 就 心 高 气 傲 ， 以 致 矜 夸 。 你 在 家 里 安 居 就 罢 了 ， 为 何 要 惹 祸 使 自 己 和 犹 大 国 一 同 败 亡 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11725', '14', '25', '20', '亚 玛 谢 却 不 肯 听 从 。 这 是 出 乎 　 神 ， 好 将 他 们 交 在 敌 人 手 里 ， 因 为 他 们 寻 求 以 东 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11726', '14', '25', '21', '於 是 以 色 列 王 约 阿 施 上 来 ， 在 犹 大 的 伯 示 麦 与 犹 大 王 亚 玛 谢 相 见 於 战 场 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11727', '14', '25', '22', '犹 大 人 败 在 以 色 列 人 面 前 ， 各 自 逃 回 家 里 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11728', '14', '25', '23', '以 色 列 王 约 阿 施 在 伯 示 麦 擒 住 约 哈 斯 ( 就 是 亚 哈 谢 ) 的 孙 子 、 约 阿 施 的 儿 子 、 犹 大 王 亚 玛 谢 ， 将 他 带 到 耶 路 撒 冷 ， 又 拆 毁 耶 路 撒 冷 的 城 墙 ， 从 以 法 莲 门 直 到 角 门 ， 共 四 百 肘 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11729', '14', '25', '24', '又 将 俄 别 以 东 所 看 守 　 神 殿 里 的 一 切 金 银 和 器 皿 ， 与 王 宫 里 的 财 宝 都 拿 了 去 ， 并 带 人 去 为 质 ， 就 回 撒 玛 利 亚 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11730', '14', '25', '25', '以 色 列 王 约 哈 斯 的 儿 子 约 阿 施 死 後 ， 犹 大 王 约 阿 施 的 儿 子 亚 玛 谢 又 活 了 十 五 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11731', '14', '25', '26', '亚 玛 谢 其 馀 的 事 ， 自 始 至 终 不 都 写 在 犹 大 和 以 色 列 诸 王 记 上 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11732', '14', '25', '27', '自 从 亚 玛 谢 离 弃 耶 和 华 之 後 ， 在 耶 路 撒 冷 有 人 背 叛 他 ， 他 就 逃 到 拉 吉 ； 叛 党 却 打 发 人 到 拉 吉 ， 将 他 杀 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11733', '14', '25', '28', '人 就 用 马 将 他 的 尸 首 驮 回 ， 葬 在 犹 大 京 城 他 列 祖 的 坟 地 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11734', '14', '26', '1', '犹 大 众 民 立 亚 玛 谢 的 儿 子 乌 西 雅 ( 又 名 亚 撒 利 雅 ) 接 续 他 父 作 王 ， 那 时 他 年 十 六 岁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11735', '14', '26', '2', '〈 亚 玛 谢 与 他 列 祖 同 睡 之 後 ， 乌 西 雅 收 回 以 禄 仍 归 犹 大 ， 又 重 新 修 理 。 〉');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11736', '14', '26', '3', '乌 西 雅 登 基 的 时 候 年 十 六 岁 ， 在 耶 路 撒 冷 作 王 五 十 二 年 。 他 母 亲 名 叫 耶 可 利 雅 ， 是 耶 路 撒 冷 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11737', '14', '26', '4', '乌 西 雅 行 耶 和 华 眼 中 看 为 正 的 事 ， 效 法 他 父 亚 玛 谢 一 切 所 行 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11738', '14', '26', '5', '通 晓 　 神 默 示 ， 撒 迦 利 亚 在 世 的 时 候 ， 乌 西 雅 定 意 寻 求 　 神 ； 他 寻 求 耶 和 华 ， 　 神 就 使 他 亨 通 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11739', '14', '26', '6', '他 出 去 攻 击 非 利 士 人 ， 拆 毁 了 迦 特 城 、 雅 比 尼 城 ， 和 亚 实 突 城 ； 在 非 利 士 人 中 ， 在 亚 实 突 境 内 ， 又 建 筑 了 些 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11740', '14', '26', '7', '　 神 帮 助 他 攻 击 非 利 士 人 和 住 在 姑 珥 巴 力 的 亚 拉 伯 人 ， 并 米 乌 尼 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11741', '14', '26', '8', '亚 扪 人 给 乌 西 雅 进 贡 。 他 的 名 声 传 到 埃 及 ， 因 他 甚 是 强 盛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11742', '14', '26', '9', '乌 西 雅 在 耶 路 撒 冷 的 角 门 和 谷 门 ， 并 城 墙 转 弯 之 处 ， 建 筑 城 楼 ， 且 甚 坚 固 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11743', '14', '26', '10', '又 在 旷 野 与 高 原 和 平 原 ， 建 筑 望 楼 ， 挖 了 许 多 井 ， 因 他 的 牲 畜 甚 多 ； 又 在 山 地 和 佳 美 之 地 ， 有 农 夫 和 修 理 葡 萄 园 的 人 ， 因 为 他 喜 悦 农 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11744', '14', '26', '11', '乌 西 雅 又 有 军 兵 ， 照 书 记 耶 利 和 官 长 玛 西 雅 所 数 点 的 ， 在 王 的 一 个 将 军 哈 拿 尼 雅 手 下 ， 分 队 出 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11745', '14', '26', '12', '族 长 、 大 能 勇 士 的 总 数 共 有 二 千 六 百 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11746', '14', '26', '13', '他 们 手 下 的 军 兵 共 有 三 十 万 七 千 五 百 人 ， 都 有 大 能 ， 善 於 争 战 ， 帮 助 王 攻 击 仇 敌 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11747', '14', '26', '14', '乌 西 雅 为 全 军 预 备 盾 牌 、 枪 、 盔 、 甲 、 弓 ， 和 甩 石 的 机 弦 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11748', '14', '26', '15', '又 在 耶 路 撒 冷 使 巧 匠 做 机 器 ， 安 在 城 楼 和 角 楼 上 ， 用 以 射 箭 发 石 。 乌 西 雅 的 名 声 传 到 远 方 ； 因 为 他 得 了 非 常 的 帮 助 ， 甚 是 强 盛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11749', '14', '26', '16', '他 既 强 盛 ， 就 心 高 气 傲 ， 以 致 行 事 邪 僻 ， 干 犯 耶 和 华 ─ 他 的 　 神 ， 进 耶 和 华 的 殿 ， 要 在 香 坛 上 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11750', '14', '26', '17', '祭 司 亚 撒 利 雅 率 领 耶 和 华 勇 敢 的 祭 司 八 十 人 ， 跟 随 他 进 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11751', '14', '26', '18', '他 们 就 阻 挡 乌 西 雅 王 ， 对 他 说 ： 乌 西 雅 啊 ， 给 耶 和 华 烧 香 不 是 你 的 事 ， 乃 是 亚 伦 子 孙 承 接 圣 职 祭 司 的 事 。 你 出 圣 殿 罢 ！ 因 为 你 犯 了 罪 。 你 行 这 事 ， 耶 和 华 　 神 必 不 使 你 得 荣 耀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11752', '14', '26', '19', '乌 西 雅 就 发 怒 ， 手 拿 香 炉 要 烧 香 。 他 向 祭 司 发 怒 的 时 候 ， 在 耶 和 华 殿 中 香 坛 旁 众 祭 司 面 前 ， 额 上 忽 然 发 出 大 ? 疯 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11753', '14', '26', '20', '大 祭 司 亚 撒 利 雅 和 众 祭 司 观 看 ， 见 他 额 上 发 出 大 ? 疯 ， 就 催 他 出 殿 ； 他 自 己 也 急 速 出 去 ， 因 为 耶 和 华 降 灾 与 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11754', '14', '26', '21', '乌 西 雅 王 长 大 ? 疯 直 到 死 日 ， 因 此 住 在 别 的 宫 里 ， 与 耶 和 华 的 殿 隔 绝 。 他 儿 子 约 坦 管 理 家 事 ， 治 理 国 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11755', '14', '26', '22', '乌 西 雅 其 馀 的 事 ， 自 始 至 终 都 是 亚 摩 斯 的 儿 子 先 知 以 赛 亚 所 记 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11756', '14', '26', '23', '乌 西 雅 与 他 列 祖 同 睡 ， 葬 在 王 陵 的 田 间 他 列 祖 的 坟 地 里 ； 因 为 人 说 ， 他 是 长 大 ? 疯 的 。 他 儿 子 约 坦 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11757', '14', '27', '1', '约 坦 登 基 的 时 候 年 二 十 五 岁 ， 在 耶 路 撒 冷 作 王 十 六 年 ， 他 母 亲 名 叫 耶 路 沙 ， 是 撒 督 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11758', '14', '27', '2', '约 坦 行 耶 和 华 眼 中 看 为 正 的 事 ， 效 法 他 父 乌 西 雅 一 切 所 行 的 ， 只 是 不 入 耶 和 华 的 殿 。 百 姓 还 行 邪 僻 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11759', '14', '27', '3', '约 坦 建 立 耶 和 华 殿 的 上 门 ， 在 俄 斐 勒 城 上 多 有 建 造 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11760', '14', '27', '4', '又 在 犹 大 山 地 建 造 城 邑 ， 在 树 林 中 建 筑 营 寨 和 高 楼 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11761', '14', '27', '5', '约 坦 与 亚 扪 人 的 王 打 仗 胜 了 他 们 ， 当 年 他 们 进 贡 银 一 百 他 连 得 ， 小 麦 一 万 歌 珥 ， 大 麦 一 万 歌 珥 ； 第 二 年 、 第 三 年 也 是 这 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11762', '14', '27', '6', '约 坦 在 耶 和 华 ─ 他 　 神 面 前 行 正 道 ， 以 致 日 渐 强 盛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11763', '14', '27', '7', '约 坦 其 馀 的 事 和 一 切 争 战 ， 并 他 的 行 为 ， 都 写 在 以 色 列 和 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11764', '14', '27', '8', '他 登 基 的 时 候 年 二 十 五 岁 ， 在 耶 路 撒 冷 作 王 十 六 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11765', '14', '27', '9', '约 坦 与 他 列 祖 同 睡 ， 葬 在 大 卫 城 里 。 他 儿 子 亚 哈 斯 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11766', '14', '28', '1', '亚 哈 斯 登 基 的 时 候 年 二 十 岁 ， 在 耶 路 撒 冷 作 王 十 六 年 ； 不 像 他 祖 大 卫 行 耶 和 华 眼 中 看 为 正 的 事 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11767', '14', '28', '2', '却 行 以 色 列 诸 王 的 道 ， 又 铸 造 巴 力 的 像 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11768', '14', '28', '3', '并 且 在 欣 嫩 子 谷 烧 香 ， 用 火 焚 烧 他 的 儿 女 ， 行 耶 和 华 在 以 色 列 人 面 前 所 驱 逐 的 外 邦 人 那 可 憎 的 事 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11769', '14', '28', '4', '并 在 邱 坛 上 、 山 冈 上 、 各 青 翠 树 下 献 祭 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11770', '14', '28', '5', '所 以 ， 耶 和 华 ─ 他 的 　 神 将 他 交 在 亚 兰 王 手 里 。 亚 兰 王 打 败 他 ， 掳 了 他 许 多 的 民 ， 带 到 大 马 色 去 。 　 神 又 将 他 交 在 以 色 列 王 手 里 ， 以 色 列 王 向 他 大 行 杀 戮 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11771', '14', '28', '6', '利 玛 利 的 儿 子 比 加 一 日 杀 了 犹 大 人 十 二 万 ， 都 是 勇 士 ， 因 为 他 们 离 弃 了 耶 和 华 ─ 他 们 列 祖 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11772', '14', '28', '7', '有 一 个 以 法 莲 中 的 勇 士 ， 名 叫 细 基 利 ， 杀 了 王 的 儿 子 玛 西 雅 和 管 理 王 宫 的 押 斯 利 甘 ， 并 宰 相 以 利 加 拿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11773', '14', '28', '8', '以 色 列 人 掳 了 他 们 的 弟 兄 ， 连 妇 人 带 儿 女 共 有 二 十 万 ， 又 掠 了 许 多 的 财 物 ， 带 到 撒 玛 利 亚 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11774', '14', '28', '9', '但 那 里 有 耶 和 华 的 一 个 先 知 ， 名 叫 俄 德 ， 出 来 迎 接 往 撒 玛 利 亚 去 的 军 兵 ， 对 他 们 说 ： 因 为 耶 和 华 ─ 你 们 列 祖 的 　 神 恼 怒 犹 大 人 ， 所 以 将 他 们 交 在 你 们 手 里 ， 你 们 竟 怒 气 冲 天 ， 大 行 杀 戮 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11775', '14', '28', '10', '如 今 你 们 又 有 意 强 逼 犹 大 人 和 耶 路 撒 冷 人 作 你 们 的 奴 婢 ， 你 们 岂 不 也 有 得 罪 耶 和 华 ─ 你 们 　 神 的 事 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11776', '14', '28', '11', '现 在 你 们 当 听 我 说 ， 要 将 掳 来 的 弟 兄 释 放 回 去 ， 因 为 耶 和 华 向 你 们 已 经 大 发 烈 怒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11777', '14', '28', '12', '於 是 ， 以 法 莲 人 的 几 个 族 长 ─ 就 是 约 哈 难 的 儿 子 亚 撒 利 雅 、 米 实 利 末 的 儿 子 比 利 家 、 沙 龙 的 儿 子 耶 希 西 家 、 哈 得 莱 的 儿 子 亚 玛 撒 ─ 起 来 拦 挡 出 兵 回 来 的 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11778', '14', '28', '13', '对 他 们 说 ： 你 们 不 可 带 进 这 被 掳 的 人 来 ！ 你 们 想 要 使 我 们 得 罪 耶 和 华 ， 加 增 我 们 的 罪 恶 过 犯 ？ 因 为 我 们 的 罪 过 甚 大 ， 已 经 有 烈 怒 临 到 以 色 列 人 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11779', '14', '28', '14', '於 是 带 兵 器 的 人 将 掳 来 的 人 口 和 掠 来 的 财 物 都 留 在 众 首 领 和 会 众 的 面 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11780', '14', '28', '15', '以 上 提 名 的 那 些 人 就 站 起 ， 使 被 掳 的 人 前 来 ； 其 中 有 赤 身 的 ， 就 从 所 掠 的 财 物 中 拿 出 衣 服 和 鞋 来 ， 给 他 们 穿 ， 又 给 他 们 吃 喝 ， 用 膏 抹 他 们 ； 其 中 有 软 弱 的 ， 就 使 他 们 骑 驴 ， 送 到 棕 树 城 耶 利 哥 他 们 弟 兄 那 里 ； 随 後 就 回 撒 玛 利 亚 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11781', '14', '28', '16', '那 时 ， 亚 哈 斯 王 差 遣 人 去 见 亚 述 诸 王 ， 求 他 们 帮 助 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11782', '14', '28', '17', '因 为 以 东 人 又 来 攻 击 犹 大 ， 掳 掠 子 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11783', '14', '28', '18', '非 利 士 人 也 来 侵 占 高 原 和 犹 大 南 方 的 城 邑 ， 取 了 伯 示 麦 、 亚 雅 仑 、 基 低 罗 ， 梭 哥 和 属 梭 哥 的 乡 村 ， 亭 纳 和 属 亭 纳 的 乡 村 ， 瑾 锁 和 属 瑾 锁 的 乡 村 ， 就 住 在 那 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11784', '14', '28', '19', '因 为 以 色 列 王 亚 哈 斯 在 犹 大 放 肆 ， 大 大 干 犯 耶 和 华 ， 所 以 耶 和 华 使 犹 大 卑 微 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11785', '14', '28', '20', '亚 述 王 提 革 拉 毗 尼 色 上 来 ， 却 没 有 帮 助 他 ， 反 倒 欺 凌 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11786', '14', '28', '21', '亚 哈 斯 从 耶 和 华 殿 里 和 王 宫 中 ， 并 首 领 家 内 所 取 的 财 宝 给 了 亚 述 王 ， 这 也 无 济 於 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11787', '14', '28', '22', '这 亚 哈 斯 王 在 急 难 的 时 候 ， 越 发 得 罪 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11788', '14', '28', '23', '他 祭 祀 攻 击 他 的 大 马 色 之 　 神 ， 说 ： 因 为 亚 兰 王 的 　 神 帮 助 他 们 ， 我 也 献 祭 与 他 ， 他 好 帮 助 我 。 但 那 些 　 神 使 他 和 以 色 列 众 人 败 亡 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11789', '14', '28', '24', '亚 哈 斯 将 　 神 殿 里 的 器 皿 都 聚 了 来 ， 毁 坏 了 ， 且 封 锁 耶 和 华 殿 的 门 ； 在 耶 路 撒 冷 各 处 的 拐 角 建 筑 祭 坛 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11790', '14', '28', '25', '又 在 犹 大 各 城 建 立 邱 坛 ， 与 别 　 神 烧 香 ， 惹 动 耶 和 华 ─ 他 列 祖 　 神 的 怒 气 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11791', '14', '28', '26', '亚 哈 斯 其 馀 的 事 和 他 的 行 为 ， 自 始 至 终 都 写 在 犹 大 和 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11792', '14', '28', '27', '亚 哈 斯 与 他 列 祖 同 睡 ， 葬 在 耶 路 撒 冷 城 里 ， 没 有 送 入 以 色 列 诸 王 的 坟 墓 中 。 他 儿 子 希 西 家 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11793', '14', '29', '1', '希 西 家 登 基 的 时 候 年 二 十 五 岁 ， 在 耶 路 撒 冷 作 王 二 十 九 年 。 他 母 亲 名 叫 亚 比 雅 ， 是 撒 迦 利 雅 的 女 儿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11794', '14', '29', '2', '希 西 家 行 耶 和 华 眼 中 看 为 正 的 事 ， 效 法 他 祖 大 卫 一 切 所 行 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11795', '14', '29', '3', '元 年 正 月 ， 开 了 耶 和 华 殿 的 门 ， 重 新 修 理 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11796', '14', '29', '4', '他 召 众 祭 司 和 利 未 人 来 ， 聚 集 在 东 边 的 宽 阔 处 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11797', '14', '29', '5', '对 他 们 说 ： 利 未 人 哪 ， 当 听 我 说 ： 现 在 你 们 要 洁 净 自 己 ， 又 洁 净 耶 和 华 ─ 你 们 列 祖 　 神 的 殿 ， 从 圣 所 中 除 去 污 秽 之 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11798', '14', '29', '6', '我 们 列 祖 犯 了 罪 ， 行 耶 和 华 ─ 我 们 　 神 眼 中 看 为 恶 的 事 ， 离 弃 他 ， 转 脸 背 向 他 的 居 所 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11799', '14', '29', '7', '封 锁 廊 门 ， 吹 灭 灯 火 ， 不 在 圣 所 中 向 以 色 列 　 神 烧 香 ， 或 献 燔 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11800', '14', '29', '8', '因 此 ， 耶 和 华 的 忿 怒 临 到 犹 大 和 耶 路 撒 冷 ， 将 其 中 的 人 抛 来 抛 去 ， 令 人 惊 骇 、 嗤 笑 ， 正 如 你 们 亲 眼 所 见 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11801', '14', '29', '9', '所 以 我 们 的 祖 宗 倒 在 刀 下 ， 我 们 的 妻 子 儿 女 也 被 掳 掠 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11802', '14', '29', '10', '现 在 我 心 中 有 意 与 耶 和 华 ─ 以 色 列 的 　 神 立 约 ， 好 使 他 的 烈 怒 转 离 我 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11803', '14', '29', '11', '我 的 众 子 啊 ， 现 在 不 要 懈 怠 ； 因 为 耶 和 华 拣 选 你 们 站 在 他 面 前 事 奉 他 ， 与 他 烧 香 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11804', '14', '29', '12', '於 是 ， 利 未 人 哥 辖 的 子 孙 、 亚 玛 赛 的 儿 子 玛 哈 ， 亚 撒 利 雅 的 儿 子 约 珥 ； 米 拉 利 的 子 孙 、 亚 伯 底 的 儿 子 基 士 ， 耶 哈 利 勒 的 儿 子 亚 撒 利 雅 ； 革 顺 的 子 孙 、 薪 玛 的 儿 子 约 亚 ， 约 亚 的 儿 子 伊 甸 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11805', '14', '29', '13', '以 利 撒 反 的 子 孙 申 利 和 耶 利 ； 亚 萨 的 子 孙 撒 迦 利 雅 和 玛 探 雅 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11806', '14', '29', '14', '希 幔 的 子 孙 耶 歇 和 示 每 ； 耶 杜 顿 的 子 孙 示 玛 雅 和 乌 薛 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11807', '14', '29', '15', '起 来 聚 集 他 们 的 弟 兄 ， 洁 净 自 己 ， 照 着 王 的 吩 咐 、 耶 和 华 的 命 令 ， 进 去 洁 净 耶 和 华 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11808', '14', '29', '16', '祭 司 进 入 耶 和 华 的 殿 要 洁 净 殿 ， 将 殿 中 所 有 污 秽 之 物 搬 到 耶 和 华 殿 的 院 内 ， 利 未 人 接 去 ， 搬 到 外 头 汲 沦 溪 边 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11809', '14', '29', '17', '从 正 月 初 一 日 洁 净 起 ， 初 八 日 到 了 耶 和 华 的 殿 廊 ， 用 八 日 的 工 夫 洁 净 耶 和 华 的 殿 ， 到 正 月 十 六 日 才 洁 净 完 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11810', '14', '29', '18', '於 是 ， 他 们 晋 见 希 西 家 王 ， 说 ： 我 们 已 将 耶 和 华 的 全 殿 和 燔 祭 坛 ， 并 坛 的 一 切 器 皿 、 陈 设 饼 的 桌 子 ， 与 桌 子 的 一 切 器 皿 都 洁 净 了 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11811', '14', '29', '19', '并 且 亚 哈 斯 王 在 位 犯 罪 的 时 候 所 废 弃 的 器 皿 ， 我 们 预 备 齐 全 ， 且 洁 净 了 ， 现 今 都 在 耶 和 华 的 坛 前 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11812', '14', '29', '20', '希 西 家 王 清 早 起 来 ， 聚 集 城 里 的 首 领 都 上 耶 和 华 的 殿 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11813', '14', '29', '21', '牵 了 七 只 公 牛 ， 七 只 公 羊 ， 七 只 羊 羔 ， 七 只 公 山 羊 ， 要 为 国 、 为 殿 、 为 犹 大 人 作 赎 罪 祭 。 王 吩 咐 亚 伦 的 子 孙 众 祭 司 ， 献 在 耶 和 华 的 坛 上 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11814', '14', '29', '22', '就 宰 了 公 牛 ， 祭 司 接 血 ? 在 坛 上 ， 宰 了 公 羊 ， 把 血 ? 在 坛 上 ， 又 宰 了 羊 羔 ， 也 把 血 ? 在 坛 上 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11815', '14', '29', '23', '把 那 作 赎 罪 祭 的 公 山 羊 牵 到 王 和 会 众 面 前 ， 他 们 就 按 手 在 其 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11816', '14', '29', '24', '祭 司 宰 了 羊 ， 将 血 献 在 坛 上 作 赎 罪 祭 ， 为 以 色 列 众 人 赎 罪 ， 因 为 王 吩 咐 将 燔 祭 和 赎 罪 祭 为 以 色 列 众 人 献 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11817', '14', '29', '25', '王 又 派 利 未 人 在 耶 和 华 殿 中 敲 钹 ， 鼓 瑟 ， 弹 琴 ， 乃 照 大 卫 和 他 先 见 迦 得 ， 并 先 知 拿 单 所 吩 咐 的 ， 就 是 耶 和 华 藉 先 知 所 吩 咐 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11818', '14', '29', '26', '利 未 人 拿 大 卫 的 乐 器 ， 祭 司 拿 号 ， 一 同 站 立 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11819', '14', '29', '27', '希 西 家 吩 咐 在 坛 上 献 燔 祭 ， 燔 祭 一 献 ， 就 唱 赞 美 耶 和 华 的 歌 ， 用 号 ， 并 用 以 色 列 王 大 卫 的 乐 器 相 和 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11820', '14', '29', '28', '会 众 都 敬 拜 ， 歌 唱 的 歌 唱 ， 吹 号 的 吹 号 ， 如 此 直 到 燔 祭 献 完 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11821', '14', '29', '29', '献 完 了 祭 ， 王 和 一 切 跟 随 的 人 都 俯 伏 敬 拜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11822', '14', '29', '30', '希 西 家 王 与 众 首 领 又 吩 咐 利 未 人 用 大 卫 和 先 见 亚 萨 的 诗 词 颂 赞 耶 和 华 ； 他 们 就 欢 欢 喜 喜 地 颂 赞 耶 和 华 ， 低 头 敬 拜 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11823', '14', '29', '31', '希 西 家 说 ： 你 们 既 然 归 耶 和 华 为 圣 ， 就 要 前 来 把 祭 物 和 感 谢 祭 奉 到 耶 和 华 殿 里 。 会 众 就 把 祭 物 和 感 谢 祭 奉 来 ， 凡 甘 心 乐 意 的 也 将 燔 祭 奉 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11824', '14', '29', '32', '会 众 所 奉 的 燔 祭 如 下 ： 公 牛 七 十 只 ， 公 羊 一 百 只 ， 羊 羔 二 百 只 ， 这 都 是 作 燔 祭 献 给 耶 和 华 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11825', '14', '29', '33', '又 有 分 别 为 圣 之 物 ， 公 牛 六 百 只 ， 绵 羊 三 千 只 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11826', '14', '29', '34', '但 祭 司 太 少 ， 不 能 剥 尽 燔 祭 牲 的 皮 ， 所 以 他 们 的 弟 兄 利 未 人 帮 助 他 们 ， 直 等 燔 祭 的 事 完 了 ， 又 等 别 的 祭 司 自 洁 了 ； 因 为 利 未 人 诚 心 自 洁 ， 胜 过 祭 司 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11827', '14', '29', '35', '燔 祭 和 平 安 祭 牲 的 脂 油 ， 并 燔 祭 同 献 的 奠 祭 甚 多 。 这 样 ， 耶 和 华 殿 中 的 事 务 俱 都 齐 备 了 ( 或 作 就 整 顿 了 ) 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11828', '14', '29', '36', '这 事 办 的 甚 速 ， 希 西 家 和 众 民 都 喜 乐 ， 是 因 　 神 为 众 民 所 预 备 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11829', '14', '30', '1', '希 西 家 差 遣 人 去 见 以 色 列 和 犹 大 众 人 ， 又 写 信 给 以 法 莲 和 玛 拿 西 人 ， 叫 他 们 到 耶 路 撒 冷 耶 和 华 的 殿 ， 向 耶 和 华 ─ 以 色 列 的 　 神 守 逾 越 节 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11830', '14', '30', '2', '因 为 王 和 众 首 领 ， 并 耶 路 撒 冷 全 会 众 已 经 商 议 ， 要 在 二 月 内 守 逾 越 节 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11831', '14', '30', '3', '正 月 ( 原 文 作 那 时 ) 间 他 们 不 能 守 ； 因 为 自 洁 的 祭 司 尚 不 敷 用 ， 百 姓 也 没 有 聚 集 在 耶 路 撒 冷 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11832', '14', '30', '4', '王 与 全 会 众 都 以 这 事 为 善 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11833', '14', '30', '5', '於 是 定 了 命 令 ， 传 遍 以 色 列 ， 从 别 是 巴 直 到 但 ， 使 他 们 都 来 ， 在 耶 路 撒 冷 向 耶 和 华 ─ 以 色 列 的 　 神 守 逾 越 节 ； 因 为 照 所 写 的 例 ， 守 这 节 的 不 多 了 ( 或 作 因 为 民 许 久 没 有 照 所 写 的 例 守 节 了 ) 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11834', '14', '30', '6', '驿 卒 就 把 王 和 众 首 领 的 信 ， 遵 着 王 命 传 遍 以 色 列 和 犹 大 。 信 内 说 ： 以 色 列 人 哪 ， 你 们 当 转 向 耶 和 华 ─ 亚 伯 拉 罕 、 以 撒 、 以 色 列 的 　 神 ， 好 叫 他 转 向 你 们 这 脱 离 亚 述 王 手 的 馀 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11835', '14', '30', '7', '你 们 不 要 效 法 你 们 列 祖 和 你 们 的 弟 兄 ； 他 们 干 犯 耶 和 华 ─ 他 们 列 祖 的 　 神 ， 以 致 耶 和 华 丢 弃 他 们 ， 使 他 们 败 亡 ( 或 作 令 人 惊 骇 ) ， 正 如 你 们 所 见 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11836', '14', '30', '8', '现 在 不 要 像 你 们 列 祖 硬 着 颈 项 ， 只 要 归 顺 耶 和 华 ， 进 入 他 的 圣 所 ， 就 是 永 远 成 圣 的 居 所 ； 又 要 事 奉 耶 和 华 ─ 你 们 的 　 神 ， 好 使 他 的 烈 怒 转 离 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11837', '14', '30', '9', '你 们 若 转 向 耶 和 华 ， 你 们 的 弟 兄 和 儿 女 必 在 掳 掠 他 们 的 人 面 前 蒙 怜 恤 ， 得 以 归 回 这 地 ， 因 为 耶 和 华 ─ 你 们 的 　 神 有 恩 典 、 施 怜 悯 。 你 们 若 转 向 他 ， 他 必 不 转 脸 不 顾 你 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11838', '14', '30', '10', '驿 卒 就 由 这 城 跑 到 那 城 ， 传 遍 了 以 法 莲 、 玛 拿 西 ， 直 到 西 布 伦 。 那 里 的 人 却 戏 笑 他 们 ， 讥 诮 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11839', '14', '30', '11', '然 而 亚 设 、 玛 拿 西 、 西 布 伦 中 也 有 人 自 卑 ， 来 到 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11840', '14', '30', '12', '　 神 也 感 动 犹 大 人 ， 使 他 们 一 心 遵 行 王 与 众 首 领 凭 耶 和 华 之 言 所 发 的 命 令 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11841', '14', '30', '13', '二 月 ， 有 许 多 人 在 耶 路 撒 冷 聚 集 ， 成 为 大 会 ， 要 守 除 酵 节 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11842', '14', '30', '14', '他 们 起 来 ， 把 耶 路 撒 冷 的 祭 坛 和 烧 香 的 坛 尽 都 除 去 ， 抛 在 汲 沦 溪 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11843', '14', '30', '15', '二 月 十 四 日 ， 宰 了 逾 越 节 的 羊 羔 。 祭 司 与 利 未 人 觉 得 惭 愧 ， 就 洁 净 自 己 ， 把 燔 祭 奉 到 耶 和 华 殿 中 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11844', '14', '30', '16', '遵 着 　 神 人 摩 西 的 律 法 ， 照 例 站 在 自 己 的 地 方 ； 祭 司 从 利 未 人 手 里 接 过 血 来 ， ? 在 坛 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11845', '14', '30', '17', '会 中 有 许 多 人 尚 未 自 洁 ， 所 以 利 未 人 为 一 切 不 洁 之 人 宰 逾 越 节 的 羊 羔 ， 使 他 们 在 耶 和 华 面 前 成 为 圣 洁 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11846', '14', '30', '18', '以 法 莲 、 玛 拿 西 、 以 萨 迦 、 西 布 伦 有 许 多 人 尚 未 自 洁 ， 他 们 却 也 吃 逾 越 节 的 羔 羊 ， 不 合 所 记 录 的 定 例 。 希 西 家 为 他 们 祷 告 说 ： 凡 专 心 寻 求 　 神 ， 就 是 耶 和 华 ─ 他 列 祖 之 　 神 的 ， 虽 不 照 着 圣 所 洁 净 之 礼 自 洁 ， 求 至 善 的 耶 和 华 也 饶 恕 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11847', '14', '30', '19', 'a');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11848', '14', '30', '20', '耶 和 华 垂 听 希 西 家 的 祷 告 ， 就 饶 恕 ( 原 文 作 医 治 ) 百 姓 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11849', '14', '30', '21', '在 耶 路 撒 冷 的 以 色 列 人 大 大 喜 乐 ， 守 除 酵 节 七 日 。 利 未 人 和 祭 司 用 响 亮 的 乐 器 ， 日 日 颂 赞 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11850', '14', '30', '22', '希 西 家 慰 劳 一 切 善 於 事 奉 耶 和 华 的 利 未 人 。 於 是 众 人 吃 节 筵 七 日 ， 又 献 平 安 祭 ， 且 向 耶 和 华 ─ 他 们 列 祖 的 　 神 认 罪 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11851', '14', '30', '23', '全 会 众 商 议 ， 要 再 守 节 七 日 ； 於 是 欢 欢 喜 喜 地 又 守 节 七 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11852', '14', '30', '24', '犹 大 王 希 西 家 赐 给 会 众 公 牛 一 千 只 ， 羊 七 千 只 为 祭 物 ； 众 首 领 也 赐 给 会 众 公 牛 一 千 只 ， 羊 一 万 只 ， 并 有 许 多 的 祭 司 洁 净 自 己 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11853', '14', '30', '25', '犹 大 全 会 众 、 祭 司 、 利 未 人 ， 并 那 从 以 色 列 地 来 的 会 众 和 寄 居 的 人 ， 以 及 犹 大 寄 居 的 人 ， 尽 都 喜 乐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11854', '14', '30', '26', '这 样 ， 在 耶 路 撒 冷 大 有 喜 乐 ， 自 从 以 色 列 王 大 卫 儿 子 所 罗 门 的 时 候 ， 在 耶 路 撒 冷 没 有 这 样 的 喜 乐 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11855', '14', '30', '27', '那 时 ， 祭 司 、 利 未 人 起 来 ， 为 民 祝 福 。 他 们 的 声 音 蒙 　 神 垂 听 ， 他 们 的 祷 告 达 到 天 上 的 圣 所 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11856', '14', '31', '1', '这 事 既 都 完 毕 ， 在 那 里 的 以 色 列 众 人 就 到 犹 大 的 城 邑 ， 打 碎 柱 像 ， 砍 断 木 偶 ， 又 在 犹 大 、 便 雅 悯 、 以 法 莲 、 玛 拿 西 遍 地 将 邱 坛 和 祭 坛 拆 毁 净 尽 。 於 是 以 色 列 众 人 各 回 各 城 ， 各 归 各 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11857', '14', '31', '2', '希 西 家 派 定 祭 司 利 未 人 的 班 次 ， 各 按 各 职 献 燔 祭 和 平 安 祭 ， 又 在 耶 和 华 殿 ( 原 文 作 营 ) 门 内 事 奉 ， 称 谢 颂 赞 耶 和 华 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11858', '14', '31', '3', '王 又 从 自 己 的 产 业 中 定 出 分 来 为 燔 祭 ， 就 是 早 晚 的 燔 祭 和 安 息 日 、 月 朔 ， 并 节 期 的 燔 祭 ， 都 是 按 耶 和 华 律 法 上 所 载 的 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11859', '14', '31', '4', '又 吩 咐 住 耶 路 撒 冷 的 百 姓 将 祭 司 、 利 未 人 所 应 得 的 分 给 他 们 ， 使 他 们 专 心 遵 守 耶 和 华 的 律 法 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11860', '14', '31', '5', '谕 旨 一 出 ， 以 色 列 人 就 把 初 熟 的 五 谷 、 新 酒 、 油 、 蜜 ， 和 田 地 的 出 产 多 多 送 来 ， 又 把 各 物 的 十 分 之 一 送 来 的 极 多 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11861', '14', '31', '6', '住 犹 大 各 城 的 以 色 列 人 和 犹 大 人 也 将 牛 羊 的 十 分 之 一 ， 并 分 别 为 圣 归 耶 和 华 ─ 他 们 　 神 之 物 ， 就 是 十 分 取 一 之 物 ， 尽 都 送 来 ， 积 成 堆 垒 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11862', '14', '31', '7', '从 三 月 积 起 ， 到 七 月 才 完 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11863', '14', '31', '8', '希 西 家 和 众 首 领 来 ， 看 见 堆 垒 ， 就 称 颂 耶 和 华 ， 又 为 耶 和 华 的 民 以 色 列 人 祝 福 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11864', '14', '31', '9', '希 西 家 向 祭 司 、 利 未 人 查 问 这 堆 垒 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11865', '14', '31', '10', '撒 督 家 的 大 祭 司 亚 撒 利 雅 回 答 说 ： 自 从 民 将 供 物 送 到 耶 和 华 殿 以 来 ， 我 们 不 但 吃 饱 ， 且 剩 下 的 甚 多 ； 因 为 耶 和 华 赐 福 给 他 的 民 ， 所 剩 下 的 才 这 样 丰 盛 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11866', '14', '31', '11', '希 西 家 吩 咐 在 耶 和 华 殿 里 预 备 仓 房 ， 他 们 就 预 备 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11867', '14', '31', '12', '他 们 诚 心 将 供 物 和 十 分 取 一 之 物 ， 并 分 别 为 圣 之 物 ， 都 搬 入 仓 内 。 利 未 人 歌 楠 雅 掌 管 这 事 ， 他 兄 弟 示 每 为 副 管 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11868', '14', '31', '13', '耶 歇 、 亚 撒 细 雅 、 拿 哈 、 亚 撒 黑 、 耶 利 末 、 约 撒 拔 、 以 列 、 伊 斯 玛 基 雅 、 玛 哈 、 比 拿 雅 都 是 督 理 ， 在 歌 楠 雅 和 他 兄 弟 示 每 的 手 下 ， 是 希 西 家 王 和 管 理 　 神 殿 的 亚 撒 利 雅 所 派 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11869', '14', '31', '14', '守 东 门 的 利 未 人 音 拿 的 儿 子 可 利 ， 掌 管 乐 意 献 与 　 神 的 礼 物 ， 发 放 献 与 耶 和 华 的 供 物 和 至 圣 的 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11870', '14', '31', '15', '在 他 手 下 有 伊 甸 、 岷 雅 岷 、 耶 书 亚 、 示 玛 雅 、 亚 玛 利 雅 、 示 迦 尼 雅 ， 在 祭 司 的 各 城 里 供 紧 要 的 职 任 ， 无 论 弟 兄 大 小 ， 都 按 着 班 次 分 给 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11871', '14', '31', '16', '按 家 谱 ， 三 岁 以 外 的 男 丁 ， 凡 每 日 进 耶 和 华 殿 、 按 班 次 供 职 的 ， 也 分 给 他 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11872', '14', '31', '17', '又 按 宗 族 家 谱 分 给 祭 司 ， 按 班 次 职 任 分 给 二 十 岁 以 外 的 利 未 人 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11873', '14', '31', '18', '又 按 家 谱 计 算 ， 分 给 他 们 会 中 的 妻 子 、 儿 女 ； 因 他 们 身 供 要 职 ， 自 洁 成 圣 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11874', '14', '31', '19', '按 名 派 定 的 人 要 把 应 得 的 分 给 亚 伦 子 孙 ， 住 在 各 城 郊 野 、 祭 司 所 有 的 男 丁 和 一 切 载 入 家 谱 的 利 未 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11875', '14', '31', '20', '希 西 家 在 犹 大 遍 地 这 样 办 理 ， 行 耶 和 华 ─ 他 　 神 眼 中 看 为 善 为 正 为 忠 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11876', '14', '31', '21', '凡 他 所 行 的 ， 无 论 是 办 　 神 殿 的 事 ， 是 遵 律 法 守 诫 命 ， 是 寻 求 他 的 　 神 ， 都 是 尽 心 去 行 ， 无 不 亨 通 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11877', '14', '32', '1', '这 虔 诚 的 事 以 後 ， 亚 述 王 西 拿 基 立 来 侵 入 犹 大 ， 围 困 一 切 坚 固 城 ， 想 要 攻 破 占 据 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11878', '14', '32', '2', '希 西 家 见 西 拿 基 立 来 ， 定 意 要 攻 打 耶 路 撒 冷 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11879', '14', '32', '3', '就 与 首 领 和 勇 士 商 议 ， 塞 住 城 外 的 泉 源 ； 他 们 就 都 帮 助 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11880', '14', '32', '4', '於 是 有 许 多 人 聚 集 ， 塞 了 一 切 泉 源 ， 并 通 流 国 中 的 小 河 ， 说 ： 亚 述 王 来 ， 为 何 让 他 得 着 许 多 水 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11881', '14', '32', '5', '希 西 家 力 图 自 强 ， 就 修 筑 所 有 拆 毁 的 城 墙 ， 高 与 城 楼 相 齐 ； 在 城 外 又 筑 一 城 ， 坚 固 大 卫 城 的 米 罗 ， 制 造 了 许 多 军 器 、 盾 牌 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11882', '14', '32', '6', '设 立 军 长 管 理 百 姓 ， 将 他 们 招 聚 在 城 门 的 宽 阔 处 ， 用 话 勉 励 他 们 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11883', '14', '32', '7', '你 们 当 刚 强 壮 胆 ， 不 要 因 亚 述 王 和 跟 随 他 的 大 军 恐 惧 、 惊 慌 ； 因 为 与 我 们 同 在 的 ， 比 与 他 们 同 在 的 更 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11884', '14', '32', '8', '与 他 们 同 在 的 是 肉 臂 ， 与 我 们 同 在 的 是 耶 和 华 ─ 我 们 的 　 神 ， 他 必 帮 助 我 们 ， 为 我 们 争 战 。 百 姓 就 靠 犹 大 王 希 西 家 的 话 ， 安 然 无 惧 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11885', '14', '32', '9', '此 後 ， 亚 述 王 西 拿 基 立 和 他 的 全 军 攻 打 拉 吉 ， 就 差 遣 臣 仆 到 耶 路 撒 冷 见 犹 大 王 希 西 家 和 一 切 在 耶 路 撒 冷 的 犹 大 人 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11886', '14', '32', '10', '亚 述 王 西 拿 基 立 如 此 说 ： 你 们 倚 靠 甚 麽 ， 还 在 耶 路 撒 冷 受 困 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11887', '14', '32', '11', '希 西 家 对 你 们 说 耶 和 华 ─ 我 们 的 　 神 必 救 我 们 脱 离 亚 述 王 的 手 ， 这 不 是 诱 惑 你 们 ， 使 你 们 受 饥 渴 而 死 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11888', '14', '32', '12', '这 希 西 家 岂 不 是 废 去 耶 和 华 的 邱 坛 和 祭 坛 ， 吩 咐 犹 大 与 耶 路 撒 冷 的 人 说 你 们 当 在 一 个 坛 前 敬 拜 ， 在 其 上 烧 香 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11889', '14', '32', '13', '我 与 我 列 祖 向 列 邦 所 行 的 ， 你 们 岂 不 知 道 麽 ？ 列 邦 的 　 神 何 尝 能 救 自 己 的 国 脱 离 我 手 呢 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11890', '14', '32', '14', '我 列 祖 所 灭 的 国 ， 那 些 　 神 中 谁 能 救 自 己 的 民 脱 离 我 手 呢 ？ 难 道 你 们 的 　 神 能 救 你 们 脱 离 我 手 麽 ？');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11891', '14', '32', '15', '所 以 你 们 不 要 叫 希 西 家 这 样 欺 哄 诱 惑 你 们 ， 也 不 要 信 他 ； 因 为 没 有 一 国 一 邦 的 　 神 能 救 自 己 的 民 脱 离 我 手 和 我 列 祖 的 手 ， 何 况 你 们 的 　 神 更 不 能 救 你 们 脱 离 我 的 手 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11892', '14', '32', '16', '西 拿 基 立 的 臣 仆 还 有 别 的 话 毁 谤 耶 和 华 　 神 和 他 仆 人 希 西 家 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11893', '14', '32', '17', '西 拿 基 立 也 写 信 毁 谤 耶 和 华 ─ 以 色 列 的 　 神 说 ： 列 邦 的 　 神 既 不 能 救 他 的 民 脱 离 我 手 ， 希 西 家 的 　 神 也 不 能 救 他 的 民 脱 离 我 手 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11894', '14', '32', '18', '亚 述 王 的 臣 仆 用 犹 大 言 语 向 耶 路 撒 冷 城 上 的 民 大 声 呼 叫 ， 要 惊 吓 他 们 ， 扰 乱 他 们 ， 以 便 取 城 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11895', '14', '32', '19', '他 们 论 耶 路 撒 冷 的 　 神 ， 如 同 论 世 上 人 手 所 造 的 　 神 一 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11896', '14', '32', '20', '希 西 家 王 和 亚 摩 斯 的 儿 子 先 知 以 赛 亚 因 此 祷 告 ， 向 天 呼 求 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11897', '14', '32', '21', '耶 和 华 就 差 遣 一 个 使 者 进 入 亚 述 王 营 中 ， 把 所 有 大 能 的 勇 士 和 官 长 、 将 帅 尽 都 灭 了 。 亚 述 王 满 面 含 羞 地 回 到 本 国 ， 进 了 他 　 神 的 庙 中 ， 有 他 亲 生 的 儿 子 在 那 里 用 刀 杀 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11898', '14', '32', '22', '这 样 ， 耶 和 华 救 希 西 家 和 耶 路 撒 冷 的 居 民 脱 离 亚 述 王 西 拿 基 立 的 手 ， 也 脱 离 一 切 仇 敌 的 手 ， 又 赐 他 们 四 境 平 安 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11899', '14', '32', '23', '有 许 多 人 到 耶 路 撒 冷 ， 将 供 物 献 与 耶 和 华 ， 又 将 宝 物 送 给 犹 大 王 希 西 家 。 此 後 ， 希 西 家 在 列 邦 人 的 眼 中 看 为 尊 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11900', '14', '32', '24', '那 时 希 西 家 病 得 要 死 ， 就 祷 告 耶 和 华 ， 耶 和 华 应 允 他 ， 赐 他 一 个 兆 头 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11901', '14', '32', '25', '希 西 家 却 没 有 照 他 所 蒙 的 恩 报 答 耶 和 华 ； 因 他 心 里 骄 傲 ， 所 以 忿 怒 要 临 到 他 和 犹 大 并 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11902', '14', '32', '26', '但 希 西 家 和 耶 路 撒 冷 的 居 民 觉 得 心 里 骄 傲 ， 就 一 同 自 卑 ， 以 致 耶 和 华 的 忿 怒 在 希 西 家 的 日 子 没 有 临 到 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11903', '14', '32', '27', '希 西 家 大 有 尊 荣 资 财 ， 建 造 府 库 ， 收 藏 金 银 、 宝 石 、 香 料 、 盾 牌 ， 和 各 样 的 宝 器 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11904', '14', '32', '28', '又 建 造 仓 房 ， 收 藏 五 谷 、 新 酒 ， 和 油 ， 又 为 各 类 牲 畜 盖 棚 立 圈 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11905', '14', '32', '29', '并 且 建 立 城 邑 ， 还 有 许 多 的 羊 群 牛 群 ， 因 为 　 神 赐 他 极 多 的 财 产 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11906', '14', '32', '30', '这 希 西 家 也 塞 住 基 训 的 上 源 ， 引 水 直 下 ， 流 在 大 卫 城 的 西 边 。 希 西 家 所 行 的 事 尽 都 亨 通 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11907', '14', '32', '31', '惟 有 一 件 事 ， 就 是 巴 比 伦 王 差 遣 使 者 来 见 希 西 家 ， 访 问 国 中 所 现 的 奇 事 ； 这 件 事 　 神 离 开 他 ， 要 试 验 他 ， 好 知 道 他 心 内 如 何 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11908', '14', '32', '32', '希 西 家 其 馀 的 事 和 他 的 善 行 都 写 在 亚 摩 斯 的 儿 子 先 知 以 赛 亚 的 默 示 书 上 和 犹 大 、 以 色 列 的 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11909', '14', '32', '33', '希 西 家 与 他 列 祖 同 睡 ， 葬 在 大 卫 子 孙 的 高 陵 上 。 他 死 的 时 候 ， 犹 大 人 和 耶 路 撒 冷 的 居 民 都 尊 敬 他 。 他 儿 子 玛 拿 西 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11910', '14', '33', '1', '玛 拿 西 登 基 的 时 候 年 十 二 岁 ， 在 耶 路 撒 冷 作 王 五 十 五 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11911', '14', '33', '2', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 效 法 耶 和 华 在 以 色 列 人 面 前 赶 出 的 外 邦 人 那 可 憎 的 事 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11912', '14', '33', '3', '重 新 建 筑 他 父 希 西 家 所 拆 毁 的 邱 坛 ， 又 为 巴 力 筑 坛 ， 做 木 偶 ， 且 敬 拜 事 奉 天 上 的 万 象 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11913', '14', '33', '4', '在 耶 和 华 的 殿 宇 中 筑 坛 ─ 耶 和 华 曾 指 着 这 殿 说 ： 我 的 名 必 永 远 在 耶 路 撒 冷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11914', '14', '33', '5', '他 在 耶 和 华 殿 的 两 院 中 为 天 上 的 万 象 筑 坛 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11915', '14', '33', '6', '并 在 欣 嫩 子 谷 使 他 的 儿 女 经 火 ， 又 观 兆 ， 用 法 术 ， 行 邪 术 ， 立 交 鬼 的 和 行 巫 术 的 ， 多 行 耶 和 华 眼 中 看 为 恶 的 事 ， 惹 动 他 的 怒 气 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11916', '14', '33', '7', '又 在 　 神 殿 内 立 雕 刻 的 偶 像 。 　 神 曾 对 大 卫 和 他 儿 子 所 罗 门 说 ： 我 在 以 色 列 各 支 派 中 所 选 择 的 耶 路 撒 冷 和 这 殿 ， 必 立 我 的 名 直 到 永 远 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11917', '14', '33', '8', '以 色 列 人 若 谨 守 遵 行 我 藉 摩 西 所 吩 咐 他 们 的 一 切 法 度 、 律 例 、 典 章 ， 我 就 不 再 使 他 们 挪 移 离 开 我 所 赐 给 他 们 列 祖 之 地 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11918', '14', '33', '9', '玛 拿 西 引 诱 犹 大 和 耶 路 撒 冷 的 居 民 ， 以 致 他 们 行 恶 比 耶 和 华 在 以 色 列 人 面 前 所 灭 的 列 国 更 甚 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11919', '14', '33', '10', '耶 和 华 警 戒 玛 拿 西 和 他 的 百 姓 ， 他 们 却 是 不 听 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11920', '14', '33', '11', '所 以 耶 和 华 使 亚 述 王 的 将 帅 来 攻 击 他 们 ， 用 铙 钩 钩 住 玛 拿 西 ， 用 铜 炼 锁 住 他 ， 带 到 巴 比 伦 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11921', '14', '33', '12', '他 在 急 难 的 时 候 ， 就 恳 求 耶 和 华 ─ 他 的 　 神 ， 且 在 他 列 祖 的 　 神 面 前 极 其 自 卑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11922', '14', '33', '13', '他 祈 祷 耶 和 华 ， 耶 和 华 就 允 准 他 的 祈 求 ， 垂 听 他 的 祷 告 ， 使 他 归 回 耶 路 撒 冷 ， 仍 坐 国 位 。 玛 拿 西 这 才 知 道 惟 独 耶 和 华 是 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11923', '14', '33', '14', '此 後 ， 玛 拿 西 在 大 卫 城 外 ， 从 谷 内 基 训 西 边 直 到 鱼 门 口 ， 建 筑 城 墙 ， 环 绕 俄 斐 勒 ， 这 墙 筑 得 甚 高 ； 又 在 犹 大 各 坚 固 城 内 设 立 勇 敢 的 军 长 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11924', '14', '33', '15', '并 除 掉 外 邦 人 的 神 像 与 耶 和 华 殿 中 的 偶 像 ， 又 将 他 在 耶 和 华 殿 的 山 上 和 耶 路 撒 冷 所 筑 的 各 坛 都 拆 毁 抛 在 城 外 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11925', '14', '33', '16', '重 修 耶 和 华 的 祭 坛 ， 在 坛 上 献 平 安 祭 、 感 谢 祭 ， 吩 咐 犹 大 人 事 奉 耶 和 华 ─ 以 色 列 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11926', '14', '33', '17', '百 姓 却 仍 在 邱 坛 上 献 祭 ， 只 献 给 耶 和 华 ─ 他 们 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11927', '14', '33', '18', '玛 拿 西 其 馀 的 事 和 祷 告 他 　 神 的 话 ， 并 先 见 奉 耶 和 华 ─ 以 色 列 　 神 的 名 警 戒 他 的 言 语 ， 都 写 在 以 色 列 诸 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11928', '14', '33', '19', '他 的 祷 告 ， 与 神 怎 样 应 允 他 ， 他 未 自 卑 以 前 的 罪 愆 过 犯 ， 并 在 何 处 建 筑 邱 坛 ， 设 立 亚 舍 拉 和 雕 刻 的 偶 像 ， 都 写 在 何 赛 的 书 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11929', '14', '33', '20', '玛 拿 西 与 他 列 祖 同 睡 ， 葬 在 自 己 的 宫 院 里 。 他 儿 子 亚 们 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11930', '14', '33', '21', '亚 们 登 基 的 时 候 年 二 十 二 岁 ， 在 耶 路 撒 冷 作 王 二 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11931', '14', '33', '22', '他 行 耶 和 华 眼 中 看 为 恶 的 事 ， 效 法 他 父 玛 拿 西 所 行 的 ， 祭 祀 事 奉 他 父 玛 拿 西 所 雕 刻 的 偶 像 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11932', '14', '33', '23', '不 在 耶 和 华 面 前 像 他 父 玛 拿 西 自 卑 。 这 亚 们 所 犯 的 罪 越 犯 越 大 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11933', '14', '33', '24', '他 的 臣 仆 背 叛 ， 在 宫 里 杀 了 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11934', '14', '33', '25', '但 国 民 杀 了 那 些 背 叛 亚 们 王 的 人 ， 立 他 儿 子 约 西 亚 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11935', '14', '34', '1', '约 西 亚 登 基 的 时 候 年 八 岁 ， 在 耶 路 撒 冷 作 王 三 十 一 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11936', '14', '34', '2', '他 行 耶 和 华 眼 中 看 为 正 的 事 ， 效 法 他 祖 大 卫 所 行 的 ， 不 偏 左 右 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11937', '14', '34', '3', '他 作 王 第 八 年 ， 尚 且 年 幼 ， 就 寻 求 他 祖 大 卫 的 　 神 。 到 了 十 二 年 才 洁 净 犹 大 和 耶 路 撒 冷 ， 除 掉 邱 坛 、 木 偶 、 雕 刻 的 像 ， 和 铸 造 的 像 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11938', '14', '34', '4', '众 人 在 他 面 前 拆 毁 巴 力 的 坛 ， 砍 断 坛 上 高 高 的 日 像 ， 又 把 木 偶 和 雕 刻 的 像 ， 并 铸 造 的 像 打 碎 成 灰 ， 撒 在 祭 偶 像 人 的 坟 上 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11939', '14', '34', '5', '将 他 们 祭 司 的 骸 骨 烧 在 坛 上 ， 洁 净 了 犹 大 和 耶 路 撒 冷 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11940', '14', '34', '6', '又 在 玛 拿 西 、 以 法 莲 、 西 缅 、 拿 弗 他 利 各 城 ， 和 四 围 破 坏 之 处 ， 都 这 样 行 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11941', '14', '34', '7', '又 拆 毁 祭 坛 ， 把 木 偶 和 雕 刻 的 像 打 碎 成 灰 ， 砍 断 以 色 列 遍 地 所 有 的 日 像 ， 就 回 耶 路 撒 冷 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11942', '14', '34', '8', '约 西 亚 王 十 八 年 ， 净 地 净 殿 之 後 ， 就 差 遣 亚 萨 利 雅 的 儿 子 沙 番 、 邑 宰 玛 西 雅 、 约 哈 斯 的 儿 子 史 官 约 亚 去 修 理 耶 和 华 ─ 他 　 神 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11943', '14', '34', '9', '他 们 就 去 见 大 祭 司 希 勒 家 ， 将 奉 到 　 神 殿 的 银 子 交 给 他 ； 这 银 子 是 看 守 殿 门 的 利 未 人 从 玛 拿 西 、 以 法 莲 ， 和 一 切 以 色 列 剩 下 的 人 ， 以 及 犹 大 、 便 雅 悯 众 人 ， 并 耶 路 撒 冷 的 居 民 收 来 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11944', '14', '34', '10', '又 将 这 银 子 交 给 耶 和 华 殿 里 督 工 的 ， 转 交 修 理 耶 和 华 殿 的 工 匠 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11945', '14', '34', '11', '就 是 交 给 木 匠 、 石 匠 ， 买 凿 成 的 石 头 和 架 木 与 栋 梁 ， 修 犹 大 王 所 毁 坏 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11946', '14', '34', '12', '这 些 人 办 事 诚 实 ， 督 工 的 是 利 未 人 米 拉 利 的 子 孙 雅 哈 、 俄 巴 底 ； 督 催 的 是 哥 辖 的 子 孙 撒 迦 利 亚 、 米 书 兰 ； 还 有 善 於 作 乐 的 利 未 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11947', '14', '34', '13', '他 们 又 监 管 扛 抬 的 人 ， 督 催 一 切 做 工 的 。 利 未 人 中 也 有 作 书 记 、 作 司 事 、 作 守 门 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11948', '14', '34', '14', '他 们 将 奉 到 耶 和 华 殿 的 银 子 运 出 来 的 时 候 ， 祭 司 希 勒 家 偶 然 得 了 摩 西 所 传 耶 和 华 的 律 法 书 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11949', '14', '34', '15', '希 勒 家 对 书 记 沙 番 说 ： 我 在 耶 和 华 殿 里 得 了 律 法 书 。 遂 将 书 递 给 沙 番 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11950', '14', '34', '16', '沙 番 把 书 拿 到 王 那 里 ， 回 覆 王 说 ： 凡 交 给 仆 人 们 办 的 都 办 理 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11951', '14', '34', '17', '耶 和 华 殿 里 的 银 子 倒 出 来 ， 交 给 督 工 的 和 匠 人 的 手 里 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11952', '14', '34', '18', '书 记 沙 番 又 对 王 说 ： 祭 司 希 勒 家 递 给 我 一 卷 书 。 沙 番 就 在 王 面 前 读 那 书 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11953', '14', '34', '19', '王 听 见 律 法 上 的 话 ， 就 撕 裂 衣 服 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11954', '14', '34', '20', '吩 咐 希 勒 家 与 沙 番 的 儿 子 亚 希 甘 、 米 迦 的 儿 子 亚 比 顿 、 书 记 沙 番 ， 和 王 的 臣 仆 亚 撒 雅 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11955', '14', '34', '21', '你 们 去 为 我 、 为 以 色 列 和 犹 大 剩 下 的 人 ， 以 这 书 上 的 话 求 问 耶 和 华 ； 因 我 们 列 祖 没 有 遵 守 耶 和 华 的 言 语 ， 没 有 照 这 书 上 所 记 的 去 行 ， 耶 和 华 的 烈 怒 就 倒 在 我 们 身 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11956', '14', '34', '22', '於 是 ， 希 勒 家 和 王 所 派 的 众 人 都 去 见 女 先 知 户 勒 大 。 户 勒 大 是 掌 管 礼 服 沙 龙 的 妻 ， 沙 龙 是 哈 斯 拉 的 孙 子 、 特 瓦 的 儿 子 。 户 勒 大 住 在 耶 路 撒 冷 第 二 区 ； 他 们 请 问 於 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11957', '14', '34', '23', '他 对 他 们 说 ： 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 你 们 可 以 回 覆 那 差 遣 你 们 来 见 我 的 人 说 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11958', '14', '34', '24', '耶 和 华 如 此 说 ： 我 必 照 着 在 犹 大 王 面 前 所 读 那 书 上 的 一 切 咒 诅 ， 降 祸 与 这 地 和 其 上 的 居 民 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11959', '14', '34', '25', '因 为 他 们 离 弃 我 ， 向 别 　 神 烧 香 ， 用 他 们 手 所 做 的 惹 我 发 怒 ， 所 以 我 的 忿 怒 如 火 倒 在 这 地 上 ， 总 不 息 灭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11960', '14', '34', '26', '然 而 差 遣 你 们 来 求 问 耶 和 华 的 犹 大 王 ， 你 们 要 这 样 回 覆 他 说 ： 耶 和 华 ─ 以 色 列 的 　 神 如 此 说 ： 至 於 你 所 听 见 的 话 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11961', '14', '34', '27', '就 是 听 见 我 指 着 这 地 和 其 上 居 民 所 说 的 话 ， 你 便 心 里 敬 服 ， 在 我 面 前 自 卑 ， 撕 裂 衣 服 ， 向 我 哭 泣 ， 因 此 我 应 允 了 你 。 这 是 我 ─ 耶 和 华 说 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11962', '14', '34', '28', '我 必 使 你 平 平 安 安 地 归 到 坟 墓 ， 到 你 列 祖 那 里 ， 我 要 降 与 这 地 和 其 上 居 民 的 一 切 灾 祸 ， 你 也 不 至 亲 眼 看 见 。 他 们 就 回 覆 王 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11963', '14', '34', '29', '王 差 遣 人 招 聚 犹 大 和 耶 路 撒 冷 的 众 长 老 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11964', '14', '34', '30', '王 和 犹 大 众 人 ， 与 耶 路 撒 冷 的 居 民 ， 并 祭 司 利 未 人 ， 以 及 所 有 的 百 姓 ， 无 论 大 小 ， 都 一 同 上 到 耶 和 华 的 殿 ； 王 就 把 殿 里 所 得 的 约 书 念 给 他 们 听 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11965', '14', '34', '31', '王 站 在 他 的 地 位 上 ， 在 耶 和 华 面 前 立 约 ， 要 尽 心 尽 性 地 顺 从 耶 和 华 ， 遵 守 他 的 诫 命 、 法 度 、 律 例 ， 成 就 这 书 上 所 记 的 约 言 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11966', '14', '34', '32', '又 使 住 耶 路 撒 冷 和 便 雅 悯 的 人 都 服 从 这 约 。 於 是 耶 路 撒 冷 的 居 民 都 遵 行 他 们 列 祖 之 　 神 的 约 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11967', '14', '34', '33', '约 西 亚 从 以 色 列 各 处 将 一 切 可 憎 之 物 尽 都 除 掉 ， 使 以 色 列 境 内 的 人 都 事 奉 耶 和 华 ─ 他 们 的 　 神 。 约 西 亚 在 世 的 日 子 ， 就 跟 从 耶 和 华 ─ 他 们 列 祖 的 　 神 ， 总 不 离 开 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11968', '14', '35', '1', '约 西 亚 在 耶 路 撒 冷 向 耶 和 华 守 逾 越 节 。 正 月 十 四 日 ， 就 宰 了 逾 越 节 的 羊 羔 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11969', '14', '35', '2', '王 分 派 祭 司 各 尽 其 职 ， 又 勉 励 他 们 办 耶 和 华 殿 中 的 事 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11970', '14', '35', '3', '又 对 那 归 耶 和 华 为 圣 、 教 训 以 色 列 人 的 利 未 人 说 ： 你 们 将 圣 约 柜 安 放 在 以 色 列 王 大 卫 儿 子 所 罗 门 建 造 的 殿 里 ， 不 必 再 用 肩 扛 抬 。 现 在 要 事 奉 耶 和 华 ─ 你 们 的 　 神 ， 服 事 他 的 民 以 色 列 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11971', '14', '35', '4', '你 们 应 当 按 着 宗 族 ， 照 着 班 次 ， 遵 以 色 列 王 大 卫 和 他 儿 子 所 罗 门 所 写 的 ， 自 己 预 备 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11972', '14', '35', '5', '要 按 着 你 们 的 弟 兄 ， 这 民 宗 族 的 班 次 ， 站 在 圣 所 ， 每 班 中 要 利 未 宗 族 的 几 个 人 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11973', '14', '35', '6', '要 宰 逾 越 节 的 羊 羔 ， 洁 净 自 己 ， 为 你 们 的 弟 兄 预 备 了 ， 好 遵 守 耶 和 华 藉 摩 西 所 吩 咐 的 话 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11974', '14', '35', '7', '约 西 亚 从 群 畜 中 赐 给 在 那 里 所 有 的 人 民 ， 绵 羊 羔 和 山 羊 羔 三 万 只 ， 牛 三 千 只 ， 作 逾 越 节 的 祭 物 ； 这 都 是 出 自 王 的 产 业 中 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11975', '14', '35', '8', '约 西 亚 的 众 首 领 也 乐 意 将 牺 牲 给 百 姓 和 祭 司 利 未 人 ； 又 有 管 理 　 神 殿 的 希 勒 家 、 撒 迦 利 亚 、 耶 歇 将 羊 羔 二 千 六 百 只 ， 牛 三 百 只 ， 给 祭 司 作 逾 越 节 的 祭 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11976', '14', '35', '9', '利 未 人 的 族 长 歌 楠 雅 和 他 两 个 兄 弟 示 玛 雅 、 拿 坦 业 ， 与 哈 沙 比 雅 、 耶 利 、 约 撒 拔 将 羊 羔 五 千 只 ， 牛 五 百 只 ， 给 利 未 人 作 逾 越 节 的 祭 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11977', '14', '35', '10', '这 样 ， 供 献 的 事 齐 备 了 。 祭 司 站 在 自 己 的 地 方 ， 利 未 人 按 着 班 次 站 立 ， 都 是 照 王 所 吩 咐 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11978', '14', '35', '11', '利 未 人 宰 了 逾 越 节 的 羊 羔 ， 祭 司 从 他 们 手 里 接 过 血 来 ? 在 坛 上 ； 利 未 人 剥 皮 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11979', '14', '35', '12', '将 燔 祭 搬 来 ， 按 着 宗 族 的 班 次 分 给 众 民 ， 好 照 摩 西 书 上 所 写 的 ， 献 给 耶 和 华 ； 献 牛 也 是 这 样 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11980', '14', '35', '13', '他 们 按 着 常 例 ， 用 火 烤 逾 越 节 的 羊 羔 。 别 的 圣 物 用 锅 ， 用 釜 ， 用 罐 煮 了 ， 速 速 地 送 给 众 民 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11981', '14', '35', '14', '然 後 为 自 己 和 祭 司 预 备 祭 物 ； 因 为 祭 司 亚 伦 的 子 孙 献 燔 祭 和 脂 油 ， 直 到 晚 上 。 所 以 利 未 人 为 自 己 和 祭 司 亚 伦 的 子 孙 ， 预 备 祭 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11982', '14', '35', '15', '歌 唱 的 亚 萨 之 子 孙 ， 照 着 大 卫 、 亚 萨 、 希 幔 ， 和 王 的 先 见 耶 杜 顿 所 吩 咐 的 ， 站 在 自 己 的 地 位 上 。 守 门 的 看 守 各 门 ， 不 用 离 开 他 们 的 职 事 ， 因 为 他 们 的 弟 兄 利 未 人 给 他 们 预 备 祭 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11983', '14', '35', '16', '当 日 ， 供 奉 耶 和 华 的 事 齐 备 了 ， 就 照 约 西 亚 王 的 吩 咐 守 逾 越 节 ， 献 燔 祭 在 耶 和 华 的 坛 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11984', '14', '35', '17', '当 时 在 耶 路 撒 冷 的 以 色 列 人 守 逾 越 节 ， 又 守 除 酵 节 七 日 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11985', '14', '35', '18', '自 从 先 知 撒 母 耳 以 来 ， 在 以 色 列 中 没 有 守 过 这 样 的 逾 越 节 ， 以 色 列 诸 王 也 没 有 守 过 ， 像 约 西 亚 、 祭 司 、 利 未 人 、 在 那 里 的 犹 大 人 ， 和 以 色 列 人 ， 以 及 耶 路 撒 冷 居 民 所 守 的 逾 越 节 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11986', '14', '35', '19', '这 逾 越 节 是 约 西 亚 作 王 十 八 年 守 的 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11987', '14', '35', '20', '这 事 以 後 ， 约 西 亚 修 完 了 殿 ， 有 埃 及 王 尼 哥 上 来 ， 要 攻 击 靠 近 伯 拉 河 的 迦 基 米 施 ； 约 西 亚 出 去 抵 挡 他 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11988', '14', '35', '21', '他 差 遣 使 者 来 见 约 西 亚 ， 说 ： 犹 大 王 啊 ， 我 与 你 何 干 ？ 我 今 日 来 不 是 要 攻 击 你 ， 乃 是 要 攻 击 与 我 争 战 之 家 ， 并 且 　 神 吩 咐 我 速 行 ， 你 不 要 干 预 　 神 的 事 ， 免 得 他 毁 灭 你 ， 因 为 　 神 是 与 我 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11989', '14', '35', '22', '约 西 亚 却 不 肯 转 去 离 开 他 ， 改 装 要 与 他 打 仗 ， 不 听 从 　 神 藉 尼 哥 之 口 所 说 的 话 ， 便 来 到 米 吉 多 平 原 争 战 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11990', '14', '35', '23', '弓 箭 手 射 中 约 西 亚 王 。 王 对 他 的 臣 仆 说 ： 我 受 了 重 伤 ， 你 拉 我 出 阵 罢 ！');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11991', '14', '35', '24', '他 的 臣 仆 扶 他 下 了 战 车 ， 上 了 次 车 ， 送 他 到 耶 路 撒 冷 ， 他 就 死 了 ， 葬 在 他 列 祖 的 坟 墓 里 。 犹 大 人 和 耶 路 撒 冷 人 都 为 他 悲 哀 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11992', '14', '35', '25', '耶 利 米 为 约 西 亚 作 哀 歌 。 所 有 歌 唱 的 男 女 也 唱 哀 歌 ， 追 悼 约 西 亚 ， 直 到 今 日 ； 而 且 在 以 色 列 中 成 了 定 例 。 这 歌 载 在 哀 歌 书 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11993', '14', '35', '26', '约 西 亚 其 馀 的 事 和 他 遵 着 耶 和 华 律 法 上 所 记 而 行 的 善 事 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11994', '14', '35', '27', '并 他 自 始 至 终 所 行 的 ， 都 写 在 以 色 列 和 犹 大 列 王 记 上 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11995', '14', '36', '1', '国 民 立 约 西 亚 的 儿 子 约 哈 斯 在 耶 路 撒 冷 接 续 他 父 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11996', '14', '36', '2', '约 哈 斯 登 基 的 时 候 年 二 十 三 岁 ， 在 耶 路 撒 冷 作 王 三 个 月 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11997', '14', '36', '3', '埃 及 王 在 耶 路 撒 冷 废 了 他 ， 又 罚 犹 大 国 银 子 一 百 他 连 得 ， 金 子 一 他 连 得 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11998', '14', '36', '4', '埃 及 王 尼 哥 立 约 哈 斯 的 哥 哥 以 利 雅 敬 作 犹 大 和 耶 路 撒 冷 的 王 ， 改 名 叫 约 雅 敬 ， 又 将 约 哈 斯 带 到 埃 及 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('11999', '14', '36', '5', '约 雅 敬 登 基 的 时 候 年 二 十 五 岁 ， 在 耶 路 撒 冷 作 王 十 一 年 ， 行 耶 和 华 ─ 他 　 神 眼 中 看 为 恶 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12000', '14', '36', '6', '巴 比 伦 王 尼 布 甲 尼 撒 上 来 攻 击 他 ， 用 铜 炼 锁 着 他 ， 要 将 他 带 到 巴 比 伦 去 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12001', '14', '36', '7', '尼 布 甲 尼 撒 又 将 耶 和 华 殿 里 的 器 皿 带 到 巴 比 伦 ， 放 在 他 神 的 庙 里 ( 或 作 自 己 的 宫 里 ) 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12002', '14', '36', '8', '约 雅 敬 其 馀 的 事 和 他 所 行 可 憎 的 事 ， 并 他 一 切 的 行 为 ， 都 写 在 以 色 列 和 犹 大 列 王 记 上 。 他 儿 子 约 雅 斤 接 续 他 作 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12003', '14', '36', '9', '约 雅 斤 登 基 的 时 候 年 八 岁 ( 王 下 二 四 章 八 节 作 十 八 岁 ) ， 在 耶 路 撒 冷 作 王 三 个 月 零 十 天 ， 行 耶 和 华 眼 中 看 为 恶 的 事 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12004', '14', '36', '10', '过 了 一 年 ， 尼 布 甲 尼 撒 差 遣 人 将 约 雅 斤 和 耶 和 华 殿 里 各 样 宝 贵 的 器 皿 带 到 巴 比 伦 ， 就 立 约 雅 斤 的 叔 叔 （ 原 文 兄 ） 西 底 家 作 犹 大 和 耶 路 撒 冷 的 王 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12005', '14', '36', '11', '西 底 家 登 基 的 时 候 年 二 十 一 岁 ， 在 耶 路 撒 冷 作 王 十 一 年 ，');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12006', '14', '36', '12', '行 耶 和 华 ─ 他 　 神 眼 中 看 为 恶 的 事 。 先 知 耶 利 米 以 耶 和 华 的 话 劝 他 ， 他 仍 不 在 耶 利 米 面 前 自 卑 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12007', '14', '36', '13', '尼 布 甲 尼 撒 曾 使 他 指 着 　 神 起 誓 ， 他 却 背 叛 ， 强 项 硬 心 ， 不 归 服 耶 和 华 ─ 以 色 列 的 　 神 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12008', '14', '36', '14', '众 祭 司 长 和 百 姓 也 大 大 犯 罪 ， 效 法 外 邦 人 一 切 可 憎 的 事 ， 污 秽 耶 和 华 在 耶 路 撒 冷 分 别 为 圣 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12009', '14', '36', '15', '耶 和 华 ─ 他 们 列 祖 的 　 神 因 为 爱 惜 自 己 的 民 和 他 的 居 所 ， 从 早 起 来 差 遣 使 者 去 警 戒 他 们 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12010', '14', '36', '16', '他 们 却 嘻 笑 　 神 的 使 者 ， 藐 视 他 的 言 语 ， 讥 诮 他 的 先 知 ， 以 致 耶 和 华 的 忿 怒 向 他 的 百 姓 发 作 ， 无 法 可 救 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12011', '14', '36', '17', '所 以 ， 耶 和 华 使 迦 勒 底 人 的 王 来 攻 击 他 们 ， 在 他 们 圣 殿 里 用 刀 杀 了 他 们 的 壮 丁 ， 不 怜 恤 他 们 的 少 男 处 女 、 老 人 白 叟 。 耶 和 华 将 他 们 都 交 在 迦 勒 底 王 手 里 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12012', '14', '36', '18', '迦 勒 底 王 将 　 神 殿 里 的 大 小 器 皿 与 耶 和 华 殿 里 的 财 宝 ， 并 王 和 众 首 领 的 财 宝 ， 都 带 到 巴 比 伦 去 了 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12013', '14', '36', '19', '迦 勒 底 人 焚 烧 　 神 的 殿 ， 拆 毁 耶 路 撒 冷 的 城 墙 ， 用 火 烧 了 城 里 的 宫 殿 ， 毁 坏 了 城 里 宝 贵 的 器 皿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12014', '14', '36', '20', '凡 脱 离 刀 剑 的 ， 迦 勒 底 王 都 掳 到 巴 比 伦 去 ， 作 他 和 他 子 孙 的 仆 婢 ， 直 到 波 斯 国 兴 起 来 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12015', '14', '36', '21', '这 就 应 验 耶 和 华 藉 耶 利 米 口 所 说 的 话 ： 地 享 受 安 息 ； 因 为 地 土 荒 凉 便 守 安 息 ， 直 满 了 七 十 年 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12016', '14', '36', '22', '波 斯 王 古 列 元 年 ， 耶 和 华 为 要 应 验 藉 耶 利 米 口 所 说 的 话 ， 就 激 动 波 斯 王 古 列 的 心 ， 使 他 下 诏 通 告 全 国 ， 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12017', '14', '36', '23', '波 斯 王 古 列 如 此 说 ： 耶 和 华 ─ 天 上 的 　 神 已 将 天 下 万 国 赐 给 我 ， 又 嘱 咐 我 在 犹 大 的 耶 路 撒 冷 为 他 建 造 殿 宇 。 你 们 中 间 凡 作 他 子 民 的 ， 可 以 上 去 ， 愿 耶 和 华 ─ 他 的 　 神 与 他 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12018', '15', '1', '1', '波 斯 王 古 列 元 年 ， 耶 和 华 为 要 应 验 藉 耶 利 米 口 所 说 的 话 ， 就 激 动 波 斯 王 古 列 的 心 ， 使 他 下 诏 通 告 全 国 说 ：');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12019', '15', '1', '2', '「 波 斯 王 古 列 如 此 说 ： 『 耶 和 华 天 上 的 　 神 已 将 天 下 万 国 赐 给 我 ， 又 嘱 咐 我 在 犹 大 . 的 耶 路 撒 冷 为 他 建 造 殿 宇 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12020', '15', '1', '3', '在 你 们 中 间 凡 作 他 子 民 的 ， 可 以 上 犹 大 的 耶 路 撒 冷 ， 在 耶 路 撒 冷 重 建 耶 和 华 ─ 以 色 列 　 神 的 殿 （ 只 有 他 是 　 神 ） 。 愿 　 神 与 这 人 同 在 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12021', '15', '1', '4', '凡 剩 下 的 人 ， 无 论 寄 居 何 处 ， 那 地 的 人 要 用 金 银 、 财 物 、 牲 畜 帮 助 他 ， 另 外 也 要 为 耶 路 撒 冷 　 神 的 殿 甘 心 献 上 礼 物 。 』 」');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12022', '15', '1', '5', '於 是 ， 犹 大 和 便 雅 悯 的 族 长 、 祭 司 、 利 未 人 ， 就 是 一 切 被 　 神 激 动 他 心 的 人 ， 都 起 来 要 上 耶 路 撒 冷 去 建 造 耶 和 华 的 殿 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12023', '15', '1', '6', '他 们 四 围 的 人 就 拿 银 器 、 金 子 、 财 物 、 牲 畜 、 珍 宝 帮 助 他 们 （ 原 文 是 坚 固 他 们 的 手 ） ， 另 外 还 有 甘 心 献 的 礼 物 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('12024', '15', '1', '7', '古 列 王 也 将 耶 和 华 殿 的 器 皿 拿 出 来 ， 这 器 皿 是 尼 布 甲 尼 撒 从 耶 路 撒 冷 掠 来 、 放 在 自 己 　 神 之 庙 中 的 。');
