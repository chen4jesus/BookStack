+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6333', '6', '19', '11', '往 西 上 到 玛 拉 拉 ， 达 到 大 巴 设 ， 又 达 到 约 念 前 的 河 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6334', '6', '19', '12', '又 从 撒 立 往 东 转 向 日 出 之 地 ， 到 吉 斯 绿 ． 他 泊 的 境 界 ， 又 通 到 大 比 拉 ， 上 到 雅 非 亚 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6335', '6', '19', '13', '从 那 里 往 东 ， 接 连 到 迦 特 ． 希 弗 ， 至 以 特 ． 加 汛 ， 通 到 临 门 ， 临 门 延 到 尼 亚 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6336', '6', '19', '14', '又 绕 过 尼 亚 的 北 边 ， 转 到 哈 拿 顿 ， 通 到 伊 弗 他 ． 伊 勒 谷 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6337', '6', '19', '15', '还 有 加 他 、 拿 哈 拉 、 伸 仑 、 以 大 拉 、 伯 利 恒 ， 共 十 二 座 城 ， 还 有 属 城 的 村 庄 。');
