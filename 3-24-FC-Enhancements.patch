+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('4625', '4', '29', '16', '并 献 一 只 公 山 羊 为 赎 罪 祭 ， 这 是 在 常 献 的 燔 祭 和 同 献 的 素 祭 并 同 献 的 奠 祭 以 外 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('4626', '4', '29', '17', '“ 第 二 日 要 献 公 牛 犊 十 二 只 ， 公 绵 羊 两 只 ， 没 有 残 疾 、 一 岁 的 公 羊 羔 十 四 只 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('4627', '4', '29', '18', '并 为 公 牛 、 公 羊 ， 和 羊 羔 ， 按 数 照 例 ， 献 同 献 的 素 祭 和 同 献 的 奠 祭 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('4628', '4', '29', '19', '又 要 献 一 只 公 山 羊 为 赎 罪 祭 。 这 是 在 常 献 的 燔 祭 和 同 献 的 素 祭 并 同 献 的 奠 祭 以 外 。');
