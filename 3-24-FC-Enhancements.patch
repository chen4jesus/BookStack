+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6344', '6', '19', '22', '又 达 到 他 泊 、 沙 哈 洗 玛 、 伯 ． 示 麦 ， 直 通 到 约 旦 河 为 止 ， 共 十 六 座 城 ， 还 有 属 城 的 村 庄 。');
