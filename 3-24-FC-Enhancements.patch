+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6328', '6', '19', '6', '伯 ． 利 巴 勿 、 沙 鲁 险 ， 共 十 三 座 城 ， 还 有 属 城 的 村 庄 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6329', '6', '19', '7', '又 有 亚 因 、 利 门 、 以 帖 、 亚 珊 ， 共 四 座 城 ， 还 有 属 城 的 村 庄 ；');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6330', '6', '19', '8', '并 有 这 些 城 邑 四 围 一 切 的 村 庄 ， 直 到 巴 拉 ． 比 珥 ， 就 是 南 地 的 拉 玛 。 这 是 西 缅 支 派 按 着 宗 族 所 得 的 地 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6331', '6', '19', '9', '西 缅 人 的 地 业 是 从 犹 大 人 地 业 中 得 来 的 ； 因 为 犹 大 人 的 分 过 多 ， 所 以 西 缅 人 在 他 们 的 地 业 中 得 了 地 业 。');
+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('6332', '6', '19', '10', '＜ 分 给 西 布 伦 支 派 的 土 地 ＞ 
