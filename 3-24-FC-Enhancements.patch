+INSERT INTO `bible_verses_chinese_union_simp` VALUES ('3924', '4', '7', '73', '他 的 供 物 是 ： 一 个 银 盘 子 ， 重 一 百 三 十 舍 客 勒 ， 一 个 银 碗 ， 重 七 十 舍 客 勒 ， 都 是 按 圣 所 的 平 ， 也 都 盛 满 了 调 油 的 细 面 作 素 祭 ；');
